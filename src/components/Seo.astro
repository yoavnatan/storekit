---
/**
 * SEO — central place for all <head> meta tags.
 *
 * Renders: title, description, canonical, robots, Open Graph, Twitter card,
 * and JSON-LD structured data. Every page passes its own title/description;
 * sensible defaults come from store.config.js.
 *
 * This component is the backbone of the "high SEO" goal — keep meta logic
 * here so no page forgets a tag.
 */
import { store } from '../config/store.config.js';
import { jsonForScript } from '../lib/json-script.js';
import { stripTrailingSlashes } from '../lib/url-base.js';

const {
  title,
  description = store.description,
  image = store.social.ogImage,
  type = 'website',
  noindex = false,
  jsonLd = null,
  productPrice,
  productCurrency = 'ILS',
  canonical: canonicalOverride,
  storeOwned = false,
  siteName,
} = Astro.props;

/**
 * Whose SITE this page belongs to — the second thing Google reads when deciding what name to print
 * above a result (after `WebSite` structured data; developers.google.com/search/docs/appearance/
 * site-names, checked 2026-08-13), and what Facebook prints on a shared card.
 *
 * It said `Dezabin` on every page including a seller's own verified domain, which is the same
 * half-applied sovereignty the title carried: a store answering on `acme.co.il` was declaring
 * somebody else's site as its own. On the platform path it makes no difference to Google — a
 * subdirectory cannot have a site name at all — so this costs nothing there and is the difference
 * that matters on the domain the seller paid for.
 */
const resolvedSiteName = (storeOwned && siteName) || store.name;

/**
 * The tab, the search result and the shared card all read this one string.
 *
 * **A shopper-facing store page does NOT carry ` | Dezabin`, and that is the sovereignty rule
 * rather than a preference (owner, 2026-08-13: "מלוא הכבוד והמקום לחנות עצמה").** It is the same
 * decision as the store's own favicon two components away in `BaseLayout` — a shopper with six
 * tabs open is looking at six shops, not six pages of ours — and `storeOwned` is set from the same
 * gate, so the tab's icon and the tab's text can never disagree about whose page this is. Every
 * page that is OURS keeps the suffix: the homepage, /stores, /search, /checkout, 404, and every
 * seller and admin screen, including the dashboard (the platform's tool for running a store, not
 * the store).
 *
 * **It costs no SEO, checked against Google's own title-link documentation (2026-08-13) rather
 * than assumed:** the site name is a recommendation for brevity ("brand concisely"), never a
 * requirement, and the title link is truncated to fit the device width anyway — so the suffix was
 * spending visible pixels on our name inside results for the seller's. Google also rewrites titles
 * it dislikes, and a store name is the clearest possible answer to "what is this page".
 */
const fullTitle = title
  ? (storeOwned ? title : `${title} | ${store.name}`)
  : `${store.name} — ${store.tagline}`;
// Canonical is always the query-stripped, trailing-slash-free path (root stays "/"),
// so filtered/sorted views (?category=&sort=) and any slash variant all consolidate
// to one indexable URL — matches the site's trailingSlash:'never' policy.
// A page may pass an explicit `canonical` to point elsewhere — a store/product with an active
// custom domain sets it to the seller's own domain (see custom-domain.ts → storeCanonicalUrl), so
// the SEO credit consolidates there instead of on the platform path.
const canonicalPath = stripTrailingSlashes(Astro.url.pathname) || '/';
const canonical = canonicalOverride ?? new URL(canonicalPath, store.url).href;
const ogImage = image ? new URL(image, store.url).href : '';
// Declared only for the platform's own card, whose size this repo controls
// (scripts/generate-brand-assets.mjs). A scraper that has the dimensions up
// front lays the card out on its FIRST pass; without them Facebook has been
// known to show a link with no image until it re-crawls. A store page passes its
// own image and no dimensions rather than have this guess at them.
const isDefaultOgImage = image === store.social.ogImage;
---

<!-- Primary -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={resolvedSiteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={store.locale} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={fullTitle} />}
{ogImage && isDefaultOgImage && <meta property="og:image:width" content="1200" />}
{ogImage && isDefaultOgImage && <meta property="og:image:height" content="630" />}

<!-- Twitter -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
{store.social.twitter && <meta name="twitter:site" content={store.social.twitter} />}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={fullTitle} />}

<!-- Product pricing (Meta/Facebook product catalog) -->
{productPrice !== undefined && <meta property="product:price:amount" content={String(productPrice)} />}
{productPrice !== undefined && <meta property="product:price:currency" content={productCurrency} />}

<!-- Structured data -->
{jsonLd && <script type="application/ld+json" is:inline set:html={jsonForScript(jsonLd)} />}
