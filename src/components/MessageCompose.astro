---
// MessageCompose — dialog for buyers to send a message to a seller/store
// Opened by: window.dispatchEvent(new CustomEvent('message:compose', { detail: { storeId, sellerId, storeName, productRef? } }))
// productRef: { productId, productName, productSlug, storeSlug }
//
// Every string here is a `t.messages` key and always was — the slice was written
// with this dialog in mind and then never wired to it, so the component rendered
// Hebrew inside an English page. The four the SCRIPT writes travel as data-str-*
// on the dialog (the Header's pattern), not through `#i18n-data`: this component
// only appears on store and product pages, and the island is emitted by
// BaseLayout for every route, so a slice there would be weight on pages that
// never open this dialog.
import { getLang, getT } from '../i18n/index.js';
const t = getT(getLang(Astro.cookies));
---

<dialog
  id="msg-compose-dialog"
  class="bd-dialog"
  aria-label={t.messages.send}
  aria-modal="true"
  style="max-width:min(460px,95vw)"
  data-str-send={t.messages.send}
  data-str-sending={t.messages.sending}
  data-str-sent={t.messages.sentShort}
  data-str-to={t.messages.toStore}
  data-str-login={t.messages.loginRequired}
  data-str-sent-status={t.messages.sent}
  data-str-error={t.messages.errorSending}
>
  <form id="msg-compose-form" style="display:flex;flex-direction:column">
    <!-- Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border);flex-shrink:0">
      <div>
        <h2 style="font-size:1rem;font-weight:700;margin:0;color:var(--color-text)">{t.messages.send}</h2>
        <p id="mc-to-name" style="font-size:0.8rem;color:var(--color-muted);margin:2px 0 0"></p>
      </div>
      <button type="button" id="mc-close" aria-label={t.messages.close} style="width:2rem;height:2rem;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;color:var(--color-muted);background:none;border:none;cursor:pointer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div style="padding:1.25rem;display:flex;flex-direction:column;gap:1rem">
      <!-- Product context chip -->
      <div id="mc-product-ref" hidden style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-sm);font-size:0.82rem;color:var(--color-muted)">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <span>{t.messages.productContext}: </span><strong id="mc-product-name"></strong>
      </div>

      <!-- Subject -->
      <label style="display:flex;flex-direction:column;gap:0.35rem">
        <span style="font-size:0.82rem;font-weight:600;color:var(--color-text)">{t.messages.subject}</span>
        <input
          id="mc-subject"
          name="subject"
          type="text"
          class="input"
          placeholder={t.messages.subjectPlaceholder}
          required
          maxlength="120"
          style="font-size:0.9rem"
        />
      </label>

      <!-- Content -->
      <label style="display:flex;flex-direction:column;gap:0.35rem">
        <span style="font-size:0.82rem;font-weight:600;color:var(--color-text)">{t.messages.content}</span>
        <textarea
          id="mc-content"
          name="content"
          class="input"
          placeholder={t.messages.contentPlaceholder}
          required
          maxlength="2000"
          rows="6"
          style="resize:none;font-size:0.9rem"
        ></textarea>
      </label>
    </div>

    <!-- Footer -->
    <div style="padding:0.85rem 1.25rem;border-top:1px solid var(--color-border);display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-shrink:0">
      <p id="mc-status" style="font-size:0.82rem;margin:0;color:var(--color-muted)"></p>
      <button
        id="mc-submit"
        type="submit"
        class="btn btn--accent"
        style="min-width:8rem;text-align:center"
      >{t.messages.send}</button>
    </div>
  </form>
</dialog>

<script>
  interface ComposeDetail {
    storeId: string;
    sellerId: string;
    storeName: string;
    productRef?: { productId: string; productName: string; productSlug: string; storeSlug: string };
  }

  const dialog = document.getElementById('msg-compose-dialog') as HTMLDialogElement | null;
  const form   = document.getElementById('msg-compose-form') as HTMLFormElement | null;
  if (!dialog || !form) throw new Error('MessageCompose: elements not found');

  let currentDetail: ComposeDetail | null = null;

  /** The seven strings this script writes, from the dialog's own data-str-* attributes
   *  (t.messages, server-rendered). The Hebrew after each `??` is the fallback for a
   *  missing attribute only — never the source. */
  const d = dialog.dataset;
  const str = {
    send:    d.strSend ?? 'שלח הודעה',
    sending: d.strSending ?? 'שולח...',
    sent:    d.strSent ?? '✓ נשלח',
    to:      d.strTo ?? 'אל',
    login:   d.strLogin ?? 'יש להתחבר כדי לשלוח הודעה',
    sentMsg: d.strSentStatus ?? 'ההודעה נשלחה!',
    error:   d.strError ?? 'שגיאה בשליחה. נסה שוב.',
  };

  function openCompose(detail: ComposeDetail) {
    currentDetail = detail;
    const toName = document.getElementById('mc-to-name');
    if (toName) toName.textContent = `${str.to}: ${detail.storeName}`;

    const refBlock = document.getElementById('mc-product-ref') as HTMLElement;
    const refName  = document.getElementById('mc-product-name');
    if (detail.productRef) {
      if (refBlock) refBlock.hidden = false;
      if (refName) refName.textContent = detail.productRef.productName;
    } else {
      if (refBlock) refBlock.hidden = true;
    }

    const status = document.getElementById('mc-status');
    if (status) { status.textContent = ''; status.style.color = 'var(--color-muted)'; }
    const submitBtn = document.getElementById('mc-submit') as HTMLButtonElement;
    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = str.send; }

    dialog!.showModal();
    dialog!.animate(
      [{ opacity: 0, transform: 'translateY(12px) scale(0.97)' },
       { opacity: 1, transform: 'translateY(0) scale(1)' }],
      { duration: 260, easing: 'cubic-bezier(0.34,1.56,0.64,1)', fill: 'forwards' }
    );
    setTimeout(() => (document.getElementById('mc-subject') as HTMLInputElement)?.focus(), 50);
  }

  function closeCompose() {
    dialog!.animate(
      [{ opacity: 1 }, { opacity: 0, transform: 'translateY(8px)' }],
      { duration: 180, easing: 'ease-in', fill: 'forwards' }
    ).onfinish = () => {
      dialog!.close();
      form!.reset();
    };
  }

  window.addEventListener('message:compose', (e: Event) => {
    openCompose((e as CustomEvent<ComposeDetail>).detail);
  });

  document.getElementById('mc-close')?.addEventListener('click', closeCompose);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) closeCompose(); });
  dialog.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); closeCompose(); } });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentDetail) return;

    const submitBtn = document.getElementById('mc-submit') as HTMLButtonElement;
    const status    = document.getElementById('mc-status');
    const subject   = (document.getElementById('mc-subject') as HTMLInputElement).value.trim();
    const content   = (document.getElementById('mc-content') as HTMLTextAreaElement).value.trim();
    if (!subject || !content) return;

    submitBtn.disabled = true;
    submitBtn.textContent = str.sending;

    try {
      const res = await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          // Only the store id travels: the server looks the seller and the shop name up from it
          // rather than believing a payload that could name one shop and deliver to another.
          toStoreId: currentDetail.storeId,
          subject,
          content,
          productRef: currentDetail.productRef,
        }),
      });
      if (!res.ok) {
        const body = await res.json() as { error?: string };
        // 401 and 429 both have something specific to say, and the generic catch below
        // would replace both with "try again" — which is wrong advice for a refusal that
        // is a rule (lib/message-flood.ts, "you have opened too many conversations with
        // this shop"). The server writes that sentence in the reader's own language, so
        // it is shown verbatim rather than re-worded here.
        if (res.status === 401 || res.status === 429) {
          if (status) {
            status.textContent = res.status === 401 ? str.login : (body.error ?? str.error);
            status.style.color = 'var(--color-danger)';
          }
          submitBtn.disabled = false; submitBtn.textContent = str.send;
          return;
        }
        throw new Error(body.error ?? 'error');
      }
      if (status) { status.textContent = str.sentMsg; status.style.color = 'var(--color-accent)'; }
      submitBtn.textContent = str.sent;
      setTimeout(closeCompose, 1600);
    } catch {
      if (status) { status.textContent = str.error; status.style.color = 'var(--color-danger)'; }
      submitBtn.disabled = false; submitBtn.textContent = str.send;
    }
  });
</script>
