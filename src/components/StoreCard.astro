---
import { cdnSrc } from '../config/store.config.js';
import StoreAvatar from './StoreAvatar.astro';
import StoreDemoBadge from './StoreDemoBadge.astro';
import { storeHomeHref } from '../lib/custom-domain.js';
import type { Store } from '../lib/stores.js';
import { isStoreSaleLive, isSaleScoped } from '../lib/discounts.js';

interface Props {
  store: Store;
  previewImages?: string[];
  class?: string;
  /** First card above the fold shouldn't lazy-load + shimmer — same eager/high-priority
   *  treatment the old homepage gave its very first product image, now handed to whichever
   *  shelf renders first (liked → new → category → discovery). */
  eager?: boolean;
  role?: 'listitem';
  /** Preview thumbs per card. A shelf holding only one or two cards makes each
   *  card very wide, and three thumbs stretched across that width read as
   *  oversized; a fourth restores the card's internal proportion. Set by
   *  HomeShelf, never by hand. */
  previewSlots?: number;
}

const { store, previewImages = [], class: className = '', eager = false, role, previewSlots = 3 } = Astro.props;
const thumbs = previewImages.slice(0, previewSlots);
// Always render a fixed slot row — a store whose products have no photos yet
// (or fewer than the slot count) gets neutral placeholder squares for the rest,
// so every card in the same shelf stays the same height instead of the
// photo-less one visibly shrinking next to its neighbors.
const placeholderCount = previewSlots - thumbs.length;
const noImgIconSvg = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`;

// At most 2 tags shown + a "+N" for the rest — a gentle label, not a wall of chips.
const CATEGORY_TAGS_SHOWN = 2;
const categories = (store.categories ?? []).map((c) => c.trim()).filter(Boolean);
const shownCategories = categories.slice(0, CATEGORY_TAGS_SHOWN);
const extraCategoryCount = categories.length - shownCategories.length;

// Link to the seller's own domain when they have a verified one (the store reads as sovereign);
// otherwise the in-platform path. Prefetch only makes sense for the same-origin (internal) link.
// A running store-wide sale is a discovery signal — it belongs on the card, but as a chip in
// the existing tags row rather than a second banner competing with the store's own identity.
const saleLive = isStoreSaleLive(store.sale);
// The card has no room to explain WHICH products a scoped sale covers, so it doesn't quote a
// percent there — only a store-wide sale can honestly advertise one number on a store card.
const saleChipPercent = saleLive && store.sale && !isSaleScoped(store.sale) ? store.sale.percent : undefined;

const storeHref = storeHomeHref(store);
const isExternalStore = storeHref.startsWith('http');
---

<a
  href={storeHref}
  data-astro-prefetch={isExternalStore ? undefined : true}
  rel={isExternalStore ? 'noopener' : undefined}
  class={`store-card ${className}`}
  data-store-name={store.name.toLowerCase()}
  data-tagline={(store.tagline || store.description || '').toLowerCase()}
  role={role}
>
  <div class="store-card__head">
    <span class="store-card__avatar-wrap">
      <StoreAvatar name={store.name} slug={store.slug} profileImage={store.profileImage} size={40} />
    </span>
    <div class="store-card__title-group">
      <span class="store-card__name" dir="auto">{store.name}</span>
      <!-- Always rendered — a store with no tagline/description used to skip
           this line entirely, same misalignment as the tags row below: its
           preview row sat higher than a neighboring card that had one. A
           non-breaking space keeps the line's own height without showing
           visible text. -->
      <span class="store-card__tagline" dir="auto">{store.tagline || store.description || ' '}</span>
    </div>
  </div>
  <!-- Always rendered (min-height reserves the row even with zero tags) —
       skipping this block entirely for a store with no categories left its
       preview row sitting higher than neighboring cards that do have tags,
       a visible misalignment across a shelf of side-by-side cards. -->
  <div class="store-card__tags">
    <!-- First in the row, before the category chips: a showcase store must
         disclose itself here and not only at the checkout refusal, which is
         server-side and final (see lib/demo-stores.ts). Renders nothing for a
         normal store. -->
    <StoreDemoBadge demo={store.demo} compact={true} />
    <!-- One chip, two mutually exclusive forms, as two sibling expressions rather than a ternary
         nested inside `saleLive &&` — that nesting is not a valid single expression and neither is
         an Astro `<>` fragment in this position; both fail the build.
         The icon is a PERCENT SIGN (the diagonal plus two dots), so it appears ONLY in the title
         form. Beside "-10%" it was the same symbol twice in one chip. In the title form there is no
         number, and there the glyph is the only thing saying what kind of chip this is — which is
         why it isn't simply deleted. `dir="ltr"` likewise belongs only to the numeric form. -->
    {saleLive && saleChipPercent && (
      <span class="sale-chip badge-finish" dir="ltr">-{saleChipPercent}%</span>
    )}
    {saleLive && !saleChipPercent && (
      <span class="sale-chip badge-finish">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
        {store.sale!.title}
      </span>
    )}
    {shownCategories.map((c) => <span class="store-card__tag badge-finish">{c}</span>)}
    {extraCategoryCount > 0 && <span class="store-card__tag store-card__tag--more badge-finish">+{extraCategoryCount}</span>}
  </div>
  <div class="store-card__preview" aria-hidden="true">
    {thumbs.map((img, i) => (
      <span class={`store-card__preview-img-wrap${eager && i === 0 ? '' : ' is-loading'}`}>
        <img
          src={cdnSrc(img, 200)}
          alt=""
          width="80"
          height="80"
          loading={eager && i === 0 ? 'eager' : 'lazy'}
          fetchpriority={eager && i === 0 ? 'high' : undefined}
          decoding="async"
          class="store-card__preview-img"
        />
      </span>
    ))}
    {Array.from({ length: placeholderCount }).map(() => (
      <span class="store-card__preview-img-wrap store-card__preview-img-wrap--empty" set:html={noImgIconSvg} />
    ))}
  </div>
</a>
