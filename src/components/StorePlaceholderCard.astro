---
/**
 * Placeholder store card — occupies a slot no store has taken yet (see
 * lib/launch-mode.ts). Reuses the REAL `.store-card` classes, not a lookalike:
 * identical padding, radius, border, hover lift and preview-row
 * geometry, so a mixed row reads as one populated shelf rather than as a
 * populated part and an empty part.
 *
 * What differs from a real card is only the content: a soft plus where the
 * store avatar goes, and three pieces of eclectic product line-art where the
 * product photos go. No category name, no "coming soon", no store name — the
 * card is an open slot, and it deliberately doesn't tell a seller what kind of
 * store belongs in it.
 */
import { pickArtTrio, pickCardHue, tileBackground, tileEdge } from '../lib/placeholder-art.js';
import { getLang, getT } from '../i18n/index.js';

interface Props {
  /** Position in the row — only used to vary which art shows, so neighbours differ. */
  index?: number;
  role?: 'listitem';
  /** Matches StoreCard's own slot count so a mixed row stays aligned. */
  previewSlots?: number;
}

const { index = 0, role, previewSlots = 3 } = Astro.props;
const lang = getLang(Astro.cookies);
const t = getT(lang);
const art = pickArtTrio(index, previewSlots);
const hue = pickCardHue(index);
// The TITLE rotates on its own cycle (5) — see the note on `launch` in
// translations.ts for why that length matters against a responsive grid. The
// subtitle is the same on every card on purpose, and that note says why: the
// number of these cards falls as real stores arrive, so a card that carried one
// feature of the offer left a late-arriving seller seeing only that feature.
const label = t.launch.inviteLabels[index % t.launch.inviteLabels.length]!;
const hint = t.launch.inviteHint;
---

<!-- `group` is what lets the art zoom on card hover the way a real card's photos
     do: `.store-card:hover .store-card__preview-img` targets `img` only, and the
     art can't take that class (it also sets width/height/object-fit, which would
     stretch a 24-viewBox glyph to fill the tile). group-hover reproduces just the
     transform, with the same curve and duration. -->
<a href="/seller/register" class="store-card group" role={role}>
  <div class="store-card__head">
    <span class="store-glow-wrap">
      <!-- Tracks StoreCard's avatar exactly — 56px and round. A different size
           or shape here and the open slot stops lining up with the real cards
           beside it, which is the one thing this component exists to do. -->
      <span
        class="flex items-center justify-center w-14 h-14 rounded-full
               bg-[color:var(--color-bg)] [color:var(--color-muted)]"
        aria-hidden="true"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
      </span>
    </span>
    <div class="store-card__title-group">
      <!-- `.store-card__name`/`__tagline` are nowrap+ellipsis, which is right for
           a store NAME (one line, truncation loses nothing you can't guess) but
           wrong for a sentence — on the 2-column mobile grid every line came out
           as "יש לכם מוצ...". These wrap instead; the card stretches to its
           neighbours anyway, so a second line costs nothing. `!` is needed
           because store-card.css is unlayered legacy CSS and outranks utilities. -->
      <span class="store-card__name !whitespace-normal !overflow-visible">{label}</span>
      <span class="store-card__tagline !whitespace-normal !overflow-visible">{hint}</span>
    </div>
  </div>
  <!-- Empty, same as a store with no categories — it's what reserves the tags
       row's height so this card lines up with its neighbours (see StoreCard). -->
  <div class="store-card__tags"></div>
  <!-- The whole card takes ONE hue (`pickCardHue`), and the three tiles differ
       only in how deep that hue sinks — never in light direction, which is a
       constant (`tileBackground`, and the note above it says what varying it
       looked like). Three flat grey boxes with a hairline glyph read as "image
       failed to load"; a lit coloured wash reads as three product photos, which
       is the difference between the card looking dead and looking stocked. One
       hue per card rather than one per tile: three different tints inside a
       single card cancel each other out and the card goes grey again — the
       variety belongs between cards, where it reads as different stores. -->
  <div class="store-card__preview" aria-hidden="true">
    {art.map((a, i) => {
      return (
        <span
          class="store-card__preview-img-wrap store-card__preview-img-wrap--empty"
          style={`background:${tileBackground(index, i)};box-shadow:${tileEdge(index)}`}
        >
          <!-- Sized to fill the tile the way a product photo does (~55% of it) —
               a small centred glyph reads as "no image", a large one reads as the
               product itself, which is the whole point of the card.
               `transition-transform`, NOT `[transition:transform_...]`: Tailwind
               v4's `scale-*` compiles to the standalone `scale` property, which
               a `transition-property: transform` does not cover — the zoom
               snapped instead of easing. The utility covers transform +
               translate + scale + rotate together. Duration and curve match
               `.store-card__preview-img`'s own photo zoom exactly. -->
          <svg
            width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"
            class="transition-transform duration-[380ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)]
                   group-hover:scale-[1.08] motion-reduce:transform-none"
            style={`color:${hue}`}
            set:html={a.paths}
          />
        </span>
      );
    })}
  </div>
</a>
