---
import { store } from '../config/store.config.js';
import CsrfField from './CsrfField.astro';
import { getLang, getT } from '../i18n/index.js';

const year     = new Date().getFullYear();
const lang     = getLang(Astro.cookies);
const t        = getT(lang);
const nextLang = lang === 'he' ? 'en' : 'he';
---

<footer class="site-footer">
  <div class="container flex between gap">
    <p class="muted">© {year} <a href="/">{store.name}</a></p>
    <nav aria-label="Footer links">
      <ul role="list" class="flex gap">
        <li><a href="/seller/register">{t.nav.openStore}</a></li>
        {/* Next to "open a shop" and before the legal pages, because it answers the question that
            link provokes. It is also the only footer entry a SELLER goes looking for, and the
            registration form links here too — a price a prospect has to hunt for reads as one
            being kept from them. */}
        <li><a href="/pricing" class="muted">{t.footer.pricing}</a></li>
        <li><a href="/help" class="muted">{t.footer.help}</a></li>
        <li><a href="/terms" class="muted">{t.footer.terms}</a></li>
        <li><a href="/returns-policy" class="muted">{t.footer.returns}</a></li>
        {/* Kept beside terms and returns because they are the same KIND of thing — the four
            documents the site is legally required to publish and to keep reachable. `/privacy`
            carries the §11 notification duty as תיקון 13 widened it (in force 2025-08-14);
            `/accessibility` is the statement תקנה 35ה requires, and the turnover exemption people
            assume covers a small site reaches only sites operating before 26.10.2017 — not this
            one, at any revenue. Removing either link does not just tidy the row, it un-publishes
            a document; `tests/legal-pages.test.ts` fails if one goes. */}
        <li><a href="/privacy" class="muted">{t.footer.privacy}</a></li>
        <li><a href="/accessibility" class="muted">{t.footer.accessibility}</a></li>
        <li><a href="/contact" class="muted">{t.footer.contact}</a></li>
        <li>
          {/* data-native-submit: no AJAX handler exists for this one on purpose — /api/lang sets
              the cookie and answers 303 back to the same page, and only a full navigation can
              re-render the page in the new language. Without the opt-out the dashboard's
              FormFallbackGuard blocks it and the seller is told saving is unavailable. */}
          <form method="POST" action={`/api/lang?l=${nextLang}`} class="lang-toggle-form" data-native-submit>
            <CsrfField />
            <button type="submit" class="lang-toggle-btn" aria-label={t.nav.switchLangLabel}>
              {t.nav.switchLang}
            </button>
          </form>
        </li>
      </ul>
    </nav>
  </div>

  {/* ── There is no licensing disclosure here any more, and that is deliberate (2026-08-21) ──
      A line saying the platform is exempt from the payment-services licence and unsupervised by
      רשות ניירות ערך sat here from 2026-08-16, because the platform was about to collect buyers'
      money and pay it on to sellers — `מאגד` activity, covered only by the size exemption, which
      obliges the exempt body to say so on every page. Under the split model the money never
      reaches us: PayMe captures each store's share into that seller's own account and sends us our
      distribution fee monthly (GO_LIVE §3.1.0). Nothing here is a payment service, so the sentence
      became a claim about a regime we do not operate under — worse than no sentence, because a
      reader would take it as describing something real. If the custodial model is ever chosen,
      this line comes back with it; `git log` has the wording. */}
</footer>
