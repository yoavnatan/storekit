---
/** Footer — config-driven links and note. */
import { store } from '../config/store.config.js';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="flex between gap">
      <p class="muted">© {year} {store.business.legalName || store.name}</p>
      <nav aria-label="Footer links">
        <ul role="list" class="flex gap">
          {store.footer.links.map((l) => (
            <li><a href={l.href} class="muted">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="muted note">{store.footer.note}</p>
  </div>
</footer>

