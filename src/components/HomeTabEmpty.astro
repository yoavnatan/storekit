---
// Shared per-tab empty state for the homepage's Liked/BuyAgain/New/Discover
// tabs — same icon+message+CTA layout as the page's own zero-stores
// fallback (index.astro), so a tab with nothing in it still reads as
// intentional rather than broken.
interface Props {
  message: string;
  ctaLabel: string;
  ctaHref: string;
}

const { message, ctaLabel, ctaHref } = Astro.props;
---

<!-- Self-contained gutter (own .container) — the panel that hosts this has
     zero horizontal padding of its own (see home.css), same reasoning as
     HomeShelf's own internal .container: whatever a .dash-panel renders is
     responsible for its own inset. -->
<div class="container flex flex-col items-center gap-4 py-12 text-center">
  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
       class="opacity-25 text-[var(--color-muted)]" aria-hidden="true">
    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    <polyline points="9 22 9 12 15 12 15 22"/>
  </svg>
  <p class="text-[var(--color-muted)] text-sm">{message}</p>
  <a href={ctaHref} class="btn btn--sm">{ctaLabel}</a>
</div>
