---
/**
 * "חנות לדוגמה" badge for a platform-owned showcase store (lib/demo-stores.ts).
 *
 * Renders nothing for a normal store, so a call site can drop it in
 * unconditionally. Deliberately shown on the CARD as well as the store page: the
 * checkout refusal is server-side and final, and a shopper who only learns the
 * store was a demo at that point has been wasted. Disclosure comes first.
 *
 * `compact` is the in-card size (sits in the `.store-card__tags` chip row and has
 * to match a `.store-card__tag`'s geometry exactly, or it changes the row height
 * every other card); the default size is for the store page's own header.
 *
 * `quiet` drops the accent tint for plain muted text on the section's own
 * background. It's for the homepage spotlight, where the store header is already
 * a busy row (avatar, name, tagline, "כנס לחנות") and the tinted pill competed
 * with it — the label still has to be there, just not shouting (user, 2026-07-28).
 *
 * Written in utilities rather than as a `.store-card__tag--demo` modifier: it also
 * appears outside store-card.css's scope, and store-card.css is unlayered legacy
 * CSS whose `.store-card__tag` rules would then need `!` overrides to beat.
 */
import { getLang, getT } from '../i18n/index.js';

interface Props {
  demo?: boolean;
  compact?: boolean;
  /** Muted, borderless variant — same words, no colour competing for attention. */
  quiet?: boolean;
}

const { demo = false, compact = false, quiet = false } = Astro.props;
const t = getT(getLang(Astro.cookies));
const size = compact || quiet
  ? 'text-[0.68rem] gap-1'
  : 'text-[0.75rem] gap-1.5';
const shape = quiet
  ? 'font-medium [color:var(--color-muted)]'
  : `rounded-full border font-semibold [color:var(--color-accent-dark)]
     ${compact ? 'px-2 py-[0.12rem]' : 'px-2.5 py-[0.2rem]'}`;
const icon = compact || quiet ? 11 : 13;

// The pill's finish, as an inline style rather than arbitrary utilities: a
// gradient built from color-mix is unreadable once escaped into Tailwind bracket
// syntax, and it's one component, not a repeated utility.
//
// Two things went wrong in the first version and both showed up as "the fill
// doesn't sit inside the border":
//   1. a semi-transparent border-color paints OVER the background, which by
//      default extends under the border — so the border read as border+gradient
//      blended, not as a line. Fixed by mixing the border toward --color-surface
//      (opaque) and clipping the fill to the padding box.
//   2. an `inset 0 1px 0` white highlight drew a second ring just inside the
//      first that doesn't follow the radius cleanly at this size. Removed.
// The gradient itself is now a whisper (11% → 5%): at chip scale a wide spread
// reads as a coarse stripe rather than as depth.
const finish = quiet ? undefined : [
  `background:linear-gradient(140deg,
     color-mix(in srgb, var(--color-accent) 11%, var(--color-surface)) 0%,
     color-mix(in srgb, var(--color-accent) 5%, var(--color-surface)) 100%)`,
  'background-clip:padding-box',
  'border-color:color-mix(in srgb, var(--color-accent) 28%, var(--color-surface))',
  'box-shadow:0 1px 1.5px color-mix(in srgb, var(--color-accent) 10%, transparent)',
].join(';').replace(/\s+/g, ' ');
---

{demo && (
  <span
    class={`inline-flex shrink-0 items-center whitespace-nowrap leading-[1.5] ${size} ${shape}`}
    style={finish}
    title={t.demo.badgeTitle}
  >
    <svg
      width={icon} height={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      style="flex-shrink:0"
    >
      <circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.6v.6"/>
    </svg>
    {t.demo.badge}
  </span>
)}
