---
/**
 * The CSRF token as a hidden field, for the handful of forms the BROWSER really submits — logout,
 * the language toggle, store creation, and the three sign-in forms. Everything else on this site
 * posts through `fetch` and is covered by the wrapper in `src/scripts/csrf-client.ts` instead.
 *
 * Server-rendered rather than injected by script on submit, for two reasons. It keeps sign-in
 * working with JavaScript off, which is the one flow where that still matters. And injecting a
 * field into every POST form would also inject it into the AJAX ones, several of which post
 * `new FormData(form)` verbatim — a stray field arriving at a route that validates its input by
 * name is harmless today and is exactly the kind of thing that stops being harmless quietly.
 *
 * Every page on this site is on-demand (`prerender = false`), so there is no build-time render in
 * which this token would be baked into a cached HTML file.
 *
 * `tests/csrf.test.ts` enforces the pairing: a POST form in `src/` either carries
 * `data-unsaved-guard` (the AJAX marker) or it carries this component.
 */
import { CSRF_FIELD, issueCsrfToken } from '../lib/csrf.js';
---

<input type="hidden" name={CSRF_FIELD} value={issueCsrfToken(Astro.cookies)} />
