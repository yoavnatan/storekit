---
// ToastContainer — listens to `toast:show` CustomEvent
// Event detail: { title: string, body: string, duration?: number }
//
// The close button's label rides on the container as data-str-close: the toast
// itself is built by innerHTML in the script below, which has no getT().
import { getLang, getT } from '../i18n/index.js';
const t = getT(getLang(Astro.cookies));
---

<div
  id="toast-container"
  class="toast-container"
  aria-live="polite"
  aria-atomic="false"
  data-str-close={t.messages.close}
></div>

<script>
  import { escapeHtml as esc } from '../lib/html-escape.js';
  const container = document.getElementById('toast-container')!;
  const shownKeys = new Set<string>();

  // If a mobile sticky bottom bar (e.g. the product page's sticky add-to-cart
  // bar) or the AddToCartPreview panel is currently on screen, lift the toast
  // above it instead of letting the two overlap — recomputed per toast since
  // visibility toggles live, and also below via a MutationObserver so an
  // already-visible toast repositions if the cart preview opens afterwards
  // (the preview itself never moves — it always stays at its own base
  // offset; the toast is the one that gets out of its way).
  function updateBottomOffset(): void {
    const bar = document.querySelector<HTMLElement>('.sticky-bottom-bar.is-visible');
    const cartPreview = document.querySelector<HTMLElement>('#cart-preview.is-open');
    const barHeight = bar ? window.innerHeight - bar.getBoundingClientRect().top : 0;
    const previewHeight = cartPreview ? window.innerHeight - cartPreview.getBoundingClientRect().top : 0;
    const height = Math.max(barHeight, previewHeight);
    container.style.setProperty('--toast-bottom-offset', height > 0 ? `${height + 12}px` : '');
  }

  const cartPreviewEl = document.getElementById('cart-preview');
  if (cartPreviewEl) {
    new MutationObserver(updateBottomOffset).observe(cartPreviewEl, { attributes: true, attributeFilter: ['class'] });
  }

  function showToast(title: string, body: string, duration = 5000, href?: string, tone?: string) {
    updateBottomOffset();
    const toast = document.createElement('div');
    // `alert` for a failure, `status` for everything else. The difference is real and not
    // cosmetic: `status` is announced only once the screen reader finishes what it is saying,
    // which for "the order did not go through" is the wrong moment. See lib/toast.ts.
    const isError = tone === 'error';
    toast.setAttribute('role', isError ? 'alert' : 'status');
    // Spelled out rather than left to `role="alert"`'s implicit mapping: this container declares
    // `aria-live="polite"`, and the live-region politeness a screen reader uses is the nearest one
    // it finds walking UP from the changed node — so the ancestor can swallow the implied
    // assertiveness. The explicit attribute on the node itself is what makes it hold.
    if (isError) toast.setAttribute('aria-live', 'assertive');
    toast.className = isError ? 'toast-card toast-card--error' : 'toast-card';
    toast.style.pointerEvents = 'auto';

    toast.innerHTML = `
      <div class="toast-card__body-wrap">
        <div class="toast-card__title">${esc(title)}</div>
        ${body ? `<div class="toast-card__body">${esc(body)}</div>` : ''}
      </div>
      <button class="toast-close" aria-label="${esc(container.dataset.strClose ?? 'סגור')}">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>`;

    container.prepend(toast);

    toast.animate(
      [{ opacity: 0, transform: 'translateY(12px) scale(0.96)' },
       { opacity: 1, transform: 'translateY(0) scale(1)' }],
      { duration: 260, easing: 'cubic-bezier(0.34,1.56,0.64,1)', fill: 'forwards' }
    );

    const dismiss = () => {
      toast.animate(
        [{ opacity: 1, transform: 'scale(1)' },
         { opacity: 0, transform: 'scale(0.94)' }],
        { duration: 160, easing: 'ease-in', fill: 'forwards' }
      ).onfinish = () => toast.remove();
    };

    toast.querySelector('button')!.addEventListener('click', (e) => { e.stopPropagation(); dismiss(); });
    toast.addEventListener('click', () => { dismiss(); if (href) window.location.href = href; });
    setTimeout(dismiss, duration);
  }

  // key = dedup id (e.g. notification relatedId) — skips a repeat toast if
  // two independent pollers (a page-local one + the site-wide notification
  // poller) both notice the same event.
  function toastOnce(key: string | undefined, title: string, body: string, duration?: number, href?: string, tone?: string) {
    if (key) {
      if (shownKeys.has(key)) return;
      shownKeys.add(key);
    }
    showToast(title, body, duration, href, tone);
  }

  window.addEventListener('toast:show', (e: Event) => {
    const { title = '', body = '', duration, href, key, tone } = (e as CustomEvent<{ title: string; body: string; duration?: number; href?: string; key?: string; tone?: string }>).detail;
    toastOnce(key, title, body, duration, href, tone);
  });

  (window as unknown as { showToast: typeof showToast }).showToast = showToast;
  (window as unknown as { toastOnce: typeof toastOnce }).toastOnce = toastOnce;

  // Replay anything an early is:inline script (BaseLayout.astro) buffered before
  // this module script — which only runs once the document has parsed and its own
  // JS chunk has loaded — had a chance to attach the listener above. toastOnce's
  // key-based dedup makes this safe even if the live listener above already caught
  // the same event in the meantime.
  type QueuedToast = { title: string; body: string; duration?: number; href?: string; key?: string; tone?: string };
  const queue = (window as unknown as { __toastQueue?: QueuedToast[] }).__toastQueue;
  if (Array.isArray(queue)) {
    queue.splice(0).forEach((d) => toastOnce(d.key, d.title, d.body, d.duration, d.href, d.tone));
  }
</script>
