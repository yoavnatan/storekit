---
// ToastContainer — listens to `toast:show` CustomEvent
// Event detail: { title: string, body: string, duration?: number }
---

<div
  id="toast-container"
  class="toast-container"
  aria-live="polite"
  aria-atomic="false"
></div>

<script>
  const container = document.getElementById('toast-container')!;
  const shownKeys = new Set<string>();

  function esc(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function showToast(title: string, body: string, duration = 5000, href?: string) {
    const toast = document.createElement('div');
    toast.setAttribute('role', 'status');
    toast.className = 'toast-card';
    toast.style.pointerEvents = 'auto';

    toast.innerHTML = `
      <div class="toast-card__icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <div class="toast-card__title">${esc(title)}</div>
        ${body ? `<div class="toast-card__body">${esc(body)}</div>` : ''}
      </div>
      <button class="toast-close" aria-label="סגור">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>`;

    container.prepend(toast);

    toast.animate(
      [{ opacity: 0, transform: 'translateY(12px) scale(0.96)' },
       { opacity: 1, transform: 'translateY(0) scale(1)' }],
      { duration: 260, easing: 'cubic-bezier(0.34,1.56,0.64,1)', fill: 'forwards' }
    );

    const dismiss = () => {
      toast.animate(
        [{ opacity: 1, transform: 'scale(1)' },
         { opacity: 0, transform: 'scale(0.94)' }],
        { duration: 160, easing: 'ease-in', fill: 'forwards' }
      ).onfinish = () => toast.remove();
    };

    toast.querySelector('button')!.addEventListener('click', (e) => { e.stopPropagation(); dismiss(); });
    toast.addEventListener('click', () => { dismiss(); if (href) window.location.href = href; });
    setTimeout(dismiss, duration);
  }

  // key = dedup id (e.g. notification relatedId) — skips a repeat toast if
  // two independent pollers (a page-local one + the site-wide notification
  // poller) both notice the same event.
  function toastOnce(key: string | undefined, title: string, body: string, duration?: number, href?: string) {
    if (key) {
      if (shownKeys.has(key)) return;
      shownKeys.add(key);
    }
    showToast(title, body, duration, href);
  }

  window.addEventListener('toast:show', (e: Event) => {
    const { title = '', body = '', duration, href, key } = (e as CustomEvent<{ title: string; body: string; duration?: number; href?: string; key?: string }>).detail;
    toastOnce(key, title, body, duration, href);
  });

  (window as unknown as { showToast: typeof showToast }).showToast = showToast;
  (window as unknown as { toastOnce: typeof toastOnce }).toastOnce = toastOnce;
</script>
