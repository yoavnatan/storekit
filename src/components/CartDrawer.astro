---
/** CartDrawer — global cart grouped by store. Each store has its own checkout. */
---

<div id="cart-overlay" class="cart-overlay"></div>
<aside id="cart-drawer" class="cart-drawer" aria-label="Shopping cart" aria-hidden="true">
  <header class="cart-drawer__head flex between">
    <h2>Your cart</h2>
    <button id="cart-close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </header>
  <div id="cart-lines" class="cart-drawer__lines"></div>
</aside>


<script>
  import { getActiveStoreCarts, getSubtotal, getGrandTotal, setQty, removeItem } from '../lib/cart.js';
  import { formatPrice } from '../config/store.config.js';

  const drawer  = document.getElementById('cart-drawer') as HTMLElement | null;
  const overlay = document.getElementById('cart-overlay') as HTMLElement | null;
  const lines   = document.getElementById('cart-lines') as HTMLElement | null;

  const esc = (s: unknown) =>
    String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  function open() {
    drawer?.classList.add('is-open');
    overlay?.classList.add('is-open');
    drawer?.removeAttribute('aria-hidden');
    render();
  }

  function close() {
    drawer?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
  }

  function placeholderSvg() {
    return `<div class="cart-line__img-placeholder" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div>`;
  }

  function render() {
    if (!lines) return;
    const carts = getActiveStoreCarts();
    if (!carts.length) {
      lines.innerHTML = '<p class="cart-empty">Your cart is empty</p>';
      return;
    }

    const grandTotal = getGrandTotal();

    lines.innerHTML = carts.map((c) => `
      <div class="cart-store-group" data-store-slug="${esc(c.storeSlug)}">
        <div class="cart-store-group__head">
          <a href="/store/${esc(c.storeSlug)}" class="cart-store-group__name">${esc(c.storeName)}</a>
          <span class="cart-store-group__count">${c.count} item${c.count !== 1 ? 's' : ''}</span>
        </div>
        <div class="cart-store-group__items">
          ${c.items.map((i) => `
            <div class="cart-line" data-item-slug="${esc(i.slug)}" data-store-slug="${esc(c.storeSlug)}">
              ${i.image
                ? `<img src="${esc(i.image)}" alt="${esc(i.name)}" width="56" height="56" loading="lazy" decoding="async">`
                : placeholderSvg()}
              <div class="cart-line__info">
                <strong>${esc(i.name)}</strong>
                <div>${formatPrice(i.price)}</div>
                <div class="cart-line__qty">
                  <button data-act="dec" data-slug="${esc(i.slug)}" data-store="${esc(c.storeSlug)}">−</button>
                  <span>${i.qty}</span>
                  <button data-act="inc" data-slug="${esc(i.slug)}" data-store="${esc(c.storeSlug)}">+</button>
                  <button data-act="rm" data-slug="${esc(i.slug)}" data-store="${esc(c.storeSlug)}" data-name="${esc(i.name)}" aria-label="Remove" style="margin-inline-start:auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </div>
            </div>`).join('')}
        </div>
        <div class="cart-store-group__foot">
          <div class="flex between" style="font-size:0.88rem">
            <span>Subtotal</span>
            <strong>${formatPrice(getSubtotal(c.storeSlug))}</strong>
          </div>
          <a href="/checkout?store=${esc(c.storeSlug)}" class="btn cart-checkout">
            Checkout — ${esc(c.storeName)}
          </a>
        </div>
      </div>`).join('<hr class="cart-store-divider">') +
      (carts.length > 1 ? `
        <div class="cart-grand-total">
          <div class="cart-grand-total__row">
            <span>Total (${carts.length} stores)</span>
            <strong>${formatPrice(grandTotal)}</strong>
          </div>
          <a href="/checkout?stores=all" class="btn cart-checkout">
            Pay all stores
          </a>
        </div>` : '');
  }

  lines?.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    const btn = e.target.closest<HTMLButtonElement>('button[data-act]');
    if (!btn) return;
    const slug  = btn.dataset.slug ?? '';
    const store = btn.dataset.store ?? '';
    const name  = btn.dataset.name ?? slug;
    if (!slug || !store) return;

    const storeCart = getActiveStoreCarts().find((c) => c.storeSlug === store);
    const item = storeCart?.items.find((i) => i.slug === slug);

    if (btn.dataset.act === 'inc' && item) setQty(store, slug, item.qty + 1);
    if (btn.dataset.act === 'dec' && item) setQty(store, slug, item.qty - 1);
    if (btn.dataset.act === 'rm') {
      window.dispatchEvent(new CustomEvent('confirm:open', {
        detail: {
          title: 'Remove item?',
          message: `Remove "${name}" from your cart?`,
          okLabel: 'Remove',
          onConfirm: () => removeItem(store, slug),
        },
      }));
    }
  });

  document.getElementById('cart-close')?.addEventListener('click', close);
  overlay?.addEventListener('click', close);
  window.addEventListener('cart:open', open);
  window.addEventListener('cart:change', render);
</script>
