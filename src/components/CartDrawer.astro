---
/** CartDrawer — global cart grouped by store. Each store has its own checkout. */
---

<div id="cart-overlay" class="cart-overlay"></div>
<aside id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" aria-hidden="true">
  <header class="cart-drawer__head flex between">
    <h2 id="cart-drawer-title">Cart</h2>
    <button id="cart-close" aria-label="Close cart">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </header>
  <div id="cart-lines" class="cart-drawer__lines"></div>
</aside>


<script>
  import { getActiveStoreCarts, getSubtotal, getGrandTotal, setQtyQuiet, removeItem } from '../lib/cart.js';
  import { formatPrice } from '../config/store.config.js';
  import { spawnRipple } from '../lib/ripple.js';

  function getI18n() {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}'); } catch { return {}; }
  }

  const drawer  = document.getElementById('cart-drawer') as HTMLElement | null;
  const overlay = document.getElementById('cart-overlay') as HTMLElement | null;
  const lines   = document.getElementById('cart-lines') as HTMLElement | null;
  const titleEl = document.getElementById('cart-drawer-title') as HTMLElement | null;

  const esc = (s: unknown) =>
    String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  let prevFocus: HTMLElement | null = null;
  let suppressNextRender = false;

  function getFocusable(): HTMLElement[] {
    if (!drawer) return [];
    return Array.from(
      drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])')
    );
  }

  function trapFocus(e: KeyboardEvent) {
    if (drawer?.getAttribute('aria-hidden') === 'true') return;
    if (e.key === 'Escape') { close(); return; }
    if (e.key !== 'Tab') return;
    const focusable = getFocusable();
    if (!focusable.length) return;
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  }

  function open() {
    prevFocus = document.activeElement as HTMLElement;
    drawer?.classList.add('is-open');
    overlay?.classList.add('is-open');
    drawer?.removeAttribute('aria-hidden');
    document.getElementById('cart-toggle')?.setAttribute('aria-expanded', 'true');
    render();
    requestAnimationFrame(() => {
      (document.getElementById('cart-close') as HTMLButtonElement | null)?.focus();
    });
  }

  function close() {
    drawer?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    document.getElementById('cart-toggle')?.setAttribute('aria-expanded', 'false');
    prevFocus?.focus();
    prevFocus = null;
  }

  document.addEventListener('keydown', trapFocus);

  function placeholderSvg() {
    return `<div class="cart-line__img-placeholder" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div>`;
  }

  function getCurrentStoreSlug(): string | null {
    const match = window.location.pathname.match(/^\/store\/([^/]+)/);
    return match ? match[1] : null;
  }

  function render() {
    if (!lines) return;
    const i18n = getI18n().cart ?? {};
    const allCarts = getActiveStoreCarts();
    const currentSlug = getCurrentStoreSlug();
    const carts = currentSlug
      ? [...allCarts].sort((a, b) => {
          if (a.storeSlug === currentSlug) return -1;
          if (b.storeSlug === currentSlug) return 1;
          return 0;
        })
      : allCarts;

    if (titleEl) titleEl.textContent = i18n.title ?? 'Cart';
    const closeBtn = document.getElementById('cart-close');
    if (closeBtn) closeBtn.setAttribute('aria-label', i18n.closeCart ?? 'Close cart');

    if (!carts.length) {
      lines.innerHTML = `<p class="cart-empty">${i18n.empty ?? 'Your cart is empty'}</p>`;
      return;
    }

    const grandTotal = getGrandTotal();

    lines.innerHTML = carts.map((c) => `
      <div class="cart-store-group" data-store-slug="${esc(c.storeSlug)}">
        <div class="cart-store-group__head">
          <a href="/store/${esc(c.storeSlug)}" class="cart-store-group__name">${esc(c.storeName)}</a>
          <span class="cart-store-group__count">${c.count} ${c.count !== 1 ? (i18n.items ?? 'items') : (i18n.item ?? 'item')}</span>
        </div>
        <div class="cart-store-group__items">
          ${c.items.map((i) => {
              const key = i.cartKey ?? i.slug;
              const variantLine = i.selectedVariants && Object.keys(i.selectedVariants).length
                ? `<div style="font-size:0.72rem;color:var(--color-muted);margin-top:0.1rem">${Object.entries(i.selectedVariants).map(([k, v]) => `${esc(k)}: ${esc(v)}`).join(' · ')}</div>`
                : '';
              return `
            <div class="cart-line cart-line--link" data-item-slug="${esc(key)}" data-product-slug="${esc(i.slug)}" data-store-slug="${esc(c.storeSlug)}" data-store-name="${esc(c.storeName)}">
              ${i.image
                ? `<img src="${esc(i.image)}" alt="${esc(i.name)}" width="56" height="56" loading="eager">`
                : placeholderSvg()}
              <div class="cart-line__info">
                <strong>${esc(i.name)}</strong>
                ${variantLine}
                <div class="cart-line__footer">
                  <span class="cart-line__price">${formatPrice(i.price)}</span>
                  <div class="cart-line__qty" dir="ltr">
                    <button data-act="dec" data-slug="${esc(key)}" data-store="${esc(c.storeSlug)}" aria-label="${esc(i18n.qtyDecrease ?? 'Decrease quantity')} ${esc(i.name)}" ${i.qty <= 1 ? 'disabled' : ''}>−</button>
                    <span aria-live="polite" aria-atomic="true">${i.qty}</span>
                    <button data-act="inc" data-slug="${esc(key)}" data-store="${esc(c.storeSlug)}" data-stock="${i.stock ?? ''}" aria-label="${esc(i18n.qtyIncrease ?? 'Increase quantity')} ${esc(i.name)}" ${i.stock != null && i.qty >= i.stock ? 'disabled' : ''}>+</button>
                  </div>
                  <button data-act="rm" data-slug="${esc(key)}" data-store="${esc(c.storeSlug)}" data-name="${esc(i.name)}" aria-label="${esc(i18n.removeOk ?? 'Remove')} ${esc(i.name)}" class="cart-line__rm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  </button>
                </div>
              </div>
            </div>`;
            }).join('')}
        </div>
        <div class="cart-store-group__foot">
          <div class="flex between" style="font-size:0.88rem">
            <span>${i18n.subtotal ?? 'Subtotal'}</span>
            <strong>${formatPrice(getSubtotal(c.storeSlug))}</strong>
          </div>
          <a href="/checkout?store=${esc(c.storeSlug)}" class="btn btn--accent cart-checkout">
            ${i18n.checkout ?? 'Checkout'} — ${esc(c.storeName)}
          </a>
        </div>
      </div>`).join('<hr class="cart-store-divider">') +
      (carts.length > 1 ? `
        <div class="cart-grand-total">
          <div class="cart-grand-total__row">
            <span>${i18n.total ?? 'Total'} (${carts.length} ${i18n.stores ?? 'stores'})</span>
            <strong>${formatPrice(grandTotal)}</strong>
          </div>
          <a href="/checkout" class="btn btn--accent cart-checkout">
            ${i18n.payAll ?? 'Pay all stores'}
          </a>
        </div>` : '');
  }

  lines?.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    const btn = e.target.closest<HTMLButtonElement>('button[data-act]');
    if (!btn) {
      const line = e.target.closest<HTMLElement>('.cart-line--link');
      if (line) {
        const productSlug = line.dataset.productSlug ?? '';
        const storeSlug   = line.dataset.storeSlug   ?? '';
        const storeName   = line.dataset.storeName    ?? '';
        if (productSlug && storeSlug) {
          window.dispatchEvent(new CustomEvent('pqv:open', { detail: { storeSlug, productSlug, storeName } }));
        }
      }
      return;
    }
    const key   = btn.dataset.slug ?? '';
    const store = btn.dataset.store ?? '';
    const name  = btn.dataset.name ?? key;
    if (!key || !store) return;

    const i18n = getI18n().cart ?? {};

    if (btn.dataset.act === 'inc' || btn.dataset.act === 'dec') {
      const storeCart = getActiveStoreCarts().find((c) => c.storeSlug === store);
      const item = storeCart?.items.find((i) => (i.cartKey ?? i.slug) === key);
      if (!item) return;

      const stockLimit = btn.dataset.act === 'inc' && btn.dataset.stock
        ? parseInt(btn.dataset.stock, 10)
        : Infinity;
      const newQty = btn.dataset.act === 'inc' ? item.qty + 1 : item.qty - 1;
      if (newQty <= 0) {
        removeItem(store, key);
        return;
      }
      if (btn.dataset.act === 'inc' && newQty > stockLimit) return;

      setQtyQuiet(store, key, newQty);

      const qtyRow = btn.closest('.cart-line__qty');
      const qtySpan = qtyRow?.querySelector<HTMLElement>('[aria-live]');
      if (qtySpan) qtySpan.textContent = String(newQty);

      const decBtn = qtyRow?.querySelector<HTMLButtonElement>('[data-act="dec"]');
      const incBtn = qtyRow?.querySelector<HTMLButtonElement>('[data-act="inc"]');
      if (decBtn) decBtn.disabled = newQty <= 1;
      if (incBtn) incBtn.disabled = isFinite(stockLimit) && newQty >= stockLimit;

      const storeGroup = btn.closest<HTMLElement>('.cart-store-group');
      const countEl = storeGroup?.querySelector<HTMLElement>('.cart-store-group__count');
      if (countEl) {
        const freshCart = getActiveStoreCarts().find((c) => c.storeSlug === store);
        if (freshCart) countEl.textContent = `${freshCart.count} ${freshCart.count !== 1 ? (i18n.items ?? 'items') : (i18n.item ?? 'item')}`;
      }
      const subtotalEl = storeGroup?.querySelector<HTMLElement>('.cart-store-group__foot .flex.between strong');
      if (subtotalEl) subtotalEl.textContent = formatPrice(getSubtotal(store));
      const grandEl = lines?.querySelector<HTMLElement>('.cart-grand-total__row strong');
      if (grandEl) grandEl.textContent = formatPrice(getGrandTotal());

      suppressNextRender = true;
      window.dispatchEvent(new CustomEvent('cart:change'));
      return;
    }

    if (btn.dataset.act === 'rm') {
      window.dispatchEvent(new CustomEvent('confirm:open', {
        detail: {
          title: i18n.removeTitle ?? 'Remove item?',
          message: `${i18n.removeMsg ?? 'Remove from your cart?'} "${name}"`,
          okLabel: i18n.removeOk ?? 'Remove',
          onConfirm: () => removeItem(store, key),
        },
      }));
    }
  });

  document.getElementById('cart-close')?.addEventListener('click', close);
  overlay?.addEventListener('click', close);
  window.addEventListener('cart:open', open);
  window.addEventListener('cart:change', () => {
    if (suppressNextRender) { suppressNextRender = false; return; }
    render();
  });

  drawer?.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button:not([disabled]), a.btn');
    if (btn) spawnRipple(btn, e.clientX, e.clientY);
  });

</script>
