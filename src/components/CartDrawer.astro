---
/** CartDrawer — slide-in panel showing cart contents. Pure client-side. */
import { store } from '../config/store.config.js';
---

<div id="cart-overlay" class="cart-overlay" hidden></div>
<aside id="cart-drawer" class="cart-drawer" aria-label="Shopping cart" hidden>
  <header class="cart-drawer__head flex between">
    <h2>Your cart</h2>
    <button id="cart-close" aria-label="Close"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </header>
  <div id="cart-lines" class="cart-drawer__lines"></div>
  <footer class="cart-drawer__foot">
    <div class="flex between">
      <span>Subtotal</span>
      <strong id="cart-subtotal">{store.business.currencySymbol}0</strong>
    </div>
    <a href="/checkout" class="btn cart-checkout">Proceed to checkout</a>
  </footer>
</aside>

<style>
  .cart-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 90;
  }
  .cart-drawer {
    position: fixed;
    top: 0; bottom: 0;
    inset-inline-start: 0;
    width: min(380px, 90vw);
    background: var(--color-bg);
    z-index: 100;
    display: flex;
    flex-direction: column;
    box-shadow: 0 0 40px rgba(0,0,0,0.2);
  }
  .cart-drawer__head { padding: 1rem; border-bottom: 1px solid var(--color-border); }
  .cart-drawer__lines { flex: 1; overflow-y: auto; padding: 1rem; }
  .cart-drawer__foot { padding: 1rem; border-top: 1px solid var(--color-border); display: grid; gap: 0.75rem; }
  .cart-checkout { width: 100%; }
  .cart-line { display: flex; gap: 0.75rem; padding: 0.6rem 0; border-bottom: 1px solid var(--color-border); }
  .cart-line img { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; background: var(--color-surface); }
  .cart-line__info { flex: 1; }
  .cart-line__qty { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.3rem; }
  .cart-line__qty button { width: 26px; height: 26px; border: 1px solid var(--color-border); border-radius: 6px; }
  .cart-empty { color: var(--color-muted); text-align: center; padding: 2rem 0; }
</style>

<script>
  import { getItems, getSubtotal, setQty, removeItem } from '../lib/cart.js';
  import { formatPrice } from '../config/store.config.js';

  /** @type {(s: unknown) => string} */
  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  const drawer = document.getElementById('cart-drawer');
  const overlay = document.getElementById('cart-overlay');
  const lines = document.getElementById('cart-lines');
  const subtotalEl = document.getElementById('cart-subtotal');

  function open() {
    if (!drawer || !overlay) return;
    drawer.hidden = false;
    overlay.hidden = false;
    render();
  }

  function close() {
    if (!drawer || !overlay) return;
    drawer.hidden = true;
    overlay.hidden = true;
  }

  function render() {
    if (!lines || !subtotalEl) return;
    const items = getItems();
    if (!items.length) {
      lines.innerHTML = '<p class="cart-empty">Your cart is empty</p>';
    } else {
      lines.innerHTML = items.map((i) => `
        <div class="cart-line">
          <img src="${esc(i.image)}" alt="${esc(i.name)}" />
          <div class="cart-line__info">
            <strong>${esc(i.name)}</strong>
            <div>${formatPrice(i.price)}</div>
            <div class="cart-line__qty">
              <button data-act="dec" data-slug="${esc(i.slug)}">−</button>
              <span>${i.qty}</span>
              <button data-act="inc" data-slug="${esc(i.slug)}">+</button>
              <button data-act="rm" data-slug="${esc(i.slug)}" aria-label="Remove" style="margin-inline-start:auto"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
            </div>
          </div>
        </div>`).join('');
    }
    subtotalEl.textContent = formatPrice(getSubtotal());
  }

  lines?.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    const btn = /** @type {HTMLButtonElement | null} */ (e.target.closest('button[data-act]'));
    if (!btn) return;
    const slug = btn.dataset.slug;
    if (!slug) return;
    const item = getItems().find((i) => i.slug === slug);
    if (!item) return;
    if (btn.dataset.act === 'inc') setQty(slug, item.qty + 1);
    if (btn.dataset.act === 'dec') setQty(slug, item.qty - 1);
    if (btn.dataset.act === 'rm') removeItem(slug);
  });

  document.getElementById('cart-close')?.addEventListener('click', close);
  overlay?.addEventListener('click', close);
  window.addEventListener('cart:open', open);
  window.addEventListener('cart:change', render);
</script>
