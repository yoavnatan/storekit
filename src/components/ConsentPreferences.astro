---
/** The cookie off-switch — the ONE place it exists, inside the cookies clause of `/privacy`.
 *
 *  **Why it is here and not in the footer or on the notice bar.** The owner asked that turning
 *  cookies off not be an easy click (2026-08-25: *"שלא יהיה שם כפתור כיבוי (כל עוד זה חוקי) פשוט
 *  שקל ללחוץ עליו"*), and under the Israeli model that is a legitimate choice: there is no
 *  cookie-banner duty and no opt-in requirement, and consent may be implied from conduct where the
 *  privacy policy discloses clearly (`lib/consent.ts`, `docs/legal-privacy-accessibility.md` §4).
 *
 *  **The parenthesis in that instruction is the constraint, and this component IS the floor.**
 *  What makes implied consent lawful rather than merely customary is that the disclosure is
 *  published and the control is genuinely reachable. It is: the footer links `/privacy` from every
 *  page, and this sits in that page's cookies clause beside the text explaining it. Not prominent,
 *  always reachable. **Moving it behind a further click, an account, or a mail to support crosses
 *  from "not easy" into "not available", which is the one version of this that fails.**
 *
 *  Display only — `lib/consent.ts` decides what a preference means and `scripts/consent.ts`
 *  records it.
 */
import { getLang, getT } from '../i18n/index.js';

const t = getT(getLang(Astro.cookies));
const c = t.consent;
---

<div id="consent-prefs" class="mt-3 rounded-[var(--radius)] border [border-color:var(--color-border)] p-3">
  <p class="m-0 text-[0.86rem] font-semibold">{c.prefsTitle}</p>

  {/* Both boxes render UNCHECKED and are ticked by the script from the live cookie. Server-side
      they cannot be pre-ticked correctly for a visitor with no preference recorded without this
      page having to vary by cookie in a way its cache would then have to respect — and a control
      that shows the wrong state for a moment is worse here than one that settles a tick later. */}
  <label class="mt-3 flex items-start gap-2 text-[0.84rem] cursor-pointer">
    <input type="checkbox" id="consent-analytics" class="mt-1" />
    <span>
      <span class="font-semibold">{c.analytics}</span>
      <span class="muted block">{c.analyticsHint}</span>
    </span>
  </label>
  <label class="mt-2 flex items-start gap-2 text-[0.84rem] cursor-pointer">
    <input type="checkbox" id="consent-ads" class="mt-1" />
    <span>
      <span class="font-semibold">{c.ads}</span>
      <span class="muted block">{c.adsHint}</span>
    </span>
  </label>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button type="button" class="btn btn--ghost btn--sm" id="consent-save">{c.save}</button>
    {/* `hidden` until it is true, and `aria-live` so a screen reader hears the confirmation — the
        only feedback this control gives when nothing was turned off and no reload follows. */}
    <span class="muted text-[0.8rem]" id="consent-saved" aria-live="polite" hidden>{c.saved}</span>
  </div>
</div>

<script>
  import { initConsentPreferences } from '../scripts/consent.js';
  initConsentPreferences();
</script>
