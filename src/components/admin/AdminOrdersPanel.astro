---
// Cards-only orders list (same shape as the seller dashboard's orders tab —
// see AI_INSTRUCTIONS.md → Dashboard sort/filter toolbar), reporting-only:
// admin never edits shipping status/tracking here, that's the seller's job.
// Shared .order-card*/.orders-toolbar CSS lives in dashboard.css (moved
// 2026-07-14) so this and the seller dashboard's own markup render identically
// without duplicating styles. Sort/filter only covers fields with real
// signal for a cross-store admin view (date, amount, shipping/payment
// status) — phone number etc. stay search-only, same call the seller
// dashboard's own orders tab already made for itself.
import { cdnThumb } from '../../config/store.config.js';
import { formatAgorot } from '../../lib/money.js';
import type { Order } from '../../lib/orders.js';
import { formatHeDateTime } from '../../lib/format-date.js';
import { orderAgeChipHtml } from '../../lib/order-age.js';
import { groupBuyerPurchases } from '../../lib/buyer-purchases.js';
import { orderPayoutLine, payoutWhyText, type PayoutWhyKey } from '../../lib/order-payout-line.js';
import { formatBusinessDayLabel } from '../../lib/format-date.js';
import type { AdminOrderSortCol, AdminOrderSortDir } from '../../lib/admin-orders-filter.js';
import { buildAdminUrl } from '../../lib/admin-nav.js';
import { businessDayISO } from '../../lib/business-day.js';
import AdminPager from './AdminPager.astro';
import AdminNewBadge from './AdminNewBadge.astro';
import AdminNewOnlyToggle from './AdminNewOnlyToggle.astro';

interface Props {
  orders: Order[]; // current page only
  totalAll: number;
  totalFiltered: number;
  q: string;
  sortCol: AdminOrderSortCol;
  sortDir: AdminOrderSortDir;
  shippingStatus: string[];
  paymentStatus: string[];
  store: string[];
  /** Where each order's money stands — the filter the seller's tab always had (opayout). */
  payout: string[];
  storeNames: string[]; // every store name across all orders, for the filter dropdown
  newSince: string;  // ISO — anything created after this is what the tab's "(N)" counted
  newOnly: boolean;
  newCount: number;
  page: number;
  totalPages: number;
  buildUrl: (page: number) => string;
}
const {
  orders, totalAll, totalFiltered, q, sortCol, sortDir, shippingStatus, paymentStatus, store, payout, storeNames,
  newSince, newOnly, newCount, page, totalPages, buildUrl,
} = Astro.props;

/**
 * This purchase's own money trail (`?panel=moneylog&mq=<ref>`).
 *
 * The window is named rather than left to the journal's 30-day default, and that is the whole
 * difference between a link that works and one that answers "no events" for every order older than
 * a month: nothing about this purchase can have happened before the purchase, so its own day is the
 * correct `from` and there is no reason to hide anything after it.
 *
 * The ref matches either spelling — `buyer-purchases.ts` uses the checkout reference when there is
 * one and the order id's first 8 characters otherwise, and the journal's search is `ILIKE` over both
 * `checkout_ref` and `order_id` (moneylog-search.ts), so the uppercased fallback still finds its
 * rows.
 */
const moneyLogHref = (ref: string, createdAt: string): string =>
  buildAdminUrl('moneylog', { mq: ref, mfrom: businessDayISO(new Date(createdAt)) });

/**
 * The hold reason, in the admin's language.
 *
 * Hebrew literals rather than `getT`, like every other string on this admin surface — the admin
 * dashboard is Hebrew-only by construction (`i18n-hardcoded-strings.test.ts` treats a file with no
 * `getT(` as exactly that).
 *
 * The `{n}` is NOT written out here: `payoutWhyText` fills it from the line's own `whyDays`, which
 * come from `payout-schedule.ts`. Those constants are still owner decisions, and a sentence
 * promising 21 days while the code waits 30 is a promise we break.
 */
const PAYOUT_WHY: Record<PayoutWhyKey, string> = {
  payWhyDelivery: 'חלון ההחזרה של הקונה — {n} ימים מהמסירה',
  payWhyPayment: 'ההזמנה לא סומנה כנמסרה — {n} ימים מיום התשלום',
  payWhyUnshipped: 'ההזמנה עוד לא נשלחה',
  payWhyUnknown: 'ההזמנה בבדיקה',
};

const shippingLabel: Record<string, string> = {
  pending: 'חדשה', processing: 'בטיפול', ready: 'ממתין לאיסוף', shipped: 'נשלח', delivered: 'נמסר',
};
const shippingColor: Record<string, string> = {
  pending: '#ef4444', processing: '#3b82f6', ready: '#f59e0b', shipped: '#8b5cf6', delivered: '#16a34a',
};
const paymentLabel: Record<string, string> = {
  pending: 'ממתין', paid: 'שולם', failed: 'נכשל',
};

const sortLabels: Record<string, string> = {
  'date:desc': 'תאריך: חדש — ישן',
  'date:asc': 'תאריך: ישן — חדש',
  'amount:desc': 'סכום: גבוה — נמוך',
  'amount:asc': 'סכום: נמוך — גבוה',
  'shippingStatus:asc': 'סטטוס משלוח: הזמנות חדשות קודם',
};
const activeFilterCount = [shippingStatus, paymentStatus, store, payout].filter((s) => s.length > 0).length;

// The page's rows, grouped back into the purchases they came from. `getAdminOrdersPage` already
// paged BY purchase and returned the rows in that page order, so this only has to re-assemble them
// — it can neither split a purchase across pages nor reorder the page, and `groupBuyerPurchases`
// preserves first-seen order for exactly that reason.
const purchases = groupBuyerPurchases(orders);
---

<div class="admin-orders-search">
  <input type="search" id="admin-order-search" class="input" value={q} placeholder="חיפוש לפי מספר הזמנה, שם, מייל, טלפון או חנות..." aria-label="חיפוש הזמנה" />
</div>

{totalAll === 0 ? (
  <p class="admin-empty">אין הזמנות עדיין.</p>
) : (
  <Fragment>
    <div class="flex flex-col items-start mb-4 gap-[0.6rem]">
      <div
        class="flex flex-wrap items-center gap-2"
        id="admin-orders-toolbar"
        data-sort-col={sortCol}
        data-sort-dir={sortDir}
        data-ship={shippingStatus.join(',')}
        data-pay={paymentStatus.join(',')}
        data-store={store.join(',')}
        data-payout={payout.join(',')}
        data-store-names={JSON.stringify(storeNames)}
        data-new-only={newOnly ? '1' : ''}
      >
        <button type="button" id="admin-orders-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
          <span id="admin-orders-sort-label">{sortLabels[`${sortCol}:${sortDir}`] ?? sortLabels['date:desc']}</span>
          <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <button type="button" id="admin-orders-filter-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="true" aria-expanded="false">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          <span>סינון לפי</span>
          <span id="admin-orders-filter-count" class="filter-count-badge inline-flex items-center justify-center min-w-4 h-4 px-1 rounded-full bg-[color:var(--color-primary)] text-white text-[.68rem] font-bold leading-none" hidden={activeFilterCount === 0}>{activeFilterCount}</span>
          <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        {(newCount > 0 || newOnly) && <AdminNewOnlyToggle id="admin-orders-new-toggle" active={newOnly} count={newCount} label="שלא נצפו בלבד" />}
      </div>
    </div>

    {totalFiltered === 0 && <p class="admin-empty">לא נמצאו הזמנות תואמות.</p>}

    <AdminPager position="top" page={page} totalPages={totalPages} buildUrl={buildUrl} />

    <div class="flex flex-col gap-3" id="admin-orders-list">
      {purchases.map((purchase) => {
        // ── One card per PURCHASE (owner, 2026-08-07) ──
        // `orders` arrives as rows, and a multi-store cart is several of them naming one checkout.
        // The tab used to give each row its own card: five cards, five order numbers and five
        // totals for one thing the buyer bought once. Grouped through `groupBuyerPurchases` — the
        // function the BUYER's own orders page already renders from — so the admin and the buyer
        // cannot end up describing the same purchase differently. The page is already paged by
        // purchase (orders.ts#getAdminOrdersPage), so a group is never cut by a page boundary.
        const rows = purchase.slices.map((s) => s.order);
        // The first row answers for the buyer: name, address and phone are copied onto every slice
        // of one checkout by checkout.ts, so they cannot disagree.
        const o = rows[0]!;
        const allItems = rows.flatMap((r) => r.items);
        const uniqueStores = [...new Map(allItems.map((i) => [i.storeSlug, i.storeName] as const)).entries()]
          .map(([slug, name]) => ({ slug, name }));
        const itemCount = allItems.length;
        const productsLabel = itemCount === 1 ? 'מוצר אחד' : `${itemCount} מוצרים`;
        const storesLabel = uniqueStores.length === 1 ? 'חנות אחת' : `${uniqueStores.length} חנויות`;
        const split = purchase.slices.length > 1;
        /**
         * Do the stores of this purchase actually DISAGREE about where it is up to?
         *
         * A multi-store purchase is several order rows, so it has several statuses — that is the
         * model, not a display accident: each seller fulfils, ships and cancels on their own, and
         * one status could only ever be the least advanced of them. But when they all say the same
         * thing, printing it once per store repeats the badge in the card's header three times over
         * and the card reads as "so many statuses" for a single purchase (owner, 2026-08-11).
         *
         * So the per-store badge is what it was always FOR: the mark of a disagreement. Agreeing
         * slices show the store name and its share, and let the header's one badge speak for all of
         * them. Nothing is hidden — a card with per-store badges is exactly a card where they differ.
         */
        const slicesDisagree = new Set(purchase.slices.map((s) => s.order.shippingStatus)).size > 1;
        // What the buyer paid for the whole cart. `purchase.totalAgorot` is the sum of the slices,
        // from the same function the buyer's card reads — never a re-derivation here.
        const totalAgorot = purchase.totalAgorot;
        const shippingAgorot = rows.reduce((sum, r) => sum + r.shippingAgorot, 0);
        // The least-advanced LIVE slice. An order with one store delivered and four still pending
        // is a pending order, and it reads as cancelled only when every slice is (buyer-purchases).
        const headlineStatus = purchase.status;
        // The card is "new" if ANY slice is, and the badge above the tab counts the same way
        // (order-reporting.ts#countOrdersSince counts DISTINCT purchases).
        const newestAt = rows.reduce((latest, r) => (r.createdAt > latest ? r.createdAt : latest), rows[0]!.createdAt);
        return (
          <div
            class="order-card @container/ordcard group border-[1.5px] border-[color:var(--color-border)] rounded-[var(--radius)] overflow-visible bg-[color:var(--color-surface)] transition-[border-color] duration-150 hover:border-[color:color-mix(in_srgb,var(--color-text)_20%,var(--color-border))]"
            data-order-id={o.id}
            data-shipping-status={headlineStatus}
            data-payment-status={o.paymentStatus}
          >
            <div class="order-card__header grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-2 @[640px]/ordcard:flex @[640px]/ordcard:gap-3 px-4 py-[0.875rem] cursor-pointer select-none rounded-[calc(var(--radius)-1.5px)] group-data-[open]:rounded-b-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-[color:var(--color-accent)] focus-visible:[outline-offset:-2px]" role="button" tabindex="0" aria-expanded="false">
              {/* In the desktop row: fixed width (not min-width) so the buyer name in
                  the next column always starts at the same x across every card —
                  id/date only; the age chip lives in the status cluster below so its
                  variable length can't squeeze this column (owner feedback). In the
                  narrow grid there is no fixed width: the grid's first column already
                  sizes to this content, and 5rem of it wrapped the date onto a second
                  line. */}
              <div class="flex flex-col items-start gap-[0.2rem] @[640px]/ordcard:w-28 shrink-0 [grid-area:1/1]">
                <span class="order-card__id text-[0.8rem] font-bold text-[color:var(--color-text)] font-mono">#{purchase.ref.toUpperCase()}</span>
                <span class="text-[0.72rem] text-[color:var(--color-muted)] whitespace-nowrap">{formatHeDateTime(purchase.createdAt)}</span>
              </div>
              <div class="contents @[640px]/ordcard:flex @[640px]/ordcard:flex-1 @[640px]/ordcard:items-center @[640px]/ordcard:gap-3 @[640px]/ordcard:min-w-0">
                <div class="flex flex-col min-w-0 flex-1 gap-[0.15rem] [grid-area:1/2]">
                  <span class="flex items-center gap-1.5 min-w-0">
                    <span class="text-sm font-semibold text-[color:var(--color-text)] truncate">{o.buyerName}</span>
                    {newestAt > newSince && <AdminNewBadge label="לא נצפתה" />}
                  </span>
                  <span class="text-[0.72rem] text-[color:var(--color-muted)] truncate">{productsLabel} · {storesLabel}</span>
                </div>
                {/* Trailing at ≥640px OF THE CARD (a container query, not the viewport —
                    this panel sits beside the admin sidebar, so viewport width says nothing
                    about the room the card has): price at a FIXED x on every card, then the
                    age chip pulled right up against the status badge in one shared,
                    fixed-width slot (they read as a single status cluster). The slot's
                    fixed width is what keeps the price aligned across all cards; the
                    status stays full-width and only the age chip yields — it shrinks and
                    clips once even 13.5rem isn't enough. Below that the header is a 3-column
                    grid and these wrappers go display:contents — see the seller dashboard's
                    copy of this card for the full note (admin↔seller parity). */}
                <div class="contents @[640px]/ordcard:flex @[640px]/ordcard:items-center @[640px]/ordcard:gap-4 @[640px]/ordcard:shrink-0">
                  <span class="order-card__amount text-sm font-bold text-[color:var(--color-text)] text-start [grid-area:2/1] self-baseline @[640px]/ordcard:w-[6rem] @[640px]/ordcard:text-end @[640px]/ordcard:self-center">{formatAgorot(totalAgorot)}</span>
                  <span class="flex flex-wrap items-center justify-end gap-1.5 min-w-0 [grid-area:2/2/3/4] @[640px]/ordcard:w-[13.5rem] @[640px]/ordcard:flex-nowrap">
                    <span class="order-age-chip-slot flex items-center min-w-0 overflow-hidden empty:hidden" set:html={orderAgeChipHtml(purchase.createdAt, headlineStatus, 'he')} />
                    <span class="order-card__status-badge text-[0.72rem] font-semibold px-[0.55rem] py-[0.2rem] rounded-[20px] whitespace-nowrap shrink-0" style={`background:${shippingColor[headlineStatus] ?? '#888'}1a;color:${shippingColor[headlineStatus] ?? '#888'}`}>
                      {shippingLabel[headlineStatus] ?? headlineStatus}
                    </span>
                  </span>
                </div>
              </div>
              <svg class="shrink-0 [grid-area:1/3] text-[color:var(--color-muted)] transition-transform duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] group-data-[open]:rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="order-card__body border-t border-[color:var(--color-border)] p-4 flex flex-col gap-4" hidden>
              <div>
                <h3 class="text-[0.78rem] font-bold text-[color:var(--color-muted)] uppercase tracking-[0.05em] mb-2">קונה</h3>
                <p class="text-sm text-[color:var(--color-text)] my-[0.1rem]"><strong>{o.buyerName}</strong></p>
                <p class="text-sm text-[color:var(--color-text)] my-[0.1rem]">{o.buyerEmail}</p>
                <p class="text-sm text-[color:var(--color-text)] my-[0.1rem]">טלפון: <span dir="ltr">{o.buyerPhone}</span></p>
                <p class="text-sm text-[color:var(--color-text)] my-[0.1rem]">{o.buyerAddress.street}, {o.buyerAddress.city}{o.buyerAddress.zip ? ` ${o.buyerAddress.zip}` : ''}</p>
              </div>
              <div>
                <h3 class="text-[0.78rem] font-bold text-[color:var(--color-muted)] uppercase tracking-[0.05em] mb-2 flex items-center gap-1 flex-wrap">
                  <span>פריטים</span>
                  {uniqueStores.length === 1 ? (
                    <a href={`/${uniqueStores[0].slug}`} target="_blank" rel="noopener noreferrer" class="normal-case font-semibold [color:var(--color-primary)] hover:underline inline-flex items-center gap-1">
                      {uniqueStores[0].name}
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </a>
                  ) : (
                    <span class="normal-case">({uniqueStores.length} חנויות)</span>
                  )}
                </h3>
                {/* One block per STORE, each carrying that store's own status and slice total.
                    This is the half of the card a flat item list could not express: the stores of
                    one purchase genuinely disagree — every seller fulfils and cancels
                    independently — so "נשלח" belongs beside the store it is true of, and not once
                    at the bottom under a header that is only the least advanced of them. A
                    single-store purchase shows no per-slice badge, because repeating the header's
                    badge one line below says nothing. Same arrangement as the buyer's own card. */}
                {purchase.slices.map((slice) => (
                  <div class="mb-3 last:mb-0">
                    {split && (
                      <div class="flex items-center gap-2 flex-wrap mb-1.5">
                        <a href={`/${slice.storeSlug}`} target="_blank" rel="noopener noreferrer" class="text-[0.82rem] font-semibold [color:var(--color-text)] no-underline hover:underline">{slice.storeName}</a>
                        {slicesDisagree && (
                          <span class="order-card__status-badge text-[0.7rem] font-semibold px-[0.5rem] py-[0.15rem] rounded-[20px] whitespace-nowrap" style={`background:${shippingColor[slice.order.shippingStatus] ?? '#888'}1a;color:${shippingColor[slice.order.shippingStatus] ?? '#888'}`}>
                            {shippingLabel[slice.order.shippingStatus] ?? slice.order.shippingStatus}
                          </span>
                        )}
                        <span class="text-[0.75rem] [color:var(--color-muted)] ms-auto tabular-nums">{formatAgorot(slice.totalAgorot)}</span>
                      </div>
                    )}
                    <ul class="order-card__items list-none p-0 flex flex-col gap-2">
                      {slice.order.items.map((item) => (
                        <li class="flex items-center gap-2.5 text-sm">
                          {item.image && <img src={cdnThumb(item.image, 72, 72)} alt="" width="36" height="36" loading="lazy" decoding="async" class="w-9 h-9 object-cover rounded-[var(--radius-sm)] shrink-0 border [border-color:var(--color-border)] bg-[color:var(--color-surface)]" />}
                          <span class="flex-1 text-[color:var(--color-text)]">{item.productName}</span>
                          <span class="text-[color:var(--color-muted)] text-[0.8rem]">×{item.qty}</span>
                          <span class="font-bold text-[color:var(--color-text)] ms-auto">{formatAgorot(item.priceAgorot * item.qty)}</span>
                        </li>
                      ))}
                    </ul>
                    {/* When this slice's money reaches its seller, and why then — the same line the
                        seller sees on their own copy of this order, from the same derivation
                        (`order-payout-line.ts`). Asked for here on 2026-08-11, and it belongs PER
                        SLICE rather than per purchase: each store's share runs its own hold clock
                        off its own shipping status, so one purchase can have a seller paid next
                        week and another blocked on a parcel that never went out. */}
                    {(() => {
                      const line = orderPayoutLine({
                        paymentStatus: slice.order.paymentStatus,
                        shippingStatus: slice.order.shippingStatus,
                        paidAt: slice.order.paidAt ?? null,
                        deliveredAt: slice.order.deliveredAt ?? null,
                        deliveryMethod: slice.order.storeSubtotals[slice.storeSlug]?.deliveryMethod ?? null,
                      });
                      return (
                        <div class="mt-2 pt-2 border-t [border-color:var(--color-border)] flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[0.78rem]">
                          {/* "התשלום למוכר", not "סטטוס תשלום": this card carries TWO payment
                              facts — the buyer's charge and the seller's payout — and both were
                              called תשלום, so neither could be read (owner, 2026-08-11). */}
                          <span class="[color:var(--color-muted)]">התשלום למוכר/ת:</span>
                          <strong class="[color:var(--color-text)]">
                            {line.state === 'not_payable' ? 'לא ישולם — בוטל או לא שולם'
                              : line.state === 'releasable' ? 'ישולם בתשלום הקרוב'
                              : line.releaseDayISO ? `ישולם אחרי ${formatBusinessDayLabel(line.releaseDayISO)}`
                              : 'הספירה מתחילה כשההזמנה נשלחת'}
                          </strong>
                          {line.state === 'held' && (
                            <span class="[color:var(--color-muted)]">· {payoutWhyText(line, PAYOUT_WHY[line.whyKey])}</span>
                          )}
                        </div>
                      );
                    })()}
                  </div>
                ))}
                <div class="order-card__subtotals flex justify-between items-center mt-2.5 pt-2.5 border-t border-[color:var(--color-border)] text-sm text-[color:var(--color-muted)]">
                  <span>משלוח: {shippingAgorot === 0 ? 'חינם' : formatAgorot(shippingAgorot)}</span>
                  <strong class="text-[color:var(--color-text)] text-[0.9375rem]">סה"כ: {formatAgorot(totalAgorot)}</strong>
                </div>
                {/* Into the journal, filtered to this purchase — the answer to "what actually
                    happened to this order's money", which is the one question the journal is FOR
                    (owner, סשן ב׳ §4: *"מה בעצם נותן לי יומן כספי?"*). The journal already links
                    out to an order; nothing linked in, so it could only be reached by opening a tab
                    of every event on the platform and searching for a reference by hand. */}
                <p class="m-0 mt-2 text-[0.75rem]">
                  <a href={moneyLogHref(purchase.ref, purchase.createdAt)} class="[color:var(--color-primary)] no-underline hover:underline">כל האירועים הכספיים של הרכישה הזאת</a>
                </p>
              </div>
              {/* ── The shipping status is NOT repeated here ──
                  It is in the card's header, on the row the admin clicked to open this, and once
                  more beside every store that disagrees with it. A third copy under a heading
                  called "סטטוס" was the third statement of one fact (owner, 2026-08-11).
                  What is left is the one status the header does not carry — payment — and since
                  that is 'paid' on every order today (stub; the real webhook is CURRENT_TASK א׳#2)
                  the section renders only when it has something to say. An empty heading is the
                  same clutter by another route. */}
              {o.paymentStatus !== 'paid' && (
                <div>
                  <h3 class="text-[0.78rem] font-bold text-[color:var(--color-muted)] uppercase tracking-[0.05em] mb-2">סטטוס</h3>
                  <div class="flex gap-2 items-center flex-wrap">
                    <span class={`admin-badge admin-badge--${o.paymentStatus}`}>חיוב הקונה: {paymentLabel[o.paymentStatus] ?? o.paymentStatus}</span>
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
    <AdminPager page={page} totalPages={totalPages} buildUrl={buildUrl} />
  </Fragment>
)}
