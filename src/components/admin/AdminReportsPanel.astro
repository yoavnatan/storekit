---
/** Visitor reports ("דווח על תקלה"), at the top of the Alerts tab.
 *
 * **Above the error table and not a tab of its own**, on purpose. The Alerts tab already answers
 * "is anything wrong with the site"; a person who took the trouble to write is the loudest possible
 * answer to that question, so it belongs at the top of the same screen rather than behind a
 * thirteenth tab nobody has a habit of opening. The tab's own "(N)" counts these alongside the
 * automatic entries (`lib/admin-tab-badges.ts`).
 *
 * **A list of cards, not a row in that table.** Every column there is a short machine fact — time,
 * severity, route. A report is a paragraph somebody wrote, and putting prose in a 12%-wide cell
 * turns the only content that matters into an ellipsis.
 *
 * Nothing here is deletable; `api/admin/reports.ts` says why.
 */
import { formatHeDateTime } from '../../lib/format-date.js';
import type { UserReport } from '../../lib/user-reports.js';
import AdminNewBadge from './AdminNewBadge.astro';

interface Props {
  reports: UserReport[];
  openCount: number;
  /** ISO — anything newer is what the tab's "(N)" counted. Same boundary the error table marks. */
  newSince: string;
}
const { reports, openCount, newSince } = Astro.props;

const kindLabel: Record<string, string> = {
  fault: 'תקלה באתר',
  content: 'תוכן פוגעני',
  store: 'חנות / מוכר',
  other: 'אחר',
};
// `content` gets the loud variant: it is the one kind that can be an account-level problem for the
// whole platform (a photo in the shared Merchant Center feed — lib/image-moderation.ts), not one
// visitor's broken page. Reuses admin.css's existing badge variants rather than a fifth palette.
const kindBadge: Record<string, string> = {
  fault: 'admin-badge--warning',
  content: 'admin-badge--failed',
  store: 'admin-badge--muted',
  other: 'admin-badge--muted',
};
const roleLabel: Record<string, string> = { guest: 'אורח', buyer: 'קונה', seller: 'מוכר' };
---

<section aria-labelledby="admin-reports-h" style="margin-bottom:1.5rem">
  <h3 id="admin-reports-h" class="!text-[0.95rem] !font-semibold" style="margin:0 0 0.6rem">
    דיווחי גולשים
    {openCount > 0 && <span class="admin-badge admin-badge--warning" style="margin-inline-start:0.4rem">{openCount} פתוחים</span>}
  </h3>

  {reports.length === 0 ? (
    /* One quiet line, never a card — memory `feedback_no_standing_screen_prose`: only a problem
       earns a box. */
    <p class="muted" style="margin:0;font-size:0.88rem">אין דיווחים.</p>
  ) : (
    <ul id="admin-reports-list" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.6rem">
      {reports.map((report) => (
        <li
          data-report-id={report.id}
          data-handled={report.status === 'handled' ? '' : undefined}
          style="border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface);padding:0.75rem 0.9rem"
        >
          <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
            <span class={`admin-badge ${kindBadge[report.kind] ?? 'admin-badge--muted'}`}>{kindLabel[report.kind] ?? report.kind}</span>
            <span class="muted" style="font-size:0.8rem">{formatHeDateTime(report.createdAt)}</span>
            {report.createdAt > newSince && <AdminNewBadge label="חדש" />}
            <span class="muted" style="font-size:0.8rem">· {roleLabel[report.reporterRole ?? 'guest'] ?? 'אורח'}</span>
            {report.storeSlug && <span class="muted" style="font-size:0.8rem">· חנות: {report.storeSlug}</span>}

            <button
              type="button"
              class="btn btn--ghost report-handled-btn"
              data-id={report.id}
              aria-pressed={report.status === 'handled' ? 'true' : 'false'}
              style="margin-inline-start:auto;font-size:0.8rem;padding:0.25rem 0.6rem"
            >{report.status === 'handled' ? 'טופל ✓' : 'סמן כטופל'}</button>
          </div>

          {/* `dir="auto"` for the same reason the error table's message cell has it: this is text a
              visitor wrote, and an English sentence inheriting the page's RTL is truncated from its
              front — the words that say what broke are the ones thrown away. */}
          <p dir="auto" style="margin:0.5rem 0 0;white-space:pre-wrap;font-size:0.9rem">{report.message}</p>

          <p class="muted" style="margin:0.45rem 0 0;font-size:0.78rem">
            {report.pageUrl && (
              /* A real link: the point of capturing the page is to be one click from what they saw.
                 <bdi> because a path is LTR text in an RTL line and its leading slash is neutral —
                 without it "/checkout" renders as "checkout/", a path that does not exist. */
              <><a href={report.pageUrl}><bdi>{report.pageUrl}</bdi></a>{' · '}</>
            )}
            {report.reporterEmail
              ? <a href={`mailto:${report.reporterEmail}`} dir="ltr">{report.reporterEmail}</a>
              : <span>ללא כתובת לחזרה</span>}
            {report.userAgent && <span title={report.userAgent}> · דפדפן</span>}
          </p>
        </li>
      ))}
    </ul>
  )}
</section>

<script>
  // In place, no reload — the platform's rule for every mutation (memory `feedback_ajax_forms`).
  document.getElementById('admin-reports-list')?.addEventListener('click', async (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.report-handled-btn');
    if (!btn) return;
    const handled = btn.getAttribute('aria-pressed') !== 'true';
    btn.disabled = true;
    try {
      const res = await fetch('/api/admin/reports', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: btn.dataset.id, handled }),
      });
      if (!res.ok) throw new Error('failed');
      btn.setAttribute('aria-pressed', handled ? 'true' : 'false');
      btn.textContent = handled ? 'טופל ✓' : 'סמן כטופל';
      // The card carries the state too, so a future stylesheet can mute a handled one without the
      // button being the only place the answer lives.
      const card = btn.closest<HTMLElement>('[data-report-id]');
      if (card) { if (handled) card.dataset.handled = ''; else delete card.dataset.handled; }
    } catch {
      const { showErrorToast } = await import('../../lib/toast.js');
      showErrorToast('לא ניתן היה לעדכן את הדיווח');
    } finally {
      btn.disabled = false;
    }
  });
</script>
