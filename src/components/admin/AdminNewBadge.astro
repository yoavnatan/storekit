---
// The "(N)" on an admin tab says HOW MANY items are new since the admin last
// left that tab (admin-tab-views.ts); on its own it never says WHICH ones, so
// opening the tab answered nothing (owner feedback, 2026-07-28). This chip is
// that answer — rendered on every row whose createdAt is past the tab's
// last-viewed boundary, so the count and the rows always agree — including when
// they DISAPPEAR: leaving the tab strips the count, the chips and the
// "חדשים בלבד" toggle together (tab-nav.ts's clearTabBadge), because the panels
// are SSR HTML that a tab switch only shows/hides.
interface Props {
  label?: string;
  /** Put the chip on its own line (a cell too narrow to hold it beside the
   *  value). `block` rather than a `<br />` before it, so removing the chip
   *  can't leave a stray line break behind. */
  block?: boolean;
}
const { label = 'חדש', block = false } = Astro.props;
---

<span
  class:list={['admin-new-chip', block ? 'block w-fit' : 'inline-block',
    'text-[0.72rem] font-semibold py-[0.2rem] px-[0.55rem] rounded-full whitespace-nowrap bg-[color-mix(in_srgb,var(--color-success)_15%,transparent)] [color:var(--color-success)]']}
  title="נוסף מאז הפעם האחרונה שיצאת מהלשונית הזו"
>{label}</span>
