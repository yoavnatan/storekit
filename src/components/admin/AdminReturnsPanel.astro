---
import { formatAgorot } from '../../lib/money.js';
import { cdnThumb } from '../../lib/cdn.js';
import { formatBusinessDateShort } from '../../lib/format-date.js';
import { buildAdminUrl } from '../../lib/admin-nav.js';
import type { ReturnRequest } from '../../lib/return-requests.js';
import { disputeCause, type ReturnReason, type ReturnStatus, type DisputeCause } from '../../lib/returns.js';

/**
 * The admin's returns queue — and it is deliberately almost empty most of the time.
 *
 * **This screen is not where the mechanism runs.** Seven of the eight states close themselves on the
 * daily sweep (`returns-run.ts`), which is the owner's standing instruction: *"תעשה כמה שיותר
 * אוטומטי... לבדוק איפה אפשר לא לערב אותי בכלל"*. So the queue's normal state is nothing to do, and
 * the one row that ever really needs him — a seller saying the parcel came back empty — arrives by
 * MAIL first. Opening this tab is how he acts on it, never how he learns of it.
 *
 * That is also why the disputes sit at the top under their own heading rather than mixed into one
 * list sorted by date. A list where the actionable row is somewhere in the middle is a list that
 * gets skimmed, and this screen has exactly one kind of actionable row.
 */
interface Props {
  requests: ReturnRequest[];
  /** Shops returning far more than the platform does (`return-rate.ts`). Empty almost always, and
   *  rendered only when it is not — a permanently visible "0 outliers" row is furniture. */
  outliers?: { storeSlug: string; deliveredOrders: number; returns: number; rate: number }[];
  /** Shops contesting most of the returns they get. A different problem from a high return rate, so
   *  it gets its own line rather than a column on the same one. */
  disputeOutliers?: { storeSlug: string; returns: number; disputes: number; disputeRate: number }[];
  platformRate?: number;
  /** Finished cases — paged and searchable over ALL of them, never a capped sample. The case
   *  somebody rings back about is exactly the one a cap would have dropped. */
  closed?: { items: ReturnRequest[]; total: number; page: number; totalPages: number };
  /** What the history is currently filtered to, so the box shows it after a reload. */
  closedQuery?: string;
  /** Builds an admin URL for this tab with extra params — the page's own helper, passed in so this
   *  component never has to know how the admin's query string is assembled. */
  tabUrl?: (panel: string, params: Record<string, string | undefined>) => string;
}
const {
  requests, outliers = [], platformRate = 0,
  closed = { items: [], total: 0, page: 1, totalPages: 1 },
  disputeOutliers = [],
  closedQuery = '',
  tabUrl,
} = Astro.props;

/** A link to this tab with the history's own params changed and everything else kept. */
const histUrl = (over: Record<string, string | undefined>): string =>
  tabUrl ? tabUrl('returns', { rq: closedQuery || undefined, rpage: undefined, ...over }) : '#';

const pct = (n: number): string => `${Math.round(n * 100)}%`;

const REASON: Record<ReturnReason, string> = {
  changed_mind: 'התחרט',
  damaged: 'הגיע פגום',
  wrong_item: 'לא מה שהוזמן',
  not_arrived: 'לא הגיע כלל',
};

const STATUS: Record<ReturnStatus, string> = {
  requested: 'מחכה לתשובה של המוכר',
  approved: 'המוכר אישר. הקונה אמור לשלוח את המוצר',
  in_transit: 'הקונה מסר שהוא שלח את המוצר. המוכר עוד לא אישר שקיבל אותו',
  received: 'המוצר הגיע למוכר וממתין שיבדוק אותו',
  disputed: 'מחכה להחלטה שלך',
  offered: 'המוכר הציע החזר חלקי במקום החזרה. מחכים לתשובת הקונה',
  rejected: 'המוכר סירב לבקשה',
  refunded: 'ההחזר אושר. הכסף בדרך לקונה',
  expired: 'הבקשה נסגרה והמוצר לא הוחזר',
};

/** What each door means, in one line the owner can act on. */
const CAUSE: Record<DisputeCause, string> = {
  seller_claim: 'המוכר קיבל את המוצר וטוען שהחבילה הגיעה ריקה או שהמוצר משומש.',
  parcel_unconfirmed: 'הקונה מסר שהוא שלח את המוצר, ואיש לא אישר שהוא הגיע. עברו שבועיים.',
  refusal_appeal: 'המוכר סירב לבקשה, והקונה מבקש שתבדוק את הסירוב.',
  // Not a case anybody can produce today — it is what a state added later without a timestamp would
  // look like, and saying so is better than printing a confident sentence about the wrong thing.
  unknown: 'הבקשה מחכה להכרעה שלך. פרטי המקרה בהזמנה ובהערות למטה.',
};

const disputes = requests.filter((r) => r.status === 'disputed');
const running = requests.filter((r) => r.status !== 'disputed');

const CARD = 'border [border-color:var(--color-border)] rounded-[var(--radius)] [background:var(--color-surface)] p-3.5';
const trailHref = (orderId: string): string => buildAdminUrl('moneylog', { mq: orderId.slice(0, 8) });
---

<h2 class="m-0 mb-1 text-[1.05rem] font-bold">החזרות</h2>
<p class="m-0 mb-5 text-[0.8rem] [color:var(--color-muted)]">
  רוב הבקשות נסגרות לבד. כאן מופיע רק מה שמחכה להחלטה שלך, ומה שעדיין בתהליך.
</p>

{disputes.length > 0 && (
  <div class="rounded-[var(--radius)] border border-[color:var(--color-danger)] bg-[color:color-mix(in_srgb,var(--color-danger)_8%,transparent)] p-3.5 mb-5">
    <strong class="text-[0.9rem]">⚠ {disputes.length} ממתינות להכרעה שלך</strong>
    <p class="m-0 mt-1 text-[0.78rem] [color:var(--color-muted)] leading-relaxed">
      הכסף לא זז עד שתחליט. ליד כל בקשה כתוב למה היא הגיעה אליך.
    </p>
    <ul class="m-0 mt-3 ps-0 list-none flex flex-col gap-2.5">
      {disputes.map((r) => (
        <li class="text-[0.82rem] border-t border-[color:color-mix(in_srgb,var(--color-danger)_25%,transparent)] pt-2.5">
          <div class="flex flex-wrap items-baseline gap-x-2">
            <a href={trailHref(r.orderId)} class="[color:var(--color-primary)] no-underline hover:underline tabular-nums">
              הזמנה {r.orderId.slice(0, 8)}
            </a>
            <span class="[color:var(--color-muted)] text-[0.76rem]">{r.storeSlug} · {REASON[r.reason]}</span>
            <span class="tabular-nums font-semibold ms-auto">{formatAgorot(r.refundAgorot)}</span>
          </div>
          {/* Why this one is here — the three doors a dispute comes through, from the case's own
              facts (`returns.ts#disputeCause`). This used to be one standing sentence above the whole
              list, which named the seller's empty-parcel claim on every case including the ones that
              never had one. */}
          <div class="mt-1 text-[0.78rem] font-semibold">{CAUSE[disputeCause(r)]}</div>
          {r.trackingNumber && (
            <div class="mt-1 [color:var(--color-muted)] text-[0.78rem]">מספר מעקב: <span class="tabular-nums">{r.trackingNumber}</span></div>
          )}
          {r.sellerNote && <div class="mt-1 [color:var(--color-muted)] text-[0.78rem]">המוכר: "{r.sellerNote}"</div>}
          {/* The buyer's own words. On an appeal this IS the case — deciding one without reading what
              he wrote is deciding it on the seller's account alone. */}
          {r.buyerNote && <div class="mt-1 [color:var(--color-muted)] text-[0.78rem]">הקונה: "{r.buyerNote}"</div>}
          {r.buyerPhotoUrl && (
            <a href={r.buyerPhotoUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-1.5">
              <img src={cdnThumb(r.buyerPhotoUrl, 160, 160)} alt="התמונה שהקונה צירף"
                width="72" height="72" loading="lazy" decoding="async"
                class="rounded-[var(--radius-sm)] border [border-color:var(--color-border)] object-cover" />
            </a>
          )}
          {/* ── The two things a decision needs, on the card and not in the dialog ──

              The REASON is required, and the API refuses without it. A decision that moves real money
              used to leave nothing behind but a status, so a month later — when a seller says he was
              treated unfairly — there was no answer to give him. It is asked here rather than in the
              confirm dialog because a person writes a sentence before he is sure, not after.

              The AMOUNT is optional, and empty means the whole refund. The case that reaches a person
              is often the one where neither extreme is true — a product that came back USED is not "as
              sold" and not "never returned" — and two buttons could only ever serve one side of it. */}
          <label class="block mt-2">
            <span class="[color:var(--color-muted)] text-[0.76rem]">למה החלטת ככה (חובה — יישמר בתיק)</span>
            <textarea rows="2" maxlength="2000" data-admin-note-for={r.id}
              class="w-full mt-1 px-2 py-1.5 border [border-color:var(--color-border)] rounded-[var(--radius-sm)] [background:var(--color-surface-2)] [color:var(--color-text)] text-[0.8rem] resize-none"
            ></textarea>
          </label>
          <label class="flex items-center gap-2 mt-2 text-[0.8rem]">
            <span class="[color:var(--color-muted)]">כמה להחזיר לקונה, בשקלים</span>
            <input type="number" min="0" step="1" inputmode="numeric" data-admin-award-for={r.id}
              placeholder={`הכל — ${formatAgorot(r.refundAgorot)}`}
              class="w-32 px-2 py-1 border [border-color:var(--color-border)] rounded-[var(--radius-sm)] [background:var(--color-surface-2)] [color:var(--color-text)]" />
          </label>
          <div class="flex gap-2 mt-2">
            <button type="button" class="btn btn--sm btn--accent" data-admin-return={r.id}
              data-admin-to="refunded" data-admin-full={String(r.refundAgorot)}>החזר לקונה</button>
            <button type="button" class="btn btn--sm" data-admin-return={r.id} data-admin-to="rejected">סגור בלי החזר</button>
          </div>
        </li>
      ))}
    </ul>
  </div>
)}

{running.length === 0 && disputes.length === 0 && (
  <p class="m-0 py-8 text-center text-[0.9rem] [color:var(--color-muted)]">אין בקשות החזר פתוחות.</p>
)}

{outliers.length > 0 && (
  <div class="rounded-[var(--radius)] border [border-color:var(--color-warning)] p-3.5 mb-5" style="background:color-mix(in srgb,var(--color-warning) 8%,transparent)">
    <strong class="text-[0.9rem]">{outliers.length} חנויות עם הרבה יותר החזרות מהרגיל</strong>
    <p class="m-0 mt-1 text-[0.78rem] [color:var(--color-muted)] leading-relaxed">
      הממוצע בפלטפורמה הוא {pct(platformRate)}. זו התראה בלבד — לא ננקטה שום פעולה, ולא נשלחה למוכר
      שום הודעה.
    </p>
    <ul class="m-0 mt-3 ps-0 list-none flex flex-col gap-1.5">
      {outliers.map((o) => (
        <li class="text-[0.82rem] flex flex-wrap items-baseline gap-x-2">
          <strong>{o.storeSlug}</strong>
          <span class="tabular-nums">{pct(o.rate)}</span>
          <span class="[color:var(--color-muted)] text-[0.76rem] tabular-nums">
            {o.returns} החזרות מתוך {o.deliveredOrders} הזמנות שנמסרו
          </span>
        </li>
      ))}
    </ul>
  </div>
)}

{running.length > 0 && (
  <Fragment>
    <p class="m-0 mb-2 text-[0.76rem] [color:var(--color-muted)]">{running.length} בקשות בתהליך. אין מה לעשות איתן. הן ייסגרו לבד</p>
    <div class="flex flex-col gap-2" data-admin-returns>
      {running.map((r) => (
        <div class={`${CARD} flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[0.82rem]`}>
          <a href={trailHref(r.orderId)} class="[color:var(--color-primary)] no-underline hover:underline tabular-nums">
            {r.orderId.slice(0, 8)}
          </a>
          <span class="[color:var(--color-muted)]">{r.storeSlug}</span>
          <strong>{STATUS[r.status]}</strong>
          <span class="[color:var(--color-muted)]">{REASON[r.reason]}</span>
          <span class="[color:var(--color-muted)] tabular-nums">{formatBusinessDateShort(r.createdAt)}</span>
          {/* What was actually PAID, which is not always the case's full refund since the admin may
              award part of it. Both are shown when they differ — the awarded figure alone would look
              like a case that was simply worth less. */}
          <span class="tabular-nums font-semibold ms-auto">
            {r.adminAwardAgorot !== null && r.adminAwardAgorot < r.refundAgorot
              ? `${formatAgorot(r.adminAwardAgorot)} מתוך ${formatAgorot(r.refundAgorot)}`
              : formatAgorot(r.refundAgorot)}
          </span>
          {/* The reason he decided. This is the entire point of requiring it: a decision you cannot
              look up months later is a decision you cannot defend. */}
          {r.adminNote && (
            <div class="basis-full [color:var(--color-muted)] text-[0.78rem]">ההכרעה שלך: "{r.adminNote}"</div>
          )}
        </div>
      ))}
    </div>
  </Fragment>
)}

{disputeOutliers.length > 0 && (
  <div class="rounded-[var(--radius)] border [border-color:var(--color-warning)] p-3.5 mb-5" style="background:color-mix(in srgb,var(--color-warning) 8%,transparent)">
    <strong class="text-[0.9rem]">{disputeOutliers.length} חנויות שחולקות על רוב ההחזרות שהן מקבלות</strong>
    <p class="m-0 mt-1 text-[0.78rem] [color:var(--color-muted)] leading-relaxed">
      חנות שטוענת שוב ושוב שהמוצר חזר ריק או משומש. זו התראה בלבד — לא ננקטה שום פעולה ולא נשלחה
      למוכר הודעה. כל טענה כזאת הגיעה להכרעה שלך בזמנה.
    </p>
    <ul class="m-0 mt-3 ps-0 list-none flex flex-col gap-1.5">
      {disputeOutliers.map((o) => (
        <li class="text-[0.82rem] flex flex-wrap items-baseline gap-x-2">
          <strong>{o.storeSlug}</strong>
          <span class="tabular-nums">{Math.round(o.disputeRate * 100)}%</span>
          <span class="[color:var(--color-muted)] text-[0.76rem] tabular-nums">
            חלקה על {o.disputes} מתוך {o.returns} החזרות
          </span>
        </li>
      ))}
    </ul>
  </div>
)}

{(closed.total > 0 || closedQuery) && (
  <details style="margin-top:1.75rem" open={!!closedQuery}>
    <summary class="cursor-pointer text-[0.82rem] [color:var(--color-muted)]">
      בקשות שנסגרו ({closed.total})
    </summary>

    {/* Its own search, and a real one: a GET form, so the result is a URL an admin can keep or send.
        A JS filter over one page would only ever search the page he happens to be on. */}
    <form method="get" action="/admin" class="flex items-center gap-2 mt-3">
      <input type="hidden" name="panel" value="returns" />
      <input
        type="search" name="rq" value={closedQuery}
        placeholder="חיפוש לפי מספר הזמנה…"
        class="font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] outline-none focus:border-[color:var(--color-primary)]"
      />
      <button type="submit" class="btn btn--sm">חפש</button>
      {closedQuery && <a href={histUrl({ rq: undefined })} class="text-[0.8rem] [color:var(--color-muted)] underline">נקה</a>}
    </form>

    {closed.items.length === 0 && (
      <p class="m-0 mt-3 text-[0.85rem] [color:var(--color-muted)]">אין בקשות שתואמות לחיפוש.</p>
    )}

    <div class="flex flex-col gap-2 mt-3">
      {closed.items.map((r) => (
        <div class={`${CARD} flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[0.8rem] opacity-80`}>
          <a href={trailHref(r.orderId)} class="[color:var(--color-primary)] no-underline hover:underline tabular-nums">
            {r.orderId.slice(0, 8)}
          </a>
          <span class="[color:var(--color-muted)]">{r.storeSlug}</span>
          <strong>{STATUS[r.status]}</strong>
          <span class="[color:var(--color-muted)]">{REASON[r.reason]}</span>
          <span class="[color:var(--color-muted)] tabular-nums">
            {formatBusinessDateShort(r.settledAt ?? r.createdAt)}
          </span>
          <span class="tabular-nums font-semibold ms-auto">{formatAgorot(r.refundAgorot)}</span>
        </div>
      ))}
    </div>

    {/* Only when there is more than one page — the same rule as the seller's tab. */}
    {closed.totalPages > 1 && (
      <nav class="flex items-center justify-center gap-3 mt-3" aria-label="עמודים">
        {closed.page > 1
          ? <a href={histUrl({ rpage: String(closed.page - 1) })} class="btn btn--sm">הקודם</a>
          : <span class="btn btn--sm" aria-disabled="true" style="opacity:.5">הקודם</span>}
        <span class="text-[0.8rem] [color:var(--color-muted)] tabular-nums">{closed.page} מתוך {closed.totalPages}</span>
        {closed.page < closed.totalPages
          ? <a href={histUrl({ rpage: String(closed.page + 1) })} class="btn btn--sm">הבא</a>
          : <span class="btn btn--sm" aria-disabled="true" style="opacity:.5">הבא</span>}
      </nav>
    )}
  </details>
)}
