---
import type { SellerCardData } from '../../lib/admin-stats.js';

interface Props {
  sellerCards: SellerCardData[];
}
const { sellerCards } = Astro.props;

function fmtDate(iso: string): string {
  return new Date(iso).toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
}
---

{sellerCards.length === 0 ? (
  <p class="admin-empty">אין מוכרים עדיין.</p>
) : (
  <div class="admin-seller-list">
    {sellerCards.map(({ seller, stores, totalProducts }) => (
      <details class="admin-seller-card">
        <summary class="admin-seller-card__summary">
          <div class="admin-seller-card__identity">
            <span class="admin-seller-card__name">{seller.name}</span>
            <span class="admin-seller-card__email">{seller.email}</span>
          </div>
          <div class="admin-seller-card__nums">
            <span>{stores.length} חנויות</span>
            <span>{totalProducts} מוצרים</span>
            <span class="muted">הצטרף/ה {fmtDate(seller.createdAt)}</span>
            <a
              href={`/admin?panel=messages&sellerId=${seller.id}`}
              class="admin-link"
              onclick="event.stopPropagation()"
            >שלח הודעה</a>
          </div>
        </summary>
        <div class="admin-seller-card__body">
          {stores.length === 0 ? (
            <p class="admin-empty">אין חנויות למוכר/ת זה/זו.</p>
          ) : (
            stores.map(({ store, products }) => (
              <details class="admin-store-block">
                <summary class="admin-store-block__summary">
                  <span class="admin-store-block__name">
                    {store.name}
                    {store.blocked && <span class="admin-badge admin-badge--failed">חסום</span>}
                  </span>
                  <span class="admin-store-block__nums">{products.length} מוצרים</span>
                  <a href={`/store/${store.slug}`} target="_blank" rel="noopener" class="admin-link" onclick="event.stopPropagation()">צפה בחנות</a>
                  <button
                    type="button"
                    class={`btn btn--sm ${store.blocked ? '' : 'btn--ghost'} admin-block-toggle`}
                    data-kind="store"
                    data-store-slug={store.slug}
                    data-blocked={store.blocked ? '1' : ''}
                    onclick="event.stopPropagation()"
                  >
                    {store.blocked ? 'בטל חסימה' : 'חסום חנות'}
                  </button>
                </summary>
                {products.length > 0 && (
                  <table class="admin-inline-table">
                    <thead>
                      <tr><th>מוצר</th><th>מחיר</th><th></th></tr>
                    </thead>
                    <tbody>
                      {products.map((p) => (
                        <tr>
                          <td>
                            {p.name}
                            {p.blocked && <span class="admin-badge admin-badge--failed">חסום</span>}
                          </td>
                          <td>{p.price.toFixed(2)} ₪</td>
                          <td>
                            <button
                              type="button"
                              class={`btn btn--sm ${p.blocked ? '' : 'btn--ghost'} admin-block-toggle`}
                              data-kind="product"
                              data-product-id={p.id}
                              data-blocked={p.blocked ? '1' : ''}
                            >
                              {p.blocked ? 'בטל חסימה' : 'חסום מוצר'}
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </details>
            ))
          )}
        </div>
      </details>
    ))}
  </div>
)}
