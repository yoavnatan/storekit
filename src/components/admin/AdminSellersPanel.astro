---
import type { AdminSellerSortCol, AdminSortDir, SellerCardData, PayoutStateFilter } from '../../lib/admin-stats.js';
import type { SellerBalance } from '../../lib/seller-balance.js';
import type { PayoutPlanRow, PayoutState } from '../../lib/payout-run.js';
import { MIN_PAYOUT_AGOROT } from '../../lib/payout-schedule.js';
import AdminStoreStateBadge from './AdminStoreStateBadge.astro';
import { formatAgorot } from '../../lib/money.js';
import { buildAdminUrl } from '../../lib/admin-nav.js';
import AdminPager from './AdminPager.astro';
import AdminNewBadge from './AdminNewBadge.astro';
import AdminNewOnlyToggle from './AdminNewOnlyToggle.astro';

interface Props {
  sellerCards: SellerCardData[]; // current page only
  /** sellerId → what they have earned (lib/seller-balance.ts). REPORTING ONLY — a lifetime figure
   *  that is never an instruction to do anything. `payoutBySeller` beside it is the opposite: what
   *  is about to move. */
  balanceBySeller: ReadonlyMap<string, SellerBalance>;
  /**
   * sellerId → what the next payout run would do for them (`payout-run.ts#planPayouts`).
   *
   * **This is where the admin's payout table went** (owner, סשן א׳ §3): *"מרגיש לי שהפרטים האלו
   * אמורים וצריכים להיות בתוך כרטיסיות המוכרים... למה ליצור עוד רשימה של מוכרים?"*. It was a
   * second roster of the same people, searchable and sortable by nothing, one tab away from this
   * one. Every fact it carried belongs to a seller and now sits on that seller's card.
   *
   * Absent for most sellers most months, and that is the steady state — `settled` and
   * `already_paid` rows are dropped upstream, so a missing entry means "nothing is moving", which
   * the card says by showing no payout tile at all.
   */
  payoutBySeller: ReadonlyMap<string, PayoutPlanRow>;
  q: string;
  sortCol: AdminSellerSortCol;
  sortDir: AdminSortDir;
  blockedOnly: boolean;
  payoutState: PayoutStateFilter;
  /** How many sellers sit in each payout state across the WHOLE list, so the chips keep showing
   *  what exists while one of them is selected — same rule as the Stores tab's state chips. */
  payoutStateCounts: Record<string, number>;
  newSince: string;  // ISO — anything created after this is what the tab's "(N)" counted
  newOnly: boolean;
  newCount: number;
  totalAll: number;   // sellers, unfiltered
  totalFiltered: number;
  page: number;
  totalPages: number;
  buildUrl: (page: number) => string;
}
const { sellerCards, balanceBySeller, payoutBySeller, q, sortCol, sortDir, blockedOnly, payoutState, payoutStateCounts, newSince, newOnly, newCount, totalAll, totalFiltered, page, totalPages, buildUrl } = Astro.props;

/** The three states worth acting on, in the order the payout plan's own tiles show them. `all`
 *  leads, because it is the way back. */
const PAYOUT_CHIPS: { value: PayoutStateFilter; label: string }[] = [
  { value: 'all', label: 'הכל' },
  { value: 'payable', label: 'ישולם' },
  { value: 'no_bank', label: 'תקוע — אין פרטי בנק' },
  { value: 'below_minimum', label: 'מתחת למינימום' },
];
/**
 * One label per state, and each is a complete ANSWER to the question this card raises — "there is a
 * balance here, why is it not in the next payment?" (owner, 2026-08-11). Naming the state was not
 * enough: `settled` said "אין יתרה" beside a card showing ₪5,000 of lifetime earnings, which reads
 * as a contradiction rather than an explanation.
 *
 * The reconciliation the admin needs, in one line: **"יתרה למוכר/ת" is a LIFETIME figure** — every
 * shekel this seller has ever earned net of commission — while "תשלום קרוב" is one moment. The
 * difference between them is money already transferred plus money still inside the buyers' return
 * windows, and it is these labels' job to say which.
 */
const PAYOUT_STATE_LABEL: Record<PayoutState, string> = {
  payable: 'ישולם בתשלום הקרוב',
  no_bank: 'תקוע — אין פרטי בנק',
  below_minimum: `מתחת ל-${formatAgorot(MIN_PAYOUT_AGOROT)} · מתגלגל`,
  already_paid: 'שולם לתקופה הזו',
  settled: 'הכל הועבר · היתרה שנותרה עוד בהמתנה',
};
/** Only `no_bank` is a problem someone has to fix, so only it is red. `payable` is the system
 *  working; the rest are the system waiting. */
const PAYOUT_STATE_CLASS: Record<PayoutState, string> = {
  payable: 'admin-badge--paid',
  no_bank: 'admin-badge--failed',
  below_minimum: 'admin-badge--muted',
  already_paid: 'admin-badge--muted',
  settled: 'admin-badge--muted',
};

function fmtDate(iso: string): string {
  return new Date(iso).toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

const sortLabels: Record<string, string> = {
  'joined:desc': 'הצטרפות: חדש — ישן',
  'joined:asc': 'הצטרפות: ישן — חדש',
  'revenue:desc': 'הכנסות: גבוה — נמוך',
  'revenue:asc': 'הכנסות: נמוך — גבוה',
  'stores:desc': 'מספר חנויות: רב — מעט',
};
---

<div class="admin-orders-search">
  <input type="search" id="admin-seller-search" class="input" value={q} placeholder="חיפוש לפי שם מוכר/ת, מייל או שם חנות..." aria-label="חיפוש מוכר/ת" />
</div>

{totalAll === 0 ? (
  <p class="admin-empty">אין מוכרים עדיין.</p>
) : (
  <Fragment>
    <div class="flex flex-wrap items-center gap-2 mb-4" id="admin-sellers-toolbar" data-sort-col={sortCol} data-sort-dir={sortDir} data-blocked-only={blockedOnly ? '1' : ''} data-new-only={newOnly ? '1' : ''}>
      <button type="button" id="admin-sellers-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
        <span id="admin-sellers-sort-label">{sortLabels[`${sortCol}:${sortDir}`] ?? sortLabels['joined:desc']}</span>
        <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <button
        type="button"
        id="admin-sellers-blocked-toggle"
        class="table-toolbar-btn inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] border"
        style={blockedOnly ? 'background:var(--color-primary);border-color:var(--color-primary);color:#fff' : 'color:var(--color-text);background:var(--color-surface);border-color:var(--color-border)'}
        aria-pressed={blockedOnly}
      >יש חנות חסומה</button>
      {(newCount > 0 || newOnly) && <AdminNewOnlyToggle id="admin-sellers-new-toggle" active={newOnly} count={newCount} />}
    </div>

    {/* The payout filter — the one thing the deleted per-seller payout table could do that a card
        cannot: find the stuck sellers among a thousand. A chip is rendered only when it would
        select somebody (or when it is already selected, so the way back out is never missing),
        because a permanent "תקוע (0)" chip trains the eye to skip the row it lives on. */}
    <div class="flex flex-wrap items-center gap-2 mb-4" id="admin-sellers-payout-chips" data-payout-state={payoutState}>
      <span class="text-[.78rem] [color:var(--color-muted)]">תשלום קרוב:</span>
      {PAYOUT_CHIPS.filter((c) => c.value === 'all' || c.value === payoutState || (payoutStateCounts[c.value] ?? 0) > 0).map((c) => (
        <button
          type="button"
          class="table-toolbar-btn inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] border"
          style={c.value === payoutState ? 'background:var(--color-primary);border-color:var(--color-primary);color:#fff' : 'color:var(--color-text);background:var(--color-surface);border-color:var(--color-border)'}
          aria-pressed={c.value === payoutState}
          data-payout-chip={c.value}
        >
          {c.label}
          {c.value !== 'all' && <span class="tabular-nums [color:inherit] opacity-70">{payoutStateCounts[c.value] ?? 0}</span>}
        </button>
      ))}
    </div>

    {totalFiltered === 0 && <p class="admin-empty">לא נמצאו מוכרים תואמים.</p>}

    <AdminPager position="top" page={page} totalPages={totalPages} buildUrl={buildUrl} />
  <div class="admin-seller-list" id="admin-seller-list">
    {sellerCards.map(({ seller, stores, totalProducts, revenue }) => {
      const balance = balanceBySeller.get(seller.id);
      const payout = payoutBySeller.get(seller.id);
      return (
      <details class="admin-seller-card">
        <summary class="admin-seller-card__summary">
          <div class="admin-seller-card__identity">
            <span class="admin-seller-card__name">
              {seller.name}
              {seller.createdAt > newSince && <AdminNewBadge />}
            </span>
            <span class="admin-seller-card__email">{seller.email}</span>
            <span class="admin-seller-card__joined">הצטרף/ה {fmtDate(seller.createdAt)}</span>
            {/* Rendered whenever this seller has ANY released money — which is what answers the
                question this card raises: "there is a balance, why is it not in the next payment?"
                It used to appear only when a payout was pending, so precisely that case was blank.
                Each state is a complete answer rather than a name.

                What it does NOT do is announce the absence of money. A seller `planPayouts` says
                nothing about has had nothing come out of hold yet, and a badge saying so on most of
                the roster is a label that means "nothing here" (owner, 2026-08-11). No badge says
                that better. */}
            {payout && (
              <span class="admin-seller-card__payout-state">
                <span class:list={['admin-badge', PAYOUT_STATE_CLASS[payout.state]]}>{PAYOUT_STATE_LABEL[payout.state]}</span>
              </span>
            )}
          </div>
          {/* Labelled mini stat-tiles (label above value) — the bare "₪0 סה"כ"
              suffixes read as "what am I looking at?" (owner feedback). Same
              clarity as the Stores tab's labelled revenue, arranged as a fixed
              grid so every card's tiles line up into the same columns. */}
          <div class="admin-seller-card__nums">
            <span class="admin-seller-card__stat">
              <span class="admin-seller-card__stat-label">חנויות</span>
              <span class="admin-seller-card__stat-value">{stores.length}</span>
            </span>
            <span class="admin-seller-card__stat">
              <span class="admin-seller-card__stat-label">מוצרים</span>
              <span class="admin-seller-card__stat-value">{totalProducts}</span>
            </span>
            <span class="admin-seller-card__stat admin-seller-card__stat--rev">
              <span class="admin-seller-card__stat-label">הכנסות סה"כ</span>
              <span class="admin-seller-card__stat-value">{formatAgorot(revenue.totalRevenueAgorot)}</span>
            </span>
            <span class="admin-seller-card__stat admin-seller-card__stat--rev">
              <span class="admin-seller-card__stat-label">הכנסות החודש</span>
              <span class="admin-seller-card__stat-value">{formatAgorot(revenue.monthRevenueAgorot)}</span>
            </span>
            {/* The tile the other four do not answer: "הכנסות" is what the shopper paid, this is
                what the seller is left with once the platform's commission comes out. Deliberately
                the last tile — it is a consequence of the one before it, and reading them in that
                order is what makes the pair legible. */}
            {/* The tooltip carries the reconciliation the two money tiles otherwise leave the admin
                to work out: this one is a LIFETIME total and "תשלום קרוב" is one moment, so they
                are not the same kind of number and the gap between them is not an error. */}
            <span class="admin-seller-card__stat admin-seller-card__stat--rev" title={`סך הכל מאז שנפתחה החנות, אחרי עמלת פלטפורמה של ${balance?.commissionRate ?? 0}% (${formatAgorot(balance?.commissionAgorot ?? 0)}). כולל גם כסף שכבר הועבר וגם כסף שעוד בתוך חלון ההחזרה של הקונה — ולכן הוא גדול מ״תשלום קרוב״. דמי המנוי החודשיים נגבים בנפרד ואינם יורדים מכאן.`}>
              <span class="admin-seller-card__stat-label">יתרה למוכר/ת</span>
              <span class="admin-seller-card__stat-value">{formatAgorot(balance?.totalEarnedAgorot ?? 0)}</span>
            </span>
            {/* The forward-looking tile, and the only one on this card that is about something
                ABOUT to happen — the rest are history. Rendered only when there is money moving:
                a permanent "₪0 תשלום קרוב" tile on every card would bury the handful that are not
                zero, and the badge under the seller's name already says why a card has none. The
                tooltip carries the platform's own cut of the transfer, which is the pairing the
                deleted table put on one line. */}
            {payout && payout.balanceAgorot > 0 && (
              <span class="admin-seller-card__stat admin-seller-card__stat--rev" title={`עמלה שתיגבה בתשלום הזה: ${formatAgorot(payout.commissionAgorot)}`}>
                <span class="admin-seller-card__stat-label">תשלום קרוב</span>
                <span class="admin-seller-card__stat-value">{formatAgorot(payout.balanceAgorot)}</span>
              </span>
            )}
          </div>
          {/* Actions moved into a three-dot kebab menu (CURRENT_TASK admin item) —
              consistent with the Stores tab, and ready to hold more per-seller
              actions without crowding the card. onclick stops the click from
              toggling the parent <summary>'s <details>. */}
          <div class="admin-seller-card__actions">
            <button
              type="button"
              class="admin-seller-card__kebab inline-flex items-center justify-center w-8 h-8 rounded-full border-0 bg-transparent cursor-pointer [color:var(--color-muted)] transition-colors duration-100 hover:bg-[color:var(--color-bg)] hover:[color:var(--color-text)] aria-expanded:bg-[color:var(--color-bg)] aria-expanded:[color:var(--color-text)]"
              data-seller-id={seller.id}
              data-seller-name={seller.name}
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label="פעולות מוכר/ת"
              title="פעולות"
              onclick="event.stopPropagation()"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
            </button>
          </div>
        </summary>
        <div class="admin-seller-card__body">
          {stores.length === 0 ? (
            <p class="admin-empty">אין חנויות למוכר/ת זה/זו.</p>
          ) : (
            stores.map(({ store, products, revenue }) => (
              <a class="admin-store-link" href={buildAdminUrl('stores', { stq: store.name })} title={`נהל את "${store.name}" בלשונית החנויות`}>
                <span class="admin-store-block__name">
                  {store.name}
                  <AdminStoreStateBadge store={store} />
                </span>
                <span class="admin-store-block__nums">{products.length} מוצרים</span>
                <span class="admin-store-block__nums">{formatAgorot(revenue.totalRevenueAgorot)} סה"כ · {formatAgorot(revenue.monthRevenueAgorot)} החודש</span>
                <span class="admin-store-block__nums">{formatAgorot(balance?.stores.find((b) => b.storeId === store.id)?.totalEarnedAgorot ?? 0)} יתרה</span>
                <svg class="admin-store-link__chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
              </a>
            ))
          )}
        </div>
      </details>
      );
    })}
  </div>

  <AdminPager page={page} totalPages={totalPages} buildUrl={buildUrl} />

  <dialog id="admin-seller-msg-modal" aria-labelledby="admin-seller-msg-modal-title" style="border:none;border-radius:var(--radius-lg);padding:0;width:min(480px,94vw);box-shadow:var(--shadow-overlay);background:var(--color-surface);margin:auto">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border)">
      <h2 id="admin-seller-msg-modal-title" style="font-size:0.95rem;font-weight:700;margin:0">הודעה חדשה</h2>
      <button type="button" id="admin-seller-msg-modal-close" aria-label="סגור" style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius-sm);border:none;background:none;color:var(--color-muted);cursor:pointer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div style="padding:1.25rem;display:flex;flex-direction:column;gap:0.75rem">
      <input type="hidden" id="admin-seller-msg-modal-seller-id" value="" />
      <textarea id="admin-seller-msg-modal-textarea" class="seller-msg-reply-textarea" placeholder="כתוב הודעה..." rows="4"></textarea>
      <div style="display:flex;justify-content:flex-end">
        <button type="button" id="admin-seller-msg-modal-send" class="btn btn--accent btn--sm">שלח הודעה</button>
      </div>
    </div>
  </dialog>
  </Fragment>
)}
