---
// Platform-level advertising overview + control (CURRENT_TASK.md → סשן ב׳).
// Organised as the owner asked: an INSIGHTS zone that reads top-down by exposure
// level — platform-wide total → split by source → top stores — then a MANAGEMENT
// zone with the controls. Everything is bounded at scale: seller boosts are only
// ever an aggregate (never a row per seller), and per-store exposure is a top-N
// list, so 1000 boosting sellers can't make this page grow without limit.
// All numbers are mock estimates until a real Google/Meta account is connected.
import { formatPrice } from '../../config/store.config.js';
import type { PlatformAdOverview } from '../../lib/admin-ads.js';
import type { BrandCampaign } from '../../lib/brand-campaigns.js';
import { brandStatsInRange } from '../../lib/ad-metrics.js';
import type { AdRangePreset } from '../../lib/date-range.js';
import { buildBarChartSvg, type BarChartPoint } from '../../lib/chart-svg.js';
import InfoTip from '../dashboard/InfoTip.astro';

interface Props {
  overview: PlatformAdOverview;
  brandCampaigns: BrandCampaign[];
  range: { from: string; to: string };
  activePreset: AdRangePreset;
  compare: { impressions: number | null; clicks: number | null; spend: number | null };
}
const { overview, brandCampaigns, range, activePreset, compare } = Astro.props;
const { connection, baseline, boost, ppc, exposure, promotedStores } = overview;

// Presets shown as chips; the range picker sets ?adpreset=… (+ adfrom/adto for
// custom) and the panel re-renders over that window (client wiring in
// advertising-platform.ts → initAdRangePicker).
const rangePresets: { key: AdRangePreset; label: string }[] = [
  { key: 'today', label: 'היום' },
  { key: '7d', label: '7 ימים' },
  { key: '30d', label: '30 יום' },
  { key: 'thisMonth', label: 'החודש' },
  { key: 'custom', label: 'מותאם' },
];
const fmtDate = (iso: string): string => iso.split('-').reverse().join('/');
// "▲ 12%" / "▼ 5%" / "" — period-over-period delta shown under a headline total.
const deltaText = (p: number | null): string => (p === null || p === 0 ? '' : `${p > 0 ? '▲' : '▼'} ${Math.abs(p)}% מהתקופה הקודמת`);
const deltaClass = (p: number | null): string => (p === null || p === 0 ? '' : p > 0 ? 'admin-delta--up' : 'admin-delta--down');

const promoLabels = ['—', 'קידום', 'קידום חזק'];
const objectiveLabels: Record<string, string> = { buyers: 'משיכת קונים', sellers: 'משיכת מוכרים' };
const platformLabels: Record<string, string> = { google: 'Google', meta: 'Meta' };
const brandRows = brandCampaigns.map((c) => ({ campaign: c, stats: brandStatsInRange(c, range.from, range.to) }));
// Top-store exposure as ONE simple bar chart (CURRENT_TASK.md, replacing the
// per-store bar-list rows): x = the ranked stores (most-exposed first), y =
// impressions, hover a bar → tooltip with the full store name (+ boost marker).
// A store running a paid boost is tinted a different colour (accent) so it
// stands out from the platform-funded baseline exposure (primary). The x-axis
// carries a short truncated name; `tipLabel` reveals the full one. The client
// re-renders at the real container width + binds the tooltips
// (advertising-platform.ts → initExposureChart), reading the JSON below.
// Reversed so the most-exposed store sits on the RIGHT (the reading-start on an
// RTL page) and exposure descends leftward — the bars are laid out left→right by
// index, so a highest-first array would otherwise put the leader on the left.
const exposurePoints: BarChartPoint[] = exposure.topStores.map((s) => ({
  label: s.name.length > 9 ? `${s.name.slice(0, 8)}…` : s.name,
  tipLabel: `${s.name}${s.hasBoost ? ' · בוסט' : ''}`,
  value: s.impressions,
  color: s.hasBoost ? 'var(--color-accent)' : 'var(--color-primary)',
})).reverse();
const exposureFmt = (v: number): string => `${v.toLocaleString('en-US')} חשיפות`;
const exposureChartSvg = buildBarChartSvg(exposurePoints, { rtl: true, height: 220, valueFormatter: exposureFmt, emptyMessage: 'אין עדיין נתוני חשיפה לפי חנות.' });
const connections = [
  { key: 'gtm', label: 'Google Tag Manager', ok: connection.googleTag, okText: 'מחובר', pendingText: 'לא הוגדר מזהה',
    tip: 'קוד מעקב של גוגל שמוטמע בכל עמוד באתר ומודד מה המבקרים עושים (צפייה במוצר, הוספה לסל, רכישה). דרוש כדי להזין נתונים לקמפייני הפרסום. כרגע ריק — צריך להזין מזהה אמיתי בקובץ ההגדרות.' },
  { key: 'pixel', label: 'Meta Pixel', ok: connection.metaPixel, okText: 'מחובר', pendingText: 'לא הוגדר מזהה',
    tip: 'המקבילה של פייסבוק/אינסטגרם ל-GTM — מודד את אותן פעולות ומזין את קמפייני מטא. כרגע ריק, ממתין למזהה אמיתי.' },
] as const;
const feedTip = 'קובץ אחד מרוכז שמכיל את כל המוצרים הזמינים באתר בפורמט שגוגל ומטא דורשים כדי לפרסם אותם. מתעדכן אוטומטית. המספרים = כמה מוצרים ומכמה חנויות נכללים בו כרגע.';
---

<div class="admin-ads">
  {/* ── Date-range picker ── */}
  <div class="admin-ads-range" id="admin-ads-range" data-preset={activePreset} data-from={range.from} data-to={range.to}>
    <div class="admin-ads-range__chips" role="group" aria-label="טווח תאריכים">
      {rangePresets.map((p) => (
        <button type="button" class={`admin-ads-range__chip${activePreset === p.key ? ' is-active' : ''}`} data-preset={p.key} aria-pressed={activePreset === p.key}>{p.label}</button>
      ))}
    </div>
    <div class="admin-ads-range__custom" id="admin-ads-range-custom" hidden={activePreset !== 'custom'}>
      <input type="date" id="admin-ads-from" class="input" value={range.from} aria-label="מתאריך" />
      <span>—</span>
      <input type="date" id="admin-ads-to" class="input" value={range.to} aria-label="עד תאריך" />
      <button type="button" class="btn btn--accent btn--sm" id="admin-ads-apply">הצג</button>
    </div>
  </div>

  {/* ═══════════ INSIGHTS ═══════════ */}

  {/* ── 1. Platform-wide total ── */}
  <h2 class="admin-panel-subtitle admin-ads-heading" style="margin-top:0">
    חשיפה בכל הפלטפורמה
    <InfoTip text="התמונה הגדולה: סך כל החשיפות וההוצאה על פני כל סוגי הפרסום יחד — הבסיסי, פרסום המותג והבוסטים של המוכרים. כל המספרים הערכה עד לחיבור חשבון פרסום אמיתי." />
  </h2>
  <p class="admin-empty" style="margin-bottom:1rem">כמה חשיפה כל האתר מקבל מכל מקורות הפרסום, בטווח {fmtDate(range.from)}–{fmtDate(range.to)}. ההשוואה היא מול התקופה הקודמת באותו אורך.</p>
  <p class="admin-ads-period"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg> המספרים הם הערכה (נתוני דמו). כשיחובר חשבון פרסום אמיתי הם יתחלפו בנתונים אמיתיים לאותו טווח.</p>
  <div class="admin-stat-grid">
    <div class="admin-stat-card">
      <dt>סה"כ חשיפות <InfoTip text="כמה פעמים מודעות של האתר נראו בסך הכול (בסיסי + מותג + בוסטים) בטווח הנבחר." /></dt>
      <dd>{exposure.totalImpressions.toLocaleString('en-US')}</dd>
      {deltaText(compare.impressions) && <span class={`admin-delta ${deltaClass(compare.impressions)}`}>{deltaText(compare.impressions)}</span>}
    </div>
    <div class="admin-stat-card">
      <dt>סה"כ קליקים <InfoTip text="כמה פעמים מישהו לחץ על מודעה ונכנס לאתר, מכל מקורות הפרסום בטווח הנבחר." /></dt>
      <dd>{exposure.totalClicks.toLocaleString('en-US')}</dd>
      {deltaText(compare.clicks) && <span class={`admin-delta ${deltaClass(compare.clicks)}`}>{deltaText(compare.clicks)}</span>}
    </div>
    <div class="admin-stat-card">
      <dt>סה"כ הוצאה <InfoTip text="סך ההוצאה על פרסום — שלך (בסיסי + מותג) ושל המוכרים (בוסטים) יחד, בטווח הנבחר." /></dt>
      <dd>{formatPrice(exposure.totalSpend)}</dd>
      {deltaText(compare.spend) && <span class={`admin-delta ${deltaClass(compare.spend)}`}>{deltaText(compare.spend)}</span>}
    </div>
  </div>

  {/* ── 2. Split by source ── */}
  <h2 class="admin-panel-subtitle admin-ads-heading">
    חשיפה לפי מקור
    <InfoTip text="מאיפה מגיעה החשיפה: פרסום בסיסי ופרסום מותג הם על חשבונך; בוסטים הם כסף של המוכרים. כך אתה רואה מי מביא כמה, בלי קשר לכמה מוכרים עושים בוסט (זה תמיד סיכום אחד)." />
  </h2>
  <div class="admin-stat-grid">
    <div class="admin-stat-card">
      <dt>פרסום בסיסי · שלך <InfoTip text="הפרסום שאנחנו מריצים אוטומטית על כל המוצרים, על חשבוננו." /></dt>
      <dd>{exposure.bySource.baseline.impressions.toLocaleString('en-US')}<span class="admin-stat-card__sub">חשיפות · {formatPrice(exposure.bySource.baseline.spend)}</span></dd>
    </div>
    <div class="admin-stat-card">
      <dt>פרסום מותג · שלך <InfoTip text="הקמפיינים שאתה יוצר כדי לפרסם את הפלטפורמה עצמה." /></dt>
      <dd>{exposure.bySource.brand.impressions.toLocaleString('en-US')}<span class="admin-stat-card__sub">חשיפות · {formatPrice(exposure.bySource.brand.spend)}</span></dd>
    </div>
    <div class="admin-stat-card">
      <dt>בוסטים · מוכרים <InfoTip text="פרסום שמוכרים משלמים עליו בעצמם. תמיד מוצג כסיכום אחד — לא רשימה — כך שגם 1000 בוסטים לא יאריכו את הדף." /></dt>
      <dd>{exposure.bySource.boost.impressions.toLocaleString('en-US')}<span class="admin-stat-card__sub">חשיפות · {formatPrice(exposure.bySource.boost.spend)} · {boost.activeCampaigns} פעילים</span></dd>
    </div>
  </div>

  {/* ── 3. Per-store exposure (bounded top-N) ── */}
  <h2 class="admin-panel-subtitle admin-ads-heading">
    חשיפה מובילה לפי חנות
    <InfoTip text="החנויות שמקבלות הכי הרבה חשיפה (בסיסי + הבוסטים שלהן). מוצגות רק המובילות — לתמונה מלאה של חנות בודדת יש עמוד ביצועים ייעודי בטאב 'חנויות'." />
  </h2>
  {exposure.topStores.length === 0 ? (
    <p class="admin-empty" style="margin-bottom:1rem">אין עדיין נתוני חשיפה לפי חנות.</p>
  ) : (
    <Fragment>
      <p class="admin-empty" style="margin-bottom:.75rem">מוצגות עד 10 החנויות המובילות מתוך {exposure.totalStores}, מדורגות לפי חשיפה. ריחוף על עמודה מציג את שם החנות. לפירוט חנות בודדת — "ביצועים" בשורת החנות בטאב "חנויות".</p>
      <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 mb-4">
        <div class="flex items-center gap-3 text-[0.72rem] [color:var(--color-muted)] mb-2 flex-wrap">
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm [background:var(--color-primary)]"></span>חשיפה בסיסית</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-sm [background:var(--color-accent)]"></span>כולל בוסט בתשלום</span>
        </div>
        <div id="admin-ads-exposure-chart" set:html={exposureChartSvg}></div>
      </div>
      <script type="application/json" id="admin-ads-exposure-data" set:html={JSON.stringify(exposurePoints)} is:inline />
    </Fragment>
  )}

  {/* ── 4. Efficiency ratios (PPC) — the numbers unique to this block; the raw
       volume (impressions/clicks/spend) already lives in the sections above, so
       only the ratios appear here to avoid duplicating them. ── */}
  <h2 class="admin-panel-subtitle admin-ads-heading">
    יעילות הפרסום שלך (מדדי PPC)
    <InfoTip text="עד כאן ראית כמה חשיפה יש (כמות). כאן רואים כמה טוב הכסף שלך עובד (יעילות) — היחסים הסטנדרטיים של עולם הפרסום. מחושבים על הפרסום שאתה מממן בלבד (בסיסי + מותג); הבוסטים של המוכרים לא נכללים כי זה הכסף שלהם. הערכה עד לחיבור חשבון פרסום אמיתי." />
  </h2>
  <div class="admin-stat-grid">
    <div class="admin-stat-card">
      <dt>CTR <InfoTip text="Click-Through Rate — אחוז ההקלקה: מתוך כל מי שראה מודעה, כמה לחצו. גבוה = המודעה מושכת. מחושב: קליקים ÷ חשיפות." /></dt>
      <dd>{ppc.ctr}%</dd>
    </div>
    <div class="admin-stat-card">
      <dt>CPC <InfoTip text="Cost Per Click — עלות ממוצעת לקליק. נמוך יותר = יעיל יותר. מחושב: הוצאה ÷ קליקים." /></dt>
      <dd>{formatPrice(ppc.cpc)}</dd>
    </div>
    <div class="admin-stat-card">
      <dt>CPM <InfoTip text="Cost Per Mille — עלות ל-1000 חשיפות. מדד להשוואת מחיר חשיפה בין ערוצים. מחושב: הוצאה ÷ חשיפות × 1000." /></dt>
      <dd>{formatPrice(ppc.cpm)}</dd>
    </div>
  </div>

  {/* ═══════════ MANAGEMENT ═══════════ */}
  <h2 class="admin-ads-zone">ניהול הפרסום</h2>

  {/* ── Connections ── */}
  <h3 class="admin-panel-subtitle admin-ads-heading" style="margin-top:1rem">
    חיבורי פרסום
    <InfoTip text="שלושת הצינורות שדרכם האתר מדבר עם מערכות הפרסום של גוגל ומטא. ירוק = מחובר ומוכן." />
  </h3>
  <ul class="admin-ads-conn">
    {connections.map((c) => (
      <li class="admin-ads-conn__row">
        <span class="admin-ads-conn__label">{c.label} <InfoTip text={c.tip} /></span>
        <span class={`admin-badge ${c.ok ? 'admin-badge--paid' : 'admin-badge--pending'}`}>{c.ok ? c.okText : c.pendingText}</span>
      </li>
    ))}
    <li class="admin-ads-conn__row">
      <span class="admin-ads-conn__label">פיד המוצרים (Google Merchant / Meta Catalog) <InfoTip text={feedTip} /></span>
      <span class="admin-badge admin-badge--paid">{connection.feedProducts} מוצרים · {connection.feedStores} חנויות</span>
    </li>
  </ul>
  <p class="admin-empty" style="margin-top:.5rem">
    כל מוצר בפיד מסומן אם הוא זמין או אזל מהמלאי. גוגל ומטא לא מפרסמים מוצר שמסומן "אזל", כך שהתקציב לא מתבזבז על מה שאי אפשר לקנות — וכשהמלאי חוזר הוא חוזר להתפרסם לבד. כדי לפרסם בפועל צריך לחבר חשבון Google Merchant / Meta ודומיין קבוע.
  </p>

  {/* ── Baseline budget control ── */}
  <h3 class="admin-panel-subtitle admin-ads-heading">
    תקציב הקמפיין הבסיסי
    <InfoTip text="הפרסום שאנחנו מריצים על כל המוצרים, על חשבוננו. התקציב חד-פעמי (lifetime) — כשנגמר הפרסום נעצר לבד עד שתזרים עוד. סטטוס נוכחי: " + (baseline.status === 'paused' ? 'מושהה.' : 'פעיל.') />
  </h3>
  {baseline.lifetimeBudget > 0 && (
    <div class="admin-ads-progress" role="progressbar" aria-valuenow={baseline.budgetUsedPct} aria-valuemin={0} aria-valuemax={100} aria-label="ניצול תקציב">
      <div class="admin-ads-progress__bar" style={`width:${baseline.budgetUsedPct}%`}></div>
      <span class="admin-ads-progress__label">{baseline.budgetUsedPct}% מהתקציב נוצל (הערכה)</span>
    </div>
  )}
  <form id="platform-ads-form" class="admin-ads-form" data-status={baseline.status}>
    <label class="admin-ads-form__field">
      <span>תקציב lifetime (₪) <InfoTip text="הסכום הכולל לפרסום הבסיסי. 0 = לא מוגדר. אחרי שמירה, שורת ההתקדמות מראה כמה נוצל." /></span>
      <input type="number" name="lifetimeBudget" class="input" min="0" step="100" value={baseline.lifetimeBudget || ''} placeholder="0 = לא הוגדר" />
    </label>
    <button type="button" id="platform-ads-status-toggle" class="btn btn--ghost" aria-pressed={baseline.status === 'paused'}>
      {baseline.status === 'paused' ? 'חדש את הקמפיין' : 'השהה קמפיין'}
    </button>
    <button type="submit" class="btn btn--accent">שמור</button>
    <span id="platform-ads-saved" class="admin-ads-form__saved muted" hidden>נשמר ✓</span>
  </form>

  {/* ── Brand campaigns (create + manage) ── */}
  <h3 class="admin-panel-subtitle admin-ads-heading">
    פרסום המותג (ShopNest עצמו)
    <InfoTip text="פרסום של הפלטפורמה עצמה, לא של מוצר: 'פתח חנות אצלנו' / 'קנה בעשרות חנויות במקום אחד'. כאן אתה יוצר את הקריאייטיב — כותרת, טקסט ותמונה — כי אין פיד מוצרים שירנדר את המודעה." />
  </h3>
  <details class="admin-brand-create">
    <summary>+ צור קמפיין מותג חדש</summary>
    <form id="brand-create-form" class="admin-brand-form">
      <div class="admin-brand-form__field">
        <span>מטרה <InfoTip text="את מי הקמפיין מנסה למשוך. קובע את יעד הקליק הדיפולטי (קונים → דף הבית, מוכרים → הרשמת מוכר)." /></span>
        <button type="button" class="admin-select" id="brand-objective-trigger" aria-haspopup="listbox" aria-expanded="false">
          <span class="admin-select__label" id="brand-objective-label">משיכת קונים (לדף הבית)</span>
          <svg class="admin-select__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <input type="hidden" name="objective" id="brand-objective" value="buyers" />
      </div>
      <label class="admin-brand-form__field admin-brand-form__field--wide">
        <span>כותרת <InfoTip text="הכותרת הראשית שתופיע במודעה. קצרה וקולעת." /></span>
        <input type="text" name="headline" id="brand-headline" class="input" maxlength="120" placeholder="פתחו חנות אונליין בדקות" />
      </label>
      <label class="admin-brand-form__field admin-brand-form__field--wide">
        <span>טקסט <InfoTip text="גוף המודעה — משפט או שניים שמסבירים את ההצעה." /></span>
        <textarea name="body" id="brand-body" class="input" rows="2" maxlength="400" placeholder="הצטרפו למרקטפלייס — בלי עמלות קבועות, בלי קוד."></textarea>
      </label>
      <div class="admin-brand-form__field admin-brand-form__field--wide">
        <span>תמונה <InfoTip text="התמונה שתופיע במודעה. מומלץ יחס רחב ואיכותי. נשמרת דרך Cloudinary כמו שאר תמונות האתר." /></span>
        <div class="admin-brand-image">
          <img id="brand-image-preview" class="admin-brand-image__preview" alt="" hidden />
          <button type="button" id="brand-image-btn" class="btn btn--ghost btn--sm">העלה תמונה</button>
          <span id="brand-image-status" class="muted" style="font-size:.8rem"></span>
          <input type="file" id="brand-image-file" accept="image/*" hidden />
          <input type="hidden" name="imageUrl" id="brand-image-url" />
        </div>
      </div>
      <label class="admin-brand-form__field admin-brand-form__field--wide">
        <span>יעד הקליק <InfoTip text="לאן הקליק על המודעה יוביל. מתמלא לבד לפי המטרה, אפשר לשנות (נתיב באתר או קישור מלא)." /></span>
        <input type="text" name="destinationUrl" id="brand-destination" class="input" value="/" />
      </label>
      <div class="admin-brand-form__field">
        <span>פלטפורמה <InfoTip text="היכן להריץ את הקמפיין — גוגל או מטא (פייסבוק/אינסטגרם)." /></span>
        <button type="button" class="admin-select" id="brand-platform-trigger" aria-haspopup="listbox" aria-expanded="false">
          <span class="admin-select__label" id="brand-platform-label">Google</span>
          <svg class="admin-select__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <input type="hidden" name="platform" id="brand-platform" value="google" />
      </div>
      <label class="admin-brand-form__field">
        <span>תקציב חודשי (₪) <InfoTip text="כמה להוציא בחודש על הקמפיין הזה." /></span>
        <input type="number" name="monthlyBudget" id="brand-budget" class="input" min="0" step="50" placeholder="500" />
      </label>
      <div class="admin-brand-form__field">
        <span>משך <InfoTip text="לכמה זמן להריץ את הקמפיין. 'רציף' = עד שתשהה או תמחק ידנית." /></span>
        <button type="button" class="admin-select" id="brand-duration-trigger" aria-haspopup="listbox" aria-expanded="false">
          <span class="admin-select__label" id="brand-duration-label">רציף</span>
          <svg class="admin-select__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <input type="hidden" name="durationDays" id="brand-duration" value="" />
      </div>
      <div class="admin-brand-form__submit">
        <button type="submit" class="btn btn--accent">צור קמפיין</button>
        <span id="brand-create-error" class="admin-link--danger" style="font-size:.82rem" hidden>חסרים כותרת / טקסט / תקציב</span>
      </div>
    </form>
  </details>

  <p class="admin-empty" id="brand-list-empty" hidden={brandRows.length > 0} style="margin-top:1rem">עדיין אין קמפייני מותג. צור אחד למעלה כדי להתחיל לפרסם את הפלטפורמה.</p>
  <div class="admin-brand-list" id="brand-list">
    {brandRows.map(({ campaign: c, stats }) => (
      <div class="admin-brand-card" data-id={c.id} data-status={c.status}>
        {c.imageUrl && <img src={c.imageUrl} alt="" class="admin-brand-card__img" loading="lazy" />}
        <div class="admin-brand-card__body">
          <div class="admin-brand-card__meta">
            <span class="admin-badge admin-badge--promo">{objectiveLabels[c.objective]}</span>
            <span class="admin-badge admin-badge--pending">{platformLabels[c.platform]}</span>
            {c.status === 'paused' && <span class="admin-badge admin-badge--warning" data-status-badge>מושהה</span>}
          </div>
          <strong class="admin-brand-card__headline">{c.headline}</strong>
          <p class="admin-brand-card__text">{c.body}</p>
          <a href={c.destinationUrl} target="_blank" rel="noopener" class="admin-brand-card__dest">{c.destinationUrl}</a>
          <div class="admin-brand-card__stats">
            <span><b>{stats.impressions.toLocaleString('en-US')}</b> חשיפות</span>
            <span><b>{stats.clicks.toLocaleString('en-US')}</b> קליקים</span>
            <span><b>{stats.ctr}%</b> CTR</span>
            <span><b>{stats.conversions.toLocaleString('en-US')}</b> המרות</span>
            <span><b>{formatPrice(stats.spend)}</b> הוצאה</span>
          </div>
          <div class="admin-brand-card__actions">
            <label class="admin-brand-card__budget">תקציב ₪ <input type="number" class="input" min="0" step="50" value={c.monthlyBudget} data-brand-budget /></label>
            <button type="button" class="admin-link" data-brand-save>עדכן</button>
            <button type="button" class="admin-link" data-brand-toggle>{c.status === 'paused' ? 'הפעל' : 'השהה'}</button>
            <button type="button" class="admin-link admin-link--danger" data-brand-delete data-headline={c.headline}>מחק</button>
          </div>
        </div>
      </div>
    ))}
  </div>

  {/* ── Silently-promoted stores ── */}
  <h3 class="admin-panel-subtitle admin-ads-heading">
    חנויות מקודמות (קידום שקט באתר)
    <InfoTip text="קידום על חשבוננו בתוך האתר עצמו: חנות מקודמת עולה קדימה בעמוד הבית וב-/stores. סוג של פרסום — בנדל'ן שלנו במקום בגוגל/מטא. המוכר לא רואה ולא משלם. כאן אפשר לבטל או לשנות דרגה, וגם דרך טאב 'חנויות'." />
  </h3>
  <ul class="admin-ads-legend">
    <li>
      <span class="admin-badge admin-badge--promo">קידום</span>
      <span>קידום רגיל — החנות עולה קדימה בעמודי הגילוי, מעל חנויות רגילות.</span>
    </li>
    <li>
      <span class="admin-badge admin-badge--promo">קידום חזק</span>
      <span>עולה גם מעל חנויות ב"קידום" רגיל וגם מעל הרגילות.</span>
    </li>
    <li class="admin-ads-legend__note">אפשר לקדם גם מכפתור הקידום בשורת החנות בטאב "חנויות". הכי אפקטיבי לקדם מעט חנויות — אם מקדמים הכול, אף אחת לא בולטת.</li>
  </ul>
  <p class="admin-empty" id="admin-ads-promoted-empty" hidden={promotedStores.length > 0}>אין חנויות מקודמות כרגע. אפשר לקדם חנות בשקט משורת החנות בטאב "חנויות" — היא תעלה קדימה בעמודי הגילוי מבלי שהמוכר/ת ידע/תדע.</p>
  <ul class="admin-ads-promoted" id="admin-ads-promoted-list">
    {promotedStores.map((s) => (
      <li class="admin-ads-promoted__row" data-store-slug={s.slug} data-weight={String(s.weight)}>
        <a href={`/admin/store/${s.slug}/advertising?from=advertising`} class="admin-ads-promoted__name">{s.name}</a>
        <span class="admin-badge admin-badge--promo" data-promo-badge>{promoLabels[s.weight] ?? promoLabels[1]}</span>
        <div class="admin-ads-promoted__actions">
          <button type="button" class="admin-link admin-ads-promo-tier" data-store-slug={s.slug}>
            {s.weight === 2 ? 'החזר לקידום רגיל' : 'הפוך לקידום חזק'}
          </button>
          <button type="button" class="admin-link admin-link--danger admin-ads-promo-cancel" data-store-slug={s.slug} data-store-name={s.name}>
            בטל קידום
          </button>
        </div>
      </li>
    ))}
  </ul>

  {/* ── PPC glossary ── */}
  <details class="admin-ads-glossary">
    <summary>מילון מונחי PPC — לחצו לפתיחה</summary>
    <dl>
      <dt>PPC (Pay Per Click)</dt>
      <dd>פרסום ממומן שמשלמים בו לפי קליק, לא לפי חשיפה.</dd>
      <dt>Impression (חשיפה)</dt>
      <dd>הופעה אחת של מודעה מול משתמש. לא בהכרח לחצו עליה.</dd>
      <dt>Click (קליק)</dt>
      <dd>מישהו לחץ על המודעה ונכנס לאתר.</dd>
      <dt>CTR (Click-Through Rate)</dt>
      <dd>אחוז ההקלקה: קליקים ÷ חשיפות. גבוה = המודעה מושכת.</dd>
      <dt>CPC (Cost Per Click)</dt>
      <dd>עלות ממוצעת לקליק אחד: הוצאה ÷ קליקים. נמוך = יעיל.</dd>
      <dt>CPM (Cost Per Mille)</dt>
      <dd>עלות ל-1000 חשיפות. מדד להשוואת מחיר חשיפה בין ערוצים.</dd>
      <dt>ROAS (Return On Ad Spend)</dt>
      <dd>כמה הכנסה חזרה על כל ₪1 פרסום. מעל 1 = רווחי (4x = כל שקל החזיר ₪4).</dd>
      <dt>Conversion (המרה)</dt>
      <dd>פעולה שרצינו שתקרה אחרי הקליק — בדרך כלל רכישה.</dd>
      <dt>Lifetime budget (תקציב חד-פעמי)</dt>
      <dd>תקציב לכל חיי הקמפיין (לא חודשי מתחדש). כשנגמר — הפרסום נעצר לבד.</dd>
    </dl>
  </details>
</div>
