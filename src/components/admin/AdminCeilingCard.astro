---
import { formatAgorot } from '../../lib/money.js';
import {
  LICENCE_CEILING_AGOROT,
  CEILING_ACT_PERCENT,
  type LicenceCeiling,
} from '../../lib/licence-ceiling.js';

/**
 * **How much room is left under the licensing exemption.**
 *
 * The platform collects buyers' money and pays it on to sellers, which is a payment service needing
 * a licence from רשות ניירות ערך; it operates instead under the size exemption, which holds only
 * while the monthly averages stay under the ceiling (`licence-ceiling.ts` carries the regulations
 * and what about them is unverified). Until this card existed the figure was unreadable anywhere,
 * which meant the only way to discover the exemption had lapsed was in hindsight.
 *
 * **It is a bar and two rows, and the restraint is the design.** A compliance widget that fills a
 * screen at 0.4% trains the owner to scroll past the spot where the real warning will appear. So at
 * `ok` it states two numbers and nothing else; the sentence about what to DO appears only once the
 * reading earns it (`feedback_no_standing_screen_prose` — only the problem gets the card).
 */
interface Props {
  ceiling: LicenceCeiling;
}
const { ceiling } = Astro.props;

const TONE: Record<LicenceCeiling['level'], { bar: string; text: string }> = {
  ok:    { bar: 'var(--color-primary)', text: 'var(--color-muted)' },
  watch: { bar: 'var(--color-warning, #b45309)', text: 'var(--color-warning, #b45309)' },
  act:   { bar: 'var(--color-danger)', text: 'var(--color-danger)' },
};
const tone = TONE[ceiling.level];

// The bar never renders emptier than a hairline: a 0.2% reading drawn as literally nothing reads as
// "not measured" rather than "measured, and tiny".
const width = Math.max(0.5, Math.min(100, ceiling.percent));

const ROW = 'flex items-baseline justify-between gap-3 py-1.5';
const LABEL = 'text-[0.78rem] [color:var(--color-muted)]';
const FIGURE = 'm-0 text-[0.95rem] font-bold tabular-nums';
---

<section class="rounded-[var(--radius)] border [border-color:var(--color-border)] p-3.5 mb-5">
  <div class="flex items-baseline justify-between gap-3 flex-wrap">
    <strong class="text-[0.9rem]">רישוי — כמה מקום נשאר</strong>
    <span class="text-[0.78rem] font-bold tabular-nums" style={`color:${tone.text}`}>
      {ceiling.percent}% מהתקרה
    </span>
  </div>

  <div class="mt-2 h-1.5 rounded-full overflow-hidden" style="background:var(--color-border)">
    <div class="h-full rounded-full" style={`width:${width}%;background:${tone.bar}`}></div>
  </div>

  {/* Both legs, because the exemption fails on whichever breaches first — an average of the two, or
      only the larger, would hide the one that is about to move. */}
  <dl class="m-0 mt-2">
    <div class={ROW}>
      <dt class={LABEL}>התקבל מקונים — ממוצע חודשי</dt>
      <dd class={FIGURE}>{formatAgorot(ceiling.received.monthlyAverageAgorot)}</dd>
    </div>
    <div class={ROW}>
      <dt class={LABEL}>הועבר למוכרים — ממוצע חודשי</dt>
      <dd class={FIGURE}>{formatAgorot(ceiling.transferred.monthlyAverageAgorot)}</dd>
    </div>
  </dl>

  {/* The denominator, said out loud. "₪40,000 a month" over two months and over twelve are
      different claims, and a young platform's average is the one most likely to be misread. */}
  <p class="muted m-0 text-[0.72rem]">
    התקרה {formatAgorot(LICENCE_CEILING_AGOROT)} לחודש, לכל צד בנפרד · ממוצע על פני {ceiling.months < 10 ? ceiling.months.toFixed(1) : Math.round(ceiling.months)} חודשים
  </p>

  {ceiling.level !== 'ok' && (
    <p class="m-0 mt-2 text-[0.78rem]" style={`color:${tone.text}`}>
      {ceiling.level === 'act'
        ? `מעל ${CEILING_ACT_PERCENT}% מהתקרה — זה המועד להתחיל בבקשת רישיון מול רשות ניירות ערך, לא לתכנן אותה. ההליך נמשך חודשים.`
        : 'חצית את חצי התקרה — שווה לפתוח את נושא הרישיון מול עו״ד עכשיו, בזמן שיש עוד מרווח.'}
    </p>
  )}
</section>
