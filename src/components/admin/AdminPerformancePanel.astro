---
import { formatPrice } from '../../config/store.config.js';
import { buildBarChartSvg, buildMultiLineChartSvg } from '../../lib/chart-svg.js';
import type { PerformanceSummary } from '../../lib/seller-performance.js';
import type { StoreRowsPage } from '../../lib/platform-performance.js';
import type { PlatformRevenue } from '../../lib/platform-revenue.js';
import { getT, type Lang } from '../../i18n/index.js';
import { jsonForScript } from '../../lib/json-script.js';

// Platform-wide performance tab (CURRENT_TASK.md item 4) — mirrors the seller
// performance tab (same #perf-* DOM ids so the shared performance.ts client
// drives it via data-endpoint) but aggregates every store + adds a searchable,
// paginated per-store breakdown table and an income-split card (platform-
// specific, own ids, driven by platform-performance.ts on the `perf:loaded`
// event and on its own search/paging fetches).
interface Props {
  summary: PerformanceSummary;
  revenue: PlatformRevenue;
  storePage: StoreRowsPage;
  fromISO: string;
  toISO: string;
  lang: Lang;
  dir: 'rtl' | 'ltr';
}
const { summary, revenue, storePage, fromISO, toISO, lang, dir } = Astro.props;
const d = getT(lang).dashboard;
const isRtl = dir === 'rtl';
const stores = storePage.rows;

// Admin views OTHER sellers' product names → escape `<` in the set:html blob so
// a product named `</script>…` can't break out (same guard as the per-store page).
const summaryJson = jsonForScript(summary);

const revenueChartSvg = buildBarChartSvg(
  summary.points.map((p) => ({ label: p.label, value: p.revenue, key: p.key })),
  { color: 'var(--color-primary)', valueFormatter: formatPrice, emptyMessage: d.perfNoData, rtl: isRtl },
);
const visitorsChartSvg = buildMultiLineChartSvg([
  { points: summary.points.map((p) => ({ label: p.label, value: p.uniqueVisitors })), color: 'var(--color-accent)', fill: true, label: d.perfUniqueVisitors },
  { points: summary.points.map((p) => ({ label: p.label, value: p.views })), color: 'var(--color-muted)', dashed: true, label: d.perfVisitors },
], { emptyMessage: d.perfNoData, rtl: isRtl });

const cols = [
  { col: 'revenue', label: d.perfRevenue },
  { col: 'orders', label: d.perfOrders },
  { col: 'views', label: d.perfVisitors },
  { col: 'conversionRate', label: d.perfConversion },
] as const;
// "N stores" / "N of M match" — the count line above the table, kept in sync
// client-side by the same function that renders the rows.
const storesCount = storePage.query.q
  ? d.perfStoresMatched.replace('{matched}', String(storePage.matched)).replace('{total}', String(storePage.total))
  : d.perfStoresTotal.replace('{total}', String(storePage.total));
const pageLabel = d.perfStorePageOf.replace('{page}', String(storePage.page)).replace('{pages}', String(storePage.totalPages));
---

<div class="dash-panel-head mb-5 py-[0.6rem] border-b [border-color:var(--color-border)] flex items-center justify-between gap-3 flex-wrap">
  <div>
    <h2 class="m-0 text-base font-semibold">{d.perfPlatformTitle}</h2>
    <p class="muted text-[0.82rem] m-0 mt-1">{d.perfPlatformSubtitle}</p>
  </div>
  <div id="perf-range-picker" data-store-slug="" data-endpoint="/api/admin/platform-performance" data-active-preset="thisMonth">
    <button type="button" id="perf-range-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="true" aria-expanded="false">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span id="perf-range-label">{d.perfPresetThisMonth}</span>
      <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <input type="hidden" id="perf-from-input" value={fromISO} />
    <input type="hidden" id="perf-to-input" value={toISO} />
  </div>
</div>

<dl id="perf-kpis" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-5" aria-live="polite">
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
    <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfRevenue}</dt>
    <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-revenue">{formatPrice(summary.totalRevenue)}</dd>
  </div>
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
    <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfOrders}</dt>
    <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-orders">{summary.totalOrders}</dd>
  </div>
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
    <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfAvgOrder}</dt>
    <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-avg">{formatPrice(summary.avgOrderValue)}</dd>
  </div>
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
    <div class="flex items-center gap-1 mb-1">
      <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfVisitors}</dt>
      <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfVisitsHint} aria-label={d.perfVisitsHint}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
      </button>
    </div>
    <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-visitors">{summary.totalViews}</dd>
  </div>
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
    <div class="flex items-center gap-1 mb-1">
      <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfUniqueVisitors}</dt>
      <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfUniqueVisitorsHint} aria-label={d.perfUniqueVisitorsHint}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
      </button>
    </div>
    <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-unique">{summary.totalUniqueVisitors}</dd>
  </div>
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
    <div class="flex items-center gap-1 mb-1">
      <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfConversion}</dt>
      <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfConversionHint} aria-label={d.perfConversionHint}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
      </button>
    </div>
    <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-conversion">{summary.conversionRate.toFixed(1)}%</dd>
  </div>
</dl>

{/* Two cards, because they answer two different questions and mixing them was
    the reported gap (CURRENT_TASK.md → סשן ב׳ item 2):
      left  — the buyer's money: GMV in, seller payouts out. The platform is a
              pass-through here; the commission is the only part it keeps.
      right — the platform's OWN income, split by where it comes from: sales
              commission, subscription fees, campaign margin. Three independent
              streams that a single "commission" figure was hiding.
    Updated on range change by platform-performance.ts (own ids, not #perf-*). */}
{/* items-start: the two cards carry a different number of lines, so stretching
    them to a shared height leaves a dead gap under the shorter one. */}
<div class="grid grid-cols-1 lg:grid-cols-2 items-start gap-4 mb-5">
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4">
    <div class="flex items-center gap-1 mb-3">
      <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfPlatformSplitTitle}</h3>
      <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfPlatformSplitHint} aria-label={d.perfPlatformSplitHint}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
      </button>
    </div>
    <dl class="m-0 flex flex-col gap-2 text-[0.86rem]">
      <div class="flex items-center justify-between gap-3">
        <dt class="[color:var(--color-muted)]">{d.perfPlatformGmv}</dt>
        <dd class="m-0 font-medium" id="plat-gmv">{formatPrice(summary.totalRevenue)}</dd>
      </div>
      <div class="flex items-center justify-between gap-3">
        <dt class="[color:var(--color-muted)]">{d.perfPlatformCommissionIncome} <span class="text-[0.78rem]">(<span id="plat-commission-rate">{summary.commissionRate}</span>%)</span></dt>
        <dd class="m-0 font-medium [color:var(--color-success)]" id="plat-commission">{formatPrice(summary.platformCommission)}</dd>
      </div>
      <div class="flex items-center justify-between gap-3 pt-2 border-t [border-color:var(--color-border)]">
        <dt class="font-semibold">{d.perfPlatformSellerPayout}</dt>
        <dd class="m-0 font-medium" id="plat-payout">{formatPrice(summary.netProfit)}</dd>
      </div>
    </dl>
  </div>

  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4 [background:color-mix(in_srgb,var(--color-primary)_4%,transparent)]">
    <div class="flex items-center gap-1 mb-3">
      <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfIncomeTitle}</h3>
      <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfIncomeHint} aria-label={d.perfIncomeHint}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
      </button>
    </div>
    <dl class="m-0 flex flex-col gap-2 text-[0.86rem]">
      <div class="flex items-start justify-between gap-3">
        <dt>
          <span class="[color:var(--color-muted)]">{d.perfIncomeCommission}</span>
          <span class="block text-[0.72rem] [color:var(--color-muted)]" id="plat-inc-commission-note">{d.perfIncomeCommissionNote.replace('{rate}', String(revenue.commissionRate))}</span>
        </dt>
        <dd class="m-0 font-medium shrink-0" id="plat-inc-commission">{formatPrice(revenue.commission)}</dd>
      </div>
      <div class="flex items-start justify-between gap-3">
        <dt>
          <span class="[color:var(--color-muted)]">{d.perfIncomeSubscriptions}</span>
          <span class="block text-[0.72rem] [color:var(--color-muted)]" id="plat-inc-subs-note">{d.perfIncomeSubscriptionsNote.replace('{count}', String(revenue.subscribers))}</span>
        </dt>
        <dd class="m-0 font-medium shrink-0" id="plat-inc-subscriptions">{formatPrice(revenue.subscriptions)}</dd>
      </div>
      <div class="flex items-start justify-between gap-3">
        <dt>
          <span class="[color:var(--color-muted)]">{d.perfIncomeAdMargin}</span>
          <span class="block text-[0.72rem] [color:var(--color-muted)]" id="plat-inc-ad-note">{d.perfIncomeAdMarginNote.replace('{rate}', String(revenue.adMarginRate)).replace('{spend}', formatPrice(revenue.adSpend))}</span>
        </dt>
        <dd class="m-0 font-medium shrink-0" id="plat-inc-ad-margin">{formatPrice(revenue.adMargin)}</dd>
      </div>
      <div class="flex items-center justify-between gap-3 pt-2 border-t [border-color:var(--color-border)]">
        <dt class="font-semibold">{d.perfIncomeTotal}</dt>
        <dd class="m-0 font-bold [color:var(--color-success)]" id="plat-inc-total">{formatPrice(revenue.total)}</dd>
      </div>
    </dl>
  </div>
</div>

<script type="application/json" id="perf-initial-summary" set:html={summaryJson} />
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5" data-perf-rtl={isRtl ? '1' : '0'}>
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4">
    <h3 class="m-0 mb-3 text-[0.9rem] font-semibold">{d.perfRevenueChartTitle}</h3>
    <div id="perf-revenue-chart" set:html={revenueChartSvg}></div>
  </div>
  <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4">
    <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
      <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfVisitorsChartTitle}</h3>
      <div class="flex items-center gap-3 text-[0.72rem] [color:var(--color-muted)]">
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-[3px] rounded-full [background:var(--color-accent)]"></span>{d.perfUniqueVisitors}</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0 border-t-2 border-dashed [border-color:var(--color-muted)]"></span>{d.perfVisitors}</span>
      </div>
    </div>
    <div id="perf-visitors-chart" set:html={visitorsChartSvg}></div>
  </div>
</div>

<div class="mb-5">
  <h3 class="m-0 mb-3 text-[0.9rem] font-semibold">{d.perfTopProducts}</h3>
  <div id="perf-top-products" class="flex flex-col gap-2">
    {summary.topProducts.length === 0 && <p class="muted text-[0.85rem] m-0">{d.perfTopProductsEmpty}</p>}
    {summary.topProducts.map((tp, i) => {
      const total = Math.max(summary.topProducts.reduce((s, x) => s + x.revenue, 0), 1);
      const pct = Math.round((tp.revenue / total) * 100);
      return (
        <div class="relative rounded-[var(--radius)] border [border-color:var(--color-border)] overflow-hidden">
          <div class="absolute inset-y-0 start-0 [background:color-mix(in_srgb,var(--color-primary)_12%,transparent)] animate-top-bar-grow" style={`width:${pct}%;--tw:${pct}%;animation-delay:${Math.min(i * 60, 300)}ms`}></div>
          <div class="relative flex items-center justify-between gap-3 py-2 px-3 text-[0.85rem]">
            <span class="font-medium overflow-hidden text-ellipsis whitespace-nowrap">{tp.name}</span>
            <span class="shrink-0 [color:var(--color-muted)]"><strong class="[color:var(--color-text)]">{pct}%</strong> · {tp.units} {d.perfUnitsSold} · {formatPrice(tp.revenue)}</span>
          </div>
        </div>
      );
    })}
  </div>
</div>

{/* Breakdown by store — a searchable, paginated view over EVERY store, not the
    old flat top-25 (CURRENT_TASK.md → סשן ב׳ item 1). Search, sort and paging all
    re-fetch just this table from /api/admin/platform-performance; the charts and
    KPIs above are untouched, so nothing re-animates and the page never reloads. */}
<div data-store-table-state={JSON.stringify(storePage.query)}>
  <div class="flex items-end justify-between gap-3 flex-wrap mb-2">
    <div>
      <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfStoreBreakdown}</h3>
      <p class="muted text-[0.78rem] m-0 mt-1" id="perf-stores-note" aria-live="polite">{storesCount}</p>
    </div>
    <label class="relative flex items-center">
      <span class="sr-only">{d.perfStoreSearch}</span>
      <svg class="absolute start-[0.6rem] pointer-events-none [color:var(--color-muted)]" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
      <input
        type="search"
        id="perf-stores-search"
        value={storePage.query.q}
        placeholder={d.perfStoreSearch}
        autocomplete="off"
        class="font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] ps-[1.9rem] pe-[.85rem] outline-none w-[13rem] max-w-full transition-colors duration-[120ms] focus:[border-color:var(--color-primary)]"
      />
    </label>
  </div>
  <div class="admin-table-wrap">
    <table class="admin-table" id="platform-store-table">
      <thead>
        <tr>
          {[{ col: 'name', label: d.perfStoreCol }, ...cols].map((c) => (
            <th scope="col" aria-sort="none">
              <button type="button" class="inline-flex items-center gap-1 bg-transparent border-0 p-0 font-[inherit] text-[inherit] [color:inherit] cursor-pointer" data-sort-col={c.col}>
                {c.label}
                <svg class="perf-sort-caret opacity-0 transition-opacity" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody id="platform-store-rows">
        {stores.length === 0 && <tr><td colspan="5"><p class="muted text-[0.85rem] m-0 py-2">{storePage.query.q ? d.perfStoresNoMatch : d.perfStoresEmpty}</p></td></tr>}
        {stores.map((s) => (
          <tr>
            <td>
              <a href={`/admin/store/${s.slug}/performance?from=performance`} class="admin-link font-medium">{s.name}</a>
              {s.blocked && <span class="admin-badge admin-badge--failed" style="margin-inline-start:0.4rem">חסום</span>}
              {!s.active && <span class="block text-[0.72rem] [color:var(--color-muted)]">{d.perfStoreNoActivity}</span>}
            </td>
            <td>{formatPrice(s.revenue)}</td>
            <td>{s.orders}</td>
            <td>{s.views}</td>
            <td>{s.conversionRate.toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {/* Buttons, not links — this pager swaps the tbody in place. AdminPager.astro
      is deliberately not reused: it navigates (full SSR reload), which is exactly
      what this table must not do. */}
  <nav id="perf-stores-pager" class="flex items-center justify-center gap-4 mt-4" aria-label={d.perfStorePager} hidden={storePage.totalPages <= 1}>
    <button type="button" class="btn btn--ghost btn--sm" data-store-page-step="-1" disabled={storePage.page <= 1}>{isRtl ? '‹ הקודם' : '‹ Prev'}</button>
    <span class="text-[0.82rem] whitespace-nowrap [color:var(--color-muted)]" id="perf-stores-page-label" aria-live="polite">{pageLabel}</span>
    <button type="button" class="btn btn--ghost btn--sm" data-store-page-step="1" disabled={storePage.page >= storePage.totalPages}>{isRtl ? 'הבא ›' : 'Next ›'}</button>
  </nav>
</div>

{/* Revenue-breakdown modal — opened by clicking a revenue bar (performance.ts),
    shows a donut of the platform's product composition for that period. */}
<dialog id="perf-breakdown-modal" aria-labelledby="pbm-title" style="border:none;border-radius:var(--radius-lg);padding:0;width:min(440px,96vw);box-shadow:0 16px 56px rgba(0,0,0,0.26);background:var(--color-surface);margin:auto">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border)">
    <div>
      <h2 id="pbm-title" style="font-size:0.95rem;font-weight:700;margin:0">{d.perfBreakdownTitle}</h2>
      <p id="pbm-subtitle" class="muted" style="font-size:0.78rem;margin:0.15rem 0 0"></p>
    </div>
    <button id="perf-breakdown-close" type="button" aria-label={d.perfBreakdownClose} style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius-sm);border:none;background:none;color:var(--color-muted);cursor:pointer;flex-shrink:0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div id="perf-breakdown-body" tabindex="-1" autofocus style="padding:1.25rem;min-height:19rem;display:flex;flex-direction:column;justify-content:center;outline:none"></div>
</dialog>
