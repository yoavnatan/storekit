---
import { formatAgorot } from '../../lib/money.js';
import type { PlatformOverview } from '../../lib/admin-stats.js';
import type { ImageModerationState } from '../../lib/image-moderation-health.js';

interface Props {
  overview: PlatformOverview;
  /** Stores with an empty catalogue — the retired "לתשומת לב" tab, now a chip on the Stores tab
   *  (סשן ב׳ §1). The card below is a LINK rather than a panel jump because it carries a filter
   *  with it; `data-goto-panel` can only switch tabs. */
  emptyStoreCount: number;
  emptyStoresHref: string;
  /** Whether anybody is checking uploaded pictures right now (`lib/image-moderation-health.ts`).
   *  A STATE, not an event — which is why it is a card here and not only a row in the Alerts log,
   *  where it would sit at the quietest severity beside every browser exception ever collected
   *  (owner, 2026-08-13). It removes itself when the answer becomes 'ok'. */
  imageModeration: ImageModerationState;
  imageModerationHref: string;
}
const { overview, emptyStoreCount, emptyStoresHref, imageModeration, imageModerationHref } = Astro.props;
---

{/* Each card jumps to its tab (data-goto-panel, wired in tab-nav.ts's
    initAdminTabNav()) — a <button> reset to look like the existing
    .admin-stat-card <div> (admin.css); the hover itself lives in admin.css
    (see that file's comment — a Tailwind hover: utility here would lose to
    admin.css's own unlayered rules). Revenue links to Orders since that's
    the only tab revenue is actually derived from — there's no dedicated
    revenue tab. */}
<div class="admin-stat-grid admin-stat-grid--aligned">
  <button type="button" class="admin-stat-card w-full text-inherit font-inherit cursor-pointer" data-goto-panel="sellers">
    <dt>מוכרים</dt>
    <dd>{overview.totalSellers}</dd>
  </button>
  <button type="button" class="admin-stat-card w-full text-inherit font-inherit cursor-pointer" data-goto-panel="stores">
    {/* Real stores only — the showcase ones are counted separately rather than
        folded in, so this card answers "how big is the marketplace" honestly. */}
    <dt>חנויות{overview.demoStores > 0 ? ` (+${overview.demoStores} הדגמה)` : ''}</dt>
    <dd>{overview.totalStores}</dd>
  </button>
  <button type="button" class="admin-stat-card w-full text-inherit font-inherit cursor-pointer" data-goto-panel="orders">
    {/* "למוכרים", and the word is doing real work as of 2026-08-07. This number counts order ROWS
        — one per store — while the Orders tab it links to now lists PURCHASES, so a five-store
        cart is 5 here and 1 card there. Both are right for their own job: the tab answers "what
        did this person buy", and this figure is the one `reconcile.ts` cross-checks the money
        against, where the unit has to be the per-store slice a seller is actually paid for. What
        would be wrong is the two disagreeing under one unqualified word. */}
    <dt title="נספרת שורה לכל חנות — רכישה מחמש חנויות היא חמש הזמנות כאן, וכרטיס אחד בלשונית ההזמנות">הזמנות למוכרים ({overview.paidOrders} ששולמו)</dt>
    <dd>{overview.totalOrders}</dd>
  </button>
  {/* GMV — what buyers paid sellers — NOT the platform's own income, which is
      commission + subscriptions + ad margin and lives in the Performance tab under
      its own heading. The old label ("סה"כ הכנסות פלטפורמה") read as the latter
      while showing the former, and its number included shipping and ignored seller
      discounts, so it could never be reconciled against the per-store rows in the
      Stores tab either. */}
  <button type="button" class="admin-stat-card w-full text-inherit font-inherit cursor-pointer" data-goto-panel="orders">
    {/* "מאז ומתמיד" is on the label because this is the ONE figure here with a same-named twin that
        is NOT all-time: the Performance tab shows GMV over a chosen range, so the two disagree by
        design and nothing said so (owner asked, 2026-08-12). Every other card on this grid — sellers,
        stores, orders — is a lifetime count that nobody would read as a period. */}
    <dt title="כל המכירות מאז ומתמיד. לפילוח לפי תקופה — לשונית הביצועים">מחזור מכירות (GMV) · מאז ומתמיד</dt>
    <dd>{formatAgorot(overview.gmvAgorot)}</dd>
  </button>
  {emptyStoreCount > 0 && (
    <a href={emptyStoresHref} class="admin-stat-card admin-stat-card--warning no-underline [color:inherit]">
      <dt>חנויות ללא מוצרים</dt>
      <dd>{emptyStoreCount}</dd>
    </a>
  )}
  {/* Reads as a fact about the platform rather than as a count, because it is one — the `dd` says
      what is true now and the `dt` names what it is about, the same way every card here does. The
      two causes are one operational meaning (nobody is checking the pictures) and two different
      next actions, so the sentence names which. `stopped` is the loud one: it arrives by itself,
      mid-month, while everything looks configured. */}
  {imageModeration !== 'ok' && (
    <a href={imageModerationHref} class="admin-stat-card admin-stat-card--warning no-underline [color:inherit]">
      <dt>סינון תמונות</dt>
      <dd>{imageModeration === 'off' ? 'כבוי' : 'נעצר'}</dd>
      <p class="!text-[0.78rem] !font-normal !m-0 !mt-1 [color:var(--color-muted)]">
        {imageModeration === 'off'
          ? 'תמונות שמוכרים מעלים אינן נבדקות. להפעלה: תוסף ב-Cloudinary + PUBLIC_IMAGE_MODERATION_ON'
          : 'התוסף מוצהר דלוק אך העלאה חזרה בלי בדיקה — כנראה נגמרה המכסה החודשית'}
      </p>
    </a>
  )}
</div>
