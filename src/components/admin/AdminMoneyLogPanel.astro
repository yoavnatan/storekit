---
import { formatAgorot } from '../../lib/money.js';
import { isolateLatinRunsHtml } from '../../lib/bidi-isolate.js';
import { formatBusinessTime, formatBusinessDateShort, formatBusinessDayLabel } from '../../lib/format-date.js';
import { MONEY_EVENT_LABELS, moneyActorLabel, moneyEventStateWord, type MoneyEvent, type MoneyEventType } from '../../lib/money-events.js';
import { businessDayISO } from '../../lib/business-day.js';
import { buildAdminUrl } from '../../lib/admin-nav.js';
import { hasActiveMoneyLogFilters, MONEY_LOG_DEFAULT_DAYS, type MoneyLogQuery } from '../../lib/admin-moneylog-filter.js';
import AdminPager from './AdminPager.astro';
import AdminReconciliationCard from './AdminReconciliationCard.astro';
import AdminMoneyLogToolbar from './AdminMoneyLogToolbar.astro';

import type { ReconciliationReport } from '../../lib/reconcile.js';

interface Props {
  /** One page of events, already filtered + sliced by the page (admin/index.astro). */
  events: MoneyEvent[];
  query: MoneyLogQuery;
  /** A `?mev=` permalink whose row isn't in the current result set. */
  targetMissing: boolean;
  /** Rows matching the active narrowing, across all pages. */
  total: number;
  page: number;
  totalPages: number;
  buildUrl: (page: number) => string;
  reconciliation: ReconciliationReport;
}
const { events, query, targetMissing, total, page, totalPages, buildUrl, reconciliation } = Astro.props;

// The tone is the point: a reader scanning this log is looking for the two rows that
// mean something went wrong, not reading all of them. Green = money arrived, red =
// money stopped counting, amber = something was caught and prevented. The LABELS live
// with the vocabulary (money-events.ts) because search matches them too.
const TYPE_TONE: Record<MoneyEventType, 'good' | 'bad' | 'warn' | 'plain'> = {
  payment_attempted: 'plain',
  order_created: 'good',
  // Red, not amber. A released hold is technically the system working correctly — but every one of
  // these rows means a real buyer's purchase failed after their card had already been touched, and
  // a row whose detail says RELEASE FAILED is money still sitting on that card. There is no reading
  // of this log where one of these is a row to scroll past.
  charge_voided: 'bad',
  duplicate_checkout_blocked: 'warn',
  payment_status_changed: 'plain',
  shipping_status_changed: 'plain',
  order_discount_changed: 'warn',
  // Red for the same reason `charge_voided` is: a real buyer's money is sitting with us for a
  // purchase that is not happening, and until `refund_settled` pairs it off, nobody has given it
  // back. Green for the settlement — the one row here that closes a debt.
  refund_due: 'bad',
  refund_settled: 'good',
  // The payout side, and the tones say what someone scanning this log needs to act on. Creating
  // the obligation is neutral — it is bookkeeping, and no money has moved. Sending is the good
  // outcome. A FAILED payout is red and belongs beside `charge_voided` and `refund_due`: it is a
  // seller who has not been paid, does not know why, and whose money is still sitting with us.
  payout_created: 'plain',
  payout_sent: 'good',
  payout_failed: 'bad',
  // Amber, not red. A clawback is the system working — money we had already released is being
  // recovered from a sale that was undone — but it is money coming OUT of a real business's
  // balance without them initiating it, which is the single most likely row in this journal to
  // start a dispute. It should never scroll past unnoticed, and it is not an emergency.
  seller_debited: 'warn',
};

const TONE_CLASS: Record<'good' | 'bad' | 'warn' | 'plain', string> = {
  good:  'bg-[color:color-mix(in_srgb,var(--color-success)_14%,transparent)] text-[color:var(--color-success)]',
  bad:   'bg-[color:color-mix(in_srgb,var(--color-danger)_14%,transparent)] text-[color:var(--color-danger)]',
  warn:  'bg-[color:color-mix(in_srgb,var(--color-warning)_18%,transparent)] text-[color:var(--color-text)]',
  plain: 'bg-[color:var(--color-bg)] text-[color:var(--color-muted)]',
};

/** A cancellation is the one status move that takes money OUT of every report, so it
 *  reads as a loss rather than as a neutral status change. */
function toneFor(e: MoneyEvent): 'good' | 'bad' | 'warn' | 'plain' {
  if (e.type === 'shipping_status_changed' && e.to === 'cancelled') return 'bad';
  if (e.type === 'payment_attempted' && e.detail?.startsWith('declined')) return 'bad';
  return TYPE_TONE[e.type] ?? 'plain';
}

// Grouped by business day (business-day.ts — the same calendar every report buckets
// by, so a row here lands on the day the seller's chart puts it on). Each row still
// carries its own date: on a searched page the groups are no longer consecutive days,
// and a heading scrolled off the top leaves a row with no date at all (owner, סשן ג׳).
const byDay = new Map<string, MoneyEvent[]>();
for (const e of events) {
  const day = businessDayISO(new Date(e.at));
  byDay.set(day, [...(byDay.get(day) ?? []), e]);
}

/** Clicking an order/checkout reference searches for it — the per-order timeline the
 *  journal was built for ("what happened to this order"), with no extra query surface. */
const traceUrl = (term: string) => buildAdminUrl('moneylog', { mq: term });
/**
 * The reference line under a detail, as PARTS — joined only where there is something on both sides.
 *
 * It used to be written as markup, with the `·` living inside the checkout-ref fragment: `{orderId
 * && <a/>}{checkoutRef && <> · <a/></>}{` · בוצע ע״י …`}`. A separator that belongs to the thing
 * AFTER it is a separator that shows up with nothing in front of it, and this journal's most common
 * row is exactly that case — a `payment_attempted` has a checkout ref and no order yet, so the line
 * opened with a stray dot (owner, 2026-08-20: *"יש שם אי סדר בטקסט"*). Built as a list instead, so
 * the join is a property of how many parts exist rather than a guess each part makes about its
 * neighbours.
 */
type MetaPart = 'order' | 'ref' | 'actor';
function metaParts(e: MoneyEvent): MetaPart[] {
  const parts: MetaPart[] = [];
  if (e.orderId) parts.push('order');
  if (e.checkoutRef) parts.push('ref');
  parts.push('actor');
  return parts;
}

const highlightId = targetMissing ? '' : query.eventId;
---

<section>
  {/* NO standing explanation above the table (owner, סשן ב׳: "everything up top is unnecessary
      and heavy" — said of prose that had grown to five lines). Everything it used to say is now
      said where it applies and only when it applies: each row names its own store slice, so a
      multi-store purchase explains itself; the אסמכתא link's tooltip says it opens the whole
      purchase; and the append-only nature of the journal is a property of the data, not something
      a reader has to be told before every reading of it. A paragraph nobody re-reads after the
      first visit is a permanent tax on the ones who do. */}
  <header class="mb-4">
    <h2 class="m-0 text-[1.05rem] font-semibold">יומן אירועים כספיים</h2>
  </header>

  <AdminReconciliationCard reconciliation={reconciliation} />
  <AdminMoneyLogToolbar query={query} total={total} />

  {/* Two different answers, because offering "look in the full journal" when the
      journal ISN'T narrowed is a link back to the same page — a dead end that reads
      as the feature being broken rather than as the row being gone. */}
  {targetMissing && (
    <p class="rounded-[var(--radius)] border border-[color:var(--color-warning)] bg-[color:color-mix(in_srgb,var(--color-warning)_12%,transparent)] p-3 mb-4 text-[0.8rem] leading-relaxed">
      {hasActiveMoneyLogFilters(query) ? (
        <Fragment>
          האירוע שאליו הקישור מפנה לא נמצא בסינון הנוכחי.
          <Fragment> </Fragment>
          {/* Drops the type/search AND names the row's own window, so the link cannot land back on
              the same default that hid it — see admin-moneylog-filter.ts#widenToEvent. */}
          <a href={buildAdminUrl('moneylog', { mev: query.eventId })} class="[color:var(--color-primary)]">חפשו אותו ביומן המלא</a>.
        </Fragment>
      ) : 'האירוע שאליו הקישור מפנה אינו קיים ביומן.'}
    </p>
  )}

  {/* THREE answers, not two. Since the journal opens on a default window, "nothing here" no
      longer means "nothing ever recorded" — saying so would be a flat lie to an owner whose
      journal is simply older than 30 days, and it would hide the one control that fixes it. */}
  {events.length === 0 ? (
    <p class="text-[0.85rem] [color:var(--color-muted)] py-8 text-center">
      {hasActiveMoneyLogFilters(query)
        ? 'אין אירועים שתואמים לסינון הזה.'
        : `לא נרשמו אירועים כספיים ב־${MONEY_LOG_DEFAULT_DAYS} הימים האחרונים. בחרו טווח תאריכים אחר כדי לראות רשומות ישנות יותר.`}
    </p>
  ) : (
    <div class="flex flex-col gap-5" id="admin-moneylog-rows" data-highlight={highlightId}>
      {[...byDay.entries()].map(([day, rows]) => (
        <div>
          <h3 class="m-0 mb-2 text-[0.78rem] font-semibold [color:var(--color-muted)]">{formatBusinessDayLabel(day)}</h3>
          {/* Scrolls inside its own box rather than pushing the page sideways on a phone.
              `relative` is LOAD-BEARING, not decoration: without it the table's overflow
              still counted toward `documentElement.scrollWidth` on this RTL page even
              though the wrapper was scrolling correctly — measured at 375px, 679px of
              document for a 375px viewport (617px before this table was widened, i.e.
              the leak predates it). Positioning the wrapper brings it back to exactly
              375. `overflow-x:clip` and `isolation:isolate` do NOT fix it; `contain:paint`
              does, but buys nothing extra here. Re-measure before removing. */}
          <div class="relative overflow-x-auto">
            <table class="w-full border-collapse text-[0.82rem] min-w-[42rem]">
              <thead>
                <tr class="text-start [color:var(--color-muted)] text-[0.74rem]">
                  <th class="text-start font-medium py-1.5 pe-3 whitespace-nowrap">תאריך ושעה</th>
                  <th class="text-start font-medium py-1.5 pe-3">אירוע</th>
                  <th class="text-start font-medium py-1.5 pe-3 whitespace-nowrap">סכום</th>
                  <th class="text-start font-medium py-1.5 pe-3">חנות</th>
                  <th class="text-start font-medium py-1.5 pe-3">פירוט</th>
                  <th class="text-start font-medium py-1.5"><span class="sr-only">קישור לשורה</span></th>
                </tr>
              </thead>
              <tbody>
                {rows.map((e) => (
                  <tr
                    data-event-row={e.id}
                    class:list={[
                      'border-t border-[color:var(--color-border)] align-top transition-colors',
                      e.id === highlightId && 'bg-[color:color-mix(in_srgb,var(--color-primary)_10%,transparent)]',
                    ]}
                  >
                    <td class="py-2 pe-3 whitespace-nowrap [color:var(--color-muted)] tabular-nums">
                      {formatBusinessDateShort(e.at)}
                      <span class="block text-[0.75rem] opacity-80">{formatBusinessTime(e.at)}</span>
                    </td>
                    <td class="py-2 pe-3">
                      <span class:list={['inline-block px-2 py-0.5 rounded-full text-[0.72rem] font-medium whitespace-nowrap', TONE_CLASS[toneFor(e)]]}>
                        {MONEY_EVENT_LABELS[e.type] ?? e.type}
                      </span>
                      {e.from && e.to && (
                        <span class="block mt-1 text-[0.72rem] [color:var(--color-muted)]">{moneyEventStateWord(e.type, e.from)} ← {moneyEventStateWord(e.type, e.to)}</span>
                      )}
                    </td>
                    <td class="py-2 pe-3 whitespace-nowrap font-medium tabular-nums">
                      {e.amountAgorot !== undefined ? formatAgorot(e.amountAgorot) : '—'}
                    </td>
                    <td class="py-2 pe-3 [color:var(--color-muted)]">{e.storeSlug ?? '—'}</td>
                    <td class="py-2 pe-3 [color:var(--color-muted)] break-words">
                      {/* Every Latin run isolated (`lib/bidi-isolate.ts`). A detail line is Hebrew
                          prose carrying machine values — a gateway reference, an eight-character
                          order id — and the Unicode bidi algorithm resolves the neutral space and
                          the digit after such a run left-to-right, so `אסמכתת סליקה MOCK-B85303C8 ·
                          1 הזמנה` painted the count on the far side of the reference, detached from
                          the word it counts. The owner read it as a number belonging to nothing.
                          Isolating in the RENDERER and not in the stored string is that module's own
                          rule: the journal is append-only, and what it recorded is what it recorded. */}
                      <Fragment set:html={isolateLatinRunsHtml(e.detail ?? '—')} />
                      {/* No opacity dimming on this line: the order/checkout refs inside it are
                          links, and fading them took the one affordance saying so. */}
                      {/* Labelled, and the label is not decoration. Unlabelled behind the same `·`
                          as the links beside it, the actor read as part of the reference — the owner
                          asked what an "אסמכתא … buyer" was, which is exactly what that line said.
                          The ids go in `<bdi>` for the reason the detail above does: they are Latin
                          runs inside a Hebrew line. */}
                      <span class="block mt-0.5 text-[0.7rem]">
                        {metaParts(e).map((part, i) => (
                          <Fragment>
                            {i > 0 && ' · '}
                            {part === 'order' && (
                              <a href={traceUrl(e.orderId!)} title="כל האירועים של הזמנה זו" class="[color:var(--color-primary)] no-underline hover:underline">הזמנה <bdi>{e.orderId!.slice(0, 8)}</bdi></a>
                            )}
                            {part === 'ref' && (
                              /* **"אסמכתא של מה?"** (owner, סשן ד׳). The word is right — it is the
                                 platform's word for this number everywhere, including the buyer's
                                 own order mail (`lib/email/parts.ts`) — and a bare noun was what
                                 made it unreadable: it named a reference without naming what it
                                 refers to, on a line that already carries an order id beside it.
                                 Two words instead of one say which of the two ids this is, and the
                                 tooltip says the rest. Renaming it to "קנייה" was the alternative
                                 and it was rejected: the buyer, the invoice and the emails would
                                 then be using a different word for the same number. */
                              <a href={traceUrl(e.checkoutRef!)} title="מספר התשלום אצל ספק הסליקה — חיוב אחד שמכסה את כל הקנייה, כל החנויות יחד. אותו מספר מופיע במייל לקונה. לחיצה מציגה את כל אירועי הקנייה." class="[color:var(--color-primary)] no-underline hover:underline">אסמכתת תשלום <bdi>{e.checkoutRef}</bdi></a>
                            )}
                            {part === 'actor' && `בוצע ע״י ${moneyActorLabel(e.actor)}`}
                          </Fragment>
                        ))}
                      </span>
                    </td>
                    <td class="py-2 text-center">
                      <button
                        type="button"
                        class="admin-moneylog-link-btn bg-transparent border-0 p-1 cursor-pointer [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors"
                        data-permalink={buildAdminUrl('moneylog', { mev: e.id })}
                        aria-label="העתקת קישור ישיר לשורה"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"/></svg>
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
  )}

  <AdminPager page={page} totalPages={totalPages} buildUrl={buildUrl} />
</section>
