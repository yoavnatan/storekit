---
// Flat, top-level "every store, one row each" view — the Sellers tab already
// shows stores, but three levels deep inside a per-seller accordion
// (AdminSellersPanel.astro). This is the owner-requested "there has to be a
// Stores tab" (CURRENT_TASK.md, 2026-07-14): a plain scannable/searchable
// list across every store regardless of who owns it. Reuses the same
// block/unblock endpoint (/api/admin/moderation) the Sellers tab already
// calls, wired independently in stores.ts (see that file's header comment
// for why it doesn't share the Sellers tab's .admin-block-toggle class).
import type { AdminSortDir, AdminStoreSortCol, StoreRow, StoreStateFilter } from '../../lib/admin-stats.js';
import { STORE_STATE_FILTERS } from '../../lib/admin-stats.js';
import { storeLifecycle } from '../../lib/store-status.js';
import { formatAgorot } from '../../lib/money.js';
import AdminPager from './AdminPager.astro';
import StoreAvatar from '../StoreAvatar.astro';
import AdminStoreStateBadge from './AdminStoreStateBadge.astro';
import AdminNewBadge from './AdminNewBadge.astro';
import AdminNewOnlyToggle from './AdminNewOnlyToggle.astro';

interface Props {
  storeRows: StoreRow[]; // current page only
  q: string;
  sortCol: AdminStoreSortCol;
  sortDir: AdminSortDir;
  state: StoreStateFilter;
  stateCounts: Record<StoreStateFilter, number>;
  /** The "לתשומת לב" tab, as a chip (admin-stats.ts#AdminStoreQuery.emptyOnly). */
  emptyOnly: boolean;
  emptyCount: number;
  newSince: string;  // ISO — anything created after this is what the tab's "(N)" counted
  newOnly: boolean;
  newCount: number;
  totalAll: number;
  totalFiltered: number;
  page: number;
  totalPages: number;
  buildUrl: (page: number) => string;
}
const { storeRows, q, sortCol, sortDir, state, stateCounts, emptyOnly, emptyCount, newSince, newOnly, newCount, totalAll, totalFiltered, page, totalPages, buildUrl } = Astro.props;

// The state chips. Labels come from the same map the row badges use, so a chip and the badge on
// the rows it filters to can never say different words for the same state.
const STATE_LABELS: Record<StoreStateFilter, string> = {
  all: 'הכל', active: 'פעילות', paused: 'מוקפאות', closing: 'לקראת סגירה', closed: 'סגורות', blocked: 'חסומות',
};
// An empty state is not worth a chip — on a healthy platform that would be four zeros between the
// admin and the two filters they actually use. "הכל" and "פעילות" always show so the row never
// collapses to nothing, and the selected one always shows so it can be switched off again.
const stateChips = STORE_STATE_FILTERS.filter(
  (f) => f === 'all' || f === 'active' || f === state || stateCounts[f] > 0,
);

const sortLabels: Record<string, string> = {
  'name:asc': 'שם: א — ת',
  'name:desc': 'שם: ת — א',
  'revenue:desc': 'הכנסות: גבוה — נמוך',
  'revenue:asc': 'הכנסות: נמוך — גבוה',
  'products:desc': 'מוצרים: רב — מעט',
};

// Silent "shop-window" curation weight (see stores.ts#promoWeight). The label
// mirrors the store's current tier; the button cycles 0→1→2→0 (client-side,
// see scripts/admin/stores.ts). Kept in sync with promoLabel() there.
const promoLabels = ['קדם חנות', 'קידום', 'קידום חזק'];
const promoLabel = (w: number): string => promoLabels[Math.max(0, Math.min(2, w))] ?? promoLabels[0]!;
---

<div class="admin-orders-search">
  <input type="search" id="admin-store-search" class="input" value={q} placeholder="חיפוש לפי שם חנות, כתובת או מוכר/ת..." aria-label="חיפוש חנות" />
</div>

{totalAll === 0 ? (
  <p class="admin-empty">אין חנויות עדיין.</p>
) : (
  <Fragment>
    <div class="flex flex-wrap items-center gap-2 mb-4" id="admin-stores-toolbar" data-sort-col={sortCol} data-sort-dir={sortDir} data-state={state} data-empty-only={emptyOnly ? '1' : ''} data-new-only={newOnly ? '1' : ''}>
      <button type="button" id="admin-stores-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
        <span id="admin-stores-sort-label">{sortLabels[`${sortCol}:${sortDir}`] ?? sortLabels['name:asc']}</span>
        <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      {/* One chip per store state, each carrying its count — so "how many are paused, and how many
          are waiting to close" is answered by LOOKING, before any filtering. The counts are over
          every store, not the current page. */}
      {stateChips.map((f) => (
        <button
          type="button"
          class="table-toolbar-btn admin-stores-state-chip inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] border"
          data-state={f}
          style={state === f ? 'background:var(--color-primary);border-color:var(--color-primary);color:#fff' : 'color:var(--color-text);background:var(--color-surface);border-color:var(--color-border)'}
          aria-pressed={state === f}
        >
          {STATE_LABELS[f]}
          <span class="opacity-70 tabular-nums">{stateCounts[f]}</span>
        </button>
      ))}
      {/* What the "לתשומת לב" tab was (owner, סשן ב׳ §1). It sits beside the state chips rather
          than among them because it is a different question — a store can be paused AND empty —
          and it appears only when there is one, like the empty state chips above. */}
      {(emptyCount > 0 || emptyOnly) && (
        <button
          type="button"
          id="admin-stores-empty-chip"
          class="table-toolbar-btn inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] border"
          style={emptyOnly ? 'background:var(--color-warning);border-color:var(--color-warning);color:var(--color-text)' : 'color:var(--color-text);background:var(--color-surface);border-color:var(--color-border)'}
          aria-pressed={emptyOnly}
          title="חנויות שעדיין לא העלו מוצר — מעקב בלבד, שום פעולה של המוכר/ת אינה חסומה"
        >
          ללא מוצרים
          <span class="opacity-70 tabular-nums">{emptyCount}</span>
        </button>
      )}
      {(newCount > 0 || newOnly) && <AdminNewOnlyToggle id="admin-stores-new-toggle" active={newOnly} count={newCount} />}
    </div>

    {totalFiltered === 0 && <p class="admin-empty">לא נמצאו חנויות תואמות.</p>}

    <AdminPager position="top" page={page} totalPages={totalPages} buildUrl={buildUrl} />
    <ul class="admin-store-list" id="admin-store-list">
      {storeRows.map(({ store, seller, productCount, revenue, openOrders }) => {
        const promoWeight = store.promoWeight ?? 0;
        // Only for a store waiting to close: it answers the one question the badge raises —
        // why is it still here, and how far off is the closure. Anywhere else this number is
        // ordinary day-to-day work and would just be noise on every row.
        const closingNote = storeLifecycle(store) === 'closing'
          ? (openOrders === 1 ? 'ממתינה להזמנה פתוחה אחת' : `ממתינה ל-${openOrders} הזמנות פתוחות`)
          : '';
        return (
          <li class="admin-store-row">
            <div class="admin-store-row__info">
              <StoreAvatar name={store.name} slug={store.slug} profileImage={store.profileImage} size={34} />
              <div class="admin-store-row__info-text">
                <span class="admin-store-row__name">
                  {store.name}
                  {store.createdAt > newSince && <AdminNewBadge />}
                  <AdminStoreStateBadge store={store} />
                  {promoWeight > 0 && <span class="admin-badge admin-badge--promo" data-promo-badge>{promoLabel(promoWeight)}</span>}
                </span>
                <span class="admin-store-row__seller muted">
                  {seller?.name ?? '—'} · {seller?.email ?? ''}
                  {closingNote && <span class="[color:var(--color-warning)]"> · {closingNote}</span>}
                </span>
              </div>
            </div>
            {productCount > 0 ? (
              <button
                type="button"
                class="admin-store-row__count admin-store-products-toggle group inline-flex items-center gap-1 bg-transparent border-0 font-[inherit] cursor-pointer hover:[color:var(--color-primary)] transition-colors duration-100"
                data-store-slug={store.slug}
                aria-expanded="false"
                title="הצג/הסתר מוצרים"
              >
                {productCount} מוצרים
                <svg class="shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            ) : (
              <span class="admin-store-row__count">{productCount} מוצרים</span>
            )}
            <span class="admin-store-row__revenue"><span class="admin-store-row__revenue-label">סה"כ הכנסות:</span> {formatAgorot(revenue.totalRevenueAgorot)}</span>
            <span class="admin-store-row__revenue"><span class="admin-store-row__revenue-label">הכנסות החודש:</span> {formatAgorot(revenue.monthRevenueAgorot)}</span>
            {/* All row actions moved into one three-dot kebab menu (CURRENT_TASK
                admin item) — the row was blown up with 5 inline actions, leaving no
                room for the important numbers. The menu is the shared floating-portal
                dropdown (stores.ts), matching every other dropdown on the site. State
                the menu needs (promo weight, blocked) lives on the trigger so reopening
                after an action reflects the fresh value. */}
            <div class="admin-store-row__actions">
              <button
                type="button"
                class="admin-store-row__kebab inline-flex items-center justify-center w-8 h-8 rounded-full border-0 bg-transparent cursor-pointer [color:var(--color-muted)] transition-colors duration-100 hover:bg-[color:var(--color-bg)] hover:[color:var(--color-text)] aria-expanded:bg-[color:var(--color-bg)] aria-expanded:[color:var(--color-text)]"
                data-store-slug={store.slug}
                data-store-name={store.name}
                data-blocked={store.blocked ? '1' : ''}
                data-weight={String(promoWeight)}
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="פעולות חנות"
                title="פעולות"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
              </button>
            </div>
            {productCount > 0 && (
              <div class="admin-store-row__products" data-store-slug={store.slug} data-loaded="" hidden></div>
            )}
          </li>
        );
      })}
    </ul>
    <AdminPager page={page} totalPages={totalPages} buildUrl={buildUrl} />
  </Fragment>
)}
