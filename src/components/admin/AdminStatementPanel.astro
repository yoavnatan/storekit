---
import { formatAgorot } from '../../lib/money.js';
import { formatBusinessDayLabel } from '../../lib/format-date.js';
import type { PlatformStatement } from '../../lib/platform-statement.js';

/**
 * **The month's closing statement, as a document rather than a dashboard.**
 *
 * The distinction is the request (owner, 2026-08-11) and it drives every layout choice here: this
 * is meant to be READ TOP TO BOTTOM ONCE, printed, and handed on. So there are no tiles, no
 * sparklines, no colour carrying meaning, and nothing is clickable inside the two tables — a figure
 * that is a link is a figure someone has to decide about. Every line is `label … amount`, in the
 * order an accountant reads them, and the two sections are visibly different documents' worth of
 * information rather than one grid of numbers.
 *
 * **The section headings state their basis, in the heading.** "נצבר בתקופה" and "תנועה בפועל" with
 * the dating rule under each — because the first question asked of any such page is "is this what I
 * earned or what I received", and a page that makes someone ask is a page that gets checked by
 * hand.
 *
 * **The closing balance is the one row with weight**, and it is the sum of the four rows above it
 * (`platform-statement.ts` builds it that way on purpose), so a reader can add up what is printed
 * and land on it.
 *
 * Printing is `window.print()` on the browser's own engine — no PDF library, no second layout
 * surface. `admin.css`'s `@media print` block hides the dashboard chrome so the printed page is
 * this section and nothing else.
 */
interface Props {
  statement: PlatformStatement;
  /** Month keys for the picker, newest first. */
  monthKeys: readonly string[];
  activeMonth: string | null;
  fromISO: string;
  toISO: string;
  csvHref: string;
}
const { statement: s, monthKeys, activeMonth, fromISO, toISO, csvHref } = Astro.props;

const MONTH_NAMES = ['ינואר', 'פברואר', 'מרץ', 'אפריל', 'מאי', 'יוני', 'יולי', 'אוגוסט', 'ספטמבר', 'אוקטובר', 'נובמבר', 'דצמבר'];
const monthLabel = (key: string): string => `${MONTH_NAMES[Number(key.slice(5, 7)) - 1]} ${key.slice(0, 4)}`;

const title = s.period.monthKey
  ? monthLabel(s.period.monthKey)
  : `${formatBusinessDayLabel(s.period.fromISO)} — ${formatBusinessDayLabel(s.period.toISO)}`;

const ROW = 'flex items-baseline justify-between gap-4 py-[0.4rem] border-b [border-color:var(--color-border)] last:border-b-0';
const LABEL = 'text-[0.85rem] [color:var(--color-text)]';
const AMOUNT = 'text-[0.9rem] tabular-nums whitespace-nowrap';
const NOTE = 'text-[0.72rem] [color:var(--color-muted)]';
const SECTION = 'rounded-[var(--radius)] border [border-color:var(--color-border)] p-4';
---

{/* Not printed: the controls. Everything below `#admin-statement-doc` is the document. */}
{/* No `.field` on these labels, deliberately: it is unlayered legacy CSS (forms.css) carrying
    `margin-bottom:1rem`, so a Tailwind `m-0` on the same element LOSES to it regardless of order —
    the documented trap, and here it would push the two buttons out of line with the inputs. The
    label markup is three utilities; the `.input` treatment is kept, since that one is the site's
    single field/focus rule and re-deriving it is how a seventh focus style gets born. */}
<div class="flex flex-wrap items-end gap-2 mb-4 admin-statement-controls" id="admin-statement-controls" data-month={activeMonth ?? ''} data-from={fromISO} data-to={toISO}>
  <label class="flex flex-col gap-1">
    <span class="text-[0.76rem] [color:var(--color-muted)]">חודש</span>
    <select id="admin-statement-month" class="input !py-[.4rem] !w-auto">
      {monthKeys.map((key) => (
        <option value={key} selected={key === activeMonth}>{monthLabel(key)}</option>
      ))}
      {/* The escape hatch out of month-mode, and it is an option rather than a second control so
          the two ways of naming a period cannot both look active at once. */}
      <option value="" selected={activeMonth === null}>טווח אחר…</option>
    </select>
  </label>
  {/* `!hidden`, never the `hidden` ATTRIBUTE: this element is `display:flex`, and a utility beats
      the UA stylesheet's `[hidden]{display:none}` — the row would stay visible in month mode. The
      client toggles the same class for the same reason. */}
  <div class:list={['flex items-end gap-2', activeMonth !== null && '!hidden']} id="admin-statement-range">
    <label class="flex flex-col gap-1">
      <span class="text-[0.76rem] [color:var(--color-muted)]">מתאריך</span>
      <input type="date" id="admin-statement-from" class="input !py-[.4rem] !w-auto" value={fromISO} />
    </label>
    <label class="flex flex-col gap-1">
      <span class="text-[0.76rem] [color:var(--color-muted)]">עד תאריך</span>
      <input type="date" id="admin-statement-to" class="input !py-[.4rem] !w-auto" value={toISO} />
    </label>
  </div>
  <a class="btn btn--ghost btn--sm" id="admin-statement-csv" href={csvHref} download>הורדת CSV</a>
  <button type="button" class="btn btn--ghost btn--sm" id="admin-statement-print">הדפסה / PDF</button>
</div>

<section id="admin-statement-doc">
  {/* `.dash-panel-head` so it pins under the tab strip like every other admin panel's heading. This
      one keeps its own header rather than taking the shell's (AdminPanelShell) because its title is
      composed from the period being shown, and it carries the dates under it. */}
  <header class="dash-panel-head mb-4 py-[0.6rem] border-b [border-color:var(--color-border)]">
    <h2 class="m-0 text-[1.05rem] font-semibold">דוח חשבונאי — {title}</h2>
    <p class={`m-0 mt-1 ${NOTE}`}>
      {formatBusinessDayLabel(s.period.fromISO)} — {formatBusinessDayLabel(s.period.toISO)} · הופק {formatBusinessDayLabel(s.generatedAtISO)}
    </p>
  </header>

  {/* ── The bottom line, in the owner's words, before either table ──
      Owner, 2026-08-12: *"לא מבין כלום... מרגיש לי שאני לא יודע להצביע בזמן נתון על המאזן"*. Every
      figure he wanted was already on this page and every one of them was in accountant's language,
      split across two bases he has to hold in his head to combine. So the three sentences he would
      actually ask for come FIRST, each carrying its own number, and the tables below stay exactly
      what they are — the working behind them, for the רו״ח.

      It repeats three figures rather than introducing any, which is the property that keeps it
      honest: there is nothing here to reconcile against the tables, because it IS the tables. The
      third line is the one nothing on the page said before — what the 10th of the month actually
      does — and it says the part that is easy to get backwards: the transfer shrinks a liability,
      it does not reduce income. */}
  <section class={`${SECTION} mb-4 statement-owner-only`}>
    <h3 class="m-0 text-[0.9rem] font-semibold mb-2">שורה תחתונה</h3>
    <ul class="m-0 p-0 list-none flex flex-col gap-2">
      <li class="text-[0.85rem] leading-relaxed">
        <strong class="tabular-nums">{formatAgorot(s.incomeAccruedAgorot)}</strong> — ההכנסה שלך בתקופה:
        עמלות <span class="tabular-nums">{formatAgorot(s.commissionAccruedAgorot)}</span>
        {' '}+ דמי מנוי <span class="tabular-nums">{formatAgorot(s.subscriptionsAccruedAgorot)}</span>
        {s.adMarginAgorot !== null && <> + עמלות קמפיינים <span class="tabular-nums">{formatAgorot(s.adMarginAgorot)}</span></>}.
      </li>
      <li class="text-[0.85rem] leading-relaxed">
        {/* What replaced three lines here on 2026-08-21: how much was collected, what was about to
            come in on the payout day, and how much of the bank account was somebody else's. All
            three were facts about money passing through us, and none of them can be stated now —
            the processor takes our commission inside each transaction and transfers it monthly, and
            nothing of a seller's ever reaches our account. What is left to say is where the income
            came from, above, and where the gap is. */}
        <strong class="tabular-nums">{formatAgorot(s.commissionAccruedAgorot)}</strong> — מזה עמלות מכירה,
        והן נגבות מאליהן בתוך כל עסקה ומועברות אלינו על ידי חברת הסליקה אחת לחודש.
        דמי המנוי והפרסום הם חיוב נפרד מול המוכר, וטרם מחוברים.
      </li>
    </ul>
  </section>

  <div class="grid grid-cols-1 gap-4">
    <div class={SECTION}>
      {/* ONLY the platform's own money (owner, 2026-08-11). The sellers' share is deliberately not
          a line in this table: it is not income and it is not ours, and a reader who sees it under
          a heading ending in "סה"כ הכנסה" concludes that paying sellers reduces his revenue. It
          used to appear in a second table beside this one, as the `+` line of a liability we
          carried; there is no such liability any more, and no such table. */}
      <h3 class="m-0 text-[0.9rem] font-semibold">ההכנסה שלנו</h3>
      {/* Two sentences, and the second one is the answer to the question the owner actually asked
          (2026-08-12): *"מתי הוא מניח שאני מושך כסף אליי?"* — never, is the answer, and a document
          on an accrual basis has to say so on its face. The commission is EARNED at the sale and
          COLLECTED at the payout, and the figure for the collected half is the last line of the
          table beside this one, which is where the sentence points. */}
      <p class={`m-0 mt-0.5 mb-3 ${NOTE}`}>
        לפי מועד ההזמנה — מה שהרווחנו בתקופה, גם אם הכסף עדיין בהמתנה. בפועל העמלה נגבית מאוחר יותר,
        כשהיא מנוכה מהתשלום למוכר ("עמלה שנגבתה בפועל", בטבלה שלצד).
      </p>
      {/* The mall's turnover, named as a line and kept OUT of the totalled list. The owner looked
          for "מכירות" and did not find the word (2026-08-12), so it is the label now — but it stays
          above the divider, because any line sitting inside a column that ends in a total reads as
          part of that total, and this is not our money. It is what the commission is a percentage
          OF, and the note under it says so rather than leaving a reader to work it out. */}
      <div class="mb-3 pb-3 border-b [border-color:var(--color-border)]">
        <div class="flex items-baseline justify-between gap-4">
          <span class={LABEL}>מכירות דרך הפלטפורמה</span>
          <span class={AMOUNT}>{formatAgorot(s.grossAgorot)}</span>
        </div>
        <p class={`m-0 mt-0.5 ${NOTE}`}>{s.purchases} רכישות · מחזור המוכרים, לא הכנסה שלנו — זהו הסכום שהעמלה נגזרת ממנו</p>
      </div>
      <dl class="m-0">
        {/* The rate is stated because the amount alone does not say what it is MADE OF (owner,
            2026-08-12: *"אני לא רואה מה מרכיב את הצבירה הזאת"*). Computed from the two figures
            printed on this very page — sales above, commission here — so a reader can check it
            rather than take it, and it is a BLENDED rate: sellers sit on different tiers
            (`pricing.ts`), so there is no single percentage to quote instead. */}
        <div class={ROW}>
          <dt class={LABEL}>
            עמלת הפלטפורמה
            {/* NOT "בממוצע" (owner, 2026-08-12): the commission is computed exactly, per order, at
                the owning seller's tier rate — the percentage here is simply the ratio between the
                two figures printed above it, and calling it an average suggested the calculation
                itself was approximate. It reads as one clean rate whenever every seller is on the
                same tier, which is the common case today. */}
            {s.grossAgorot > 0 && <span class={`block ${NOTE}`}>{(s.commissionAccruedAgorot / s.grossAgorot * 100).toFixed(2)}% מסך המכירות · מחושב לכל מוכר לפי המסלול שלו</span>}
          </dt>
          <dd class={`m-0 ${AMOUNT}`}>{formatAgorot(s.commissionAccruedAgorot)}</dd>
        </div>
        <div class={ROW}>
          <dt class={LABEL}>דמי מנוי<span class={`block ${NOTE}`}>{s.subscribers} מנויים</span></dt>
          <dd class={`m-0 ${AMOUNT}`}>{formatAgorot(s.subscriptionsAccruedAgorot)}</dd>
        </div>
        {/* The third income stream. Present as a LINE even while it has no figure — see
            `platform-statement.ts`: absent read as forgotten, and a 0 would have been a claim. */}
        <div class={ROW}>
          <dt class={LABEL}>עמלות קמפיינים<span class={`block ${NOTE}`}>{s.adMarginAgorot === null ? 'טרם — החיבור לגוגל/מטא לא בוצע' : 'המרווח שלנו על תקציבי הפרסום'}</span></dt>
          <dd class={`m-0 ${AMOUNT}${s.adMarginAgorot === null ? ' [color:var(--color-muted)]' : ''}`}>{s.adMarginAgorot === null ? '—' : formatAgorot(s.adMarginAgorot)}</dd>
        </div>
        <div class="flex items-baseline justify-between gap-4 pt-2.5 mt-1 border-t-2 [border-color:var(--color-text)]">
          {/* THE line the owner was looking for and could not find (2026-08-12: *"איפה השורה
              שאומרת כמה אני מכניס בחודש"*). It was already the bottom of this table; what was
              missing is that "נצברה" answers only half the question, so the earned figure now
              carries the collected one directly under it. */}
          <dt class="text-[0.9rem] font-semibold">ההכנסה שלי בתקופה<span class={`block font-normal ${NOTE}`}>נצברה — נרשמת במועד המכירה</span></dt>
          <dd class="m-0 text-[1.05rem] font-bold tabular-nums whitespace-nowrap">{formatAgorot(s.incomeAccruedAgorot)}</dd>
        </div>
      </dl>
    </div>
  </div>

  {/* On the document, not under it. Each line is something an accountant would otherwise ASK, and
      the answer to two of them is "this number is deliberately not here" — which is only honest if
      the document says so itself. */}
  <ul class={`mt-4 ps-4 flex flex-col gap-1 ${NOTE}`}>
    <li>המספרים מחושבים מהנתונים החיים. ביטול הזמנה ישנה משנה גם תקופה שכבר הופקה.</li>
    <li>שורת עמלות הקמפיינים ריקה בכוונה — עד לחיבור החשבונות בגוגל ובמטא אין מספר אמיתי לדווח, והיא אינה נכללת בסה"כ.</li>
    <li>ללא מע"מ וללא מספרי חשבונית — טרם נקבעו.</li>
    {/* The largest thing this document is NOT, and until now the only way to find that out was to
        look for an expense line and fail to find one. The platform records no expense of its own —
        gateway fees, our own campaign spend, hosting — so this is an income-and-liability statement,
        not a P&L, and the accountant's own books are where the two meet. Said here rather than
        left implied, for the same reason as every other line on this list. */}
    <li>הדוח מציג הכנסות והתחייבות למוכרים בלבד. הוצאות התפעול (עמלות סליקה, הפרסום שלנו, שרתים) אינן נרשמות במערכת — הן מגיעות מהבנק ומהחשבוניות אצל רואה החשבון, ורק שם מתקבל הרווח.</li>
  </ul>
</section>
