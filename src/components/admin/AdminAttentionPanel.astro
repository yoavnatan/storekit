---
import type { AttentionEntry } from '../../lib/admin-stats.js';

interface Props {
  entries: AttentionEntry[];
}
const { entries } = Astro.props;
---

<p class="admin-attention-note">
  רשימת מעקב בלבד — לא חוסמת שום פעולה של המוכר/ת, לצפייה שלך בלבד.
</p>

{entries.length === 0 ? (
  <p class="admin-empty">אין חנויות הדורשות תשומת לב כרגע.</p>
) : (
  <ul class="admin-attention-list">
    {entries.map(({ store, seller, reasons }) => (
      <li class="admin-attention-item">
        <div class="admin-attention-item__info">
          <span class="admin-attention-item__store">{store.name}</span>
          <span class="admin-attention-item__seller muted">{seller?.name ?? ''} · {seller?.email ?? ''}</span>
        </div>
        <div class="admin-attention-item__reasons">
          {reasons.map((r) => <span class="admin-badge admin-badge--warning">{r}</span>)}
        </div>
        <a href={`/store/${store.slug}`} target="_blank" rel="noopener" class="admin-link">צפה בחנות</a>
      </li>
    ))}
  </ul>
)}
