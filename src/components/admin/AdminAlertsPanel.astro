---
import type { AlertsSortDir, ErrorLogEntry } from '../../lib/error-log.js';
import { SEVERITY_ORDER, type ErrorSeverity } from '../../lib/error-severity.js';
import { errorRef, errorMeaning, errorCopyText } from '../../lib/error-reference.js';
import { MAX_ENTRIES as MAX_ENTRIES_HINT } from '../../lib/error-log.js';
import { formatHeDateTime } from '../../lib/format-date.js';
import AdminPager from './AdminPager.astro';
import AdminNewBadge from './AdminNewBadge.astro';
import AdminNewOnlyToggle from './AdminNewOnlyToggle.astro';

interface Props {
  errors: ErrorLogEntry[]; // current page only
  totalAll: number;
  totalFiltered: number;
  sortDir: AlertsSortDir;
  source: string[];
  storeSlug: string[];
  severity: string[];
  /** Set when the alert mail's deep link narrowed the list to one entry. */
  entryRef?: string;
  storeOptions: { slug: string; name: string }[];
  newSince: string;  // ISO — anything logged after this is what the tab's "(N)" counted
  newOnly: boolean;
  newCount: number;
  page: number;
  totalPages: number;
  buildUrl: (page: number) => string;
}
const { errors, totalAll, totalFiltered, sortDir, source, storeSlug, severity, entryRef, storeOptions, newSince, newOnly, newCount, page, totalPages, buildUrl } = Astro.props;

const sourceLabel: Record<string, string> = { server: 'שרת', client: 'דפדפן' };
// The three levels a person actually triages by (lib/error-severity.ts). The wording answers
// "do I stop what I am doing", not "how technical is this" — which is the only question the
// column is there to settle.
const severityLabel: Record<ErrorSeverity, string> = { critical: 'קריטי', error: 'שגיאה', warning: 'אזהרה' };
// Reuses the badge variants admin.css already defines rather than adding a fourth palette: danger
// for the level that pages someone, warning for a real failure nobody has to wake up for, muted for
// a single browser. The colour is the scan signal and the label is what makes it accessible without
// it — never colour alone.
const severityBadge: Record<ErrorSeverity, string> = { critical: 'admin-badge--failed', error: 'admin-badge--warning', warning: 'admin-badge--muted' };
/** Rows written before migration 0013, and any entry built without one, are server failures nobody
 *  classified — the same fallback the column default and the filter use. */
const severityOf = (e: ErrorLogEntry): ErrorSeverity => e.severity ?? 'error';
const roleLabel: Record<string, string> = { buyer: 'קונה', seller: 'מוכר' };
const sortLabels: Record<AlertsSortDir, string> = { desc: 'תאריך: חדש — ישן', asc: 'תאריך: ישן — חדש' };

// Plain-text dump for the "העתק" button — everything a developer would want
// to paste elsewhere for diagnosis. Built server-side (one source of truth)
// instead of scraped from the rendered row client-side.
/** The same text the alert mail carries, from the same function (lib/error-reference.ts). No stack
 *  cap here: on a screen scrolling is free, and the mail's 1200-character cut exists only because a
 *  phone is not a place to scroll a stack trace. */
function buildCopyText(e: ErrorLogEntry): string {
  return errorCopyText(e, { when: formatHeDateTime(e.createdAt) });
}
---

<div class="admin-alerts-toolbar">
  <p class="admin-attention-note">יומן שגיאות תפעוליות (שרת + דפדפן) — לצפייה בלבד.</p>
  {totalAll > 0 && <button type="button" id="admin-alerts-clear" class="btn btn--ghost btn--sm">נקה יומן</button>}
</div>

{totalAll === 0 ? (
  <p class="admin-empty" id="admin-alerts-empty">אין שגיאות רשומות.</p>
) : (
  <div id="admin-alerts-wrap">
  <div
    class="flex flex-wrap items-center gap-2 mb-4"
    id="admin-alerts-toolbar-controls"
    data-sort-dir={sortDir}
    data-source={source.join(',')}
    data-store={storeSlug.join(',')}
    data-severity={severity.join(',')}
    data-new-only={newOnly ? '1' : ''}
    data-store-options={JSON.stringify(storeOptions)}
  >
    <button type="button" id="admin-alerts-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
      <span id="admin-alerts-sort-label">{sortLabels[sortDir]}</span>
      <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    {(['server', 'client'] as const).map((s) => (
      <button
        type="button"
        class="admin-alerts-source-chip table-toolbar-btn inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] border"
        data-source-value={s}
        style={source.includes(s) ? 'background:var(--color-primary);border-color:var(--color-primary);color:#fff' : 'color:var(--color-text);background:var(--color-surface);border-color:var(--color-border)'}
        aria-pressed={source.includes(s)}
      >{sourceLabel[s]}</button>
    ))}
    {/* Severity before source in the toolbar too, matching the column order — and rendered from
        SEVERITY_ORDER so the row of chips can never disagree with the rest of the app about which
        level is loudest. */}
    {SEVERITY_ORDER.map((sev) => (
      <button
        type="button"
        class="admin-alerts-severity-chip table-toolbar-btn inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] border"
        data-severity-value={sev}
        style={severity.includes(sev) ? 'background:var(--color-primary);border-color:var(--color-primary);color:#fff' : 'color:var(--color-text);background:var(--color-surface);border-color:var(--color-border)'}
        aria-pressed={severity.includes(sev)}
      >{severityLabel[sev]}</button>
    ))}
    {storeOptions.length > 0 && (
      <button type="button" id="admin-alerts-store-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="true" aria-expanded="false">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <span>חנות</span>
        <span id="admin-alerts-store-count" class="filter-count-badge inline-flex items-center justify-center min-w-4 h-4 px-1 rounded-full bg-[color:var(--color-primary)] text-white text-[.68rem] font-bold leading-none" hidden={storeSlug.length === 0}>{storeSlug.length}</span>
        <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    )}
    {(newCount > 0 || newOnly) && <AdminNewOnlyToggle id="admin-alerts-new-toggle" active={newOnly} count={newCount} label="חדשות בלבד" />}
  </div>

  {/* Arriving from the mail's link, the list is one row and the reason must be visible — otherwise
      the tab silently looks like it has lost 499 entries. The way out is a link, not a back button,
      because the mail was opened in a new tab as often as not. */}
  {entryRef && (
    <p class="admin-attention-note flex flex-wrap items-center gap-2">
      <span>מציג שגיאה אחת מתוך קישור בהתראה: <strong dir="ltr">{entryRef.startsWith('#') ? entryRef : `#${entryRef}`}</strong></span>
      <a href={buildUrl(1).replace(/([?&])alref=[^&]*&?/, '$1').replace(/[?&]$/, '')}>הצגת כל השגיאות</a>
    </p>
  )}
  {totalFiltered === 0 && entryRef && (
    <p class="admin-empty">השגיאה הזאת כבר לא ביומן — הוא שומר את {MAX_ENTRIES_HINT} הרשומות האחרונות, והיא נדחקה החוצה.</p>
  )}
  {totalFiltered === 0 && !entryRef && <p class="admin-empty">לא נמצאו שגיאות תואמות.</p>}

  <AdminPager position="top" page={page} totalPages={totalPages} buildUrl={buildUrl} />
  <div class="admin-table-wrap">
    <table class="admin-table" id="admin-alerts-table">
      {/* The action column is sized in PIXELS, not in a share of the table: it holds three
          icon buttons of a known width, and a percentage made it 180px wide on a desktop
          (the cluster floated with a gap on either side) and 60px wide on a narrow laptop
          (the buttons spilled). The message column carries no width at all so it absorbs
          whatever is left over — it is the one column that always has more to say. */}
      <colgroup>
        <col style="width:11%" /><col style="width:12%" /><col style="width:12%" />
        <col style="width:15%" /><col style="width:12%" /><col /><col style="width:108px" />
      </colgroup>
      <thead>
        <tr><th>זמן</th><th class="admin-alerts-th-source">חומרה</th><th>חנות</th><th>עבור</th><th>נתיב</th><th>הודעה</th><th class="admin-alerts-th-details"><span class="sr-only">פרטים נוספים</span></th></tr>
      </thead>
      <tbody>
        {errors.map((e) => {
          const actor = e.actorLabel
            ? `${e.actorLabel}${e.actorRole ? ` (${roleLabel[e.actorRole] ?? e.actorRole})` : ''}`
            : '—';
          return (
          <>
            <tr data-alert-row class={e.resolved ? 'admin-alerts-row--resolved' : ''}>
              {/* Chip on its own line inside the (nowrap, ~11%-wide) time cell —
                  the table has no spare column, and the time is the one field
                  the "חדשה" mark is actually about. */}
              <td class="admin-nowrap admin-alerts-time">
                {formatHeDateTime(e.createdAt)}
                {/* The code the alert mail carries in its subject. It is here so that "my phone
                    buzzed about #a1b2c3d4" can be found on this screen by eye — a lookup aid, never
                    an identifier; nothing keys on it and resolving a row still uses the full uuid. */}
                <span class="block text-[.72rem] [color:var(--color-muted)] font-mono" dir="ltr">{errorRef(e.id)}</span>
                {e.createdAt > newSince && <AdminNewBadge label="חדשה" block />}
              </td>
              {/* Severity leads and source follows it: when the list is long the first thing worth
                  knowing is whether to stop, and the second is where to look. Stacked in the one
                  cell rather than given a column of their own — the table is already seven wide,
                  and the time cell beside it stacks its "חדשה" mark the same way. */}
              <td class="admin-alerts-source">
                <span class={`admin-badge ${severityBadge[severityOf(e)]}`}>{severityLabel[severityOf(e)]}</span>
                <span class="admin-badge admin-badge--muted mt-1 block w-fit mx-auto">{sourceLabel[e.source] ?? e.source}</span>
              </td>
              <td class="admin-nowrap admin-alerts-store" title={e.storeName ?? undefined}>
                <span class="admin-alerts-field-label">חנות: </span>{e.storeName ?? '—'}
              </td>
              <td class="admin-nowrap admin-alerts-actor" title={actor}>
                <span class="admin-alerts-field-label">עבור: </span>{actor}
              </td>
              {/* <bdi>, because a route is LTR text living in an RTL cell and its LEADING SLASH is
                  a bidi-neutral character: without isolation the paragraph direction pulls it to
                  the other end and "/api/checkout" is displayed as "api/checkout/" — a path that
                  does not exist, printed on the screen someone reads to find out which one broke. */}
              <td class="admin-nowrap admin-alerts-route" title={e.route ?? undefined}>
                <span class="admin-alerts-field-label">נתיב: </span><bdi>{e.route ?? '—'}</bdi>
              </td>
              {/* The plain sentence above the raw message, because "/api/checkout" and "500" say
                  everything except the one thing that decides what happens next: whether a customer
                  was hurt. Same wording the alert mail leads with, from the same function — a row
                  and its mail describing the same failure differently is worse than either alone. */}
              {/* `dir="auto"` on the raw message and nowhere else in this cell. The line above it is
                  our own Hebrew sentence; this one is whatever threw — usually an English driver
                  message, occasionally Hebrew. Left to inherit the page's RTL, an English message
                  is truncated from its FRONT, so the row showed "…iolates unique constraint" and
                  the words that say what broke were the ones thrown away. `auto` reads the first
                  strong character and truncates each language at its own end. */}
              <td class="admin-alerts-message" title={e.message}>
                <span class="block font-semibold">{errorMeaning(e.route, severityOf(e))}</span>
                <span class="block text-[.8rem] [color:var(--color-muted)] mt-[.15rem]" dir="auto">{e.message}</span>
              </td>
              {/* The flex row is a DIV inside the cell, never the <td> itself. A `display:flex`
                  on a `td` stops it being a table-cell at all: the browser wraps it in an
                  anonymous cell that the <colgroup> width and the row's shared border-bottom
                  never reach, and the row visibly breaks apart mid-way across (2026-08-07). */}
              <td class="admin-nowrap admin-alerts-actions">
                <div class="admin-alerts-actions__row">
                  <button
                    type="button"
                    class="admin-alerts-resolve-btn"
                    data-id={e.id}
                    aria-pressed={e.resolved ? 'true' : 'false'}
                    aria-label={e.resolved ? 'בטל סימון כטופל' : 'סמן כטופל'}
                    title={e.resolved ? 'בטל סימון כטופל' : 'סמן כטופל'}
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="admin-alerts-details-btn"
                    aria-expanded={entryRef ? 'true' : 'false'}
                    aria-controls={`admin-alert-details-${e.id}`}
                    title="פרטים נוספים"
                  >
                    <span class="admin-alerts-details-btn__label">פרטים נוספים</span>
                    <svg class="admin-alerts-details-btn__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="admin-alerts-copy-btn"
                    data-copy-text={buildCopyText(e)}
                    aria-label="העתק פרטי שגיאה ללוח"
                    title="העתק פרטי שגיאה ללוח"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
            {/* Open already when the mail's link brought us to this one row. Clicking through from
                an alert and then being asked to click again for the context is the same "here is a
                code, now go find it" friction the deep link removed one step earlier. Only in that
                case — the unfiltered list stays collapsed, or it is a wall. */}
            <tr id={`admin-alert-details-${e.id}`} class="admin-alerts-details-row" hidden={!entryRef}>
              <td colspan="7">
                <div class="admin-alerts-details-body">
                  <p><strong>הודעה מלאה:</strong> {e.message}</p>
                  <p><strong>קוד סטטוס:</strong> {e.statusCode ?? '—'}</p>
                  {/* "הקשר", not "הצעת פתרון", and the old label was wrong twice over as of
                      2026-08-05. The field stopped being only a suggestion the day /api/checkout
                      started writing the attempted cart into it — "בעגלה: כיסא ×2" is not advice.
                      And "(טרם נשלחת אוטומטית)" became false the same day: this text is exactly
                      what the critical-error mail carries under the same word, which is the point —
                      the row and the mail must not name one field two ways. */}
                  {e.resolutionHint && (
                    <p class="admin-alerts-hint"><strong>הקשר:</strong> {e.resolutionHint}</p>
                  )}
                  {e.stack ? (
                    <pre class="admin-alerts-stack">{e.stack}</pre>
                  ) : (
                    <p class="admin-empty">אין stack trace לשגיאה זו.</p>
                  )}
                </div>
              </td>
            </tr>
          </>
          );
        })}
      </tbody>
    </table>
  </div>
  <AdminPager page={page} totalPages={totalPages} buildUrl={buildUrl} />
  </div>
)}
