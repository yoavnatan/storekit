---
import type { ErrorLogEntry } from '../../lib/error-log.js';
import { formatHeDateTime } from '../../lib/format-date.js';
import AdminPager from './AdminPager.astro';

interface Props {
  errors: ErrorLogEntry[]; // current page only
  totalAll: number;
  page: number;
  totalPages: number;
  buildUrl: (page: number) => string;
}
const { errors, totalAll, page, totalPages, buildUrl } = Astro.props;

const sourceLabel: Record<string, string> = { server: 'שרת', client: 'דפדפן' };
const roleLabel: Record<string, string> = { buyer: 'קונה', seller: 'מוכר' };

// Plain-text dump for the "העתק" button — everything a developer would want
// to paste elsewhere for diagnosis. Built server-side (one source of truth)
// instead of scraped from the rendered row client-side.
function buildCopyText(e: ErrorLogEntry): string {
  const actor = e.actorLabel
    ? `${e.actorLabel}${e.actorRole ? ` (${roleLabel[e.actorRole] ?? e.actorRole})` : ''}`
    : '—';
  return [
    `זמן: ${formatHeDateTime(e.createdAt)}`,
    `מקור: ${sourceLabel[e.source] ?? e.source}`,
    `חנות: ${e.storeName ?? '—'}`,
    `עבור: ${actor}`,
    `נתיב: ${e.route ?? '—'}`,
    `קוד סטטוס: ${e.statusCode ?? '—'}`,
    `הודעת שגיאה (טכנית): ${e.message}`,
    `הצעת פתרון: ${e.resolutionHint ?? 'אין הצעת פתרון אוטומטית לשגיאה זו'}`,
    `Stack:`,
    e.stack ?? 'אין stack trace לשגיאה זו.',
  ].join('\n');
}
---

<div class="admin-alerts-toolbar">
  <p class="admin-attention-note">יומן שגיאות תפעוליות (שרת + דפדפן) — לצפייה בלבד.</p>
  {totalAll > 0 && <button type="button" id="admin-alerts-clear" class="btn btn--ghost btn--sm">נקה יומן</button>}
</div>

{totalAll === 0 ? (
  <p class="admin-empty" id="admin-alerts-empty">אין שגיאות רשומות.</p>
) : (
  <div id="admin-alerts-wrap">
  <AdminPager position="top" page={page} totalPages={totalPages} buildUrl={buildUrl} />
  <div class="admin-table-wrap">
    <table class="admin-table" id="admin-alerts-table">
      <thead>
        <tr><th>זמן</th><th>מקור</th><th>חנות</th><th>עבור</th><th>נתיב</th><th>הודעה</th><th class="admin-alerts-th-details"><span class="sr-only">פרטים נוספים</span></th></tr>
      </thead>
      <tbody>
        {errors.map((e) => (
          <>
            <tr>
              <td class="admin-nowrap">{formatHeDateTime(e.createdAt)}</td>
              <td><span class="admin-badge admin-badge--failed">{sourceLabel[e.source] ?? e.source}</span></td>
              <td class="admin-nowrap">{e.storeName ?? '—'}</td>
              <td class="admin-nowrap">
                {e.actorLabel
                  ? `${e.actorLabel}${e.actorRole ? ` (${roleLabel[e.actorRole] ?? e.actorRole})` : ''}`
                  : '—'}
              </td>
              <td class="admin-nowrap">{e.route ?? '—'}</td>
              <td>{e.message}</td>
              <td class="admin-nowrap admin-alerts-actions">
                <button
                  type="button"
                  class="admin-alerts-details-btn"
                  aria-expanded="false"
                  aria-controls={`admin-alert-details-${e.id}`}
                >
                  <span>פרטים נוספים</span>
                  <svg class="admin-alerts-details-btn__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <button
                  type="button"
                  class="admin-alerts-copy-btn"
                  data-copy-text={buildCopyText(e)}
                  aria-label="העתק פרטי שגיאה ללוח"
                  title="העתק פרטי שגיאה ללוח"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                </button>
              </td>
            </tr>
            <tr id={`admin-alert-details-${e.id}`} class="admin-alerts-details-row" hidden>
              <td colspan="7">
                <div class="admin-alerts-details-body">
                  <p><strong>קוד סטטוס:</strong> {e.statusCode ?? '—'}</p>
                  {e.resolutionHint && (
                    <p class="admin-alerts-hint"><strong>הצעת פתרון (טרם נשלחת אוטומטית):</strong> {e.resolutionHint}</p>
                  )}
                  {e.stack ? (
                    <pre class="admin-alerts-stack">{e.stack}</pre>
                  ) : (
                    <p class="admin-empty">אין stack trace לשגיאה זו.</p>
                  )}
                </div>
              </td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>
  <AdminPager page={page} totalPages={totalPages} buildUrl={buildUrl} />
  </div>
)}
