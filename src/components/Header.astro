---
import { store } from '../config/store.config.js';
import { getLang, getT } from '../i18n/index.js';

interface Props {
  isLoggedIn?: boolean;
  hasStore?: boolean;
  storeMode?: boolean;
  storeName?: string;
  storeSlug?: string;
  sellerMode?: boolean;
  hideNav?: boolean;
  showSearch?: boolean;
}

const { isLoggedIn = false, storeMode = false, sellerMode = false, hideNav = false, showSearch = false, storeName, storeSlug } = Astro.props;
const logo = store.logo;


const currentPath = Astro.url.pathname + (Astro.url.search ? Astro.url.search : '');
const loginUrl = `/seller/login?next=${encodeURIComponent(currentPath)}`;

const lang = getLang(Astro.cookies);
const t    = getT(lang);

type NavItem = { label: string; href: string };

let navItems: NavItem[] = [];
if (!storeMode && !sellerMode) {
  if (isLoggedIn) {
    navItems = [
      { label: t.nav.home, href: '/' },
      { label: t.nav.dashboard, href: '/seller/dashboard' },
    ];
  } else {
    navItems = [
      { label: t.nav.home, href: '/' },
      { label: t.nav.openStore, href: `/seller/register?next=${encodeURIComponent(currentPath)}` },
      { label: t.nav.login, href: loginUrl },
    ];
  }
}

const searchIconPos = lang === 'he' ? 'right:0.55rem' : 'left:0.55rem';
const searchInputPad = lang === 'he' ? 'padding-right:2rem;padding-left:0.75rem' : 'padding-left:2rem;padding-right:0.75rem';
const strRecents = lang === 'he' ? 'חיפושים אחרונים' : 'Recent searches';
const strClear   = lang === 'he' ? 'נקה' : 'Clear';
const strEmpty   = t.store.noProductsFound;
---

<header class="site-header">
  <div class={storeMode ? 'container' : 'container between flex'} style={storeMode ? 'display:flex;align-items:center;gap:0.75rem' : undefined}>

    <!-- Logo / store back-link -->
    <div style={storeMode ? 'flex:1' : 'flex-shrink:0'}>
      {storeMode && storeName && storeSlug
        ? <div class="flex items-center gap-2">
            <a href="/" class="store-back-link" aria-label={store.name}>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style={`flex-shrink:0${lang === 'he' ? ';transform:scaleX(-1)' : ''}`}><polyline points="15 18 9 12 15 6"/></svg>
              <span class="store-back-link__label" aria-hidden="true">{store.name}</span>
            </a>
            <span aria-hidden="true" style="color:var(--color-border);font-size:0.85rem;line-height:1">|</span>
            <a href={`/store/${storeSlug}`} class="logo" aria-label={storeName}><span>{storeName}</span></a>
          </div>
        : <a href="/" class="logo" aria-label={store.name}>
            <span>{logo.text}</span>
          </a>
      }
    </div>

    <!-- Homepage search (showSearch=true, no storeSlug) -->
    {showSearch && !storeSlug && (
      <div class="header-search" style="flex:1">
        <svg
          class="header-search__icon"
          width="13" height="13"
          viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2.5"
          aria-hidden="true"
          style={`top:50%;${searchIconPos}`}
        >
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <label for="store-search" class="visually-hidden">{t.home.searchPlaceholder}</label>
        <input
          type="search"
          id="store-search"
          class="header-search__input"
          placeholder={t.home.searchPlaceholder}
          autocomplete="off"
          aria-label={t.home.searchPlaceholder}
          style={searchInputPad}
        />
      </div>
    )}

    <!-- Store search (storeMode only) -->
    {storeMode && storeSlug && (
      <div
        class="header-search"
        id="header-search"
        data-store-slug={storeSlug}
        data-lang={lang}
        data-str-recents={strRecents}
        data-str-clear={strClear}
        data-str-empty={strEmpty}
        style="flex:1"
      >
        <svg
          class="header-search__icon"
          width="13" height="13"
          viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2.5"
          aria-hidden="true"
          style={`top:50%;${searchIconPos}`}
        >
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <label for="header-search-input" class="visually-hidden">{t.store.searchLabel}</label>
        <input
          type="search"
          id="header-search-input"
          class="header-search__input"
          placeholder={t.store.searchPlaceholder}
          autocomplete="off"
          aria-label={t.store.searchLabel}
          aria-autocomplete="list"
          aria-controls="header-search-dropdown"
          aria-expanded="false"
          style={searchInputPad}
        />
        <div
          id="header-search-dropdown"
          class="header-search__dropdown"
          hidden
          role="listbox"
          aria-label={t.store.searchLabel}
        ></div>
      </div>
    )}


    <!-- Nav (non-store/seller mode) -->
    {!storeMode && !sellerMode && !hideNav && (
      <nav aria-label="Main navigation">
        <ul role="list" class="flex gap">
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Actions -->
    <div class="header-actions" style={storeMode ? 'flex:1;display:flex;justify-content:flex-end' : undefined}>
      {!isLoggedIn && !sellerMode && (
        <a href={loginUrl} class="lang-toggle-btn" style="text-decoration:none">
          {t.nav.login}
        </a>
      )}

      {/* Notifications bell — shows seller replies to buyer */}
      {isLoggedIn && (
        <div class="notif-bell-wrap" style="position:relative">
          <button
            id="notif-bell-btn"
            class="cart-btn"
            aria-label="התראות"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="notif-dropdown"
            style="position:relative"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span id="notif-dot" class="notif-dot" hidden aria-live="polite" aria-atomic="true" aria-label="התראות חדשות"></span>
          </button>
          <div id="notif-dropdown" class="notif-dropdown" hidden role="dialog" aria-label="התראות">
            <div class="notif-panel-head">
              <span>התראות</span>
              <button id="notif-close-btn" class="notif-close-btn" type="button" aria-label="סגור התראות">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <div id="notif-list" class="notif-list">
              <p class="notif-empty">אין התראות חדשות</p>
            </div>
          </div>
        </div>
      )}

      {!sellerMode && (
        <Fragment>
          <button id="wishlist-toggle" class="cart-btn" aria-label={t.nav.openWishlist} aria-expanded="false" aria-controls="wishlist-panel" style="position:relative">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span id="wishlist-count" class="cart-count" hidden aria-live="polite" aria-atomic="true"></span>
          </button>
          <button id="cart-toggle" class="cart-btn" aria-label={t.nav.openCart}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span id="cart-count" class="cart-count" hidden aria-live="polite" aria-atomic="true"></span>
          </button>
          <script is:inline>
            (function () {
              try {
                var cartCount = 0;
                for (var i = 0; i < localStorage.length; i++) {
                  var k = localStorage.key(i);
                  if (!k || k.indexOf('store_cart_v2_') !== 0) continue;
                  var c = JSON.parse(localStorage.getItem(k) || 'null') || {};
                  var cartItems = c.items ? Object.values(c.items) : [];
                  cartCount += cartItems.reduce(function (s, item) { return s + ((item && item.qty) || 0); }, 0);
                }
                var cartEl = document.getElementById('cart-count');
                if (cartEl && cartCount > 0) { cartEl.textContent = String(cartCount); cartEl.removeAttribute('hidden'); }
                var wItems = JSON.parse(localStorage.getItem('wishlist_v1') || '[]');
                var wCount = Array.isArray(wItems) ? wItems.length : 0;
                var wEl = document.getElementById('wishlist-count');
                if (wEl && wCount > 0) { wEl.textContent = String(wCount); wEl.removeAttribute('hidden'); }
              } catch (_) {}
            })();
          </script>
        </Fragment>
      )}

      {/* User avatar dropdown — all logged-in users */}
      {isLoggedIn && (
        <div class="user-menu">
          <button class="user-btn" id="user-menu-toggle" aria-label={t.nav.userMenu} aria-haspopup="menu" aria-expanded="false" aria-controls="user-dropdown">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          </button>
          <div class="user-dropdown" id="user-dropdown" role="menu" hidden>
            <a href="/buyer/dashboard" class="user-dropdown__item" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              האזור שלי
            </a>
            {(Astro.props.hasStore || storeMode || sellerMode) && (
              <a href="/seller/dashboard" class="user-dropdown__item" role="menuitem">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                {t.nav.sellersDashboard}
              </a>
            )}
            <form method="POST" action="/seller/logout">
              <input type="hidden" name="_next" value={currentPath} />
              <button class="user-dropdown__item user-dropdown__item--btn" type="submit" role="menuitem">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                {t.nav.logout}
              </button>
            </form>
          </div>
        </div>
      )}
    </div>

  </div>
</header>


<script>
  import { getCount } from '../lib/cart.js';

  function refresh() {
    const el = document.getElementById('cart-count');
    if (!el) return;
    const count = getCount();
    el.textContent = String(count);
    if (count > 0) el.removeAttribute('hidden');
    else el.setAttribute('hidden', '');
  }

  document.getElementById('wishlist-toggle')?.addEventListener('click', () => {
    const nd = document.getElementById('notif-dropdown') as HTMLElement | null;
    if (nd && !nd.hidden) {
      nd.hidden = true;
      document.getElementById('notif-bell-btn')?.setAttribute('aria-expanded', 'false');
    }
    window.dispatchEvent(new CustomEvent('wishlist:open'));
  });

  document.getElementById('cart-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });

  window.addEventListener('cart:change', refresh);
  refresh();

  // ── User dropdown ─────────────────────────────────────────────
  const userToggle   = document.getElementById('user-menu-toggle') as HTMLButtonElement | null;
  const userDropdown = document.getElementById('user-dropdown');

  function openUserMenu() {
    userDropdown?.removeAttribute('hidden');
    userToggle?.setAttribute('aria-expanded', 'true');
    (userDropdown?.querySelector<HTMLElement>('[role="menuitem"]'))?.focus();
  }
  function closeUserMenu() {
    userDropdown?.setAttribute('hidden', '');
    userToggle?.setAttribute('aria-expanded', 'false');
  }
  userToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    userDropdown?.hasAttribute('hidden') ? openUserMenu() : closeUserMenu();
  });
  document.addEventListener('click', () => {
    if (userDropdown && !userDropdown.hasAttribute('hidden')) closeUserMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && userDropdown && !userDropdown.hasAttribute('hidden')) {
      closeUserMenu(); userToggle?.focus();
    }
  });

  // ── Notifications bell ────────────────────────────────────────
  const originalTitle = document.title;
  const bellBtn    = document.getElementById('notif-bell-btn') as HTMLButtonElement | null;
  const notifDot   = document.getElementById('notif-dot') as HTMLElement | null;
  const notifDrop  = document.getElementById('notif-dropdown') as HTMLElement | null;
  const notifList  = document.getElementById('notif-list') as HTMLElement | null;

  interface NotifItem { id: string; type?: string; title: string; body: string; read: boolean; createdAt: string; }

  function timeAgo(iso: string): string {
    const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (diff < 60)    return 'עכשיו';
    if (diff < 3600)  return `לפני ${Math.floor(diff / 60)} ד'`;
    if (diff < 86400) return `לפני ${Math.floor(diff / 3600)} ש'`;
    return `לפני ${Math.floor(diff / 86400)} ימים`;
  }
  function escH(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function renderNotifs(items: NotifItem[]) {
    if (!notifList) return;
    const unreadCount = items.filter(n => !n.read).length;
    if (notifDot) { unreadCount > 0 ? notifDot.removeAttribute('hidden') : notifDot.setAttribute('hidden', ''); }
    document.title = unreadCount > 0 ? `(${unreadCount}) ${originalTitle}` : originalTitle;
    if (!items.length) { notifList.innerHTML = '<p class="notif-empty">אין התראות חדשות</p>'; return; }
    notifList.innerHTML = items.slice(0, 10).map((n) => `
      <div class="notif-item${n.read ? '' : ' notif-item--unread'}" data-id="${escH(n.id)}" data-type="${escH(n.type ?? '')}" role="button" tabindex="0">
        <div class="notif-item__title">${escH(n.title)}</div>
        <div class="notif-item__body">${escH(n.body)}</div>
        <div class="notif-item__time">${timeAgo(n.createdAt)}</div>
      </div>`).join('');
    notifList.querySelectorAll<HTMLElement>('[data-id]').forEach((el) => {
      el.addEventListener('click', () => {
        closeNotifDrop();
        const type = el.dataset.type ?? '';
        const href = type === 'new_message'
          ? '/seller/dashboard?panel=messages'
          : type === 'new_order' || type === 'order_update'
          ? '/seller/dashboard?panel=orders'
          : '/buyer/dashboard?tab=messages';
        window.location.href = href;
      });
    });
  }

  function openNotifDrop()  { if (!notifDrop || !bellBtn) return; notifDrop.hidden = false; bellBtn.setAttribute('aria-expanded','true'); }
  function closeNotifDrop() { if (!notifDrop || !bellBtn) return; notifDrop.hidden = true;  bellBtn.setAttribute('aria-expanded','false'); }
  document.getElementById('notif-close-btn')?.addEventListener('click', (e) => { e.stopPropagation(); closeNotifDrop(); bellBtn?.focus(); });

  bellBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (document.getElementById('wishlist-toggle')?.getAttribute('aria-expanded') === 'true') {
      window.dispatchEvent(new CustomEvent('wishlist:open'));
    }
    if (notifDrop?.hidden) { openNotifDrop(); loadNotifs(); } else closeNotifDrop();
  });
  document.addEventListener('click', (e) => {
    if (bellBtn && notifDrop && !bellBtn.contains(e.target as Node) && !notifDrop.contains(e.target as Node)) closeNotifDrop();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && notifDrop && !notifDrop.hidden) { closeNotifDrop(); bellBtn?.focus(); }
  });


  async function loadNotifs() {
    try {
      const res = await fetch('/api/notifications');
      if (!res.ok) return;
      const { notifications } = await res.json() as { notifications: NotifItem[]; unreadCount: number };
      renderNotifs(notifications ?? []);
      const sellerReplyCount = (notifications ?? []).filter((n: NotifItem) => n.type === 'seller_reply' && !n.read).length;
      window.dispatchEvent(new CustomEvent('msg-badge-update', { detail: sellerReplyCount }));
    } catch { /* ignore */ }
  }

  setInterval(loadNotifs, 30000);

  window.addEventListener('notifications:update', (e: Event) => {
    const { notifications } = (e as CustomEvent<{ unreadCount: number; notifications: NotifItem[] }>).detail;
    if (notifications) renderNotifs(notifications);
  });

  window.addEventListener('notif-refreshed', () => { loadNotifs(); });

  if (bellBtn) {
    fetch('/api/notifications').then(r => r.json()).then((d: { notifications: NotifItem[]; unreadCount: number }) => {
      renderNotifs(d.notifications ?? []);
    }).catch(() => {});
  }

  // ── Store header search ───────────────────────────────────────
  const headerSearch = document.getElementById('header-search') as HTMLElement | null;
  if (headerSearch) {
    const storeSlug    = headerSearch.dataset.storeSlug ?? '';
    const strRecents   = headerSearch.dataset.strRecents ?? 'חיפושים אחרונים';
    const strEmpty     = headerSearch.dataset.strEmpty ?? 'לא נמצאו מוצרים';
    const input        = document.getElementById('header-search-input') as HTMLInputElement;
    const dropdown     = document.getElementById('header-search-dropdown') as HTMLElement;

    const RECENTS_KEY  = `store_recent_searches_${storeSlug}`;
    const MAX_RECENTS  = 5;
    const PLACEHOLDER_SVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;

    type SearchProduct = { slug: string; name: string; price: number; image: string };
    let products: SearchProduct[] = [];
    try {
      const el = document.getElementById('header-search-products');
      if (el) products = JSON.parse(el.textContent ?? '[]') as SearchProduct[];
    } catch { /* no products data embedded */ }

    function formatPrice(n: number) {
      return `₪${n.toLocaleString('he-IL')}`;
    }

    function getRecents(): string[] {
      try { return JSON.parse(localStorage.getItem(RECENTS_KEY) ?? '[]') as string[]; }
      catch { return []; }
    }

    function saveRecent(q: string) {
      if (!q.trim()) return;
      const list = [q.trim(), ...getRecents().filter((r) => r !== q.trim())].slice(0, MAX_RECENTS);
      try { localStorage.setItem(RECENTS_KEY, JSON.stringify(list)); } catch { /* quota */ }
    }

    function clearRecents() {
      try { localStorage.removeItem(RECENTS_KEY); } catch { /* quota */ }
    }

    function showDropdown() {
      dropdown.removeAttribute('hidden');
      input.setAttribute('aria-expanded', 'true');
    }

    function hideDropdown() {
      dropdown.setAttribute('hidden', '');
      input.setAttribute('aria-expanded', 'false');
    }

    function navigateToProduct(slug: string, query: string) {
      saveRecent(query);
      window.location.href = `/store/${storeSlug}/${slug}`;
    }

    function applySearch(q: string) {
      saveRecent(q);
      const gridSearch = document.getElementById('product-search') as HTMLInputElement | null;
      if (gridSearch) {
        gridSearch.value = q;
        gridSearch.dispatchEvent(new Event('input', { bubbles: true }));
        hideDropdown();
      } else {
        window.location.href = `/store/${storeSlug}?q=${encodeURIComponent(q)}`;
      }
    }

    function renderRecents() {
      const recents = getRecents();
      if (!recents.length) { hideDropdown(); return; }
      const strClear = headerSearch?.dataset.strClear ?? 'נקה';
      dropdown.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:0.3rem 0.5rem 0.1rem">
          <span class="hsd-section-label" style="padding:0">${strRecents}</span>
          <button class="hsd-clear-recents" type="button">${strClear}</button>
        </div>
        <div class="hsd-recents-list">
          ${recents.map((r) => `<button class="hsd-recent-chip" type="button" data-q="${r.replace(/"/g, '&quot;')}">${r}</button>`).join('')}
        </div>`;
      dropdown.querySelector<HTMLButtonElement>('.hsd-clear-recents')?.addEventListener('click', () => {
        clearRecents();
        hideDropdown();
      });
      dropdown.querySelectorAll<HTMLButtonElement>('.hsd-recent-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const q = btn.dataset.q ?? '';
          input.value = q;
          applySearch(q);
        });
      });
      showDropdown();
    }

    function normalizeHe(str: string): string {
      return str
        .toLowerCase()
        .replace(/[ְ-ׇֽֿׁׂׅׄ]/g, '')
        .replace(/[ן]/g, 'נ').replace(/[ף]/g, 'פ').replace(/[ך]/g, 'כ')
        .replace(/[ם]/g, 'מ').replace(/[ץ]/g, 'צ')
        .replace(/[׳״'""]/g, '')
        .replace(/[-_.,!?;:()\[\]{}/\\]/g, ' ')
        .replace(/\s+/g, ' ').trim();
    }

    function matchesSearch(query: string, name: string): boolean {
      if (!query) return true;
      const nQuery = normalizeHe(query);
      const nName = normalizeHe(name);
      return nQuery.split(' ').every((word) => word && nName.includes(word));
    }

    function renderResults(q: string) {
      const hits = products.filter((p) => matchesSearch(q, p.name)).slice(0, 5);
      if (!hits.length) {
        dropdown.innerHTML = `<div class="hsd-empty">${strEmpty}</div>`;
      } else {
        dropdown.innerHTML = `<ul class="hsd-results" role="listbox">
          ${hits.map((p) => `
            <li role="option">
              <a class="hsd-result-item" href="/store/${storeSlug}/${p.slug}" data-slug="${p.slug}">
                ${p.image
                  ? `<img class="hsd-result-img" src="${p.image}" alt="${p.name.replace(/"/g, '&quot;')}" width="36" height="36" loading="lazy">`
                  : `<div class="hsd-result-img-placeholder" aria-hidden="true">${PLACEHOLDER_SVG}</div>`
                }
                <span class="hsd-result-name">${p.name}</span>
                <span class="hsd-result-price">${formatPrice(p.price)}</span>
              </a>
            </li>`).join('')}
        </ul>`;
        dropdown.querySelectorAll<HTMLAnchorElement>('.hsd-result-item').forEach((a) => {
          a.addEventListener('click', (e) => {
            e.preventDefault();
            navigateToProduct(a.dataset.slug ?? '', q);
          });
        });
      }
      showDropdown();
    }

    input.addEventListener('focus', () => {
      if (!input.value.trim()) renderRecents();
      else renderResults(input.value.trim());
    });

    let debounceTimer = 0;
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const q = input.value.trim();
      if (!q) {
        const gridSearch = document.getElementById('product-search') as HTMLInputElement | null;
        if (gridSearch) {
          gridSearch.value = '';
          gridSearch.dispatchEvent(new Event('input', { bubbles: true }));
        } else {
          window.location.href = `/store/${storeSlug}`;
          return;
        }
        renderRecents();
        return;
      }
      debounceTimer = window.setTimeout(() => renderResults(q), 150);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const q = input.value.trim();
        if (q) applySearch(q);
        else hideDropdown();
      }
      if (e.key === 'Escape') { hideDropdown(); input.blur(); }
    });

    document.addEventListener('click', (e) => {
      if (!headerSearch?.contains(e.target as Node)) hideDropdown();
    });
  }
</script>
