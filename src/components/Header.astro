---
// Layout rules this component owns (moved out of AI_INSTRUCTIONS.md 2026-07-31 so they are read by
// whoever edits the header, not by every session regardless of what it is doing). The two that are
// still in the always-read file are the ones a stranger could break from outside: the header is
// `position:fixed` and never sticky, and nothing here may carry an entrance animation.
//
//  • Height is pinned INLINE on <header> (`height:3.4rem;box-sizing:border-box`) with a matching
//    `body{padding-top:3.4rem}`, and must NEVER change. Inline because a `min-height` in header.css
//    arrives too late — the dev server injects CSS via JS after first paint, so the header would
//    flash tall and then shrink.
//  • `.logo` is shared by the platform name AND a store name, and is
//    `display:inline-flex; line-height:1; font-size:1.3rem` so both render at an identical box in
//    every context and the row height does not depend on which one is showing. The row itself is
//    `.site-header .container{height:2rem}` — fixed, not min-height.
//  • Only the logo/store-name text is a click-to-home target; the rest of the row is inert.
//  • The row always renders `class="container"` (never the old `container between flex`) — every
//    page passes `storeMode`, seller register/login/dashboard included, so row layout is one
//    mechanism everywhere. It carries `min-height:2rem` (the search input's height) so the icons
//    centre identically with or without a search bar.
//  • `.user-btn`/`.user-menu` pre-declare `position:relative`/`display:flex` rather than leaving it
//    to spawnRipple()'s static→relative promotion: the alert dot nests INSIDE `.user-btn`, so a
//    ripple-triggered position change on first click would silently move the dot's containing
//    block (fixed 2026-07-16).
import { store } from '../config/store.config.js';
import CsrfField from './CsrfField.astro';
import StoreAvatar from './StoreAvatar.astro';
import BrandLogo from './BrandLogo.astro';
import { getLang, getT } from '../i18n/index.js';
import { getSellerSession } from '../lib/seller-auth.js';
import { sellerHasAnyAlert } from '../lib/seller-alerts.js';

interface Props {
  isLoggedIn?: boolean;
  hasStore?: boolean;
  storeMode?: boolean;
  storeName?: string;
  storeSlug?: string;
  /** The store's uploaded logo, when the page is one store's own. Optional on
   *  purpose: a storeMode page that doesn't have the store record (checkout,
   *  admin) simply renders the generated mark, never an empty box. */
  storeLogo?: string;
  sellerMode?: boolean;
  hideNav?: boolean;
  showSearch?: boolean;
  isHome?: boolean;
  initialUnreadCount?: number;
}

const { isLoggedIn = false, storeMode = false, sellerMode = false, hideNav = false, showSearch = false, isHome = false, storeName, storeSlug, storeLogo, initialUnreadCount = 0 } = Astro.props;
const initialUnreadLabel = initialUnreadCount > 99 ? '99+' : String(initialUnreadCount);

// Same SSR-not-async-fetch fix as the notif badge above, for the other
// "you have something unhandled" indicator (avatar dot + dropdown-link dot) —
// it independently re-fetches /api/seller/alerts on every page load and used
// to start hidden until that resolved, flashing empty then reappearing.
const hasStoreForAlert = Astro.props.hasStore || storeMode || sellerMode;
const sellerIdForAlert = hasStoreForAlert ? getSellerSession(Astro.cookies) : null;
const initialSellerAlert = sellerIdForAlert ? await sellerHasAnyAlert(sellerIdForAlert) : false;

// "This header is standing in a real store" — it carries that store's name and slug
// rather than the platform's. It picks the logo/name lockup below; it no longer
// picks a colour. The store-colour bar this used to feed was removed on 2026-08-05
// and header.css carries the reasoning — the short version is that the colour is
// read off the logo on the CLIENT, so the bar could not be right at first paint and
// changed under the shopper on every store load.
const storeHeader = storeMode && !!storeName && !!storeSlug;

const currentPath = Astro.url.pathname + (Astro.url.search ? Astro.url.search : '');
const loginUrl = `/seller/login?next=${encodeURIComponent(currentPath)}`;

const lang = getLang(Astro.cookies);
const t    = getT(lang);

type NavItem = { label: string; href: string };

let navItems: NavItem[] = [];
if (!storeMode && !sellerMode) {
  if (isLoggedIn) {
    navItems = [
      { label: t.nav.home, href: '/' },
      { label: t.nav.dashboard, href: '/seller/dashboard' },
    ];
  } else {
    navItems = [
      { label: t.nav.home, href: '/' },
      { label: t.nav.openStore, href: `/seller/register?next=${encodeURIComponent(currentPath)}` },
      { label: t.nav.login, href: loginUrl },
    ];
  }
}

const searchIconPos = lang === 'he' ? 'right:0.55rem' : 'left:0.55rem';
const searchInputPad = lang === 'he' ? 'padding-right:2rem;padding-left:0.75rem' : 'padding-left:2rem;padding-right:0.75rem';
const strRecents = lang === 'he' ? 'חיפושים אחרונים' : 'Recent searches';
const strClear   = lang === 'he' ? 'נקה' : 'Clear';
const strEmpty   = t.store.noProductsFound;
---

{/* This header hosts no store colour and sets no colour custom property — it carries
    the shared 1px hairline like every other page. header.css says why, and
    tests/header-store-line.test.ts fails if either comes back. */}
<header
  class={`site-header${storeMode ? ' site-header--store' : ''}`}
  style="height:3.4rem;box-sizing:border-box"
>
  {/* Height is pinned INLINE (not only in header.css) so it is fixed from the very
      first paint — before external CSS/fonts load — and can never grow-then-shrink. */}
  <div class={storeMode ? 'container' : 'container between flex'}>

    <!-- Logo / store home -->
    <div class={storeMode ? 'store-header__logo-col' : undefined} style={storeMode ? undefined : 'flex-shrink:0'}>
      {storeMode && storeName && storeSlug
        ? <a href={`/${storeSlug}`} class="logo store-name-link" aria-label={storeName} data-astro-prefetch>
            {/* 32px, and that ceiling is structural rather than timid: this row is
                pinned to 2rem, and on a store page — which renders a search bar — the
                container becomes a 3-column grid whose row grows to its tallest item.
                A 40px avatar was tried and measured on 2026-08-05: the grid row went
                to 48.6px, which pushed the icons 8px down and hung the column below
                the header's own edge. Anything taller than the row needs the HEADER
                to get taller, which is a different decision.
                Round, like every other store avatar on the site; a square plate was
                tried on the store card the same day and reverted — StoreAvatar.astro
                carries that reasoning. */}
            <StoreAvatar name={storeName} slug={storeSlug} profileImage={storeLogo} size={32} class="store-header__logo" />
            <span class="store-name-text">{storeName}</span>
          </a>
        : <a href="/" class="logo" aria-label={store.name} data-astro-prefetch>
            {/* The wordmark inherits `.logo`'s font-size (1.3rem), so the header
                row's fixed height still governs — see the layout rules above. */}
            <BrandLogo />
          </a>
      }
    </div>
    <!-- Back-to-store pill (persistent, subtle) — shown whenever we're not already inside a store's own header, so a buyer detoured away by a notification/toast/checkout always has a way back into the store they were shopping in -->
    {!(storeName && storeSlug) && !isHome && (
      <Fragment>
      <a href="#" id="back-to-store-pill" class="back-to-store-pill" hidden aria-label={lang === 'he' ? 'חזרה לחנות' : 'Back to store'}>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style={`flex-shrink:0${lang === 'he' ? ';transform:scaleX(-1)' : ''}`}><polyline points="15 18 9 12 15 6"/></svg>
        <span id="back-to-store-pill__name" class="back-to-store-pill__name"></span>
      </a>
      {/* Filled in HERE, inline and synchronous, rather than from the module script
          at the bottom of this file. The header row is `justify-content:space-between`,
          so a child appearing after first paint doesn't just fade in — it re-divides
          the row's free space and slides the nav sideways. Deferred, that landed as a
          visible header shift on every navigation to a non-store page. The pill's
          whole input is one sessionStorage read, so there is no reason for it to
          happen a frame late. Same reasoning as the cart-badge seed further down;
          `textContent` (never innerHTML) keeps the stored store name inert. */}
      <script is:inline>
        (function () {
          try {
            var raw = sessionStorage.getItem('last_store_v1');
            if (!raw) return;
            var last = JSON.parse(raw);
            if (!last || !last.url || !last.name) return;
            // saveLastStore() only ever stores `location.pathname + location.search`,
            // so a site-relative path is the ONLY shape that can legitimately be here.
            // Re-checking it is the same rule lib/safe-redirect.ts enforces for a
            // request-supplied destination: a stored value is still a destination, and
            // an href is where `javascript:` becomes execution. `//host` is rejected
            // too — that is protocol-relative, i.e. off-site.
            if (last.url.charAt(0) !== '/' || last.url.charAt(1) === '/') return;
            var pill = document.getElementById('back-to-store-pill');
            if (!pill) return;
            pill.href = last.url;
            var nameEl = document.getElementById('back-to-store-pill__name');
            if (nameEl) nameEl.textContent = last.name;
            pill.removeAttribute('hidden');
          } catch {
            // Storage blocked (private mode) or a corrupt entry: the pill stays
            // hidden, which is exactly what a browser with no remembered visit shows.
          }
        })();
      </script>
      </Fragment>
    )}

    <!-- Homepage search (showSearch=true, no storeSlug) -->
    {showSearch && !storeSlug && (
      <div
        class="header-search home-header-search"
        id="home-header-search"
        data-str-stores={t.home.searchSectionStores}
        data-str-products={t.home.searchSectionProducts}
        data-str-empty={t.home.searchEmpty}
        data-str-view-all={t.search.viewAllResults}
      >
        <svg
          class="header-search__icon"
          width="13" height="13"
          viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2.5"
          aria-hidden="true"
          style={`top:50%;${searchIconPos}`}
        >
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <form role="search" autocomplete="off" onsubmit="return false" style="display:contents">
          <label for="store-search" class="visually-hidden">{t.home.searchPlaceholder}</label>
          <input
            type="search"
            id="store-search"
            class="header-search__input"
            placeholder={t.home.searchPlaceholder}
            autocomplete="off"
            list="store-search-empty-list"
            aria-label={t.home.searchPlaceholder}
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="home-search-dropdown"
            style={searchInputPad}
          />
          <datalist id="store-search-empty-list"></datalist>
        </form>
        <div
          id="home-search-dropdown"
          class="header-search__dropdown"
          hidden
          role="listbox"
          aria-label={t.home.searchPlaceholder}
        ></div>
      </div>
    )}

    <!-- Store search (storeMode only) -->
    {storeMode && storeSlug && (
      <div
        class="header-search"
        id="header-search"
        data-store-slug={storeSlug}
        data-lang={lang}
        data-str-recents={strRecents}
        data-str-clear={strClear}
        data-str-empty={strEmpty}
      >
        <svg
          class="header-search__icon"
          width="13" height="13"
          viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2.5"
          aria-hidden="true"
          style={`top:50%;${searchIconPos}`}
        >
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <label for="header-search-input" class="visually-hidden">{t.store.searchLabel}</label>
        <input
          type="search"
          id="header-search-input"
          class="header-search__input"
          placeholder={t.store.searchPlaceholder}
          autocomplete="off"
          aria-label={t.store.searchLabel}
          aria-autocomplete="list"
          aria-controls="header-search-dropdown"
          aria-expanded="false"
          style={searchInputPad}
        />
        <div
          id="header-search-dropdown"
          class="header-search__dropdown"
          hidden
          role="listbox"
          aria-label={t.store.searchLabel}
        ></div>
      </div>
    )}


    <!-- Nav (non-store/seller mode) -->
    {!storeMode && !sellerMode && !hideNav && (
      <nav aria-label="Main navigation">
        <ul role="list" class="flex gap">
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Actions -->
    <div class="header-actions" style={storeMode ? 'flex-shrink:0' : undefined}>
      {/* Mobile search icon — store pages only, hidden on desktop via CSS */}
      {storeMode && storeSlug && !sellerMode && (
        <button id="mobile-search-btn" class="cart-btn mobile-search-btn" aria-label={lang === 'he' ? 'חיפוש' : 'Search'} aria-expanded="false" aria-controls="mobile-search-panel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
      )}
      {/* Mobile search icon — homepage, hidden on desktop via CSS */}
      {showSearch && !storeSlug && !sellerMode && (
        <button id="home-mobile-search-btn" class="cart-btn home-mobile-search-btn" aria-label={lang === 'he' ? 'חיפוש' : 'Search'} aria-expanded="false" aria-controls="home-mobile-search-panel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
      )}

      {!isLoggedIn && !sellerMode && (
        <a href={loginUrl} class="lang-toggle-btn" style="text-decoration:none">
          {t.nav.login}
        </a>
      )}

      {/* Notifications bell — shows seller replies to buyer */}
      {isLoggedIn && (
        <div class="notif-bell-wrap" style="position:relative">
          <button
            id="notif-bell-btn"
            class="cart-btn"
            aria-label="התראות"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="notif-dropdown"
            style="position:relative"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span id="notif-count-badge" class="cart-count cart-count--alert" hidden={initialUnreadCount <= 0} aria-live="polite" aria-atomic="true" aria-label="התראות חדשות" data-ticker-value={initialUnreadCount > 0 ? initialUnreadLabel : undefined}>{initialUnreadCount > 0 && (
              <span class="badge-ticker__track"><span class="badge-ticker__val">{initialUnreadLabel}</span></span>
            )}</span>
          </button>
          <div id="notif-dropdown" class="notif-dropdown" hidden role="dialog" aria-label="התראות">
            <div class="notif-panel-head">
              <span style="display:inline-flex;align-items:center;gap:0.4rem">
                התראות
                <span id="notif-loading-dot" class="dot-pulse" hidden aria-hidden="true"><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span></span>
              </span>
              <span style="display:inline-flex;align-items:center;gap:0.6rem">
                <button id="notif-clear-all-btn" class="notif-clear-all-btn" type="button" hidden>נקה הכל</button>
                <button id="notif-close-btn" class="notif-close-btn" type="button" aria-label="סגור התראות">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </span>
            </div>
            <div id="notif-list" class="notif-list">
              <p class="notif-empty">אין התראות חדשות</p>
            </div>
          </div>
        </div>
      )}

      {!sellerMode && (
        <Fragment>
          <div class="cart-btn-wrap">
            <button id="wishlist-toggle" class="cart-btn" aria-label={t.nav.openWishlist} aria-expanded="false" aria-controls="wishlist-panel">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>
            <span id="wishlist-count" class="cart-count" hidden aria-live="polite" aria-atomic="true"></span>
          </div>
          <div class="cart-btn-wrap">
            <button id="cart-toggle" class="cart-btn" aria-label={t.nav.openCart}>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </button>
            <span id="cart-count" class="cart-count" hidden aria-live="polite" aria-atomic="true"></span>
          </div>
          <script is:inline>
            (function () {
              try {
                var cartCount = 0;
                for (var i = 0; i < localStorage.length; i++) {
                  var k = localStorage.key(i);
                  if (!k || k.indexOf('store_cart_v2_') !== 0) continue;
                  var c = JSON.parse(localStorage.getItem(k) || 'null') || {};
                  var cartItems = c.items ? Object.values(c.items) : [];
                  // MUST stay identical to getActiveStoreCarts() in lib/cart.js — an
                  // unavailable line is listed in the drawer but is not part of what the
                  // buyer is buying, so it never counts here either. This seed and
                  // getCount() paint the SAME badge microseconds apart: any drift between
                  // the two rules makes the badge show one number and then roll to another
                  // on every single page load (the ticker literally renders the seeded
                  // value as the "previous" digit). Guarded by tests/header-cart-badge.test.ts.
                  cartCount += cartItems.filter(function (it) { return !(it && it.gone); }).length;
                }
                // Pre-wrap in the same `.badge-ticker__track`/`.badge-ticker__val`
                // markup badge-ticker.ts's tickBadge() produces, so the module
                // script's refresh()/refreshWishlistCount() call right after this
                // finds a matching value + already-wrapped structure and skips its
                // rebuild — confirmed via frame-by-frame screen-recording analysis
                // that the raw-text→wrapped swap was a real, visible ~2px settle
                // on every refresh (2026-07-16).
                var cartEl = document.getElementById('cart-count');
                if (cartEl && cartCount > 0) { cartEl.innerHTML = '<span class="badge-ticker__track"><span class="badge-ticker__val">' + cartCount + '</span></span>'; cartEl.dataset.tickerValue = String(cartCount); cartEl.removeAttribute('hidden'); }
                var wItems = JSON.parse(localStorage.getItem('wishlist_v1') || '[]');
                var wCount = Array.isArray(wItems) ? wItems.length : 0;
                var wEl = document.getElementById('wishlist-count');
                if (wEl && wCount > 0) { wEl.innerHTML = '<span class="badge-ticker__track"><span class="badge-ticker__val">' + wCount + '</span></span>'; wEl.dataset.tickerValue = String(wCount); wEl.removeAttribute('hidden'); }
              } catch (_) {}
            })();
          </script>
        </Fragment>
      )}

      {/* User avatar dropdown — all logged-in users.

         THE -4px PULL THAT USED TO BE HERE IS GONE (2026-08-05, owner: the cart
         is always too tight to the avatar — and he was right). Its comment had
         the observation correct and the conclusion inverted: the avatar's circle
         IS drawn flush to its own box while the cart/heart/bell glyphs carry
         empty space inside their viewBox, and that makes the avatar's gap the
         SMALLEST one optically, not the widest. Pulling it in made the only
         already-tight gap tighter. Measured ink-edge to ink-edge on the built
         page at 8x, with the pull in place: avatar→cart 10.00px, cart→heart
         14.38px, heart→bell 15.00px. Without it all three are 13.6–15.0, which
         is the rhythm the pull was trying to produce.

         `flex items-center` (not the div default block) so
         the button below is sized off its own intrinsic box — otherwise it's
         an inline-level child sized by the *inherited* line-height instead,
         which was quietly adding ~1.4px of phantom height on top of the
         button's real 30.4px (2026-07-16). The `user-menu` classname itself
         must stay (no CSS left on it) — queried via `.user-menu` in this
         component's own script below. */}
      {isLoggedIn && (
        <div class="user-menu relative flex items-center" data-has-store={(Astro.props.hasStore || storeMode || sellerMode) ? '1' : ''}>
          <button class="user-btn" id="user-menu-toggle" aria-label={t.nav.userMenu} aria-haspopup="menu" aria-expanded="false" aria-controls="user-dropdown">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            {/* Absolute against .user-btn's own padding box (position:relative
               in header.css) — 0/0 lands it flush in the corner, inset by
               that button's own 1px border. */}
            <span id="seller-alert-avatar-dot" class="absolute top-0 end-0 w-2 h-2 bg-[#ef4444] border border-[color:var(--color-border)] rounded-full" hidden={!initialSellerAlert} aria-hidden="true"></span>
          </button>
          <div class="user-dropdown" id="user-dropdown" role="menu" hidden>
            {/* The D rather than a house: this row goes to the platform's own home,
                and the mark says which platform. Same path as BrandLogo.astro and the
                favicon — one drawing, three surfaces. */}
            <a href="/" class="user-dropdown__item" role="menuitem">
              <svg width="12" height="14" viewBox="10.75 8 22.79 28" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.25 8 L24.84 8 L33.04 16.2 L33.04 27.8 L24.84 36 L11.25 36 Z M17.757 13.199 L21.724 13.199 L26.533 18.009 L26.533 25.991 L21.724 30.801 L17.757 30.801 Z"/></svg>
              {t.nav.home}
            </a>
            <a href="/buyer/dashboard" class="user-dropdown__item" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              האזור שלי
            </a>
            {/* Saved stores (CURRENT_TASK → סשן ג׳ 1). The only route to them used to be the
                homepage's own "liked" tab, so a shopper standing inside a store had no way back
                to the stores they had saved. A disclosure rather than a second floating panel:
                the avatar menu is anchored to the very edge of the header, and a flyout beside it
                has nowhere to go at 375px — and the same "there is more inside" gesture is
                already the store page's category chevron, so this reads as one language.
                Filled lazily — see the script below; nothing about it costs an SSR read. */}
            <button
              type="button"
              class="user-dropdown__item"
              id="saved-stores-toggle"
              role="menuitem"
              aria-expanded="false"
              aria-controls="saved-stores-panel"
              data-str-empty={t.nav.savedStoresEmpty}
              data-str-all={t.nav.savedStoresAll}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.7 7.8l1 1 7.8 7.8 7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
              {/* nowrap: this is the only row carrying BOTH an icon and a trailing chevron, so at
                  the dropdown's 160px floor it was the one label that wrapped to two lines — and
                  it did so only while the list was empty, i.e. only when nothing else was
                  widening the menu. */}
              <span class="flex-1 whitespace-nowrap">{t.home.shelfLiked}</span>
              <svg id="saved-stores-chev" class="transition-transform duration-150" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            {/* `ps-[0.9rem]` is the inset the store page's own nested category group already uses
                (`.category-drawer-group`) — these rows have to read as being INSIDE the row above
                them, and the site had an answer for that. The height fits everything the server
                can send (six rows + the "all saved stores" link — MENU_CAP in /api/saved-stores),
                so nothing normally scrolls: it was 13rem first, and that is precisely the bug it
                guards against — the link scrolled out of sight, and a scroller inside a dropdown
                gives no hint that anything is below it. The overflow rule is the backstop for a
                larger font or a raised cap. */}
            <div
              id="saved-stores-panel"
              class="mt-0.5 ps-[0.9rem] max-h-[15.5rem] max-w-[15rem] overflow-y-auto"
              role="group"
              aria-labelledby="saved-stores-toggle"
              hidden
            ></div>

            {(Astro.props.hasStore || storeMode || sellerMode) && (
              <a href="/seller/dashboard" class="user-dropdown__item" role="menuitem" id="seller-dashboard-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                {t.nav.sellersDashboard}
                <span id="seller-alert-dropdown-dot" class="inline-alert-dot" hidden={!initialSellerAlert} aria-hidden="true"></span>
              </a>
            )}
            {/* data-native-submit: a real browser POST, on purpose — logout answers with a
                redirect, and it must keep working even with every module on the page dead
                (see dashboard/FormFallbackGuard.astro). */}
            <form method="POST" action="/seller/logout" class="user-dropdown__sep" data-native-submit>
              <CsrfField />
              <input type="hidden" name="_next" value={currentPath} />
              <button class="user-dropdown__item user-dropdown__item--btn" type="submit" role="menuitem">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                {t.nav.logout}
              </button>
            </form>
          </div>
        </div>
      )}
    </div>

  </div>
</header>

{storeMode && storeSlug && (
  <div
    id="mobile-search-panel"
    hidden
    style="position:fixed;z-index:60;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);box-shadow:var(--shadow-card);padding:0.4rem 0.5rem"
  >
    <div id="mobile-search-slot"></div>
  </div>
)}

{showSearch && !storeSlug && (
  <div
    id="home-mobile-search-panel"
    hidden
    style="position:fixed;z-index:60;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);box-shadow:var(--shadow-card);padding:0.4rem 0.5rem"
  >
    <div id="home-mobile-search-slot"></div>
  </div>
)}

<script>
  import { initHeaderScrolled } from '../lib/sticky-bar.js';
  import { animateScrollTo } from '../scripts/dashboard/scroll-utils.js';
  import { getCount } from '../lib/cart.js';
  import { getWishlistCount } from '../lib/wishlist.js';
  import { updateBadge } from '../lib/badge-ticker.js';
  import { cdnThumb } from '../lib/cdn.js';
  // Two historic local names in this file, one implementation.
  import { escapeHtml as escH, escapeHtml as escHtml } from '../lib/html-escape.js';
  // No initStoreGlow() here any more. The header asked for it because its bottom
  // rule wore the store's colour, and a product page — no store cards, so nobody
  // else asking — was the case that made the header ask. That rule is gone
  // (header.css), so the only surface left with a `[data-glow-host]` is the store
  // card, which asks for itself in StoreCard.astro. Keeping the call here would
  // ship the sampler, and a document-wide image pass, onto every page on the site
  // for nothing.

  // ── The logo, when it points at the page you are already on ──────────
  // A full navigation to the current URL rebuilds the whole document: the header is torn down and
  // repainted, which reads as the header "jumping" even though nothing about it changed. That was
  // nearly free while a page was a file read; against a real database it is a few hundred
  // milliseconds of the browser holding the old paint and then replacing it.
  //
  // The site's standing rule is that an interaction changing no state must not move anything, so
  // the click is intercepted and does what a logo click actually means when you are already home:
  // returns you to the top. `animateScrollTo` rather than native smooth scrolling — on this RTL
  // site the native one drifts scrollX off zero mid-animation (scroll-utils.ts). Already at the
  // top, it is a genuine no-op and nothing moves at all.
  //
  // Deliberately NOT a general same-URL guard for every link: elsewhere on the site a same-URL
  // click can legitimately re-run a filtered view. This is the logo, whose one job is "go home".
  document.querySelector<HTMLAnchorElement>('a.logo')?.addEventListener('click', (event) => {
    const link = event.currentTarget as HTMLAnchorElement;
    // Let the browser do its normal thing for anything that is not a plain left click — a
    // middle-click or ctrl/cmd-click means "open this somewhere else", and that is still a real
    // navigation.
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const target = new URL(link.href, window.location.href);
    if (target.origin !== window.location.origin) return;
    const samePage = target.pathname.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, '')
      && target.search === window.location.search;
    if (!samePage) return;
    event.preventDefault();
    if (window.scrollY > 0) animateScrollTo(0);
  });

  // Fades the header's shadow in the moment the page is scrolled at all — at the
  // top it is covering nothing, so it carries only its border (header.css).
  initHeaderScrolled(document.querySelector<HTMLElement>('.site-header'));

  // ── Back-to-store pill ────────────────────────────────────────
  // Deliberately NOT here: the pill is filled in by an inline script next to its
  // own markup above, because revealing it from this deferred module re-divided
  // the space-between header row after first paint and shifted the nav.

  function fadeClose(el: HTMLElement, onDone: () => void): void {
    if (el.classList.contains('dropdown--closing')) return;
    el.classList.add('dropdown--closing');
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      el.classList.remove('dropdown--closing');
      onDone();
    };
    el.addEventListener('animationend', finish, { once: true });
    setTimeout(finish, 200);
  }

  // `animate: false` on the first call of a page: reconciling against the inline
  // seed a few lines above is not a change the shopper made, so it must never roll.
  function refresh(opts?: { animate?: boolean }) {
    const el = document.getElementById('cart-count');
    if (!el) return;
    const count = getCount();
    updateBadge(el, count > 0 ? String(count) : null, opts);
  }

  function refreshWishlistCount(opts?: { animate?: boolean }) {
    const el = document.getElementById('wishlist-count');
    if (!el) return;
    const count = getWishlistCount();
    updateBadge(el, count > 0 ? String(count) : null, opts);
  }

  document.getElementById('wishlist-toggle')?.addEventListener('click', () => {
    closeUserMenu();
    const nd = document.getElementById('notif-dropdown') as HTMLElement | null;
    if (nd && !nd.hidden) { document.getElementById('notif-bell-btn')?.setAttribute('aria-expanded', 'false'); fadeClose(nd, () => { nd!.hidden = true; }); }
    const msp = document.getElementById('mobile-search-panel') as HTMLElement | null;
    if (msp && !msp.hasAttribute('hidden')) { document.getElementById('mobile-search-btn')?.setAttribute('aria-expanded', 'false'); fadeClose(msp, () => { msp!.setAttribute('hidden', ''); }); }
    const hmsp = document.getElementById('home-mobile-search-panel') as HTMLElement | null;
    if (hmsp && !hmsp.hasAttribute('hidden')) { document.getElementById('home-mobile-search-btn')?.setAttribute('aria-expanded', 'false'); fadeClose(hmsp, () => { hmsp!.setAttribute('hidden', ''); }); }
    window.dispatchEvent(new CustomEvent('wishlist:open'));
  });

  document.getElementById('cart-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });

  window.addEventListener('cart:change', () => refresh());
  refresh({ animate: false });

  window.addEventListener('wishlist:change', () => refreshWishlistCount());
  refreshWishlistCount({ animate: false });

  // ── User dropdown ─────────────────────────────────────────────
  const userToggle   = document.getElementById('user-menu-toggle') as HTMLButtonElement | null;
  const userDropdown = document.getElementById('user-dropdown');

  function closeAllPanels() {
    const nd = document.getElementById('notif-dropdown') as HTMLElement | null;
    if (nd && !nd.hidden) { document.getElementById('notif-bell-btn')?.setAttribute('aria-expanded', 'false'); fadeClose(nd, () => { nd!.hidden = true; }); }
    const wp = document.getElementById('wishlist-panel') as HTMLElement | null;
    if (wp && wp.style.display !== 'none') { window.dispatchEvent(new CustomEvent('wishlist:open')); document.getElementById('wishlist-toggle')?.setAttribute('aria-expanded', 'false'); }
    const msp = document.getElementById('mobile-search-panel') as HTMLElement | null;
    if (msp && !msp.hasAttribute('hidden')) { document.getElementById('mobile-search-btn')?.setAttribute('aria-expanded', 'false'); fadeClose(msp, () => { msp!.setAttribute('hidden', ''); }); }
    const hmsp = document.getElementById('home-mobile-search-panel') as HTMLElement | null;
    if (hmsp && !hmsp.hasAttribute('hidden')) { document.getElementById('home-mobile-search-btn')?.setAttribute('aria-expanded', 'false'); fadeClose(hmsp, () => { hmsp!.setAttribute('hidden', ''); }); }
    const hsd = document.getElementById('home-search-dropdown') as HTMLElement | null;
    if (hsd && !hsd.hasAttribute('hidden')) { hsd.setAttribute('hidden', ''); document.getElementById('store-search')?.setAttribute('aria-expanded', 'false'); }
  }

  function openUserMenu() {
    closeAllPanels();
    userDropdown?.removeAttribute('hidden');
    userToggle?.setAttribute('aria-expanded', 'true');
    (userDropdown?.querySelector<HTMLElement>('[role="menuitem"]'))?.focus();
    loadSavedStores();
  }
  function closeUserMenu() {
    if (!userDropdown || userDropdown.hasAttribute('hidden')) return;
    userToggle?.setAttribute('aria-expanded', 'false');
    fadeClose(userDropdown, () => { userDropdown!.setAttribute('hidden', ''); });
  }
  userToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    userDropdown?.hasAttribute('hidden') ? openUserMenu() : closeUserMenu();
  });
  document.addEventListener('click', () => {
    if (userDropdown && !userDropdown.hasAttribute('hidden')) closeUserMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && userDropdown && !userDropdown.hasAttribute('hidden')) {
      closeUserMenu(); userToggle?.focus();
    }
  });

  // ── Saved stores, inside the avatar menu ──────────────────────
  // Fetched once per page load, the first time the avatar menu is opened at all — not on page
  // load, and not per disclosure click. The header renders on every page of the site, so this
  // list must never be part of what a page costs; a deliberate click on the avatar is the
  // earliest moment anyone can be about to look at it, and doing it then means the disclosure
  // itself opens instantly instead of on a spinner.
  const savedToggle = document.getElementById('saved-stores-toggle') as HTMLButtonElement | null;
  const savedPanel  = document.getElementById('saved-stores-panel') as HTMLElement | null;
  const savedChev   = document.getElementById('saved-stores-chev') as HTMLElement | null;

  interface SavedStore { slug: string; name: string; image: string; initial: string; gradient: string }

  // Empty string, never a hardcoded Hebrew literal: the strings come from the server through
  // data-str-* like every other client-rendered string in this file, so an English page cannot
  // end up with a Hebrew row (see tests/i18n-island-scope.test.ts for why the dictionary island
  // is not available here).
  const strSavedEmpty = savedToggle?.dataset.strEmpty ?? '';
  const strSavedAll   = savedToggle?.dataset.strAll ?? '';

  /** One row — the store's real logo when it has one, otherwise the same generated mark it wears
   *  on a store card, resolved server-side (see /api/saved-stores). */
  function savedStoreRow(s: SavedStore): string {
    const avatar = s.image
      ? `<img src="${escH(cdnThumb(s.image, 44, 44))}" alt="" width="22" height="22" loading="lazy" decoding="async" class="w-[22px] h-[22px] rounded-full object-cover flex-shrink-0" style="border:1px solid var(--color-border)">`
      : `<span class="w-[22px] h-[22px] rounded-full flex-shrink-0 flex items-center justify-center font-bold text-white text-[10px]" style="background:${escH(s.gradient)};border:1px solid var(--color-border)" aria-hidden="true">${escH(s.initial)}</span>`;
    // outline-offset goes NEGATIVE because this panel is a scroll container: the focus ring is
    // drawn 4px outside the row, which a scroller clips (AI_INSTRUCTIONS → Accessibility).
    return `<a href="/${escH(s.slug)}" role="menuitem" class="flex items-center gap-2 w-full py-1.5 px-2 rounded-sm text-[0.82rem] text-[color:var(--color-text)] no-underline transition-colors hover:bg-[color:var(--color-bg)] focus-visible:[outline-offset:-2px]">${avatar}<span class="min-w-0 truncate">${escH(s.name)}</span></a>`;
  }

  let savedStoresLoaded = false;
  async function loadSavedStores(): Promise<void> {
    if (savedStoresLoaded || !savedPanel) return;
    savedStoresLoaded = true;
    try {
      const res = await fetch('/api/saved-stores');
      // Thrown, not returned: a 401 from an expired session has to land on the same path as a
      // dropped connection, or the panel stays permanently blank with nothing left to retry it.
      if (!res.ok) throw new Error(`saved-stores ${res.status}`);
      const data = await res.json() as { total: number; stores: SavedStore[] };
      const list = Array.isArray(data.stores) ? data.stores : [];
      savedPanel.innerHTML = list.length === 0
        ? `<p class="px-2 py-1.5 text-[0.78rem] text-[color:var(--color-muted)]">${escH(strSavedEmpty)}</p>`
        : list.map(savedStoreRow).join('')
          // Only when the menu is actually hiding some — a link to "all" beside all of them is a
          // row that answers a question nobody asked.
          + (data.total > list.length
            ? `<a href="/?panel=liked" role="menuitem" class="flex items-center w-full py-1.5 px-2 rounded-sm text-[0.78rem] font-medium text-[color:var(--color-primary)] no-underline transition-colors hover:bg-[color:var(--color-bg)] focus-visible:[outline-offset:-2px]">${escH(strSavedAll)}</a>`
            : '');
    } catch {
      // The disclosure stays empty rather than claiming "you saved nothing", and the flag goes
      // back so the next open genuinely retries.
      savedStoresLoaded = false;
    }
  }

  // The heart on a store page writes this very list. Without this the menu keeps whatever it read
  // when it was first opened, so a store saved a moment ago is missing from it — and one just
  // un-saved is still in it, linking somewhere the shopper deliberately removed.
  window.addEventListener('favorite:change', () => {
    savedStoresLoaded = false;
    if (!savedPanel) return;
    // Open right now: refill in place, so it never blinks empty. Closed: drop what it holds and
    // let the next open pay for the read.
    if (savedPanel.hasAttribute('hidden')) savedPanel.innerHTML = '';
    else loadSavedStores();
  });

  savedToggle?.addEventListener('click', (e) => {
    // The menu closes on any document click (see above); this one is inside it and must not.
    e.stopPropagation();
    if (!savedPanel) return;
    const open = savedPanel.hasAttribute('hidden');
    savedPanel.toggleAttribute('hidden', !open);
    savedToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    savedChev?.classList.toggle('rotate-180', open);
    if (open) loadSavedStores();
  });

  // ── Notifications bell ────────────────────────────────────────
  const originalTitle = document.title;
  const bellBtn    = document.getElementById('notif-bell-btn') as HTMLButtonElement | null;
  const notifCountBadge = document.getElementById('notif-count-badge') as HTMLElement | null;
  const notifDrop  = document.getElementById('notif-dropdown') as HTMLElement | null;
  const notifList  = document.getElementById('notif-list') as HTMLElement | null;

  interface NotifItem { id: string; type?: string; title: string; body: string; read: boolean; createdAt: string; storeName?: string; relatedId?: string; }

  function timeAgo(iso: string): string {
    const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (diff < 60)    return 'עכשיו';
    if (diff < 3600)  return `לפני ${Math.floor(diff / 60)} ד'`;
    if (diff < 86400) return `לפני ${Math.floor(diff / 3600)} ש'`;
    return `לפני ${Math.floor(diff / 86400)} ימים`;
  }

  // Badge/title always reflect the server's own unreadCount (computed fresh from
  // *all* of a user's notifications) — never derived from whatever `items` list
  // happens to be on hand, which can be just an incremental since-filtered batch
  // (see notifications:update below) and would otherwise reset the badge to that
  // batch's own small size instead of the true total.
  function setBadge(unreadCount: number, opts?: { animate?: boolean }) {
    if (notifCountBadge) {
      updateBadge(notifCountBadge, unreadCount > 0 ? (unreadCount > 99 ? '99+' : String(unreadCount)) : null, opts);
    }
    document.title = unreadCount > 0 ? `(${unreadCount}) ${originalTitle}` : originalTitle;
  }

  function renderNotifs(items: NotifItem[]) {
    if (!notifList) return;
    const clearAllBtn = document.getElementById('notif-clear-all-btn') as HTMLButtonElement | null;
    if (clearAllBtn) clearAllBtn.hidden = items.length === 0;
    if (!items.length) { notifList.innerHTML = '<p class="notif-empty">אין התראות חדשות</p>'; return; }
    notifList.innerHTML = items.slice(0, 10).map((n) => `
      <div class="notif-item${n.read ? '' : ' notif-item--unread'}" data-id="${escH(n.id)}" data-type="${escH(n.type ?? '')}" data-related-id="${escH(n.relatedId ?? '')}" role="button" tabindex="0">
        <button class="notif-item__delete" data-del-id="${escH(n.id)}" type="button" aria-label="מחק התראה">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="notif-item__title">${escH(n.title)}</div>
        ${n.storeName ? `<div class="notif-item__tag">${escH(n.storeName)}</div>` : ''}
        <div class="notif-item__body">${escH(n.body)}</div>
        <div class="notif-item__time">${timeAgo(n.createdAt)}</div>
      </div>`).join('');
    notifList.querySelectorAll<HTMLElement>('[data-del-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.dataset.delId ?? '';
        if (!id) return;
        const card = btn.closest<HTMLElement>('.notif-item');
        card?.remove();
        if (notifList && !notifList.querySelector('.notif-item')) {
          notifList.innerHTML = '<p class="notif-empty">אין התראות חדשות</p>';
        }
        if (clearAllBtn && !notifList?.querySelector('.notif-item')) clearAllBtn.hidden = true;
        fetch('/api/notifications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id }),
        }).then(loadNotifs).catch(() => {});
      });
    });
    notifList.querySelectorAll<HTMLElement>('[data-id]').forEach((el) => {
      el.addEventListener('click', () => {
        closeNotifDrop();
        const id = el.dataset.id ?? '';
        if (el.classList.contains('notif-item--unread') && id) {
          el.classList.remove('notif-item--unread');
          // keepalive: the POST must still land even though a navigation is
          // about to fire right after — otherwise the browser can abort it
          // mid-flight and the notification stays unread forever.
          fetch('/api/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'mark-read', id }),
            keepalive: true,
          }).catch(() => {});
        }
        const type = el.dataset.type ?? '';
        // A system message's relatedId is its THREAD id (admin/messages.ts) —
        // the same value the dashboard row carries as data-msg-id, so the
        // deep-link opens that exact conversation rather than one shared
        // "system messages" row (which no longer exists).
        const relatedId = el.dataset.relatedId ?? '';
        const href = type === 'new_message'
          ? '/seller/dashboard?panel=messages'
          : type === 'admin_message'
          ? `/seller/dashboard?panel=messages${relatedId ? `&msg=${encodeURIComponent(relatedId)}` : ''}`
          : type === 'new_order' || type === 'order_update'
          ? '/seller/dashboard?panel=orders'
          : type === 'low_stock' || type === 'out_of_stock'
          ? '/seller/dashboard?panel=products'
          : '/buyer/dashboard?tab=messages';
        window.location.href = href;
      });
    });
  }

  function openNotifDrop() {
    if (!notifDrop || !bellBtn) return;
    if (window.innerWidth <= 640) {
      const rect = bellBtn.getBoundingClientRect();
      Object.assign(notifDrop.style, { top: `${rect.bottom + 8}px`, left: '8px', right: '8px', width: 'auto', maxHeight: '480px' });
    } else {
      notifDrop.style.cssText = '';
    }
    notifDrop.hidden = false;
    bellBtn.setAttribute('aria-expanded', 'true');
  }
  function closeNotifDrop() {
    if (!notifDrop || !bellBtn || notifDrop.hidden) return;
    bellBtn.setAttribute('aria-expanded', 'false');
    fadeClose(notifDrop, () => { notifDrop!.hidden = true; });
  }
  document.getElementById('notif-close-btn')?.addEventListener('click', (e) => { e.stopPropagation(); closeNotifDrop(); bellBtn?.focus(); });

  document.getElementById('notif-clear-all-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (notifList) notifList.innerHTML = '<p class="notif-empty">אין התראות חדשות</p>';
    (document.getElementById('notif-clear-all-btn') as HTMLButtonElement | null)!.hidden = true;
    setBadge(0);
    fetch('/api/notifications', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'delete-all' }),
    }).catch(() => {});
  });

  bellBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeUserMenu();
    if (document.getElementById('wishlist-toggle')?.getAttribute('aria-expanded') === 'true') {
      window.dispatchEvent(new CustomEvent('wishlist:open'));
    }
    const msp = document.getElementById('mobile-search-panel') as HTMLElement | null;
    if (msp && !msp.hasAttribute('hidden')) { msp.setAttribute('hidden', ''); document.getElementById('mobile-search-btn')?.setAttribute('aria-expanded', 'false'); }
    const hmsp = document.getElementById('home-mobile-search-panel') as HTMLElement | null;
    if (hmsp && !hmsp.hasAttribute('hidden')) { hmsp.setAttribute('hidden', ''); document.getElementById('home-mobile-search-btn')?.setAttribute('aria-expanded', 'false'); }
    if (notifDrop?.hidden) { openNotifDrop(); loadNotifs(); } else closeNotifDrop();
  });
  document.addEventListener('click', (e) => {
    if (bellBtn && notifDrop && !bellBtn.contains(e.target as Node) && !notifDrop.contains(e.target as Node)) closeNotifDrop();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && notifDrop && !notifDrop.hidden) { closeNotifDrop(); bellBtn?.focus(); }
  });


  async function loadNotifs() {
    const loadingDot = document.getElementById('notif-loading-dot');
    loadingDot?.removeAttribute('hidden');
    try {
      const res = await fetch('/api/notifications');
      if (!res.ok) return;
      const { notifications, unreadCount } = await res.json() as { notifications: NotifItem[]; unreadCount: number };
      renderNotifs(notifications ?? []);
      setBadge(unreadCount ?? 0);
      const sellerReplyCount = (notifications ?? []).filter((n: NotifItem) => n.type === 'seller_reply' && !n.read).length;
      window.dispatchEvent(new CustomEvent('msg-badge-update', { detail: sellerReplyCount }));
    } catch { /* ignore */ }
    finally {
      loadingDot?.setAttribute('hidden', '');
    }
  }

  setInterval(loadNotifs, 30000);

  // Background tabs get their timers throttled by the browser (battery/perf
  // policy) — the 30s poll above still runs while hidden, just less often.
  // This forces an immediate refresh the instant the tab regains focus, so
  // the title badge is never stale by more than the throttled gap.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') loadNotifs();
  });

  window.addEventListener('notifications:update', (e: Event) => {
    const { unreadCount } = (e as CustomEvent<{ unreadCount: number; notifications: NotifItem[] }>).detail;
    setBadge(unreadCount ?? 0);
    // The event's own `notifications` is only the incremental since-filtered
    // batch from the site-wide poller, not the full list — reuse it for the
    // visible dropdown would show a wrong/shrunk list, so only a real fetch
    // (loadNotifs, already called whenever the dropdown opens) keeps it accurate.
    if (notifDrop && !notifDrop.hidden) loadNotifs();
  });

  window.addEventListener('notif-refreshed', () => { loadNotifs(); });

  if (bellBtn) {
    // Page-load reconcile against the SSR-seeded bell count. Silent for the same
    // reason the cart's first refresh is: this fetch answers a question that was
    // already settled when the page rendered a moment ago, so a difference here is
    // a stale seed, not news arriving — rolling it would make every navigation
    // flick the bell. Real arrivals (the 30s poll, notifications:update, opening
    // the dropdown) still animate.
    fetch('/api/notifications').then(r => r.json()).then((d: { notifications: NotifItem[]; unreadCount: number }) => {
      renderNotifs(d.notifications ?? []);
      setBadge(d.unreadCount ?? 0, { animate: false });
    }).catch(() => {});
  }

  // ── Seller alert dot (avatar + "sellers dashboard" link) ──────
  // Persistent "you have something unhandled" indicator, derived live from
  // real order/message state — unlike the bell, it can't go stale if the
  // seller flips an order back to "pending" after dismissing its notification.
  const userMenuEl = document.querySelector<HTMLElement>('.user-menu');
  if (userMenuEl && userMenuEl.dataset.hasStore === '1') {
    const avatarDot   = document.getElementById('seller-alert-avatar-dot') as HTMLElement | null;
    const dropdownDot = document.getElementById('seller-alert-dropdown-dot') as HTMLElement | null;

    async function loadSellerAlert() {
      try {
        const res = await fetch('/api/seller/alerts');
        if (!res.ok) return;
        const { hasAlert } = await res.json() as { hasAlert: boolean };
        avatarDot?.toggleAttribute('hidden', !hasAlert);
        dropdownDot?.toggleAttribute('hidden', !hasAlert);
      } catch { /* ignore */ }
    }

    loadSellerAlert();
    setInterval(loadSellerAlert, 30000);
    window.addEventListener('notif-refreshed', loadSellerAlert);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') loadSellerAlert();
    });
  }

  // ── Homepage mobile search ────────────────────────────────────
  const homeSearchBtn   = document.getElementById('home-mobile-search-btn') as HTMLButtonElement | null;
  const homeSearchPanel = document.getElementById('home-mobile-search-panel') as HTMLElement | null;
  const homeSearchDiv   = document.getElementById('home-header-search') as HTMLElement | null;

  if (homeSearchBtn && homeSearchPanel && homeSearchDiv) {
    const homeMq = window.matchMedia('(max-width: 640px)');
    const homeOrigParent      = homeSearchDiv.parentElement as HTMLElement;
    const homeOrigNextSibling = homeSearchDiv.nextElementSibling;
    const homeSearchSlot      = document.getElementById('home-mobile-search-slot') as HTMLElement | null;

    function setupHomeMobile() {
      if (homeMq.matches) {
        if (homeSearchSlot && !homeSearchSlot.contains(homeSearchDiv)) homeSearchSlot.appendChild(homeSearchDiv!);
      } else {
        closeHomeMobileSearch();
        if (!homeOrigParent.contains(homeSearchDiv)) homeOrigParent.insertBefore(homeSearchDiv!, homeOrigNextSibling);
      }
    }

    function positionHomePanel() {
      const rect = homeSearchBtn!.getBoundingClientRect();
      Object.assign(homeSearchPanel!.style, { top: `${rect.bottom + 8}px`, left: '8px', right: '8px', width: 'auto' });
    }

    function openHomeMobileSearch(e: MouseEvent) {
      e.stopPropagation();
      closeUserMenu();
      closeAllPanels();
      positionHomePanel();
      homeSearchPanel!.removeAttribute('hidden');
      homeSearchBtn!.setAttribute('aria-expanded', 'true');
      setTimeout(() => (homeSearchPanel!.querySelector('input') as HTMLInputElement | null)?.focus(), 50);
    }

    function closeHomeMobileSearch() {
      if (homeSearchPanel!.hasAttribute('hidden')) return;
      homeSearchBtn!.setAttribute('aria-expanded', 'false');
      fadeClose(homeSearchPanel!, () => { homeSearchPanel!.setAttribute('hidden', ''); });
    }

    setupHomeMobile();
    homeMq.addEventListener('change', setupHomeMobile);

    homeSearchBtn.addEventListener('click', (e) => {
      homeSearchPanel!.hasAttribute('hidden') ? openHomeMobileSearch(e) : closeHomeMobileSearch();
    });

    document.addEventListener('click', (e) => {
      if (!homeSearchPanel!.hasAttribute('hidden') &&
          !homeSearchPanel!.contains(e.target as Node) &&
          !homeSearchBtn!.contains(e.target as Node)) {
        closeHomeMobileSearch();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !homeSearchPanel!.hasAttribute('hidden')) {
        closeHomeMobileSearch();
        homeSearchBtn?.focus();
      }
    });
  }

  // ── Home / buyer-dashboard store+product search dropdown ─────
  const homeSearchIn  = document.getElementById('store-search') as HTMLInputElement | null;
  const homeSearchDdEl = document.getElementById('home-search-dropdown') as HTMLElement | null;
  const homeSearchWrap = document.getElementById('home-header-search') as HTMLElement | null;

  if (homeSearchIn && homeSearchDdEl) {
    const strStores   = homeSearchWrap?.dataset.strStores ?? 'חנויות';
    const strProducts = homeSearchWrap?.dataset.strProducts ?? 'מוצרים';
    const strEmptyRes = homeSearchWrap?.dataset.strEmpty ?? 'לא נמצאו תוצאות';
    const strViewAll  = homeSearchWrap?.dataset.strViewAll ?? 'צפו בכל התוצאות';

    const HOME_RECENTS_KEY = 'home_search_recent_v1';
    const MAX_HOME_RECENTS = 5;
    function getHomeRecents(): string[] { try { return JSON.parse(localStorage.getItem(HOME_RECENTS_KEY) ?? '[]') as string[]; } catch { return []; } }
    function saveHomeRecent(q: string) {
      const list = [q, ...getHomeRecents().filter(r => r !== q)].slice(0, MAX_HOME_RECENTS);
      try { localStorage.setItem(HOME_RECENTS_KEY, JSON.stringify(list)); } catch {}
    }
    function clearHomeRecents() { try { localStorage.removeItem(HOME_RECENTS_KEY); } catch {} }

    function showHomeDd() { homeSearchDdEl!.removeAttribute('hidden'); homeSearchIn!.setAttribute('aria-expanded', 'true'); }
    function hideHomeDd() { homeSearchDdEl!.setAttribute('hidden', ''); homeSearchIn!.setAttribute('aria-expanded', 'false'); }

    // Typing here used to also filter whatever page it's on (homepage shelves,
    // /stores' own grid) in place — dropped (2026-07-14): it silently mutated
    // the page layout underneath the dropdown, which read as broken/confusing.
    // This search bar now only ever shows a preview in its own dropdown; the
    // real destination is the dedicated /search results page (goToSearch).
    function goToSearch(q: string): void {
      saveHomeRecent(q);
      window.location.href = `/search?q=${encodeURIComponent(q)}`;
    }

    function renderHomeRecents() {
      const recents = getHomeRecents();
      if (!recents.length) { hideHomeDd(); return; }
      homeSearchDdEl!.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:0.3rem 0.5rem 0.1rem">
          <span class="hsd-section-label" style="padding:0">חיפושים אחרונים</span>
          <button class="hsd-clear-recents" type="button" id="home-clear-recents">נקה</button>
        </div>
        <div class="hsd-recents-list">
          ${recents.map(r => `<button class="hsd-recent-chip" type="button" data-q="${r.replace(/"/g,'&quot;')}">${r}</button>`).join('')}
        </div>`;
      homeSearchDdEl!.querySelector<HTMLButtonElement>('#home-clear-recents')?.addEventListener('click', () => { clearHomeRecents(); hideHomeDd(); });
      homeSearchDdEl!.querySelectorAll<HTMLButtonElement>('.hsd-recent-chip').forEach(btn => {
        btn.addEventListener('click', () => goToSearch(btn.dataset.q ?? ''));
      });
      showHomeDd();
    }

    const STORE_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`;

    function formatHomePrice(n: number): string {
      return `${n.toLocaleString('he-IL')} ₪`;
    }

    // A store row shows its real logo when the seller set one, otherwise an
    // initial-gradient avatar (mirrors StoreAvatar.astro) — never the generic
    // house icon, so every store result reads as a distinct brand.
    function storeAvatarHtml(name: string, image: string): string {
      if (image) return `<img class="hsd-result-store-img" src="${escHtml(cdnThumb(image, 112, 112))}" alt="" width="56" height="56" loading="lazy" decoding="async">`;
      const initial = escHtml((name.trim()[0] ?? '?').toUpperCase());
      return `<span class="hsd-result-avatar" aria-hidden="true">${initial}</span>`;
    }

    type SiteSearchStore = { name: string; slug: string; tagline: string; image: string };
    type SiteSearchProduct = { name: string; slug: string; price: number; basePrice?: number; image: string; storeSlug: string; storeName: string };

    // Guards a slower, earlier fetch (e.g. a fast backspace-retype) from resolving
    // after a newer one and overwriting the dropdown with stale results.
    let homeSearchToken = 0;

    // Platform-wide search: stores by name/tagline/description, products by name —
    // each product hit carries its own store's name so a product result reads
    // "product name — in store X", never a bare product with no context.
    async function renderHomeResults(q: string) {
      const token = ++homeSearchToken;
      let stores: SiteSearchStore[] = [];
      let products: SiteSearchProduct[] = [];
      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
        const data = await res.json() as { ok: boolean; stores?: SiteSearchStore[]; products?: SiteSearchProduct[] };
        if (data.ok) { stores = data.stores ?? []; products = data.products ?? []; }
      } catch { /* network error — falls through to the empty-results message */ }
      if (token !== homeSearchToken) return;

      if (!stores.length && !products.length) {
        homeSearchDdEl!.innerHTML = `<div class="hsd-empty">${strEmptyRes}</div>`;
      } else {
        const storesHtml = !stores.length ? '' : `
          ${products.length ? `<div class="hsd-section-label">${strStores}</div>` : ''}
          <ul class="hsd-results" role="listbox">
            ${stores.map(s => `
              <li role="option">
                <a class="hsd-result-item" href="/${s.slug}">
                  ${storeAvatarHtml(s.name, s.image)}
                  <span class="hsd-result-name">${escHtml(s.name)}</span>
                  ${s.tagline ? `<span class="hsd-result-price" style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(s.tagline)}</span>` : ''}
                </a>
              </li>`).join('')}
          </ul>`;
        const productsHtml = !products.length ? '' : `
          ${stores.length ? `<div class="hsd-section-label">${strProducts}</div>` : ''}
          <ul class="hsd-results" role="listbox">
            ${products.map(p => `
              <li role="option">
                <a class="hsd-result-item" href="/${p.storeSlug}/${p.slug}">
                  ${p.image
                    ? `<img class="hsd-result-img" src="${escHtml(cdnThumb(p.image, 112, 112))}" alt="${escHtml(p.name)}" width="56" height="56" loading="lazy" decoding="async">`
                    : `<div class="hsd-result-img-placeholder" aria-hidden="true">${STORE_ICON}</div>`
                  }
                  <div class="hsd-result-text">
                    <span class="hsd-result-name">${escHtml(p.name)}</span>
                    <span class="hsd-result-store">${escHtml(p.storeName)}</span>
                  </div>
                  <span class="hsd-result-price price-now${p.basePrice ? ' price-now--sale' : ''}">${formatHomePrice(p.price)}</span>${p.basePrice ? `<s class="price-was">${formatHomePrice(p.basePrice)}</s>` : ''}
                </a>
              </li>`).join('')}
          </ul>`;
        const viewAllHtml = `
          <button type="button" class="hsd-view-all" id="home-view-all">${escHtml(strViewAll)}</button>`;
        homeSearchDdEl!.innerHTML = storesHtml + productsHtml + viewAllHtml;
        homeSearchDdEl!.querySelectorAll<HTMLAnchorElement>('.hsd-result-item').forEach(a => {
          a.addEventListener('click', e => { e.preventDefault(); saveHomeRecent(q); window.location.href = a.href; });
        });
        homeSearchDdEl!.querySelector<HTMLButtonElement>('#home-view-all')?.addEventListener('click', () => goToSearch(q));
      }
      showHomeDd();
    }

    homeSearchIn.addEventListener('focus', () => {
      if (!homeSearchIn.value.trim()) renderHomeRecents(); else renderHomeResults(homeSearchIn.value.trim());
    });

    let homeDebounce = 0;
    homeSearchIn.addEventListener('input', () => {
      clearTimeout(homeDebounce);
      const q = homeSearchIn.value.trim();
      if (!q) { hideHomeDd(); renderHomeRecents(); return; }
      homeDebounce = window.setTimeout(() => renderHomeResults(q), 150);
    });

    homeSearchIn.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') { hideHomeDd(); homeSearchIn.blur(); }
      if (e.key === 'Enter') {
        e.preventDefault();
        const q = homeSearchIn.value.trim();
        if (q) goToSearch(q);
      }
    });

    document.addEventListener('click', (e: MouseEvent) => {
      const wrap = document.getElementById('home-header-search') ?? document.getElementById('home-mobile-search-panel');
      if (!wrap?.contains(e.target as Node)) hideHomeDd();
    });
  }

  // ── Store header search ───────────────────────────────────────
  const headerSearch = document.getElementById('header-search') as HTMLElement | null;
  if (headerSearch) {
    const storeSlug    = headerSearch.dataset.storeSlug ?? '';
    const strRecents   = headerSearch.dataset.strRecents ?? 'חיפושים אחרונים';
    const strEmpty     = headerSearch.dataset.strEmpty ?? 'לא נמצאו מוצרים';
    const input        = document.getElementById('header-search-input') as HTMLInputElement;
    const dropdown     = document.getElementById('header-search-dropdown') as HTMLElement;

    const RECENTS_KEY  = `store_recent_searches_${storeSlug}`;
    const MAX_RECENTS  = 5;
    const PLACEHOLDER_SVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;

    /**
     * The product index this dropdown matches against.
     *
     * It used to be serialised into the page as `<script id="header-search-products">`
     * — instant, but paid for by every visitor on every store and product page whether
     * they searched or not (24.1KB of HTML on the biggest showcase store, growing with
     * the catalog). It now comes from `/api/store-search-index`, and the matching is
     * still done entirely in the browser: the fetch is moved OUT of the page load, not
     * onto the keystroke.
     *
     * Warmed twice, so a first character never waits on it: once when the browser goes
     * idle after paint, and once on first focus for anyone who beats that. `loadIndex`
     * is idempotent and shares one in-flight promise, so those two calls are one request.
     *
     * A failure leaves `products` empty: the dropdown offers nothing and Enter still
     * submits the query, which is exactly what a visitor without JS gets.
     */
    type SearchProduct = { slug: string; name: string; price: number; basePrice?: number; image: string };
    let products: SearchProduct[] = [];
    let indexLoad: Promise<void> | null = null;

    function loadIndex(): Promise<void> {
      if (!indexLoad) {
        indexLoad = fetch(`/api/store-search-index?store=${encodeURIComponent(storeSlug)}`)
          .then((r) => (r.ok ? r.json() : null))
          .then((data: { ok?: boolean; products?: SearchProduct[] } | null) => {
            if (data?.ok && Array.isArray(data.products)) products = data.products;
          })
          .catch(() => { /* suggestions unavailable; Enter still searches */ });
      }
      return indexLoad;
    }

    // Idle, not load: this is a convenience for an interaction that hasn't happened
    // yet, so it must never compete with the page's own images or scripts.
    // Same shape as seller/dashboard.astro's idle deferral — a `'x' in window`
    // check narrows the else branch to `never`, so read the property instead.
    const warm = () => { void loadIndex(); };
    const idle = window.requestIdleCallback ?? ((cb: () => void) => window.setTimeout(cb, 1200));
    idle(warm, { timeout: 3000 });

    function formatPrice(n: number) {
      return `${n.toLocaleString('he-IL')} ₪`;
    }

    function getRecents(): string[] {
      try { return JSON.parse(localStorage.getItem(RECENTS_KEY) ?? '[]') as string[]; }
      catch { return []; }
    }

    function saveRecent(q: string) {
      if (!q.trim()) return;
      const list = [q.trim(), ...getRecents().filter((r) => r !== q.trim())].slice(0, MAX_RECENTS);
      try { localStorage.setItem(RECENTS_KEY, JSON.stringify(list)); } catch { /* quota */ }
    }

    function clearRecents() {
      try { localStorage.removeItem(RECENTS_KEY); } catch { /* quota */ }
    }

    function showDropdown() {
      dropdown.removeAttribute('hidden');
      input.setAttribute('aria-expanded', 'true');
    }

    function hideDropdown() {
      dropdown.setAttribute('hidden', '');
      input.setAttribute('aria-expanded', 'false');
    }

    function navigateToProduct(slug: string, query: string) {
      saveRecent(query);
      window.location.href = `/${storeSlug}/${slug}`;
    }

    function applySearch(q: string) {
      saveRecent(q);
      const gridSearch = document.getElementById('product-search') as HTMLInputElement | null;
      if (gridSearch) {
        // Dispatched instead of writing straight into #product-search — this search
        // bar always searches the whole store, ignoring whatever category filter is
        // currently selected (the page's own listener resets the category to "all").
        window.dispatchEvent(new CustomEvent('store-search:global', { detail: { q } }));
        hideDropdown();
      } else {
        window.location.href = `/${storeSlug}?q=${encodeURIComponent(q)}`;
      }
    }

    function renderRecents() {
      const recents = getRecents();
      if (!recents.length) { hideDropdown(); return; }
      const strClear = headerSearch?.dataset.strClear ?? 'נקה';
      dropdown.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:0.3rem 0.5rem 0.1rem">
          <span class="hsd-section-label" style="padding:0">${strRecents}</span>
          <button class="hsd-clear-recents" type="button">${strClear}</button>
        </div>
        <div class="hsd-recents-list">
          ${recents.map((r) => `<button class="hsd-recent-chip" type="button" data-q="${r.replace(/"/g, '&quot;')}">${r}</button>`).join('')}
        </div>`;
      dropdown.querySelector<HTMLButtonElement>('.hsd-clear-recents')?.addEventListener('click', () => {
        clearRecents();
        hideDropdown();
      });
      dropdown.querySelectorAll<HTMLButtonElement>('.hsd-recent-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const q = btn.dataset.q ?? '';
          input.value = q;
          applySearch(q);
        });
      });
      showDropdown();
    }

    function normalizeHe(str: string): string {
      return str
        .toLowerCase()
        .replace(/[ְ-ׇֽֿׁׂׅׄ]/g, '')
        .replace(/[ן]/g, 'נ').replace(/[ף]/g, 'פ').replace(/[ך]/g, 'כ')
        .replace(/[ם]/g, 'מ').replace(/[ץ]/g, 'צ')
        .replace(/[׳״'""]/g, '')
        .replace(/[-_.,!?;:()\[\]{}/\\]/g, ' ')
        .replace(/\s+/g, ' ').trim();
    }

    function matchesSearch(query: string, name: string): boolean {
      if (!query) return true;
      const nQuery = normalizeHe(query);
      const nName = normalizeHe(name);
      return nQuery.split(' ').every((word) => word && nName.includes(word));
    }

    async function renderResults(q: string) {
      await loadIndex();
      // The index may have taken longer than the next keystroke or a blur. Anything
      // rendered now would be answering a question the box no longer asks.
      if (input.value.trim() !== q) return;
      const hits = products.filter((p) => matchesSearch(q, p.name)).slice(0, 5);
      if (!hits.length) {
        dropdown.innerHTML = `<div class="hsd-empty">${strEmpty}</div>`;
      } else {
        dropdown.innerHTML = `<ul class="hsd-results" role="listbox">
          ${hits.map((p) => `
            <li role="option">
              <a class="hsd-result-item" href="/${storeSlug}/${p.slug}" data-slug="${p.slug}">
                ${p.image
                  ? `<img class="hsd-result-img" src="${escH(cdnThumb(p.image, 112, 112))}" alt="${escH(p.name)}" width="56" height="56" loading="lazy" decoding="async">`
                  : `<div class="hsd-result-img-placeholder" aria-hidden="true">${PLACEHOLDER_SVG}</div>`
                }
                <span class="hsd-result-name">${escH(p.name)}</span>
                <span class="hsd-result-price price-now${p.basePrice ? ' price-now--sale' : ''}">${formatPrice(p.price)}</span>${p.basePrice ? `<s class="price-was">${formatPrice(p.basePrice)}</s>` : ''}
              </a>
            </li>`).join('')}
        </ul>`;
        dropdown.querySelectorAll<HTMLAnchorElement>('.hsd-result-item').forEach((a) => {
          a.addEventListener('click', (e) => {
            e.preventDefault();
            navigateToProduct(a.dataset.slug ?? '', q);
          });
        });
      }
      showDropdown();
    }

    input.addEventListener('focus', () => {
      // Catches anyone who focuses before the idle warm-up ran; it's the same promise.
      void loadIndex();
      if (!input.value.trim()) renderRecents();
      else void renderResults(input.value.trim());
    });

    let debounceTimer = 0;
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const q = input.value.trim();
      if (!q) {
        const gridSearch = document.getElementById('product-search') as HTMLInputElement | null;
        if (gridSearch) {
          // Cleared (native "x" or backspaced to empty) — restores whatever filter
          // was active before this search bar overrode it, see store-search:global.
          window.dispatchEvent(new CustomEvent('store-search:global', { detail: { q: '' } }));
        } else {
          window.location.href = `/${storeSlug}`;
          return;
        }
        renderRecents();
        return;
      }
      debounceTimer = window.setTimeout(() => void renderResults(q), 150);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const q = input.value.trim();
        if (q) applySearch(q);
        else hideDropdown();
      }
      if (e.key === 'Escape') { hideDropdown(); input.blur(); }
    });

    document.addEventListener('click', (e) => {
      if (!headerSearch?.contains(e.target as Node)) hideDropdown();
    });

    // ── Mobile search panel (icon → dropdown like notifications/wishlist) ──
    const mobileSearchBtn   = document.getElementById('mobile-search-btn') as HTMLButtonElement | null;
    const mobileSearchPanel = document.getElementById('mobile-search-panel') as HTMLElement | null;

    if (mobileSearchBtn && mobileSearchPanel) {
      const mq = window.matchMedia('(max-width: 640px)');
      // Save original position so we can restore on desktop
      const origParent      = headerSearch.parentElement as HTMLElement;
      const origNextSibling = headerSearch.nextElementSibling;

      const searchSlot = document.getElementById('mobile-search-slot') as HTMLElement | null;

      function setupMobile() {
        if (mq.matches) {
          if (searchSlot && !searchSlot.contains(headerSearch)) {
            searchSlot.appendChild(headerSearch!);
          }
        } else {
          closeMobileSearch();
          if (!origParent.contains(headerSearch)) {
            origParent.insertBefore(headerSearch!, origNextSibling);
          }
        }
      }

      function positionPanel() {
        const rect = mobileSearchBtn!.getBoundingClientRect();
        Object.assign(mobileSearchPanel!.style, {
          top:   `${rect.bottom + 8}px`,
          left:  '8px',
          right: '8px',
          width: 'auto',
        });
      }

      function closeOthers() {
        // Close notifications
        const nd = document.getElementById('notif-dropdown') as HTMLElement | null;
        if (nd && !nd.hidden) {
          nd.hidden = true;
          document.getElementById('notif-bell-btn')?.setAttribute('aria-expanded', 'false');
        }
        // Close wishlist — WishlistDrawer uses style.display, not hidden attribute
        const wp = document.getElementById('wishlist-panel') as HTMLElement | null;
        if (wp && wp.style.display !== 'none') {
          window.dispatchEvent(new CustomEvent('wishlist:open')); // toggles it closed
          document.getElementById('wishlist-toggle')?.setAttribute('aria-expanded', 'false');
        }
      }

      function openMobileSearch(e: MouseEvent) {
        e.stopPropagation();
        closeOthers();
        positionPanel();
        mobileSearchPanel!.removeAttribute('hidden');
        mobileSearchBtn!.setAttribute('aria-expanded', 'true');
        setTimeout(() => (mobileSearchPanel!.querySelector('input') as HTMLInputElement | null)?.focus(), 50);
      }

      function closeMobileSearch() {
        if (mobileSearchPanel!.hasAttribute('hidden')) return;
        hideDropdown();
        mobileSearchBtn!.setAttribute('aria-expanded', 'false');
        fadeClose(mobileSearchPanel!, () => { mobileSearchPanel!.setAttribute('hidden', ''); });
      }

      setupMobile();
      mq.addEventListener('change', setupMobile);

      mobileSearchBtn.addEventListener('click', (e) => {
        mobileSearchPanel!.hasAttribute('hidden') ? openMobileSearch(e) : closeMobileSearch();
      });

      document.addEventListener('click', (e) => {
        if (!mobileSearchPanel!.hasAttribute('hidden') &&
            !mobileSearchPanel!.contains(e.target as Node) &&
            !mobileSearchBtn!.contains(e.target as Node)) {
          closeMobileSearch();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileSearchPanel!.hasAttribute('hidden')) {
          closeMobileSearch();
          mobileSearchBtn?.focus();
        }
      });
    }
  }
</script>
