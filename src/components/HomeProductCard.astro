---
/**
 * One product tile on the homepage — the spotlight's per-store carousel.
 *
 * Lifted out of index.astro (which is long enough that pulling a self-contained
 * card out of it is worth it on its own), plus the `data-skeleton` marker that
 * initImageSkeletons() promotes to a shimmer only while the image is in flight
 * (never server-side — see lib/img-skeleton.ts for what that cost).
 *
 * The image carries a REAL `src`/`srcset` and native `loading="lazy"`. It used to
 * hold the URL in `data-lazy-src` for a hand-rolled IntersectionObserver, which
 * cost far more than it saved: an <img> with no src is invisible to the browser's
 * preload scanner, so not one tile could start downloading until the page's JS
 * module had loaded, parsed and run — and the shimmer replayed on every refresh
 * even for images sitting in cache. Native lazy-loading defers the off-screen
 * ones just the same, without blocking the visible ones behind JS.
 *
 * The card links to the STORE, not the product page — deliberate, and the reason
 * it isn't `<a href={product url}>`: the row is a discovery surface for stores.
 * Which is also why it prefetches like StoreCard does: same destination, same
 * hover-means-intent bet. Every tile in one carousel points at one store, and
 * Astro dedupes by URL, so a row of twelve costs one fetch however it is swept.
 */
import type { StoreProduct } from '../lib/store-products.js';
import { formatPrice, cdnSrc, cdnSrcSet } from '../config/store.config.js';
import { resolvePrice, type StoreSale } from '../lib/discounts.js';
import { priceHtml, saleBadgeHtml } from '../lib/price-html.js';

interface Props {
  product: StoreProduct;
  /** Where the tile links — the store the product belongs to. */
  storeSlug: string;
  /** That store's running sale, so a discounted tile shows the same price the store page does. */
  sale?: StoreSale;
  /** Accessible name of the carousel/row this tile sits in (for role="listitem"). */
  role?: 'listitem';
  /** Above the fold: load eagerly at high priority instead of lazily. Only the
   *  first few tiles of the first row should set this — marking everything
   *  "priority" is the same as marking nothing. */
  priority?: boolean;
}

const { product: p, storeSlug, sale, role, priority = false } = Astro.props;
const pv = resolvePrice(p, sale);
/** 220px tile; 440 covers 2x retina. Widths kept short on purpose — each distinct
 *  width is a separate CDN derivative. */
const WIDTHS = [220, 440];
---

<a
  href={`/${storeSlug}`}
  data-astro-prefetch
  class="home-product-card card"
  role={role}
  aria-label={`${p.name} — ${formatPrice(pv.price)}`}
>
  <div class="home-product-card__img-wrap" data-skeleton={p.images?.[0] ? '' : undefined}>
    {p.images?.[0]
      ? <img
          src={cdnSrc(p.images[0], 220)}
          srcset={cdnSrcSet(p.images[0], WIDTHS) || undefined}
          sizes="(max-width: 480px) 44vw, 220px"
          alt={p.name}
          width="300"
          height="300"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          class="home-product-card__img"
        />
      : <span class="home-product-card__initial" aria-hidden="true">
          {p.name[0]?.toUpperCase() ?? '?'}
        </span>
    }
    <Fragment set:html={saleBadgeHtml(pv)} />
  </div>
  <div class="home-product-card__body">
    <!-- `<bdi>` not `dir="auto"`: dir would also flip the ALIGNMENT, so a Latin
         product name on a Hebrew page left-aligned itself away from the price
         and card edge below it, and truncated from the wrong side. Same fix and
         same reasoning as StoreCard's own name. -->
    <span class="home-product-card__name"><bdi>{p.name}</bdi></span>
    <span class="home-product-card__price-row"><Fragment set:html={priceHtml(pv, { className: 'home-product-card__price' })} /></span>
  </div>
</a>
