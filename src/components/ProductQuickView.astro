---
import { getLang, getT } from '../i18n/index.js';
const lang = getLang(Astro.cookies);
const t    = getT(lang);
const c    = t.checkout;

const strToPayment = c.toPayment;
const strViewFull  = lang === 'he' ? 'לדף המוצר המלא' : 'View full product page';
const strQty       = lang === 'he' ? 'כמות' : 'Qty';
const strInc       = lang === 'he' ? 'הגדל' : 'Increase';
const strDec       = lang === 'he' ? 'הפחת' : 'Decrease';
const strClose     = lang === 'he' ? 'סגור' : 'Close';
const strError     = lang === 'he' ? 'שגיאה בטעינת המוצר' : 'Error loading product';
const strEnlarged  = lang === 'he' ? 'תמונה מוגדלת' : 'Enlarged image';
const strLoadingImage = t.product.loadingImage;
const strPrev      = lang === 'he' ? 'הקודמת' : 'Previous';
const strNext      = lang === 'he' ? 'הבאה' : 'Next';
const strShowMore  = lang === 'he' ? 'עוד' : 'More';
const strShowLess  = lang === 'he' ? 'פחות' : 'Less';
const strSaleBadge = t.store.saleBadge;
const strSaleWas   = t.store.saleWas;
const strHalted    = t.store.haltedTitle;
// "מוצר לדוגמה". This modal is opened from the CART drawer, where a showcase item sits next to a
// real one — so it is the surface furthest from the store page's own disclosure and the one where
// the words matter most (`lib/demo-stores.ts`: never learn it at the checkout refusal).
const strDemo      = t.demo.productBadge;
---

<!-- Lightbox (native dialog → top-layer, opens above pqv-dialog).
     While it's open the PQV modal CARD is hidden (data-lightbox=open → opacity-0,
     set in openLightbox) so its white surface doesn't show through as a lighter
     patch. Only two full-viewport black layers remain — this bg-black/80 over the
     modal's still-painted ::backdrop (bg-black/50; opacity-0 doesn't touch a
     ::backdrop) — compositing to a UNIFORM 1−(1−0.8)(1−0.5)=0.9, identical to the
     full product page's single rgba(0,0,0,0.9) lightbox. -->
<dialog id="co-lightbox" aria-label={strEnlarged}
  class="border-0 p-0 m-0 w-screen h-screen max-w-[100vw] max-h-[100vh] bg-transparent overflow-hidden [&::backdrop]:bg-black/80 [&::backdrop]:cursor-zoom-out">
  <div data-lb-frame data-lb-label={strLoadingImage}
    class="relative flex items-center justify-center w-full h-full py-12 px-20 box-border pointer-events-none max-[600px]:py-14 max-[600px]:px-10">
    <button id="co-lb-close" aria-label={strClose}
      class="absolute top-4 right-5 z-[2] w-9 h-9 rounded-[var(--radius)] border-0 bg-white/10 text-white cursor-pointer flex items-center justify-center transition-colors duration-100 [pointer-events:all] hover:bg-white/20">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button id="co-lb-prev" aria-label={strPrev}
      class="absolute top-1/2 -translate-y-1/2 z-[2] w-10 h-10 rounded-[var(--radius)] border-0 bg-white/10 text-white cursor-pointer flex items-center justify-center transition-colors duration-100 [pointer-events:all] hover:bg-white/20 left-5 max-[600px]:left-2">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <img id="co-lb-img" src="" alt="" loading="eager" decoding="async"
      class="w-auto h-auto max-w-full max-h-full object-contain rounded-[var(--radius)] block shadow-[0_8px_48px_rgba(0,0,0,.5)] select-none pointer-events-none bg-[color:var(--color-surface)] [-webkit-user-drag:none] transition-[filter,scale] duration-300 ease-out motion-reduce:transition-none" />
    <button id="co-lb-next" aria-label={strNext}
      class="absolute top-1/2 -translate-y-1/2 z-[2] w-10 h-10 rounded-[var(--radius)] border-0 bg-white/10 text-white cursor-pointer flex items-center justify-center transition-colors duration-100 [pointer-events:all] hover:bg-white/20 right-5 max-[600px]:right-2">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div id="co-lb-counter" hidden
      class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/60 text-[.78rem] tracking-[.04em] pointer-events-none"></div>
  </div>
</dialog>

<!-- Product quick-view dialog -->
<dialog
  id="pqv-dialog"
  aria-labelledby="pqv-name"
  aria-modal="true"
  data-str-to-payment={strToPayment}
  data-str-view-full={strViewFull}
  data-str-qty={strQty}
  data-str-inc={strInc}
  data-str-dec={strDec}
  data-str-error={strError}
  data-str-show-more={strShowMore}
  data-str-show-less={strShowLess}
  data-str-sale-badge={strSaleBadge}
  data-str-halted={strHalted}
  data-str-sale-was={strSaleWas}
  data-str-demo={strDemo}
  class="border-0 rounded-[var(--radius-lg)] p-0 w-[min(540px,94vw)] max-h-[90dvh] overflow-hidden shadow-[0_8px_40px_rgba(0,0,0,.22)] [overscroll-behavior:contain] fixed inset-0 m-auto will-change-transform contain-layout open:animate-modal-in [&::backdrop]:bg-black/50 transition-opacity duration-150 data-[lightbox=open]:opacity-0"
>
  <div class="relative max-h-[90dvh] flex flex-col overflow-hidden">
    <button id="pqv-close" aria-label={strClose} type="button"
      class="absolute top-3 end-3 z-10 w-8 h-8 rounded-[var(--radius-icon)] bg-black/35 border-0 text-white cursor-pointer flex items-center justify-center transition-colors duration-[140ms] hover:bg-black/60">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div id="pqv-body" class="flex flex-col flex-1 min-h-0 overflow-hidden">
      <div class="p-5">
        <div class="skel-bar" style="height:220px;border-radius:var(--radius);margin-bottom:1rem"></div>
        <div class="skel-bar" style="height:22px;width:60%;margin-bottom:.5rem"></div>
        <div class="skel-bar" style="height:18px;width:35%"></div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { cdnSrc } from '../config/store.config.js';
  import { initOverflowShadow } from '../lib/sticky-bar.js';
  import { setLightboxImage, resetLightboxImage, lightboxWidth, warmLightboxImage, neighbourIndexes } from '../lib/lightbox-image.js';
  import { arrowStep, wrapIndex } from '../lib/arrow-step.js';
  import { priceHtml, saleBadgeHtml } from '../lib/price-html.js';
  import { demoProductBadgeHtml } from '../lib/demo-badge.js';
  import type { PriceView } from '../lib/discounts.js';
  import { escapeHtml as pqvEsc } from '../lib/html-escape.js';
  import { resolveVariantColor, isColorVariant } from '../lib/color-variants.js';
  import { initReadMore } from '../lib/read-more.js';
  import { initLiquidDots } from '../lib/carousel-dots.js';
  import { scrollBelowPinnedChrome } from '../scripts/dashboard/scroll-utils.js';

  const pqvDialog = document.getElementById('pqv-dialog') as HTMLDialogElement | null;
  const pqvBody   = document.getElementById('pqv-body');
  const pqvClose  = document.getElementById('pqv-close');
  let   pqvPrevFocus: HTMLElement | null = null;

  const strings = {
    toPayment: pqvDialog?.dataset['strToPayment'] ?? 'לתשלום',
    viewFull:  pqvDialog?.dataset['strViewFull']  ?? 'לדף המוצר המלא',
    qty:       pqvDialog?.dataset['strQty']       ?? 'כמות',
    inc:       pqvDialog?.dataset['strInc']       ?? 'הגדל',
    dec:       pqvDialog?.dataset['strDec']       ?? 'הפחת',
    error:     pqvDialog?.dataset['strError']     ?? 'שגיאה בטעינת המוצר',
    showMore:  pqvDialog?.dataset['strShowMore']  ?? 'הצג עוד',
    showLess:  pqvDialog?.dataset['strShowLess']  ?? 'הצג פחות',
    saleBadge: pqvDialog?.dataset['strSaleBadge'] ?? 'מבצע',
    saleWas:   pqvDialog?.dataset['strSaleWas']   ?? 'מחיר קודם',
    halted:    pqvDialog?.dataset['strHalted']    ?? '',
    demo:      pqvDialog?.dataset['strDemo']      ?? '',
  };

  interface PQVProduct {
    // `price` is what the buyer would be charged; the rest describe the discount behind it
    // (see /api/store-product) so the struck-through original can render next to it.
    slug: string; name: string; price: number; description: string;
    basePrice?: number; isDiscounted?: boolean; percentOff?: number; showSaleBadge?: boolean;
    stock: number; images: string[];
    /** The store stopped selling (see /api/store-product). Additive — an older payload without
     *  it behaves exactly as before, and /api/checkout refuses the purchase either way. */
    storeHalted?: boolean;
    /** The store is a showcase store (same endpoint, same additive contract) — the item can be
     *  added to the cart and will never be charged (lib/demo-stores.ts#splitDemoCarts). */
    storeDemo?: boolean;
    variants: Array<{ name: string; options: string[] }>;
    variantImages?: Record<string, string>;
  }

  const pqvCache = new Map<string, PQVProduct>();

  /** The endpoint sends resolved numbers, not the discount record — rebuild the shape
   *  price-html.ts renders from (an older payload falls back to "no discount"). */
  function pqvPriceView(p: PQVProduct): PriceView {
    return {
      price: p.price,
      basePrice: p.basePrice ?? p.price,
      isDiscounted: p.isDiscounted === true,
      percentOff: p.percentOff ?? 0,
      showBadge: p.showSaleBadge !== false,
      source: p.isDiscounted ? 'product' : null,
    };
  }

  async function openProductQuickView(storeSlug: string, productSlug: string, storeName: string, newTab = false): Promise<void> {
    if (!pqvDialog || !pqvBody) return;
    pqvPrevFocus = document.activeElement as HTMLElement;

    const cacheKey = `${storeSlug}:${productSlug}`;
    let product: PQVProduct | undefined = pqvCache.get(cacheKey);

    if (!product) {
      pqvBody.innerHTML = `<div class="p-5">
        <div class="skel-bar" style="height:220px;border-radius:var(--radius);margin-bottom:1rem"></div>
        <div class="skel-bar" style="height:22px;width:60%;margin-bottom:.5rem"></div>
        <div class="skel-bar" style="height:18px;width:35%"></div>
      </div>`;
      pqvDialog.showModal();
      try {
        const res = await fetch(`/api/store-product?store=${encodeURIComponent(storeSlug)}&product=${encodeURIComponent(productSlug)}`);
        if (!res.ok) throw new Error('not found');
        product = await res.json() as PQVProduct;
        pqvCache.set(cacheKey, product);
      } catch {
        pqvBody.innerHTML = `<div class="p-5 text-center py-8 text-[color:var(--color-muted)]">${strings.error}</div>`;
        return;
      }
    } else {
      pqvDialog.showModal();
    }

    if (!product) return;
    const p = product;
    const selectedVariants: Record<string, string> = {};
    // Same "a dimension with no name or no options is not a dimension" rule as `generateCombos`
    // and `resolveSelection`. It used to default such a rubric to `''`, which reads as a chosen
    // option and is not one — and since the checkout now resolves the selection against the
    // product, that phantom key would be an extra dimension and refuse the whole purchase.
    p.variants.forEach(v => { if (v.name && v.options.length) selectedVariants[v.name] = v.options[0]!; });

    function renderDialog(): void {
      // Set once the slide carousel is wired below (only exists with >1
      // image) — a color chip's own linked photo (p.variantImages) calls this
      // the same way clicking a dot would.
      let pqvGoToImage: ((idx: number) => void) | null = null;

      const hasImages  = p.images.length > 0;
      const hasMultiple= p.images.length > 1;

      const slideClasses = 'group pqv-slide relative overflow-hidden shrink-0 w-full h-full [scroll-snap-align:start] [scroll-snap-stop:always] data-[loading]:[background:linear-gradient(90deg,var(--color-border)_25%,var(--color-bg)_50%,var(--color-border)_75%)] data-[loading]:[background-size:200%_100%] data-[loading]:animate-[skeleton-shimmer_1.3s_infinite_linear]';
      const imgClasses   = 'w-full h-full object-cover block cursor-zoom-in transition-opacity duration-[180ms] group-data-[loading]:opacity-0';
      const dotClasses   = 'pqv-dot w-1.5 h-1.5 rounded-full bg-white/70 shadow-[0_0_0_1px_rgba(0,0,0,0.25)] shrink-0 cursor-pointer pointer-events-auto transition-[width] duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] data-[active]:w-[18px] data-[active]:bg-white';

      const imgAreaHtml = hasImages
        ? `<div class="relative bg-[color:var(--color-surface)] aspect-[5/4] overflow-hidden border-b border-[color:var(--color-border)]">
             <div class="pqv-slides flex w-full h-full overflow-x-scroll overflow-y-hidden [scroll-snap-type:x_mandatory] [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [touch-action:pan-x] [overscroll-behavior-inline:contain] [&::-webkit-scrollbar]:hidden">${p.images.map((img) => `<div class="${slideClasses}" data-loading><img data-src="${pqvEsc(cdnSrc(img, 900))}" alt="${pqvEsc(p.name)}" class="${imgClasses}" loading="lazy" decoding="async" /></div>`).join('')}</div>
             ${hasMultiple ? `<div class="pqv-dots absolute bottom-[7px] left-1/2 -translate-x-1/2 flex items-center justify-center gap-1 py-1 px-2 rounded-full bg-white/15 [backdrop-filter:blur(8px)] border-[0.75px] border-white/20 z-[3] pointer-events-none" aria-hidden="true">${p.images.map((_, i) => `<span class="${dotClasses}"${i === 0 ? ' data-active' : ''}></span>`).join('')}</div>` : ''}
             ${saleBadgeHtml(pqvPriceView(p), strings.saleBadge)}
           </div>`
        : `<div class="relative bg-[color:var(--color-surface)] aspect-[5/4] overflow-hidden border-b border-[color:var(--color-border)] flex items-center justify-center text-[color:var(--color-muted)]"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>`;

      const variantsHtml = p.variants.map(v => {
        const isCv = isColorVariant(v.name);
        return `
        <div class="mb-2">
          <p class="text-[.8rem] font-semibold text-[color:var(--color-text)] mb-1.5">${pqvEsc(v.name)}</p>
          <div class="flex flex-wrap gap-1.5">
            ${v.options.map(opt => {
              const { display, hex } = resolveVariantColor(opt);
              const swatch = isCv && hex
                ? `<span aria-hidden="true" style="width:12px;height:12px;border-radius:3px;background:${hex};border:1px solid rgba(0,0,0,0.15);flex-shrink:0;display:inline-block"></span>`
                : '';
              const selected = selectedVariants[v.name] === opt;
              return `<button type="button" class="pqv-variant-opt inline-flex items-center gap-[.35rem] py-[.3rem] px-3 border-[1.5px] border-[color:var(--color-border)] rounded-[var(--radius-sm)] text-[.8rem] font-[inherit] bg-transparent cursor-pointer text-[color:var(--color-text)] transition-colors duration-[130ms] data-[selected]:border-[color:var(--color-accent)] data-[selected]:bg-[color-mix(in_srgb,var(--color-accent)_8%,transparent)] data-[selected]:text-[color:var(--color-accent)] data-[selected]:font-semibold" data-variant-name="${pqvEsc(v.name)}" data-variant-opt="${pqvEsc(opt)}"${selected ? ' data-selected' : ''}>${swatch}${pqvEsc(display)}</button>`;
            }).join('')}
          </div>
        </div>`;
      }).join('');

      const descHtml = p.description
        ? `<p dir="auto" class="text-sm text-[color:var(--color-muted)] leading-[1.65] mb-2 whitespace-pre-line" id="pqv-desc">${pqvEsc(p.description)}</p>`
        : '';

      pqvBody!.innerHTML = `<div class="animate-fade-in flex flex-col flex-1 min-h-0 overflow-hidden">
        <div class="overflow-y-auto flex-1 min-h-0 [-webkit-overflow-scrolling:touch]" data-pqv-scroll>
          ${imgAreaHtml}
          <div class="pt-3.5 px-5 pb-5">
            <a href="/${pqvEsc(storeSlug)}" class="text-xs font-bold text-[color:var(--color-muted)] no-underline tracking-[.05em] uppercase inline-block mb-1.5 transition-colors duration-[140ms] hover:text-[color:var(--color-text)]">${pqvEsc(storeName)}</a>
            <div dir="auto">
              ${p.storeDemo ? demoProductBadgeHtml(strings.demo, 'inline') : ''}
              <h2 class="text-[1.2rem] font-bold text-[color:var(--color-text)] mb-1.5" id="pqv-name">${pqvEsc(p.name)}</h2>
              <p class="text-[1.125rem] font-extrabold mb-2${pqvPriceView(p).isDiscounted ? '' : ' text-[color:var(--color-accent)]'}">${priceHtml(pqvPriceView(p), { saleLabel: strings.saleWas })}</p>
            </div>
            ${descHtml}
            ${variantsHtml}
          </div>
        </div>
        <div class="shrink-0 pt-3 px-5 pb-[1.125rem] border-t border-[color:var(--color-border)]" data-pqv-foot>
          <div class="flex items-center gap-3 mb-3"${p.storeHalted ? ' hidden' : ''}>
            <span class="text-sm text-[color:var(--color-muted)]">${pqvEsc(strings.qty)}</span>
            <div class="inline-flex items-center border border-[color:var(--color-border)] rounded-[var(--radius)] overflow-hidden h-9" dir="ltr" role="group" aria-label="${pqvEsc(strings.qty)}">
              <button type="button" class="w-[34px] h-full bg-transparent border-0 cursor-pointer text-[color:var(--color-muted)] flex items-center justify-center transition-colors duration-100 shrink-0 hover:bg-[color:var(--color-surface)] disabled:opacity-35 disabled:cursor-default" id="pqv-dec" aria-label="${pqvEsc(strings.dec)}" disabled>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <span class="min-w-7 text-center font-semibold text-sm text-[color:var(--color-text)] select-none" id="pqv-qty-val" aria-live="polite">1</span>
              <button type="button" class="w-[34px] h-full bg-transparent border-0 cursor-pointer text-[color:var(--color-muted)] flex items-center justify-center transition-colors duration-100 shrink-0 hover:bg-[color:var(--color-surface)] disabled:opacity-35 disabled:cursor-default" id="pqv-inc" aria-label="${pqvEsc(strings.inc)}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
          </div>
          ${p.storeHalted
            ? `<p class="text-center text-sm text-[color:var(--color-muted)] py-2 m-0">${pqvEsc(strings.halted)}</p>`
            : `<button type="button" class="btn btn--accent w-full h-11 flex items-center justify-center gap-[.4rem] text-[.9375rem]" id="pqv-to-payment">
            ${pqvEsc(strings.toPayment)} <svg class="inline-flex shrink-0 transition-transform duration-150 rtl:-scale-x-100" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>`}
          <a href="/${pqvEsc(storeSlug)}/${pqvEsc(p.slug)}" class="block text-center mt-2 text-xs text-[color:var(--color-muted)] no-underline hover:underline"${newTab ? ' target="_blank" rel="noopener"' : ''}>${pqvEsc(strings.viewFull)}</a>
        </div>
      </div>`;

      // The footer's upward shadow only while something is actually behind it —
      // re-wired per render because this whole subtree is rebuilt by innerHTML.
      initOverflowShadow(
        pqvBody!.querySelector<HTMLElement>('[data-pqv-scroll]'),
        pqvBody!.querySelector<HTMLElement>('[data-pqv-foot]'),
      );

      let pqvImgIdx = 0;

      // skeleton for slide images — set src after rendering so shimmer is always visible first
      const slidesEl = pqvBody!.querySelector<HTMLElement>('.pqv-slides');
      const slideEls = slidesEl ? Array.from(slidesEl.querySelectorAll<HTMLElement>('.pqv-slide')) : [];
      slideEls.forEach((slide) => {
        const img = slide.querySelector<HTMLImageElement>('img[data-src]');
        if (img && img.dataset['src']) {
          img.src = img.dataset['src'];
          img.decode()
            .then(() => slide.removeAttribute('data-loading'))
            .catch(() => slide.removeAttribute('data-loading'));
        }
      });

      const dotsEl = pqvBody!.querySelector<HTMLElement>('.pqv-dots');
      const dots   = dotsEl ? Array.from(dotsEl.querySelectorAll<HTMLElement>('.pqv-dot')) : [];

      if (slidesEl && slideEls.length > 1) {
        const isRtl = getComputedStyle(slidesEl).direction === 'rtl';
        const getSlideW = () => slidesEl.offsetWidth || 1;

        // Same "liquid" dot flow as the product-card carousel; the scroll drives
        // the dots, we only track the settled index for the lightbox.
        const { setActive } = initLiquidDots(slidesEl, dots, (idx) => { pqvImgIdx = idx; });

        function scrollToIdx(idx: number): void {
          pqvImgIdx = idx;
          slidesEl!.scrollTo({ left: (isRtl ? -1 : 1) * idx * getSlideW(), behavior: 'smooth' });
        }
        pqvGoToImage = scrollToIdx;

        dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToIdx(i)));

        // Touch — one slide at a time, no momentum skip
        let tStartX = 0, tStartScroll = 0;
        slidesEl.addEventListener('touchstart', (e: TouchEvent) => {
          tStartX = e.touches[0].clientX;
          tStartScroll = slidesEl!.scrollLeft;
          slidesEl!.style.scrollSnapType = 'none';
        }, { passive: true });
        slidesEl.addEventListener('touchend', (e: TouchEvent) => {
          const slideW = getSlideW();
          const dx = e.changedTouches[0].clientX - tStartX;
          const cur = Math.round(Math.abs(tStartScroll) / slideW);
          let tgt = cur;
          if (dx < -(slideW * 0.08)) tgt = Math.min(cur + 1, slideEls.length - 1);
          if (dx >  (slideW * 0.08)) tgt = Math.max(cur - 1, 0);
          const left = (isRtl ? -1 : 1) * tgt * slideW;
          slidesEl!.style.overflow = 'hidden';
          requestAnimationFrame(() => {
            slidesEl!.style.overflow = '';
            slidesEl!.scrollLeft = left;
            slidesEl!.style.scrollSnapType = '';
            pqvImgIdx = tgt;
            setActive(tgt);
          });
        }, { passive: true });
      }

      slidesEl?.addEventListener('click', () => {
        if (p.images.length > 0) openLightbox(p.images, pqvImgIdx, p.name);
      });
      // Hover = they're about to enlarge. Fetch the bigger render during that
      // dwell rather than after the click, when they'd be watching it arrive.
      slidesEl?.addEventListener('pointerenter', () => {
        if (p.images.length > 0) warmLightboxImage(cdnSrc(p.images[pqvImgIdx] ?? '', lightboxWidth(colbImg)));
      });

      const descEl = document.getElementById('pqv-desc');
      if (descEl) initReadMore(descEl, 2, { more: strings.showMore, less: strings.showLess });

      pqvBody!.querySelectorAll<HTMLButtonElement>('.pqv-variant-opt').forEach(btn => {
        btn.addEventListener('click', () => {
          const vName = btn.dataset['variantName'] ?? '';
          const vOpt  = btn.dataset['variantOpt']  ?? '';
          selectedVariants[vName] = vOpt;
          pqvBody!.querySelectorAll<HTMLButtonElement>(`.pqv-variant-opt[data-variant-name="${CSS.escape(vName)}"]`)
            .forEach(b => b.toggleAttribute('data-selected', b.dataset['variantOpt'] === vOpt));
          if (isColorVariant(vName)) {
            const url = p.variantImages?.[vOpt];
            const idx = url ? p.images.indexOf(url) : -1;
            if (idx !== -1) pqvGoToImage?.(idx);
          }
        });
      });

      let pqvQty = 1;
      const decBtn = document.getElementById('pqv-dec') as HTMLButtonElement | null;
      const incBtn = document.getElementById('pqv-inc') as HTMLButtonElement | null;
      const qtyVal = document.getElementById('pqv-qty-val');
      decBtn?.addEventListener('click', () => {
        if (pqvQty > 1) { pqvQty--; if (qtyVal) qtyVal.textContent = String(pqvQty); if (decBtn) decBtn.disabled = pqvQty <= 1; if (incBtn) incBtn.disabled = false; }
      });
      incBtn?.addEventListener('click', () => {
        if (pqvQty < (p.stock ?? Infinity)) { pqvQty++; if (qtyVal) qtyVal.textContent = String(pqvQty); if (decBtn) decBtn.disabled = false; if (incBtn) incBtn.disabled = pqvQty >= (p.stock ?? Infinity); }
      });

      document.getElementById('pqv-to-payment')?.addEventListener('click', () => {
        pqvDialog!.close();
        const paymentSection = document.getElementById('payment-section');
        if (paymentSection) {
          const toPaymentBtn = document.getElementById('to-payment-btn') as HTMLButtonElement | null;
          if (!paymentSection.hasAttribute('data-open')) {
            paymentSection.setAttribute('data-open', '');
            paymentSection.setAttribute('aria-hidden', 'false');
            toPaymentBtn?.setAttribute('aria-expanded', 'true');
          }
          // Same landing spot as the accordion's own handler in checkout.astro: past the button's
          // bottom, so the header line is followed by the "פרטי תשלום" heading and nothing else.
          setTimeout(() => { if (toPaymentBtn) scrollBelowPinnedChrome(toPaymentBtn, 0, 'bottom'); }, 120);
        } else {
          // Off the checkout page there is no payment section to open, so this navigates — and it
          // names the store it was pressed in, exactly as the product page and the add-to-cart
          // toast do. `?store=` pre-ticks that store on arrival; `?pay=1` still opens the payment
          // accordion once there (checkout.astro).
          window.location.href = `/checkout?store=${encodeURIComponent(storeSlug)}&pay=1`;
        }
      });
    }

    renderDialog();
  }

  // ── Lightbox ──────────────────────────────────────────────────
  const colb        = document.getElementById('co-lightbox') as HTMLDialogElement | null;
  const colbImg     = document.getElementById('co-lb-img')   as HTMLImageElement | null;
  const colbPrev    = document.getElementById('co-lb-prev')  as HTMLButtonElement | null;
  const colbNext    = document.getElementById('co-lb-next')  as HTMLButtonElement | null;
  const colbClose   = document.getElementById('co-lb-close') as HTMLButtonElement | null;
  const colbCounter = document.getElementById('co-lb-counter') as HTMLDivElement | null;
  let lbImages: string[] = [];
  let lbName = '';
  let lbIdx = 0;
  let lbTouchX = 0;
  let lbPrevFocus: HTMLElement | null = null;

  function showLbImg() {
    // The PQV slides are already loaded at 900px — open on that (softened) and
    // settle onto the full-screen render once it decodes, so the frame is never
    // black while the big one downloads.
    const src = lbImages[lbIdx] ?? '';
    const w = lightboxWidth(colbImg);
    if (colbImg) setLightboxImage(colbImg, {
      full: cdnSrc(src, w),
      preview: cdnSrc(src, 900),
      alt: lbName ? `${lbName} — ${lbIdx + 1}` : `${lbIdx + 1}`,
      neighbours: neighbourIndexes(lbImages.length, lbIdx).map(i => cdnSrc(lbImages[i] ?? '', w)),
    });
    const multi = lbImages.length > 1;
    if (colbPrev)    colbPrev.hidden    = !multi;
    if (colbNext)    colbNext.hidden    = !multi;
    if (colbCounter) { colbCounter.hidden = !multi; colbCounter.textContent = `${lbIdx + 1} / ${lbImages.length}`; }
  }

  function openLightbox(images: string[], startIdx = 0, name = '') {
    lbImages = images; lbIdx = startIdx; lbName = name;
    lbPrevFocus = document.activeElement as HTMLElement;
    showLbImg();
    // Hide the modal card beneath so it doesn't show through the lightbox
    // backdrop as a lighter patch — leaves a uniform dim over the page.
    pqvDialog?.setAttribute('data-lightbox', 'open');
    colb?.showModal();
    colbClose?.focus();
  }

  function closeLightbox() {
    colb?.close();
    pqvDialog?.removeAttribute('data-lightbox');
    resetLightboxImage(colbImg);
    lbImages = [];
    lbPrevFocus?.focus();
    lbPrevFocus = null;
  }

  colb?.addEventListener('click', closeLightbox);
  colbClose?.addEventListener('click', (e) => { e.stopPropagation(); closeLightbox(); });
  colbPrev?.addEventListener('click', (e) => { e.stopPropagation(); lbIdx = (lbIdx - 1 + lbImages.length) % lbImages.length; showLbImg(); });
  colbNext?.addEventListener('click', (e) => { e.stopPropagation(); lbIdx = (lbIdx + 1) % lbImages.length; showLbImg(); });
  colb?.addEventListener('touchstart', (e: TouchEvent) => { lbTouchX = e.touches[0].clientX; }, { passive: true });
  colb?.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - lbTouchX;
    if (Math.abs(dx) > 50) { lbIdx = dx < 0 ? (lbIdx + 1) % lbImages.length : (lbIdx - 1 + lbImages.length) % lbImages.length; showLbImg(); }
  }, { passive: true });
  document.addEventListener('keydown', (e) => {
    if (!colb?.open) return;
    if (e.key === 'Escape') { e.preventDefault(); closeLightbox(); }
    // arrowStep() mirrors the pair in RTL, so the arrow always moves the
    // gallery the way it points on screen (lib/arrow-step.ts).
    const step = arrowStep(e.key, colb);
    if (step !== 0) { lbIdx = wrapIndex(lbIdx, step, lbImages.length); showLbImg(); }
  });

  // PQV close handlers
  pqvClose?.addEventListener('click', () => pqvDialog?.close());
  pqvDialog?.addEventListener('click', (e) => { if (e.target === pqvDialog) pqvDialog.close(); });
  pqvDialog?.addEventListener('close', () => { pqvPrevFocus?.focus(); pqvPrevFocus = null; });

  // Listen for pqv:open events (dispatched by CartDrawer and others)
  window.addEventListener('pqv:open', (e: Event) => {
    const detail = (e as CustomEvent<{ storeSlug: string; productSlug: string; storeName: string; newTab?: boolean }>).detail;
    if (detail?.storeSlug && detail?.productSlug) {
      openProductQuickView(detail.storeSlug, detail.productSlug, detail.storeName ?? '', detail.newTab ?? false);
    }
  });

  // Delegate .pqv-trigger clicks (checkout page product cards)
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('.pqv-trigger');
    if (!trigger) return;
    e.preventDefault();
    const storeSlug   = trigger.dataset['storeSlug']   ?? '';
    const productSlug = trigger.dataset['productSlug'] ?? '';
    const storeName   = trigger.dataset['storeName']   ?? '';
    if (storeSlug && productSlug) openProductQuickView(storeSlug, productSlug, storeName);
  });
</script>
