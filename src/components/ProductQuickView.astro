---
import { getLang, getT } from '../i18n/index.js';
const lang = getLang(Astro.cookies);
const t    = getT(lang);
const c    = t.checkout;

const strToPayment = c.toPayment;
const strViewFull  = lang === 'he' ? 'לדף המוצר המלא' : 'View full product page';
const strQty       = lang === 'he' ? 'כמות' : 'Qty';
const strInc       = lang === 'he' ? 'הגדל' : 'Increase';
const strDec       = lang === 'he' ? 'הפחת' : 'Decrease';
const strClose     = lang === 'he' ? 'סגור' : 'Close';
const strError     = lang === 'he' ? 'שגיאה בטעינת המוצר' : 'Error loading product';
const strEnlarged  = lang === 'he' ? 'תמונה מוגדלת' : 'Enlarged image';
const strPrev      = lang === 'he' ? 'הקודמת' : 'Previous';
const strNext      = lang === 'he' ? 'הבאה' : 'Next';
---

<!-- Lightbox (native dialog → top-layer, opens above pqv-dialog) -->
<dialog id="co-lightbox" class="co-lb" aria-label={strEnlarged}>
  <div class="co-lb__panel">
    <button class="co-lb__close" id="co-lb-close" aria-label={strClose}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="co-lb__arrow co-lb__arrow--prev" id="co-lb-prev" aria-label={strPrev}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <img class="co-lb__img" id="co-lb-img" src="" alt="" width="1200" height="1200" />
    <button class="co-lb__arrow co-lb__arrow--next" id="co-lb-next" aria-label={strNext}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="co-lb__counter" id="co-lb-counter" hidden></div>
  </div>
</dialog>

<!-- Product quick-view dialog -->
<dialog
  id="pqv-dialog"
  aria-labelledby="pqv-name"
  aria-modal="true"
  data-str-to-payment={strToPayment}
  data-str-view-full={strViewFull}
  data-str-qty={strQty}
  data-str-inc={strInc}
  data-str-dec={strDec}
  data-str-error={strError}
>
  <div class="pqv-inner">
    <button class="pqv-close" id="pqv-close" aria-label={strClose} type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div id="pqv-body" class="pqv-body">
      <div class="pqv-loading">
        <div class="skel-bar" style="height:220px;border-radius:12px;margin-bottom:1rem"></div>
        <div class="skel-bar" style="height:22px;width:60%;margin-bottom:.5rem"></div>
        <div class="skel-bar" style="height:18px;width:35%"></div>
      </div>
    </div>
  </div>
</dialog>

<style is:global>
  /* ── Product quick-view dialog ─────────────── */
  #pqv-dialog {
    border: none;
    border-radius: 16px;
    padding: 0;
    width: min(540px, 94vw);
    max-height: 90dvh;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,.22);
    overscroll-behavior: contain;
    position: fixed;
    inset: 0;
    margin: auto;
  }
  #pqv-dialog::backdrop { background: rgba(0,0,0,.5); }
  #pqv-dialog { will-change: transform, opacity; contain: layout style; }
  #pqv-dialog[open] { animation: pqv-in 120ms ease-out both; }
  @keyframes pqv-in {
    from { opacity:0; transform:translateY(8px) scale(.99); }
    to   { opacity:1; transform:none; }
  }
  .pqv-content-in { animation: pqv-content-in 100ms ease-out both; }
  @keyframes pqv-content-in {
    from { opacity:0; }
    to   { opacity:1; }
  }
  .pqv-inner { position: relative; overflow-y: auto; max-height: 90dvh; }
  .pqv-close {
    position: absolute;
    inset-block-start: .75rem;
    inset-inline-end: .75rem;
    z-index: 10;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(0,0,0,.35);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 140ms;
  }
  .pqv-close:hover { background: rgba(0,0,0,.6); }
  .pqv-body { display: flex; flex-direction: column; }
  .pqv-loading { padding: 1.25rem; }
  @keyframes pqv-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .pqv-img-area {
    position: relative; background: var(--color-bg);
    aspect-ratio: 4/3; overflow: hidden;
  }
  .pqv-img-area.is-loading {
    background: linear-gradient(90deg, var(--color-border) 25%, var(--color-bg) 50%, var(--color-border) 75%);
    background-size: 200% 100%;
    animation: pqv-shimmer 1.3s infinite linear;
  }
  .pqv-main-img {
    width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; cursor: zoom-in;
    transition: opacity 0.18s;
  }
  .pqv-img-area.is-loading .pqv-main-img { opacity: 0; }
  .pqv-no-img { aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; color: var(--color-muted); }
  .pqv-thumbs {
    display: flex; gap: .375rem;
    padding: .5rem .875rem;
    overflow-x: auto; scrollbar-width: none;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .pqv-thumb {
    flex: 0 0 52px; width: 52px; height: 52px;
    border-radius: 6px; overflow: hidden;
    border: 2px solid var(--color-border);
    cursor: pointer; background: none; padding: 0;
    transition: border-color 130ms;
  }
  .pqv-thumb.is-active,
  .pqv-thumb:hover { border-color: var(--color-accent); }
  .pqv-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pqv-content { padding: 1.125rem 1.25rem 1.5rem; }
  .pqv-store-link {
    font-size: .75rem; font-weight: 700;
    color: var(--color-muted); text-decoration: none;
    letter-spacing: .05em; text-transform: uppercase;
    display: inline-block; margin-bottom: .5rem;
    transition: color 140ms;
  }
  .pqv-store-link:hover { color: var(--color-text); }
  .pqv-name { font-size: 1.2rem; font-weight: 700; color: var(--color-text); margin-bottom: .375rem; }
  .pqv-price { font-size: 1.125rem; font-weight: 800; color: var(--color-accent); margin-bottom: .875rem; }
  .pqv-desc { font-size: .875rem; color: var(--color-muted); line-height: 1.65; margin-bottom: 1rem; white-space: pre-line; }
  .pqv-variant-group { margin-bottom: .875rem; }
  .pqv-variant-label { font-size: .8rem; font-weight: 600; color: var(--color-text); margin-bottom: .375rem; }
  .pqv-variant-opts { display: flex; flex-wrap: wrap; gap: .375rem; }
  .pqv-variant-opt {
    padding: .3rem .75rem;
    border: 1.5px solid var(--color-border);
    border-radius: 6px;
    font-size: .8rem; font-family: inherit;
    background: transparent; cursor: pointer;
    color: var(--color-text);
    transition: border-color 130ms, background 130ms;
  }
  .pqv-variant-opt.is-selected {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent); font-weight: 600;
  }
  .pqv-cart-row { display: flex; align-items: center; gap: .75rem; margin-bottom: .75rem; }
  .pqv-qty { display: inline-flex; align-items: center; border: 1.5px solid var(--color-border); border-radius: 8px; overflow: hidden; }
  .pqv-qty-btn {
    width: 32px; height: 32px;
    background: transparent; border: none; cursor: pointer;
    color: var(--color-text); font-size: 1.0625rem;
    display: flex; align-items: center; justify-content: center;
    transition: background 100ms; flex-shrink: 0;
  }
  .pqv-qty-btn:hover { background: #f0f1f3; }
  .pqv-qty-btn:disabled { opacity: .35; cursor: default; }
  .pqv-qty-val {
    min-width: 30px; text-align: center; font-weight: 700;
    font-size: .875rem; color: var(--color-text);
    border-inline: 1.5px solid var(--color-border);
    line-height: 32px; user-select: none;
  }
  .pqv-qty-label { font-size: .875rem; color: var(--color-muted); }
  .pqv-to-payment { width: 100%; height: 44px; display: flex; align-items: center; justify-content: center; gap: .4rem; font-size: .9375rem; }
  .pqv-arrow { display: inline-flex; flex-shrink: 0; transition: transform 150ms; }
  [dir="rtl"] .pqv-arrow { transform: scaleX(-1); }
  .pqv-product-link { display: block; text-align: center; margin-top: .5rem; font-size: .75rem; color: var(--color-muted); text-decoration: none; }
  .pqv-product-link:hover { text-decoration: underline; }

  /* ── Lightbox ── */
  #co-lightbox { border:none;padding:0;margin:0;width:100vw;height:100vh;max-width:100vw;max-height:100vh;background:transparent;overflow:hidden; }
  #co-lightbox::backdrop { background:rgba(0,0,0,.9);cursor:zoom-out; }
  .co-lb__panel { position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:100%;padding:3rem 5rem;box-sizing:border-box;pointer-events:none; }
  .co-lb__img { max-width:100%;max-height:100%;object-fit:contain;border-radius:var(--radius);display:block;box-shadow:0 8px 48px rgba(0,0,0,.5);user-select:none;-webkit-user-drag:none;pointer-events:none; }
  .co-lb__close { position:absolute;top:1rem;right:1.25rem;z-index:2;width:36px;height:36px;border-radius:var(--radius);border:none;background:rgba(255,255,255,.1);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .1s;pointer-events:all; }
  .co-lb__close:hover { background:rgba(255,255,255,.2); }
  .co-lb__arrow { position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:40px;height:40px;border-radius:var(--radius);border:none;background:rgba(255,255,255,.1);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .1s;pointer-events:all; }
  .co-lb__arrow:hover { background:rgba(255,255,255,.2); }
  .co-lb__arrow--prev { left:1.25rem; }
  .co-lb__arrow--next { right:1.25rem; }
  .co-lb__counter { position:absolute;bottom:1.25rem;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.6);font-size:.78rem;font-weight:.5;letter-spacing:.04em;pointer-events:none; }
  @media(max-width:600px){.co-lb__panel{padding:3.5rem 2.5rem;}.co-lb__arrow--prev{left:.5rem;}.co-lb__arrow--next{right:.5rem;}}
</style>

<script>
  import { formatPrice } from '../config/store.config.js';

  const pqvDialog = document.getElementById('pqv-dialog') as HTMLDialogElement | null;
  const pqvBody   = document.getElementById('pqv-body');
  const pqvClose  = document.getElementById('pqv-close');
  let   pqvPrevFocus: HTMLElement | null = null;

  const strings = {
    toPayment: pqvDialog?.dataset['strToPayment'] ?? 'לתשלום',
    viewFull:  pqvDialog?.dataset['strViewFull']  ?? 'לדף המוצר המלא',
    qty:       pqvDialog?.dataset['strQty']       ?? 'כמות',
    inc:       pqvDialog?.dataset['strInc']       ?? 'הגדל',
    dec:       pqvDialog?.dataset['strDec']       ?? 'הפחת',
    error:     pqvDialog?.dataset['strError']     ?? 'שגיאה בטעינת המוצר',
  };

  function pqvEsc(s: unknown): string {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  interface PQVProduct {
    slug: string; name: string; price: number; description: string;
    stock: number; images: string[];
    variants: Array<{ name: string; options: string[] }>;
  }

  const pqvCache = new Map<string, PQVProduct>();

  async function openProductQuickView(storeSlug: string, productSlug: string, storeName: string, newTab = false): Promise<void> {
    if (!pqvDialog || !pqvBody) return;
    pqvPrevFocus = document.activeElement as HTMLElement;

    const cacheKey = `${storeSlug}:${productSlug}`;
    let product: PQVProduct | undefined = pqvCache.get(cacheKey);

    if (!product) {
      pqvBody.innerHTML = `<div class="pqv-loading">
        <div class="skel-bar" style="height:220px;border-radius:12px;margin-bottom:1rem"></div>
        <div class="skel-bar" style="height:22px;width:60%;margin-bottom:.5rem"></div>
        <div class="skel-bar" style="height:18px;width:35%"></div>
      </div>`;
      pqvDialog.showModal();
      try {
        const res = await fetch(`/api/store-product?store=${encodeURIComponent(storeSlug)}&product=${encodeURIComponent(productSlug)}`);
        if (!res.ok) throw new Error('not found');
        product = await res.json() as PQVProduct;
        pqvCache.set(cacheKey, product);
      } catch {
        pqvBody.innerHTML = `<div class="pqv-loading" style="text-align:center;padding:2rem;color:var(--color-muted)">${strings.error}</div>`;
        return;
      }
    } else {
      pqvDialog.showModal();
    }

    if (!product) return;
    const p = product;
    const selectedVariants: Record<string, string> = {};
    p.variants.forEach(v => { selectedVariants[v.name] = v.options[0] ?? ''; });

    function renderDialog(): void {
      const mainImg    = p.images[0] ?? '';
      const hasImages  = p.images.length > 0;
      const hasMultiple= p.images.length > 1;

      const imgAreaHtml = hasImages
        ? `<div class="pqv-img-area is-loading"><img id="pqv-main-img" data-src="${pqvEsc(mainImg)}" alt="${pqvEsc(p.name)}" class="pqv-main-img" /></div>`
        : `<div class="pqv-img-area pqv-no-img"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>`;

      const thumbsHtml = hasMultiple
        ? `<div class="pqv-thumbs">${p.images.map((img, i) => `<button type="button" class="pqv-thumb ${i === 0 ? 'is-active' : ''}" data-idx="${i}" data-src="${pqvEsc(img)}"><img src="${pqvEsc(img)}" alt="" width="52" height="52" loading="lazy" /></button>`).join('')}</div>`
        : '';

      const variantsHtml = p.variants.map(v => `
        <div class="pqv-variant-group">
          <p class="pqv-variant-label">${pqvEsc(v.name)}</p>
          <div class="pqv-variant-opts">
            ${v.options.map(opt => `<button type="button" class="pqv-variant-opt ${selectedVariants[v.name] === opt ? 'is-selected' : ''}" data-variant-name="${pqvEsc(v.name)}" data-variant-opt="${pqvEsc(opt)}">${pqvEsc(opt)}</button>`).join('')}
          </div>
        </div>`).join('');

      pqvBody!.innerHTML = `<div class="pqv-content-in">
        ${imgAreaHtml}
        ${thumbsHtml}
        <div class="pqv-content">
          <a href="/store/${pqvEsc(storeSlug)}" class="pqv-store-link">${pqvEsc(storeName)}</a>
          <h2 class="pqv-name" id="pqv-name">${pqvEsc(p.name)}</h2>
          <p class="pqv-price">${formatPrice(p.price)}</p>
          ${p.description ? `<p class="pqv-desc">${pqvEsc(p.description)}</p>` : ''}
          ${variantsHtml}
          <div class="pqv-cart-row">
            <span class="pqv-qty-label">${pqvEsc(strings.qty)}</span>
            <div class="pqv-qty" dir="ltr" role="group" aria-label="${pqvEsc(strings.qty)}">
              <button type="button" class="pqv-qty-btn" id="pqv-dec" aria-label="${pqvEsc(strings.dec)}" disabled>−</button>
              <span class="pqv-qty-val" id="pqv-qty-val" aria-live="polite">1</span>
              <button type="button" class="pqv-qty-btn" id="pqv-inc" aria-label="${pqvEsc(strings.inc)}">+</button>
            </div>
          </div>
          <button type="button" class="btn btn--accent pqv-to-payment" id="pqv-to-payment">
            ${pqvEsc(strings.toPayment)} <svg class="pqv-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <a href="/store/${pqvEsc(storeSlug)}/${pqvEsc(p.slug)}" class="pqv-product-link"${newTab ? ' target="_blank" rel="noopener"' : ''}>${pqvEsc(strings.viewFull)}</a>
        </div>
      </div>`;

      let pqvImgIdx = 0;

      // skeleton for main image — set src after rendering so shimmer is always visible first
      const pqvImgArea = pqvBody!.querySelector<HTMLElement>('.pqv-img-area');
      const pqvMainImg = document.getElementById('pqv-main-img') as HTMLImageElement | null;
      if (pqvImgArea && pqvMainImg && pqvMainImg.dataset['src']) {
        pqvMainImg.src = pqvMainImg.dataset['src'];
        pqvMainImg.decode()
          .then(() => pqvImgArea.classList.remove('is-loading'))
          .catch(() => pqvImgArea.classList.remove('is-loading'));
      }

      pqvBody!.querySelectorAll<HTMLButtonElement>('.pqv-thumb').forEach(btn => {
        btn.addEventListener('click', () => {
          const src = btn.dataset['src'] ?? '';
          pqvImgIdx = parseInt(btn.dataset['idx'] ?? '0', 10);
          const mainImgEl = document.getElementById('pqv-main-img') as HTMLImageElement | null;
          const imgArea   = pqvBody!.querySelector<HTMLElement>('.pqv-img-area');
          if (mainImgEl && imgArea) {
            imgArea.classList.add('is-loading');
            mainImgEl.src = src;
            mainImgEl.decode()
              .then(() => imgArea.classList.remove('is-loading'))
              .catch(() => imgArea.classList.remove('is-loading'));
          }
          pqvBody!.querySelectorAll('.pqv-thumb').forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
        });
      });

      document.getElementById('pqv-main-img')?.addEventListener('click', () => {
        if (p.images.length > 0) openLightbox(p.images, pqvImgIdx, p.name);
      });

      pqvBody!.querySelectorAll<HTMLButtonElement>('.pqv-variant-opt').forEach(btn => {
        btn.addEventListener('click', () => {
          const vName = btn.dataset['variantName'] ?? '';
          const vOpt  = btn.dataset['variantOpt']  ?? '';
          selectedVariants[vName] = vOpt;
          pqvBody!.querySelectorAll<HTMLButtonElement>(`.pqv-variant-opt[data-variant-name="${CSS.escape(vName)}"]`)
            .forEach(b => b.classList.toggle('is-selected', b.dataset['variantOpt'] === vOpt));
        });
      });

      let pqvQty = 1;
      const decBtn = document.getElementById('pqv-dec') as HTMLButtonElement | null;
      const incBtn = document.getElementById('pqv-inc') as HTMLButtonElement | null;
      const qtyVal = document.getElementById('pqv-qty-val');
      decBtn?.addEventListener('click', () => {
        if (pqvQty > 1) { pqvQty--; if (qtyVal) qtyVal.textContent = String(pqvQty); if (decBtn) decBtn.disabled = pqvQty <= 1; if (incBtn) incBtn.disabled = false; }
      });
      incBtn?.addEventListener('click', () => {
        if (pqvQty < (p.stock ?? Infinity)) { pqvQty++; if (qtyVal) qtyVal.textContent = String(pqvQty); if (decBtn) decBtn.disabled = false; if (incBtn) incBtn.disabled = pqvQty >= (p.stock ?? Infinity); }
      });

      document.getElementById('pqv-to-payment')?.addEventListener('click', () => {
        pqvDialog!.close();
        const paymentSection = document.getElementById('payment-section');
        if (paymentSection) {
          const toPaymentBtn = document.getElementById('to-payment-btn') as HTMLButtonElement | null;
          if (!paymentSection.classList.contains('is-open')) {
            paymentSection.classList.add('is-open');
            paymentSection.setAttribute('aria-hidden', 'false');
            toPaymentBtn?.setAttribute('aria-expanded', 'true');
          }
          setTimeout(() => toPaymentBtn?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 120);
        } else {
          window.location.href = '/checkout?pay=1';
        }
      });
    }

    renderDialog();
  }

  // ── Lightbox ──────────────────────────────────────────────────
  const colb        = document.getElementById('co-lightbox') as HTMLDialogElement | null;
  const colbImg     = document.getElementById('co-lb-img')   as HTMLImageElement | null;
  const colbPrev    = document.getElementById('co-lb-prev')  as HTMLButtonElement | null;
  const colbNext    = document.getElementById('co-lb-next')  as HTMLButtonElement | null;
  const colbClose   = document.getElementById('co-lb-close') as HTMLButtonElement | null;
  const colbCounter = document.getElementById('co-lb-counter') as HTMLDivElement | null;
  let lbImages: string[] = [];
  let lbName = '';
  let lbIdx = 0;
  let lbTouchX = 0;
  let lbPrevFocus: HTMLElement | null = null;

  function showLbImg() {
    const url = lbImages[lbIdx] ?? '';
    if (colbImg) { colbImg.src = url; colbImg.alt = lbName ? `${lbName} — ${lbIdx + 1}` : `${lbIdx + 1}`; }
    const multi = lbImages.length > 1;
    if (colbPrev)    colbPrev.hidden    = !multi;
    if (colbNext)    colbNext.hidden    = !multi;
    if (colbCounter) { colbCounter.hidden = !multi; colbCounter.textContent = `${lbIdx + 1} / ${lbImages.length}`; }
  }

  function openLightbox(images: string[], startIdx = 0, name = '') {
    lbImages = images; lbIdx = startIdx; lbName = name;
    lbPrevFocus = document.activeElement as HTMLElement;
    showLbImg();
    colb?.showModal();
    colbClose?.focus();
  }

  function closeLightbox() {
    colb?.close();
    lbImages = [];
    lbPrevFocus?.focus();
    lbPrevFocus = null;
  }

  colb?.addEventListener('click', closeLightbox);
  colbClose?.addEventListener('click', (e) => { e.stopPropagation(); closeLightbox(); });
  colbPrev?.addEventListener('click', (e) => { e.stopPropagation(); lbIdx = (lbIdx - 1 + lbImages.length) % lbImages.length; showLbImg(); });
  colbNext?.addEventListener('click', (e) => { e.stopPropagation(); lbIdx = (lbIdx + 1) % lbImages.length; showLbImg(); });
  colb?.addEventListener('touchstart', (e: TouchEvent) => { lbTouchX = e.touches[0].clientX; }, { passive: true });
  colb?.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - lbTouchX;
    if (Math.abs(dx) > 50) { lbIdx = dx < 0 ? (lbIdx + 1) % lbImages.length : (lbIdx - 1 + lbImages.length) % lbImages.length; showLbImg(); }
  }, { passive: true });
  document.addEventListener('keydown', (e) => {
    if (!colb?.open) return;
    if (e.key === 'Escape') { e.preventDefault(); closeLightbox(); }
    if (e.key === 'ArrowLeft')  { lbIdx = (lbIdx - 1 + lbImages.length) % lbImages.length; showLbImg(); }
    if (e.key === 'ArrowRight') { lbIdx = (lbIdx + 1) % lbImages.length; showLbImg(); }
  });

  // PQV close handlers
  pqvClose?.addEventListener('click', () => pqvDialog?.close());
  pqvDialog?.addEventListener('click', (e) => { if (e.target === pqvDialog) pqvDialog.close(); });
  pqvDialog?.addEventListener('close', () => { pqvPrevFocus?.focus(); pqvPrevFocus = null; });

  // Listen for pqv:open events (dispatched by CartDrawer and others)
  window.addEventListener('pqv:open', (e: Event) => {
    const detail = (e as CustomEvent<{ storeSlug: string; productSlug: string; storeName: string; newTab?: boolean }>).detail;
    if (detail?.storeSlug && detail?.productSlug) {
      openProductQuickView(detail.storeSlug, detail.productSlug, detail.storeName ?? '', detail.newTab ?? false);
    }
  });

  // Delegate .pqv-trigger clicks (checkout page product cards)
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('.pqv-trigger');
    if (!trigger) return;
    e.preventDefault();
    const storeSlug   = trigger.dataset['storeSlug']   ?? '';
    const productSlug = trigger.dataset['productSlug'] ?? '';
    const storeName   = trigger.dataset['storeName']   ?? '';
    if (storeSlug && productSlug) openProductQuickView(storeSlug, productSlug, storeName);
  });
</script>
