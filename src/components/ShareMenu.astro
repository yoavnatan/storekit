---
import { getT, type Lang } from '../i18n/index.js';
import { SHARE_CHANNELS, shareChannelUrl } from '../lib/share.js';

interface Props {
  /** Absolute canonical URL of the thing being shared — the seller's own domain when the store
   *  has one. Never a filtered/paginated/ad-landing URL; see lib/share.ts's header. */
  url: string;
  /** Plain text naming it: a store name, or "<product> · <store>". */
  title: string;
  lang: Lang;
  /** What is being shared — carried into the `share` analytics event, nothing else. */
  contentType: 'store' | 'product';
  /** The store this share belongs to (`store_id`, the key every dataLayer event on this site
   *  already carries). */
  storeId: string;
  /** The product's CATALOG id (`lib/ad-item-id.ts`) when sharing a product — the same string the
   *  feed and every other ad event use for it, so `share` joins to the same item instead of
   *  becoming a second spelling of it. A share link never carries a variant selection, so this is
   *  the bare product id. Omitted for a store: `item_id` is then not sent at all rather than sent
   *  empty (see `reportable` in lib/tracking.ts for why an empty id is worse than none). */
  itemId?: string;
  /** Class for the trigger, so the button belongs to the row it sits in rather than importing a
   *  second button style into it (store banner: `store-banner-action-btn`; product page: the
   *  wishlist button's plain text treatment). */
  buttonClass?: string;
  /** Inline style for the trigger, same reason. */
  buttonStyle?: string;
  /** Which edge the panel hangs from. `start` under a left-most control in RTL terms, `end` when
   *  the trigger sits at the row's end and a start-aligned panel would overflow the viewport. */
  align?: 'start' | 'end';
}

/**
 * Share this page — WhatsApp / Facebook / Telegram / email / copy link, plus the OS share sheet
 * where one exists.
 *
 * **Every channel is a real `<a href>`, rendered on the server.** Not a JS click handler that
 * builds the URL: this is a link to somewhere else, so it must work with no JS, be middle-clickable
 * and show its destination in the status bar like any other link. The only two items that cannot
 * be links are the two that aren't navigations — copy (clipboard) and the native sheet — and both
 * are `<button>`s, with the native one hidden until the script confirms `navigator.share` exists.
 *
 * **The icons are monochrome `currentColor`, including the brand glyphs, and that is a decision.**
 * WhatsApp green is not free here: `--color-sale` is the site's one green and it means "this price
 * dropped" (design line, test 4 — an accent has ONE job). A share menu that spends it on a brand
 * mark teaches the shopper that green means nothing in particular. The glyphs are recognisable by
 * SHAPE at 15px, which is how anyone reads them in a share sheet anyway.
 *
 * **What makes the link look good on the other end is not in this file.** WhatsApp, Facebook and
 * Telegram all render the card from the shared page's own Open Graph tags — `Seo.astro` — so a
 * missing `og:image` there is a share feature that ships broken while every button here works.
 */
const { url, title, lang, contentType, storeId, itemId, buttonClass = '', buttonStyle, align = 'start' } = Astro.props;
const t = getT(lang).share;

const CHANNEL_LABEL: Record<(typeof SHARE_CHANNELS)[number], string> = {
  whatsapp: t.whatsapp,
  facebook: t.facebook,
  telegram: t.telegram,
  email: t.email,
};

/** `nofollow` because these are share widgets, not endorsements: every product and store page on
 *  the platform emits four outbound links to the same four hosts, each carrying the page's own URL
 *  as a query parameter. None of that is worth a crawler's time on the most-indexed page type the
 *  site has. `noopener noreferrer` is the ordinary `target=_blank` hygiene. */
const SHARE_LINK_REL = 'nofollow noopener noreferrer';

const ITEM_CLASS =
  'flex items-center gap-2.5 w-full px-3 py-[0.45rem] text-sm text-start rounded-[var(--radius-sm)] ' +
  'transition-colors duration-100 hover:bg-[var(--color-bg)] focus-visible:bg-[var(--color-bg)] ' +
  'text-[color:var(--color-text)] cursor-pointer';
---

<div
  class="share-menu"
  data-share-menu
  data-share-url={url}
  data-share-title={title}
  data-share-content-type={contentType}
  data-share-store-id={storeId}
  data-share-item-id={itemId}
  style="position:relative;display:flex;align-items:center"
>
  <button
    type="button"
    class={buttonClass}
    style={buttonStyle}
    data-share-trigger
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={t.buttonLabel}
  >
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
      <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
    </svg>
    <span>{t.button}</span>
  </button>

  {/* z-45, not a smaller number: on the store page the sticky filter toolbar below the banner is
      z-index:40 and painted straight through this panel while it was z-30 (the same trap
      `.store-details__content` documents in store.css). 45 also keeps it UNDER the fixed site
      header at 50, which is right — a panel anchored to page content should slide beneath the
      header, not over it. */}
  <div
    data-share-panel
    role="menu"
    aria-label={t.buttonLabel}
    hidden
    class="absolute top-full z-[45] mt-1 p-[0.3rem] rounded-[var(--radius)] border [border-color:var(--color-border)] bg-[color:var(--color-surface)] shadow-[var(--shadow-card)] animate-product-menu-open"
    style={`${align === 'end' ? 'inset-inline-end:0' : 'inset-inline-start:0'};min-width:12rem;max-width:calc(100vw - 1.5rem)`}
  >
    {SHARE_CHANNELS.map((channel) => (
      <a
        role="menuitem"
        href={shareChannelUrl(channel, { url, title })}
        target={channel === 'email' ? undefined : '_blank'}
        rel={SHARE_LINK_REL}
        data-share-channel={channel}
        class={ITEM_CLASS}
      >
        {channel === 'whatsapp' && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
        )}
        {channel === 'facebook' && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
            <path d="M22.675 0h-21.35C.595 0 0 .593 0 1.325v21.351C0 23.407.595 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/>
          </svg>
        )}
        {channel === 'telegram' && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        )}
        {channel === 'email' && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>
          </svg>
        )}
        <span>{CHANNEL_LABEL[channel]}</span>
      </a>
    ))}

    <button type="button" role="menuitem" data-share-copy class={ITEM_CLASS} data-str-copied={t.copied}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
      <span>{t.copyLink}</span>
    </button>

    {/* Shown only where `navigator.share` exists — i.e. a phone, where it opens the OS sheet with
        SMS, Instagram, AirDrop and everything else installed. On a desktop browser without it the
        item never appears rather than appearing and failing. */}
    <button type="button" role="menuitem" data-share-native hidden class={ITEM_CLASS}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><line x1="12" y1="2" x2="12" y2="15"/>
      </svg>
      <span>{t.more}</span>
    </button>
  </div>
</div>

<script>
  import { initShareMenus } from '../scripts/share-menu.js';
  initShareMenus();
</script>
