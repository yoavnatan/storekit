---
/**
 * The artwork behind `lib/category-icons.ts` — one inline SVG per platform
 * category (no emoji, per Hard rules; `currentColor` so a chip and a shelf
 * heading tint it themselves).
 *
 * `set:html` here is a lookup into a const record defined in this file — never a
 * category label, and never anything a seller typed. The label only ever chooses
 * WHICH constant renders.
 */
import { categoryIconKey, type CategoryIconKey } from '../lib/category-icons.js';

interface Props {
  /** Category label; resolved to an icon (incl. the seed-inheritance fallback). */
  label?: string;
  /** Or name the icon outright — the "all" chip has no category to resolve from. */
  name?: CategoryIconKey;
  /** Rendered box in px. 15 suits a chip; a shelf heading passes a larger one. */
  size?: number;
  class?: string;
}

const { label, name, size = 15, class: className } = Astro.props;
const key: CategoryIconKey = name ?? categoryIconKey(label ?? '');

const ART: Readonly<Record<CategoryIconKey, string>> = {
  /* A HANGER for אופנה and the t-shirt for בגדים, and the swap is deliberate: they are two shelves
     now (`store-taxonomy.ts` argues why), so they need two glyphs a shopper can tell apart at 15px.
     The garment is the specific one, and a hanger reads as the shop rather than the item — which is
     the difference between the two shelves. */
  fashion: '<path d="M12 2a2 2 0 0 0-2 2 2 2 0 0 0 2 2v2"/><path d="m12 8-8.4 6.1A1.5 1.5 0 0 0 4.5 17h15a1.5 1.5 0 0 0 .9-2.9L12 8Z"/>',
  clothing: '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23Z"/>',
  footwear: '<path d="M2 17v-6a1 1 0 0 1 1-1h3l2 2h3l4-3 3.6 3.6A5 5 0 0 1 20 16.1V17a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1Z"/><path d="M2 14.5h6"/>',
  bag: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  jewelry: '<path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/>',
  beauty: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/><path d="M5 3v3"/><path d="M3.5 4.5h3"/><path d="M19 18v3"/><path d="M17.5 19.5h3"/>',
  electronics: '<path d="M9 2v6"/><path d="M15 2v6"/><path d="M5.5 8h13v3a6.5 6.5 0 0 1-13 0Z"/><path d="M12 17.5V22"/>',
  accessories: '<circle cx="6" cy="15" r="4"/><circle cx="18" cy="15" r="4"/><path d="M10 15a2 2 0 0 1 4 0"/><path d="M2.5 13 5 7.4A3 3 0 0 1 7.8 5.5"/><path d="M21.5 13 19 7.4a3 3 0 0 0-2.8-1.9"/>',
  // The chimney is drawn open-ended (up the left side, over the top, back down) so
  // its bottom edge disappears into the roof stroke instead of boxing itself off.
  home: '<path d="M3 10a2 2 0 0 1 .7-1.5l7-6a2 2 0 0 1 2.6 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M15.2 4.2V2.4a.5.5 0 0 1 .5-.5h1.8a.5.5 0 0 1 .5.5v3.9"/><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>',
  kitchen: '<path d="M3 2v7a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2V2"/><path d="M6 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2h3Zm0 0v7"/>',
  furniture: '<path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 11v5a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-4 0Z"/><path d="M5 18v2"/><path d="M19 18v2"/>',
  sports: '<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>',
  food: '<path d="M12 20.9c1.5 0 2.7 1.1 4 1.1 3 0 6-8 6-12.2A4.9 4.9 0 0 0 17 5c-2.2 0-4 1.4-5 2-1-.6-2.8-2-5-2a4.9 4.9 0 0 0-5 4.8C2 14 5 22 8 22c1.2 0 2.5-1.1 4-1.1Z"/><path d="M10 2c1 .5 2 2 2 5"/>',
  toys: '<circle cx="12" cy="14.5" r="6.5"/><circle cx="5.6" cy="6.6" r="2.9"/><circle cx="18.4" cy="6.6" r="2.9"/><path d="M9.8 13.5h.01"/><path d="M14.2 13.5h.01"/><path d="M9.8 17a3.4 3.4 0 0 0 4.4 0"/>',
  baby: '<path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5S14.6 8 13.5 8c-.8 0-1.5-.4-1.5-1"/>',
  pets: '<circle cx="11" cy="4.5" r="2"/><circle cx="18" cy="8.5" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10.5a5 5 0 0 1 5 5V19a3.5 3.5 0 0 1-6.8 1Q6.5 18 4.5 17.3a3.5 3.5 0 0 1 1-6.8Z"/>',
  books: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3Z"/>',
  tools: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"/>',
  car: '<path d="M19 17h2a1 1 0 0 0 1-1v-3c0-.9-.7-1.7-1.5-1.9L16 10s-1.3-1.4-2.2-2.3A2.6 2.6 0 0 0 12 7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4a1 1 0 0 0 1 1h2"/><path d="M9 17h6"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10.5 3 12 6.5 12 8c0-1.5 1.5-5 4.5-5a2.5 2.5 0 0 1 0 5"/>',
  store: '<path d="m2 7 4.4-4.4A2 2 0 0 1 7.8 2h8.4a2 2 0 0 1 1.4.6L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20v3a2.6 2.6 0 0 1-4.5 1.8 2.6 2.6 0 0 1-3.5 0 2.6 2.6 0 0 1-3.5 0A2.6 2.6 0 0 1 2 10Z"/>',
  plants: '<path d="M6.5 15.5h11l-1 5.6a1 1 0 0 1-1 .9H8.5a1 1 0 0 1-1-.9Z"/><path d="M12 15.5V9"/><path d="M12 12.5C9.2 12.5 7 10.3 7 7.5c2.8 0 5 2.2 5 5Z"/><path d="M12 10.5c0-2.8 2.2-5 5-5 0 2.8-2.2 5-5 5Z"/>',
  garden: '<path d="M3 12h10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M6 12V9.8a2.5 2.5 0 0 1 5 0V12"/><path d="m13 14.5 5.5-4"/><path d="m16.8 8.2 3.4 2.6"/>',
  // Star of David rather than a menorah: at 15px a 7-branch candelabrum collapses
  // into a smudge, while the star stays readable at any size.
  judaica: '<path d="M12 3 20.7 18H3.3Z"/><path d="M12 21 3.3 6h17.4Z"/>',
  computers: '<path d="M4 16V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v9"/><path d="M2.6 16h18.8l-1 2.4a1 1 0 0 1-.9.6H4.5a1 1 0 0 1-.9-.6Z"/>',
  phone: '<rect x="6.5" y="2" width="11" height="20" rx="2.5"/><path d="M10.5 5.5h3"/><path d="M10.5 18.5h3"/>',
  flowers: '<path d="M12 2.5c-2.6 0-4.5 2-4.5 4.5 0 2.9 2 5.2 4.5 6.82.5-1.6 4.5-3.9 4.5-6.8 0-2.5-1.9-4.5-4.5-4.5Z"/><path d="M12 13.8V22"/><path d="M12 18.5c-2.7 0-4.3-1.6-4.3-3.8 2.7 0 4.3 1.6 4.3 3.8Z"/>',
  // A balloon, not a child figure (would read as an account avatar) and not a kite
  // (its diamond body collides with the jewelry gem at chip size).
  kids: '<path d="M12 2.5a5.5 5.5 0 0 1 5.5 5.5c0 3.9-3.3 7-5.5 7S6.5 11.9 6.5 8A5.5 5.5 0 0 1 12 2.5Z"/><path d="m10.7 14.7 1.3 1.8 1.3-1.8"/><path d="M12 16.5c0 2.6 3.2 2 3.2 4.2"/>',
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  nature: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/>',
  cleaning: '<path d="M8 9h6a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/><path d="M9.5 9V5.5a1.5 1.5 0 0 1 1.5-1.5h1.5"/><path d="M12.5 4h4.5l-2 3.2"/><path d="M19.5 3h.01"/><path d="M21 5.5h.01"/><path d="M18.8 7h.01"/>',
  // A takeaway cup. The lid deliberately OVERHANGS the body and there's a sleeve
  // band across the middle — without those two it reads as the plant pot.
  disposables: '<path d="M4 6h16l-.9-2.3a1 1 0 0 0-.9-.7H5.8a1 1 0 0 0-.9.7Z"/><path d="M5.6 6h12.8l-1.3 14.7a1.5 1.5 0 0 1-1.5 1.3H8.4a1.5 1.5 0 0 1-1.5-1.3Z"/><path d="M6.6 12.6h10.8"/>',
  all: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  default: '<path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4Z"/><path d="M7.5 7.5h.01"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  style="flex-shrink:0"
  set:html={ART[key]}
/>
