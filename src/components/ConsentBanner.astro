---
/** The cookie NOTICE — a statement, not a request.
 *
 *  **Read `lib/consent.ts` before changing anything here.** The short version: Israeli law has no
 *  cookie-banner duty and no opt-in requirement, and with clear disclosure in the privacy policy
 *  consent may be implied from conduct. So cookies run from the first visit, this bar says that
 *  they do, and the detail plus the off-switch live in `/privacy`. That is the Israeli practice,
 *  and it replaced a first version of this component that implemented the European one (owner,
 *  2026-08-25: *"הלכת רחוק מדי"*).
 *
 *  **There is no reject button and no settings button on this bar, deliberately** — *"שלא יהיה שם
 *  כפתור כיבוי (כל עוד זה חוקי) פשוט שקל ללחוץ עליו"*. The parenthesis is the constraint, and it
 *  is a real one: what keeps conduct-based consent lawful is that the disclosure is complete and
 *  the control is genuinely reachable. It is, in the cookies clause of `/privacy`, which the footer
 *  links from every page — one level in, never hidden. **Do not remove the link to the policy from
 *  this bar.** Without it the notice stops being a notice and the arrangement loses the thing that
 *  makes it defensible.
 *
 *  **It is rendered on every page and starts HIDDEN, always**, then its script shows it if nobody
 *  has dismissed it. Default-hidden is the rule for every injected overlay here (memory
 *  `project_injected_overlay_flash`), and it matters more than usual on this one: a bar that
 *  flashes for a returning visitor who already dismissed it reads as the site having forgotten
 *  them.
 *
 *  **No shadow** — it is pinned to the viewport edge, and a bar says which layer it is on with a
 *  border and a fill (the elevation rule, base/tokens.css). Header and store filter row, same call.
 */
import { getLang, getT } from '../i18n/index.js';
import { CONSENT_COOKIE, parseConsent } from '../lib/consent.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const c = t.consent;

/** Never notified → the bar shows on load. Note this is `parseConsent` and NOT `effectiveConsent`:
 *  the question here is "has this visitor been told", which is a different question from "what may
 *  run", and the tags are already running either way. */
const notified = parseConsent(Astro.cookies.get(CONSENT_COOKIE)?.value) !== null;
---

{/* `role="region"` + a label, not `role="dialog"`: it traps nothing, blocks nothing and demands
    nothing, and announcing a dialog that does not behave like one is worse for a screen reader
    than announcing a landmark that does. No `aria-live` — the bar is in the DOM from first paint,
    so there is no insertion for a live region to announce. */}
{/* `py-1.5` on a phone, `py-2.5` from `sm` up. The owner's wording cannot fit one line at 375px —
    68 characters against roughly 280px of usable width — so the bar is two lines there no matter
    what, and what is left to control is what those two lines COST. Padding, leading and type size
    are the three, and each is tightened only below `sm`, which is the only place a second line
    exists. (This comment lives ABOVE the tag on purpose: a JSX comment between attributes does not
    parse, and the compile error it produces names a Fragment on a line 50 rows away.) */}
<div
  id="consent-notice"
  class="!hidden fixed bottom-0 inset-x-0 z-[60] border-t [border-color:var(--color-border)] [background:var(--color-surface)] py-1.5 sm:py-2.5" data-bottom-bar
  data-consent-show={notified ? undefined : ''}
  role="region"
  aria-label={c.title}
>
  {/* Does NOT wrap, and the button never drops to a line of its own. Wrapping cost a whole extra
      row at 375px — the text took two lines, the button took a third, and the bar stood 103px tall
      over a 780px viewport. Text takes the remaining width (`flex-1 min-w-0`) and the button holds
      its own (`shrink-0`), so the bar is as tall as the text and no taller. */}
  <div class="container flex items-center gap-2 sm:gap-3">
    <p class="muted m-0 min-w-0 flex-1 text-[0.76rem] leading-snug sm:text-[0.82rem] sm:leading-relaxed">
      {c.body}{' '}
      {/* `whitespace-nowrap`: at 375px "פרטים ואפשרויות" broke across the line end and left
          "ואפשרויות" alone on a line of its own — a two-word link split in half reads as two
          links, and it is the one thing on this bar a person is meant to be able to aim at. */}
      <a href="/privacy" class="underline whitespace-nowrap">{c.more}</a>
    </p>
    {/* ONE button, two faces. On a phone it is a 28px ×, which hands its ~54px back to the text and
        is the difference between a second line that is nearly full and one carrying three words;
        from `sm` up, where the whole notice fits on one line anyway, it says "הבנתי", because a
        word is a clearer target than a glyph when there is room for it. Not two buttons: one
        element, one id, one `aria-label` — the accessible name is the same at every width, so a
        screen reader is never told a different thing by the viewport. */}
    <button
      type="button"
      class="btn btn--ghost btn--sm shrink-0 !px-2 sm:!px-3"
      id="consent-dismiss"
    >
      <svg class="sm:hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      {/* `sr-only sm:not-sr-only`, NOT `hidden sm:inline`, and there is deliberately no `aria-label`
          on the button. Two rules meet here and only this spelling satisfies both. `display:none`
          text is not in the accessible name, so a phone would get a nameless icon button — which is
          why the first draft carried an `aria-label`. But an `aria-label` OVERRIDES the visible
          text, so from `sm` up the button would read "הבנתי" and announce "סגירת ההודעה": a
          different name from the visible label, which is WCAG 2.5.3 Label in Name, level AA — the
          exact level `/accessibility` states in public that this site meets. Keeping the word in
          the accessible tree at every width makes the name "הבנתי" always, and identical to the
          label wherever the label is visible. */}
      <span class="sr-only sm:not-sr-only">{c.dismiss}</span>
    </button>
  </div>
</div>

<script>
  import { initConsentNotice } from '../scripts/consent.js';
  initConsentNotice();
</script>
