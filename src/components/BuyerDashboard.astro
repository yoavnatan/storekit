---
interface Props {
  hasStore?: boolean;
  sellerMode?: boolean;
}
const { hasStore = false } = Astro.props;
---

<dialog
  id="buyer-dashboard"
  class="bd-dialog"
  aria-modal="true"
  aria-label="האזור האישי"
>
  <div id="bd-inner" style="display:flex;flex-direction:column;height:100%;border-radius:inherit;overflow:hidden">

    <!-- Header — diagonal gradient matching home-hero colors -->
    <div style="background:linear-gradient(135deg,#07101e 0%,#0d1829 50%,#1a2f4a 100%);flex-shrink:0;position:relative;overflow:hidden">

      <!-- Top row: user info | actions + close -->
      <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem 0.85rem;position:relative;z-index:1;gap:0.5rem">
        <!-- User info -->
        <div style="display:flex;align-items:center;gap:0.65rem;min-width:0">
          <div style="width:2.2rem;height:2.2rem;border-radius:50%;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:white">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          </div>
          <div style="display:flex;flex-direction:column;gap:1px;min-width:0">
            <span id="bd-user-name" style="color:white;font-weight:600;font-size:0.9rem;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"> </span>
            <span id="bd-user-email" style="color:rgba(255,255,255,0.5);font-size:0.74rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"> </span>
          </div>
        </div>

        <!-- Actions + close -->
        <div style="display:flex;align-items:center;gap:0.4rem;flex-shrink:0">
          {hasStore && (
            <a
              href="/seller/dashboard"
              style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.28rem 0.65rem;border-radius:9999px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.18);color:rgba(255,255,255,0.88);font-size:0.74rem;font-weight:500;text-decoration:none;transition:background 0.12s"
              onmouseover="this.style.background='rgba(255,255,255,0.2)'"
              onmouseout="this.style.background='rgba(255,255,255,0.1)'"
            >
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              דשבורד מוכר
            </a>
          )}
          <form method="POST" action="/seller/logout" style="margin:0">
            <button
              type="submit"
              style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.28rem 0.65rem;border-radius:9999px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.18);color:rgba(255,255,255,0.88);font-size:0.74rem;font-weight:500;cursor:pointer;transition:background 0.12s"
              onmouseover="this.style.background='rgba(255,255,255,0.2)'"
              onmouseout="this.style.background='rgba(255,255,255,0.1)'"
            >
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              התנתקות
            </button>
          </form>
          <button
            id="bd-close"
            aria-label="סגור"
            style="width:1.8rem;height:1.8rem;border-radius:0.45rem;background:rgba(255,255,255,0.08);border:none;display:flex;align-items:center;justify-content:center;color:white;cursor:pointer;transition:background 0.12s;flex-shrink:0"
            onmouseover="this.style.background='rgba(255,255,255,0.16)'"
            onmouseout="this.style.background='rgba(255,255,255,0.08)'"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <!-- Tabs -->
      <div role="tablist" style="display:flex;border-top:1px solid rgba(255,255,255,0.08);position:relative;z-index:1">
        <button class="bd-tab bd-tab--active" role="tab" id="bd-tab-orders" data-bd-panel="orders" aria-selected="true" tabindex="0">הזמנות</button>
        <button class="bd-tab" role="tab" id="bd-tab-messages" data-bd-panel="messages" aria-selected="false" tabindex="-1">
          הודעות
          <span id="bd-msg-dot" style="display:none;width:7px;height:7px;background:#ef4444;border-radius:50%;margin-inline-start:0.4rem;flex-shrink:0" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <!-- Content body -->
    <div style="flex:1;overflow-y:auto;background:var(--color-bg)">
      <div id="bd-pane-orders" role="tabpanel" aria-labelledby="bd-tab-orders">
        <div id="bd-orders-content" style="padding:1.25rem">
          <div class="bd-loading">טוען...</div>
        </div>
      </div>

      <div id="bd-pane-messages" role="tabpanel" aria-labelledby="bd-tab-messages" hidden>
        <div id="bd-messages-content" style="padding:1.25rem">
          <div class="bd-loading">טוען...</div>
        </div>
      </div>

    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('buyer-dashboard') as HTMLDialogElement | null;
  if (!dialog) throw new Error('BuyerDashboard: dialog not found');

  let ordersLoaded = false;
  let messagesLoaded = false;

  const panes: Record<string, HTMLElement | null> = {
    orders:   document.getElementById('bd-pane-orders'),
    messages: document.getElementById('bd-pane-messages'),
  };

  // ── Open / close ────────────────────────────────────────────
  const inner = document.getElementById('bd-inner') as HTMLElement | null;

  function openDashboard() {
    dialog!.showModal();
    inner?.animate(
      [{ opacity: 0, transform: 'translateY(8px)' },
       { opacity: 1, transform: 'translateY(0)' }],
      { duration: 160, easing: 'cubic-bezier(0.22,1,0.36,1)', fill: 'forwards' }
    );
    loadUserInfo();
    if (!ordersLoaded) loadOrders();
  }

  function closeDashboard() {
    const anim = inner?.animate(
      [{ opacity: 1 }, { opacity: 0 }],
      { duration: 100, easing: 'ease-in', fill: 'forwards' }
    );
    if (anim) anim.onfinish = () => dialog!.close();
    else dialog!.close();
  }

  window.addEventListener('buyer-dashboard:open', openDashboard);
  document.getElementById('bd-close')?.addEventListener('click', closeDashboard);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) closeDashboard(); });
  dialog.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); closeDashboard(); } });

  // ── User info ────────────────────────────────────────────────
  async function loadUserInfo() {
    const nameEl  = document.getElementById('bd-user-name');
    const emailEl = document.getElementById('bd-user-email');
    if (nameEl?.textContent?.trim()) return;
    try {
      const r = await fetch('/api/buyer/orders');
      if (r.ok) {
        const { orders } = await r.json() as { orders: Array<{ buyerName: string; buyerEmail: string }> };
        if (orders[0]) {
          if (nameEl)  nameEl.textContent  = orders[0].buyerName;
          if (emailEl) emailEl.textContent = orders[0].buyerEmail;
        }
      }
    } catch { /* ignore */ }
  }

  // ── Tab switching ────────────────────────────────────────────
  const tabs = dialog.querySelectorAll<HTMLButtonElement>('[data-bd-panel]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activateTab(tab.dataset.bdPanel!));
    tab.addEventListener('keydown', (e: KeyboardEvent) => {
      const list = [...tabs];
      const idx  = list.indexOf(tab);
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        const next = list[(idx + (e.key === 'ArrowLeft' ? 1 : -1) + list.length) % list.length]!;
        next.focus();
        activateTab(next.dataset.bdPanel!);
      }
    });
  });

  function activateTab(panel: string) {
    tabs.forEach((t) => {
      const active = t.dataset.bdPanel === panel;
      t.classList.toggle('bd-tab--active', active);
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
    });
    Object.entries(panes).forEach(([key, el]) => {
      if (!el) return;
      if (key === panel) {
        el.removeAttribute('hidden');
        el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: 'ease', fill: 'forwards' });
      } else {
        el.setAttribute('hidden', '');
      }
    });
    if (panel === 'messages' && !messagesLoaded) loadMessages();
  }

  // ── Helpers ──────────────────────────────────────────────────
  function fmtDate(iso: string): string {
    return new Date(iso).toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit' });
  }
  function fmtPrice(n: number): string {
    return `₪${n.toLocaleString('he-IL')}`;
  }
  function esc(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function timeAgo(iso: string): string {
    const diff = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
    if (diff < 60)    return 'עכשיו';
    if (diff < 3600)  return `לפני ${Math.floor(diff / 60)} ד'`;
    if (diff < 86400) return `לפני ${Math.floor(diff / 3600)} ש'`;
    return `לפני ${Math.floor(diff / 86400)} ימים`;
  }

  // ── Orders ───────────────────────────────────────────────────
  async function loadOrders() {
    const el = document.getElementById('bd-orders-content');
    if (!el) return;
    try {
      const res = await fetch('/api/buyer/orders');
      if (!res.ok) { el.innerHTML = '<p class="bd-empty">שגיאה בטעינת ההזמנות.</p>'; return; }
      const { orders } = await res.json() as { orders: Array<{
        id: string; createdAt: string; totalAmount: number; paymentStatus: string;
        shippingStatus: string; items: Array<{ productName: string; qty: number }>
      }> };
      ordersLoaded = true;
      if (!orders.length) { el.innerHTML = '<p class="bd-empty">עדיין לא ביצעת הזמנות.</p>'; return; }
      const statusMap: Record<string,string> = { pending:'ממתין לתשלום', paid:'שולם', failed:'נכשל' };
      const shipMap:   Record<string,string> = { pending:'ממתין', processing:'בטיפול', shipped:'נשלח', delivered:'נמסר' };
      el.innerHTML = `<div class="bd-orders-list">${orders.map((o) => `
        <div class="bd-order-card">
          <div class="bd-order-card__head">
            <span class="bd-order-card__id">#${o.id.slice(0,8)}</span>
            <span class="bd-order-card__date">${fmtDate(o.createdAt)}</span>
          </div>
          <div class="bd-order-card__items">${o.items.map((i) => `<span>${esc(i.productName)} × ${i.qty}</span>`).join(' · ')}</div>
          <div class="bd-order-card__foot">
            <span class="bd-status bd-status--${o.paymentStatus}">${statusMap[o.paymentStatus] ?? o.paymentStatus}</span>
            <span class="bd-status bd-status--ship">${shipMap[o.shippingStatus] ?? o.shippingStatus}</span>
            <strong style="margin-inline-start:auto">${fmtPrice(o.totalAmount)}</strong>
          </div>
        </div>`).join('')}</div>`;
    } catch {
      const el2 = document.getElementById('bd-orders-content');
      if (el2) el2.innerHTML = '<p class="bd-empty">שגיאה בטעינת ההזמנות.</p>';
    }
  }

  // ── Messages ─────────────────────────────────────────────────
  async function loadMessages() {
    const el = document.getElementById('bd-messages-content');
    if (!el) return;
    try {
      const res = await fetch('/api/messages?role=buyer');
      if (!res.ok) { el.innerHTML = '<p class="bd-empty">שגיאה בטעינת ההודעות.</p>'; return; }
      const { messages } = await res.json() as { messages: Array<{
        id: string; toStoreName: string; subject: string; content: string;
        createdAt: string; readBySeller: boolean;
        productRef?: { productName: string }
      }> };
      messagesLoaded = true;
      if (!messages.length) { el.innerHTML = '<p class="bd-empty">אין הודעות עדיין.</p>'; return; }
      el.innerHTML = `<div class="bd-messages-list">${messages.map((m) => `
        <div class="bd-msg-card">
          <div class="bd-msg-card__head">
            <span class="bd-msg-card__to">אל: ${esc(m.toStoreName)}</span>
            <span class="bd-msg-card__date">${fmtDate(m.createdAt)}</span>
          </div>
          ${m.productRef ? `<span class="bd-msg-card__ref">בנוגע למוצר: ${esc(m.productRef.productName)}</span>` : ''}
          <p class="bd-msg-card__subject">${esc(m.subject)}</p>
          <p class="bd-msg-card__body">${esc(m.content)}</p>
          ${!m.readBySeller ? '<span class="bd-msg-card__unread">טרם נקרא</span>' : ''}
        </div>`).join('')}</div>`;
    } catch {
      const el2 = document.getElementById('bd-messages-content');
      if (el2) el2.innerHTML = '<p class="bd-empty">שגיאה בטעינת ההודעות.</p>';
    }
  }

  window.addEventListener('bd-messages:unread', () => {
    const dot = document.getElementById('bd-msg-dot');
    if (dot) dot.style.display = 'inline-block';
  });
</script>
