---
import { cdnSrc } from '../config/store.config.js';
import { cdnIsSampleable } from '../lib/cdn.js';
import { storeMark, storeMarkGradient } from '../lib/store-mark.js';

interface Props {
  name: string;
  /** Seed for the generated fallback mark — always pass the store slug, so the
   *  avatar matches the same store's off-site imagery (see store-image.ts). */
  slug?: string;
  profileImage?: string;
  size?: number;
  class?: string;
  /** Opt in to having this picture's own colour read off it on the client
   *  (scripts/store-glow.ts). Only the caller knows whether anything on the page
   *  uses the result, and the `crossorigin` it requires is not free to hand to
   *  every avatar on the site — see `sampleable` below. */
  sampleColor?: boolean;
}

const { name, slug, profileImage, size = 40, class: className = '', sampleColor = false } = Astro.props;
// Same identity the PNG endpoint renders for this store: one hue per store, so a
// store with no uploaded picture is still recognisable from list to list — the
// old fallback painted every such store the identical grey-blue.
const mark = storeMark(slug || name, name);

// `crossorigin` is not a safe default: on a host that sends no
// `access-control-allow-origin` it stops the image loading ENTIRELY instead of
// merely leaving the canvas unreadable — so ask cdn.ts, which owns that fact,
// before tagging. A URL it can't route through Cloudinary stays untagged and
// the card simply keeps its default halo.
const sampleable = !!profileImage && sampleColor && cdnIsSampleable(profileImage);
---

{profileImage ? (
  <img
    src={cdnSrc(profileImage, size * 2)}
    alt=""
    decoding="async"
    width={size}
    height={size}
    loading="lazy"
    crossorigin={sampleable ? 'anonymous' : undefined}
    data-glow={sampleable ? '' : undefined}
    class={`rounded-full object-cover flex-shrink-0 ${className}`}
    style={`width:${size}px;height:${size}px;border:1px solid var(--color-border)`}
  />
) : (
  <span
    class={`rounded-full flex-shrink-0 flex items-center justify-center font-bold text-white ${className}`}
    style={`width:${size}px;height:${size}px;background:${storeMarkGradient(mark)};font-size:${Math.round(size * 0.42)}px;border:1px solid var(--color-border)`}
    aria-hidden="true"
  >{mark.initial}</span>
)}
