---
import { cdnSrc } from '../config/store.config.js';

interface Props {
  name: string;
  profileImage?: string;
  size?: number;
  class?: string;
}

const { name, profileImage, size = 40, class: className = '' } = Astro.props;
const initial = (name.trim()[0] ?? '?').toUpperCase();
---

{profileImage ? (
  <img
    src={cdnSrc(profileImage, size * 2)}
    alt=""
    width={size}
    height={size}
    loading="lazy"
    class={`rounded-full object-cover flex-shrink-0 ${className}`}
    style={`width:${size}px;height:${size}px;border:1px solid var(--color-border);box-shadow:var(--shadow-xs)`}
  />
) : (
  <span
    class={`rounded-full flex-shrink-0 flex items-center justify-center font-bold text-white ${className}`}
    style={`width:${size}px;height:${size}px;background:linear-gradient(135deg,#2a3c40,#3a5260);font-size:${Math.round(size * 0.42)}px;border:1px solid var(--color-border);box-shadow:var(--shadow-xs)`}
    aria-hidden="true"
  >{initial}</span>
)}
