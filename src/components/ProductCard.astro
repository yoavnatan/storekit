---
/** ProductCard — used in grids (homepage + product listing). */
import { formatPrice } from '../config/store.config.js';
const { product } = Astro.props;
const out = product.stock <= 0;
---

<article class="card product">
  <a href={`/products/${product.slug}`} class="product__media" aria-label={product.name}>
    <img
      src={product.image}
      alt={product.name}
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="product__body">
    <h3 class="product__name">
      <a href={`/products/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="muted product__desc">{product.description}</p>
    <div class="flex between product__foot">
      <span class="product__price">{formatPrice(product.price)}</span>
      {out
        ? <span class="badge">Out of stock</span>
        : <button class="btn add-to-cart" data-slug={product.slug}>Add to cart</button>}
    </div>
  </div>
</article>

<script>
  import { addItem } from '../lib/cart.js';
  import { getProductBySlug } from '../data/products.js';

  document.querySelectorAll('.add-to-cart').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-slug');
      const product = getProductBySlug(slug);
      if (product) {
        addItem(product, 1);
        window.dispatchEvent(new CustomEvent('cart:open'));
      }
    });
  });
</script>

<style>
  .product__media { aspect-ratio: 1; background: var(--color-surface); }
  .product__media img { width: 100%; height: 100%; object-fit: cover; }
  .product__body { padding: 0.9rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .product__name { font-size: 1.05rem; }
  .product__name a:hover { color: var(--color-primary); }
  .product__desc {
    font-size: 0.88rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product__foot { margin-top: auto; }
  .product__price { font-weight: 800; font-size: 1.1rem; }
  .add-to-cart { padding: 0.5rem 0.9rem; font-size: 0.9rem; }
</style>
