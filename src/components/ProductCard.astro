---
import { formatPrice } from '../config/store.config.js';
const { product } = Astro.props;
const out = product.stock <= 0;

const icons = {
  zap: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  star: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  briefcase: `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
};
const iconHtml = icons[product.icon as keyof typeof icons] ?? icons.zap;
---

<article class="card plan-card">
  <div class="plan-card__icon-area">
    <Fragment set:html={iconHtml} />
    {product.badge && <span class="plan-badge">{product.badge}</span>}
  </div>
  <div class="plan-card__body">
    <h3 class="plan-card__name">
      <a href={`/products/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="muted plan-card__desc">{product.description}</p>
    <div class="plan-card__price">
      {product.price === 0 ? 'Free' : formatPrice(product.price)}
      {product.price > 0 && <span class="plan-card__period">/mo</span>}
    </div>
    <div class="plan-card__action">
      {out
        ? <span class="badge">Out of stock</span>
        : <button class="btn plan-add-to-cart" data-slug={product.slug}>Get started</button>}
    </div>
  </div>
</article>

<script>
  import { addItem } from '../lib/cart.js';
  import { getProductBySlug } from '../data/products.js';

  document.querySelectorAll('.plan-add-to-cart').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-slug') ?? '';
      const product = getProductBySlug(slug);
      if (product) {
        addItem(product, 1);
        window.dispatchEvent(new CustomEvent('cart:open'));
      }
    });
  });
</script>

