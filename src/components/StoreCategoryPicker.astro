---
/**
 * Store-category picker — replaces the free-text comma field that let seller A write
 * "אלקטרוניקה" and seller B "חשמל ואלקטרוניקה", splitting one category into two
 * across `/stores`' filter and the homepage shelves (see lib/store-taxonomy.ts).
 *
 * Pick from the shared vocabulary (curated seeds + everything other stores already
 * use, most-used first). Adding a genuinely new one is allowed — the mall can't
 * predict every niche and owner approval would break the zero-touch rule — but it
 * goes through `proposeCategory()`: unsafe wording is refused outright, and a label
 * sharing a word with an existing category offers that one first (a SOFT block; the
 * seller can still insist).
 *
 * Submits a plain comma-joined `categories` field, so the existing form POST is
 * unchanged and `/api/store.ts` re-sanitizes server-side regardless — this component
 * is convenience, never the rule.
 */
import { MAX_CATEGORIES_PER_STORE, SEED_CATEGORIES } from '../lib/store-taxonomy.js';
import { CATEGORY_EN_FIELD_PREFIX, MAX_TRANSLATION_LENGTH } from '../lib/category-translations.js';
import { getLang, getT } from '../i18n/index.js';

interface Props {
  /** Full vocabulary to choose from, already ordered (see buildVocabulary). */
  vocabulary: readonly string[];
  /** Categories this store already carries. */
  selected?: readonly string[];
  /** Any English labels already recorded for the selected categories, keyed by the
   *  stored Hebrew value — so re-opening the form shows what was saved rather than
   *  an empty box that reads as "not set". */
  englishLabels?: Record<string, string>;
  /** Whether to offer the optional English label at all. OFF when opening a store
   *  (owner, 2026-08-07: "אחרת זה עלול לסבך את הפתיחת חנות") — the first form a
   *  seller ever meets asks for nothing extra, and the field waits in Settings for
   *  whenever they want it. Nothing depends on it either way: an untranslated
   *  category renders as the seller wrote it. */
  askEnglish?: boolean;
  /** Distinguishes the two instances (settings form / new-store form) on one page. */
  id?: string;
}

const { vocabulary, selected = [], englishLabels = {}, askEnglish = true, id = 'store-cats' } = Astro.props;
const t = getT(getLang(Astro.cookies));
---

<div
  class="store-cat-picker"
  id={id}
  data-max={MAX_CATEGORIES_PER_STORE}
  data-vocabulary={JSON.stringify(vocabulary)}
  data-i18n={JSON.stringify({
    search: t.dashboard.storeCategoriesPlaceholder,
    add: t.dashboard.categoryAdd,
    addAnyway: t.dashboard.categoryAddAnyway,
    full: t.dashboard.categoryLimit.replace('{n}', String(MAX_CATEGORIES_PER_STORE)),
    remove: t.dashboard.categoryRemove,
    enLabel: t.dashboard.categoryEnLabel,
    enPlaceholder: t.dashboard.categoryEnPlaceholder,
  })}
  data-seed-categories={JSON.stringify(SEED_CATEGORIES)}
  data-en-prefix={CATEGORY_EN_FIELD_PREFIX}
  data-en-max={MAX_TRANSLATION_LENGTH}
  data-en-values={JSON.stringify(englishLabels)}
>
  <!-- The real submitted value. Kept in sync by the script; the form works with
       whatever is here even if JS never runs (it holds the saved value already). -->
  <input type="hidden" name="categories" value={selected.join(', ')} class="store-cat-picker__value" />

  <div class="store-cat-picker__chips flex flex-wrap gap-1.5 mb-2" data-chips></div>

  <!-- One optional English input per category the seller INVENTED. A seed category
       already has a label we wrote, so it gets no row: a seller renaming the shelf
       everyone else sits on is a different thing entirely (category-translations.ts).
       Empty is the expected state and never blocks the save. -->
  {askEnglish && <div class="store-cat-picker__en flex flex-col gap-1.5 mt-2 mb-4" data-en-fields hidden></div>}

  <input
    type="text"
    class="input store-cat-picker__search"
    placeholder={t.dashboard.storeCategoriesPlaceholder}
    autocomplete="off"
    data-search
  />

  <p class="store-cat-picker__msg hidden mt-1.5 text-[0.8rem] leading-relaxed [color:var(--color-muted)]" data-msg role="status"></p>

  <div
    class="store-cat-picker__list hidden mt-1.5 max-h-52 overflow-y-auto rounded-[var(--radius)] border p-[0.3rem]
           [border-color:var(--color-border)] [background:var(--color-surface)]"
    data-list
    role="listbox"
  ></div>
</div>
