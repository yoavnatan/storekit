---
import { getLang, getT } from '../i18n/index.js';
import {
  MARK_PATH,
  LETTERS_PATH,
  STROKE_WIDTH,
  VIEW_BOX,
  HEIGHT_EM,
  GRADIENT,
  TAGLINE,
} from '../lib/brand-lockup.js';
/**
 * The platform's wordmark: a drawn `D` followed by "ezabin". One component, so
 * the logo can never drift between the header, the auth pages and whatever
 * comes next.
 *
 * THE LETTERS ARE OUTLINES, NOT TEXT (2026-08-10). This is the one thing to
 * understand before changing anything here. The wordmark is Chakra Petch 700
 * thickened by 0.014em, and a thickening is an outline — the family stops at
 * 700 and has no variable axis, so there is no heavier cut to switch to. CSS
 * cannot paint `-webkit-text-stroke` with a gradient, so a text wordmark would
 * have to outline itself in a flat colour and would halo against the ramp.
 * Hence SVG; and once it is SVG, paths cost nothing and buy a lot:
 *
 *   • CHAKRA PETCH IS NEVER SENT. Nothing else on the site uses it, so the
 *     alternative was an eleventh font preload on every page for seven letters.
 *   • THE LOGO CANNOT PAINT IN THE WRONG FACE. Every face in main.css is
 *     `font-display: optional`, which means a face not already available at
 *     first paint is not used AT ALL for that page view. That is exactly how
 *     the previous lockup shipped 24px misaligned in August — twice — because
 *     both "fixes" were measured against a fallback. A path has no such state.
 *   • The site's logo and `public/brand/*.svg` are the same drawing.
 *
 * Everything geometric lives in `src/lib/brand-lockup.ts`, which
 * `scripts/generate-wordmark.mjs` writes from the font itself. Do not retype a
 * number from it here. Its header records what is authored (the octagon's cut,
 * the two optical ratios, the tracking, the thickening) and what is derived
 * (everything else).
 *
 * WHY THE D IS A DRAWING AND NOT THE FONT'S LETTER (asked and answered
 * 2026-08-10). Chakra Petch cuts its own D's corner at 45°, exactly as this mark
 * does — the same language, which is most of why this face fits. What differs is
 * depth: the mark cuts 29.3% of its height, the font 17.1%. Rendered side by
 * side, the owner kept the drawn one. The reason it matters is the icon, where
 * the D stands alone and the deep cut is what makes it a shape rather than a
 * letter — and it is the only part of the wordmark that is ours rather than the
 * typeface's.
 *
 * THE DENSITY IS THE POINT. Heavy plus tight is what closes the seven letters
 * into ONE SOLID SHAPE, and that shape is the logo. The opposite was tried in
 * August — Heebo 600 at zero tracking — shipped, and the owner's verdict was
 * that it had become *cheaper* ("לפחות קודם זה היה גוש אחיד"). Reverted within
 * the hour. **Do not lighten or open this.** The 0.014em thickening exists for
 * the same reason: Chakra Petch 700's stem is 0.136em against Heebo 800's
 * 0.167em, and the block would otherwise have gone thinner in the move.
 *
 * IT STANDS TO THE ASCENDER, NOT TO THE CAP LINE. A deliberate logotype
 * override made with the rule in hand (owner, 2026-08-05, after the mark was
 * moved back to cap height for an hour to check): a drawn symbol standing in for
 * a letter is not a letter, and aligning one to the tallest thing in the word is
 * ordinary practice. The rule it breaks is a rule about running text. In Chakra
 * Petch the two are only 0.013em apart, so it now costs almost nothing — but it
 * stays, because it is the same mark.
 *
 * COLOUR. The letters carry the site's brand gradient — the one `.btn` wears,
 * unchanged — as ONE ramp across the whole wordmark. That needs
 * `gradientUnits="userSpaceOnUse"`: the default is objectBoundingBox, which
 * resolves per element, so every letter would get its own full ramp and the word
 * would read as pieces stuck together. Same failure the old code avoided by
 * giving the D a hand-computed slice; there is nothing to hand-compute now.
 *
 * ACCESSIBILITY. The whole lockup is one `role="img"` with the real name on it
 * and everything inside hidden from the tree. That was true when the letters
 * were text (the DOM said "ezabin", so the name was read without its first
 * letter) and it is more necessary now that there is no text at all.
 */

interface Props {
  /** `brand` = the site gradient inside the letters (light surfaces).
   *  `white` = solid white, for a brand-coloured surface. */
  tone?: 'brand' | 'white';
  /** Any CSS length. Everything else is in `em`, so this is the only size knob;
   *  omit it to inherit (the header sizes the logo through `.logo`). */
  size?: string;
  /** Adds the Hebrew line under the mark. Off by default: in a header or a form
   *  it would be a second voice in a place that has room for one. */
  tagline?: boolean;
  class?: string;
}

const { tone = 'brand', size, tagline = false, class: className = '' } = Astro.props;

/** The accessible name. Not `store.name` from the config: this component draws
 *  these exact seven letters, so the two must not be able to disagree. */
const NAME = 'Dezabin';

/**
 * The tagline follows the visitor's language in both places it appears — the
 * drawn line under the mark and the `aria-label` that is the homepage `<h1>`'s
 * whole accessible name. Both read `home.startSelling`. It is the one part of
 * the lockup that stays LIVE TEXT, precisely because it changes with the
 * language; it is Heebo, which the site already ships, so it costs nothing.
 *
 * The two languages are laid out differently, and the reason is arithmetic
 * rather than taste. The Hebrew is 19 glyphs and `TAGLINE.sizeEm` solves it to
 * sit flush with the wordmark on one line. "A home for independent stores" is 28
 * characters — roughly half again as wide at the same size — so no single line
 * of it fits the mark, and the flush-both-edges result the Hebrew gets is not
 * available to it at all. The owner's call (2026-08-07) was that two lines are
 * fine and that being aligned matters more than being one line.
 */
const lang = getLang(Astro.cookies);
const isHe = lang === 'he';
const t = getT(lang);

/**
 * A gradient is referenced by id, and two logos on one page (the header and the
 * homepage h1) would otherwise ship the same id twice. The counter only has to
 * be unique WITHIN a document, which it is even when two requests interleave —
 * it never decides anything a visitor sees, so it is not the kind of shared
 * state `feedback_scalability` is about.
 */
const seq = globalThis as { __dzLogoSeq?: number };
seq.__dzLogoSeq = (seq.__dzLogoSeq ?? 0) + 1;
const gradId = `dz-ramp-${seq.__dzLogoSeq}`;
const paint = tone === 'white' ? '#fff' : `url(#${gradId})`;

/**
 * The TAGLINE's colour, which the SVG does not inherit and must not.
 *
 * This used to sit on the outer span and paint both halves at once — the
 * wordmark was text, so a `background-clip:text` ramp across the column caught
 * the Hebrew line as well. The wordmark is paths now and takes its ramp from
 * inside the SVG, so the class has to be aimed at the line that is still text or
 * it silently falls back to whatever colour the surrounding page happens to
 * have. It is the same ramp and the same clip, so the line is painted exactly as
 * it was before.
 */
const taglineTone =
  tone === 'white'
    ? 'text-white'
    : 'bg-[linear-gradient(135deg,#2a3c40,#3a5260)] bg-clip-text text-transparent';
---

<span
  role="img"
  aria-label={tagline ? `${NAME} — ${t.home.startSelling}` : NAME}
  class:list={[
    // `dz-logo` carries no styling — it is a stable hook, because the rest of
    // this class list is utilities and a stylesheet cannot address those. The
    // header needs to nudge THIS element and nothing else near it.
    'dz-logo',
    'inline-flex flex-col gap-[0.05em] align-middle',
    // The Hebrew line is narrower than the mark and hangs off the start edge by
    // design, so the column aligns to start. The English line is WIDER than the
    // mark, which makes it the widest child and therefore the column's width —
    // start-aligning there would pin the mark to one edge with the whole
    // overhang on the other. Centring the column instead splits the overhang
    // evenly and keeps the mark on the lockup's axis. Only reachable with
    // `tagline`, i.e. the homepage h1; the header and the auth pages draw none.
    isHe || !tagline ? 'items-start' : 'items-center',
    className,
  ]}
  style={size ? `font-size:${size}` : undefined}
>
  {/* `max-w-none` is not decoration: reset.css sets `svg { max-width:100% }`,
      which clamps a fixed-size inline SVG inside a narrow box — the same trap
      that shrank icons in the products table. `shrink-0` does not cover it,
      because max-width is not flex shrinking.

      The height is an inline style rather than an `h-[...]` class on purpose:
      Tailwind scans source text for class names, so a value interpolated from a
      module would never be emitted at all. That is the same failure mode as the
      old `text-[0.390em]` trap (a trailing zero silently dropped the class),
      and going through `style` removes the whole class of it. */}
  <svg
    class="block w-auto max-w-none shrink-0"
    style={`height:${HEIGHT_EM}em`}
    viewBox={VIEW_BOX}
    aria-hidden="true"
    focusable="false"
  >
    {tone === 'brand' && (
      <defs>
        <linearGradient
          id={gradId}
          gradientUnits="userSpaceOnUse"
          x1={GRADIENT.x1}
          y1={GRADIENT.y1}
          x2={GRADIENT.x2}
          y2={GRADIENT.y2}
        >
          <stop offset="0" stop-color={GRADIENT.from} />
          <stop offset="1" stop-color={GRADIENT.to} />
        </linearGradient>
      </defs>
    )}
    {/* The thickening is a centred stroke in the SAME paint as the fill, on the
        mark and the letters alike — `paint-order="stroke"` keeps it behind the
        fill so the join never prints over a corner. Stroking one and not the
        other is the way to make the D stop matching the word. */}
    <g
      fill={paint}
      stroke={paint}
      stroke-width={STROKE_WIDTH}
      stroke-linejoin="miter"
      paint-order="stroke"
    >
      <path fill-rule="evenodd" d={MARK_PATH} />
      <path d={LETTERS_PATH} />
    </g>
  </svg>
  {tagline && (
    /* HEEBO, AT ITS NATURAL SPACING — both halves of that are the fix
     * (2026-08-05). It was Rubik 600 stretched with +0.0356em of tracking to
     * reach the name's width. Two problems, one cause. Hebrew is drawn to sit
     * close: tracking it open does not enlarge it, it loosens it, and a loosened
     * Hebrew word under a tight Latin wordmark is what read as amateur (owner:
     * "לא מספיק מקצועי ולא מספיק מתאים לאתר"). And a second family for one line
     * on one page failed the first design-line test — is it already in the
     * system — while costing a preload on EVERY page.
     *
     * The width match is kept, because it is what makes this a lockup rather
     * than two stacked lines, and it is solved with SIZE at the font's own
     * spacing. `TAGLINE.sizeEm` is that ratio, computed by the generator from
     * both faces' real ink widths.
     *
     * FLUSH ON BOTH ENDS, INK TO INK, AND THAT IS WHAT THE MARGIN IS FOR
     * (owner, 2026-08-05: "חשוב שהטקסט בעברית — כולל הצ׳ופצ׳יק של הי׳ — ישב בול
     * על הרוחב"). Matching the two ink WIDTHS is only half the job. The other
     * half is that a line box is not its ink: Heebo leaves a side bearing to the
     * right of the מ, while the wordmark now has none at all — its viewBox is
     * cropped to the stroked ink. Align the boxes, which is all `items-start`
     * can do, and the Hebrew therefore starts a visible pixel INSIDE the
     * English however exact the ratio is. `TAGLINE.marginEm` is exactly that
     * bearing, negated, in the tagline's OWN em — which is why it is applied
     * here and not on the column.
     *
     * Weight 500 under the wordmark: the gap is what keeps this a subtitle
     * rather than a second name. */
    <span
      dir={isHe ? 'rtl' : 'ltr'}
      class:list={[
        'font-medium',
        taglineTone,
        // Hebrew: the measured lockup above — one line, flush by construction.
        isHe && 'leading-none',
        // English: one line, centred on the mark, and allowed to overhang it.
        //
        // "A home for independent stores" is 28 characters against the Hebrew's
        // 19, so it cannot be flush inside the mark at this size — and the
        // owner's call (2026-08-07) was that overhanging is fine and centred is
        // what matters. Centred, not start-aligned, because an overhang that
        // spills to one side only reads as a mistake; split evenly it reads as
        // the lockup being wider than the mark.
        //
        // A first attempt boxed it to wrap instead, and gave one word per line:
        // `em` inside this span resolves against the span's OWN font-size, so
        // the box was a third of what was intended. Any length here has to be
        // divided by the size first — which is why there is no length here now.
        !isHe && 'whitespace-nowrap leading-none',
      ]}
      style={`font-size:${TAGLINE.sizeEm}em${isHe ? `;margin-inline-start:${TAGLINE.marginEm}em` : ''}`}
      aria-hidden="true"
    >{t.home.startSelling}</span>
  )}
</span>
