---
// WishlistDropdown — dropdown on desktop, bottom-sheet on mobile.
---

<div
  id="wishlist-panel"
  aria-labelledby="wishlist-panel-title"
  aria-hidden="true"
  style="display:none;position:fixed;z-index:200;background:var(--color-surface);border:1px solid var(--color-border);flex-direction:column;overflow:hidden"
>
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;border-bottom:1px solid var(--color-border);flex-shrink:0">
    <h2 id="wishlist-panel-title" style="font-size:0.92rem;font-weight:700;margin:0">Wishlist</h2>
    <button
      id="wishlist-close"
      aria-label="Close"
      style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;color:var(--color-muted);transition:background 0.1s"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div id="wishlist-lines" style="flex:1;overflow-y:auto;overscroll-behavior:contain;padding:0.5rem 0.4rem"></div>
</div>

<script>
  import { removeFromWishlist, addToWishlist, getWishlistByStore } from '../lib/wishlist.js';
  import { addItem, getCartQty } from '../lib/cart.js';
  import { formatPrice, cdnSrc } from '../config/store.config.js';
  import { spawnRipple } from '../lib/ripple.js';

  function getI18n() {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}'); } catch { return {}; }
  }

  const panel  = document.getElementById('wishlist-panel') as HTMLElement | null;
  const lines  = document.getElementById('wishlist-lines') as HTMLElement | null;
  const titleEl = document.getElementById('wishlist-panel-title') as HTMLElement | null;

  const isRtl = document.documentElement.dir === 'rtl';
  let isOpen = false;

  const esc = (s: unknown) =>
    String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // render() rebuilds the whole list (innerHTML) on every wishlist:change
  // while the panel is open — even for an unrelated add/remove elsewhere on
  // the page — which destroys and recreates every <img>, resetting them all
  // back to their opacity:0 skeleton state and re-fading in at once (a
  // full-panel "flicker"). Once a src has successfully decoded, it's
  // recorded here so a later render() can paint it already-loaded from the
  // first frame instead of replaying the fade for images the user already saw.
  const loadedImageSrcs = new Set<string>();

  function position() {
    if (!panel) return;
    const btn = document.getElementById('wishlist-toggle');
    if (!btn) return;
    const rect = btn.getBoundingClientRect();
    if (window.innerWidth <= 640) {
      Object.assign(panel.style, {
        top: `${rect.bottom + 8}px`,
        bottom: 'auto',
        left: '8px',
        right: '8px',
        width: 'auto',
        maxHeight: '480px',
        borderRadius: 'var(--radius)',
        boxShadow: '0 8px 32px rgba(0,0,0,0.14)',
      });
    } else {
      const panelWidth = Math.min(340, window.innerWidth - 16);
      Object.assign(panel.style, {
        top: `${rect.bottom + 8}px`,
        bottom: 'auto',
        right: isRtl ? 'auto' : `${window.innerWidth - rect.right}px`,
        left: isRtl ? `${rect.left}px` : 'auto',
        width: `${panelWidth}px`,
        maxHeight: '480px',
        borderRadius: 'var(--radius)',
        boxShadow: '0 8px 32px rgba(0,0,0,0.14)',
      });
    }
  }

  function open() {
    if (!panel) return;
    // Item data (name/price/qty) comes from localStorage — already known
    // synchronously, so render the real structure immediately instead of
    // showing a generically-sized skeleton first: swapping a 3-row mock
    // for the real (possibly differently-shaped) list is what caused the
    // panel to visibly "jump"/shrink a beat after opening.
    render();
    position();
    panel.style.display = 'flex';
    panel.removeAttribute('aria-hidden');
    panel.animate(
      [
        { opacity: '0', transform: 'translateY(-6px)' },
        { opacity: '1', transform: 'translateY(0)' },
      ],
      { duration: 160, easing: 'cubic-bezier(0.2,0,0,1)', fill: 'forwards' }
    );
    isOpen = true;
    document.getElementById('wishlist-toggle')?.setAttribute('aria-expanded', 'true');
    (document.getElementById('wishlist-close') as HTMLButtonElement | null)?.focus();
  }

  // Per-image shimmer: each item's thumbnail loads (and reveals) on its own,
  // instead of gating the whole list on every image finishing first. On a
  // cached image decode() resolves almost immediately, so a re-open never
  // re-shows a shimmer that lingers.
  function hydrateImages() {
    lines?.querySelectorAll<HTMLElement>('.wl-img-wrap:not(.loaded)').forEach((wrap) => {
      const img = wrap.querySelector<HTMLImageElement>('img');
      if (!img) return;
      const markLoaded = () => {
        wrap.classList.add('loaded');
        if (img.src) loadedImageSrcs.add(img.src);
      };
      img.decode().then(markLoaded).catch(markLoaded);
    });
  }

  function close() {
    if (!panel || !isOpen) return;
    isOpen = false;
    document.getElementById('wishlist-toggle')?.setAttribute('aria-expanded', 'false');
    panel.animate([{ opacity: '1' }, { opacity: '0' }], { duration: 100, easing: 'ease-in', fill: 'forwards' })
      .addEventListener('finish', () => {
        panel.style.display = 'none';
        panel.setAttribute('aria-hidden', 'true');
      });
  }

  // Close on click-outside (composedPath captures elements before DOM mutations)
  document.addEventListener('click', (e) => {
    if (!isOpen) return;
    const toggle = document.getElementById('wishlist-toggle');
    const path = e.composedPath();
    if (panel && toggle && !path.includes(panel) && !path.includes(toggle)) close();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      close();
      document.getElementById('wishlist-toggle')?.focus();
    }
  });

  // Reposition on resize
  window.addEventListener('resize', () => { if (isOpen) position(); });


  function render() {
    if (!lines) return;
    const i18n    = getI18n().wishlist ?? {};
    const cartI18n = getI18n().cart ?? {};
    const byStore = getWishlistByStore();

    if (titleEl) titleEl.textContent = i18n.title ?? 'Wishlist';
    const closeBtn = document.getElementById('wishlist-close');
    if (closeBtn) closeBtn.setAttribute('aria-label', i18n.close ?? 'Close');

    if (byStore.size === 0) {
      lines.innerHTML = `<p style="color:var(--color-muted);text-align:center;padding:1.5rem 0;font-size:0.88rem">${i18n.empty ?? 'Your wishlist is empty'}</p>`;
      return;
    }

    const groups = [...byStore.entries()];
    lines.innerHTML = groups.map(([storeSlug, { storeName, items }], gi) => `
      ${gi > 0 ? '<hr style="border:none;border-top:1px solid var(--color-border);margin:0.25rem 0">' : ''}
      <div>
        <div style="display:flex;align-items:center;padding:0.5rem 0 0.25rem">
          <a href="/store/${esc(storeSlug)}" style="font-weight:700;font-size:0.82rem;color:var(--color-primary);text-decoration:none;flex:1">${esc(storeName)}</a>
          <span style="font-size:0.72rem;color:var(--color-muted)">${items.length}</span>
        </div>
        ${items.map((item, idx) => {
          // Ceiling nets out whatever quantity of this product already sits in
          // the cart (added from here, the store page, or a quick-view) — not
          // just its raw stock — so this stepper/button can't push the cart
          // past real stock once every unit is already in it.
          const remaining = item.stock != null ? Math.max(0, item.stock - getCartQty(storeSlug, item.slug)) : undefined;
          return `
          ${idx > 0 ? '<div style="height:1px;background:var(--color-border);margin:0 0.4rem"></div>' : ''}
          <div class="wl-item" style="display:flex;flex-direction:column;gap:0.4rem;padding:0.45rem 0.6rem">
            <a href="/store/${esc(storeSlug)}/${esc(item.slug)}" style="display:flex;align-items:center;gap:0.55rem;min-width:0;text-decoration:none;color:inherit">
              ${item.image
                ? (() => {
                    const imgSrc = cdnSrc(item.image, 400);
                    const alreadyLoaded = loadedImageSrcs.has(imgSrc);
                    return `<span class="wl-img-wrap skel-bar${alreadyLoaded ? ' loaded' : ''}" style="border-radius:8px"><img class="wl-img" src="${esc(imgSrc)}" alt="${esc(item.name)}" width="56" height="56" loading="eager" style="${alreadyLoaded ? 'opacity:1' : ''}"></span>`;
                  })()
                : `<div style="width:56px;height:56px;border-radius:8px;background:var(--color-surface);border:1px solid var(--color-border);flex-shrink:0"></div>`}
              <div style="flex:1;min-width:0">
                <span style="display:block;font-weight:600;font-size:0.83rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(item.name)}</span>
                <span style="font-size:0.8rem;color:var(--color-muted)">${formatPrice(item.price)}</span>
              </div>
            </a>
            <div class="wl-controls" style="display:flex;align-items:center;gap:0.35rem">
                <div class="cart-line__qty" dir="ltr" style="flex-shrink:0">
                  <button data-wl-minus="${esc(item.slug)}" aria-label="${esc(cartI18n.qtyDecrease ?? 'Decrease quantity')}" disabled>−</button>
                  <span data-wl-qty="${esc(item.slug)}" aria-live="polite" aria-atomic="true">1</span>
                  <button data-wl-plus="${esc(item.slug)}" data-stock="${remaining ?? ''}" aria-label="${esc(cartI18n.qtyIncrease ?? 'Increase quantity')}" ${remaining != null && remaining <= 1 ? 'disabled' : ''}>+</button>
                </div>
                <button
                  class="btn btn--sm"
                  data-wl-cart="${esc(item.slug)}"
                  data-wl-store="${esc(storeSlug)}"
                  data-wl-sname="${esc(storeName)}"
                  data-wl-name="${esc(item.name)}"
                  data-wl-price="${item.price}"
                  data-wl-img="${esc(cdnSrc(item.image, 400))}"
                  data-wl-stock="${item.stock ?? ''}"
                  data-label-added="${esc(i18n.addedToCart ?? 'Added ✓')}"
                  style="flex:1;font-size:0.78rem;white-space:nowrap"
                  ${remaining != null && remaining <= 0 ? 'disabled' : ''}
                >${esc(i18n.addToCart ?? 'Add to cart')}</button>
                <button data-wl-rm="${esc(item.slug)}" class="cart-line__rm" aria-label="${esc(i18n.remove ?? 'Remove')}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><circle cx="10" cy="13" r="1.1" fill="currentColor" stroke="none"/><circle cx="14" cy="13" r="1.1" fill="currentColor" stroke="none"/><path d="M9 6V4h6v2"/></svg></button>
            </div>
          </div>`;
        }).join('')}
      </div>`).join('');
    hydrateImages();
  }

  function setHeartStyle(btn: HTMLElement, active: boolean) {
    const svg = btn.querySelector<SVGElement>('svg');
    if (!svg) return;
    if (active) {
      svg.style.fill = '#e53e3e'; svg.style.stroke = '#e53e3e';
      btn.style.color = '#e53e3e'; btn.style.background = 'rgba(255,255,255,0.95)';
    } else {
      svg.style.fill = 'none'; svg.style.stroke = 'currentColor';
      btn.style.color = ''; btn.style.background = 'rgba(255,255,255,0.9)';
    }
  }

  lines?.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;

    const plusBtn = e.target.closest<HTMLButtonElement>('[data-wl-plus]');
    if (plusBtn) {
      if (plusBtn.disabled) return;
      const qtyRow = plusBtn.closest<HTMLElement>('.cart-line__qty');
      const qtyEl = qtyRow?.querySelector<HTMLElement>('[data-wl-qty]');
      if (qtyEl) {
        const stock = plusBtn.dataset.stock ? parseInt(plusBtn.dataset.stock, 10) : Infinity;
        const newQty = parseInt(qtyEl.textContent ?? '1', 10) + 1;
        if (newQty > stock) return;
        qtyEl.textContent = String(newQty);
        const minusBtn = qtyRow?.querySelector<HTMLButtonElement>('[data-wl-minus]');
        if (minusBtn) minusBtn.disabled = newQty <= 1;
        plusBtn.disabled = newQty >= stock;
      }
      return;
    }

    const minusBtn = e.target.closest<HTMLButtonElement>('[data-wl-minus]');
    if (minusBtn) {
      const qtyRow = minusBtn.closest<HTMLElement>('.cart-line__qty');
      const qtyEl = qtyRow?.querySelector<HTMLElement>('[data-wl-qty]');
      if (qtyEl) {
        const cur = parseInt(qtyEl.textContent ?? '1', 10);
        if (cur > 1) {
          const newQty = cur - 1;
          qtyEl.textContent = String(newQty);
          minusBtn.disabled = newQty <= 1;
          const plusBtn = qtyRow?.querySelector<HTMLButtonElement>('[data-wl-plus]');
          if (plusBtn) {
            const stock = plusBtn.dataset.stock ? parseInt(plusBtn.dataset.stock, 10) : Infinity;
            plusBtn.disabled = newQty >= stock;
          }
        }
      }
      return;
    }

    const cartBtn = e.target.closest<HTMLButtonElement>('[data-wl-cart]');
    if (cartBtn) {
      const slug = cartBtn.dataset.wlCart ?? '';
      const cartStoreSlug = cartBtn.dataset.wlStore ?? '';
      const rawStock = cartBtn.dataset.wlStock ? Number(cartBtn.dataset.wlStock) : undefined;
      const qtyEl = lines.querySelector<HTMLElement>(`[data-wl-qty="${slug}"]`);
      const qty = Math.max(1, parseInt(qtyEl?.textContent ?? '1', 10));
      const itemData = {
        slug,
        name:  cartBtn.dataset.wlName  ?? '',
        price: Number(cartBtn.dataset.wlPrice ?? 0),
        image: cartBtn.dataset.wlImg   ?? '',
        stock: rawStock,
      };
      for (let i = 0; i < qty; i++) {
        addItem(cartStoreSlug, cartBtn.dataset.wlSname ?? '', itemData, 1, undefined, false);
      }
      const orig = cartBtn.textContent ?? '';
      cartBtn.textContent = cartBtn.dataset.labelAdded ?? orig;
      cartBtn.disabled = true;
      cartBtn.classList.add('btn--confirmed');
      cartBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 260, easing: 'cubic-bezier(0.34,1.56,0.64,1)' }
      );
      setTimeout(() => {
        cartBtn.textContent = orig;
        cartBtn.classList.remove('btn--confirmed');
        // Re-enables only if stock remains, not blindly — also re-syncs this
        // row's own qty stepper to the fresh ceiling.
        const remaining = rawStock != null ? Math.max(0, rawStock - getCartQty(cartStoreSlug, slug)) : undefined;
        cartBtn.disabled = remaining != null && remaining <= 0;
        const qtyRow = cartBtn.closest<HTMLElement>('.wl-controls')?.querySelector<HTMLElement>('.cart-line__qty');
        const plusBtn = qtyRow?.querySelector<HTMLButtonElement>('[data-wl-plus]');
        const minusBtn = qtyRow?.querySelector<HTMLButtonElement>('[data-wl-minus]');
        if (qtyEl) qtyEl.textContent = '1';
        if (minusBtn) minusBtn.disabled = true;
        if (plusBtn) {
          plusBtn.dataset.stock = String(remaining ?? '');
          plusBtn.disabled = remaining != null && remaining <= 1;
        }
      }, 1400);
      return;
    }

    const rmBtn = e.target.closest<HTMLButtonElement>('[data-wl-rm]');
    if (!rmBtn) return;
    const slug = rmBtn.dataset.wlRm ?? '';
    if (!slug) return;

    if (rmBtn.dataset.confirming === 'true') {
      // Second click — confirm deletion
      clearTimeout(Number(rmBtn.dataset.timer ?? '0'));
      delete rmBtn.dataset.confirming;
      delete rmBtn.dataset.timer;

      // Capture full item data before the optimistic removal wipes its row,
      // so a failed server sync can restore it exactly.
      const row = rmBtn.closest<HTMLElement>('.wl-item');
      const cartBtn = row?.querySelector<HTMLButtonElement>('[data-wl-cart]');
      const itemForRollback = cartBtn ? {
        slug,
        name: cartBtn.dataset.wlName ?? '',
        price: Number(cartBtn.dataset.wlPrice ?? 0),
        image: cartBtn.dataset.wlImg ?? '',
        storeSlug: cartBtn.dataset.wlStore ?? '',
        storeName: cartBtn.dataset.wlSname ?? '',
        stock: cartBtn.dataset.wlStock ? Number(cartBtn.dataset.wlStock) : undefined,
      } : null;

      fetch('/api/wishlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'remove', productSlug: slug }),
      }).then((r) => {
        if (r.ok) return;
        throw new Error('remove failed');
      }).catch(() => {
        if (!itemForRollback) return;
        addToWishlist(itemForRollback);
        document.querySelectorAll<HTMLElement>(`[data-wishlist-slug="${slug}"]`).forEach((b) => {
          b.setAttribute('data-wishlisted', 'true');
          b.setAttribute('aria-pressed', 'true');
          setHeartStyle(b, true);
        });
        const i18n = getI18n().wishlist ?? {};
        window.dispatchEvent(new CustomEvent('toast:show', {
          detail: { title: i18n.removeFailed ?? 'Could not remove from wishlist', body: i18n.removeFailedBody ?? '' },
        }));
      });

      removeFromWishlist(slug);
      document.querySelectorAll<HTMLElement>(`[data-wishlist-slug="${slug}"]`).forEach((b) => {
        b.setAttribute('data-wishlisted', 'false');
        b.setAttribute('aria-pressed', 'false');
        setHeartStyle(b, false);
      });
    } else {
      // First click — button turns red with a checkmark, waits for second click
      rmBtn.dataset.confirming = 'true';
      const origInner = rmBtn.innerHTML;
      const origBg = rmBtn.style.background;
      const origColor = rmBtn.style.color;
      const origBorder = rmBtn.style.borderColor;
      rmBtn.style.background = '#e53e3e';
      rmBtn.style.color = 'white';
      rmBtn.style.borderColor = '#e53e3e';
      rmBtn.setAttribute('aria-label', getI18n().wishlist?.confirmRemove ?? 'Confirm removal');
      rmBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
      const timer = window.setTimeout(() => {
        if (rmBtn.dataset.confirming !== 'true') return;
        delete rmBtn.dataset.confirming;
        delete rmBtn.dataset.timer;
        rmBtn.style.background = origBg;
        rmBtn.style.color = origColor;
        rmBtn.style.borderColor = origBorder;
        rmBtn.setAttribute('aria-label', getI18n().wishlist?.remove ?? 'Remove');
        rmBtn.innerHTML = origInner;
      }, 3000);
      rmBtn.dataset.timer = String(timer);
    }
  });

  // #wishlist-count itself is owned by Header.astro's refreshWishlistCount()
  // (shared updateBadge()/badge-ticker.ts, with the pop/roll animations) — this
  // drawer only ever needs to re-render its own item list on the same event.
  window.addEventListener('wishlist:change', () => {
    if (isOpen) render();
  });

  document.getElementById('wishlist-close')?.addEventListener('click', close);
  window.addEventListener('wishlist:open', () => isOpen ? close() : open());

  const wishlistPanel = document.getElementById('wishlist-panel');
  wishlistPanel?.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button:not([disabled]), a.btn');
    if (btn) spawnRipple(btn, e.clientX, e.clientY);
  });

</script>
