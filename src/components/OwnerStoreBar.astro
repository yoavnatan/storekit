---
// OwnerStoreBar — the strip the seller sees at the top of their OWN store, on the
// store page and on every product page inside it. It is a wayfinding bar, not a mode:
// the page underneath is the live store, identical to what a shopper gets. The one
// difference is that buying is refused (lib/own-store-guard.ts client-side,
// /api/checkout server-side), which is why the copy avoids the word "preview".
//
// Sits in normal flow above whatever the page pins, so it scrolls away and no
// sticky/curtain geometry below has to account for it.
interface Props {
  /** Copy from t.store — kept as props so the component needs no lang of its own. */
  label: string;
  backLabel: string;
  /** Absolute on a custom domain (the dashboard lives on another origin there). */
  dashboardHref: string;
}

const { label, backLabel, dashboardHref } = Astro.props;
---

<div class="bg-[color:var(--color-bg)] border-b border-[color:var(--color-border)]">
  <div class="container flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2 text-[.82rem]">
    <span class="[color:var(--color-muted)]">{label}</span>
    <a
      id="owner-preview-back"
      href={dashboardHref}
      class="font-semibold [color:var(--color-accent)] no-underline hover:underline"
    >{backLabel}</a>
  </div>
</div>

<script>
  // Close the preview tab instead of navigating, so the seller lands back on the
  // dashboard tab that is still open rather than ending up with two of them.
  // Closable when the dashboard opened this tab via window.open (initStorePreviewLink),
  // or while it still holds a single history entry. Reached any other way — a direct
  // link, or after browsing deep into the store from a plain link-opened tab — close
  // is refused, so that case falls through to the plain navigation the href provides.
  const ownerBack = document.getElementById('owner-preview-back') as HTMLAnchorElement | null;
  ownerBack?.addEventListener('click', (e) => {
    if (!window.opener && history.length > 1) return;
    e.preventDefault();
    window.close();
    setTimeout(() => { if (!window.closed) window.location.href = ownerBack.href; }, 120);
  });
</script>
