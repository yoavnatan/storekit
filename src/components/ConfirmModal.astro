---
---
<dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
  <div class="confirm-dialog__inner">
    <h3 class="confirm-dialog__title" id="confirm-title"></h3>
    <p class="confirm-dialog__message" id="confirm-message"></p>
    {/* The OK button ships in its DANGER skin because that is what almost every
        confirmation here guards (delete, block, cancel an order). A confirmation
        on a POSITIVE action — reopening a paused store, calling off a closure —
        passes tone:'primary' and the two danger classes come off, so red keeps
        meaning "this one takes something away" instead of just "this is the OK
        button". See the toneOk() handler below. */}
    <div class="confirm-dialog__actions">
      <button id="confirm-cancel" class="btn btn--ghost"></button>
      <button id="confirm-ok" class="btn btn--danger !bg-[color:var(--color-danger)] hover:opacity-90"></button>
    </div>
  </div>
</dialog>

<script>
  import { showActionFailedToast } from '../lib/toast.js';

  function getI18n() {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}'); } catch { return {}; }
  }

  const dialog = document.getElementById('confirm-dialog') as HTMLDialogElement | null;
  const titleEl = document.getElementById('confirm-title');
  const msgEl = document.getElementById('confirm-message');
  const cancelBtn = document.getElementById('confirm-cancel') as HTMLButtonElement | null;
  const okBtn = document.getElementById('confirm-ok') as HTMLButtonElement | null;

  let pending: (() => void | Promise<void>) | null = null;
  let workingLabel = 'Working…';
  let busy = false;

  function centerDialog() {
    if (dialog) dialog.style.transform = '';
  }

  /** Danger unless the caller says otherwise — toggled rather than rewritten so the
   *  class strings stay literal in the markup above, where Tailwind's scanner can
   *  still see the arbitrary utility. */
  function toneOk(tone: string | undefined) {
    if (!okBtn) return;
    const danger = tone !== 'primary';
    okBtn.classList.toggle('btn--danger', danger);
    okBtn.classList.toggle('!bg-[color:var(--color-danger)]', danger);
  }

  window.addEventListener('confirm:open', (e: Event) => {
    const i18n = getI18n().confirm ?? {};
    const detail = (e as CustomEvent<{ title?: string; message?: string; okLabel?: string; workingLabel?: string; tone?: 'danger' | 'primary'; onConfirm?: () => void | Promise<void> }>).detail;
    if (titleEl) titleEl.textContent = detail.title ?? i18n.defaultTitle ?? 'Are you sure?';
    if (msgEl) msgEl.textContent = detail.message ?? i18n.defaultMsg ?? 'This action cannot be undone.';
    if (okBtn) okBtn.textContent = detail.okLabel ?? i18n.confirm ?? 'Confirm';
    toneOk(detail.tone);
    if (cancelBtn) cancelBtn.textContent = i18n.cancel ?? 'Cancel';
    pending = detail.onConfirm ?? null;
    workingLabel = detail.workingLabel ?? i18n.working ?? 'Working…';
    centerDialog();
    dialog?.showModal();
  });

  cancelBtn?.addEventListener('click', () => {
    if (busy) return;
    dialog?.close();
    pending = null;
  });

  okBtn?.addEventListener('click', async () => {
    if (busy) return;
    const action = pending;
    pending = null;
    if (!action) { dialog?.close(); return; }

    const origOkText = okBtn.textContent ?? '';
    busy = true;
    okBtn.disabled = true;
    if (cancelBtn) cancelBtn.disabled = true;
    // **Six dots, and it was on every confirm dialog in the app** (owner, 2026-08-17). Every
    // `workingLabel` in the codebase is written with a trailing ellipsis — "מוחק…", "מבטל…",
    // "משהה…" — and the `.dot-pulse` beside it draws three more that actually animate. So the
    // button read "משהה… ⋯". Stripped HERE and not in the twenty call sites: the dots belong to
    // this component, so the fact that the label must not carry its own is this component's to
    // know. A caller that never sees the dots keeps its ellipsis where it wrote it.
    const label = workingLabel.replace(/[\s.…]+$/, '');
    okBtn.innerHTML = `<span style="display:inline-flex;align-items:center;gap:0.5em">${label}<span class="dot-pulse" role="status" aria-label="${label}"><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span></span></span>`;
    try {
      await action();
    } catch {
      // **Every destructive action on this site funnels through here**, which is why the missing
      // `catch` mattered more than any single one of them. `finally` closed the dialog and put the
      // button back exactly as it does on success, so a delete whose fetch was dropped LOOKED
      // DELETED: the confirm box vanished, nothing was said, and the only trace was an unhandled
      // rejection in the console. A confirmed action that then does nothing, silently, is the
      // worst shape a failure can take — the user has already decided, so they do not check.
      //
      // Handlers that detect their own failure (a non-`ok` body) report it themselves and return
      // normally, so they never reach this. Only a THROW does, which means no double message.
      showActionFailedToast();
    } finally {
      busy = false;
      okBtn.disabled = false;
      okBtn.textContent = origOkText;
      if (cancelBtn) cancelBtn.disabled = false;
      dialog?.close();
    }
  });

  // Native Escape triggers a 'cancel' event before 'close' — block it mid-action
  // so a busy delete/save can't be silently abandoned while its fetch is in flight.
  dialog?.addEventListener('cancel', (e) => {
    if (busy) e.preventDefault();
  });

  dialog?.addEventListener('click', (e) => {
    if (busy) return;
    if (e.target === dialog) {
      dialog.close();
      pending = null;
    }
  });
</script>
