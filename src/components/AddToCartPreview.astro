---
// AddToCartPreview — listens for cart.ts's `cart:item-added` event and shows
// a brief, auto-dismissing preview of the item just added: desktop gets a
// corner card (same placement language as ToastContainer), mobile gets a
// full-width bottom bar. Never opens the full CartDrawer itself — "view
// cart" / "checkout" are just links into the existing flows.
---

<div id="cart-preview" class="cart-preview" role="status" aria-live="polite" hidden></div>

<script>
  import type { CartItemAddedDetail } from '../lib/cart.js';
  import { formatPrice, cdnThumb } from '../config/store.config.js';
  import { escapeHtml as esc } from '../lib/html-escape.js';

  const preview = document.getElementById('cart-preview')!;
  let hideTimer: ReturnType<typeof setTimeout> | undefined;
  const DISPLAY_MS = 6000;

  function getI18n() {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}'); } catch { return {}; }
  }

  // Mirrors ToastContainer's own offset trick — if the product page's sticky
  // mobile add-to-cart bar is on screen, sit above it instead of overlapping.
  function updateBottomOffset(): void {
    const bar = document.querySelector<HTMLElement>('.sticky-bottom-bar.is-visible');
    const height = bar ? window.innerHeight - bar.getBoundingClientRect().top : 0;
    preview.style.setProperty('--cart-preview-bottom-offset', height > 0 ? `${height + 12}px` : '');
  }

  function scheduleHide() {
    clearTimeout(hideTimer);
    hideTimer = setTimeout(hide, DISPLAY_MS);
  }

  function hide() {
    clearTimeout(hideTimer);
    preview.classList.remove('is-open');
    setTimeout(() => { preview.hidden = true; }, 180);
  }

  /**
   * The URL to paint in the preview — and it is deliberately NOT a fresh `cdnThumb`.
   *
   * Reported by a seller 2026-08-03: the thumbnail took seconds to appear on a confirmation of an
   * action whose picture is already on screen. `cdnThumb(image, 104, 104)` is a DIFFERENT
   * transformation from the one the product card renders (`cdnSrc`/`cdnSrcSet` at 300–800w), so it
   * is a URL the browser has never requested AND, the first time any shopper adds that product,
   * one Cloudinary has never generated — a full round trip plus a derivative build, to show 52
   * CSS pixels that were already decoded a few centimetres away.
   *
   * So: find an `<img>` on this page already showing the same SOURCE image and reuse the exact
   * candidate the browser chose (`currentSrc` — with `srcset` that is the only URL guaranteed to
   * have been fetched; `src` may never have been). Matching is on the source tail, because every
   * Cloudinary derivative of one origin image ends with that same encoded origin. The oversized
   * bytes cost nothing here: they are already in memory, and a cache hit paints in the same frame.
   * Returns `''` when it cannot serve one — a cart restored on a page that never rendered the
   * product — and the call site falls back to `cdnThumb`, which is left visible there on purpose:
   * `tests/image-optimization.test.ts` reads the `src` expression to prove no raw URL ever reaches
   * an `<img>`, and hiding the CDN call inside this function would defeat a guard that is right.
   */
  function cachedImageFor(url: string): string {
    const tail = url.slice(url.lastIndexOf('/') + 1);
    if (!tail) return '';
    for (const img of document.querySelectorAll<HTMLImageElement>('img')) {
      const chosen = img.currentSrc || img.src;
      if (chosen && chosen !== url && chosen.endsWith(tail) && img.complete && img.naturalWidth > 0) return chosen;
    }
    return '';
  }

  function show(detail: CartItemAddedDetail) {
    updateBottomOffset();
    const i18n = getI18n().cart ?? {};
    preview.innerHTML = `
      <button type="button" class="cart-preview__close" aria-label="${esc(i18n.closePreview ?? 'Close')}">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="cart-preview__body">
        <img class="cart-preview__img" src="${esc(cachedImageFor(detail.item.image) || cdnThumb(detail.item.image, 104, 104))}" alt="" width="52" height="52" loading="eager" decoding="sync" />
        <div class="cart-preview__info">
          <p class="cart-preview__added">${esc(i18n.addedToCart ?? 'Added to cart')}</p>
          <p class="cart-preview__name">${esc(detail.item.name)}</p>
          <p class="cart-preview__price">${esc(formatPrice(detail.item.price))}</p>
        </div>
      </div>
      <div class="cart-preview__actions">
        <button type="button" class="btn btn--sm btn--ghost cart-preview__view">${esc(i18n.viewCart ?? 'View cart')}</button>
        <a class="btn btn--sm btn--accent cart-preview__checkout" href="/checkout?store=${encodeURIComponent(detail.storeSlug)}">${esc(i18n.checkout ?? 'Checkout')}</a>
      </div>
    `;

    preview.querySelector('.cart-preview__close')?.addEventListener('click', hide);
    preview.querySelector('.cart-preview__view')?.addEventListener('click', () => {
      hide();
      window.dispatchEvent(new CustomEvent('cart:open'));
    });

    preview.hidden = false;
    requestAnimationFrame(() => preview.classList.add('is-open'));
    scheduleHide();
  }

  preview.addEventListener('mouseenter', () => clearTimeout(hideTimer));
  preview.addEventListener('mouseleave', scheduleHide);

  window.addEventListener('cart:item-added', (e) => {
    show((e as CustomEvent<CartItemAddedDetail>).detail);
  });

  // The full cart drawer opening (icon click, or our own "view cart" button)
  // should take over — no point in a stale preview sitting behind it.
  window.addEventListener('cart:open', hide);
</script>
