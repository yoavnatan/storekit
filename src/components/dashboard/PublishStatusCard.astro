---
/**
 * One line on the overview saying the shop is not on the site, and one button to the screen that
 * fixes it.
 *
 * ── It used to be the whole errand, and that was the problem ──
 * It listed every hold with its own explanation and its own button, while the Payments tab
 * separately carried a clearing-status line, a details form and a subscription card. Four boxes
 * across two tabs for one thing (owner, 2026-08-24: *"סירבול של כפתורים ומידע למוכר. צריך משהו
 * מרוכז וברור"*). `GoLiveSteps.astro` is now the one place, and this is a POINTER to it.
 *
 * It still earns its place: the overview is where a seller lands, and a shop that is not on the
 * site is the most important thing true about it. What it must not do is answer the question here
 * as well — two screens explaining one errand is how they start disagreeing.
 *
 * Renders nothing once the shop is live.
 */
import type { PublishHold } from '../../lib/store-publication.js';
import type { getT } from '../../i18n/index.js';

interface Props {
  holds: PublishHold[];
  /**
   * Is the shop the seller is LOOKING AT on the site?
   *
   * The card used to key off `holds` alone, and since 2026-08-24 that is no longer the whole
   * question: the holds are the ACCOUNT's, and a paying seller who has just opened a second shop
   * has none of them while that shop is still not up (`lib/store-plan.ts` — its fee is not on the
   * standing order yet). Keyed off holds alone the overview would have said nothing at all about a
   * shop that is not on the site, which is the most important thing true about it.
   */
  storeIsLive: boolean;
  d: ReturnType<typeof getT>['dashboard'];
}
const { holds, storeIsLive, d } = Astro.props;

/**
 * ── What this card SAYS depends on which hold is in front (owner, 2026-08-25) ──
 *
 * *"עד מתי 'העלאה לאוויר' נשאר בסקירה בכפתור הזה? הרי אם ממתינים — צריך להיות רשום שם שההעלאה
 * ממתינה לאישור."* It offered the same sentence and the same call to action in every state, so a
 * seller a week into PayMe's review was still being told to go and put his shop live — an
 * instruction he cannot follow, on the one screen he lands on every time.
 *
 * The holds are already ordered by the flow (`store-publication.ts`), so the FIRST one is what he
 * is actually waiting on. The approval hold is the one nobody can act on, and there the card drops
 * its button entirely rather than pointing at a screen with nothing to press.
 */
const blocking = holds[0] ?? null;
const LINE: Record<string, string> = {
  'clearing-details': d.pubHoldDetailsNote,
  'clearing-approval': d.pubHoldApprovalNote,
  'subscription': d.pubHoldSubscriptionNote,
};
const CTA: Record<string, string> = {
  'clearing-details': d.pubHoldDetailsCta,
  'subscription': d.pubHoldSubscriptionCta,
};
const title = blocking === 'clearing-approval' ? d.pubHoldApproval : d.pubTitle;
const line = blocking ? LINE[blocking] : d.pubBuildOn;
const cta = blocking ? CTA[blocking] : d.pubHoldSubscriptionCta;
---

{!storeIsLive && (
  <section class="card card--flat p-4 md:p-5 mb-4" id="publish-status" data-publish-holds={holds.join(',')}>
    <h3 class="text-[1.05rem] font-bold m-0">{title}</h3>
    <p class="muted m-0 mt-1 text-[0.86rem]">{line}</p>
    {/* `data-goto-panel` is the dashboard's own tab switch (scripts/dashboard/ui.ts) — the same
        mechanism every stat card on this tab uses, so this behaves like every other jump here.
        Absent while PayMe are reviewing: there is nothing to press, and a button that leads to a
        screen with nothing to do on it is worse than none. */}
    {cta && (
      <button type="button" class="btn btn--accent btn--sm mt-3" data-goto-panel="payouts">
        {cta}
      </button>
    )}
  </section>
)}
