---
// Small "(i)" info icon that reveals an explanatory tooltip on hover/focus.
// Reuses the shared floating tooltip (scripts/tooltip.ts): the text
// lives in `data-tooltip` and initInfoTooltips() binds the hover/focus events.
// Same markup the performance/advertising tabs already use — factored out here
// so the admin advertising panel can drop one next to anything without copying
// the SVG each time.
interface Props {
  text: string;
  /** Extra classes on the button (e.g. margin tweaks). */
  class?: string;
}
const { text, class: extra = '' } = Astro.props;
---
<button
  type="button"
  class:list={['inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0 align-middle shrink-0', extra]}
  data-tooltip={text}
  aria-label={text}
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
</button>
