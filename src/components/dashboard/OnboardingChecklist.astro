---
// "First steps" checklist shown at the top of the seller dashboard's Overview tab while a
// brand-new store is still incomplete. Renders NOTHING once every step is done — the guidance
// retires itself instead of becoming permanent chrome.
//
// State-free by design: `steps` come from lib/seller-onboarding.ts, which derives each step
// from the store's real data (see that file's note). Nothing here is dismissible, so there is
// no onboarding record to store, sync or migrate.
//
// Pending rows are real <button>s wired to the existing data-goto-panel mechanism
// (initGotoPanelLinks() in scripts/dashboard/ui.ts) — the whole row is the tap target, which
// is what makes it usable at 375px.
import { getLang, getT } from '../../i18n/index.js';
import { missingRequiredSteps, onboardingProgress, type OnboardingStep, type OnboardingStepId } from '../../lib/seller-onboarding.js';

interface Props {
  steps: OnboardingStep[];
}
const { steps } = Astro.props;
const lang = getLang(Astro.cookies);
const d = getT(lang).dashboard;
const progress = onboardingProgress(steps);
// A missing REQUIRED step means the store is genuinely undiscoverable right now (the gate lives in
// lib/store-readiness.ts, not here) — so it gets a stated consequence, not a nudge.
const blocking = missingRequiredSteps(steps);

// A step whose target tab hides its control behind a toggle names that control, so the row opens
// it as well as switching tabs (data-goto-open, handled by initGotoPanelLinks() in ui.ts). The id
// lives here and not in lib/seller-onboarding.ts because it is a fact about this dashboard's
// markup, and that module is deliberately pure. Steps with nothing to open simply omit it —
// Astro drops an attribute whose value is undefined.
const STEP_OPENS: Partial<Record<OnboardingStepId, string>> = {
  product: 'toggle-add-form',
};

const COPY: Record<OnboardingStepId, { label: string; hint: string }> = {
  product:    { label: d.onbStepProduct,    hint: d.onbStepProductHint },
  image:      { label: d.onbStepImage,      hint: d.onbStepImageHint },
  about:      { label: d.onbStepAbout,      hint: d.onbStepAboutHint },
  categories: { label: d.onbStepCategories, hint: d.onbStepCategoriesHint },
  address:    { label: d.onbStepAddress,    hint: d.onbStepAddressHint },
};
---

{!progress.complete && (
  <section
    class="mb-5 bg-[color:var(--color-surface)] border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] p-4"
    aria-labelledby="onb-title"
  >
    <div class="flex items-baseline justify-between gap-3 flex-wrap">
      <h2 id="onb-title" class="m-0 text-[0.95rem] font-semibold [color:var(--color-text)]">{d.onbTitle}</h2>
      <span class="text-[0.8rem] font-semibold [color:var(--color-muted)] whitespace-nowrap">
        {progress.doneCount}/{progress.total} {d.onbStepsDone}
      </span>
    </div>
    <p class="muted text-[0.82rem] m-0 mt-1 leading-[1.5]">{d.onbSubtitle}</p>

    {blocking.length > 0 && (
      <p class="flex items-start gap-2 m-0 mt-3 py-2 px-[0.7rem] rounded-[var(--radius)] bg-[#fffbeb] border border-[#fde68a] text-[0.82rem] leading-[1.5] [color:#92400e]">
        <svg class="shrink-0 mt-[0.15rem]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>{d.onbNotLive}</span>
      </p>
    )}

    {/* Progress bar — decorative duplicate of the "n/total" text above, hence aria-hidden. */}
    <div class="mt-3 h-[4px] rounded-full bg-[color:var(--color-bg)] overflow-hidden" aria-hidden="true">
      <div
        class="h-full rounded-full bg-[color:var(--color-success)] transition-[width] duration-300 ease-out"
        style={`width:${progress.percent}%`}
      ></div>
    </div>

    <ul class="list-none m-0 mt-3 p-0 flex flex-col gap-1">
      {steps.map((step) => (
        <li>
          {step.done ? (
            <div class="flex items-center gap-2 py-[0.4rem] px-[0.3rem]">
              <svg class="shrink-0 [color:var(--color-success)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke-width="1.6"/>
                <polyline points="8 12.5 11 15.5 16 9.5"/>
              </svg>
              <span class="text-[0.87rem] [color:var(--color-muted)] line-through decoration-1">{COPY[step.id].label}</span>
            </div>
          ) : (
            <button
              type="button"
              data-goto-panel={step.panel}
              data-goto-open={STEP_OPENS[step.id]}
              class="group w-full flex items-start gap-2 text-start py-[0.4rem] px-[0.3rem] bg-transparent border-0 rounded-[var(--radius-sm)] cursor-pointer transition-colors duration-150 hover:bg-[color:var(--color-bg)]"
            >
              <svg class="shrink-0 mt-[0.15rem] [color:var(--color-border)] transition-colors duration-150 group-hover:[color:var(--color-accent)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
              </svg>
              <span class="flex-1 min-w-0">
                <span class="block text-[0.87rem] font-medium [color:var(--color-text)]">
                  {COPY[step.id].label}
                  {step.required && (
                    <span class="align-middle ms-[0.35rem] py-[0.05rem] px-[0.35rem] rounded-[var(--radius-sm)] bg-[#fef3c7] text-[0.68rem] font-bold [color:#92400e]">{d.onbRequired}</span>
                  )}
                </span>
                <span class="block text-[0.78rem] [color:var(--color-muted)] leading-[1.45] mt-[0.1rem]">{COPY[step.id].hint}</span>
              </span>
              <span class="shrink-0 self-center text-[0.78rem] font-semibold [color:var(--color-accent)] opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100 max-sm:opacity-100">
                {d.onbGo}
              </span>
            </button>
          )}
        </li>
      ))}
    </ul>
  </section>
)}
