---
/** Every field of the "launch a boost" form — shared by the seller's Advertising tab and the
 *  admin's per-store twin (/admin/store/[slug]/advertising). Each page keeps only its own frame
 *  around this: the <form> element, its trailing notes and its submit button.
 *
 *  One component rather than two copies: the two forms post to twin endpoints and are driven by
 *  the SAME script (scripts/dashboard/advertising.ts), which finds every field by id — so a copy
 *  that drifted would not fail loudly, it would quietly stop behaving like its twin. They had
 *  already drifted once (the admin form never gained the multi-product scope).
 *
 *  Scope: a campaign may cover the whole store, a hand-picked set of products, or whole
 *  categories. The two narrowed scopes are multi-pick, so "one product" is simply a list of one —
 *  the server stores that as the long-standing single-product shape (lib/ad-campaign-input.ts).
 *  Field order matters: the two pickers are full-width and come AFTER the paired scope/platform
 *  row, so revealing one never leaves half a row empty above it.
 */
import { AD_BUDGET_PRESETS, MIN_CAMPAIGN_BUDGET, MAX_CAMPAIGN_BUDGET } from '../../lib/ad-budget.js';
import { formatPrice } from '../../config/store.config.js';
import { jsonForScript } from '../../lib/json-script.js';
import type { getT } from '../../i18n/index.js';

interface Props {
  /** Boostable products: on the storefront and in stock. Names + prices only — the picker builds
   *  its rows on the client for the current search term, so a large catalog costs one small
   *  payload instead of a DOM node per product (Hard rules → Scalability). `inferGender`/
   *  `inferAge` ride along so the audience fields can pre-fill from whatever the seller ticks. */
  products: Array<{ id: string; name: string; price: number; inferGender: string; inferAge: string }>;
  /** Whether this store has a category tree at all. The categories option renders only when it
   *  does — a scope with nothing to pick is a dead end. */
  hasCategories: boolean;
  /** The management-fee explainer for the little "(i)" beside the budget label. */
  budgetTipText: string;
  /** The dashboard translation table, passed down rather than re-resolved, so the component uses
   *  the language the page already picked from the cookie. */
  d: ReturnType<typeof getT>['dashboard'];
}

const { products, hasCategories, budgetTipText, d } = Astro.props;
const [defaultBudget] = AD_BUDGET_PRESETS;
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
  <label class="field">
    <span>{d.adScopeLabel}</span>
    <select id="ad-scope-select" name="scope" class="input">
      <option value="store">{d.adScopeStore}</option>
      <option value="products">{d.adScopeProducts}</option>
      {hasCategories && <option value="categories">{d.adScopeCategories}</option>}
    </select>
  </label>

  <label class="field">
    <span>{d.adPlatform}</span>
    <select id="ad-platform-select" name="platform" class="input">
      <option value="both">{d.adPlatformBoth}</option>
      <option value="google">{d.adPlatformGoogle}</option>
      <option value="meta">{d.adPlatformMeta}</option>
    </select>
  </label>

  <div class="field sm:col-span-2" id="ad-product-field" hidden>
    <span>{d.adSelectProducts} <span class="muted font-normal" id="ad-products-count"></span></span>
    <input type="hidden" name="productIds" id="ad-product-ids" value="" />
    <input class="input" type="search" id="ad-products-search" placeholder={d.saleProductsSearch} autocomplete="off" />
    <div id="ad-products-list" class="mt-2 max-h-[15rem] overflow-y-auto rounded-[var(--radius)] border [border-color:var(--color-border)] [background:var(--color-surface)] p-1"></div>
    <script type="application/json" id="ad-products-data" set:html={jsonForScript(products)} />
  </div>

  {hasCategories && (
    <div class="field sm:col-span-2" id="ad-category-field" hidden>
      <span>{d.adSelectCategories}</span>
      {/* The dashboard's own category picker in multi mode — the same control the sale scope
          uses, so one campaign and one sale name a category identically. */}
      <div class="category-picker relative" data-category-picker data-picker-input="categoryIds" data-picker-add="off" data-picker-multi="on" data-picker-more-label={d.adScopeAndMore}>
        <input type="hidden" name="categoryIds" id="ad-category-ids" value="" />
        <button type="button" class="category-picker__trigger input group flex items-center justify-between gap-2 cursor-pointer [color:var(--color-text)] text-start transition-colors duration-[120ms] hover:border-[var(--color-muted)] aria-expanded:border-[var(--color-accent)]" aria-haspopup="true" aria-expanded="false">
          <span class="category-picker__label overflow-hidden text-ellipsis whitespace-nowrap">{d.categoryNone}</span>
          <svg class="category-picker__chevron shrink-0 [color:var(--color-muted)] transition-transform duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="category-picker__menu absolute start-0 top-[calc(100%+5px)] w-max min-w-full max-w-[20rem] max-h-[18rem] overflow-y-auto [background:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-[0.3rem] shadow-[0_4px_20px_rgba(0,0,0,0.12)] z-[60] animate-status-pop" hidden></div>
      </div>
    </div>
  )}

  {/* Budget: a ladder of ready amounts plus "another amount". A seller who has never bought
      advertising has nothing to compare an empty number box against, and that figure is the one
      decision in this form that costs him money — the presets answer "what does a campaign cost
      here?" in a glance, the free field stays for anyone who already knows. A <div>, not a
      <label>: two controls live here and a label may only bind to one, so both point at the
      heading with aria-labelledby instead. */}
  <div class="field">
    <span class="inline-flex items-center">
      <span id="ad-budget-label">{d.adBudgetMonthlyFieldLabel}</span>
      <button type="button" class="ms-[5px] inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={budgetTipText} aria-label={budgetTipText}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
      </button>
    </span>
    <select id="ad-budget-select" class="input" aria-labelledby="ad-budget-label">
      {AD_BUDGET_PRESETS.map((amount) => <option value={amount}>{formatPrice(amount)}</option>)}
      <option value="custom">{d.adBudgetCustom}</option>
    </select>
    {/* Hidden until "another amount" is picked, but always the field that POSTS the value — so a
        preset and a typed amount travel the identical path to the server. `step="1"`, NOT 10:
        with a coarser step the browser refuses to submit anything off the ladder (777 with
        step=10) — and because the field can be hidden at that moment, it refuses SILENTLY, with
        no bubble and no submit event. min/max mirror the server's own rule (lib/ad-budget.ts).
        Picking "another amount" EMPTIES this field (advertising.ts#syncBudgetChoice) and it stays
        empty — no placeholder and no spinner arrows (user, 2026-07-31): the seller is typing one
        figure he already has in mind, and a greyed range in the box reads as a value that is
        already there. The range is told to him only if he leaves it — see the error line below.
        `value` still seeds the field for the presets, which write into it on every change. */}
    <input
      type="number"
      id="ad-budget-input"
      name="monthlyBudget"
      class="input mt-2 [appearance:textfield] [-moz-appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:m-0 [&::-webkit-outer-spin-button]:m-0"
      min={MIN_CAMPAIGN_BUDGET}
      max={MAX_CAMPAIGN_BUDGET}
      step="1"
      value={defaultBudget}
      dir="ltr"
      aria-labelledby="ad-budget-label"
      aria-describedby="ad-budget-range-error"
      hidden
    />
    {/* Shown when he leaves the field holding something outside the range — never while he is
        still typing it, since "5" on the way to "500" is not yet a mistake. Text comes from
        advertising.ts so the limits in it are the constants, not prose that goes stale. */}
    <p id="ad-budget-range-error" class="m-0 mt-1 text-[0.76rem] [color:var(--color-danger)]" role="alert" hidden></p>
  </div>

  <label class="field">
    <span>{d.adDurationLabel}</span>
    <select id="ad-duration-select" name="durationDays" class="input">
      <option value="">{d.adDurationOngoing}</option>
      <option value="7">{d.adDuration7}</option>
      <option value="14">{d.adDuration14}</option>
      <option value="30">{d.adDuration30}</option>
    </select>
  </label>

  <p id="ad-budget-mode-note" class="sm:col-span-2 muted text-[0.76rem] m-0 -mt-1">{d.adBudgetMonthlyHint}</p>

  {/* A whole-store campaign covers a mixed catalog, so one manual gender/age would force a single
      demographic on all of it — each product self-targets by its own feed attributes instead.
      These two exist for the narrowed scopes only; advertising.ts swaps them for the note below. */}
  <label class="field" id="ad-gender-field" hidden>
    <span>{d.adAudienceGender}</span>
    <select id="ad-gender-select" name="gender" class="input">
      <option value="all">{d.adGenderAll}</option>
      <option value="women">{d.adGenderWomen}</option>
      <option value="men">{d.adGenderMen}</option>
    </select>
    <small id="ad-infer-note" class="text-[0.72rem] [color:var(--color-success)] mt-1" hidden>{d.adAudienceAutoNote}</small>
  </label>

  <label class="field" id="ad-age-field" hidden>
    <span>{d.adAudienceAge}</span>
    <select id="ad-age-select" name="age" class="input">
      <option value="all">{d.adAgeAll}</option>
      <option value="infant">{d.adAgeInfant}</option>
      <option value="kids">{d.adAgeKids}</option>
      <option value="adult">{d.adAgeAdult}</option>
    </select>
  </label>
</div>

<p id="ad-store-auto-note" class="text-[0.78rem] m-0 [color:var(--color-success)]">{d.adStoreAutoNote}</p>
