---
// One-line "what this tab does" explainer, rendered at the top of a dashboard panel.
//
// Shown ONLY while the seller's onboarding checklist is still incomplete (the parent decides) —
// so a first-time seller is told what every tab is for, and an established seller never carries
// the extra line. Same derived signal as the checklist, so nothing is stored or dismissed.
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<p class="flex items-start gap-[0.4rem] m-0 mb-3 text-[0.82rem] leading-[1.5] [color:var(--color-muted)]">
  <svg class="shrink-0 mt-[0.15rem]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
  </svg>
  <span>{text}</span>
</p>
