---
import { formatAgorot } from '../../lib/money.js';
import { heCount } from '../../lib/he-count.js';
import { cdnThumb } from '../../lib/cdn.js';
import { formatBusinessDateShort } from '../../lib/format-date.js';
import {
  isOpen, handoverDeadlineISO, autoRefundDueISO, responseDeadlineISO,
  inTransitReviewDueISO, offerAnswerDueISO, isPartialReturn, disputeCause, sellerOwesAction,
  OFFER_ANSWER_DAYS, RETURN_REASON_LABELS as REASON,
  type ReturnStatus, type ReturnReason, type DisputeCause,
} from '../../lib/returns.js';
import type { ReturnRequest, ReturnOrderFacts } from '../../lib/return-requests.js';

/**
 * The seller's returns tab — one CARD per case, saying where it stands and what he can do.
 *
 * The owner asked for exactly this and asked for it plainly: *"למה אין פשוט כרטיס של בקשת החזר שאני
 * רואה עם ui פשוט ומובן — מה הסטטוס שלו?"*. So the card answers three questions in that order, and
 * nothing else appears above them: **what happened**, **what it costs**, **whose turn it is**.
 *
 * ── Why the buttons are derived from the state machine, not written per card ──
 * `returns.ts#RETURN_TRANSITIONS` already says which moves are legal from here. Listing them again
 * as markup would be a second definition that drifts the first time a state is added, and the drift
 * would show up as a button that 409s — the worst kind, because it looks like the seller's fault.
 *
 * ── The deadline line is the whole point of the card ──
 * Every open state has a clock, and the seller's real question is never "what status is this" but
 * "how long have I got". So each card shows the date its clock lands on, in words, from the same
 * pure functions the job uses — never a second calculation.
 *
 * Hebrew literals rather than the dictionary: this is a seller surface, which is Hebrew-only by
 * construction — `i18n-hardcoded-strings.test.ts` decides that by whether a file calls the
 * translator at all, and this one deliberately does not. (Naming that function here, even inside a
 * comment, is enough to flip the guard and fail the suite on every literal below — which is exactly
 * what the first version of this header did.)
 */
interface Props {
  requests: ReturnRequest[];
  storeSlug: string;
  /**
   * The dates on the ORDER behind each case, keyed by order id — see
   * `return-requests.ts#getOrderFactsForReturns` for why the card needs three dates and not one.
   * A missing entry simply renders fewer of them; an order can be absent only if it was removed
   * under the request, which nothing on the platform does.
   */
  orderFacts?: Map<string, ReturnOrderFacts>;
  /**
   * Does this shop take returns over the counter?
   *
   * True for every shop that offers collection in person — the owner's rule (2026-08-17), and not a
   * setting the seller gets to switch off: he already invites people to his address to pick things up.
   * When it is true he gets a button for the handover he can see happening in front of him, which is
   * the strongest proof of return in the whole mechanism and needs no carrier at all.
   */
  acceptsInStoreReturns?: boolean;
}
const { requests, acceptsInStoreReturns = false, orderFacts } = Astro.props;

/** The unsigned upload pair, for the seller's optional dispute photo. Public by design — the same
 *  two values the buyer's return form already carries; `scripts/dashboard/cloudinary.ts` owns the
 *  call. Empty in a checkout with no `.env`, and the field then simply offers no upload. */
const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? '';
const cloudPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET ?? '';

/** What the case IS, in the seller's words. Every status in the machine has one — a card that
 *  printed a raw English state would be the exact bug the buyer dashboard already had once. */
const STATUS: Record<ReturnStatus, string> = {
  requested: 'הקונה מחכה לתשובה שלך.',
  approved: 'אישרת את הבקשה, והקונה אמור לשלוח את המוצר בחזרה.',
  // ⚠️ Read `statusLine()` before using this one directly — inside the statutory window nobody
  // approved anything, and the card must not tell the seller he did.
  in_transit: 'לפי הקונה, המוצר כבר בדרך אליך.',
  received: 'המוצר הגיע אליך וממתין שתבדוק אותו.',
  // "העברת את זה אלינו. אנחנו מכריעים" until 2026-08-20 — the owner's note was that it *"נשמע לא
  // טוב"*, and he was right about more than the tone. It addressed the seller as the one who did it,
  // on a card the sweep can also land here without him touching anything (`in_transit` goes to
  // `disputed` on its own after a fortnight of silence), and "אנחנו מכריעים" is present tense for
  // something nobody has started.
  disputed: 'הבקשה ממתינה להכרעת המערכת.',
  offered: 'הצעת לקונה סכום במקום החזרת המוצר, ואנחנו מחכים לתשובתו.',
  rejected: 'סירבת לבקשה.',
  refunded: 'הבקשה נסגרה, והכסף בדרכו חזרה לקונה.',
  expired: 'הבקשה נסגרה מאליה, והמוצר לא חזר אליך.',
};

/**
 * The status sentence, and the one state where the stored word is not the whole truth.
 *
 * **A request opened inside the statutory 14 days is `approved` the moment it is made** — the buyer
 * has a right and the seller has no say (`returns.ts#autoApproved`). The card said "אישרת" for it,
 * which tells a seller he did something he never did, on the MOST COMMON case there is: eight of the
 * ten scenarios on the demo board are inside the window. The owner asked what he is supposed to do
 * with those, which is the question a wrong first sentence produces.
 *
 * `within_statutory` is stored on the row at creation precisely so this stays answerable forever
 * after (migration 0030), so telling the two apart costs nothing.
 */
function statusLine(r: ReturnRequest): string {
  if (r.status === 'approved' && r.withinStatutory) {
    // "הוא אמור לשלוח את המוצר" until 2026-08-20 — the owner's correction, and it is about more
    // than register: "אמור" says the buyer is under an obligation the seller might have to chase,
    // when in fact this is simply the next step and the clock enforces it. Naming the DESTINATION
    // ("אליך") is the other half — the sentence never said where the goods were going.
    return 'הבקשה אושרה אוטומטית — זו זכות הקונה בתוך 14 יום. הלקוח שולח את המוצר אליך.';
  }
  return STATUS[r.status];
}

/** The tone each state carries. `danger` only where the seller is holding something up. */
const TONE: Record<ReturnStatus, string> = {
  requested: 'danger', approved: 'warning', in_transit: 'muted', received: 'danger', offered: 'muted',
  disputed: 'warning', rejected: 'muted', refunded: 'success', expired: 'muted',
};

/** The moves the seller may make FROM each state, with the words for them. Derived from the machine
 *  in `returns.ts`; anything it does not allow simply has no button. */
const MOVES: Partial<Record<ReturnStatus, { to: ReturnStatus; label: string; kind: string }[]>> = {
  requested: [
    { to: 'approved', label: 'אשר', kind: 'accent' },
    { to: 'rejected', label: 'סרב', kind: 'ghost' },
  ],
  // ⚠️ 'הקונה שלח את המוצר' USED to be here, and it was two bugs in one button. It 403'd, because
  // `in_transit` is not in `/api/returns`' list of seller moves — but the deeper fault is why nobody
  // noticed: only the buyer can know he posted a parcel, so asking the seller to declare it put the
  // buyer's whole protection in the hands of the person with the opposite interest. A seller who
  // pressed nothing let the case expire on day 7 and kept the money AND the product. It is the
  // buyer's button now (`lib/return-buyer-cta.ts`).
  approved:   [
    { to: 'offered', label: 'הצע החזר חלקי במקום החזרה', kind: 'ghost' },
  ],
  in_transit: [{ to: 'received', label: 'המוצר הגיע אליי', kind: 'accent' }],
  received: [
    { to: 'refunded', label: 'המוצר תקין — החזר לו את הכסף', kind: 'accent' },
    { to: 'disputed', label: 'הגיע ריק או משומש', kind: 'ghost' },
  ],
};

/**
 * The moves for THIS shop — `MOVES`, plus the counter handover where the shop has a counter.
 *
 * `approved → received` skips the whole postal journey, and it is the only place in the mechanism
 * where "the product came back" is a fact somebody watched happen rather than a claim about a parcel.
 * Nothing else here needs to change for it: `received` already starts the 2-business-day clock and
 * already offers both answers, so an in-store return is refunded or disputed exactly like a posted one.
 */
function movesFor(status: ReturnStatus): { to: ReturnStatus; label: string; kind: string }[] {
  const base = MOVES[status] ?? [];
  if (status === 'approved' && acceptsInStoreReturns) {
    return [{ to: 'received', label: 'הקונה הביא את המוצר לחנות', kind: 'accent' }, ...base];
  }
  return base;
}

/** The one line that says how long is left, per state. Null when no clock runs. */
function deadlineLine(r: ReturnRequest): string | null {
  if (r.status === 'requested') {
    // Inside the statutory window there is nothing to answer — it was approved on arrival — so this
    // branch only ever describes a request the seller may really refuse.
    //
    // **Every line here now names WHOSE WAY the clock closes and what happens to the money** (owner,
    // 2026-08-20: *"מה המשמעות של 'הבקשה תיסגר', בעבור המוכר ובעבור הלקוח"*). "הבקשה תיסגר" is the
    // one thing on this card the seller cannot infer: the four clocks do not all land the same way —
    // silence on a request he was entitled to refuse becomes a REFUSAL (`returns.ts#responseOverdue`
    // argues why), an unposted parcel expires in his favour, an unanswered offer expires but leaves
    // the buyer free to start again, and a parcel he received and ignored refunds the buyer. Naming
    // the direction is also the honest warning on the two where it costs him.
    if (r.withinStatutory) return null;
    return `יש לך זמן להשיב עד ${formatBusinessDateShort(responseDeadlineISO(r.createdAt))}. אם לא תשיב, הבקשה תיסגר כסירוב והכסף יישאר אצלך.`;
  }
  if (r.status === 'approved') {
    const d = handoverDeadlineISO(r.approvedAt);
    return d ? `הקונה אמור לשלוח את המוצר עד ${formatBusinessDateShort(d)}. אם לא ישלח, הבקשה תיסגר והכסף יישאר אצלך.` : null;
  }
  // A separate clock now, and a separate SENTENCE, because the two used to share both: an approved
  // request that the buyer never posted closes in the seller's favour on day 7, but once the buyer has
  // said he posted it, nothing closes in anybody's favour — we decide it ourselves. Telling the seller
  // that plainly is also the honest warning: if the parcel really did arrive, marking it received is
  // how he keeps the case out of our hands.
  if (r.status === 'in_transit') {
    const d = inTransitReviewDueISO(r.sentAt);
    return d ? `כשהמוצר יגיע, סמן שקיבלת אותו. אם לא תסמן עד ${formatBusinessDateShort(d)}, נבדוק את המקרה ונכריע בעצמנו.` : null;
  }
  if (r.status === 'offered') {
    const d = offerAnswerDueISO(r.offeredAt);
    return d ? `הקונה אמור להשיב להצעה עד ${formatBusinessDateShort(d)}. אם לא ישיב, הבקשה תיסגר והכסף יישאר אצלך.` : null;
  }
  if (r.status === 'received') {
    const d = autoRefundDueISO(r.deliveredBackAt);
    return d ? `יש לך זמן לבדוק את המוצר עד ${formatBusinessDateShort(d)}. אם לא תשיב עד אז, הכסף יחזור לקונה אוטומטית.` : null;
  }
  return null;
}

/**
 * The reason, plus the ONE thing it implies that the card cannot show otherwise.
 *
 * The owner's question was *"מה זה אומר 'התחרט'"* — two words are a category, and a seller needs
 * what follows from it. The first answer to that was a second line under the reason spelling out the
 * consequence of each of the four, and looking at the result killed it: two of the four only
 * restated the words directly above them ("הגיע פגום" → "טוען שהמוצר הגיע פגום"), and the shipping
 * clause on those two was FALSE on a partial return, where the original delivery is never refunded
 * (`returns.ts#partialRefundAgorot`). Every card carried a line, one of them wrong.
 *
 * So the clause is appended to the reason itself, and only on the two that are genuinely opaque:
 * `changed_mind`, where a seller's first question is whether the goods are faulty, and `not_arrived`,
 * which is the one case where nothing comes back and the case is not his to settle. The other two
 * say what they mean. Who pays the postage is on the next line already.
 */
const REASON_EXTRA: Partial<Record<ReturnReason, string>> = {
  changed_mind: 'המוצר תקין, הקונה פשוט התחרט',
  not_arrived: 'אין מוצר לשלוח בחזרה, ואנחנו מטפלים בזה מול חברת המשלוחים',
};

/**
 * The three dates a case actually turns on, as one line.
 *
 * The card used to print ONE date next to the order number — `הזמנה 4cb3f442 · 04.08.26` — and it
 * was the day the REQUEST opened, which reads exactly like the day the order was placed and is the
 * least useful of the three (owner, 2026-08-20). What decides a return is how long ago the goods
 * reached the buyer, because that is what the statutory window is measured from.
 *
 * Each part is dropped when its date is absent rather than shown empty: `delivered_at` is stamped by
 * whoever marked the order delivered, and an order that reached the buyer without anyone pressing
 * the button is a gap in our records (`returns.ts#withinStatutoryWindow` treats it the same way).
 */
/**
 * The goods this case is about, named.
 *
 * A partial return names exactly the lines coming back and says what stays; a whole-order return
 * lists the order's lines. `returnedLines` carries POSITIONS (migration 0031), which is what makes
 * the partial answerable at all — a product id would be ambiguous the moment one order holds the
 * same product twice at different variants.
 *
 * Capped at three names with a count for the rest: this is a card, not a receipt, and the order
 * itself is one click away now.
 */
/**
 * How many of the order's lines this request is about — `2 מתוך 3`.
 *
 * Asked for by the owner (2026-08-21) and it answers a question the names alone cannot: a card
 * listing two products does not say whether that IS the order or part of it, and the difference
 * decides what the seller expects to receive back. Empty when the request covers the whole order,
 * because "3 מתוך 3" beside every ordinary return is noise on the common case.
 */
function itemsCount(r: ReturnRequest): string {
  const items = orderFacts?.get(r.orderId)?.items ?? [];
  if (!items.length || !isPartialReturn(r.returnedLines)) return '';
  return `${r.returnedLines!.length} מתוך ${items.length}`;
}

/**
 * The most a partial offer may be, in SHEKELS — what the field's `max` attribute takes.
 *
 * A named function rather than `Math.floor(r.refundAgorot / 100)` written into the markup, and
 * `money-guards` is right to have refused that: a bare `/ 100` beside Hebrew copy is the exact
 * shape that has shipped agorot to a person before, and a reader cannot tell the two apart at a
 * glance. The visible placeholder goes through `formatAgorot` like every other amount on this card;
 * only the attribute — which no one reads — takes the bare number, because `max` on a number input
 * is a comparison and not a sentence.
 */
function offerCeilingShekels(agorot: number): number {
  return Math.floor(agorot / 100);
}

/** How many lines are coming back — what the approve dialog needs to say מוצר or מוצרים. */
function returningCount(r: ReturnRequest): number {
  const items = orderFacts?.get(r.orderId)?.items ?? [];
  if (isPartialReturn(r.returnedLines)) return r.returnedLines!.length;
  return items.length || 1;
}

function itemsLine(r: ReturnRequest): string {
  const items = orderFacts?.get(r.orderId)?.items ?? [];
  if (!items.length) return '';
  const name = (i: { name: string; qty: number }): string => (i.qty > 1 ? `${i.name} ×${i.qty}` : i.name);
  const list = (picked: typeof items): string => {
    const shown = picked.slice(0, 3).map(name).join(', ');
    return picked.length > 3 ? `${shown} ועוד ${picked.length - 3}` : shown;
  };
  // No "מוחזר:" prefix any more — the grid's own label says it (owner, 2026-08-20), and a value
  // that repeats its label is the noise a scannable column exists to remove. The "נשאר אצל הקונה"
  // half stays: that one is a second fact, not a restatement.
  if (isPartialReturn(r.returnedLines)) {
    const back = new Set(r.returnedLines!.map((l) => l.position));
    const returning = items.filter((i) => back.has(i.position));
    const keeping = items.filter((i) => !back.has(i.position));
    if (!returning.length) return list(items);
    return keeping.length
      ? `${list(returning)} · נשאר אצל הקונה: ${list(keeping)}`
      : list(returning);
  }
  return list(items);
}

function dateLine(r: ReturnRequest): string {
  const f = orderFacts?.get(r.orderId);
  const day = (iso: string): string => formatBusinessDateShort(iso);
  // Paid is shown only when it is NOT the day of the order, which is nearly never: the checkout
  // authorizes and captures inside one request. Four labelled dates in a row is a table, not a
  // sentence, and the one that adds nothing is the one that always repeats its neighbour.
  const paidElsewhere = f?.paidAt && day(f.paidAt) !== day(f.placedAt);
  return [
    f && `הוזמנה ${day(f.placedAt)}`,
    paidElsewhere && `שולמה ${day(f.paidAt!)}`,
    f?.deliveredAt && `נמסרה ${day(f.deliveredAt)}`,
    `הבקשה ${day(r.createdAt)}`,
  ].filter(Boolean).join(' · ');
}

/** Rows per page. Only ever rendered as a pager when the visible set exceeds it — see the nav below. */
const RETURNS_PAGE_SIZE = 20;

/**
 * Why a case is with US, in the seller's words — and the reason he needs it spelled out.
 *
 * The card said "הועבר לבדיקת המערכת. ממתין להכרעה" and then, at the bottom, "הכסף לא זז עד
 * שנחליט" — true, and it never said HOW it got there (owner, 2026-08-20: *"לא ברור בעצם מה
 * הסיבה שזה עלה להכרעה"*). Three different things put a case here and they are not remotely the
 * same event to a seller: one is his own claim about an empty parcel, one is a clock running out
 * on a parcel nobody confirmed, and one is the buyer appealing a refusal HE made. Without the
 * cause the card reads as the platform having taken his case away for no stated reason.
 *
 * Derived, never stored: `disputeCause` reads the case's own timestamps, and the admin's panel
 * shows the same three causes from the same function — so the two screens cannot come to describe
 * one case differently. The words differ because the reader does: the admin's copy asks him to
 * decide, this one tells the seller where he stands and what, if anything, is left for him to do.
 */
const DISPUTE_CAUSE: Record<DisputeCause, string> = {
  // ── The REGISTER here is the whole thing, and the first version got it wrong ──
  //
  // It read *"אתה אמרת שהחבילה הגיעה ריקה... אנחנו מכריעים"*, and the owner's verdict was
  // *"משפט גרוע, זה נשמע כמו האשמה"*. He is right, and it is not a matter of taste: "אתה אמרת"
  // and "טוען" are the words a person uses when they doubt you, on a card shown to a seller who
  // did exactly what the button told him to. The wording below is his, and the fix generalises —
  // **name the ACTION he took, never the claim he made.** "סימנת" is a fact about a button;
  // "אתה אמרת" is an account of his honesty.
  //
  // The tail was his too. It carried three more clauses — the money is frozen, there is nothing
  // for you to do, we will write if we need more — and *"זהו"* was the answer: a seller reading
  // "ממתין להכרעת המערכת" already knows all three, and spelling them out is the reassurance that
  // makes a person wonder what he is being reassured about.
  seller_claim: 'סימנת שהחבילה הגיעה ריקה או שהמוצר משומש, והקונה טען אחרת. ממתין להכרעת המערכת.',
  parcel_unconfirmed: 'לפי הקונה המוצר נשלח בחזרה, וחלפו שבועיים בלי שסומן שהגיע. ממתין להכרעת המערכת.',
  refusal_appeal: 'סירבת לבקשה, והקונה ביקש שנבדוק את הסירוב. ממתין להכרעת המערכת.',
  unknown: 'ממתין להכרעת המערכת.',
};

const open = requests.filter((r) => isOpen(r.status));
/** Open, split by whose move it is — the two halves the header counts separately. */
const mine = open.filter((r) => sellerOwesAction(r.status));
const waiting = open.filter((r) => !sellerOwesAction(r.status));
const closed = requests.filter((r) => !isOpen(r.status));
const CARD = 'border [border-color:var(--color-border)] rounded-[var(--radius-lg)] [background:var(--color-surface)] p-4';
---

<div class="dash-panel-head mb-4 py-[0.6rem] border-b [border-color:var(--color-border)] flex flex-col items-start gap-[0.6rem]">
  <div>
    <h2 class="m-0 text-[1.05rem] font-bold">החזרות</h2>
    {/* WHAT is actually waiting on him, and what is merely in flight (owner, 2026-08-20: *"זה גם
        לא נכון להגיד '13 בקשות מחכות לך' כי יש שם בקשות שלא מחכות לו! מחכות להכרעה... או שמחכות
        שהקונה ישלח את המוצר"*). Naming the reader as the person holding up eleven cases he cannot
        touch is how a seller learns to stop reading his own badge — and then the two that ARE his
        go unanswered too. `sellerOwesAction` is the same rule the tab badge counts by, so the
        number outside the panel and the number inside it cannot disagree. */}
    <p class="m-0 mt-1 text-[0.82rem] [color:var(--color-muted)]">
      {mine.length > 0 && <span class="font-semibold [color:var(--color-text)]">{heCount(mine.length, 'בקשה מחכה לך', 'בקשות מחכות לך')}</span>}
      {mine.length > 0 && waiting.length > 0 && ' · '}
      {waiting.length > 0 && `${heCount(waiting.length, 'בקשה נוספת בתהליך', 'בקשות נוספות בתהליך')}, שלא ממתינות לך`}
      {mine.length === 0 && waiting.length === 0 && 'אין בקשות פתוחות'}
    </p>
  </div>

  {requests.length > 0 && (
    <div class="dash-toolbar w-full">
      <div class="relative flex-1 min-w-[110px] max-w-[280px]">
        <svg class="absolute top-1/2 -translate-y-1/2 start-[0.7rem] pointer-events-none" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="color:var(--color-muted)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="search" id="returns-search" data-returns-search
          placeholder="חיפוש לפי מספר הזמנה…"
          class="returns-search w-full font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] ps-[1.9rem] pe-[.85rem] outline-none transition-colors duration-[120ms] focus:border-[color:var(--color-primary)]"
        />
      </div>
      {/* A CHECKBOX, not a pressed button (owner, 2026-08-20: *"וכשבוחרים נהיה שם רק קו בורדר ולא
          נראה שכל הכפתור לחוץ בכלל. לדעתי זה בכלל צריך להיות צ׳קבוקס"*). He is right about both
          halves: this is a standing "also include these", which is what a checkbox means, and the
          pressed state of a pill button on this toolbar is a border colour — legible next to a row
          of unpressed twins, invisible when it is the only one. A ticked box is unambiguous alone.

          It DISABLES itself when it cannot change anything: a shop with no closed cases, or a search
          that no closed case matches. A control that is on screen and does nothing is a control the
          seller presses twice and then distrusts — and `returns.ts` drives the state, because only
          the client knows what the current search matched. */}
      <label
        class="inline-flex items-center gap-[.45rem] text-[.82rem] cursor-pointer select-none has-[:disabled]:opacity-50 has-[:disabled]:cursor-default"
        data-returns-closed-wrap
      >
        <input
          type="checkbox" data-returns-show-closed
          class="w-[.95rem] h-[.95rem] accent-[color:var(--color-primary)] cursor-pointer disabled:cursor-default"
          disabled={closed.length === 0}
        />
        <span>הצג גם בקשות שנסגרו</span>
        {closed.length > 0 && (
          <span class="inline-flex items-center justify-center min-w-4 h-4 px-1 rounded-full bg-[color:var(--color-muted)] text-white text-[.68rem] font-bold leading-none">{closed.length}</span>
        )}
      </label>
    </div>
  )}
</div>

{requests.length === 0 && (
  <p class="m-0 py-8 text-center text-[0.9rem] [color:var(--color-muted)]">
    עוד לא ביקשו ממך להחזיר שום דבר.
  </p>
)}

{/* Only when there is something to search. With no cases at all the line above already says so,
    and rendering both left the tab stating two different emptinesses at once — the script paints
    this one the moment nothing matches, and "nothing" is what an empty tab always matches
    (owner, 2026-08-20). Absent from the DOM rather than hidden: `returns.ts` looks the element up
    and simply finds nothing, so there is no second rule about when to show it. */}
{requests.length > 0 && (
  <p class="m-0 py-6 text-center text-[0.88rem] [color:var(--color-muted)]" data-returns-empty hidden>
    אין בקשות שתואמות לחיפוש.
  </p>
)}

<div class="flex flex-col gap-3" data-returns-list data-returns-page-size={String(RETURNS_PAGE_SIZE)}>
  {[...open, ...closed].map((r) => (
    <article
      class={`${CARD}${isOpen(r.status) ? '' : ' opacity-70'}`}
      data-return-id={r.id}
      data-return-closed={isOpen(r.status) ? undefined : ''}
      data-return-order={r.orderId.slice(0, 8)}
      hidden={!isOpen(r.status)}
    >
      {/* The order number is a LINK, and it goes to the ORDER (owner, 2026-08-20: *"איך המוכר מבין
          איזו הזמנה, אלו פריטים? זה לא אינטואיטיבי בכלל"*). It was eight characters of plain text —
          true, useless, and the only thing on the card identifying what the case is about. The
          ADMIN's copy of this list links the same number to the money journal, which is right for
          him and wrong here: an admin is auditing where money went, a seller is asking what he
          packed. Same mechanism as the chip going the other way (`scripts/dashboard/panel-intent.ts`),
          so the two tabs now reach each other from both sides.
          The id in `<bdi>` because it is a Latin run inside a Hebrew line. */}
      <div>
        <strong class="block text-[0.95rem]">{statusLine(r)}</strong>
        {/* UNDER the title, not opposite it (owner, 2026-08-20: *"צריך שההזמנה הלחיצה תהיה מתחת
            לכותרת, כי כרגע זה בצד וזה קל לפספס יש שם בלאגן"*). It was the far end of a
            `justify-between` row, which is the one position on a card that competes with the
            heading instead of belonging to it: on a narrow card the row wrapped and the two
            swapped places, and on a wide one the eye reads the status and stops. Below the title it
            is the first thing after it, in reading order.

            It also LOOKS like a link at rest now. A coloured word with the underline held back for
            hover is only discoverable by pointing at it — no help on a touch screen, and his
            "easy to miss" exactly. Dotted at rest, solid on hover: one signal, changing state,
            which is the site's hover rule rather than a second effect stacked on. */}
        {/* The dates were beside the order number for a day and are not any more (owner,
            2026-08-21): with the grid's own "תאריכים" row below, the same three dates were on the
            card twice. The summary was the copy worth cutting — the row underneath is the complete
            record and the one a person reads when the dates are the question. */}
        <button
          type="button"
          class="mt-[0.35rem] text-[0.78rem] [color:var(--color-primary)] tabular-nums bg-transparent border-0 p-0 cursor-pointer underline decoration-dotted underline-offset-[3px] hover:decoration-solid"
          data-goto-panel="orders"
          data-goto-intent={`search:${r.orderId.slice(0, 8)}`}
          data-tooltip="פתח את ההזמנה בלשונית הזמנות"
        >הזמנה <bdi>{r.orderId.slice(0, 8)}</bdi></button>
      </div>

      {/* ── The facts, as a LABELLED GRID rather than a sentence (owner, 2026-08-20) ──
          *"עשית כרטיסיות שהן יותר כמו סיפור מאשר דרך לקבל מידע בשעת עומס"*, and *"לפני כל דבר
          כותרת שמסבירה מה הוא"*. He is right about the failure mode: every fact here was true and
          every one of them was buried in running prose — reason, amount and who pays the postage
          shared one sentence separated by middots, the goods were a second sentence, the dates a
          third. Reading one card told you everything; scanning nine of them for the one with a
          damaged item told you nothing, because there was no column to run your eye down.

          A `<dl>` and not a table: these are label→value pairs and one of them (the note) is a
          paragraph, which a table row handles badly. `grid-cols-[max-content_1fr]` gives the labels
          a shared right edge on every card in the list — the alignment IS the scannability — and it
          holds at 375px because the labels are two words. It degrades honestly if one ever is not:
          the value column takes the remainder rather than the row wrapping.

          Rows are dropped when they have nothing to say, never rendered empty. `<Fragment>` around
          each pair because a `<dl>` cannot hold a wrapper element between it and its own children
          without breaking the grid, and the whole point is one grid per card, not one per row. */}
      <dl class="m-0 mt-3 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-[0.45rem] text-[0.85rem] items-baseline">
        <dt class="[color:var(--color-muted)]">סיבת החזרה:</dt>
        <dd class="m-0">
          {REASON[r.reason]}{REASON_EXTRA[r.reason] && <span class="[color:var(--color-muted)]"> — {REASON_EXTRA[r.reason]}</span>}
        </dd>

        {itemsLine(r) && (
          <Fragment>
            <dt class="[color:var(--color-muted)]">פריטים בבקשה:</dt>
            <dd class="m-0">
              {itemsCount(r) && <span class="[color:var(--color-muted)] tabular-nums">{itemsCount(r)} · </span>}
              {itemsLine(r)}
            </dd>
          </Fragment>
        )}

        <dt class="[color:var(--color-muted)]">סכום לזיכוי:</dt>
        <dd class="m-0 tabular-nums font-semibold">
          {formatAgorot(r.refundAgorot)}
          {/* A partial's amount is smaller than the order and that is not a mistake — said HERE,
              beside the number that prompts the question, rather than as a separate line further
              down where it answered a question the reader had already stopped asking. */}
          {isPartialReturn(r.returnedLines) && (
            <span class="font-normal [color:var(--color-muted)]"> · החזרה חלקית, {heCount(r.returnedLines!.length, 'פריט', 'פריטים')} מתוך ההזמנה</span>
          )}
        </dd>

        <dt class="[color:var(--color-muted)]">משלוח חזרה:</dt>
        <dd class="m-0">
          {r.returnShippingPayer === 'buyer' ? 'על חשבון הקונה' : 'על חשבון החנות'}
          {isPartialReturn(r.returnedLines) && (
            <span class="[color:var(--color-muted)]"> · דמי המשלוח המקוריים אינם מוחזרים</span>
          )}
        </dd>

        {r.trackingNumber && (
          <Fragment>
            <dt class="[color:var(--color-muted)]">מספר מעקב:</dt>
            <dd class="m-0 tabular-nums">{r.trackingNumber}</dd>
          </Fragment>
        )}

        {/* The COMPLETE record, including the two the header shows. Repeating them costs a line and
            buys the thing the header cannot have: every date this case has, in one place, in order.
            The header is a summary you read at a glance; this is what you read when the dates are
            the question. */}
        {dateLine(r) && (
          <Fragment>
            <dt class="[color:var(--color-muted)]">תאריכים:</dt>
            <dd class="m-0 tabular-nums [color:var(--color-muted)] text-[0.8rem]">{dateLine(r)}</dd>
          </Fragment>
        )}

        {r.buyerNote && (
          <Fragment>
            <dt class="[color:var(--color-muted)]">הערת הקונה:</dt>
            <dd class="m-0 italic">"{r.buyerNote}"</dd>
          </Fragment>
        )}

        {/* The photo is OPTIONAL and offered only under "פגום" / "לא מה שהזמנתי" (decisions §1) — a
            picture of a change of mind answers nothing — so its ABSENCE is evidence of nothing and
            the row simply is not there. */}
        {r.buyerPhotoUrl && (
          <Fragment>
            <dt class="[color:var(--color-muted)]">תמונה מהקונה:</dt>
            <dd class="m-0">
              <a href={r.buyerPhotoUrl} target="_blank" rel="noopener noreferrer" class="inline-block">
                <img
                  src={cdnThumb(r.buyerPhotoUrl, 160, 160)}
                  alt="התמונה שהקונה צירף"
                  width="72" height="72" loading="lazy" decoding="async"
                  class="rounded-[var(--radius-sm)] border [border-color:var(--color-border)] object-cover"
                />
              </a>
            </dd>
          </Fragment>
        )}

        {r.sellerNote && (
          <Fragment>
            <dt class="[color:var(--color-muted)]">מה שכתבת:</dt>
            <dd class="m-0 italic">"{r.sellerNote}"</dd>
          </Fragment>
        )}

        {r.sellerPhotoUrl && (
          <Fragment>
            <dt class="[color:var(--color-muted)]">התמונה שצירפת:</dt>
            <dd class="m-0">
              <a href={r.sellerPhotoUrl} target="_blank" rel="noopener noreferrer" class="inline-block">
                <img
                  src={cdnThumb(r.sellerPhotoUrl, 160, 160)}
                  alt="התמונה שצירפת לטענה"
                  width="72" height="72" loading="lazy" decoding="async"
                  class="rounded-[var(--radius-sm)] border [border-color:var(--color-border)] object-cover"
                />
              </a>
            </dd>
          </Fragment>
        )}
      </dl>

      {/* What happens WHEN it arrives — the question an approved card left him holding (owner,
          2026-08-20: *"צריך במקרה כזה לרשום הסבר למוכר, מה השלב הבא, כלומר, מה יקרה כשהמוצר יגיע
          אליו?"*). The deadline line below says when the case closes if the parcel never comes; it
          never said what to DO if it does, and that is the whole of the seller's part in an
          auto-approved return. Only on the two states where the parcel is still travelling — once
          it is in his hands the buttons themselves say it. */}
      {(r.status === 'approved' || r.status === 'in_transit') && (
        <p class="m-0 mt-2 text-[0.8rem] [color:var(--color-muted)]">
          כשהחבילה תגיע אליך, סמן "המוצר הגיע אליי". מאותו רגע יש לך יומיים לבדוק אותה: אם הכול
          תקין, החזר לקונה את הכסף. ואם החבילה הגיעה ריקה או שהמוצר משומש, אפשר להעביר את המקרה
          להכרעה שלנו.
        </p>
      )}

      {deadlineLine(r) && (
        <p class={`m-0 mt-2 text-[0.82rem] font-semibold [color:var(--color-${TONE[r.status] === 'danger' ? 'danger' : 'warning'})]`}>
          {deadlineLine(r)}
        </p>
      )}

      {/* What the offer button IS, said on the one card that shows it (owner, 2026-08-20: *"הצע החזר
          חלקי במקום החזרה? לא הבנתי באיזה שלב זה בא כי אני רואה שכבר על כרטיסייה של 'אישרת' יש את
          זה, אז זה לא ברור בכלל"*). His confusion was the button appearing on a case he had just
          approved, which looks like two contradictory answers offered at once — and the machine
          agrees with him about where it belongs: `offered` is reachable from `approved` and from
          nowhere else (`returns.ts#RETURN_TRANSITIONS`), i.e. it is a shortcut THROUGH an approved
          return, never a way around the decision. Saying that on the card is cheaper than moving the
          button, and moving it would leave the shortcut unreachable.

          The WORDING is his (2026-08-20): the line said what happens without saying it needs the
          buyer's AGREEMENT, and said nothing about what happens if the buyer never answers.
          `OFFER_ANSWER_DAYS` is that answer, and it is named here rather than left to the deadline
          line — the seller reads this BEFORE making the offer, when there is no deadline yet. */}
      {movesFor(r.status).some((m) => m.to === 'offered') && (
        <p class="m-0 mt-3 text-[0.8rem] [color:var(--color-muted)]">
          אפשר להציע לקונה החזר כספי חלקי במקום שיחזיר את המוצר, אם יסכים לכך. אם לא ישיב תוך
          {OFFER_ANSWER_DAYS} ימים, הבקשה תיסגר והכסף יישאר אצלך.
        </p>
      )}

      {movesFor(r.status).length > 0 && (
        <div class="flex gap-2 mt-3 flex-wrap">
          {movesFor(r.status).map((m) => (
            <button
              type="button"
              class={`btn btn--sm ${m.kind === 'accent' ? 'btn--accent' : ''}`}
              data-return-move={m.to}
              data-return-target={r.id}
              data-return-amount={formatAgorot(r.refundAgorot)}
              data-return-items={String(returningCount(r))}
            >{m.label}</button>
          ))}
        </div>
      )}

      {/* ── The empty-parcel claim has to say what was in the box ── (owner, 2026-08-20)
          Hidden until "הגיע ריק או משומש" is pressed, for the same reason the offer's amount is:
          a question on every card that does not need one is a question nobody reads.

          The SENTENCE is required and `/api/returns` refuses the move without it — this is the one
          move in the mechanism that is a claim about goods only the seller has seen, and it used to
          travel to a person carrying nothing while the buyer's side of the same case carried a note
          AND a photo. The PICTURE is optional on both sides deliberately: an empty carton
          photographs as an empty carton whoever emptied it, so it informs a decision and never
          settles one, and demanding it would bar an honest seller with no camera to hand.

          `has-[textarea[hidden]]:!hidden` on the wrapper, driven off the field's own `hidden` —
          the same one piece of state `returns.ts` reads to tell a first press from a second, rather
          than a second flag two files would have to agree about. `!hidden` because the wrapper is
          `flex` (memory `project_tailwind_hidden_vs_flex`). */}
      {movesFor(r.status).some((m) => m.to === 'disputed') && (
        <div class="flex flex-col gap-2 mt-2 has-[textarea[hidden]]:!hidden" data-dispute-wrap>
          <label class="flex flex-col gap-1 text-[0.85rem]">
            <span class="[color:var(--color-muted)]">ספר לנו מה היה בחבילה — זה מה שנכריע לפיו</span>
            <textarea
              rows="2"
              class="w-full px-2 py-1 border [border-color:var(--color-border)] rounded-[var(--radius-sm)] [background:var(--color-surface-2)] [color:var(--color-text)] resize-none"
              data-dispute-note
              hidden
              placeholder="הקרטון הגיע חתוך והמוצר לא היה בפנים"
            ></textarea>
          </label>
          {cloudName && cloudPreset && (
            <label class="flex flex-col gap-1 text-[0.8rem] [color:var(--color-muted)]">
              <span>אפשר לצרף תמונה. זו אינה חובה, אבל היא עוזרת לנו להכריע</span>
              <input type="file" accept="image/*" class="text-[0.78rem]" data-dispute-photo data-cloud-name={cloudName} data-cloud-preset={cloudPreset} />
              <span class="text-[0.78rem]" data-dispute-photo-state></span>
            </label>
          )}
        </div>
      )}

      {/* The offer's amount. Hidden until "הצע כסף במקום החזרה" is pressed — a field asking for a
          number the seller has not decided to give is a question on every card that does not need
          one. In shekels, because that is what a person types; the script converts at the boundary.

          **The LABEL hides with it, via `has-[input[hidden]]:!hidden`, and that was missing** — only
          the `<input>` carried `hidden`, so every approved case rendered the caption "סכום ההחזר
          המוצע, בשקלים" with no field beside it: a line of prose that reads as a broken control
          (found by looking at the seeded scenario board, owner 2026-08-20). Driven off the field's
          own `hidden` rather than a second flag the script also toggles — that attribute is already
          the one piece of state saying whether an offer has been asked for, and `returns.ts` reads
          it to tell a first press from a second. `!hidden`, because this label is `flex` and an
          unimportant `hidden` utility loses to it (memory `project_tailwind_hidden_vs_flex`). */}
      {movesFor(r.status).some((m) => m.to === 'offered') && (
        <div class="flex flex-wrap items-center gap-2 mt-2 text-[0.85rem] has-[input[hidden]]:!hidden" data-offer-wrap>
          <label class="flex items-center gap-2">
            <span class="[color:var(--color-muted)]">סכום ההחזר המוצע, בשקלים</span>
            {/* A CEILING the field itself enforces (owner, 2026-08-21). The server has always
                clamped to the case's full refund (`/api/returns`, `offerCeilingAgorot`) — but
                silently, so a seller could type 900 on a 49 ₪ return, press send, and be told
                nothing about the number that was actually stored. `max` stops the arrows and the
                script refuses above it in words, which is the same rule said three times in the one
                order a person meets it. The placeholder names the ceiling rather than "₪", because
                a limit you can see before typing is not a limit you hit. */}
            <input
              type="number" min="1" step="1" inputmode="numeric"
              max={offerCeilingShekels(r.refundAgorot)}
              class="w-24 px-2 py-1 border [border-color:var(--color-border)] rounded-[var(--radius-sm)] [background:var(--color-surface-2)] [color:var(--color-text)]"
              data-offer-amount
              hidden
              placeholder={`עד ${formatAgorot(r.refundAgorot)}`}
            />
          </label>
          {/* WHERE TO PRESS. The first press on "הצע החזר חלקי" opened a field and the same button
              then sent it — which the owner worked out and still called unclear, correctly: a
              revealed field with no button beside it looks like it is waiting for Enter, and the
              button that opened it has already been "used". Two explicit ones, and a way out that
              is not "reload the page". */}
          <button type="button" class="btn btn--sm btn--accent" data-offer-send>שלח את ההצעה</button>
          <button type="button" class="btn btn--sm" data-offer-cancel>ביטול</button>
        </div>
      )}

      {/* The AMOUNT only. The status line at the top already says an offer was made and that we are
          waiting for an answer; repeating that here in longer words is the shape the owner called
          מסורבל. (And this comment sits OUTSIDE the `&& (…)` on purpose — inside it, it is a second
          sibling with no fragment around it, which is the silent `.astro` compile failure that
          answers every route with a 404 and names no file. See scripts/verify.mjs's header.) */}
      {r.status === 'offered' && r.partialOfferAgorot !== null && (
        <p class="m-0 mt-2 text-[0.82rem]">
          הסכום שהצעת: <strong class="tabular-nums">{formatAgorot(r.partialOfferAgorot)}</strong>
        </p>
      )}

      {r.status === 'disputed' && (
        <p class="m-0 mt-2 text-[0.8rem] [color:var(--color-muted)]">{DISPUTE_CAUSE[disputeCause(r)]}</p>
      )}
    </article>
  ))}
</div>

<nav class="flex items-center justify-center gap-2 mt-4" data-returns-pager hidden aria-label="עמודים">
  <button type="button" class="btn btn--sm" data-returns-prev>הקודם</button>
  <span class="text-[0.8rem] [color:var(--color-muted)] tabular-nums" data-returns-page-label></span>
  <button type="button" class="btn btn--sm" data-returns-next>הבא</button>
</nav>
