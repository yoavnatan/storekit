      closeOffer(key);
      delete orphans[key];
      try { localStorage.removeItem(key); } catch { /* private mode — nothing was stored */ }
      refreshNotice();
      if (window.__dashMarkDraftRows) window.__dashMarkDraftRows();
    };

    /** Write every pending debounced draft NOW. The 700ms window is generous while a page sits
     *  still and exactly wrong at the moment something is about to destroy the form — a table
     *  rebuild, a tab going away. Both callers are about to take the fields out of reach. */
    window.__dashFlushDrafts = function () {
      var forms = document.querySelectorAll('form[data-unsaved-guard][data-draft-live]');
      for (var i = 0; i < forms.length; i++) {
        if (timers[keyFor(forms[i])]) save(forms[i]);   // save() cancels the timer it supersedes
      }
    };

    window.__dashDraftProducts = function () {
      var out = [];
      for (var k in orphans) out.push(orphans[k].record);
      return out;
    };

    window.__dashScanDrafts = function (root) {
      scanForms(root || document);
      // A panel or a row that just arrived may be the home of a draft this was naming from the
      // outside a moment ago — that draft now has a form, and its own bar takes over.
      pruneOrphans();
      watchNotice();
      // The table's marks are drawn from `orphans`, and a row arriving is the one thing that takes
      // an entry out of it — so the mark on that row has to go in the same breath.
      if (window.__dashMarkDraftRows) window.__dashMarkDraftRows();
    };

    document.addEventListener('DOMContentLoaded', function () {
      wireNoticeButtons();
      // A scan describes ONE document: all three of these are "since this page loaded", so a
      // re-scan that inherited them would measure his typing against a form that no longer exists.
      // The marker goes too — it is what makes the SCOPED rescan below additive, and on a fresh
      // document there is nothing for it to protect.
      offers = {};
      touched = {};
      var seen = document.querySelectorAll('form[data-draft-live]');
      for (var s = 0; s < seen.length; s++) seen[s].removeAttribute('data-draft-live');
      scanForms(document);
      scanOrphans();
      watchNotice();
      if (window.__dashMarkDraftRows) window.__dashMarkDraftRows();
    });
  })();
</script>
