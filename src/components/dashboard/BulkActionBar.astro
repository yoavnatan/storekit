---
/**
 * What you can do with the rows you ticked, as a bar that rises from the bottom of the screen.
 *
 * Owner, 2026-08-23: *"סרגל פעולות צף: מסמנים שורות בטבלה, סרגל עולה מלמטה עם 'נבחרו 3'
 * ומחיקה/עריכה/העלאה, במקום שהכפתורים בראש הדף יתחלפו."*
 *
 * **These are the same four buttons, moved — every id is unchanged.** `initBulkSelect`,
 * `promotions.ts`'s discount panel, the image-panel freeze and `refreshBulkEditLabel` all find
 * their controls exactly where they always did, so none of that logic is touched by this. The one
 * new line in `updateBar` shows and hides this element.
 *
 * **Why the top of the page was the wrong place**, beyond his asking: the toolbar there had to
 * hold three permanent buttons AND four that appear on a tick, on one row, on every width — which
 * is why it grew a horizontal scroller, two steps of label-shedding and a divider. All of that was
 * paying for a collision that only exists if both sets share a row. Down here the selection's
 * actions have the width to keep their words, and the toolbar above keeps a fixed shape that never
 * changes under the seller's hand. The compaction rules went with the collision.
 *
 * It floats over the page, so it is one of the few things in this design that earns a shadow
 * (elevation rule, base/tokens.css) — and it is `position: fixed`, which is what makes it reachable
 * without scrolling back up after ticking a row eight hundred rows down.
 */
import { getLang, getT } from '../../i18n/index.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const d = t.dashboard;
---

{/* No `hidden` attribute: the stylesheet has this `visibility: hidden` and off the bottom of the
    screen until `is-on` arrives, so a table with nothing selected never paints it even for a
    frame, and nothing has to be un-hidden before it can animate. `aria-live` on the count alone,
    so a screen reader hears the number change rather than the whole bar being read out again on
    each tick. */}
<div id="bulk-bar" class="bulk-bar" role="group" aria-label={d.bulkBarLabel}>
  <button type="button" id="bulk-clear" class="bulk-bar__clear" aria-label={d.bulkClear}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <span class="bulk-bar__count" aria-live="polite" aria-atomic="true">
    <strong id="bulk-count">0</strong> {d.bulkSelected}
  </span>
  <span class="bulk-bar__sep" aria-hidden="true"></span>
  <button id="bulk-edit-btn" type="button" class="btn btn--sm bulk-btn" aria-label={d.bulkEdit}>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    <span id="bulk-edit-label" class="bulk-btn__label" aria-hidden="true">{d.bulkEdit}</span>
  </button>
  <button id="bulk-upload-btn" type="button" class="btn btn--sm bulk-btn" aria-label={d.bulkUploadImages}>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    <span id="bulk-upload-label" class="bulk-btn__label" aria-hidden="true">{d.bulkUploadImages}</span>
  </button>
  <button id="bulk-discount-btn" type="button" class="btn btn--sm bulk-btn" aria-label={d.bulkDiscountTitle}>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
    <span class="bulk-btn__label" aria-hidden="true">{d.bulkDiscount}</span>
  </button>
  {/* Last, and the only one with a fill: the destructive action sits at the far end of the row so
      it is never the neighbour of the one you meant to press. */}
  <button id="bulk-delete-btn" type="button" class="btn btn--sm btn--danger bulk-btn !bg-[color:var(--color-danger)] hover:opacity-90" aria-label={d.bulkDelete}>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
    <span class="bulk-btn__label" aria-hidden="true">{d.bulkDelete}</span>
  </button>
</div>
