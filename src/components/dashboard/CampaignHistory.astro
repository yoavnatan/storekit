---
/** The store's finished and cancelled campaigns — the read-only half of the Advertising tab,
 *  shared by the seller's own tab and the admin's per-store twin.
 *
 *  It exists because a campaign that stops is not a campaign that never happened: it spent money,
 *  and every reported figure on this platform is derived from the campaign list, so erasing the
 *  row rewrote what a past month's ad spend had been. Keeping it also answers the only question a
 *  seller actually asks between campaigns — "which one worked?" — which he cannot answer from a
 *  list that only shows what is running right now.
 *
 *  Collapsed by default and free of buttons: history informs, it never invites an action. The
 *  cards themselves are drawn by the same client renderer as the live list
 *  (scripts/dashboard/advertising.ts), which fills this list from the same GET response.
 */
import type { getT } from '../../i18n/index.js';

interface Props {
  d: ReturnType<typeof getT>['dashboard'];
}
const { d } = Astro.props;
---

<details id="ad-history" class="mt-4 border [border-color:var(--color-border)] rounded-[var(--radius)]">
  <summary class="text-[0.85rem] font-semibold px-3 py-2.5 cursor-pointer select-none [color:var(--color-text)]">
    {d.adHistoryTitle}
  </summary>
  <div class="px-3 pb-3">
    <p class="muted text-[0.78rem] m-0 mb-3">{d.adHistoryHint}</p>
    <div id="ad-history-list" class="flex flex-col gap-3">
      <p class="muted text-[0.85rem] m-0">{d.adHistoryEmpty}</p>
    </div>
  </div>
</details>
