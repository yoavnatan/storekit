---
// Store-creation card — ONE form for both entry points so they can never drift:
//   • a seller with no store at all (`first`), and
//   • an existing seller opening an additional store (?new=1 on the dashboard).
// Both POST `_action=create-store` back to /seller/dashboard, which redirects to the new store.
import { getLang, getT } from '../../i18n/index.js';
import StoreCategoryPicker from '../StoreCategoryPicker.astro';
import CsrfField from '../CsrfField.astro';
import { BUSINESS_TYPES } from '../../lib/payout-details.js';
import { store as platformConfig } from '../../config/store.config';

interface Props {
  /** Shared category vocabulary for the picker (see lib/store-taxonomy.ts). */
  vocabulary?: readonly string[];
  /** true = the seller's very first store (different heading + no way back). */
  first: boolean;
  error?: string;
}
const { first, error = '' , vocabulary = [] } = Astro.props;
const lang = getLang(Astro.cookies);
const d = getT(lang).dashboard;
const host = new URL(platformConfig.url).hostname;
/** Same three labels the payments tab's copy of this form uses — one wording for one field. */
const TYPE_LABEL: Record<string, string> = {
  exempt: d.payBusinessExempt,
  licensed: d.payBusinessLicensed,
  company: d.payBusinessCompany,
};
---

<section class="section container">
  <div class="card" style="max-width:520px;margin:2rem auto;padding:2.5rem 2rem;text-align:center">
    {error && <p class="dash-error bg-[#fef2f2] text-[color:var(--color-danger)] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#fecaca] text-sm" style="margin-bottom:1.5rem;text-align:start">{error}</p>}
    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-accent);margin:0 auto 1.25rem;display:block" aria-hidden="true">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <h1 style="font-size:1.5rem;margin:0 0 0.5rem">{first ? d.noStoreTitle : d.addStore}</h1>
    <p class="muted" style="margin-bottom:2rem">{first ? d.noStoreDesc : d.addStoreDesc}</p>
    {/* data-native-submit: this one really is a browser POST back to the page, which answers
        with a redirect to the new store (see dashboard/FormFallbackGuard.astro). */}
    <form method="POST" class="mt-4" style="text-align:start" data-native-submit>
      <CsrfField />
      <input type="hidden" name="_action" value="create-store" />
      <label class="field">
        <span>{d.storeNameReq}</span>
        <input class="input" name="name" required placeholder={d.storeNamePlaceholder} autofocus />
      </label>
      <label class="field">
        <span>{d.storeUrlLabel}</span>
        {/* dir="auto" so a Hebrew slug types right-to-left; the PREVIEW below stays ltr because
            the address as a whole reads host-then-path, with bidi laying the Hebrew run out inside it. */}
        <input class="input" name="slug" id="create-store-slug" required placeholder="my-store" dir="auto" autocomplete="off" spellcheck="false" data-host={host} />
        <p class="muted text-[0.78rem] mt-1" style="text-align:start">{d.storeUrlHint} · <span id="create-store-url-preview" dir="ltr" class="font-mono [color:var(--color-text)]">{`${host}/my-store`}</span></p>
        <p class="muted text-[0.78rem] mt-1 leading-[1.5]" style="text-align:start">{d.storeUrlHebrewNote}</p>
      </label>
      <div class="field">
        <span>{d.storeCategories}</span>
        <StoreCategoryPicker vocabulary={vocabulary} id="create-store-cats" />
      </div>

      {/* ── Bank details, HERE, and skippable (owner, 2026-08-11) ──
          This reverses the standing "never at store-opening" reading of `feedback_seller_form_burden`,
          on his instruction: *"אני גם חושב שזה כן צריך להיות חלק מההרשמה… או שזה יהיה חלק שאפשר
          לדלג עליו אבל שהוא כן יופיע"*. The rule's PURPOSE is intact and is what shapes this block —
          nothing here is `required`, the form submits empty, and the heading says so before the
          first field. What changes is that the seller now MEETS the question at the moment they are
          thinking about getting paid, instead of discovering it weeks later behind a banner.
          The four bank fields are still all-or-nothing as a UNIT (`parsePayoutDetails`), so a
          half-filled block is refused rather than half-saved. */}
      <details class="mt-2 border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
        <summary class="cursor-pointer text-[0.9rem] font-semibold list-none">{d.createStoreBankTitle}</summary>
        <p class="muted text-[0.78rem] mt-1 mb-2 leading-[1.5]">{d.createStoreBankHint}</p>
        <div class="grid gap-3 sm:grid-cols-2">
          {/* `dir="ltr"` + numeric: ASCII digits on an RTL page group the wrong way round if left
              to inherit — the same reason the payments tab's copy of this form carries them. */}
          <label class="field">
            <span class="text-[0.85rem]">{d.payBankCode}</span>
            <input class="input" name="bankCode" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="2" />
          </label>
          <label class="field">
            <span class="text-[0.85rem]">{d.payBankBranch}</span>
            <input class="input" name="bankBranch" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="3" />
          </label>
          <label class="field">
            <span class="text-[0.85rem]">{d.payBankAccount}</span>
            <input class="input" name="bankAccount" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="20" />
          </label>
          <label class="field">
            <span class="text-[0.85rem]">{d.payBankHolder}</span>
            <input class="input" name="bankAccountHolder" autocomplete="off" maxlength="120" />
          </label>
          <label class="field">
            <span class="text-[0.85rem]">{d.payBusinessId}</span>
            <input class="input" name="businessId" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="9" />
          </label>
          <label class="field">
            <span class="text-[0.85rem]">{d.payBusinessType}</span>
            <select class="input" name="businessType">
              <option value="">{d.payBusinessNone}</option>
              {BUSINESS_TYPES.map((t) => <option value={t}>{TYPE_LABEL[t]}</option>)}
            </select>
          </label>
        </div>
      </details>

      <button class="btn btn--accent" type="submit" style="width:100%;margin-top:0.25rem">{d.createStoreBtn}</button>
    </form>
    {!first && (
      <p class="mt-4 mb-0 text-[0.82rem]">
        <a href="/seller/dashboard" class="[color:var(--color-muted)] no-underline hover:underline">{d.backToDashboard}</a>
      </p>
    )}
  </div>
</section>

<script>
  // This card renders on its own page (no store yet), so the dashboard's own init
  // never runs here — the picker has to be armed locally.
  import { initAllStoreCategoryPickers } from '../../scripts/store-category-picker.js';
  import { trimDashes, slugChars } from '../../lib/url-base.js';
  initAllStoreCategoryPickers();

  // Live-sanitize the store-URL field to a valid slug + preview the full address as the seller
  // types. Server re-normalizes on submit (see normalizeSlug), so this is only a nicety.
  const slugInput = document.getElementById('create-store-slug') as HTMLInputElement | null;
  const preview = document.getElementById('create-store-url-preview');
  if (slugInput) {
    const host = slugInput.dataset.host ?? '';
    // slugChars, not a private character class — it is the server's own rule (url-base.ts), so the
    // field can never delete something normalizeSlug would have kept. Hebrew included: the seller
    // may type it, and the hint beside the field is where the trade-off is stated.
    const clean = (v: string) => slugChars(v).replace(/\s+/g, '-').replace(/-+/g, '-');
    const update = () => {
      const pos = slugInput.selectionStart;
      slugInput.value = clean(slugInput.value);
      try { slugInput.setSelectionRange(pos, pos); } catch { /* ignore */ }
      // trimDashes, not `^-+|-+$` — this runs per keystroke on the raw field, where that form is
      // quadratic and a pasted run of dashes freezes the tab (url-base.ts#trimDashes).
      if (preview) preview.textContent = `${host}/${trimDashes(slugInput.value) || 'my-store'}`;
    };
    slugInput.addEventListener('input', update);
  }
</script>
