---
// Store-creation card — ONE form for both entry points so they can never drift:
//   • a seller with no store at all (`first`), and
//   • an existing seller opening an additional store (?new=1 on the dashboard).
// Both POST `_action=create-store` back to /seller/dashboard, which redirects to the new store.
import { getLang, getT } from '../../i18n/index.js';
import StoreCategoryPicker from '../StoreCategoryPicker.astro';
import { store as platformConfig } from '../../config/store.config';

interface Props {
  /** Shared category vocabulary for the picker (see lib/store-taxonomy.ts). */
  vocabulary?: readonly string[];
  /** true = the seller's very first store (different heading + no way back). */
  first: boolean;
  error?: string;
}
const { first, error = '' , vocabulary = [] } = Astro.props;
const lang = getLang(Astro.cookies);
const d = getT(lang).dashboard;
const host = new URL(platformConfig.url).hostname;
---

<section class="section container">
  <div class="card" style="max-width:520px;margin:2rem auto;padding:2.5rem 2rem;text-align:center">
    {error && <p class="dash-error bg-[#fef2f2] text-[color:var(--color-danger)] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#fecaca] text-sm" style="margin-bottom:1.5rem;text-align:start">{error}</p>}
    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-accent);margin:0 auto 1.25rem;display:block" aria-hidden="true">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <h1 style="font-size:1.5rem;margin:0 0 0.5rem">{first ? d.noStoreTitle : d.addStore}</h1>
    <p class="muted" style="margin-bottom:2rem">{first ? d.noStoreDesc : d.addStoreDesc}</p>
    <form method="POST" class="mt-4" style="text-align:start">
      <input type="hidden" name="_action" value="create-store" />
      <label class="field">
        <span>{d.storeNameReq}</span>
        <input class="input" name="name" required placeholder={d.storeNamePlaceholder} autofocus />
      </label>
      <label class="field">
        <span>{d.storeUrlLabel}</span>
        <input class="input" name="slug" id="create-store-slug" required placeholder="my-store" dir="ltr" autocomplete="off" spellcheck="false" data-host={host} />
        <p class="muted text-[0.78rem] mt-1" style="text-align:start">{d.storeUrlHint} · <span id="create-store-url-preview" dir="ltr" class="font-mono [color:var(--color-text)]">{`${host}/my-store`}</span></p>
      </label>
      <div class="field">
        <span>{d.storeCategories}</span>
        <StoreCategoryPicker vocabulary={vocabulary} id="create-store-cats" />
      </div>
      <button class="btn btn--accent" type="submit" style="width:100%;margin-top:0.25rem">{d.createStoreBtn}</button>
    </form>
    {!first && (
      <p class="mt-4 mb-0 text-[0.82rem]">
        <a href="/seller/dashboard" class="[color:var(--color-muted)] no-underline hover:underline">{d.backToDashboard}</a>
      </p>
    )}
  </div>
</section>

<script>
  // This card renders on its own page (no store yet), so the dashboard's own init
  // never runs here — the picker has to be armed locally.
  import { initAllStoreCategoryPickers } from '../../scripts/store-category-picker.js';
  initAllStoreCategoryPickers();

  // Live-sanitize the store-URL field to a valid slug + preview the full address as the seller
  // types. Server re-normalizes on submit (see normalizeSlug), so this is only a nicety.
  const slugInput = document.getElementById('create-store-slug') as HTMLInputElement | null;
  const preview = document.getElementById('create-store-url-preview');
  if (slugInput) {
    const host = slugInput.dataset.host ?? '';
    const clean = (v: string) => v.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
    const update = () => {
      const pos = slugInput.selectionStart;
      slugInput.value = clean(slugInput.value);
      try { slugInput.setSelectionRange(pos, pos); } catch { /* ignore */ }
      if (preview) preview.textContent = `${host}/${slugInput.value.replace(/^-+|-+$/g, '') || 'my-store'}`;
    };
    slugInput.addEventListener('input', update);
  }
</script>
