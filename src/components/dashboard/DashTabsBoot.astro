---
/**
 * Tab switching that does NOT wait for the page's JS bundle.
 *
 * Every `.dash-tabs` / `.dash-panel` shell (seller dashboard, /admin, homepage)
 * has its panels server-rendered with `hidden` already set, so the ONLY thing a
 * tab click needs is a few DOM attribute flips. That work used to live inside
 * `initDashTabs()` in the page's hoisted module — which on the seller dashboard
 * means ~61 KB gzipped of dashboard code has to arrive and parse before a tab
 * responds at all. On a weak mobile connection that is seconds of a page that
 * looks finished and answers nothing (owner, 2026-07-31: "הכל תקוע").
 *
 * So the activation itself lives here, inline in the HTML: zero network, runs
 * during parse, interactive the moment the strip paints. `initDashTabs()` keeps
 * only what genuinely needs the module (keyboard arrows, the overflow edge
 * fades, wheel→horizontal scroll) and calls `window.__dashTabActivate` rather
 * than re-implementing it — one copy of the rule, not two.
 *
 * A page that renders a tab strip MUST render this component too, or the strip
 * is dead: enforced by `tests/dash-tabs-boot.test.ts`.
 *
 * The replay on `DOMContentLoaded`: panels lazy-load their contents off the
 * bubbling `dashtab:show` event (performance, advertising, promotions, the
 * admin URL-param cleanup, the homepage tab indicator). A tab activated before
 * the module ran fired that event into a page with no listeners yet, so the
 * panel would open empty. Deferred module scripts all execute *before*
 * `DOMContentLoaded`, so re-firing it there reaches every listener exactly once.
 */
---
<script is:inline>
  (function () {
    var earlyPanel = null;
    var hydrated = false;

    /**
     * Keep a tab horizontally visible inside an overflowing strip — by scrolling
     * the STRIP, never the page.
     *
     * This used to be `tab.scrollIntoView({block:'nearest', inline:'nearest'})`,
     * which looks safe and is not: the seller dashboard's strip is `position:
     * sticky`, and scrollIntoView targets an element's STATIC position, so the
     * browser scrolled the whole document back up to where the strip would sit
     * unstuck — near the top. On a refresh (which restores the seller's scroll)
     * that read as the page jumping down, up, and down again: restore → this call
     * → the browser re-applying its restoration a frame later (owner, 2026-07-31).
     * Adjusting `scrollLeft` by the visual overshoot does the one thing that was
     * ever wanted and cannot touch the vertical axis. It is direction-agnostic:
     * RTL reports scrollLeft negative, but in both directions a POSITIVE delta
     * moves the view toward the visual right.
     *
     * "Visible" here means visible ENOUGH TO READ, not "its box overlaps the
     * strip's". Landing the tab flush against the edge parks it under the 1.8rem
     * edge fade, which is painted precisely to dissolve whatever reaches that
     * edge — so the tab the seller is ON came back from a refresh half washed out
     * at the rim, which is the same as not knowing where you are (owner,
     * 2026-08-11). So the target is an inset band: the tab must clear the edge by
     * `insetOf()` on any side that still has strip left to scroll. A side that is
     * fully scrolled has no fade lit and needs no inset, which is what keeps the
     * first and last tabs resting flush instead of being pushed off their end.
     */
    function insetOf(strip) {
      // Half a tab's worth of breathing room, so the neighbour peeks and the
      // active tab reads as inside the strip rather than falling off it. Capped
      // at a fifth of a narrow strip: on a 320px phone a fixed 64px would be a
      // fifth of the visible width spent on margin at each end.
      return Math.min(64, strip.clientWidth * 0.2);
    }

    /** How much strip is hidden past each VISUAL edge. RTL runs scrollLeft from
     *  -max (end) to 0 (start), and its start is the right-hand side. */
    function hiddenSides(strip, rtl) {
      var max = strip.scrollWidth - strip.clientWidth;
      var sl = Math.abs(strip.scrollLeft);
      return rtl ? { left: max - sl, right: sl } : { left: sl, right: max - sl };
    }

    window.__dashTabReveal = function (tab) {
      var strip = tab.closest('.dash-tabs');
      if (!strip || strip.scrollWidth <= strip.clientWidth + 1) return;
      var t = tab.getBoundingClientRect(), s = strip.getBoundingClientRect();
      var rtl = getComputedStyle(strip).direction === 'rtl';
      var hidden = hiddenSides(strip, rtl), inset = insetOf(strip);
      var left = s.left + (hidden.left > 1 ? inset : 0);
      var right = s.right - (hidden.right > 1 ? inset : 0);
      // Already inside the band: move nothing. A tab that is comfortably on
      // screen must not slide because something re-ran this (no-op interactions
      // are invisible).
      if (t.left >= left && t.right <= right) return;
      // A tab WIDER than the band (a long label on a narrow phone) can satisfy
      // neither edge. Pin its READING start — the side its label begins on — and
      // let the tail run under the far fade. Without this branch the two tests
      // below both stay true forever and each re-assert flips the strip to the
      // other edge.
      if (t.width > right - left) strip.scrollLeft += rtl ? t.right - right : t.left - left;
      else if (t.left < left) strip.scrollLeft += t.left - left;
      else strip.scrollLeft += t.right - right;
    };

    /**
     * Put the strip where the OPEN tab is — on load, and again after the browser
     * has had its say.
     *
     * A reload restores a scroller's own offset, and the browser applies that
     * restoration on its own schedule (after layout, around `load`), so a
     * position written at parse time is simply overwritten a few frames later.
     * What came back was wherever the strip happened to sit when the seller
     * pressed refresh — with a different panel open, that is an arbitrary tab,
     * and the active one could be off screen entirely. Re-asserting at each point
     * the geometry can still change (DOM ready → fonts swapped → load) is what
     * makes the answer stable rather than a race.
     *
     * `data-tab-scrolled` is the off switch: the moment the seller touches the
     * strip themselves — a wheel, a drag, a tab click — their position is the
     * right one and a later re-assert would be the page yanking the strip out
     * from under them.
     */
    window.__dashTabRestore = function (strip) {
      var strips = strip ? [strip] : document.querySelectorAll('.dash-tabs');
      for (var i = 0; i < strips.length; i++) {
        if (strips[i].hasAttribute('data-tab-scrolled')) continue;
        var active = strips[i].querySelector('.dash-tab--active');
        if (active) window.__dashTabReveal(active);
      }
    };

    function markScrolled(e) {
      var el = e.target instanceof Element ? e.target.closest('.dash-tabs') : null;
      if (el) el.setAttribute('data-tab-scrolled', '');
    }
    // Capture, and the gestures that MOVE a strip — not `scroll`, which our own
    // writes (and the browser's restoration) fire too, and which would therefore
    // switch the restore off before it ever ran.
    for (var g = 0, gestures = ['pointerdown', 'wheel', 'touchstart', 'keydown']; g < gestures.length; g++) {
      document.addEventListener(gestures[g], markScrolled, { capture: true, passive: true });
    }

    function restoreSoon() { requestAnimationFrame(function () { window.__dashTabRestore(); }); }
    // Now (this script is rendered after its strip, so on the seller dashboard
    // the tabs already exist and the placement is right in the first paint),
    // then at every later point the measurement can still change.
    window.__dashTabRestore();
    document.addEventListener('DOMContentLoaded', restoreSoon);
    window.addEventListener('load', restoreSoon);
    // A tab's width changes when Heebo swaps in (main.css), which moves every tab
    // after it — a strip placed against fallback metrics is placed against the
    // wrong ones.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(restoreSoon);

    window.__dashTabActivate = function (tab) {
      var name = tab.getAttribute('data-panel') || '';
      var tabs = document.querySelectorAll('[role="tab"][data-panel]');
      for (var i = 0; i < tabs.length; i++) {
        tabs[i].classList.remove('dash-tab--active');
        tabs[i].setAttribute('aria-selected', 'false');
        tabs[i].setAttribute('tabindex', '-1');
      }
      // `dashtab:hide` is the mirror of the `dashtab:show` below, and it is dispatched only for a
      // panel that really WAS visible — a broadcast to nine already-hidden panels would make
      // "your tab is being left" fire eight times for something that never happened. Same
      // bubbling + inert-unless-listened-to contract: the Orders tab uses it to undo a filter it
      // was handed by a link (scripts/dashboard/orders.ts).
      var panels = document.querySelectorAll('.dash-panel');
      for (var j = 0; j < panels.length; j++) {
        if (!panels[j].hidden) panels[j].dispatchEvent(new CustomEvent('dashtab:hide', { bubbles: true }));
        panels[j].hidden = true;
      }

      tab.classList.add('dash-tab--active');
      tab.setAttribute('aria-selected', 'true');
      tab.setAttribute('tabindex', '0');
      // Keep the just-activated tab in view when the strip overflows, without
      // ever yanking the page vertically (feedback_subtle_scroll).
      window.__dashTabReveal(tab);

      var panel = document.getElementById('dash-panel-' + name);
      if (panel) {
        panel.hidden = false;
        // Bubbling + inert unless something listens — lets a page react to its
        // own panel becoming active without this shared controller knowing
        // anything about that page's content.
        panel.dispatchEvent(new CustomEvent('dashtab:show', { bubbles: true }));
        if (!hydrated) earlyPanel = panel;
      }

      var u = new URL(window.location.href);
      u.searchParams.set('panel', name);
      history.replaceState(null, '', u.toString());

      // Links that must FOLLOW the open tab rather than the one the page was loaded with — the
      // seller's store switcher above all. Their href is server-rendered with `panel=<initial>`,
      // which is correct without JS (the tab cannot change) and quietly wrong the moment it can:
      // a seller who arrived from an order notification (?panel=orders), browsed to מוצרים and
      // then switched store landed back on הזמנות, and the new page then re-baked the same stale
      // panel into its own links, so it kept happening (owner, סשן ב׳ §2). Rewritten here rather
      // than in the dashboard bundle because a switch clicked before those 61 KB arrive would
      // still carry the stale value.
      var followers = document.querySelectorAll('a[data-panel-link]');
      for (var k = 0; k < followers.length; k++) {
        var raw = followers[k].getAttribute('href');
        // A marker on an element with no href would resolve to the page's own URL and rewrite the
        // link to point at itself — silently, and only for that one element.
        if (!raw) continue;
        var href = new URL(raw, window.location.href);
        href.searchParams.set('panel', name);
        followers[k].setAttribute('href', href.pathname + href.search + href.hash);
      }
    };

    // Delegated, so it covers tabs rendered later and synthetic `.click()`
    // calls (the overview stat cards' [data-goto-panel] jump).
    document.addEventListener('click', function (e) {
      var target = e.target instanceof Element ? e.target : null;
      if (!target) return;
      var tab = target.closest('[role="tab"][data-panel]');
      if (tab) { window.__dashTabActivate(tab); return; }

      // Second job: a menu opened from inside a panel whose JS has not arrived
      // yet. The trigger is real, the handler is not, so the tap did nothing and
      // said nothing (owner, 2026-07-31: "אי אפשר לפתוח את בוררי הזמן... בלי שום
      // מושג מה קורה"). Remember it, and the panel's loader clicks it again the
      // moment that panel is wired — so the picker just opens, a beat late.
      // Deliberately ONLY `aria-haspopup` triggers: replaying a click is safe
      // exactly because opening a menu changes nothing. A save/delete button
      // must never be replayed, and none of them match this.
      var opener = target.closest('[aria-haspopup="true"]');
      if (opener && opener.closest('.dash-panel[data-hydrating]')) {
        // Answer the tap NOW. Remembering it is not enough on its own: a control
        // that shows nothing for a second reads as broken, which is the report
        // that kept coming back. [data-opening] pulses the trigger (utils.css)
        // until the real menu opens.
        var previous = document.querySelector('[data-opening]');
        if (previous && previous !== opener) previous.removeAttribute('data-opening');
        opener.setAttribute('data-opening', '');
        window.__dashPendingClick = opener;
      }
    });

    document.addEventListener('DOMContentLoaded', function () {
      hydrated = true;
      if (earlyPanel) {
        earlyPanel.dispatchEvent(new CustomEvent('dashtab:show', { bubbles: true }));
        earlyPanel = null;
      }
    });
  })();
</script>
