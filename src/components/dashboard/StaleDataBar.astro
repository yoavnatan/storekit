---
// "Another tab changed this store" notice — raised by scripts/dashboard/tab-sync.ts.
//
// Floating rather than in-flow on purpose: it appears while the seller is in the
// middle of something, and a bar inserted at the top of the page would either be
// off-screen (long products table) or push the content he is reading. Nothing here
// moves or reloads on its own — the seller decides when to take the fresh data.
//
// Hidden with the `!hidden` utility, not the `hidden` attribute: this element is
// display:flex, and a flex utility beats the attribute's display:none (see the
// same trap elsewhere in the dashboard).
//
// `bottom-6` is the resting value; `scripts/dashboard/bar-stack.ts` moves it up when a bar below it
// is out. It used to carry a fixed `bottom-[5.5rem]` so it could never land on UnsavedChangesBar —
// which meant that when this bar was the only one showing, it hovered a bar's height above nothing
// (owner, סשן א׳ §3). The offsets are computed from what is on screen instead. The element still
// positions itself rather than sitting in a shared flex container, because the elevation guard
// (tests/design-shadow-rule.test.ts) requires the element CASTING a shadow to declare that it
// floats — an ancestor's `fixed` deliberately cannot vouch for it, so hoisting the positioning out
// of here would have made the shadow look unjustified exactly where it is earned.
interface Props {
  message: string;
  refreshLabel: string;
  dismissLabel: string;
}
const { message, refreshLabel, dismissLabel } = Astro.props;
---

<div
  id="dash-stale-bar"
  role="status"
  aria-live="polite"
  class="!hidden fixed bottom-6 inset-x-4 z-[9998] flex flex-wrap items-center gap-x-2.5 gap-y-1.5 py-2 ps-3 pe-2 rounded-[var(--radius-lg)] border [border-color:var(--color-border)] [background:var(--color-surface)] shadow-[var(--shadow-card)] text-[0.82rem] mx-auto max-w-[34rem] sm:gap-3 sm:py-[0.55rem] sm:ps-[0.9rem] sm:pe-[0.55rem] sm:text-[0.85rem]" data-bottom-bar
>
    {/* Icon and sentence are ONE flex item, and its 19rem `basis` is the whole layout rule: it is
        about a line of this sentence, so either the buttons fit beside it or they go under it —
        the words are never squeezed into a column. ONE rule at every width, deliberately (owner,
        2026-08-20: *"זה צריך להיות כמו במובייל פשוט"*). The first attempt gated the wrap at `sm`,
        which fixed a phone and left the middle of the range worse than it started: measured across
        twelve widths, 640px produced a bar 320px wide and 106px tall. It is 76px below 500 and
        49–51px above 600 now, at every step. */}
  <div class="flex items-center gap-2.5 min-w-0 grow basis-[19rem] sm:gap-3">
    <svg class="shrink-0 max-w-none [color:var(--color-primary)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
    </svg>
    <span class="min-w-0">{message}</span>
  </div>
  {/* Same unit as the draft bar's pair, for the same reason: an action and the way to dismiss it
      belong on one line as each other's alternatives. */}
  {/* `mx-auto`, not `ms-auto`, and the difference only shows on a phone. Beside the sentence there
      is no free space to absorb — the sentence has `grow` and takes it — so the pair sits where it
      always did, at the end of the line. On its OWN row there is nothing else, so the two auto
      margins split what is left and centre it. End-aligning a row with nothing else in it reads as
      the buttons having fallen off the bar (owner, 2026-08-20). */}
  <div class="flex items-center gap-2 shrink-0 mx-auto">
  <button type="button" id="dash-stale-refresh" class="btn btn--sm shrink-0">{refreshLabel}</button>
  <button
    type="button"
    id="dash-stale-dismiss"
    aria-label={dismissLabel}
    class="shrink-0 inline-flex items-center justify-center w-6 h-6 bg-transparent border-0 rounded-full cursor-pointer [color:var(--color-muted)] transition-colors duration-100 hover:[background:var(--color-bg)] hover:[color:var(--color-text)]"
  >
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  </div>
</div>
