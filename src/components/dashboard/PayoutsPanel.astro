---
/**
 * The seller's money, under the split model: where it comes from, when, and the account it lands in.
 *
 * ── What this screen stopped being, 2026-08-21 ──
 * It used to be the seller's half of a payout WE made: what was payable now, what was still on hold
 * and why, a table splitting the waiting money by reason, and four rules explaining a fifteen-day
 * clock. Every one of those existed because the buyer's money passed through the platform and we
 * decided when to send it on. Under the split model it never arrives here — the processor captures
 * each store's share into that seller's own account at the moment of the charge, deducts our
 * distribution fee inside the same transaction, and credits the seller on its own schedule
 * (GO_LIVE §3.1.0). There is no hold to explain, no release date to promise and no transfer to
 * forecast, so the screen that explained them is three things instead of nine.
 *
 * **The bank and business form stays, and its job changed rather than ended.** It is no longer
 * where we learn how to pay a seller; it is what we hand the processor to open his merchant
 * account, so the same six fields now gate his ability to SELL rather than his ability to be paid.
 * That is a stronger gate, and it is why the owner chose (2026-08-21) to ask for them on the
 * store-opening card, skippable — `payout-details.ts`'s header carries the rule, and both surfaces
 * still write through `parsePayoutDetails` so neither can half-save an account.
 *
 * ⚠️ The gate itself is NOT built: nothing yet refuses to publish a store whose seller has no
 * merchant account, because there is no adapter to open one with. It arrives with the adapter, and
 * this panel is where the seller will read the account's status.
 *
 * **One account, one registered business** — one subscription, one commission rate, one ח״פ, one
 * bank account, however many stores (`pricing.ts`). A seller with a second ח״פ opens a second
 * account; `DB_MIGRATION_PLAN.md` §10 records why, and it is closed rather than pending.
 */
import { BUSINESS_TYPES, maskedBankLine, businessSummaryLine, type PayoutDetails } from '../../lib/payout-details.js';
import type { getT } from '../../i18n/index.js';

interface Props {
  seller: PayoutDetails;
  /** More than one store, so the "these details cover all of them" line is worth saying. */
  multiStore: boolean;
  d: ReturnType<typeof getT>['dashboard'];
}
const { seller, multiStore, d } = Astro.props;

const TYPE_LABEL: Record<string, string> = {
  exempt: d.payBusinessExempt,
  licensed: d.payBusinessLicensed,
  company: d.payBusinessCompany,
};

const bankLine = maskedBankLine(seller);
/** The business line of the closed summary. Assembled by `payout-details.ts#businessSummaryLine`,
 *  which `scripts/dashboard/payouts.ts` also calls after a save — one composition rule, two
 *  renderers, no drift. */
const businessSummary = businessSummaryLine(seller, TYPE_LABEL, d.payBusinessMissing);
---

<div id="payouts-root">
  <div class="dash-panel-head mb-4 py-[0.6rem] border-b [border-color:var(--color-border)]">
    <h2 class="m-0 text-base font-semibold">{d.payTitle}</h2>
    <p class="muted text-[0.82rem] m-0 mt-1">{d.paySubtitle}</p>
  </div>

  <form class="card card--flat p-4 md:p-5" id="pay-details-form" data-unsaved-guard>
    <h3 class="text-[1.05rem] font-bold m-0">
      {d.payBankTitle}
    </h3>
    {/* The one thing on this screen that genuinely is account-wide and could be MISTAKEN for the
        store's, so it is said here and only here (owner, 2026-08-11: *"לא צריך להיות בכותרת, אלא
        ליד הפרטי בנק… וזה צריך להופיע רק אם יש לו מעל חנות אחת"*). A seller with one shop has no
        second shop for the sentence to be about, and telling them anyway invents a distinction they
        do not have. The two account-wide FIGURES carry their own scope in their own labels. */}
    {multiStore && <p class="muted m-0 mt-1 text-[0.8rem]">{d.payBankAllStores}</p>}

    {/* ── The closed summary (owner, סשן א׳ §2) ──────────────────────────────────────────────
        *"אם יש חשבון בנק לא צריך לשים שם את האינפוטים ככה פתוחים, הפרטים צריכים להופיע בתוך מסגרת
        קטנה סגורה, עם כפתור ״ערוך״"*. Six open inputs on a saved account read as unfinished work
        on the one screen a seller opens to reassure themselves that nothing is.

        **Both halves are SERVER-rendered with `hidden` on the one that does not apply**, never
        revealed by a script on load: a JS-gated visibility is the flash class this project already
        has a memory for (`project_injected_overlay_flash`). The server knows which state this is —
        `bankLine` is non-null exactly when all four fields make a payable account — so there is
        nothing for the client to decide before first paint.

        The account is MASKED here, as it is everywhere: `maskedBankLine` shows the last four digits
        so a seller recognises their own account and a screen-share does not carry the whole number.
        Its header carries the reasoning. */}
    <div
      id="pay-bank-summary"
      class="flex items-center justify-between gap-3 flex-wrap mt-3 p-3 border [border-color:var(--color-border)] rounded-[var(--radius)]"
      hidden={!bankLine}
    >
      <div class="min-w-0">
        <p class="muted m-0 text-[0.76rem] font-medium">{d.payBankOnFile}</p>
        <p class="m-0 mt-0.5 text-[0.9rem] font-semibold"><code dir="ltr" id="pay-bank-summary-line">{bankLine}</code></p>
        <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBusinessOnFile} <span id="pay-business-summary">{businessSummary}</span></p>
      </div>
      <button type="button" class="btn btn--ghost btn--sm shrink-0" id="pay-bank-edit">{d.payBankEdit}</button>
    </div>

    {/* The fields. `hidden` while a saved account is being summarised — and they stay INSIDE the
        form rather than being rendered only on demand, so "ערוך" is a class toggle instead of a
        second renderer for a money form (`project_client_renderer_i18n_drift`). A hidden input is
        still submitted, which is correct here: pressing Save from the summary state would post the
        account exactly as it stands. */}
    <div id="pay-bank-fields" hidden={!!bankLine}>
      <p class="muted m-0 mt-1 text-[0.82rem]">{d.payBankHint}</p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-4">
        {/* `inputmode="numeric"` + `dir="ltr"`: these are ASCII numbers on an RTL page, and left to
            inherit they render with their digits grouped the wrong way round. */}
        <label class="field">
          <span class="text-[0.85rem]">{d.payBankCode}</span>
          <input class="input" name="bankCode" id="pay-bank-code" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="2" value={seller.bankCode ?? ''} />
        </label>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBankBranch}</span>
          <input class="input" name="bankBranch" id="pay-bank-branch" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="3" value={seller.bankBranch ?? ''} />
        </label>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBankAccount}</span>
          <input class="input" name="bankAccount" id="pay-bank-account" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="20" value={seller.bankAccount ?? ''} />
        </label>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBankHolder}</span>
          <input class="input" name="bankAccountHolder" id="pay-bank-holder" autocomplete="off" maxlength="120" value={seller.bankAccountHolder ?? ''} />
          <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBankHolderHint}</p>
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 mt-1">
        <label class="field">
          <span class="text-[0.85rem]">{d.payBusinessId}</span>
          <input class="input" name="businessId" id="pay-business-id" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="9" value={seller.businessId ?? ''} />
        </label>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBusinessType}</span>
          <select class="input" name="businessType" id="pay-business-type">
            <option value="">{d.payBusinessNone}</option>
            {BUSINESS_TYPES.map((t) => (
              <option value={t} selected={seller.businessType === t}>{TYPE_LABEL[t]}</option>
            ))}
          </select>
          <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBusinessHint}</p>
        </label>
      </div>

      <p class="hidden text-sm [color:var(--color-danger)] mt-1 mb-3" id="pay-details-error" role="alert"></p>
      <div class="flex items-center gap-2 mt-3">
        <button type="submit" class="btn btn--sm" id="pay-details-save">{d.payDetailsSave}</button>
        {/* Rendered always, HIDDEN until there is a saved account to go back to. It has to exist in
            the markup because a seller filling this in for the first time collapses into the
            summary the moment they save, without a reload — so `payouts.ts` un-hides it there.
            Cancelling with nothing saved would close the fields over an EMPTY summary card, which
            is why it is not simply always visible. */}
        <button type="button" class="btn btn--ghost btn--sm" id="pay-bank-cancel" hidden={!bankLine}>{d.payBankCancel}</button>
      </div>
    </div>
  </form>

  {/* ── The rules, once, at the end ──────────────────────────────────────────────────────────
      Three questions in the order a seller asks them, each with one short answer. There is no
      fourth about a hold, a release date or a minimum transfer: under the split model none of
      those is a thing that happens to his money.

      A `<dl>` and not prose: a seller scanning for one of the three finds it by its question,
      which is not true of a paragraph containing the same words. */}
  <h3 class="text-[1.05rem] font-bold m-0 mt-8 mb-2" id="pay-how">{d.payHowTitle}</h3>
  <dl class="card card--flat p-4 md:p-5 gap-3 text-[0.85rem]">
    <div>
      <dt class="font-semibold m-0">{d.payHowWhenQ}</dt>
      <dd class="muted m-0 mt-0.5">{d.payHowWhenA}</dd>
    </div>
    <div>
      <dt class="font-semibold m-0">{d.payHowFeeQ}</dt>
      <dd class="muted m-0 mt-0.5">{d.payHowFeeA}</dd>
    </div>
    <div>
      <dt class="font-semibold m-0">{d.payHowRefundQ}</dt>
      <dd class="muted m-0 mt-0.5">{d.payHowRefundA}</dd>
    </div>
  </dl>
</div>
