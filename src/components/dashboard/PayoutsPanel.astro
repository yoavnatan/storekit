---
/**
 * The seller's money, under the split model: where it comes from, when, and the account it lands in.
 *
 * ── What this screen stopped being, 2026-08-21 ──
 * It used to be the seller's half of a payout WE made: what was payable now, what was still on hold
 * and why, a table splitting the waiting money by reason, and four rules explaining a fifteen-day
 * clock. Every one of those existed because the buyer's money passed through the platform and we
 * decided when to send it on. Under the split model it never arrives here — the processor captures
 * each store's share into that seller's own account at the moment of the charge, deducts our
 * distribution fee inside the same transaction, and credits the seller on its own schedule
 * (GO_LIVE §3.1.0). There is no hold to explain, no release date to promise and no transfer to
 * forecast, so the screen that explained them is three things instead of nine.
 *
 * **The bank and business form stays, and its job changed rather than ended.** It is no longer
 * where we learn how to pay a seller; it is what we hand the processor to open his merchant
 * account, so the same six fields now gate his ability to SELL rather than his ability to be paid.
 * That is a stronger gate, and it is why the owner chose (2026-08-21) to ask for them on the
 * store-opening card, skippable — `payout-details.ts`'s header carries the rule, and both surfaces
 * still write through `parsePayoutDetails` so neither can half-save an account.
 *
 * **The gate is built (2026-08-23).** `/api/checkout` refuses a store whose seller has no APPROVED
 * merchant account, in the pre-pass, before any stock moves (`seller-merchant.ts#merchantBlockFor`).
 * So this panel now carries the one thing a seller must not have to discover from a shopper: that
 * his shop cannot take an order, and what is standing in the way. Rendered only when a clearing
 * provider is configured at all — with none, nothing is blocked and a status line about it would be
 * a sentence about a rule that is not in force.
 *
 * **One account, one registered business** — one ח״פ, one bank account, one clearing account and
 * ONE standing order, however many shops. What is NOT one of them, since 2026-08-24, is the plan:
 * each shop carries its own fee and its own commission rate, and the standing order's amount is the
 * sum of the shops on the site (`lib/store-plan.ts`). A seller with a second ח״פ opens a second
 * account; `DB_MIGRATION_PLAN.md` §10 records why, and it is closed rather than pending.
 */
import { BUSINESS_TYPES, maskedBankLine, businessSummaryLine, type PayoutDetails } from '../../lib/payout-details.js';
import { ISRAELI_BANKS, bankName } from '../../lib/israeli-banks.js';
import GoLiveSteps from './GoLiveSteps.astro';
import SubscriptionCard from './SubscriptionCard.astro';
import type { PublishHold } from '../../lib/store-publication.js';
import type { SellerTierId } from '../../lib/pricing.js';
import type { StoreFeeLine } from '../../lib/store-plan.js';
import type { MerchantKyc } from '../../lib/merchant-kyc.js';
import type { getT } from '../../i18n/index.js';

interface Props {
  seller: PayoutDetails;
  /** More than one store, so the "these details cover all of them" line is worth saying. */
  multiStore: boolean;
  /** Whether this seller's stores can take money, and what is in the way if not.
   *
   *  **`null` means no clearing provider is configured**, which is dev and the pre-gateway window
   *  GO_LIVE §7 plans — nothing is blocked, so a line about being blocked would describe a rule
   *  that is not in force. The block renders only when there is really something to say. */
  clearing: { state: 'ready' | 'missing-details' | 'awaiting-approval'; signupLink?: string } | null;
  /** What PayMe require about the business, as far as it has been filled in. Rendered under the
   *  bank block (owner, 2026-08-23) — one screen owns everything to do with money, and the
   *  "your shop is not live" card on the overview links straight here. */
  kyc: Partial<MerchantKyc>;
  /** The merchant category derived from the shop's own categories, or null when their list has no
   *  row for this trade. Null is what makes the form render the field at all. */
  derivedCategory: string | null;
  /** True once nothing is outstanding — the fields collapse into one line with an edit button. */
  kycComplete: boolean;
  /** What is still holding the shop off the site. Empty means it is live, and the go-live screen
   *  does not render at all. */
  holds: PublishHold[];
  /** The shop the dashboard is currently on — the one the go-live screen is about. Since 2026-08-24
   *  the plan and the monthly line belong to the SHOP (`lib/store-plan.ts`), so this screen cannot
   *  be about "the account" any more. Null only for a seller who has not created one yet, in which
   *  case there is nothing to put live and the screen does not render. */
  store: { id: string; name: string; tier?: string; publishedAt?: string } | null;
  /** Every plan's display name, for the picker inside the last step. Lives in the pricing copy
   *  rather than the dashboard's, so it is handed down rather than looked up — no component below
   *  this one reaches into another screen's translations. */
  planNames: Record<SellerTierId, string>;
  /** The plan's NAME for the current shop, same rule. */
  planName: string;
  /** What is on file, and whether PayMe are actually billing it. Both come from the server so this
   *  card can never disagree with the publication gate about whether the seller is paying.
   *  `storeFees` is what the standing order was last set from — the breakdown behind the total. */
  subscription: { status: number | null; nextCharge?: string; endsAt?: string; priceAgorot?: number; storeFees?: StoreFeeLine[]; cardSavedAt?: string; providerRef?: string } | null;
  subscriptionPaying: boolean;
  /** Whose card the monthly fee is taken from — the seller's own account details, handed down so
   *  the card fields never ask him for anything he has already given us. */
  payer: { name: string; email: string; phone: string };
  d: ReturnType<typeof getT>['dashboard'];
}
const { seller, multiStore, clearing, kyc, derivedCategory, kycComplete, holds, store, planNames, planName, subscription, subscriptionPaying, payer, d } = Astro.props;

/** A card is on file and PayMe have nothing yet — the state a seller spends the clearing review in
 *  (`lib/subscription-arm.ts`). Derived from the same two facts the server derives it from, rather
 *  than passed as a third flag that could disagree with them. */
const cardOnFile = !!subscription?.cardSavedAt && !subscription.providerRef;

/** Whether THIS shop is one of the lines the standing order pays for. A paying seller who has just
 *  opened a second shop clears every account-level hold and still owes for this one — the case that
 *  would otherwise put a shop on the site for free (`lib/store-plan.ts`). */
const storeInPlan = !!store && (subscription?.storeFees ?? []).some((f) => f.storeId === store.id);

/** Whether the go-live screen has anything left to say about THIS shop — **the same single
 *  condition it computes for itself**, so the two can never both render or both vanish. It is the
 *  shop being on the site and nothing else: keyed off the STEPS instead, a seller who had finished
 *  them all saw neither screen while his shop was still going up. A cancelled subscription inside
 *  its paid period lands here too, which is right — the shop is up, and what he needs is the manage
 *  card (where the renew button is), not a three-step wizard. */
const goLiveDone = !!store?.publishedAt;

const TYPE_LABEL: Record<string, string> = {
  exempt: d.payBusinessExempt,
  licensed: d.payBusinessLicensed,
  company: d.payBusinessCompany,
};

const bankLine = maskedBankLine(seller);
/** The business line of the closed summary. Assembled by `payout-details.ts#businessSummaryLine`,
 *  which `scripts/dashboard/payouts.ts` also calls after a save — one composition rule, two
 *  renderers, no drift. */
const businessSummary = businessSummaryLine(seller, TYPE_LABEL, d.payBusinessMissing);
---

<div id="payouts-root">
  <div class="dash-panel-head mb-4 py-[0.6rem] border-b [border-color:var(--color-border)]">
    <h2 class="m-0 text-base font-semibold">{d.payTitle}</h2>
    <p class="muted text-[0.82rem] m-0 mt-1">{d.paySubtitle}</p>
  </div>

  {/* ── The money on its way to his bank — the first thing on the screen the screen is named after ──
      Owner, סשן א׳ §1 (2026-08-25): *"איפה המוכר בעצם רואה כמה כסף יועבר לו, אני רוצה שהוא בכלל לא
      יצטרך לצאת לפיימי כדי לעשות פעולות."* Every figure here is PayMe's, read live through
      `/api/seller/transfers` — never our own accrual, which answers a different question
      (`lib/seller-transfers.ts` carries the distinction and why printing ours would be a promise).

      **First on the page and not beside the bank form**, which the same day's reorganisation moved
      to the END: the form is where the money LANDS, a thing a seller settles once, and this is the
      one question he comes back to the tab for.

      **Rendered only when a clearing provider is configured** — with none there is no account for
      anything to be pending in, and a strip saying ₪0 would be a claim rather than an absence.

      Empty on the server and filled by `scripts/dashboard/transfers.ts`. It is a THIRD-PARTY call,
      so it must not sit on the panel's render path — PayMe being slow would be the dashboard being
      slow, and PayMe being down would be a panel that does not render. `aria-live` so a screen
      reader is told when the figure arrives rather than being left on an empty box. */}
  {clearing && (
    <section class="card card--flat p-4 md:p-5 mb-4" id="pay-transfers" aria-live="polite" hidden>
      <h3 class="text-[1.05rem] font-bold m-0">{d.payTransferTitle}</h3>
      {/* `max-w`, because each row is `justify-between`: on a 1100px panel that puts the label
          against one edge and the figure against the other, and a label a seller has to travel the
          width of the screen to attach to its number is not a labelled grid any more. 22rem is the
          widest row this list can produce (the undated sentence) plus its label. */}
      <dl class="mt-3 text-[0.85rem] max-w-[22rem]" id="pay-transfers-body"></dl>
      <p class="muted m-0 mt-3 text-[0.76rem]">{d.payTransferSource}</p>
    </section>
  )}

  {/* ── Where the clearing fee actually shows up (owner, 2026-08-25: *"לא הבנתי אז איפה הוא רואה
      עמלת סליקה, מינימום חודשי, הכחשת עסקה"*) ──
      PayMe publish the fee split per charge and nothing had ever read it. Three numbers per sale —
      THEIR clearing fee, OUR commission, and what reached him — never one "fees" total, because a
      seller shown a single deduction concludes the platform took all of it.

      **What this deliberately does NOT claim to cover:** the account-level charges (the ₪50 monthly
      minimum top-up, a ₪59 chargeback, the terminal). We have not found them in any endpoint —
      question 4 in `docs/payme-questions-open.md` — so the heading says "on your sales" rather than
      "your fees", which would be a total that is quietly missing rows. */}
  {clearing && (
    <section class="card card--flat p-4 md:p-5 mb-4" id="pay-charges" hidden>
      <h3 class="text-[1.05rem] font-bold m-0">{d.payChargesTitle}</h3>
      <div class="mt-2 max-w-[26rem]" id="pay-charges-body"></div>
      <p class="muted m-0 mt-3 text-[0.76rem]">{d.payChargesHint}</p>
    </section>
  )}

  {/* ── The one add-on a seller may switch on for himself ──
      Owner, 2026-08-25: *"אני רוצה שהמוכר יוכל לבחור אם להפעיל את זה, ושזה יהיה בתשלום שלו"* —
      PayMe issuing the buyer's invoice in his name, billed to him, **at cost with no margin of
      ours** (the agreement would allow one; he declined it).

      Empty markup, and it stays hidden unless PayMe have PROVISIONED the service on that merchant.
      They have not, on any of ours — `lib/seller-invoicing.ts` carries the measurement and why an
      absent card beats a disabled switch for a feature we cannot yet deliver. */}
  {clearing && (
    <section class="card card--flat p-4 md:p-5 mb-4" id="pay-invoicing" hidden></section>
  )}

  {/**
    * ── The clearing status USED to be announced here, and it is not any more (2026-08-25) ──
    *
    * The page read: "חשבון סליקה … / פרטי בנק … / פרטי העסק לחברת הסליקה" — the same subject twice
    * with the bank block wedged between them (owner: *"לא הבנתי את הסדר הלא מסודר בדף הזה ואת ריבוי
    * הסקשנים"*). It was a status line about a process that now has a whole screen of its own, so
    * it said the same thing worse and a paragraph earlier.
    *
    * `GoLiveSteps` below is the one place that answers it, in the order a seller walks it. The
    * signup link the block carried moved with it, into the approval step that is about that wait.
    */}

  {/* Directly under the bank block, because it is the same errand: the bank account says where the
      money goes and this says who the business is, and PayMe need both before they will open an
      account at all. Rendered only when a clearing provider is configured — with none, nothing is
      blocked and a form about being blocked would be a form about a rule that is not in force. */}
  {/* ONE screen for the whole errand, directly under the bank block — the details form and the
      subscription action live inside it now, as the steps that own them, rather than as two more
      cards beside it (owner, 2026-08-24). It renders nothing once the shop is live. */}
  {/* ── Once the shop is UP, the subscription is a thing to manage rather than a step ──
      The go-live screen renders only while something is still holding the shop off the site, and
      the subscription card lived inside it — so from the moment a seller succeeded, the card
      vanished and with it the next-charge date, the breakdown and **the cancel button**. He was
      paying us monthly with no screen that admitted it. Found in the review of 2026-08-24, in code
      that had been written the same day: the two states are complementary and exactly one of them
      renders, which is also why this is not a second copy of the same card on any screen. */}
  {clearing && store && goLiveDone && (
    <SubscriptionCard
      storeId={store.id}
      tier={store.tier as SellerTierId | undefined}
      planName={planName}
      subscription={subscription}
      paying={subscriptionPaying}
      storeInPlan={storeInPlan}
      cardOnFile={cardOnFile}
      payer={payer}
      d={d}
    />
  )}

  {clearing && store && (
    <GoLiveSteps
      holds={holds}
      store={store}
      storeInPlan={storeInPlan}
      cardOnFile={cardOnFile}
      payer={payer}
      kyc={kyc}
      derivedCategory={derivedCategory}
      kycComplete={kycComplete}
      planName={planName}
      planNames={planNames}
      subscription={subscription}
      subscriptionPaying={subscriptionPaying}
      {...(clearing.signupLink ? { signupLink: clearing.signupLink } : {})}
      d={d}
    />
  )}


  {/* AFTER the go-live screen, not before it. This is where the seller's money LANDS — a fact
      about being paid, not a step in getting the shop up — and putting it first made the page open
      on a form whose purpose the reader had not been told yet. `mt-6` because two bordered cards
      flush against each other read as one thing with a line through it (owner, 2026-08-25:
      *"צריך ריווחים בין הסקשנים"*). */}
  <form class="card card--flat p-4 md:p-5 mt-6" id="pay-details-form" data-unsaved-guard>
    <h3 class="text-[1.05rem] font-bold m-0">
      {d.payBankTitle}
    </h3>
    {/* The one thing on this screen that genuinely is account-wide and could be MISTAKEN for the
        store's, so it is said here and only here (owner, 2026-08-11: *"לא צריך להיות בכותרת, אלא
        ליד הפרטי בנק… וזה צריך להופיע רק אם יש לו מעל חנות אחת"*). A seller with one shop has no
        second shop for the sentence to be about, and telling them anyway invents a distinction they
        do not have. The two account-wide FIGURES carry their own scope in their own labels. */}
    {multiStore && <p class="muted m-0 mt-1 text-[0.8rem]">{d.payBankAllStores}</p>}

    {/* ── The closed summary (owner, סשן א׳ §2) ──────────────────────────────────────────────
        *"אם יש חשבון בנק לא צריך לשים שם את האינפוטים ככה פתוחים, הפרטים צריכים להופיע בתוך מסגרת
        קטנה סגורה, עם כפתור ״ערוך״"*. Six open inputs on a saved account read as unfinished work
        on the one screen a seller opens to reassure themselves that nothing is.

        **Both halves are SERVER-rendered with `hidden` on the one that does not apply**, never
        revealed by a script on load: a JS-gated visibility is the flash class this project already
        has a memory for (`project_injected_overlay_flash`). The server knows which state this is —
        `bankLine` is non-null exactly when all four fields make a payable account — so there is
        nothing for the client to decide before first paint.

        The account is MASKED here, as it is everywhere: `maskedBankLine` shows the last four digits
        so a seller recognises their own account and a screen-share does not carry the whole number.
        Its header carries the reasoning. */}
    <div
      id="pay-bank-summary"
      class="flex items-center justify-between gap-3 flex-wrap mt-3 p-3 border [border-color:var(--color-border)] rounded-[var(--radius)]"
      hidden={!bankLine}
    >
      <div class="min-w-0">
        <p class="muted m-0 text-[0.76rem] font-medium">{d.payBankOnFile}</p>
        <p class="m-0 mt-0.5 text-[0.9rem] font-semibold"><code dir="ltr" id="pay-bank-summary-line">{bankLine}</code></p>
        <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBusinessOnFile} <span id="pay-business-summary">{businessSummary}</span></p>
      </div>
      <button type="button" class="btn btn--ghost btn--sm shrink-0" id="pay-bank-edit">{d.payBankEdit}</button>
    </div>

    {/* The fields. `hidden` while a saved account is being summarised — and they stay INSIDE the
        form rather than being rendered only on demand, so "ערוך" is a class toggle instead of a
        second renderer for a money form (`project_client_renderer_i18n_drift`). A hidden input is
        still submitted, which is correct here: pressing Save from the summary state would post the
        account exactly as it stands. */}
    <div id="pay-bank-fields" hidden={!!bankLine}>
      <p class="muted m-0 mt-1 text-[0.82rem]">{d.payBankHint}</p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-4">
        {/* `inputmode="numeric"` + `dir="ltr"`: these are ASCII numbers on an RTL page, and left to
            inherit they render with their digits grouped the wrong way round. */}
        {/* ── The bank, by name — the code is what gets stored ──
            A bare two-digit box is a field a seller guesses at, and a guessed code is a transfer
            that bounces weeks later (owner, 2026-08-25). So he searches by name or by code and
            picks; the input keeps the CODE, because that is what PayMe take, and the name of the
            match is shown under it as confirmation that he picked the bank he meant.

            **Not a `<select>`** — this site does not use native dropdowns — and **not a gate**: a
            code that is not on the list is still accepted and simply shows no name, for the same
            reason `payout-details.ts` refuses to check a business number's check digit. */}
        <div class="field relative" id="pay-bank-picker">
          <span class="text-[0.85rem]">{d.payBankCode}</span>
          <input
            class="input"
            name="bankCode"
            id="pay-bank-code"
            dir="ltr"
            inputmode="numeric"
            autocomplete="off"
            maxlength="2"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls="pay-bank-list"
            placeholder={d.payBankCodePlaceholder}
            value={seller.bankCode ?? ''}
            data-banks={JSON.stringify(ISRAELI_BANKS)}
          />
          <p class="muted m-0 mt-1 text-[0.76rem]" id="pay-bank-name">{bankName(seller.bankCode) ?? ''}</p>
          <div
            id="pay-bank-list"
            role="listbox"
            class="!hidden absolute top-[calc(100%-1.25rem)] inset-inline-start-0 z-30 w-full max-h-52 overflow-y-auto rounded-[var(--radius)] border p-[0.3rem] [border-color:var(--color-border)] [background:var(--color-surface)] [box-shadow:var(--shadow-card)]"
          ></div>
        </div>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBankBranch}</span>
          <input class="input" name="bankBranch" id="pay-bank-branch" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="3" value={seller.bankBranch ?? ''} />
        </label>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBankAccount}</span>
          <input class="input" name="bankAccount" id="pay-bank-account" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="20" value={seller.bankAccount ?? ''} />
        </label>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBankHolder}</span>
          <input class="input" name="bankAccountHolder" id="pay-bank-holder" autocomplete="off" maxlength="120" value={seller.bankAccountHolder ?? ''} />
          <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBankHolderHint}</p>
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 mt-1">
        <label class="field">
          <span class="text-[0.85rem]">{d.payBusinessId}</span>
          <input class="input" name="businessId" id="pay-business-id" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="9" value={seller.businessId ?? ''} />
        </label>
        <label class="field">
          <span class="text-[0.85rem]">{d.payBusinessType}</span>
          <select class="input" name="businessType" id="pay-business-type">
            <option value="">{d.payBusinessNone}</option>
            {BUSINESS_TYPES.map((t) => (
              <option value={t} selected={seller.businessType === t}>{TYPE_LABEL[t]}</option>
            ))}
          </select>
          <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBusinessHint}</p>
        </label>
      </div>

      <p class="hidden text-sm [color:var(--color-danger)] mt-1 mb-3" id="pay-details-error" role="alert"></p>
      <div class="flex items-center gap-2 mt-3">
        <button type="submit" class="btn btn--sm" id="pay-details-save">{d.payDetailsSave}</button>
        {/* Rendered always, HIDDEN until there is a saved account to go back to. It has to exist in
            the markup because a seller filling this in for the first time collapses into the
            summary the moment they save, without a reload — so `payouts.ts` un-hides it there.
            Cancelling with nothing saved would close the fields over an EMPTY summary card, which
            is why it is not simply always visible. */}
        <button type="button" class="btn btn--ghost btn--sm" id="pay-bank-cancel" hidden={!bankLine}>{d.payBankCancel}</button>
      </div>
    </div>
  </form>

  {/* ── The rules, once, at the end ──────────────────────────────────────────────────────────
      Three questions in the order a seller asks them, each with one short answer. There is no
      fourth about a hold, a release date or a minimum transfer: under the split model none of
      those is a thing that happens to his money.

      A `<dl>` and not prose: a seller scanning for one of them finds it by its question,
      which is not true of a paragraph containing the same words.

      **A fourth arrived on 2026-08-25** — who issues the buyer's invoice. It is asked here because
      this is the money screen a seller is standing on when the question occurs to him (owner:
      *"לא הבנתי כל כך את העניין"*, about a feature that was built), and the answer NAMES THE DOOR:
      the tab, the card and what the two buttons do. The long version is `/help/sale-invoices`. */}
  <h3 class="text-[1.05rem] font-bold m-0 mt-8 mb-2" id="pay-how">{d.payHowTitle}</h3>
  <dl class="card card--flat p-4 md:p-5 gap-3 text-[0.85rem]">
    <div>
      <dt class="font-semibold m-0">{d.payHowWhenQ}</dt>
      <dd class="muted m-0 mt-0.5">{d.payHowWhenA}</dd>
    </div>
    <div>
      <dt class="font-semibold m-0">{d.payHowFeeQ}</dt>
      <dd class="muted m-0 mt-0.5">{d.payHowFeeA}</dd>
    </div>
    <div>
      <dt class="font-semibold m-0">{d.payHowRefundQ}</dt>
      <dd class="muted m-0 mt-0.5">{d.payHowRefundA}</dd>
    </div>
    <div>
      <dt class="font-semibold m-0">{d.payHowInvoiceQ}</dt>
      <dd class="muted m-0 mt-0.5">{d.payHowInvoiceA}</dd>
    </div>
  </dl>
</div>
