---
/**
 * The seller's money: what is payable now, what is still on hold and why, where it goes, and what
 * has already been sent.
 *
 * **The only panel in this dashboard that is not about the store in the switcher.** A payout is per
 * registered business — one subscription, one commission rate, one bank account, however many
 * stores (`pricing.ts`, `seller-account.ts`) — so this covers all of them and says so in a line
 * rather than leaving the seller to reconcile a figure that looks too large.
 *
 * **Server-rendered, unlike Reports and Performance.** Those defer because a report is the heaviest
 * thing the dashboard can build. This is three small queries assembled by one call
 * (`payouts.ts#getSellerAccountFor`) and its numbers are the reason a seller opens the tab at all —
 * a screen about money that arrives a beat later reads as a screen that is not sure.
 *
 * **Every number here comes from `buildSellerAccount` and none is computed in this file.** That is
 * the rule `reporting-invariants.test.ts` exists for: the payout run and this screen must answer
 * from the same function, or a seller reads one figure and is paid another.
 *
 * The bank form lives HERE and not in Settings, and that is a deliberate reading of the rule it is
 * under (`feedback_seller_form_burden`): what the rule forbids is meeting these fields at
 * registration or store-opening. Splitting one form across two tabs — the money on this screen, the
 * account it goes to on another — costs the seller the one context in which the fields make sense.
 */
import { formatAgorot } from '../../lib/money.js';
import { paginate } from '../../lib/pagination.js';
import Pager from './PayoutsPager.astro';
import { formatBusinessDayLabel, formatBusinessDateShort } from '../../lib/format-date.js';
import { PAYOUT_DAY_OF_MONTH, MIN_PAYOUT_AGOROT, HOLD_DAYS_AFTER_DELIVERY, FALLBACK_DAYS_AFTER_PAYMENT } from '../../lib/payout-schedule.js';
import { BUSINESS_TYPES, hasPayableBank, maskedBankLine, type PayoutDetails } from '../../lib/payout-details.js';
import type { SellerAccount } from '../../lib/seller-account.js';
import type { SellerPayout } from '../../lib/payouts.js';
import type { getT } from '../../i18n/index.js';

interface Props {
  account: SellerAccount;
  payouts: SellerPayout[];
  seller: PayoutDetails;
  /** More than one store, so the "all your stores" line is worth saying. */
  multiStore: boolean;
  /** 1-based pages of the two tables, from `?paypage=` and `?payhist=`. Two params, because
   *  paging the history must not reset the held list under the seller's cursor. */
  heldPage: number;
  payoutPage: number;
  /** Build a page href, preserving the open tab and the OTHER table's page. */
  heldPageHref: (page: number) => string;
  payoutPageHref: (page: number) => string;
  d: ReturnType<typeof getT>['dashboard'];
}
const { account, payouts, seller, multiStore, heldPage, payoutPage, heldPageHref, payoutPageHref, d } = Astro.props;

/** Only what is still moving. A released slice is already inside `payableNowAgorot` above, and a
 *  seller who has traded for a year does not need every settled order rendered to be told what is
 *  waiting (the same bound `getSellerAccountRows` argues for). */
const heldSlices = account.slices.filter((s) => s.hold.state === 'held');
/**
 * Ten a page, with a pager — not a cap with a footnote.
 *
 * It WAS a cap ("ועוד 4 בהמתנה") and the owner named the problem exactly: a number of orders you
 * are told exist and cannot look at is worse than not knowing, because the ones you cannot see are
 * the ones you would want to check. This panel is rendered on every dashboard load, hidden or not
 * — that is what pays for the tab's badge — so drawing all 500 rows the query allows is a quarter
 * of a megabyte on pages nobody opens this tab from (memory `project_dashboard_html_weight`).
 * A page slice costs the same as a cap and every row is reachable.
 *
 * The sums in the tiles are computed from ALL of them and are unaffected by which page is shown.
 */
const PAGE_SIZE = 10;
const heldPageResult = paginate(heldSlices, heldPage, PAGE_SIZE);
/** The same treatment for the history, and for the opposite reason: that table has no cap at all —
 *  it is every payout this seller has ever had — so it grows for as long as they trade. A statement
 *  that is comfortable in month two and unreadable in year two is a table nobody scrolls. */
const payoutPageResult = paginate(payouts, payoutPage, PAGE_SIZE);

/**
 * Three columns, and each answers a different question the seller actually has: **when** the money
 * is approved, **why** then, and **whether anything is waiting on them** (owner, 2026-08-10). The
 * third is the one that was missing, and it is the only one that can require a decision — a table
 * of dates a seller cannot influence teaches them there is nothing to do, which is true for two of
 * these three rows and false for the one that matters.
 *
 * The day counts are interpolated from `payout-schedule.ts` rather than written into the sentence:
 * those constants are still owner decisions, and a line promising 21 days while the code waits 30
 * is a promise we break.
 */
const WHY: Record<string, string> = {
  delivery: d.payWhyDelivery.replace('{n}', String(HOLD_DAYS_AFTER_DELIVERY)),
  payment: d.payWhyPayment.replace('{n}', String(FALLBACK_DAYS_AFTER_PAYMENT)),
  unshipped: d.payWhyUnshipped,
};
const ACTION: Record<string, string> = {
  delivery: d.payActionNone,
  payment: d.payActionMarkDelivered,
  unshipped: d.payActionShip,
};
/** The one basis where the seller is BLOCKING their own money: no clock runs until they ship. It is
 *  the only action here that changes an outcome rather than a date, so it is the only one that
 *  takes a colour — three highlighted rows would highlight nothing. */
const BLOCKING = 'unshipped';
const STATUS: Record<SellerPayout['status'], string> = {
  pending: d.payStatusPending,
  sent: d.payStatusSent,
  paid: d.payStatusPaid,
  failed: d.payStatusFailed,
};
const TYPE_LABEL: Record<string, string> = {
  exempt: d.payBusinessExempt,
  licensed: d.payBusinessLicensed,
  company: d.payBusinessCompany,
};

const bankLine = maskedBankLine(seller);
const TILE = 'border [border-color:var(--color-border)] rounded-[var(--radius)] p-3';
const CELL = 'py-2 px-2.5 text-[0.85rem]';
---

<div id="payouts-root">
  <div class="dash-panel-head mb-4 py-[0.6rem] border-b [border-color:var(--color-border)]">
    <h2 class="m-0 text-base font-semibold">{d.payTitle}</h2>
    {/* The whole arrangement in one sentence, before any number. A seller meeting this screen has
        never heard of a hold period, and three figures with no explanation above them is what makes
        a payments page feel like something being done TO them. */}
    <p class="muted text-[0.82rem] m-0 mt-1">{d.paySubtitle.replace('{day}', String(PAYOUT_DAY_OF_MONTH))}{multiStore ? ` · ${d.payAllStores}` : ''}</p>
  </div>

  <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-3">
    <div class={TILE}>
      <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.payPayableNow}</dt>
      {/* The one figure a seller acts on, so it is the one that takes the accent. The others are
          context and stay in the ordinary text colour — three coloured numbers say nothing. */}
      <dd class={`m-0 text-[1.1rem] font-bold ${account.payableNowAgorot > 0 ? '[color:var(--color-accent)]' : ''}`} id="pay-kpi-now">{formatAgorot(account.payableNowAgorot)}</dd>
      <p class="muted m-0 mt-1 text-[0.72rem] leading-snug">{d.payPayableNowHint}</p>
    </div>
    <div class={TILE}>
      <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.payHeld}</dt>
      <dd class="m-0 text-[1.1rem] font-bold">{formatAgorot(account.heldAgorot)}</dd>
      <p class="muted m-0 mt-1 text-[0.72rem] leading-snug">{d.payHeldHint}</p>
    </div>
    <div class={TILE}>
      <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.payPaidOut}</dt>
      <dd class="m-0 text-[1.1rem] font-bold">{formatAgorot(account.paidOutAgorot)}</dd>
      <p class="muted m-0 mt-1 text-[0.72rem] leading-snug">{d.payPaidOutHint}</p>
    </div>
    {/* Rendered only when it exists. A permanent "0 ₪ debt" tile teaches a seller to expect a debt
        column, which is the wrong thing for a screen most of them will never see one on. */}
    {account.carriedAgorot > 0 && (
      <div class={TILE}>
        <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.payCarried}</dt>
        <dd class="m-0 text-[1.1rem] font-bold [color:var(--color-danger)]">{formatAgorot(account.carriedAgorot)}</dd>
        <p class="muted m-0 mt-1 text-[0.72rem]">{d.payCarriedHint}</p>
      </div>
    )}
  </dl>

  <p class="muted m-0 mb-4 text-[0.8rem]">{d.payMinNote.replace('{min}', formatAgorot(MIN_PAYOUT_AGOROT))}</p>

  {/* The banner. It appears on ONE condition — money is genuinely released and there is nowhere to
      send it — because a standing "complete your profile" prompt is the entry barrier this project
      refuses to build (`feedback_seller_form_burden`). Nothing here is required until it is. */}
  {account.payableNowAgorot > 0 && !hasPayableBank(seller) && (
    <div class="card card--flat p-4 mb-4 [border-color:var(--color-warning)]" role="status" id="pay-no-bank-banner">
      <h3 class="text-[0.98rem] font-bold m-0">{d.payNoBankTitle}</h3>
      <p class="muted m-0 mt-1 text-[0.85rem]">{d.payNoBankBody}</p>
      {/* `self-start`, and it is not cosmetic: `.card` is `display:flex; flex-direction:column`
          (cards.css), so a direct child stretches to the card's whole width — which is how a
          `.btn`, an inline-flex element everywhere else on the site, came out as a full-width bar
          here and nowhere else. Every direct child of a `.card` that is not meant to fill it needs
          this.
          A button rather than an anchor: `href="#..."` scrolls the form's TOP to the viewport's
          top, where the fixed header covers it, so it landed in the middle of the fields
          (owner, 2026-08-10). The script takes them to the first EMPTY field instead, which is the
          thing they actually came to fill in. */}
      <button type="button" class="btn btn--sm mt-3 self-start" id="pay-goto-details">{d.payNoBankCta}</button>
    </div>
  )}

  <form class="card card--flat p-4 md:p-5" id="pay-details-form" data-unsaved-guard>
    <h3 class="text-[1.05rem] font-bold m-0">{d.payBankTitle}</h3>
    <p class="muted m-0 mt-1 text-[0.82rem]">{d.payBankHint}</p>
    {bankLine && <p class="m-0 mt-2 text-[0.82rem]">{d.payCurrentBank} <code dir="ltr">{bankLine}</code></p>}

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-4">
      {/* `inputmode="numeric"` + `dir="ltr"`: these are ASCII numbers on an RTL page, and left to
          inherit they render with their digits grouped the wrong way round. */}
      <label class="field">
        <span class="text-[0.85rem]">{d.payBankCode}</span>
        <input class="input" name="bankCode" id="pay-bank-code" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="2" value={seller.bankCode ?? ''} />
      </label>
      <label class="field">
        <span class="text-[0.85rem]">{d.payBankBranch}</span>
        <input class="input" name="bankBranch" id="pay-bank-branch" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="3" value={seller.bankBranch ?? ''} />
      </label>
      <label class="field">
        <span class="text-[0.85rem]">{d.payBankAccount}</span>
        <input class="input" name="bankAccount" id="pay-bank-account" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="20" value={seller.bankAccount ?? ''} />
      </label>
      <label class="field">
        <span class="text-[0.85rem]">{d.payBankHolder}</span>
        <input class="input" name="bankAccountHolder" id="pay-bank-holder" autocomplete="off" maxlength="120" value={seller.bankAccountHolder ?? ''} />
        <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBankHolderHint}</p>
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 mt-1">
      <label class="field">
        <span class="text-[0.85rem]">{d.payBusinessId}</span>
        <input class="input" name="businessId" id="pay-business-id" dir="ltr" inputmode="numeric" autocomplete="off" maxlength="9" value={seller.businessId ?? ''} />
      </label>
      <label class="field">
        <span class="text-[0.85rem]">{d.payBusinessType}</span>
        <select class="input" name="businessType" id="pay-business-type">
          <option value="">{d.payBusinessNone}</option>
          {BUSINESS_TYPES.map((t) => (
            <option value={t} selected={seller.businessType === t}>{TYPE_LABEL[t]}</option>
          ))}
        </select>
        <p class="muted m-0 mt-1 text-[0.76rem]">{d.payBusinessHint}</p>
      </label>
    </div>

    <p class="hidden text-sm [color:var(--color-danger)] mt-1 mb-3" id="pay-details-error" role="alert"></p>
    <button type="submit" class="btn btn--sm mt-3 self-start" id="pay-details-save">{d.payDetailsSave}</button>
  </form>

  <h3 class="text-[1.05rem] font-bold m-0 mt-6 mb-2">{d.payHeldTitle}</h3>
  {heldPageResult.total === 0 ? <p class="muted m-0 text-[0.85rem]">{d.payHeldEmpty}</p> : (
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-start">
        <thead>
          <tr class="[color:var(--color-muted)] text-[0.76rem]">
            <th class={`${CELL} text-start font-medium`}>{d.payColOrder}</th>
            {multiStore && <th class={`${CELL} text-start font-medium`}>{d.payColStore}</th>}
            <th class={`${CELL} text-start font-medium`}>{d.payColAmount}</th>
            <th class={`${CELL} text-start font-medium`}>{d.payColRelease}</th>
            <th class={`${CELL} text-start font-medium`}>{d.payColWhy}</th>
            <th class={`${CELL} text-start font-medium`}>{d.payColAction}</th>
          </tr>
        </thead>
        <tbody>
          {heldPageResult.items.map((slice) => (
            <tr class="border-t [border-color:var(--color-border)]">
              <td class={CELL}><code dir="ltr" class="text-[0.76rem]">{slice.orderId.slice(0, 8)}</code></td>
              {multiStore && <td class={CELL}>{slice.storeSlug}</td>}
              <td class={CELL}>{formatAgorot(slice.netOfCommissionAgorot)}</td>
              {/* An em dash, not a blank: `basis: 'unshipped'` has NO date because the thing the
                  date would depend on has not happened, and the two columns beside it say so. A
                  blank reads as a value that failed to load. */}
              <td class={CELL}>{slice.hold.releaseDayISO ? formatBusinessDayLabel(slice.hold.releaseDayISO) : '—'}</td>
              <td class={`${CELL} [color:var(--color-muted)]`}>{WHY[slice.hold.basis ?? ''] ?? d.payWhyUnknown}</td>
              <td class={`${CELL} ${slice.hold.basis === BLOCKING ? 'font-semibold [color:var(--color-warning)]' : '[color:var(--color-muted)]'}`}>
                {ACTION[slice.hold.basis ?? ''] ?? d.payActionNone}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <Pager page={heldPageResult.page} totalPages={heldPageResult.totalPages} buildUrl={heldPageHref} label={d.payHeldTitle} d={d} />
    </div>
  )}

  <h3 class="text-[1.05rem] font-bold m-0 mt-6 mb-2">{d.payHistoryTitle}</h3>
  {payoutPageResult.total === 0 ? <p class="muted m-0 text-[0.85rem]">{d.payHistoryEmpty}</p> : (
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-start">
        <thead>
          <tr class="[color:var(--color-muted)] text-[0.76rem]">
            <th class={`${CELL} text-start font-medium`}>{d.payColPeriod}</th>
            <th class={`${CELL} text-start font-medium`}>{d.payColAmount}</th>
            <th class={`${CELL} text-start font-medium`}>{d.payColStatus}</th>
            <th class={`${CELL} text-start font-medium`}>{d.payColSent}</th>
          </tr>
        </thead>
        <tbody>
          {payoutPageResult.items.map((p) => (
            <tr class="border-t [border-color:var(--color-border)]">
              <td class={CELL}><code dir="ltr" class="text-[0.76rem]">{p.periodKey}</code></td>
              <td class={CELL}>{formatAgorot(p.amountAgorot)}</td>
              {/* A failed transfer is the one row in this table a seller has to act on — it is
                  money that came back and is payable again — so it is the only one that colours. */}
              <td class={`${CELL} ${p.status === 'failed' ? '[color:var(--color-danger)]' : ''}`}>{STATUS[p.status]}</td>
              <td class={`${CELL} [color:var(--color-muted)]`}>{p.sentAt ? formatBusinessDateShort(p.sentAt) : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <Pager page={payoutPageResult.page} totalPages={payoutPageResult.totalPages} buildUrl={payoutPageHref} label={d.payHistoryTitle} d={d} />
    </div>
  )}
</div>
