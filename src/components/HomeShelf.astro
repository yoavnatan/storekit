---
import StoreCard from './StoreCard.astro';
import StorePlaceholderCard from './StorePlaceholderCard.astro';
import CategoryIcon from './CategoryIcon.astro';
import type { FeedStore } from '../lib/home-feed.js';

interface Props {
  id: string;
  title: string;
  stores: FeedStore[];
  dotIndex?: number;
  eagerFirst?: boolean;
  /** The Liked/BuyAgain/New tabs each render exactly one shelf whose title
   *  would just repeat the tab button's own label — hides the h2 in that
   *  case (the tab itself is already the heading), but the section still
   *  needs an accessible name, so `aria-label` takes over from
   *  `aria-labelledby` when there's no heading to point at. */
  hideHeading?: boolean;
  /** The Liked/BuyAgain/New tabs each render exactly this one shelf as their whole panel — on a
   *  narrow viewport a single horizontal-scroll row of cards leaves most of the panel as dead
   *  space below it. `fillMobile` switches the row to a 2-column grid under 640px so the cards
   *  actually fill the panel instead. Discover's own shelves (several per panel, already followed
   *  by more content below) stay the plain horizontal-scroll row — leave this false there. */
  fillMobile?: boolean;
  /** How many placeholder cards close the row (see lib/launch-mode.ts) — 1 while
   *  the mall is merely thin, enough to fill the row in launch mode. They count
   *  toward the shelf being rendered at all, so a shelf that is ALL placeholders
   *  still shows; a shelf with neither stores nor placeholders hides. */
  invites?: number;
  /** Launch mode's own shelf (CURRENT_TASK.md → סשן א׳ 3). Drops the horizontal
   *  scroller for a real grid — 2 columns, 3 from 900px — so every card is wider,
   *  carries a 4th preview thumb, and is ON SCREEN. That last part is the reason
   *  it's a grid and not just a bigger `--shelf-card-max`: widening cards inside
   *  the scroll row pushes the tail of the row past the viewport, and the tail is
   *  exactly where the "your store here" card sits (the same burial MIN_SHELF_DEMO
   *  was added to prevent). A grid wraps instead of scrolling, so a launch shelf
   *  can give each store real presence without hiding the invitation behind it. */
  grid?: boolean;
  /** A platform category label (`store-taxonomy.ts`) when this shelf IS a category
   *  row — swaps the heading's colour dot for that category's icon. Left unset by
   *  shelves that aren't a category (recently-visited, launch), which keep the dot:
   *  there is nothing meaningful to draw for them, and a generic icon in the slot
   *  would say less than the dot already does. */
  categoryLabel?: string;
}

const { id, title, stores, dotIndex = 0, eagerFirst = false, hideHeading = false, fillMobile = false, invites = 0, grid = false, categoryLabel } = Astro.props;

// How many cards this row holds, and therefore how wide each may grow before the
// row is full (store-card.css reads --shelf-count).
const cardCount = Math.max(1, stores.length + invites);
// A row of one or two cards can only reach the far edge by letting each card get
// very wide — and at that width three preview thumbs blow up and the card reads
// as stretched. A fourth thumb restores the internal proportion, which is what
// makes the wider cap look deliberate instead of zoomed. Below that the normal
// 3-up card already fills the row at its own cap. A grid shelf is wide by
// construction, so it takes the fourth thumb for the same reason.
const SPARSE_SHELF = 2;
const previewSlots = grid || cardCount <= SPARSE_SHELF ? 4 : 3;
// The ceiling exists for ONE case: a row of a single card, where "fill the row"
// would mean a 1128px-wide card. Every other count already has the row's own
// share-of-the-width formula holding it back (store-card.css), and a flat
// ceiling on top of that formula is what left the ragged tail this fixes
// (CURRENT_TASK.md → סשן ב׳ 2): a 3-card shelf wants 368px per card at the
// site's full 1160px width, the old 360px cap cut it to 1104px of card in a
// 1128px row, and that 24px short of the edge is exactly what read as "not the
// width of the site" against the carousel and the longer shelves beside it,
// which do run edge to edge. `100%` is the row itself, so from two cards up the
// ceiling can never bite and every shelf ends flush at every width.
const cardMax = cardCount <= 1 ? '560px' : '100%';
// Deliberately NOT the `.home-shelf` class: that rule set is a scroll container
// (overflow-x, snap, edge-fade mask) and `.home-shelf .store-card` caps every card
// at --shelf-card-max. Reusing it and overriding both would need `!` on each — the
// grid is simply a different layout for the same cards, so it says so directly.
// `home-shelf-grid` carries no CSS — it's the hook index.astro's REVEAL_SELECTOR
// needs, since dropping `.home-shelf` also dropped this row out of the card
// entrance animation on tab switches.
// `edge-fade` only on the scrolling variant — the grid has nothing to scroll, so
// nothing to fade toward. The mask itself stays inert until initEdgeFade sets
// `data-fade` (utilities/utils.css explains why the width is static, not a var).
const shelfClass = grid
  ? 'home-shelf-grid grid grid-cols-2 gap-3 min-[900px]:grid-cols-3'
  : `home-shelf edge-fade${fillMobile ? ' home-shelf--fill-mobile' : ''}`;
// The shelf the visitor actually lands on fades in as one block on first paint —
// see `@keyframes shelf-arrive` in home.css for why it's the row and not the
// cards. `eagerFirst` already means exactly "the first shelf of the active tab",
// so no second prop is needed to say the same thing.
const arriveClass = eagerFirst
  // ease-out, not ease-in-out: an ease-in-out curve held the row under 10%
  // opacity for the first ~120ms, which reads as the page hanging rather than
  // as a fade. Fast off the mark, slow to settle.
  ? ' animate-[shelf-arrive_550ms_ease-out_both] motion-reduce:animate-none'
  : '';
---

{(stores.length > 0 || invites > 0) && (
  <section
    class="home-shelf-section"
    data-shelf
    aria-labelledby={hideHeading ? undefined : `shelf-${id}`}
    aria-label={hideHeading ? title : undefined}
  >
    <div class="container">
      {!hideHeading && (
        <div class="home-section-header">
          <h2 id={`shelf-${id}`} class="home-section-title">
            {categoryLabel
              ? <CategoryIcon label={categoryLabel} size={19} class={`home-shelf-icon home-shelf-icon--${dotIndex % 3}`} />
              : <span class={`home-shelf-dot home-shelf-dot--${dotIndex % 3}`} aria-hidden="true"></span>}
            {title}
          </h2>
        </div>
      )}
      <!-- --shelf-count drives the card max-width so a short shelf ends flush
           with the row instead of leaving a ragged tail — see store-card.css. -->
      <div class={shelfClass + arriveClass} role="list" aria-label={title}
           style={`--shelf-count:${cardCount};--shelf-card-max:${cardMax}`}>
        {stores.map(({ store, products }, i) => (
          <StoreCard
            store={store}
            previewImages={products.map((p) => p.images?.[0]).filter((u): u is string => !!u)}
            eager={eagerFirst && i === 0}
            previewSlots={previewSlots}
            role="listitem"
          />
        ))}
        {Array.from({ length: invites }).map((_, i) => (
          <StorePlaceholderCard index={stores.length + i} previewSlots={previewSlots} role="listitem" />
        ))}
      </div>
    </div>
  </section>
)}
