---
/** "שליחת פנייה בטופס" — the form itself, rendered on `/contact`.
 *
 * It takes FIVE kinds and a fault is one of them, which is why it stopped being named after that
 * one (owner, 2026-08-24: *"מתוך מרכז העזרה מגיעים לצור קשר ואז פתוח שם טופס של 'דווח על תקלה',
 * למה?"*). A general door — the help centre's "כתיבה אלינו", the footer's "צור קשר" — now opens on
 * "שאלה לפלטפורמה"; only a link that ASKS for a fault (`?report=fault`) preselects one.
 *
 * **Why a form and not a subject line on a `mailto:`** (which is what the contact page offered, and
 * the shape the question came in as): the three facts that make a report actionable are the three
 * nobody types — which page, which store, who they were. Everything under `page` below is captured,
 * not asked for, and `lib/platform-inquiries.ts` re-derives the store and the identity server-side rather
 * than believing this form about either.
 *
 * It also has somewhere to land, and since 2026-08-19 that somewhere can answer back: it opens a
 * THREAD in the admin's Messages inbox, so a reply reaches the sender inside the product instead of
 * from somebody's own mail client. It used to be a one-way slip on the Alerts tab, which the owner
 * ruled is for machine-detected failures and not for what people write.
 *
 * The strings the SCRIPT writes travel as `data-str-*` on the form, MessageCompose's pattern — this
 * component renders on one route, so a slice in the global i18n island would be weight on every
 * other page. Nothing here is built in the browser from a language conditional
 * (memory `project_client_renderer_i18n_drift`).
 */
import { getLang, getT } from '../i18n/index.js';
import { MAX_REPORT_LEN, REPORT_KINDS, type ReportKind } from '../lib/platform-inquiries.js';
import { RETURN_NOTE_MAX } from '../lib/returns.js';

interface Props {
  /** Preselected `kind`, so an in-context "report this" link arrives on the right option.
   *  **The default is a question, not a fault** — see `/contact`'s note; a general door must not
   *  open on the one kind that promises no reply. */
  kind?: string;
  /** The sender holds a store, so a thread opened here lands in their dashboard's Messages tab —
   *  which is true of every kind EXCEPT a fault (`platform-inquiries.ts`). Decides which of the two
   *  hints under the kind picker applies; false for a buyer, a guest, or a seller with no store. */
  sellerInbox?: boolean;
  /** The page being reported, when the visitor came from one. Site-relative; the server validates
   *  it again on arrival and does not trust this value either. */
  page?: string;
  /** A visitor who arrived from a mailed "פנייה בנוגע להזמנה" link: the order is already known and
   *  the signature already checked, so the two identifying fields are not asked for. The server
   *  re-verifies the token — this only decides what the form shows. */
  orderId?: string;
  orderToken?: string;
}
const { kind = 'question', page = '', orderId = '', orderToken = '', sellerInbox = false } = Astro.props;
const identified = !!(orderId && orderToken);

const lang = getLang(Astro.cookies);
const t = getT(lang);
const r = t.report;

/** A `Record` over `ReportKind`, not an array of pairs, and that is the whole point: the kinds are
 *  a CHECK constraint on `admin_messages.about_kind` and a `switch` in the admin panel, so a
 *  fifth one added there and forgotten here would render a form that cannot offer it. Typed this
 *  way the omission is a compile error, not a missing option nobody notices. */
const KIND_LABELS: Record<ReportKind, string> = {
  fault: r.kindFault,
  content: r.kindContent,
  store: r.kindStore,
  // The kind the old form had no word for, and the absence was load-bearing: a seller with a
  // question found only "תקלה" / "תוכן" / "בעיה עם חנות", none of which is what they came to say,
  // so the page sent them to a mailto instead. It is a thread like any other now.
  question: r.kindQuestion,
  other: r.kindOther,
};
const KINDS = REPORT_KINDS.map((value) => ({ value, label: KIND_LABELS[value] }));
/** `order` is NOT a `ReportKind` — it is the branch that opens a CASE rather than filing a report,
 *  so it deliberately has no row in the `about_kind` CHECK constraint. It is the form's own option,
 *  and the script below sends it to a different endpoint. */
const ORDER_KIND = 'order';
/** Not a `ReturnReason` — it is the branch that sends a MESSAGE instead of opening a case, so it
 *  deliberately has no row in the returns vocabulary. The script below routes it elsewhere. */
const QUESTION_REASON = 'question';
const selected = identified || kind === ORDER_KIND
  ? ORDER_KIND
  // An unrecognised `?report=` value falls back to the same kind an absent one gets, or the page's
  // default and its "I don't know" would be two different answers to one question.
  : ((REPORT_KINDS as readonly string[]).includes(kind) ? kind : 'question');

/** The closed list from the returns decisions doc §1, in the order it is written there. Values are
 *  `ReturnReason`; labels are the buyer's words. */
const REASONS = [
  { value: 'changed_mind', label: r.orderReasonChanged },
  { value: 'damaged', label: r.orderReasonDamaged },
  { value: 'wrong_item', label: r.orderReasonWrong },
  { value: 'not_arrived', label: r.orderReasonMissing },
];
---

<form
  id="report-form"
  data-page={page}
  data-str-sending={r.sending}
  data-str-submit={r.submit}
  data-str-error={r.error}
  data-str-error-empty={r.errorEmpty}
  data-str-throttled={r.throttled}
  data-order-kind={ORDER_KIND}
  data-order-id={orderId}
  data-order-token={orderToken}
  data-str-order-submit={r.orderSubmit}
  data-str-order-sent={r.orderSent}
  data-str-order-sent-body={r.orderSentBody}
  data-str-question-sent={r.questionSent}
  data-str-question-sent-body={r.questionSentBody}
  data-str-fault-sent-body={r.faultSentBody}
  data-question-reason={QUESTION_REASON}
  style="max-width:44rem;margin-top:1rem"
>
  <label class="field">
    <span>{r.kind}</span>
    <select id="report-kind" name="kind" class="input">
      <option value={ORDER_KIND} selected={selected === ORDER_KIND}>{r.kindOrder}</option>
      {KINDS.map((k) => <option value={k.value} selected={k.value === selected}>{k.label}</option>)}
    </select>
  </label>

  {/* **What happens to this after you press send, said before you write it** (owner, סשן ד׳: *"על
      תקלה אני לא מצפה שהמוכר יחכה לתשובה"*). The two kinds behave differently and always did — a
      fault is filed and fixed, everything else is a conversation — and nothing on the form said so,
      so a seller reported a bug and then waited. It sits under the picker because that is the
      control that decides which of the two it is, and it moves with it. Both strings are
      server-rendered onto the form (this component's own rule); the second one only exists when
      the sender actually has a dashboard for a reply to land in. */}
  <p id="report-kind-hint" class="muted" data-str-fault={r.hintFault}
     data-str-thread={sellerInbox ? r.hintThreadSeller : ''}
     style="font-size:0.82rem;margin:-0.35rem 0 1rem"></p>


  {/* ── The order branch ──
      Shown only for "פנייה בנוגע להזמנה", and it is a different KIND of submission: it opens a
      case against an order (`/api/returns`) instead of filing a report. The two identifying fields
      disappear entirely for a visitor who arrived from the mailed link — they have already proved
      which order is theirs, and asking again would be the form doubting its own credential. */}
  <div id="order-fields" hidden={selected !== ORDER_KIND}>
    {identified
      ? <p class="muted" style="font-size:0.85rem;margin:0 0 1rem">{r.orderIdentified}</p>
      : (
        <>
          <label class="field">
            <span>{r.orderRef}</span>
            <input id="order-ref" class="input" maxlength="8" dir="ltr" autocomplete="off" style="text-transform:uppercase" />
            <span class="muted" style="display:block;margin-top:0.35rem;font-size:0.82rem">{r.orderRefHint}</span>
          </label>
          <label class="field">
            <span>{r.orderEmail}</span>
            <input id="order-email" type="email" class="input" maxlength="200" autocomplete="email" />
          </label>
        </>
      )}

    {/* **"שאלה" first, and it is not a return reason** (owner, 2026-08-19). Until now the only
        thing a buyer could do with their own order here was open a CASE — a heavy instrument for
        "when is this shipping?", and one that leaves a record against the seller nobody wanted.
        Most of what arrives on this form is a question, so it is the first option and the default,
        and it goes to the SELLER (`/api/order-message`) rather than into the returns machinery. */}
    <label class="field">
      <span>{r.orderReason}</span>
      <select id="order-reason" class="input">
        <option value={QUESTION_REASON}>{r.orderReasonQuestion}</option>
        {REASONS.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </label>

    {/* The ONE free-text field on this surface, and it is capped rather than open — `returns.ts`
        argues why it exists at all and why 500. `resize:none` is a site-wide ban, not a choice. */}
    <label class="field">
      <span>{r.orderNote}</span>
      <textarea id="order-note" class="input" rows="3" maxlength={RETURN_NOTE_MAX} style="resize:none"></textarea>
      {/* The same counter, on the other free-text box of the same form. One with it and one
          without would read as a bug in whichever box lacked it. */}
      <span
        id="order-note-count"
        class="muted"
        dir="ltr"
        aria-live="off"
        hidden
        data-max={RETURN_NOTE_MAX}
        data-str-count={r.messageCount}
        style="display:block;margin-top:0.35rem;font-size:0.78rem;text-align:start"
      ></span>
    </label>
  </div>

  <label class="field" id="report-message-field">
    <span>{r.message}</span>
    <textarea
      id="report-message"
      name="message"
      class="input"
      rows="6"
      maxlength={MAX_REPORT_LEN}
      required
      placeholder={r.messagePlaceholder}
      style="resize:none"
    ></textarea>
    {/* **The ceiling, said out loud** (owner, 2026-08-24: *"צריך שם הגבלה על תווים! שלא כל אחד
        יוכל לשלוח לי תקלה עם 100000 תווים. וצריך שיהיה שם מד תווים"*). The cap itself was already
        there and enforced twice — `maxlength` here, and `platform-inquiries.ts` clamps the body
        again because nothing believes a form — but it was invisible, so a long message simply
        stopped accepting characters with no explanation. This is the missing half.
        `aria-live="off"`: it updates on every keystroke, and a screen reader announcing the count
        after each letter would make the field unusable. The remaining-characters figure is
        announced instead when it gets close (the script raises `aria-live` at the last 10%), which
        is the only moment it is news.
        `dir="ltr"` — the line is two numbers and a slash, and in an RTL paragraph the slash lands
        on the wrong side of them. */}
    <span
      id="report-count"
      class="muted"
      dir="ltr"
      aria-live="off"
      hidden
      data-max={MAX_REPORT_LEN}
      data-str-count={r.messageCount}
      style="display:block;margin-top:0.35rem;font-size:0.78rem;text-align:start"
    ></span>
  </label>

  <label class="field" id="report-email-field">
    <span>{r.email}</span>
    <input id="report-email" name="email" type="email" class="input" maxlength="200" autocomplete="email" />
    <span class="muted" style="display:block;margin-top:0.35rem;font-size:0.82rem">{r.emailHint}</span>
  </label>

  {page && (
    <p class="muted" style="font-size:0.82rem;margin:0 0 1rem">
      {r.pageContext}: <span dir="ltr">{page}</span>
    </p>
  )}

  <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
    <button id="report-submit" type="submit" class="btn btn--accent">{r.submit}</button>
    {/* aria-live, not a toast: the reply to a form submission belongs beside the button that was
        pressed, and a screen reader has to hear it without moving focus. */}
    <p id="report-status" role="status" aria-live="polite" style="margin:0;font-size:0.88rem"></p>
  </div>
</form>

{/* Replaces the form on success rather than sitting under it — leaving a filled form beside
    "sent" invites the same report a second time. */}
<div id="report-done" hidden style="max-width:44rem;margin-top:1rem;padding:1rem 1.25rem;border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface)">
  <p style="margin:0;font-weight:600">{r.sent}</p>
  <p class="muted" style="margin:0.35rem 0 0;font-size:0.9rem">{r.sentBody}</p>
</div>

<script>
  import { initSelectDropdown } from '../scripts/dashboard/select-dropdown.js';

  const form = document.getElementById('report-form') as HTMLFormElement | null;
  const done = document.getElementById('report-done');
  const status = document.getElementById('report-status');
  const submit = document.getElementById('report-submit') as HTMLButtonElement | null;
  if (form && submit) {
    const d = form.dataset;
    // Server-rendered, per the component note. The Hebrew after each `??` covers a missing
    // attribute only and is never the source of the string.
    const str = {
      sending: d.strSending ?? 'שולח…',
      submit: d.strSubmit ?? 'שליחת דיווח',
      error: d.strError ?? 'הדיווח לא נשלח. נסו שוב.',
      empty: d.strErrorEmpty ?? 'צריך לכתוב מה קרה',
      throttled: d.strThrottled ?? 'נשלחו כבר כמה דיווחים מהכתובת הזו. אפשר לנסות שוב בעוד {n} דקות.',
      orderSubmit: d.strOrderSubmit ?? 'שליחת הפנייה',
      orderSent: d.strOrderSent ?? 'הפנייה התקבלה',
      orderSentBody: d.strOrderSentBody ?? 'נטפל בה ונעדכן אתכם במייל.',
      questionSent: d.strQuestionSent ?? 'השאלה נשלחה למוכר',
      questionSentBody: d.strQuestionSentBody ?? 'המוכר יענה לכם במייל שאיתו בוצעה ההזמנה.',
      faultSentBody: d.strFaultSentBody ?? 'התקלה נרשמה ותיבדק. אין צורך להמתין לתשובה.',
    };
    const ORDER_KIND = d.orderKind ?? 'order';
    const QUESTION_REASON = d.questionReason ?? 'question';
    const kindEl = document.getElementById('report-kind') as HTMLSelectElement;
    // **The site's own dropdown, not the browser's** — standing instruction (owner, 2026-08-19),
    // and it holds on a PUBLIC page more than anywhere: `/contact` is the first screen a stranger
    // judges the platform by, and a native popup there is the one control wearing somebody else's
    // styling. The native element stays as the source of truth, so everything below that reads
    // `kindEl.value` or listens for `change` is untouched.
    initSelectDropdown(kindEl);
    // The order branch's reason picker, same rule. Both are on this form, and one upgraded while
    // the other stayed native would be worse than either choice made consistently.
    const reasonEl = document.getElementById('order-reason') as HTMLSelectElement | null;
    if (reasonEl) initSelectDropdown(reasonEl);
    const orderFields = document.getElementById('order-fields');
    const messageField = document.getElementById('report-message-field');
    const emailField = document.getElementById('report-email-field');
    const messageEl = document.getElementById('report-message') as HTMLTextAreaElement;

    /** One switch: the order branch swaps which fields exist, so the visitor is never looking at a
     *  form half of which does not apply to them. `required` moves with it — a hidden required
     *  field blocks submission with a validation bubble pointing at nothing. */
    const isOrder = () => kindEl.value === ORDER_KIND;
    const isFault = () => kindEl.value === 'fault';
    const hint = document.getElementById('report-kind-hint');
    const syncKind = () => {
      const order = isOrder();
      if (orderFields) orderFields.hidden = !order;
      if (messageField) messageField.hidden = order;
      if (emailField) emailField.hidden = order;
      messageEl.required = !order;
      submit.textContent = order ? str.orderSubmit : str.submit;
      if (hint) {
        // The order branch has its own copy further down and needs nothing here; an empty string
        // (a sender with no dashboard) leaves the line off the page rather than blank.
        const text = order ? '' : isFault() ? (hint.dataset.strFault ?? '') : (hint.dataset.strThread ?? '');
        hint.textContent = text;
        hint.hidden = !text;
      }
    };
    kindEl.addEventListener('change', syncKind);
    syncKind();

    /** The live character counter under a capped textarea.
     *
     * Reads its ceiling and its sentence off the `<span>` — the string is server-rendered like
     * every other one on this form (this component's own rule), and the max is the same constant
     * the `maxlength` attribute got, so the two cannot disagree.
     *
     * **It is not on screen until the last tenth** (owner, 2026-08-24: *"רעיון טוב, רק בעשירית
     * האחרונה"*). A count standing under an empty box is furniture — it tells everyone who writes
     * two normal sentences that they are being measured, against a number they were never going to
     * reach. It appears when it becomes news, and that is also the moment it turns amber, so the
     * arrival and the colour are one signal rather than a permanent line that occasionally
     * recolours.
     *
     * `aria-live` follows the same instant: silent while the line is absent, `polite` from the
     * moment it appears, so a screen-reader user hears the warning once instead of a number after
     * every keystroke — and never reaches the cap to find the field quietly ignoring them. The
     * colour is never the only signal (AI_INSTRUCTIONS → Accessibility): the line's arrival and
     * its words carry it.
     */
    const wireCounter = (areaId: string, outId: string) => {
      const area = document.getElementById(areaId) as HTMLTextAreaElement | null;
      const out = document.getElementById(outId);
      if (!area || !out) return;
      const max = Number(out.dataset.max ?? area.maxLength ?? 0);
      const tpl = out.dataset.strCount ?? '{n}/{max}';
      if (!max) return;
      const paint = () => {
        const n = area.value.length;
        const near = n >= max * 0.9;
        // Written before it is revealed, so the line is never blank for a frame.
        out.textContent = near ? tpl.replace('{n}', String(n)).replace('{max}', String(max)) : '';
        out.hidden = !near;
        out.style.color = near ? 'var(--color-warning)' : '';
        out.setAttribute('aria-live', near ? 'polite' : 'off');
      };
      area.addEventListener('input', paint);
      paint();
    };
    wireCounter('report-message', 'report-count');
    wireCounter('order-note', 'order-note-count');

    const say = (text: string, bad: boolean) => {
      if (!status) return;
      status.textContent = text;
      status.style.color = bad ? 'var(--color-danger)' : 'var(--color-muted)';
    };

    /** The order branch — a CASE, not a report.
     *
     * The credential is whatever the visitor has: the signed link they arrived on, or the order
     * number plus the address they bought with. The server decides which, and answers the SAME
     * thing either way (`order-access.ts`) — so this function cannot tell the difference between
     * "opened a case" and "no such order", and deliberately does not try. */
    const submitOrderCase = async (): Promise<void> => {
      const reason = (document.getElementById('order-reason') as HTMLSelectElement).value;
      const note = (document.getElementById('order-note') as HTMLTextAreaElement).value.trim();
      // The credential is whatever the visitor has, and it is the SAME either way — the signed link
      // they arrived on, or the order number plus the address they bought with. Built once here
      // because both destinations below take it and `order-access.ts` resolves it identically.
      const credential = d.orderId
        ? { orderId: d.orderId, token: d.orderToken }
        : {
            orderRef: (document.getElementById('order-ref') as HTMLInputElement).value.trim(),
            email: (document.getElementById('order-email') as HTMLInputElement).value.trim(),
          };

      // **A question is not a case.** It goes to the SELLER — the person who packed and shipped it
      // and the only one who can answer "when is this arriving" — instead of opening a return
      // against them. Same credential, different destination.
      const isQuestion = reason === QUESTION_REASON;
      const res = isQuestion
        ? await fetch('/api/order-message', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: note, ...credential }),
          })
        : await fetch('/api/returns', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'open', reason, note, ...credential }),
          });
      if (res.status === 429) {
        const body = await res.json() as { retryAfterMinutes?: number };
        say(str.throttled.replace('{n}', String(body.retryAfterMinutes ?? 60)), true);
        submit.disabled = false; submit.textContent = str.orderSubmit;
        return;
      }
      // **Every other outcome shows the same screen, including 403.** A form that says "we could
      // not find that order" is a way to discover which order numbers exist, and the reference is
      // only eight characters. A real 5xx is caught by the caller and says so.
      if (res.status >= 500) throw new Error('failed');
      const done2 = document.getElementById('report-done');
      if (done2) {
        const [h, b] = done2.querySelectorAll('p');
        // The two outcomes say different things because two different people will answer. Promising
        // "we'll update you" for a question would have the buyer waiting on the wrong party's mail.
        if (h) h.textContent = isQuestion ? str.questionSent : str.orderSent;
        if (b) b.textContent = isQuestion ? str.questionSentBody : str.orderSentBody;
        done2.hidden = false;
      }
      form.hidden = true;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const orderBranch = isOrder();
      const message = messageEl.value.trim();
      if (!orderBranch && !message) { say(str.empty, true); return; }
      // A return case can be filed on the reason alone — the note is genuinely optional there. A
      // QUESTION is nothing but its note, so an empty one would post a blank message to a seller
      // and come back a 400 the visitor cannot read the cause of.
      if (orderBranch
          && (document.getElementById('order-reason') as HTMLSelectElement).value === QUESTION_REASON
          && !(document.getElementById('order-note') as HTMLTextAreaElement).value.trim()) {
        say(str.empty, true);
        (document.getElementById('order-note') as HTMLTextAreaElement).focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = str.sending;
      say('', false);

      try {
        if (orderBranch) { await submitOrderCase(); return; }
        const res = await fetch('/api/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            kind: (document.getElementById('report-kind') as HTMLSelectElement).value,
            message,
            email: (document.getElementById('report-email') as HTMLInputElement).value.trim(),
            // Where they were when they hit the link, falling back to this page — the server
            // validates it as a site-relative path either way.
            pageUrl: d.page || location.pathname + location.search,
          }),
        });
        if (res.status === 429) {
          const body = await res.json() as { retryAfterMinutes?: number };
          say(str.throttled.replace('{n}', String(body.retryAfterMinutes ?? 60)), true);
          submit.disabled = false; submit.textContent = str.submit;
          return;
        }
        if (!res.ok) throw new Error('failed');
        form.hidden = true;
        if (done) {
          // A fault promises no reply; every other kind does. Same reason the order branch above
          // writes two different bodies — a screen that says "we will get back to you" for
          // something nobody is going to answer is the wait this change exists to remove.
          const body = done.querySelectorAll('p')[1];
          if (body && isFault()) body.textContent = str.faultSentBody;
          done.hidden = false;
        }
      } catch {
        say(str.error, true);
        submit.disabled = false;
        submit.textContent = isOrder() ? str.orderSubmit : str.submit;
      }
    });
  }
</script>
