---
/**
 * Banner for a showcase store (lib/demo-stores.ts): the store's photograph. Only that.
 *
 * ── Two overlays were built here and both were wrong (owner, 2026-08-12) ────
 * The first set the store's name in an `<svg viewBox="0 0 1200 400"
 * preserveAspectRatio="xMidYMid slice">`. `slice` means COVER, so in any box that is not exactly
 * 3/1 the viewBox scales up until it fills and the overflow is cut — and the name was anchored at
 * the edge, which is what got cut. He screenshotted "הר" where "סהר" belongs.
 *
 * The second replaced it with HTML, which fixed the clipping and then got the direction wrong: in
 * an RTL column flex, `align-items:flex-end` is the LEFT edge, so the Hebrew was pushed to the
 * wrong side. And white type over a photograph needed a scrim heavy enough that it read, in his
 * words, as writing on a scribble.
 *
 * A third overlay followed those two and lasted a day. It was HTML type, correctly placed, with a
 * scrim behind it — and it was still wrong, for a reason neither earlier attempt had: the BANNER
 * IMAGE NOW CARRIES THE NAME ITSELF. Each generated banner is composed around real signage reading
 * the store's name and its line (`identity.mjs#bannerPrompt`), so the overlay printed the same
 * words a second time, in a different typeface, over a photograph that already said them (owner,
 * 2026-08-13: "תעיף את הכיתוב שלך על גבי הבאנר").
 *
 * ── So there is no overlay, and no scrim either ─────────────────────────────
 * The scrim existed only to make white type legible. With no type there is nothing to make legible,
 * and darkening a third of the photograph for no reason is just a worse photograph.
 *
 * A real seller's banner has no text drawn over it either, and this page renders the store's name
 * as an `<h1>` in the identity row immediately below. What is left here is the picture, at the same
 * 3/1 geometry and through the same cdn helpers a seller's own banner uses. Nothing about a
 * showcase store's banner is special any more, which is the point.
 */
import { cdnBand, cdnCropSrcSet, BANNER_RATIO, BANNER_WIDTHS } from '../lib/cdn.js';

interface Props {
  /** Only for the image's alt text — the picture itself carries the name, so nothing is drawn. */
  name: string;
  bannerImage?: string;
  /** The store's own two colours — only used for the no-picture fallback. */
  colors?: { primary?: string; accent?: string };
}

const { name, bannerImage, colors } = Astro.props;

// Same geometry as a real seller's banner, so the two are the same box and the curtain-scroll on
// the store page is untouched. 2048 is the top width because the source is generated at 2K+ and a
// 1128px slot on a 2× display asks for 2256 — the widest rung has to be able to answer that.
const W = 2048;
const H = Math.round(W / BANNER_RATIO);
const SIZES = '(min-width: 1160px) 1128px, calc(100vw - 2rem)';

const primary = colors?.primary ?? '#2b2118';
const accent = colors?.accent ?? '#c4622d';
---

<div class="relative w-full h-full overflow-hidden" style="border-radius:inherit">
  {bannerImage ? (
    <img
      src={cdnBand(bannerImage, W, BANNER_RATIO)}
      srcset={cdnCropSrcSet(bannerImage, [...BANNER_WIDTHS], BANNER_RATIO) || undefined}
      sizes={SIZES}
      alt={`${name} — באנר החנות`}
      width={W}
      height={H}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
  ) : (
    /* No picture yet — a wash of the store's OWN palette, so an unseeded environment still reads as
       four different shops rather than four grey boxes. */
    <div class="absolute inset-0" style={`background:linear-gradient(135deg, ${accent} 0%, ${primary} 100%)`} />
  )}

</div>
