---
/**
 * Banner for a showcase store (lib/demo-stores.ts) — a generated graphic, never a
 * photo.
 *
 * A real store's banner is the seller's own artwork. A showcase store has no
 * seller, and the two obvious substitutes both fail: reusing one of its product
 * photos crops to a giant close-up of a single shirt (tried, looked broken), and
 * inventing brand artwork would make a demo store look like a real business.
 * Saying what it is, in type, is the honest version — and it doubles as the
 * disclosure the badge and the notice below it also carry.
 *
 * SVG rather than a styled `<div>`: the box is a fixed 3/1 crop shared with the
 * seller's banner tool, and `viewBox` + `preserveAspectRatio` makes the wordmark
 * scale with the container at every width for free — no font-size breakpoints,
 * and it can never wrap or clip. The hue comes from the same 5-colour palette the
 * placeholder cards rotate through (placeholder-art.ts), so the showcase stores
 * read as distinct shops rather than one template — keyed off POSITION in the
 * showcase set, not a hash of the slug: five buckets over strings that all start
 * "showcase-" collide immediately (two of the three came out the same orange).
 */
import { PLACEHOLDER_ART, pickCardHue } from '../lib/placeholder-art.js';
import { getLang, getT } from '../i18n/index.js';

interface Props {
  /** Only used to make the gradient id unique per store. */
  slug: string;
  /** Position in the showcase set — picks the hue, so no two of them match. */
  index?: number;
}

const { slug, index = 0 } = Astro.props;
const t = getT(getLang(Astro.cookies));
// Gradient ids are document-global: two banners on one page (never happens today,
// but a future "example stores" row would) must not share one.
const gradientId = `demo-banner-${slug.replace(/[^a-z0-9-]/gi, '')}`;
const hue = pickCardHue(index);

// The same line-art the placeholder cards use, ghosted into the background so a
// showcase store's banner and an empty slot's card read as one visual family.
// Fixed positions rather than random: SSR output has to be stable.
const MOTIF = [
  { id: 'bag', x: 118, y: 92, size: 132 },
  { id: 'mug', x: 992, y: 74, size: 116 },
  { id: 'shirt', x: 1052, y: 246, size: 104 },
  { id: 'plant', x: 226, y: 268, size: 96 },
].flatMap((m) => {
  const art = PLACEHOLDER_ART.find((a) => a.id === m.id);
  return art ? [{ ...m, paths: art.paths }] : [];
});
---

<svg
  viewBox="0 0 1200 400"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={t.demo.badge}
  class="block w-full h-full"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <!-- stop-color goes through `style`, not the attribute: a var() in a bare
           SVG presentation attribute isn't resolved, it's just an invalid string. -->
      <stop offset="0%" style={`stop-color:color-mix(in srgb, ${hue} 82%, #ffffff)`} />
      <stop offset="55%" style={`stop-color:${hue}`} />
      <stop offset="100%" style={`stop-color:color-mix(in srgb, ${hue} 72%, var(--color-primary-dark))`} />
    </linearGradient>
  </defs>

  <rect width="1200" height="400" fill={`url(#${gradientId})`} />

  <g fill="none" stroke="#ffffff" stroke-opacity="0.16" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {MOTIF.map((m) => (
      <g transform={`translate(${m.x - m.size / 2} ${m.y - m.size / 2}) scale(${m.size / 24})`} set:html={m.paths} />
    ))}
  </g>

  <!-- `dominant-baseline` is unreliable across engines for this; a plain `y` at
       the optical centre plus text-anchor:middle is the portable version. -->
  <text
    x="600" y="238" text-anchor="middle"
    font-family="Heebo, system-ui, sans-serif" font-size="112" font-weight="800"
    fill="#ffffff" letter-spacing="-1"
  >{t.demo.badge}</text>
</svg>
