---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import CsrfField from '../../components/CsrfField.astro';
import { registerSeller, setSellerSession, getSellerSession, MIN_PASSWORD_LENGTH } from '../../lib/seller-auth.js';
import { getLang, getT } from '../../i18n/index.js';
import { getDemoStores } from '../../lib/stores.js';
import { getVisibleProductsByStoreIds } from '../../lib/store-products.js';
import { safeRedirectPath } from '../../lib/safe-redirect.js';
import { isValidEmail } from '../../lib/email-address.js';
import { isGoogleAuthEnabled } from '../../lib/google-oauth.js';
import { clientIp } from '../../lib/client-ip.js';
import {
  checkAuthRate, countAuthAttempt, registerRules, retryAfterMinutes,
} from '../../lib/rate-limit.js';

// **Already signed in, and he pressed "פתח חנות"** — so take him to the form that opens one, not to
// the dashboard he was already looking at (owner, 2026-08-24). `?new=1` is the dashboard's own entry
// point for a second shop; for a seller with none it changes nothing, because the create card is
// what that page renders anyway. `\u0026` is not needed and no user input reaches this string, so it
// is a literal rather than a `machineUrl` — nothing here carries Hebrew.
if (getSellerSession(Astro.cookies)) return Astro.redirect('/seller/dashboard?new=1');

const lang = getLang(Astro.cookies);
const t    = getT(lang);
const googleEnabled = isGoogleAuthEnabled();

// Same rule as login — see lib/safe-redirect.ts.
const safeNext = safeRedirectPath(Astro.url.searchParams.get('next'), '/', ['/seller/register']);

// The seller-facing way into a finished store (lib/demo-stores.ts) — this entry
// point never expires, unlike the showcase stores' presence in shopper discovery.
// First showcase store that actually has something on its shelves; nothing renders
// if the showcase seeder was never run, so this can't become a dead link.
const demoStores = await getDemoStores();
const demoProducts = await getVisibleProductsByStoreIds(demoStores.map((s) => s.id));
const showcase = demoStores.find((s) => (demoProducts.get(s.id) ?? []).length > 0) ?? null;

const oauthError = Astro.url.searchParams.get('error');
const oauthErrorMsg =
  oauthError === 'oauth_denied' ? t.auth.oauthDenied :
  oauthError === 'oauth_unverified_email' ? t.auth.oauthUnverifiedEmail :
  oauthError ? t.auth.oauthFailed : '';

let error = oauthErrorMsg;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name     = String(form.get('name')     || '').trim();
  const email    = String(form.get('email')    || '').trim();
  const password = String(form.get('password') || '');
  // The hidden field is as attacker-controlled as `?next=` — a form on someone else's page posts
  // here with whatever it likes — so it goes through the same rule (lib/safe-redirect.ts).
  const next     = safeRedirectPath(String(form.get('_next') ?? ''), safeNext, ['/seller/register']);

  if (!name || !email || !password) {
    error = t.auth.allRequired;
  } else if (!isValidEmail(email)) {
    // The browser's type="email" is a convenience, not a guarantee — this POST can arrive without
    // one. The address is the account's only recovery channel, so a junk value is unrecoverable.
    error = t.auth.invalidEmail;
  } else if (password.length < MIN_PASSWORD_LENGTH) {
    error = t.auth.passwordTooShort;
  } else {
    // Per-source only, and counted on EVERY attempt that reaches this point — including a
    // successful one. Unlike login, the two behaviours being limited here are enumeration ("is
    // this address taken?", which `emailExists` answers truthfully by design) and bulk account
    // creation, and a success is exactly what the second one looks like. Counting failures alone
    // would leave mass signup unbounded. Deliberately NOT keyed to the submitted address: that
    // would let anyone lock a competitor out of registering by burning their address first.
    const rules = registerRules(clientIp(Astro.request, Astro.clientAddress));
    const gate = await checkAuthRate(rules);
    if (!gate.allowed) {
      Astro.response.status = 429;
      error = t.auth.tooManyAttempts.replace('{n}', String(retryAfterMinutes(gate.retryAfterSec)));
    } else {
      await countAuthAttempt(rules);
      const seller = await registerSeller(email, password, name);
      if (!seller) {
        error = t.auth.emailExists;
      } else {
        setSellerSession(Astro.cookies, seller.id);
        return Astro.redirect(next);
      }
    }
  }
}
---

<BaseLayout title={t.auth.openStore} noindex={true} isLoggedIn={false} hasStore={false} storeMode={true} sellerMode={true}>
  <section class="section container auth-wrap">
    <div class="auth-card">
      <header class="auth-head">
        <BrandLogo class="mb-[0.9rem]" size="1.45rem" />
        <h1>{t.auth.openStore}</h1>
        <p class="auth-subtitle">{t.auth.createFree}</p>
      </header>

      {error && <p class="auth-error" role="alert">{error}</p>}

      {/* Only offered when the flow can actually complete: with no GOOGLE_CLIENT_ID/SECRET the
          route answers a bare 503, so an always-rendered button was a dead end (lib/google-oauth.ts). */}
      {googleEnabled && (
        <Fragment>
        <a href={`/api/auth/google?next=${encodeURIComponent(safeNext)}`} class="btn-google" aria-label={t.auth.continueWithGoogle}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          {t.auth.continueWithGoogle}
        </a>

        <div class="auth-divider"><span>{t.auth.orDivider}</span></div>
        </Fragment>
      )}

      <form method="POST" class="auth-form">
        <CsrfField />
        <input type="hidden" name="_next" value={safeNext} />
        <label class="field">
          <span>{t.auth.yourName}</span>
          <input class="input" type="text" name="name" required autocomplete="name" placeholder={t.auth.namePlaceholder} />
        </label>
        <label class="field">
          <span>{t.auth.email}</span>
          <input class="input" type="email" name="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span>{t.auth.password}</span>
          <input class="input" type="password" name="password" required minlength="6" autocomplete="new-password" />
        </label>
        <button class="btn btn--accent" type="submit">{t.auth.createStore}</button>
        <p class="muted auth-switch">{t.auth.alreadyHaveStore} <a href="/seller/login">{t.auth.loginLink}</a></p>
      </form>
    </div>

    <ul class="auth-benefits">
      <li>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        {t.auth.benefitMall}
      </li>
      <li>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        {t.auth.benefitBuiltIn}
      </li>
      <li>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        {t.auth.benefitHebrew}
      </li>
    </ul>

    {/* ── The price, named on the form (2026-08-23) ──
        A registration form that never mentions money reads as one hiding it, and this one asks for
        no card at all — which is a stronger thing to say when the reader can go and check what the
        card would eventually be for. It is the sentence, not a button: the action on this page is
        registering, and a second call to action beside it competes with the one that matters. */}
    <p class="mt-4 text-center text-[0.85rem] muted">
      <a href="/pricing">{t.footer.pricing}</a>
    </p>

    {showcase && (
      <p class="mt-4 text-center text-[0.85rem]">
        <a
          class="inline-flex items-center gap-1.5 [color:var(--color-accent-dark)] font-medium hover:underline"
          href={`/${showcase.slug}`}
        >
          {t.demo.sellerLink}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
            {lang === 'he' ? <polyline points="15 18 9 12 15 6"/> : <polyline points="9 18 15 12 9 6"/>}
          </svg>
        </a>
      </p>
    )}
  </section>
</BaseLayout>
