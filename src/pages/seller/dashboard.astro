<script>
  import { initCropModal } from '../../scripts/dashboard/crop-modal.js';
  import { initCleanupModal } from '../../scripts/dashboard/cleanup-modal.js';
  import { initGalleryWidget } from '../../scripts/dashboard/gallery.js';
  import { bindExistingRows, initAddProduct, initDeleteProduct, initProductVisibilityToggle, initProductMenus, initProductsToolbar, initSpecsEditors, initVariantEditors, initTagsEditor, initRemoveConfirm, initStockBreakdowns, initBulkSelect, initThumbs, initInlineEdit, initViewProduct, initPagination, initStickyOffsets, applyStockAttentionFilter } from '../../scripts/dashboard/products.js';
  import { initCsvImport } from '../../scripts/dashboard/csv-import.js';
  import { initFeedSync } from '../../scripts/dashboard/feed-sync.js';
  import { initCustomDomain } from '../../scripts/dashboard/custom-domain.js';
  import { initStoreUrl } from '../../scripts/dashboard/store-url.js';
  import { initSettingsForm, initFormToggles, initStoreSwitcher, initAutoHideStatus, initDashTabs, initStoreHours, initGotoPanelLinks, initStorePreviewLink } from '../../scripts/dashboard/ui.js';
  import { initUnsavedGuard } from '../../scripts/dashboard/unsaved-guard.js';
  import { initStoreImageWidget } from '../../scripts/dashboard/store-image.js';
  import { initCategoryTreeEditor } from '../../scripts/dashboard/category-tree.js';
  import { initCategoryPicker } from '../../scripts/dashboard/category-picker.js';
  import { createFloatingPortal } from '../../lib/toolbar-portal.js';
  import { orderAgeChipHtml } from '../../lib/order-age.js';
  import { encodeList, debounce } from '../../lib/admin-nav.js';
  import { initPerformanceTab } from '../../scripts/dashboard/performance.js';
  import { initAdvertisingTab } from '../../scripts/dashboard/advertising.js';
  import { initOrdersTab } from '../../scripts/dashboard/orders.js';
  import { initMessagesTab } from '../../scripts/dashboard/messages.js';
  import { initSelectDropdown, COMPACT_TRIGGER_CLASS } from '../../scripts/dashboard/select-dropdown.js';
  import { initAllStoreCategoryPickers } from '../../scripts/store-category-picker.js';

  const uploadCfg = document.getElementById('upload-config');
  const CLOUD  = uploadCfg?.dataset.cloud  ?? '';
  const PRESET = uploadCfg?.dataset.preset ?? '';

  // clean status params from URL + handle deep-link params
  {
    const u = new URL(window.location.href);
    if (u.searchParams.has('saved') || u.searchParams.has('added')) {
      u.searchParams.delete('saved'); u.searchParams.delete('added'); history.replaceState(null, '', u.toString());
    }
  }

  initDashTabs();
  initGotoPanelLinks();
  initPerformanceTab();
  initAdvertisingTab();

  // Deep-link: ?panel=messages&msg=<id>
  {
    const params = new URLSearchParams(window.location.search);
    const panel  = params.get('panel');
    const msgId  = params.get('msg');
    if (panel) {
      const tabBtn = document.querySelector<HTMLButtonElement>(`[role="tab"][data-panel="${panel}"]`);
      if (tabBtn) tabBtn.click();
      if (msgId && panel === 'messages') {
        requestAnimationFrame(() => {
          const card = document.querySelector<HTMLElement>(`[data-msg-id="${CSS.escape(msgId)}"]`);
          if (card) { card.click(); card.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        });
      }
    }
    if (msgId) {
      const u = new URL(window.location.href);
      u.searchParams.delete('msg');
      history.replaceState(null, '', u.toString());
    }
  }

  initCropModal();
  initCleanupModal();

  {
    let dashI18n: Record<string, string> = {};
    try { dashI18n = JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}').dashboard ?? {}; } catch { /* noop */ }
    const labels = {
      upload: dashI18n.uploadImage ?? 'Upload image',
      change: dashI18n.storeImageChange ?? 'Change image',
      remove: dashI18n.removeImage ?? 'Remove',
      uploading: dashI18n.uploadingImage ?? 'Uploading image…',
    };
    initStoreImageWidget({
      frameId: 'banner-frame', fileInputId: 'banner-file-input', hiddenInputId: 'banner-image-input',
      uploadBtnId: 'banner-upload-btn', removeBtnId: 'banner-remove-btn',
      aspect: 3, vpWidth: 420, previewWidth: 900, cloud: CLOUD, preset: PRESET, labels,
    });
    initStoreImageWidget({
      frameId: 'avatar-frame', fileInputId: 'avatar-file-input', hiddenInputId: 'avatar-image-input',
      uploadBtnId: 'avatar-upload-btn', removeBtnId: 'avatar-remove-btn',
      aspect: 1, vpWidth: 220, previewWidth: 200, cloud: CLOUD, preset: PRESET, labels,
    });
  }
  initSpecsEditors();
  // Registered before the editors below: its document-level click listener
  // must see the pre-click "is anything armed?" state before either editor's
  // own listener arms a *new* confirm on this same click — otherwise the
  // just-armed span looks like a stale one (its trigger element just got
  // replaced) and gets cancelled in the same event that armed it.
  initRemoveConfirm();
  initVariantEditors();
  initTagsEditor();
  initStockBreakdowns();
  document.querySelectorAll<Element>('.gallery-widget').forEach(g => initGalleryWidget(g));
  bindExistingRows(CLOUD, PRESET);
  document.querySelectorAll<HTMLElement>('.category-picker').forEach(initCategoryPicker);
  initAddProduct(CLOUD, PRESET);
  initProductMenus();
  initDeleteProduct();
  initProductVisibilityToggle();
  initSettingsForm();
  initUnsavedGuard();
  initStorePreviewLink();
  initStoreHours();
  initCategoryTreeEditor();
  initFormToggles();
  initStoreSwitcher();
  initAutoHideStatus();
  initProductsToolbar();
  initBulkSelect(CLOUD, PRESET);
  initCsvImport();
  initFeedSync();
  initCustomDomain();
  initStoreUrl();
  initThumbs();
  initInlineEdit();
  initPagination();
  {
    // Page-size native <select> → app dropdown (compact pill matching the
    // sort/filter chips beside it). Keeps the select as value source, so
    // initPagination's `change` listener is untouched (CURRENT_TASK 2).
    const pageSizeSelect = document.getElementById('products-page-size') as HTMLSelectElement | null;
    if (pageSizeSelect) initSelectDropdown(pageSizeSelect, { triggerClassName: COMPACT_TRIGGER_CLASS });
  }
  initStickyOffsets();
  initViewProduct();

  // Keeps the store-switcher title dot (and this store's own row-dot in the
  // dropdown) in sync as orders get handled / messages get read — without a
  // page reload. Re-derives "does the current store still have an alert"
  // from what's actually left in the DOM (.order-new-dot / .msg-table__row--unread),
  // since those are already kept accurate by the order/message handlers.
  function updateSwitcherAlertDot(): void {
    const switcherBtn = document.getElementById('store-switcher-btn');
    const menu        = document.getElementById('store-switcher-menu');
    if (!switcherBtn || !menu) return;

    const currentLink = menu.querySelector<HTMLElement>('a.store-option--current');
    if (currentLink) {
      const dotHost = currentLink.querySelector<HTMLElement>('.store-switcher__item-actions');
      const dot     = currentLink.querySelector<HTMLElement>('.store-switcher__item-dot');
      const currentHasAlert =
        document.querySelectorAll('.order-new-dot').length > 0 ||
        document.querySelectorAll('.msg-table__row--unread').length > 0;
      if (currentHasAlert && !dot && dotHost) {
        const newDot = document.createElement('span');
        newDot.className = 'store-switcher__item-dot';
        newDot.setAttribute('aria-label', 'יש התראות');
        dotHost.prepend(newDot);
      } else if (!currentHasAlert && dot) {
        dot.remove();
      }
    }

    // Button dot only reflects OTHER stores — the whole point is to send the
    // seller there. If it's the current store's own alert, they're already
    // looking at it, so it's excluded here (see hasAnyNonCurrentAlert above).
    const anyOtherAlert = Array.from(menu.querySelectorAll<HTMLElement>('.store-switcher__item-dot'))
      .some((dot) => !dot.closest('a')?.classList.contains('store-option--current'));
    let btnDot = switcherBtn.querySelector<HTMLElement>('.store-switcher__alert-dot');
    if (anyOtherAlert && !btnDot) {
      btnDot = document.createElement('span');
      btnDot.className = 'store-switcher__alert-dot';
      btnDot.setAttribute('aria-label', 'יש התראות בחנויות אחרות');
      switcherBtn.querySelector('.store-switcher__chevron')?.after(btnDot);
    } else if (!anyOtherAlert && btnDot) {
      btnDot.remove();
    }
  }

  // Orders + Messages tabs — extracted to their own modules; both share the
  // switcher-alert refresh above (called on order-status / mark-read changes).
  initOrdersTab(updateSwitcherAlertDot);
  initMessagesTab(updateSwitcherAlertDot);
  initAllStoreCategoryPickers();
</script>
