// control here — that was only asked for on Products).
//
// **The page is a page in the QUERY now (2026-08-11).** The tab was already paginated, but the read
// behind it was the store's entire order history, filtered and sorted in JavaScript so fifteen rows
// could be kept — on the first paint of the page a seller opens all day. The three counts beside it
// were three more passes over that same array and are one `GROUP BY` now. Both reads are
// independent, so they go together.
const sellerOrderQuery = parseSellerOrderQuery(Astro.url.searchParams);
// Deliberately SEQUENTIAL, and the one place on this page where that is right (the standing rule is
// that independent reads share a `Promise.all` — these are not independent). The new-order poll
// starts from this instant, so it has to be older than the orders below it: taken alongside them,
// an order committed in between would be both absent from the page and older than the watermark,
// which is a new order nobody is ever told about. `getOrderPollWatermark` carries the reasoning.
//
// The PAGE of orders belongs to this tab and is read only for it. The status COUNTS are not: the
// "(N)" badge on the tab strip is one of them, and a badge reports a tab the seller is not looking
// at. One `GROUP BY` whatever the store's history, which is what makes it affordable everywhere.
const ordersWatermark = store ? await only(['orders'], () => getOrderPollWatermark(), '') : '';
const [ordersPage, orderStatusCounts] = store
  ? await Promise.all([
      only(['orders'], () => getSellerOrdersPage(store.slug, sellerOrderQuery, parsePage(Astro.url.searchParams, 'opage'), 15),
        { orders: [] as Order[], total: 0, page: 1, totalPages: 1 }),
      getSellerOrderStatusCounts(store.slug),
    ])
  : [{ orders: [] as Order[], total: 0, page: 1, totalPages: 1 }, {} as Record<string, number>];
const newOrdersCount = orderStatusCounts.pending ?? 0;

// ── The returns tab's two reads ──
//
// The badge is a single indexed COUNT and runs on EVERY panel, because it is what tells a seller
// there is something waiting on a tab he is not looking at — a badge that only appears once you
// open the tab is not a badge. The list itself is behind `only`, so a store with no returns pays
// one count and nothing else.
//
// Both are skipped entirely when there is no store selected: `store` is null on an account whose
// shop was just deleted, and a query keyed on a slug that does not exist is a round trip whose
// only possible answer is "none".
// Cases HE has to act on — not cases that are open. A badge is a claim that something needs doing,
// and this one used to include every request waiting on the buyer to post a parcel and every one
// waiting on our own decision (owner, 2026-08-20). `returns.ts#sellerActionSql` is the single
// definition, shared with the panel's own header line.
const openReturnsCount = store ? await countSellerActionReturns(store.slug) : 0;
// The words for the chip above, per order — one batched read, and only on the tab that renders
// order cards. `openReturnsCount` above is the badge and runs everywhere; this is the detail and
// runs where it is drawn.
//
// The KEY, not the word (`lib/return-chip.ts`) — the client twin renders this same card after every
// search, sort and poll and has to draw the same chip from its own dictionary. It did not draw one
// at all until 2026-08-20, which is why the chip vanished the first time a seller typed in the
// search box.
const returnChipByOrderId = new Map<string, OrderReturnChip>();
if (store && shows('orders') && ordersPage.orders.length) {
  const live = await getLatestReturnsByOrder(ordersPage.orders.map((o: Order) => o.id), store.slug);
  for (const [orderId, r] of live) {
    const chip = orderReturnChip(r.status, orderId);
    if (chip) returnChipByOrderId.set(orderId, chip);
  }
}
const returnRequests = store
  ? await only(['returns'], () => getReturnsForStore(store.slug), [])
  : [];
// The order dates each card shows (`return-requests.ts#getOrderFactsForReturns`). One query for the
// whole tab, after the list because the ids are its output — and it is not asked at all on a store
// with no cases, where its only possible answer is "none".
const returnOrderFacts = returnRequests.length
  ? await getOrderFactsForReturns(returnRequests.map((r) => r.orderId), store!.slug)
  : new Map();
// Whether the seller has already provided each of these orders' buyer invoices. One query for the
// page, after it, because the ids are its output — and skipped entirely when there are no orders,
// so an empty store's first paint does not pay for a round trip that can only answer "none".
const invoiceStates = ordersPage.orders.length
  ? await getBuyerInvoiceStates(sellerId, ordersPage.orders.map((o) => o.id))
  : new Map();
// Overview "orders needing attention" square (CURRENT_TASK item 4): 'processing'
// (בטיפול) = started but not yet shipped, the second attention stage after the
// new-orders ('pending') count above. 'ready' (ממתין לאיסוף) is omitted for the
// same reason the Orders filter omits it — no seller can reach it today (carrier-
// driven once shipping is wired). Clicking a square jumps to the Orders tab filtered
// to exactly that status, so the count and the filtered list always agree.
const unshippedOrdersCount = orderStatusCounts.processing ?? 0;
/** Every order this store has ever taken — the "orders so far" stat, and the test the tab's
 *  empty state asks ("no orders at all" is a different screen from "none match this filter"). */
const storeOrdersTotal = Object.values(orderStatusCounts).reduce((sum, n) => sum + n, 0);

/**
 * The overview's money row (owner, סשן א׳ §4), scoped to THIS SHOP and nothing else.
 *
 * The first version carried a third tile with the account-wide held total beside the per-store one.
 * The owner cut it, and gave the rule rather than the correction (2026-08-11): *"כמה שפחות לערבב
 * בין חנויות יחד, זה אמור להיות מידע משני ולא מרכזי. הוא נמצא על חנות א׳ אז הוא צריך לקבל מידע על
 * חנות א׳."* An overview is the most central surface in the dashboard, so it is the last place a
 * cross-store figure belongs; the one number that genuinely cannot be split by shop — the transfer
 * — is said once, on the Payments tab, under the tile it qualifies.
 *
 * So both tiles here are the store in the switcher, and neither needs a scope suffix: the whole
 * panel is about that shop, which is what makes the plain labels honest.
 *
 * **Costing nothing extra, and agreeing by construction.** `payoutAccount` is already read on every
 * dashboard load for the tab's badge, and both figures come from the same two functions the Payments
 * tab calls (`payableHeadlineAgorot`, `splitHeldByBasis`) — so they are a reduce over rows already
 * in memory, and the two screens cannot print different numbers for one shop.
 */
function heldTotalFor(slug: string): number {
  if (!payoutAccount) return 0;
  const split = splitHeldByBasis(payoutAccount.account.slices, slug);
  return split.groups.reduce((t, g) => t + g.agorot, 0) + split.unknownAgorot;
}
// ⚠️ `splitHeldByBasis` with no slug is the WHOLE ACCOUNT, which is why `heldTotalFor` takes a
// REQUIRED one and the no-store case is handled here instead. Passing `store?.slug` straight through
// would have printed the account-wide figure under a label naming one shop — zero in practice (no
// store, no orders), which is exactly what makes it the kind of mislabelling that ships.
const ovHeldThisStore = store ? heldTotalFor(store.slug) : 0;
// The SAME rule the Payments tab's headline tile uses, from the same function: this shop's released
// money for a multi-store seller, the account figure for a seller who has only one shop for it to
// come from. `order-payout-line.ts#payableHeadlineAgorot` carries why those differ.
const ovPayableNow = payoutAccount
  ? payableHeadlineAgorot(payoutAccount.account.slices, store?.slug ?? null, allStores.length > 1, payoutAccount.account.payableNowAgorot)
  : 0;
// The toolbar's filter badge is SSR-computed (same as AdminOrdersPanel.astro) because
// the first paint ALREADY shows a filtered list — the default "active" preset. Leaving
// it hidden until the client's refreshOrdersFilterBadge() first runs (only on a filter/
// sort/page change) told the seller "no filter" while rows were in fact being hidden.
// One entry per filter column — and the second column ACTUALLY ARRIVED (payout status,
// 2026-08-11) and was not added here, so a deep link that selected both showed "1" on the badge
// while the client's own count said 2 the moment anything was clicked (owner). The comment
// promised this would be a one-line change and then nobody made it; it is made now, and the
// two counts are the same question asked on two sides of one request.
const ordersActiveFilterCount = [sellerOrderQuery.shippingStatus, sellerOrderQuery.payoutStatus]
  .filter((v) => v.length > 0).length;

// Alerts per store for store-switcher dots — EVERYTHING that shop is waiting on, at the severity
// `seller-alerts.ts` assigns it (a person waiting = danger, a wrong state = warning). It used to be
// orders and mail only, so a stock-out or a stopped boost in another shop was invisible until the
// seller happened to switch to it (owner, 2026-08-12).
const storeAlerts: Record<string, StoreAlertLevel> = allStores.length > 1 ? await getSellerStoreAlerts(sellerId) : {};
// The header dot should point the seller TO the alert — so it only fires when
// a store OTHER than the one currently open has something unhandled. If the
// seller is already looking at the store with the alert, they can already
// see it there (tab badge / order dot), so the header dot would be redundant.
// It carries the LOUDEST of those stores' levels, because it stands for all of them at once.
const otherStoreLevels = store
  ? Object.entries(storeAlerts).filter(([id]) => id !== store.id).map(([, v]) => v)
  : [];
const otherStoresLevel: StoreAlertLevel | null =
  otherStoreLevels.includes('danger') ? 'danger' : otherStoreLevels.length > 0 ? 'warning' : null;

/**
 * Every shipping status the seller can SEE, named — and `returned` was the one that was not.
 *
 * It is a real status: `return-requests.ts` moves the order to it when a whole-order return is
 * refunded, and it is deliberately not a flavour of `cancelled` (`order-status-rules.ts` argues
 * why). It reached this map through no door at all, so the filter menu — which is generated from
 * the status table, exactly so a new status cannot be forgotten — fell back to `?? value` and
 * printed the raw English word beside "בוטלה" (owner, 2026-08-20: *"יש שם כפילות מוזרה! כשהאתר
 * בעברית לפחות"*). Two rows in a filter, one of them in the wrong language, reading as the same
 * thing.
 *
 * `dashboard.shippingReturned` had existed in both dictionaries the whole time. Pinned now by
 * `orders-i18n.test.ts`, which fails if a filterable status has no name here or in the client twin.
 */
const orderShippingLabels: Record<string, string> = {
  pending: d.shippingPending,
  processing: d.shippingProcessing,
  ready: d.shippingReady,
  shipped: d.shippingShipped,
  delivered: d.shippingDelivered,
  cancelled: d.shippingCancelled,
  returned: d.shippingReturned,
};

const orderStatusColors: Record<string, string> = {
  pending: '#ef4444',
  processing: '#3b82f6',
  ready: '#f59e0b',
  shipped: '#8b5cf6',
  delivered: '#16a34a',
  cancelled: '#6b7280',
  // Its own colour, not the cancellation's grey: the two orders look identical in every money
  // column and are different events, which is the whole reason they are separate statuses.
  returned: '#0d9488',
};

---

<BaseLayout title={hasNoStore ? d.noStoreTitle : d.title} noindex={true} isLoggedIn={true} hasStore={!hasNoStore} storeMode={true} sellerMode={true}>
  {showCreateStore ? (
    <CreateStoreCard first={hasNoStore} error={error} vocabulary={categoryVocabulary} />
  ) : store ? (
  <Fragment>
  <FormFallbackGuard message={d.saveUnavailable} draftFound={d.draftFound} draftRestore={d.draftRestore} draftDiscard={d.draftDiscard} draftNotice={d.draftNotice} draftOpenFailed={d.draftOpenFailed} draftNoticeMoreOne={d.draftNoticeMoreOne} draftNoticeMore={d.draftNoticeMore} />
  {/* The store's category tree, for every client renderer that has to turn a `categoryId` back into
      a readable path: the products table's chip, its category filter and sort, and the category
      picker inside a product's edit form.

      It sits HERE, in the page shell, and that is the whole point — it used to live inside the
      SETTINGS panel, next to the tree editor that owns it. That was fine until panels stopped being
      server-rendered (2026-08-11): from then on a seller who never opened Settings had no tree in
      the DOM at all, `getCategoryTree()` returned `[]`, and every one of those renderers silently
      resolved a real category to nothing. The symptom the owner hit (2026-08-15) was the edit form
      showing "ללא קטגוריה" for a product that plainly had one — and the same emptiness was in the
      chip of every row the table REBUILT (i.e. after any page change, filter or sort), while page
      one still looked right because the server had rendered it.

      Data a client renderer needs belongs to the page, not to the panel that happens to edit it. */}
  <script type="application/json" id="category-tree-data" set:html={jsonForScript(categoryTree)} />
  <div id="upload-config" data-cloud={cloudinaryCloud} data-preset={cloudinaryPreset} data-invoice-preset={cloudinaryInvoicePreset} data-store-slug={store.slug} data-store-id={store.id} data-store-name={store.name} data-host={platformHost} data-seller-id={sellerId} data-bg-colors={JSON.stringify(store.bgColors ?? [])} hidden></div>
  <section class="section container dash-section dash-section--bleed">
    <div id="dash-main-card" class="card seller-dash" style="margin-bottom:1.5rem">

      <!-- ── Store header ── -->
      <div class="dash-head">
        <div class="dash-head__top">
          {/* The switcher renders even for a single-store seller — it is the only entry point to
              "open another store", and one mechanism beats a second entry point hidden elsewhere. */}
          <div class="relative inline-block" id="store-switcher">
              <button
                class="group inline-flex items-center gap-[.3rem] bg-transparent border-0 p-0 cursor-pointer font-[inherit] text-[color:var(--color-text)] transition-colors duration-150 hover:text-[color:var(--color-accent)]"
                id="store-switcher-btn"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label={lang === 'he' ? 'החלף חנות' : 'Switch store'}
              >
                <span class="dash-store-name text-[1.3rem] font-bold m-0 leading-[1.2]">{store.name}</span>
                <svg class="store-switcher__chevron text-[color:var(--color-muted)] shrink-0 mt-px [transition:transform_.2s_ease,color_.15s] group-hover:text-[color:var(--color-accent)] group-aria-expanded:rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
                {otherStoresLevel && (
                  <span class="store-switcher__alert-dot" data-level={otherStoresLevel} aria-label={otherStoresLevel === 'danger' ? t.dashboard.alertsDotOtherStores : t.dashboard.alertsDotOtherStoresWarning}></span>
                )}
              </button>
              <ul class="absolute top-[calc(100%+0.5rem)] start-0 min-w-[200px] bg-[color:var(--color-surface)] border border-[color:var(--color-border)] rounded-[var(--radius)] shadow-[0_4px_20px_rgba(0,0,0,0.1)] z-20 list-none m-0 p-[.35rem] [&:not([hidden])]:animate-[user-dropdown-open_130ms_cubic-bezier(0.34,1.56,0.64,1)]" id="store-switcher-menu" role="listbox" data-str-alert-dot={t.dashboard.alertsDot} data-str-alert-dot-other={t.dashboard.alertsDotOtherStores} data-str-alert-dot-warning={t.dashboard.alertsDotWarning} data-str-alert-dot-other-warning={t.dashboard.alertsDotOtherStoresWarning} hidden>
                {allStores.map((s) => (
                  <li>
                    <a
                      href={`/seller/dashboard?store=${s.id}&panel=${initialPanel}`}
                      data-panel-link
                      role="option"
                      aria-selected={s.id === store.id}
                      class={s.id === store.id
                        /* `store-option--current` is a JS-only marker (no CSS) — updateSwitcherAlertDot() below finds the current row through it. */
                        ? 'store-option--current flex items-center justify-between gap-2 py-[.45rem] px-3 rounded-[var(--radius-sm)] no-underline text-[.9rem] transition-colors duration-100 hover:bg-[color:var(--color-bg)] font-semibold text-[color:var(--color-primary)]'
                        : 'flex items-center justify-between gap-2 py-[.45rem] px-3 rounded-[var(--radius-sm)] text-[color:var(--color-text)] no-underline text-[.9rem] transition-colors duration-100 hover:bg-[color:var(--color-bg)]'}
                    >
                      <span>{s.name}</span>
                      <span class="store-switcher__item-actions" style="display:flex;align-items:center;gap:0.35rem;flex-shrink:0">
                        {storeAlerts[s.id] && (
                          <span class="store-switcher__item-dot" data-level={storeAlerts[s.id]} aria-label={storeAlerts[s.id] === 'danger' ? t.dashboard.alertsDot : t.dashboard.alertsDotWarning}></span>
                        )}
                        {s.id === store.id && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
                <li class="mt-[.2rem] pt-[.2rem] border-t [border-color:var(--color-border)]">
                  {atStoreLimit ? (
                  <p class="m-0 py-[.45rem] px-3 text-[.8rem] leading-[1.4] [color:var(--color-muted)]">{d.storeLimitReached}</p>
                  ) : (
                  <a
                    href="/seller/dashboard?new=1"
                    class="flex items-center gap-2 py-[.45rem] px-3 rounded-[var(--radius-sm)] no-underline text-[.9rem] [color:var(--color-accent)] font-medium transition-colors duration-100 hover:bg-[color:var(--color-bg)]"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>{d.addStore}</span>
                  </a>
                  )}
                </li>
              </ul>
            </div>
          {/* This used to carry a NAMED target so every click reused one preview tab instead of
              piling them up on mobile. REVERTED 2026-08-03, reported by a seller: a window name is
              browser-wide and it sticks to a tab after that tab has been navigated elsewhere, so
              the next click reached across and took over whatever they had open there. Saving a
              tab was never worth hijacking an unrelated one.
              NO rel="noopener" still, but for a different reason now: the opener link is what lets
              initStorePreviewLink's window.open hand back a handle it can close, which is how the
              store page's "back to dashboard" bar ([storeSlug]/index.astro) gets the seller back
              here. Safe because the destination is our own store page, never third-party. */}
          <a id="dash-view-store" href={storeHomeHref(store)} class="btn btn--sm" target="_blank">
            {d.viewLive}
          </a>
        </div>
        {/* The store's public address — the seller's own domain once verified, else the platform host.
            The WHOLE address, not the `/slug` path this used to show (owner, 2026-08-14): a path is
            not something anyone can be sent to, and this line is the one place in the dashboard a
            seller looks when someone asks him where his store is. It is also the copy source, so
            what he hands over is a working address rather than a fragment he has to complete.
            No scheme, deliberately — see the note on `cd-local-addr` further down. */}
        {/* `mt-3 sm:mt-1` — the address line needs air on a phone and does not on a desktop, and
            that is a difference in LAYOUT, not in taste (owner, סשן ד׳: *"הכתובת למעלה ליד 'החנות
            שלך' והכפתור העתק נדבק לכפתור של 'צפה חנות' — צפוף שם מדי"*). On a wide row the name
            and the "צפה בחנות" button sit side by side and this line runs clear underneath both;
            at 390px the button is alone on the inline-start edge and the copy button lands
            directly beneath it — measured 4px apart, two buttons of different kinds reading as one
            stack. 12px on the phone, the original 4px from `sm:` up where nothing was wrong.
            (Inline `style` converted to utilities on contact — Hard rules → Tailwind v4 only.) */}
        <p class="muted flex items-center gap-1.5 flex-wrap m-0 mt-3 sm:mt-1 text-[0.82rem]">
          <span>{d.storeSubtitle} ·</span>
          <code id="dash-store-address" dir="ltr" data-has-custom-domain={store.customDomain?.status === 'active' ? '1' : ''} style="font-size:0.78rem">{store.customDomain?.status === 'active' ? store.customDomain.hostname : `${platformHost}/${store.slug}`}</code>
          {/* No size override. It carried `!py-0 !px-1` to sit lightly on a 0.82rem line, and what
              that actually did was pull the ghost border in against the 13px icon — the button read
              as a box drawn around the glyph. `.btn--sm`'s own padding is what the three copy
              buttons in the settings panel use, and matching them is also the point. */}
          <CopyButton target="dash-store-address" label={d.cdCopy} copiedLabel={d.cdCopied} />
        </p>

        {settingsSuccess && <p class="dash-success bg-[#f0fdf4] text-[#166534] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#bbf7d0] text-sm" style="margin-top:1rem;margin-bottom:0">{d.settingsSaved}</p>}
        {productSuccess && <p class="dash-success bg-[#f0fdf4] text-[#166534] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#bbf7d0] text-sm" style="margin-top:1rem;margin-bottom:0">{d.productAdded}</p>}
        {error && <p class="dash-error bg-[#fef2f2] text-[color:var(--color-danger)] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#fecaca] text-sm" style="margin-top:1rem;margin-bottom:0">{error}</p>}
      </div>

      <!-- ── Section tabs ── -->
      <div class="dash-tabs" role="tablist">
        <button
          class={`dash-tab${initialPanel === 'overview' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-overview"
          data-panel="overview"
          aria-selected={initialPanel === 'overview'}
          tabindex={initialPanel === 'overview' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>{d.tabOverview}</button>
        <button
          class={`dash-tab${initialPanel === 'products' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-products"
          data-panel="products"
          aria-selected={initialPanel === 'products'}
          tabindex={initialPanel === 'products' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>{d.tabProducts}
          {/* The severity this marker declares to scripts/dashboard/tab-alert-edges.ts, so the tab
              strip's edge can flag it while this tab is scrolled off screen. "warning" — a wrong
              state that can wait; the red ones below are someone waiting on the seller. */}
          <span id="products-stock-badge" class="dash-tab-badge ![background:var(--color-warning)]" data-tab-alert="warning" data-tooltip={d.stockAlertBadge} aria-label={d.stockAlertBadge} hidden={stockAlertCount === 0}>{stockAlertCount}</span>
        </button>
        <button
          class={`dash-tab${initialPanel === 'promotions' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-promotions"
          data-panel="promotions"
          aria-selected={initialPanel === 'promotions'}
          tabindex={initialPanel === 'promotions' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>{d.tabPromotions}</button>
        <button
          class={`dash-tab${initialPanel === 'orders' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-orders"
          data-panel="orders"
          aria-selected={initialPanel === 'orders'}
          tabindex={initialPanel === 'orders' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>{d.tabOrders}
          {newOrdersCount > 0 && (
            <span class="dash-tab-badge" data-tab-alert="danger" aria-label={t.dashboard.orderNewCount.replace('{n}', String(newOrdersCount))}>{newOrdersCount}</span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'returns' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-returns"
          data-panel="returns"
          aria-selected={initialPanel === 'returns'}
          tabindex={initialPanel === 'returns' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>{d.tabReturns}
          {openReturnsCount > 0 && (
            <span class="dash-tab-badge" data-tab-alert="danger" aria-label={t.dashboard.returnsOpenCount.replace('{n}', String(openReturnsCount))}>{openReturnsCount}</span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'performance' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-performance"
          data-panel="performance"
          aria-selected={initialPanel === 'performance'}
          tabindex={initialPanel === 'performance' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>{d.tabPerformance}</button>
        {/* Next to Performance and not next to Orders, deliberately: the two answer the same
            question — "how did this period go" — and a seller who wants the rows behind a figure
            looks beside the figure. */}
        <button
          class={`dash-tab${initialPanel === 'reports' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-reports"
          data-panel="reports"
          aria-selected={initialPanel === 'reports'}
          tabindex={initialPanel === 'reports' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>{d.tabReports}</button>
        <button
          class={`dash-tab${initialPanel === 'advertising' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-advertising"
          data-panel="advertising"
          aria-selected={initialPanel === 'advertising'}
          tabindex={initialPanel === 'advertising' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>{d.tabAdvertising}
          {/* "warning", like the stock badge: the campaign has already STOPPED, so nothing is
              being spent while it waits — but it stays stopped until the seller puts the products
              back or uploads a photo, which is why it is a dot at all. The self-healing pause
              (sold out) is excluded at the source, `ad-campaigns.ts#getStoreIdsWithStalledCampaigns`. */}
          {adNeedsAttention && (
            <span data-tab-alert="warning" style="position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:var(--color-warning);border-radius:50%" aria-label={d.adTabAttention}></span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'messages' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-messages"
          data-panel="messages"
          aria-selected={initialPanel === 'messages'}
          tabindex={initialPanel === 'messages' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>{t.dashboard.tabMessages}
          {unreadMsgRows > 0 && (
            <span data-tab-alert="danger" style="position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:var(--color-danger);border-radius:50%" aria-label={t.dashboard.msgUnreadCount.replace('{n}', String(unreadMsgRows))}></span>
          )}
        </button>
        {/* Between Messages and Settings, and the position is the argument: this is the seller's
            own money rather than the store's operation, so it sits at the end of the working tabs
            and beside the other account-shaped one. */}
        <button
          class={`dash-tab${initialPanel === 'payouts' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-payouts"
          data-panel="payouts"
          aria-selected={initialPanel === 'payouts'}
          tabindex={initialPanel === 'payouts' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>{d.tabPayouts}
          {/* "danger", like the orders badge and unlike the stock one: this is not a wrong state
              that can wait, it is the seller's own money sitting still because of a form nobody
              has asked them to fill in. `data-tab-alert` is what lets the strip's edge flag it
              while this tab is scrolled off screen (scripts/dashboard/tab-alert-edges.ts). */}
          {payoutNeedsBank && (
            <span data-tab-alert="danger" style="position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:var(--color-danger);border-radius:50%" aria-label={d.payNoBankTitle}></span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'settings' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-settings"
          data-panel="settings"
          aria-selected={initialPanel === 'settings'}
          tabindex={initialPanel === 'settings' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>{d.tabSettings}</button>
      </div>
      <DashTabsBoot />

      {/* Hydration bar. Server-rendered VISIBLE and removed by the panel loader
          once the open panel's JS is in place — the only direction that works,
          since a bar shown by JS could never report that JS hasn't arrived.
          Until then the panel's dropdowns and buttons genuinely cannot answer a
          click (owner, 2026-07-31: "אי אפשר לפתוח דרופדאונים"), so this says so
          instead of leaving the seller tapping a dead control.
          The 0.25s delayed fade-in is what keeps it off a normal load: hydration
          usually finishes first and the bar is removed before it was ever
          painted — the same "don't flash a loader" rule performance.ts applies
          to its own fetch. */}
      {/* Two elements, not one: the sweep spends the `animation` shorthand, so
          the delayed fade has to sit on a wrapper or it would replace it.
          Deliberately NOT `.skel-bar` — that gradient is tuned to sit under a
          photo and read as barely-there, and here it was invisible (owner,
          2026-07-31: "הלואדר קצת בלתי נראה"). A primary-coloured sweep on the
          site's own `skeleton-shimmer` keyframe is the same language, at the
          contrast a progress signal needs. */}
      {/* Flush under the tab strip, never on it: `.dash-tabs` owns a 1px
          bottom border and the active `.dash-tab` overlaps it upward with its
          own 2.5px indicator (margin-bottom:-1px), so anything taller here
          reads as swallowing both. 2px, directly below, no margins.
          The track stays in the DOM after loading and only the sweep is
          removed — taking the whole element out would shift every panel up by
          its height the instant hydration finished. */}
      {/* `.progress-sweep` (utilities/utils.css) owns the loop — it is built so
          its last frame equals its first, which a background-position shimmer
          could not be. The delayed fade sits on a wrapper because the sweep has
          already spent its `animation` on the loop. */}
      <div id="dash-hydrating-bar" class="progress-track" role="status" aria-label={d.dashHydrating}>
        <span class="block h-full opacity-0 [animation:fade-in_0.2s_ease_0.25s_forwards]">
          <span class="progress-sweep block h-full"></span>
        </span>
      </div>

      {/* Raised by tab-sync.ts when another tab of this same store saves something —
          advisory only, the seller chooses when to take the fresh data. */}
      <StaleDataBar message={d.staleDataMsg} refreshLabel={d.staleDataRefresh} dismissLabel={d.staleDataDismiss} />

      {/* Raised by unsaved-guard.ts while any dashboard form holds work that has not been saved.
          Each bar owns its own fixed position; they are offset so they cannot overlap. */}
      <UnsavedChangesBar />

      <!-- ── Panel: Overview ── -->
      <SellerPanelShell panel="overview" active={shows('overview')} hydrating={false}>
        <OnboardingChecklist steps={onboardingSteps} />
        {showTabHints && <TabHint text={d.tabHintOverview} />}
        {false && (<div class="mb-4 pb-[0.6rem] border-b [border-color:var(--color-border)]">
          <h2 class="m-0 text-base font-semibold">{d.storeOverview}</h2>
        </div>)}
        {/* Each card jumps to its tab (data-goto-panel, initGotoPanelLinks() in ui.ts) — same pattern as AdminOverviewPanel.astro. favoritedBy has no dedicated tab of its own, so it stays a plain (non-button) stat. Box style matches the performance tab's KPI cards (perf-kpis below) for visual consistency between the two stat grids. */}
        <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {/* Orders group first (total → new → not-yet-shipped): the total, then its
              two attention breakdowns. The attention cards jump to their tab AND apply
              the matching filter (wired in the inline script below), so a click lands on
              exactly the counted rows; their number turns coloured only when there's
              something to act on, muted "all clear" otherwise. */}
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="orders">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.tabOrders}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{storeOrdersTotal}</dd>
          </button>
          <button type="button" id="ov-new-orders" data-goto-panel="orders" data-goto-intent="status:pending" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.ovNewOrders}</dt>
            <dd class={`m-0 text-[1.15rem] font-bold ${newOrdersCount > 0 ? '[color:var(--color-accent)]' : '[color:var(--color-muted)]'}`}>{newOrdersCount}</dd>
          </button>
          <button type="button" id="ov-unshipped" data-goto-panel="orders" data-goto-intent="status:processing" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.ovUnshipped}</dt>
            <dd class={`m-0 text-[1.15rem] font-bold ${unshippedOrdersCount > 0 ? '[color:var(--color-warning)]' : '[color:var(--color-muted)]'}`}>{unshippedOrdersCount}</dd>
          </button>
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="products">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.products}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{productCount}</dd>
          </button>
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="products">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.inStock}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{inStockCount}</dd>
          </button>
          <button type="button" id="ov-stock-attention" data-goto-panel="products" data-goto-intent="stockAttention" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.ovStockAttention}</dt>
            <dd class={`m-0 text-[1.15rem] font-bold ${stockAlertCount > 0 ? '[color:var(--color-danger)]' : '[color:var(--color-muted)]'}`}>{stockAlertCount}</dd>
          </button>
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="products">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.stockValue}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{formatPrice(totalStockValue)}</dd>
          </button>
          <div class="bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.favoritedBy}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{storeFavoriteCount}</dd>
          </div>
        </dl>

        {/* ── The money row (owner, סשן א׳ §4) ────────────────────────────────────────────────
            Its own `<dl>` under the counts rather than three more cells in that grid: these are
            shekels and the ones above are quantities, and a row of five numbers where two are money
            reads as one list of comparable things. A rule and a heading are cheaper than teaching
            the seller to re-read the labels.

            Both tiles jump to the Payments tab, where the same figures are broken down — the
            overview's job is to say "there is something here", not to answer it.

            **Neither label carries a scope, and that is the point** (owner, 2026-08-11: *"כמה שפחות
            לערבב בין חנויות יחד… הוא נמצא על חנות א׳ אז הוא צריך לקבל מידע על חנות א׳"*). Both are
            the store in the switcher, like every other number on this panel, so a suffix would be
            answering a question the seller has not been given a reason to ask. The account-wide
            held tile that stood here first is gone for the same reason. */}
        {payoutAccount && (
          <>
            <h3 class="text-[0.95rem] font-semibold m-0 mt-6 mb-2">{d.tabPayouts}</h3>
            <dl class="grid grid-cols-2 gap-3">
              <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="payouts">
                <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.payPayableNow}</dt>
                <dd class={`m-0 text-[1.15rem] font-bold ${ovPayableNow > 0 ? '[color:var(--color-accent)]' : '[color:var(--color-muted)]'}`}>{formatAgorot(ovPayableNow)}</dd>
              </button>
              <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="payouts">
                <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.payHeld}</dt>
                <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{formatAgorot(ovHeldThisStore)}</dd>
              </button>
            </dl>
          </>
        )}
      </SellerPanelShell>

      <!-- ── Panel: Products ── -->
      <SellerPanelShell panel="products" active={shows('products')}>
        {showTabHints && <TabHint text={d.tabHintProducts} />}

        {/* The unattended pull has stopped working. A bell notification is read once and dismissed
            while the sync stays broken for days, so the state is also stated here, on the tab whose
            numbers are the ones going stale — and it says the SAME sentence the notification did
            (feed-sync-alert.ts#feedSyncProblemCopy), because two wordings for one situation is how
            a seller ends up believing the milder of them. Only rendered while it is true; a card
            that is always there is furniture. */}
        {syncFailure && (
          <div class="card card--flat p-4 mb-3 [border-color:var(--color-warning)] flex items-start gap-[0.6rem]" role="status">
            <svg class="shrink-0 max-w-none mt-[0.15rem] [color:var(--color-warning)]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <div class="text-[0.85rem] leading-[1.6]">
              <strong>{syncFailure.title}.</strong>{' '}
              <span>{syncFailure.body}</span>{' '}
              <span class="[color:var(--color-muted)]">{d.feedFailureSince.replace('{date}', syncFailure.since)}</span>
              <button type="button" data-open-feed-panel class="btn btn--ghost btn--sm mt-[0.55rem] block">{d.feedFailureOpen}</button>
            </div>
          </div>
        )}

        <div>
          <div class="products-header">
            <div class="products-header__title">
              <input type="checkbox" id="bulk-select-all-mobile" class="bulk-select-all bulk-select-all--mobile cursor-pointer disabled:cursor-not-allowed disabled:opacity-40" aria-label={d.bulkSelectAll} style="width:15px;height:15px;flex-shrink:0">
              <span class="bulk-count-paren" id="bulk-count-paren" aria-hidden="true"></span>
              <h2>{d.productsTitle}</h2>
              <span class="bulk-count-badge" id="bulk-count-badge" hidden>
                <strong id="bulk-count">0</strong> {d.bulkSelected}
              </span>
            </div>
            <div class="products-header__actions">
              <button id="bulk-edit-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkEdit}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span id="bulk-edit-label" class="bulk-btn__label" aria-hidden="true">{d.bulkEdit}</span>
              </button>
              <button id="bulk-upload-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkUploadImages}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span id="bulk-upload-label" class="bulk-btn__label" aria-hidden="true">{d.bulkUploadImages}</span>
              </button>
              <button id="bulk-discount-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkDiscountTitle}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.bulkDiscount}</span>
              </button>
              <button id="bulk-delete-btn" type="button" class="btn btn--sm btn--danger bulk-btn !bg-[color:var(--color-danger)] hover:opacity-90" hidden aria-label={d.bulkDelete}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.bulkDelete}</span>
              </button>
              <span class="products-header__sep" id="bulk-sep" aria-hidden="true" hidden></span>
              {/* Primary action first; the two panel-toggles follow it and go icon-only on mobile
                  (see dashboard.css mobile block) so the strip stays compact when nothing's selected. */}
              <button class="btn btn--sm add-product-btn" id="toggle-add-form" aria-label={d.addProduct}>
                <svg class="add-product-btn__icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span class="add-product-btn__label" aria-hidden="true">{d.addProduct}</span>
              </button>
              <button class="btn btn--sm bulk-btn" id="toggle-csv-panel" aria-label={d.csvImportExport}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9.5 14.5 12 17 14.5 14.5"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.csvImportExport}</span>
              </button>
              <button class="btn btn--sm bulk-btn" id="toggle-feed-panel" aria-label={d.feedSyncTitle}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.feedSyncTitle}</span>
              </button>
            </div>
          </div>

          <div id="add-product-form" class="bg-[color:var(--color-surface)] border border-[color:var(--color-border)] rounded-[var(--radius)] p-5 mb-6" hidden>
            <h3 class="m-0 mb-1 text-base">{d.newProduct}</h3>
            {/* Only `name` carries `required`, and the server agrees (api/product.ts rejects a
                blank name and nothing else) — but a form of eleven fields reads as eleven
                obligations. Stating the real rule is what lets a first product take a minute. */}
            <p class="m-0 text-[0.82rem] leading-[1.5] [color:var(--color-muted)]">{d.addFormRequiredNote}</p>
            <form method="POST" class="mt-4" data-unsaved-guard>
              <input type="hidden" name="_action" value="add-product" />
              <input type="hidden" name="storeId" value={store.id} />

              <div class="grid grid-cols-[2fr_1fr_1fr] gap-4">
                <label class="field">
                  <span>{d.nameReq}</span>
                  <input class="input" name="name" required placeholder={d.namePlaceholder} />
                </label>
                <label class="field">
                  <span>{d.priceLabel}</span>
                  <input
                    class="input"
                    name="price"
                    type="number"
                    min="0"
                    step="0.01"
                    placeholder="0.00"
                  />
                </label>
                <label class="field">
                  <span>{d.colStock}</span>
                  <input class="input" name="stock" type="number" min="0" step="1" placeholder="0" />
                  {/* Revealed by initLockedStockHint() only when the seller tries to type into a
                      field that has locked itself — which happens only once EVERY combo carries
                      its own number, the point at which this field really is just their sum.
                      While any combo is still pooled the field stays editable, because it is that
                      pool. Server-rendered text, JS only flips `hidden`, so one line needs no
                      dashboard-i18n plumbing. */}
                  <p data-stock-from-variants class="m-0 mt-1 text-[0.76rem] [color:var(--color-muted)]" hidden>{d.stockFromVariants}</p>
                </label>
              </div>

              <Fragment set:html={discountFieldHtml(undefined, discountLabels)} />

              <label class="field">
                <span>{d.descLabel}</span>
                <textarea
                  class="input"
                  name="description"
                  rows="2"
                  placeholder={d.descPlaceholderProduct}></textarea>
              </label>

              <div class="grid grid-cols-[2fr_1fr_1fr] gap-4">
                <div class="field max-w-[280px]">
                  <span>{d.categoryLabel}</span>
                  <div class="category-picker relative" data-category-picker>
                    <input type="hidden" name="categoryId" value="" />
                    <button type="button" class="category-picker__trigger input group flex items-center justify-between gap-2 cursor-pointer text-[color:var(--color-text)] text-start transition-colors duration-[120ms]" aria-haspopup="true" aria-expanded="false">
                      <span class="category-picker__label overflow-hidden text-ellipsis whitespace-nowrap">{d.categoryNone}</span>
                      <svg class="category-picker__chevron shrink-0 text-[color:var(--color-muted)] transition-transform duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="category-picker__menu absolute start-0 top-[calc(100%+5px)] w-max min-w-full max-w-[20rem] max-h-[18rem] overflow-y-auto bg-[color:var(--color-surface)] border border-[color:var(--color-border)] rounded-[var(--radius)] p-[0.3rem] shadow-[0_4px_20px_rgba(0,0,0,0.12)] z-[60] animate-status-pop" hidden></div>
                  </div>
                  <p class="muted" style="margin:0.3rem 0 0;font-size:0.76rem">{d.categoryEditHint}</p>
                </div>
              </div>

              {/* Everything past this point is optional, and a first-time seller does not know
                  what a SKU or a variant is — eleven fields at once is what made adding one
                  product feel like filling in a form for the tax authority. `<details>` and not a
                  JS toggle: the fields stay in the DOM either way (tags/variants/specs all
                  initialise by querySelector at boot, and the browser reveals a collapsed field
                  that fails validation), so this needs no script and cannot desync. */}
              <details class="mt-4 border-t [border-color:var(--color-border)] pt-3">
                {/* The native disclosure triangle is kept deliberately — it is the affordance, and
                    the browser already flips it for RTL. A custom chevron here would be a second
                    mechanism for something the element does correctly on its own. */}
                <summary class="cursor-pointer text-[0.87rem] font-medium [color:var(--color-text)]">
                  {d.addFormMore}
                </summary>

              {/* A <div> with an explicit `for`, not a wrapping <label>: an InfoTip inside a label
                  is unreachable on touch — the tap is forwarded to the input, so the field takes
                  focus and the tooltip (hover/focus on the button) never fires. The other three
                  tips below already sit in plain <div class="field"> blocks, which is why only
                  this one needed unwrapping. */}
              <div class="field max-w-[280px] mt-3">
                <label class="inline-flex items-center gap-[0.35rem]" for="add-product-sku">
                  {d.skuLabel}
                </label>
                <InfoTip text={d.skuHint} class="ms-[0.35rem]" />
                <input class="input" id="add-product-sku" name="sku" placeholder={d.skuPlaceholder} />
              </div>

              {/* The placeholder IS the explanation: an empty field showing the store's own name
                  greyed out says "this is what will be published" without the seller reading the
                  tip. Only a reseller needs to type anything here. */}
              <div class="field max-w-[280px] mt-3">
                <label class="inline-flex items-center gap-[0.35rem]" for="add-product-brand">
                  {d.brandLabel}
                </label>
                <InfoTip text={d.brandHint} class="ms-[0.35rem]" />
                <input class="input" id="add-product-brand" name="brand" maxlength="70" placeholder={store.name} />
                <p class="muted" style="margin:0.3rem 0 0;font-size:0.76rem">{d.brandFallbackNote}</p>
              </div>

              {/* Optional on purpose, and it stays optional: the carrier integration that will
                  price on it does not exist yet (GO_LIVE §5), so gating a product on a weight
                  today would block a sale for a number nothing reads. The field is here now so a
                  catalogue fills in as it is edited rather than all at once on connection day. */}
              <div class="field max-w-[280px] mt-3">
                <label class="inline-flex items-center gap-[0.35rem]" for="add-product-weight">
                  {d.weightLabel}
                </label>
                <InfoTip text={d.weightHint} class="ms-[0.35rem]" />
                <input class="input" id="add-product-weight" name="weightGrams" type="number" min="1" max={MAX_WEIGHT_GRAMS} step="1" inputmode="numeric" placeholder={d.weightPlaceholder} />
              </div>

              <div class="field max-w-none" data-tags-field>
                <span class="inline-flex items-center gap-[0.35rem]">
                  {d.tagsLabel}
                  <InfoTip text={d.tagsHint} />
                </span>
                <div class="variant-chips" data-tag-chips style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
                  <span data-tag-adder>
                    <button type="button" class="variant-chip-add-trigger btn btn--ghost btn--sm" data-tag-add-trigger style="border-radius:999px">{d.variantValueAddBtn}</button>
                  </span>
                </div>
                <div data-tag-suggestions style="display:none;flex-wrap:wrap;gap:0.4rem;align-items:center;margin-top:0.45rem"></div>
                <input type="hidden" name="tags" value="" />
              </div>

              <div class="field variants-editor" data-variants-editor>
                <span class="field-label inline-flex items-center gap-[0.35rem]">
                  {d.variantsLabel}
                  <InfoTip text={d.variantsHint} />
                </span>
                <div class="variant-dims" data-variant-dims></div>
                <button type="button" class="variants-add-btn btn btn--ghost btn--sm" style="margin-top:0.25rem">{d.variantAddBtn}</button>
                <!-- Filled by products.ts#updateVariantLimitNote only while a limit actually applies. -->
                <p data-variant-limit-note aria-live="polite" style="font-size:0.78rem;margin:0.4rem 0 0" hidden></p>
                <div class="variant-combos" data-variant-combos style="margin-top:0.75rem" hidden>
                  <p class="field-label" style="margin:0 0 0.3rem">{d.variantComboLabel}</p>
                  <p class="muted" data-variant-combo-hint style="font-size:0.78rem;margin:0 0 0.5rem" hidden>{d.variantComboHint}</p>
                  <div style="max-height:260px;overflow:auto;border:1px solid var(--color-border);border-radius:var(--radius)">
                    <table style="width:100%;border-collapse:separate;border-spacing:0">
                      <thead data-variant-combo-thead></thead>
                      <tbody data-variant-combo-rows></tbody>
                      <tfoot data-variant-combo-tfoot></tfoot>
                    </table>
                  </div>
                </div>
              </div>

              <div class="field">
                <span class="field-label inline-flex items-center gap-[0.35rem]">
                  {d.specsLabel}
                  <InfoTip text={d.specsHint} />
                </span>
                <div class="specs-rows"
                     data-label-placeholder={d.specsLabelPlaceholder}
                     data-value-placeholder={d.specsValuePlaceholder}></div>
                <button type="button" class="btn btn--ghost btn--sm specs-add-row" style="margin-top:0.5rem">{d.specsAddRow}</button>
              </div>

              <label class="field max-w-none">
                <span class="inline-flex items-center gap-[0.35rem]">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;color:var(--color-muted)"><path d="M4.5 3.5h15v10.5l-5.5 5.5h-9.5z"/><path d="M19.5 14h-5.5v5.5"/><line x1="8" y1="8.5" x2="16" y2="8.5"/><line x1="8" y1="12" x2="13" y2="12"/></svg>
                  {d.sellerNoteLabel}
                </span>
                <textarea class="input resize-none" name="sellerNote" rows="2" maxlength="2000" placeholder={d.sellerNotePlaceholder}></textarea>
              </label>
              </details>

              {/* Photos stay OUT of the collapsed block: they are optional to the form and decisive
                  to the listing, and a product added without one is the thing the checklist's
                  "upload a store image" step cannot fix later. */}
              <div class="field">
                <span class="field-label">{d.productImages}</span>
                <div set:html={galleryWidgetHtml([], g)}></div>
              </div>

              {/* Advice, never a gate — it sits ABOVE the submit row on purpose (a seller reads it
                  on the way to saving) and disables nothing. See lib/product-seo-field.ts. */}
              <div set:html={productSeoPanelHtml(EMPTY_PRODUCT_SEO, seoPreviewCtx, seoLabels)}></div>

              <div class="flex gap-2 mt-2">
                <button class="btn" type="submit">{d.addProductBtn}</button>
                <button class="btn btn--ghost" type="button" id="cancel-add">{d.cancel}</button>
              </div>
            </form>
          </div>

          {/* "Nothing matches" is a row inside the table (see #products-empty-row below), not a
              paragraph under a hidden table — the header's filter funnels have to stay reachable. */}
          {/* The CTA repeats #toggle-add-form rather than replacing it: this block is hidden the
              moment the catalog is non-empty OR a filter is active (products.ts#applyPagination),
              so it cannot be the only way in. It exists because "add the first one above" pointed
              at a toolbar of six buttons — a direction, where the seller needed a target. */}
          <div id="empty-products" class="py-6" hidden={products.length > 0}>
            <p class="m-0 text-[0.95rem] [color:var(--color-muted)]">{d.noProducts}</p>
            <button type="button" class="btn btn--accent mt-3" data-goto-open="toggle-add-form" data-goto-panel="products">
              {d.noProductsCta}
            </button>
          </div>

          {/* CSV bulk import/export panel */}
          <div id="csv-panel" class="csv-panel border [border-color:var(--color-border)] rounded-[var(--radius)] p-[0.8rem] mb-3 bg-[color:var(--color-bg)] animate-bulk-bar-in" hidden data-store-id={store.id}>
            <div class="csv-panel__header flex items-center justify-between text-[0.85rem] font-semibold [color:var(--color-muted)] uppercase tracking-[0.04em] mb-2">
              <span>{d.csvImportExport}</span>
              <button type="button" class="btn btn--ghost btn--sm" id="csv-panel-close" aria-label={d.csvClose}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <p class="csv-panel__hint muted text-[0.82rem] leading-[1.5] mb-1">{d.csvImportLead}</p>
            <ul class="muted text-[0.82rem] leading-[1.5] m-0 mb-3 ps-[1.1rem] space-y-1 list-disc marker:[color:var(--color-primary)]">
              {d.csvImportPoints.map((p) => (typeof p === 'string' ? <li>{p}</li> : (
                <li>{p.text}
                  <ul class="mt-1 ps-[1.1rem] space-y-1 list-[circle] marker:[color:var(--color-primary)]">
                    {p.sub.map((s) => <li>{s}</li>)}
                  </ul>
                </li>
              )))}
            </ul>
            <div class="csv-panel__actions flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:flex-wrap">
              <a class="btn btn--ghost btn--sm sm:!justify-start" id="csv-export-link" href={`/api/store-product/bulk?storeId=${store.id}`} download="products.csv">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                {d.csvExport}
              </a>
              <button type="button" class="btn btn--ghost btn--sm sm:!justify-start" id="csv-template-btn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
                {d.csvTemplate}
              </button>
              <label class="btn btn--ghost btn--sm sm:!justify-start" for="csv-file-input">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                {d.csvChooseFile}
              </label>
              <input type="file" id="csv-file-input" accept=".csv,text/csv" hidden />
              <span id="csv-file-name" class="muted text-[0.8rem] overflow-hidden text-ellipsis whitespace-nowrap" aria-live="polite"></span>
            </div>
            <div id="csv-preview" class="csv-preview mt-[0.9rem]" hidden></div>
          </div>

          {/* External-inventory sync panel — for a store that manages its stock in another system
              (POS/ERP/Shopify/Woo/spreadsheet). Deliberately separate from the CSV panel above: that
              one is our own catalog round-trip; this one translates a FOREIGN feed (any column names)
              and matches by SKU. See feed-mapping.ts / feed-sync.ts. */}
          <div id="feed-panel" class="feed-panel border [border-color:var(--color-border)] rounded-[var(--radius)] p-[0.8rem] mb-3 bg-[color:var(--color-bg)] animate-bulk-bar-in" hidden
               data-store-id={store.id}
               data-feed-url={store.feedSync?.url ?? ''}
               data-feed-mapping={JSON.stringify(store.feedSync?.mapping ?? {})}
               data-last-sync={store.feedSync?.lastSyncAt ?? ''}>
            <div class="flex items-center justify-between text-[0.85rem] font-semibold [color:var(--color-muted)] uppercase tracking-[0.04em] mb-2">
              <span>{d.feedSyncTitle}</span>
              <button type="button" class="btn btn--ghost btn--sm" id="feed-panel-close" aria-label={d.csvClose}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <p class="muted text-[0.82rem] leading-[1.5] mb-3">{d.feedSyncLead}</p>

            {/* Live feed URL — the near-live path (a saved URL we pull on demand / on a future timer) */}
            <div class="flex flex-col gap-2 pb-3 mb-3 border-b [border-color:var(--color-border)]">
              <label for="feed-url-input" class="text-[0.82rem] font-semibold [color:var(--color-text)]">{d.feedUrlLabel}</label>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <input type="url" id="feed-url-input" inputmode="url" placeholder="https://…/inventory.csv" value={store.feedSync?.url ?? ''}
                  class="flex-1 min-w-0 font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] py-[.4rem] px-[.7rem] outline-none transition-colors duration-[120ms] focus:border-[color:var(--color-primary)]" />
                <button type="button" class="btn btn--ghost btn--sm shrink-0" id="feed-save-btn">{d.feedSaveUrl}</button>
                <button type="button" class="btn btn--sm shrink-0" id="feed-sync-now-btn">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                  {d.feedSyncNow}
                </button>
              </div>
              <span id="feed-last-sync" class="muted text-[0.78rem]" aria-live="polite"></span>
              {syncUnreachable.length > 0 && (
                <p class="text-[0.78rem] leading-[1.5] [color:var(--color-danger)] flex items-start gap-[0.3rem]">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[0.15rem]" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  <span>
                    {d.feedUnreachableNote.replace('{max}', String(CSV_MAX_DIMENSIONS))}
                    {' '}
                    {syncUnreachable.slice(0, 3).map((p) => p.name).join(', ')}
                    {syncUnreachable.length > 3 ? d.feedUnreachableMore.replace('{n}', String(syncUnreachable.length - 3)) : ''}
                  </span>
                </p>
              )}
              <p class="muted text-[0.75rem] leading-[1.5] flex items-start gap-[0.3rem]">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[0.15rem]" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                <span>{d.feedManualNote}</span>
              </p>
            </div>

            {/* One-off upload — also how a seller sets/corrects the column mapping from a sample export */}
            <p class="muted text-[0.82rem] leading-[1.5] mb-2">{d.feedUploadHint}</p>
            <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:flex-wrap">
              <label class="btn btn--ghost btn--sm sm:!justify-start" for="feed-file-input">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                {d.csvChooseFile}
              </label>
              <input type="file" id="feed-file-input" accept=".csv,text/csv" hidden />
              <span id="feed-file-name" class="muted text-[0.8rem] overflow-hidden text-ellipsis whitespace-nowrap" aria-live="polite"></span>
            </div>

            {/* Outbound: share THIS store's live inventory OUT to another system via a tokenized,
                login-free URL (mirror of the inbound sync above). See /api/store-feed/[token].ts. */}
            <div id="feed-export" class="border-t [border-color:var(--color-border)] pt-[0.8rem] mt-[0.9rem]" data-store-id={store.id} data-feed-base={`${platformConfig.url}/api/store-feed/`}>
              <p class="text-[0.85rem] font-semibold [color:var(--color-muted)] uppercase tracking-[0.04em] mb-1">{d.feedExportTitle}</p>
              <p class="muted text-[0.82rem] leading-[1.5] mb-2">{d.feedExportLead}</p>
              <button type="button" class="btn btn--ghost btn--sm" id="feed-export-gen" hidden={!!store.feedExportToken}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                {d.feedExportCreate}
              </button>
              <div id="feed-export-active" hidden={!store.feedExportToken} class="flex flex-col gap-2">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                  <input type="text" id="feed-export-url" readonly value={store.feedExportToken ? `${platformConfig.url}/api/store-feed/${store.feedExportToken}` : ''}
                    class="flex-1 min-w-0 font-mono text-[.76rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] py-[.4rem] px-[.6rem] outline-none" />
                  <button type="button" class="btn btn--ghost btn--sm shrink-0" id="feed-export-copy">
