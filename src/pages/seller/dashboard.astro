                  <button type="button" class="sort-btn seo-col__filter" data-filter-funnel-col="seo" dir="ltr" aria-expanded="false" aria-haspopup="true" data-tooltip={d.filterColSeo ?? 'נראות בחיפוש'} aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.filterColSeo ?? 'נראות בחיפוש'}`}>{d.colSeo ?? 'SEO'}</button>
                </th>
                <th class="actions-col" />
              </tr>
            </thead>
            <tbody id="products-tbody">
              {productsPage.items.map((p, idx) => {
                const fmtDateAdded = (iso: string) => new Date(iso).toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit' });
                // The per-combo rows behind the stock cell's breakdown dropdown — the ONE thing the
                // display row still needs from the variant machinery. Everything else this block
                // used to derive (the locked total, the column list, the combo sum) belonged to the
                // edit form, which products.ts#buildEditRow now owns end to end.
                const { combos: pVariantCombos } = variantCombosData(p.variants ?? [], p.variantStock, p.stock);
                return (
                <>
                  <tr data-product-display={p.id} data-store-id={store.id} data-discount={p.discount ? JSON.stringify(p.discount) : ''} data-hidden={p.hidden ? '1' : ''} data-featured={p.featured ? '1' : ''} class={p.hidden ? 'is-product-hidden' : undefined} data-images={JSON.stringify(p.images ?? [])} data-sort-name={p.name.toLowerCase()} data-sort-price={String(p.price)} data-sort-stock={String(p.stock)} data-sort-wishlist={String(wishlistCounts[p.slug] ?? 0)} data-sort-created-at={p.createdAt} data-category={productCategoryPaths.get(p.id) ?? ''} data-category-id={p.categoryId ?? ''} data-product-slug={p.slug} data-store-slug={store.slug} data-store-name={store.name} data-has-variants={(p.variants ?? []).length ? '1' : ''}>
                    <td class="check-col w-8 text-center align-middle px-[0.15rem]"><input type="checkbox" class="bulk-check cursor-pointer disabled:cursor-not-allowed disabled:opacity-40" data-bulk-check={p.id} aria-label={p.name} style="width:15px;height:15px"></td>
                    <td class="num row-num pe-[0.2rem]">{(productsPage.page - 1) * productsPageSize + idx + 1}</td>
                    <td class="thumb-col">
                      {p.images?.[0] && <span class="thumb-wrap" data-skeleton><img src={thumbUrl(p.images[0])} alt="" class="product-thumb" width="42" height="42" loading="lazy" decoding="async" /></span>}
                    </td>
                    <td class="name-col">
                      <span class="product-name cursor-text">{p.name}</span>
                      {/* Sits beside the name, never inside the price cell: that cell is
                          click-to-edit and parses its own textContent as the price. */}
                      <span class="sale-chip ms-1.5 align-middle" data-row-sale={p.id} dir="ltr" hidden={!rowSaleLabel(p)}>{rowSaleLabel(p)}</span>
                      <span class="product-note-chip inline-flex items-center align-middle ms-1 [color:var(--color-muted)]" title={p.sellerNote || undefined} aria-label={d.sellerNoteLabel} hidden={!p.sellerNote}>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 3.5h15v10.5l-5.5 5.5h-9.5z"/><path d="M19.5 14h-5.5v5.5"/><line x1="8" y1="8.5" x2="16" y2="8.5"/><line x1="8" y1="12" x2="13" y2="12"/></svg>
                      </span>
                      <span class="product-hidden-chip inline-flex items-center gap-1 text-[.66rem] font-semibold [color:var(--color-muted)] [background:color-mix(in_srgb,var(--color-muted)_14%,transparent)] py-[.08rem] px-[.4rem] rounded-full align-middle ms-1" hidden={!p.hidden}>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        {d.productHiddenChip}
                      </span>
                      {/* Shown when this product is one of the store card's picks. A CHIP and not
                          only a menu state, because the menu is a per-row popup: without a mark on
                          the row itself the only way to answer "which four did I choose?" is to
                          open every kebab in the table. Same geometry as the hidden chip beside it,
                          in the accent rather than the muted tone — this one is a good thing. */}
                      <span class="product-featured-chip inline-flex items-center gap-1 text-[.66rem] font-semibold [color:var(--color-accent)] [background:color-mix(in_srgb,var(--color-accent)_14%,transparent)] py-[.08rem] px-[.4rem] rounded-full align-middle ms-1" hidden={!p.featured}>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                        {d.productFeaturedChip}
                      </span>
                      {/* NO "this listing is thin" marker here — tried and removed 2026-08-04, do not
                          re-add without solving the column first. `.name-col` is 13% under
                          `table-layout: fixed`: a text pill wraps to two lines and reads as a fault, an
                          icon-only version (a magnifying glass) could not be decoded even by the person
                          who commissioned it, and giving it its own line adds height to exactly the rows
