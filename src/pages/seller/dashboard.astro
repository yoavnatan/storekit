  }
  .store-switcher__alert-dot {
    margin-inline-start: 0.15rem;
    align-self: center;
  }
  .store-switcher__alert-dot[data-level='warning'],
  .store-switcher__item-dot[data-level='warning'] {
    background: var(--color-warning);
  }

</style>

