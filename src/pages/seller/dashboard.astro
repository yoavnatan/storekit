import { businessTodayISO, businessMonthStartISO } from '../../lib/business-day.js';
import { storeBaselineStatus } from '../../lib/ad-baseline.js';
import { getCampaignsForStore } from '../../lib/ad-campaign-health.js';
import { getStoreIdsWithStalledCampaigns } from '../../lib/ad-campaigns.js';
import { boostFeePercent, commissionPercentForTier } from '../../lib/pricing.js';
import { campaignScopeName, campaignTargetingLabel, campaignHealthNote } from '../../lib/ad-scope-label.js';
import { campaignLifetimeStats, campaignRunPeriod } from '../../lib/ad-metrics.js';
import { shortDate } from '../../lib/date-range.js';
import { roasTierChipHtml, ctrTierChipHtml } from '../../lib/ad-tier.js';
import { orderAgeChipHtml } from '../../lib/order-age.js';
import { buildBarChartSvg, buildLineChartSvg, buildMultiLineChartSvg } from '../../lib/chart-svg.js';
import StoreCategoryPicker from '../../components/StoreCategoryPicker.astro';
import { buildVocabulary, sanitizeStoreCategories } from '../../lib/store-taxonomy.js';
// The no-JS fallbacks below write the same public store text `/api/store.ts` does, so they need the
// same two gates. They had NEITHER until 2026-08-12 — the exact shape of the authorization hole
// found in this same file on 2026-08-06 (review-diff → area audit row 4): the API twin checks, the
// fallback that writes the identical row does not, and no diff contains both.
import { storeTextOverLimit, fieldLimitRejectionMessage } from '../../lib/field-limits.js';
import { findSpamKeyword, spamRejectionMessage, findKeywordStuffing, stuffingRejectionMessage } from '../../lib/spam-filter.js';
import { storeSettingsRev } from '../../lib/record-rev.js';
import { toSellerProductRow } from '../../lib/seller-product-row.js';
import { MAX_WEIGHT_GRAMS } from '../../lib/product-weight.js';
import { getVisibleStores, isStoreDiscoverable } from '../../lib/stores.js';
import { getSellerAccountFor } from '../../lib/payouts.js';
import { needsBankDetails } from '../../lib/payout-details.js';


// Color dimensions must go through resolveVariantColor() before display — a
// custom color assigned via the picker is stored as "name #hex", and without
// stripping it the hex code leaks straight into the label. Each part also
// carries its resolved hex (color dimensions only) so the template can render
// a small swatch right next to the color name, easy to tell apart at a glance.
interface ComboLabelPart { text: string; hex: string | null }

function comboLabelParts(dims: VariantDimension[], combo: Record<string, string>): ComboLabelPart[] {
  return dims.map((d) => {
    const raw = combo[d.name] ?? '';
    if (!isColorVariant(d.name)) return { text: raw, hex: null };
    const { display, hex } = resolveVariantColor(raw);
    return { text: display, hex };
  });
}

/**
 * The per-combo rows the server-rendered edit form starts from.
 *
 * This used to hold a PRIVATE copy of the even-split rule — its own `evenSplit`, unreachable from
 * the library — which is why removing the split from lib/variant-combo.ts left this render still
 * inventing numbers and every test still green. It reads `comboStockRows` now, so the SSR pass,
 * the client editor (scripts/dashboard/products.ts) and the API all answer from one definition:
 * a combo with no bucket of its own sells from the shared pool and gets a BLANK field, never a
 * fabricated share of it.
 */
function variantCombosData(variants: VariantDimension[], variantStock: Record<string, number> | undefined, totalStock: number) {
  const combos = comboStockRows(variants, variantStock, totalStock).map((row) => ({
    key: row.key,
    parts: comboLabelParts(variants, row.selection),
    /** undefined = no bucket; the input renders empty with the pool as its placeholder. */
    value: row.override,
    /** What this combo can actually sell — its bucket, or the pool. For read-only displays. */
    effective: row.effective,
    shared: row.shared,
  }));
  return { hasAnyStock: combos.some((c) => !c.shared), combos };
}

const lang = getLang(Astro.cookies);
const t    = getT(lang);
const d    = t.dashboard;
// Built once — the discount block's labels are the same for every product row.
const discountLabels = discountFieldLabels(d);
/** The store-card pick's tooltip, interpolated once rather than per row. The count comes from
 *  `STORE_PREVIEW_SLOTS` and never from a literal: the cap, the card's slot count and this
 *  sentence are the same fact, and a hard-coded "4" here would be the copy that goes stale first. */
const featureHint = d.productFeatureHint.replace('{n}', String(STORE_PREVIEW_SLOTS));
// Same, for the "will this be found" panel. `seoPreviewCtx` is per-store, not per-product; the
// edit rows override `productSlug` from the product they render.
const seoLabels = productSeoLabels(d);
// Bare host for the preview's URL line — it is text a seller reads, never a link, so the origin
// is stripped rather than rendered. Derived from the config so the go-live domain switch carries.
const platformHost = new URL(platformConfig.url).host;
/** A product that does not exist yet — what the add form's panel starts from. */
const EMPTY_PRODUCT_SEO: ProductSeoInput = {
  name: '', description: '', imageCount: 0, hasCategory: false, specCount: 0,
};
// "-25%" for any product a shopper currently sees discounted — its own markdown OR the running
// store-wide sale. The seller asked "which of these is on sale", and the honest answer is the one
// the storefront gives, so this resolves through the same discounts.ts, sale included.
const rowSaleLabel = (p: StoreProduct): string => {
  const view = resolvePrice(p, store?.sale);
  return view.isDiscounted ? `-${view.percentOff}%` : '';
};
const g    = t.gallery;

const sellerId = getSellerSession(Astro.cookies);
if (!sellerId) return Astro.redirect('/seller/login');

const cloudinaryCloud = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? '';
const cloudinaryPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET ?? '';
// The invoice attachment goes through its OWN unsigned preset — the one above is image-only, and
// that is what keeps a product photo from ever being a PDF (.env.example carries the rest).
const cloudinaryInvoicePreset = import.meta.env.PUBLIC_CLOUDINARY_INVOICE_PRESET ?? '';

let error = '';

// Validated against the real panel list, never taken raw: `SellerPanelShell` renders
// `hidden={!active}` and `active` is "is this the panel asked for", so an unknown value (a typo, a
// stale bookmark, a link someone edited) hid ALL of them and served a dashboard with an empty body.
// Fall back to the landing tab instead.
const PANEL_NAMES = ['overview', 'products', 'orders', 'returns', 'performance', 'reports', 'advertising', 'messages', 'promotions', 'payouts', 'settings'] as const;
const requestedPanel = Astro.url.searchParams.get('panel') ?? '';
const initialPanel = (PANEL_NAMES as readonly string[]).includes(requestedPanel) ? requestedPanel : 'overview';

// ── ONE PANEL PER REQUEST (2026-08-11, SELLER_LAZY_PANELS_PLAN.md) ──
//
// This page used to build all ten panels on every request — ~865KB of HTML, of which about 73% was
// never seen, on the surface a seller opens on a phone and leaves open all day. `?panel=` chose
// which one was not `hidden`; every other one was still queried, still rendered, and still sent.
// It now chooses what the server BUILDS, exactly as `admin/index.astro` does, and a tab the seller
// actually opens is fetched on the click (the loader at the bottom of this file).
//
// What is deliberately NOT gated is the tab strip's own signals — the stock badge, the new-orders
// badge, the unread-mail dot and the payouts dot. A badge exists to report a tab you are NOT
// looking at, so it has to be computed whether or not you are looking at it; each is a count or a
// small indexed read, never the panel's full data (the same split `admin-tab-badges.ts` exists for).
//
// `only()` returns the fallback without touching the database when the panel is not the one asked
// for. The fallback is always the empty value the pure code below already handles — an empty list,
// an empty map — so nothing downstream needs to know a panel was skipped: it computes over nothing,
// and the panel is not rendered at all (see `SellerPanelShell`).
const only = <T,>(panels: readonly string[], load: () => Promise<T>, fallback: T): Promise<T> =>
  (panels.includes(initialPanel) ? load() : Promise.resolve(fallback));

/** Is this the panel being rendered? Gates the derivations whose inputs would be missing otherwise,
 *  and every panel shell in the template below. */
const shows = (panel: string): boolean => panel === initialPanel;

// ── Which panels need which read ──
// Named here rather than inline so the sharing is visible in one place: several panels want the
// same list, and a panel quietly missing from one of these renders empty rather than throwing,
// which is the failure mode this whole change has to be careful about.
/** The store's catalogue. The products table, the overview's three catalogue stats, the "top
 *  products" section under the charts, the boost picker's eligible list, and the sale scope picker. */
const CATALOG_PANELS = ['overview', 'products', 'performance', 'advertising', 'promotions'] as const;

/**
 * `&panel=<current>` for a POST redirect, or nothing.
 *
 * "מעבר בין חנויות צריך להשאיר את היוזר על הלשונית שהוא נמצא בה" (owner, סשן ב׳) is the same
 * complaint as this one, one step later: a native form POST lands back on the dashboard, and every
 * redirect below used to drop the panel — so adding a product from the מוצרים tab answered on
 * סקירה כללית. The tab strip keeps `?panel=` current (DashTabsBoot), these forms have no `action`
 * and therefore post to that same URL, so the value is here to be carried back.
 *
 * Whitelisted through `initialPanel` rather than interpolated raw: this string ends up in a
 * `Location` header, which is the one place a reflected query parameter must never be trusted.
 */
const panelParam = initialPanel === 'overview' ? '' : `&panel=${initialPanel}`;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'save-settings');

  if (action === 'save-settings') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    if (!name) {
      error = d.storeNameRequired;
    } else {
      // Resolved against the seller's OWN stores (lib/store-ownership.ts). The `?? stores[0]`
      // fallback this replaces meant an unrecognised id silently overwrote a different shop of
      // theirs instead of failing — a form that lost its storeId must say so, not guess.
      const target = await ownedStore(sellerId, storeId);
      const tooLong = storeTextOverLimit({ name, tagline, description });
      const spam = findSpamKeyword(name, tagline, description);
      const stuffing = findKeywordStuffing(name, tagline, description);
      if (!target) {
        error = d.notYours;
      } else if (tooLong) {
        error = fieldLimitRejectionMessage(tooLong);
      } else if (spam) {
        error = spamRejectionMessage(spam);
      } else if (stuffing) {
        error = stuffingRejectionMessage(stuffing);
      } else {
        await updateStore(target.id, { name, tagline, description, colors: target.colors });
        return Astro.redirect(machineUrl(`/seller/dashboard?store=${target.id}&saved=1${panelParam}`));
      }
    }
  } else if (action === 'create-store') {
    const name = String(form.get('name') || '').trim();
    const slug = normalizeSlug(String(form.get('slug') || ''));
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    const newTooLong = storeTextOverLimit({ name, tagline, description });
    const newSpam = findSpamKeyword(name, tagline, description);
    const newStuffing = findKeywordStuffing(name, tagline, description);
    if (!name) {
      error = d.storeNameRequired;
    } else if (!slug) {
      error = d.storeUrlRequired;
    } else if (newTooLong) {
      error = fieldLimitRejectionMessage(newTooLong);
    } else if (newSpam) {
      error = spamRejectionMessage(newSpam);
    } else if (newStuffing) {
      error = stuffingRejectionMessage(newStuffing);
    } else if (!await canOpenAnotherStore(sellerId)) {
      // Server-side gate — the entry point is hidden at the cap, but a hidden link is not a guard.
      error = d.storeLimitReached;
    } else {
      const { id: newStoreId } = await createStore(sellerId, { name, slug, tagline, description });
      // Same sanitizer the settings endpoint uses — the picker is convenience, this is the rule.
      const initialCategories = sanitizeStoreCategories(String(form.get('categories') ?? '').split(','));
      if (initialCategories.length) await updateStore(newStoreId, { categories: initialCategories });
      return Astro.redirect(machineUrl(`/seller/dashboard?store=${newStoreId}`));
    }
  } else if (action === 'add-product') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    // The store is resolved from the SESSION's own list before a row is written — the form's
    // `storeId` is attacker-controlled, and this handler used to hand it straight to
    // createProduct, which files a product into whatever store the id names.
    const ownerStore = await ownedStore(sellerId, storeId);
    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else if (!ownerStore) {
      error = d.notYours;
    } else {
      await createProduct(ownerStore.id, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      return Astro.redirect(machineUrl(`/seller/dashboard?store=${ownerStore.id}&added=1${panelParam}`));
    }
  } else if (action === 'edit-product') {
    const productId = String(form.get('productId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    // Same binding the /api/product twin has always had: a product id is not a permission, so it
    // is checked against the seller's stores before price or stock — the two fields that decide
    // what a shopper is charged and how many units exist — can be written.
    const claim = await ownedProduct(sellerId, productId);
    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else if (!claim.ok) {
      error = d.notYours;
    } else {
      await updateProduct(claim.product.id, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      const sid = Astro.url.searchParams.get('store') ?? '';
      return Astro.redirect(sid ? machineUrl(`/seller/dashboard?store=${sid}${panelParam}`) : `/seller/dashboard?panel=${initialPanel}`);
    }
  } else if (action === 'delete-product') {
    const productId = String(form.get('productId') || '');
    const sid = String(form.get('storeId') || '');
    const claim = await ownedProduct(sellerId, productId);
    if (!claim.ok) {
      error = d.notYours;
    } else {
      await deleteProduct(claim.product.id);
      return Astro.redirect(sid ? machineUrl(`/seller/dashboard?store=${sid}${panelParam}`) : `/seller/dashboard?panel=${initialPanel}`);
    }
  }
}

const allStores = await getStoresBySellerId(sellerId);
const hasNoStore = allStores.length === 0;
// **The one read on this page that is not about the store in the switcher.** A payout is per
// registered business, so this covers every store the seller owns — three small indexed reads
// assembled by one call (`payouts.ts#getSellerAccountFor`), issued on every load rather than only
// when the tab is open, because what it decides is the tab's BADGE: money released with no bank
// account to send it to is the one state a seller has to be told about from wherever they are
// standing. It also carries the seller row, which the performance tab reads for the tier.
const payoutAccount = await getSellerAccountFor(sellerId);
const seller = payoutAccount?.seller ?? null;
// The badge condition, and it is the banner's condition too — one predicate, so the strip and the
// panel cannot disagree about whether there is anything to do (PayoutsPanel.astro).
// Both tables on the Payments tab page through the URL, so each link has to carry the OTHER
// table's page too — otherwise stepping through the history silently resets the held list under
// the seller's cursor. Built here rather than in the component so the store id and the open tab
// stay this page's business.
/**
 * From a hold reason on the Payments tab to the orders behind it, in the tab that manages orders.
 *
 * The half of the deleted held-orders table that was worth keeping (owner, סשן א׳ §4): a seller
 * told "3 orders are waiting on you to ship" needs the three orders, and a link that lands them on
 * an unfiltered list has sent them to look for something rather than at it. The statuses are
 * derived from what each reason MEANS — `unshipped` is every status the payout clock does NOT run
 * from — so a new shipping status is filtered correctly by `order-status-rules.ts` rather than by a
 * list here going stale.
 *
 * It reads the courier column and not `pickupPayoutClockRuns`, which is a simplification and a safe
 * one: the only status where the two differ is `ready`, which the seller's filter menu cannot
 * express at all (`ORDER_FILTER_STATUSES`). This decides which rows a link shows, never which money
 * moves — `payout-hold.ts` is the only thing that does that, and it reads the right column.
 */
function ordersForHoldBasisHref(basis: 'payment' | 'unshipped', storeSlug: string | null): string {
  const params = new URLSearchParams({ panel: 'orders' });
  // The row's OWN shop, not the one in the switcher. The payments tab is account-wide and the
  // Orders tab shows one store, so a link that always used the current store sent a two-shop seller
  // to the wrong list and showed them a subset as if it were the answer (owner, 2026-08-11).
  const target = storeSlug ? allStores.find((s) => s.slug === storeSlug) : store;
  if (target) params.set('store', target.id);
  // `opay` — the Orders tab's own payout-status column, NOT a list of shipping statuses. The first
  // version spelled the hold rule out as `?ostatus=pending,processing`, which is a restatement of
  // `order-status-rules.ts` inside a link: it would have gone on filtering the old way the day a
  // status's payout behaviour changed. The owner asked for the filter column instead, and it is
  // also the version that cannot drift.
  params.set('opay', basis === 'unshipped' ? 'unshipped' : 'undelivered');
  // Says why the list is narrowed once it gets there, and offers the way out. Without it the seller
  // lands on a filtered Orders tab with no idea what filtered it or how to leave (owner, same).
  params.set('ofrom', basis);
  return `/seller/dashboard?${params.toString()}`;
}

/** The reason the Orders tab is narrowed, when the seller arrived from the payments tab. Whitelisted
 *  rather than echoed: it is printed on the page, and an unknown value simply means no banner. */
const ordersFromBasis = ['payment', 'unshipped'].includes(Astro.url.searchParams.get('ofrom') ?? '')
  ? Astro.url.searchParams.get('ofrom')! as 'payment' | 'unshipped'
  : null;
/** The way back: the same tab with no status filter at all. `ostatus=` (explicitly empty) is
 *  "cleared" rather than "default" — `parseSellerOrderQuery` distinguishes them, and a seller
 *  pressing "show everything" means everything, including delivered and cancelled.
 *
