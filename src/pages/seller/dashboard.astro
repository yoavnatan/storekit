                `empty:hidden` is load-bearing rather than tidy: the `hidden` ATTRIBUTE loses to a
                `flex` class (memory `project_tailwind_hidden_vs_flex`, and
                .home-spotlight-arrow[hidden] in home.css is the same fix), so `hidden` alone left a
                padded flex row for every store with one page. `:empty` adds a pseudo-class to the
                selector, so it beats `.flex` whatever the source order — and the pager is emptied
                and hidden by the same branch, so the two can never disagree. */}
            <nav class="dash-toolbar__pager order-1 empty:hidden flex items-center justify-center flex-wrap gap-[.4rem] mx-auto" data-list-pager="products" data-page={productsPage.page} data-total-pages={productsPage.totalPages} hidden></nav>
          </div>

          <table id="products-table" class="products-table" hidden={products.length === 0}>
            <thead>
              <tr>
                <th class="check-col w-8 text-center align-middle px-[0.15rem]"><input type="checkbox" id="bulk-select-all" class="bulk-select-all cursor-pointer disabled:cursor-not-allowed disabled:opacity-40" aria-label={d.bulkSelectAll} style="width:15px;height:15px;flex-shrink:0"></th>
                {/* Width lives in dashboard.css, not here: under `table-layout: fixed` the
                    declared width is the column's REAL width rather than a minimum, and an
                    inline 2rem (narrower than a 4-digit row number) beats any stylesheet. */}
                <th class="num row-num pe-[0.2rem]">#</th>
                <th class="thumb-col"></th>
                <th class="name-col">
                  <button type="button" class="sort-btn" data-sort-col="name" aria-label={`${d.sortByLabel} ${d.colName}`}><span class="sort-btn__label">{d.colName}</span><svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="sku-col"><span class="sort-btn__label">{d.skuLabel}</span></th>
                <th class="cat-col">
                  <div style="display:flex;align-items:center;gap:0.25rem;min-width:0">
                    <button type="button" class="sort-btn" data-sort-col="category" aria-label={`${d.sortByLabel} ${d.categoryLabel}`}><span class="sort-btn__label">{d.categoryLabel}</span><svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                    <button type="button" class="combo-filter-btn" data-filter-funnel-col="category" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.categoryLabel}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;flex-shrink:0;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    </button>
                  </div>
                </th>
                <th class="price-col">
                  <button type="button" class="sort-btn" data-sort-col="price" aria-label={`${d.sortByLabel} ${d.colPrice}`}><span class="sort-btn__label">{d.colPrice}</span><svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="stock-col">
                  <div style="display:flex;align-items:center;gap:0.25rem;min-width:0">
                    <button type="button" class="sort-btn" data-sort-col="stock" aria-label={`${d.sortByLabel} ${d.colStock}`}><span class="sort-btn__label">{d.colStock}</span><svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                    <button type="button" class="combo-filter-btn" data-filter-funnel-col="stock" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.colStock}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;flex-shrink:0;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    </button>
                  </div>
                </th>
                <th class="num wishlist-col">
