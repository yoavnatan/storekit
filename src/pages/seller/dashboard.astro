                              (`lib/return-chip.ts`). */}
                          <Fragment set:html={orderReturnChipHtml(
                            returnChipByOrderId.get(order.id) ?? null,
                            (() => { const c = returnChipByOrderId.get(order.id); return c ? d[c.key] : ''; })(),
                            d.returnChipOpenCase,
                          )} />
                          <span class="order-age-chip-slot flex items-center min-w-0 overflow-hidden empty:hidden" set:html={orderAgeChipHtml(order.createdAt, order.shippingStatus, lang)} />
                          <span class="order-note-chip inline-flex items-center shrink-0 [color:var(--color-muted)] cursor-help" data-tooltip={d.orderNoteChip} aria-label={d.orderNoteChip} hidden={noteList.length === 0} tabindex="0"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 3.5h15v10.5l-5.5 5.5h-9.5z"/><path d="M19.5 14h-5.5v5.5"/><line x1="8" y1="8.5" x2="16" y2="8.5"/><line x1="8" y1="12" x2="13" y2="12"/></svg></span>
