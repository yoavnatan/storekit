                const { hasAnyStock: pHasVariantStock, combos: pVariantCombos } = variantCombosData(p.variants ?? [], p.variantStock, p.stock);
                const pVariantColumns = (p.variants ?? []).map((v) => v.name);
                const pHasVariants = (p.variants ?? []).length > 0;
                const pStockFieldValue = pHasVariants ? pVariantCombos.reduce((s, c) => s + c.value, 0) : p.stock;
                return (
                <>
