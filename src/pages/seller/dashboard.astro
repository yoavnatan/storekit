<dialog id="edit-order-modal" aria-labelledby="eom-title" style="border:none;border-radius:var(--radius-lg);padding:0;width:min(520px,96vw);box-shadow:var(--shadow-overlay);background:var(--color-surface);margin:auto">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border);flex-shrink:0">
    <h2 id="eom-title" style="font-size:0.95rem;font-weight:700;margin:0">{t.dashboard.eomTitle}</h2>
    <button id="edit-order-modal-close" type="button" aria-label={t.dashboard.eomClose} style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius-sm);border:none;background:none;color:var(--color-muted);cursor:pointer;transition:background 0.1s">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
