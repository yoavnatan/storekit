<dialog id="edit-order-modal" aria-labelledby="eom-title" style="border:none;border-radius:14px;padding:0;width:min(520px,96vw);box-shadow:0 16px 56px rgba(0,0,0,0.26);background:var(--color-surface);margin:auto">
