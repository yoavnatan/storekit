                    <svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                  </button>
                </th>
                <th class="num purchased-col">
                  <button type="button" class="sort-btn" data-sort-col="purchased"><span class="sort-btn__label">{d.colPurchased}</span><svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="date-col">
                  <button type="button" class="sort-btn" data-sort-col="createdAt"><span class="sort-btn__label">{d.colDateAdded}</span><svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="actions-col" />
              </tr>
            </thead>
