  {/* min-height keeps the dialog from resizing/recentering as content swaps
      (loading/empty ↔ donut), which read as a flicker on open.
      autofocus + tabindex=-1 catch showModal()'s initial focus here (outline
      suppressed) instead of on the close button, which otherwise opened with a
      visible focus ring. Keyboard Tab still reaches the close button normally. */}
  <div id="perf-breakdown-body" tabindex="-1" autofocus style="padding:1.25rem;min-height:19rem;display:flex;flex-direction:column;justify-content:center;outline:none"></div>
