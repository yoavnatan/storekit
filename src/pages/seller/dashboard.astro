                          <div class="flex gap-2 mt-2" style="margin-inline-start:auto;margin-top:0">
                            <button class="btn btn--sm" type="submit" style="min-width:5rem;text-align:center">{d.save}</button>
                            <button class="btn btn--ghost btn--sm" type="button" data-cancel-edit={p.id}>{d.cancel}</button>
                          </div>
                        </div>
                        <div class="grid grid-cols-[2fr_1fr_1fr] gap-4">
                          <label class="field">
                            <span>{d.nameReq}</span>
                            <input class="input" name="name" value={p.name} required />
                          </label>
                          <label class="field">
                            <span>{d.priceLabel}</span>
                            <input class="input" name="price" type="number" min="0" step="0.01" value={p.price} />
                          </label>
                          <label class="field">
                            <span>{d.colStock}</span>
                            <input class="input" name="stock" type="number" min="0" step="1" value={pStockFieldValue} readonly={pHasVariants} style={pHasVariants ? 'background:var(--color-bg)' : undefined} />
                          </label>
                        </div>
                        <label class="field">
                          <span>{d.descLabel}</span>
                          <textarea class="input" name="description" rows="2">{p.description}</textarea>
                        </label>

                        <div class="grid grid-cols-[2fr_1fr_1fr] gap-4">
                          <div class="field max-w-[280px]">
                            <span>{d.categoryLabel}</span>
                            <div class="category-picker relative" data-category-picker>
                              <input type="hidden" name="categoryId" value={p.categoryId ?? ''} />
                              <button type="button" class="category-picker__trigger group flex items-center justify-between gap-2 w-full px-[0.7rem] py-2 bg-[color:var(--color-bg)] border border-[var(--color-border)] rounded-[var(--radius)] cursor-pointer text-sm text-[color:var(--color-text)] text-start transition-colors duration-[120ms] hover:border-[var(--color-muted)] aria-expanded:border-[var(--color-accent)]" aria-haspopup="true" aria-expanded="false">
                                <span class="category-picker__label overflow-hidden text-ellipsis whitespace-nowrap">{(p.categoryId && productCategoryPaths.get(p.id)) || d.categoryNone}</span>
                                <svg class="category-picker__chevron shrink-0 text-[color:var(--color-muted)] transition-transform duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                              </button>
                              <div class="category-picker__menu absolute start-0 top-[calc(100%+5px)] w-max min-w-full max-w-[20rem] max-h-[18rem] overflow-y-auto bg-[color:var(--color-surface)] border border-[color:var(--color-border)] rounded-[var(--radius)] p-[0.3rem] shadow-[0_4px_20px_rgba(0,0,0,0.12)] z-[60] animate-status-pop" hidden></div>
                            </div>
                            <p class="muted" style="margin:0.3rem 0 0;font-size:0.76rem">{d.categoryEditHint}</p>
                          </div>
                          <label class="field max-w-[280px]">
                            <span>{d.skuLabel}</span>
                            <input class="input" name="sku" value={p.sku ?? ''} placeholder={d.skuPlaceholder} />
                          </label>
                        </div>

                        <div class="field max-w-none" data-tags-field>
                          <span>{d.tagsLabel}</span>
                          <div class="variant-chips" data-tag-chips style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
                            {(p.tags ?? []).map((tag) => (
                              <span class="variant-chip" data-tag-chip data-value={tag} style="display:inline-flex;align-items:center;gap:0.35rem;border:1px solid var(--color-border);border-radius:999px;padding:0.25rem 0.5rem 0.25rem 0.4rem;font-size:0.82rem">
                                <span class="variant-chip-label">{tag}</span>
                                <button type="button" class="variant-chip-remove" data-tag-chip-remove aria-label={d.variantChipRemove} style="display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;border:none;background:none;color:var(--color-muted);cursor:pointer;font-size:0.85rem;line-height:1;padding:0">×</button>
                              </span>
                            ))}
                            <span data-tag-adder>
                              <button type="button" class="variant-chip-add-trigger btn btn--ghost btn--sm" data-tag-add-trigger style="border-radius:999px">{d.variantValueAddBtn}</button>
                            </span>
                          </div>
                          <input type="hidden" name="tags" value={p.tags?.join(',') ?? ''} />
                        </div>

                        <div class="field variants-editor" data-variants-editor>
                          <span class="field-label">{d.variantsLabel}</span>
                          <div class="variant-dims" data-variant-dims>
                            {(p.variants ?? []).map((v) => (
                              <div class="variant-dim" data-variant-dim style="border:1px solid var(--color-border);border-radius:var(--radius);padding:0.65rem;margin-bottom:0.5rem">
                                <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem">
                                  <input class="input" data-dim-name value={v.name} placeholder={d.variantNamePlaceholder} style="width:130px;flex:0 0 auto" />
                                  <button type="button" class="variant-dim-remove btn btn--ghost btn--sm" aria-label={d.variantRemove} style="flex-shrink:0">×</button>
                                </div>
                                <div class="variant-chips" data-variant-chips style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
                                  {v.options.map((opt) => {
                                    const isColor = isColorVariant(v.name);
                                    const resolved = isColor ? resolveVariantColor(opt) : { display: opt, hex: null as string | null };
                                    return (
                                      <span class="variant-chip" data-variant-chip data-value={opt} style="display:inline-flex;align-items:center;gap:0.35rem;border:1px solid var(--color-border);border-radius:999px;padding:0.25rem 0.5rem 0.25rem 0.4rem;font-size:0.82rem">
                                        {isColor && (resolved.hex
                                          ? <span class="variant-chip-swatch" aria-hidden="true" style={`width:14px;height:14px;border-radius:3px;background:${resolved.hex};border:1px solid rgba(0,0,0,0.15);flex-shrink:0;display:inline-block`}></span>
                                          : <input type="color" class="variant-chip-color-input" value="#9ca3af" aria-label={d.variantColorPicker} style="width:16px;height:16px;padding:0;border:1px solid rgba(0,0,0,0.15);border-radius:3px;flex-shrink:0;cursor:pointer;background:none" />
                                        )}
                                        <span class="variant-chip-label">{resolved.display}</span>
                                        <button type="button" class="variant-chip-remove" aria-label={d.variantChipRemove} style="display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;border:none;background:none;color:var(--color-muted);cursor:pointer;font-size:0.85rem;line-height:1;padding:0">×</button>
                                      </span>
                                    );
                                  })}
                                  <span data-dim-value-adder>
                                    <button type="button" class="variant-chip-add-trigger btn btn--ghost btn--sm" data-dim-value-trigger style="border-radius:999px">{d.variantValueAddBtn}</button>
                                  </span>
                                </div>
                              </div>
                            ))}
                          </div>
                          <button type="button" class="variants-add-btn btn btn--ghost btn--sm" style="margin-top:0.25rem">{d.variantAddBtn}</button>
                          <div class="variant-combos" data-variant-combos style="margin-top:0.75rem" hidden={!(p.variants ?? []).length}>
                            <p class="field-label" style="margin:0 0 0.3rem">{d.variantComboLabel}</p>
                            <p class="muted" data-variant-combo-hint style="font-size:0.78rem;margin:0 0 0.5rem" hidden={pHasVariantStock}>{d.variantComboHint}</p>
                            <div style="max-height:260px;overflow:auto;border:1px solid var(--color-border);border-radius:var(--radius)">
                              <table style="width:100%;border-collapse:separate;border-spacing:0">
                                <thead data-variant-combo-thead>
                                  <tr data-variant-combo-header>
                                    {pVariantColumns.map((col, i) => (
                                      <th style="padding:0.4rem 0.6rem;text-align:start;border-bottom:1px solid var(--color-border);white-space:nowrap">
                                        <div style="display:flex;align-items:center;gap:0.25rem">
                                          <button type="button" class="combo-sort-btn" data-combo-sort-col={i}>{col}<svg class="combo-sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                                          <span class="combo-filter" data-combo-filter data-filter-col={i} style="display:inline-flex">
                                            <button type="button" class="combo-filter-btn" aria-expanded="false" aria-haspopup="true" aria-label={`${d.variantFilterAriaPrefix} ${col}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                                              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                                            </button>
                                          </span>
                                        </div>
                                      </th>
                                    ))}
                                    <th style="padding:0.4rem 0.6rem;text-align:end;border-bottom:1px solid var(--color-border);white-space:nowrap;position:sticky;inset-inline-end:0;background:var(--color-surface);z-index:2">
                                      <button type="button" class="combo-sort-btn" data-combo-sort-col="stock">{d.variantStockColLabel}<svg class="combo-sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                                    </th>
                                  </tr>
                                </thead>
                                <tbody data-variant-combo-rows>
                                  {pVariantCombos.map((c) => (
                                    <tr class="variant-combo-row" data-variant-combo-row data-combo-key={c.key}>
                                      {c.parts.map((part) => (
                                        <td style="padding:0.4rem 0.6rem;font-size:0.85rem;color:var(--color-text);white-space:nowrap;vertical-align:middle">
                                          {part.hex
                                            ? <span style="display:inline-flex;align-items:center;gap:0.3rem"><span aria-hidden="true" style={`display:inline-block;width:10px;height:10px;border-radius:3px;background:${part.hex};border:1px solid rgba(0,0,0,0.15);flex-shrink:0`}></span>{part.text}</span>
                                            : part.text}
                                        </td>
                                      ))}
                                      <td style="padding:0.4rem 0.6rem;text-align:end;vertical-align:middle;position:sticky;inset-inline-end:0;background:var(--color-surface);z-index:1"><input type="number" min="0" step="1" class="input" data-combo-stock value={c.value} style="width:80px;text-align:center;padding:0.3rem 0.4rem" /></td>
                                    </tr>
                                  ))}
                                </tbody>
                                <tfoot data-variant-combo-tfoot>
                                  <tr data-variant-combo-total-row>
                                    <td colspan={pVariantColumns.length} data-variant-combo-total-label style="padding:0.4rem 0.6rem;font-size:0.82rem;font-weight:600;color:var(--color-text);white-space:nowrap;border-top:1px solid var(--color-border);position:sticky;bottom:0;background:var(--color-surface)">{`${d.variantComboTotal} (${d.variantFilterAll})`}</td>
                                    <td data-variant-combo-total-value style="padding:0.4rem 0.6rem;text-align:end;font-weight:600;color:var(--color-text);border-top:1px solid var(--color-border);position:sticky;inset-inline-end:0;bottom:0;background:var(--color-surface);z-index:1">{pVariantCombos.reduce((s, c) => s + c.value, 0)}</td>
                                  </tr>
                                </tfoot>
                              </table>
                            </div>
                          </div>
                        </div>

                        <div class="field">
                          <span class="field-label">{d.specsLabel}</span>
                          <div class="specs-rows"
                               data-label-placeholder={d.specsLabelPlaceholder}
                               data-value-placeholder={d.specsValuePlaceholder}>
                            {(p.specs ?? []).map((s) => (
                              <div class="specs-row" style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem">
                                <input class="input" name="specs_label" value={s.label} placeholder={d.specsLabelPlaceholder} style="width:170px;flex:0 0 auto" />
                                <input class="input" name="specs_value" value={s.value} placeholder={d.specsValuePlaceholder} style="width:220px;flex:0 0 auto" />
                                <button type="button" class="specs-remove-row btn btn--ghost btn--sm" aria-label={d.specsRemoveRow}>×</button>
                              </div>
                            ))}
                          </div>
                          <button type="button" class="specs-add-row btn btn--ghost btn--sm" style="margin-top:0.5rem">{d.specsAddRow}</button>
                        </div>

                        <label class="field max-w-none">
                          <span class="inline-flex items-center gap-[0.35rem]">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;color:var(--color-muted)"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                            {d.sellerNoteLabel}
                          </span>
                          <textarea class="input resize-none" name="sellerNote" rows="2" maxlength="2000" placeholder={d.sellerNotePlaceholder}>{p.sellerNote ?? ''}</textarea>
                        </label>

                        <div class="field">
                          <span class="field-label">{d.productImages}</span>
                          <div set:html={galleryWidgetHtml(p.images ?? [], g)}></div>
                        </div>
                        <div class="flex gap-2 mt-2">
                          <button class="btn btn--sm" type="submit" style="min-width:5rem;text-align:center">{d.save}</button>
                          <button class="btn btn--ghost btn--sm" type="button" data-cancel-edit={p.id}>{d.cancel}</button>
                        </div>
                      </form>
                    </td>
                  </tr>
                </>
                );
              })}
            </tbody>
          </table>

          <nav id="products-pagination" class="flex items-center justify-center gap-4 pt-4 pb-1" aria-label={d.productsTitle} data-page={productsPage.page} data-total-pages={productsPage.totalPages} hidden></nav>
        </div>
      </div>

      <!-- ── Panel: Orders ── -->
      <div id="dash-panel-orders" class="dash-panel" role="tabpanel" aria-labelledby="tab-orders" hidden={initialPanel !== 'orders'}>
        {showTabHints && <TabHint text={d.tabHintOrders} />}
        <div class="dash-panel-head flex flex-col items-start mb-4 gap-[0.6rem] py-[0.6rem] border-b [border-color:var(--color-border)]">
          <h2 class="m-0">{d.ordersTitle}</h2>
          {/* Orders is cards-only at every screen size (no table/header to fall
              back to), so this toolbar is always visible — unlike
              .table-toolbar (products/messages), it's not display:none above
              640px. Default filter selection = the old "active" preset
              (pending/processing/ready/shipped), matching today's default. */}
          {storeOrders.length > 0 && (
            <div class="dash-toolbar w-full" id="orders-toolbar">
              <div class="relative flex-1 min-w-[110px] max-w-[280px]">
                <svg class="absolute top-1/2 -translate-y-1/2 start-[0.7rem] pointer-events-none" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="color:var(--color-muted)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="search" id="orders-search-input" value={sellerOrderQuery.q} placeholder={d.ordersSearchPlaceholder ?? 'חיפוש הזמנות…'} class="w-full font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] ps-[1.9rem] pe-[.85rem] outline-none transition-colors duration-[120ms] focus:border-[color:var(--color-primary)]" />
              </div>
              <button type="button" id="orders-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
                <span id="orders-sort-label" class="toolbar-btn-label">{d.orderSortOptDateDesc}</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <button type="button" id="orders-filter-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="true" aria-expanded="false">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                <span class="toolbar-btn-label">{d.filterByLabel}</span>
                <span id="orders-filter-count" class="filter-count-badge inline-flex items-center justify-center min-w-4 h-4 px-1 rounded-full bg-[color:var(--color-primary)] text-white text-[.68rem] font-bold leading-none" hidden>0</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          )}
        </div>
        {storeOrders.length === 0 ? (
          <p class="seller-msg-empty">{d.noOrders}</p>
        ) : (
          <Fragment>
          <p class="seller-msg-empty" id="orders-filter-empty" hidden={ordersPage.total > 0}>אין הזמנות בקטגוריה זו.</p>
          <div class="flex flex-col gap-3" id="orders-list">
            {ordersPage.items.map((order) => {
              const storeItems = order.items.filter((i) => i.storeSlug === store!.slug);
              const storeSub   = order.storeSubtotals[store!.slug];
              const fmtDate    = (iso: string) => new Date(iso).toLocaleString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
              const shortId    = order.checkoutRef ?? order.id.slice(0, 8).toUpperCase();
              const noteList   = orderStoreNotes(order, store!.slug);
              return (
                <div class="order-card group border-[1.5px] border-[color:var(--color-border)] rounded-[var(--radius)] overflow-visible bg-[color:var(--color-surface)] transition-[border-color] duration-150 hover:border-[color:color-mix(in_srgb,var(--color-text)_20%,var(--color-border))]" data-order-id={order.id} data-store-slug={store!.slug} data-shipping-status={order.shippingStatus} data-sort-date={order.createdAt} data-sort-amount={storeSub ? storeSub.subtotal + storeSub.shipping : 0}>
                  <div class="order-card__header flex items-center gap-3 px-4 py-[0.875rem] cursor-pointer select-none rounded-[calc(var(--radius)-1.5px)] group-data-[open]:rounded-b-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-[color:var(--color-accent)] focus-visible:[outline-offset:-2px]" role="button" tabindex="0" aria-expanded="false">
                    <div class="flex flex-col items-start gap-[0.2rem] w-20 sm:w-28 shrink-0">
                      <span class="order-card__id text-[0.8rem] font-bold text-[color:var(--color-text)] font-mono">
                        #{shortId}
                        {order.shippingStatus === 'pending' && (
                          <span class="order-new-dot inline-block w-2 h-2 bg-[#ef4444] rounded-full ms-[5px] align-middle shrink-0" aria-label="הזמנה חדשה"></span>
                        )}
                      </span>
                      <span class="text-[0.72rem] text-[color:var(--color-muted)]">{fmtDate(order.createdAt)}</span>
                    </div>
                    <div class="flex-1 flex items-center gap-3 min-w-0">
                      <div class="flex flex-col min-w-0 flex-1 gap-[0.15rem]">
                        <span class="text-sm font-semibold text-[color:var(--color-text)] truncate">{order.buyerName}</span>
                        <span class="text-[0.72rem] text-[color:var(--color-muted)] truncate">{storeItems.length === 1 ? 'מוצר אחד' : `${storeItems.length} מוצרים`}</span>
                      </div>
                      {/* Trailing on desktop: price at a FIXED x on every card, then the
                          age chip pulled right up against the status badge in one shared,
                          fixed-width slot (they read as a single status cluster). The slot's
                          fixed width is what keeps the price aligned across all cards; the
                          status stays full-width and only the age chip yields (clips) in the
                          rare case both are at their longest. On mobile they stack. */}
                      <div class="flex flex-col items-end gap-1.5 shrink-0 sm:flex-row sm:items-center sm:gap-4">
                        <span class="order-card__amount text-sm font-bold text-[color:var(--color-text)] w-[6rem] text-end">{formatPrice(storeSub ? storeSub.subtotal + storeSub.shipping : 0)}</span>
                        <div class="flex items-center justify-end gap-1.5 min-w-0 sm:w-[12rem]">
                          <span class="order-age-chip-slot flex items-center shrink-0 empty:hidden" set:html={orderAgeChipHtml(order.createdAt, order.shippingStatus, lang)} />
                          <span class="order-note-chip inline-flex items-center shrink-0 [color:var(--color-muted)]" title={noteList.join('\n') || undefined} aria-label={d.orderNoteLabel} hidden={noteList.length === 0}><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></span>
                          <button type="button" class="order-card__status-badge inline-flex items-center gap-1 shrink-0 text-[0.72rem] font-semibold px-[0.55rem] py-[0.2rem] rounded-[20px] border-0 cursor-pointer transition-[filter] duration-100 hover:brightness-95 whitespace-nowrap" style={`background:${orderStatusColors[order.shippingStatus] ?? '#888'}1a;color:${orderStatusColors[order.shippingStatus] ?? '#888'};`} aria-haspopup="listbox" aria-expanded="false" aria-label={`${d.orderShippingStatus}: ${orderShippingLabels[order.shippingStatus] ?? order.shippingStatus}`}>
                            <span class="order-status-badge-label">{orderShippingLabels[order.shippingStatus] ?? order.shippingStatus}</span>
                            <svg class="order-status-badge-chevron shrink-0" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                          </button>
                        </div>
                      </div>
                    </div>
                    <svg class="shrink-0 text-[color:var(--color-muted)] transition-transform duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] group-data-[open]:rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </div>
                  <div class="order-card__body border-t border-[color:var(--color-border)] p-4 flex flex-col gap-4 animate-product-menu-open" hidden>
                    <div>
                      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
                        <h3 class="text-[0.78rem] font-bold text-[color:var(--color-muted)] uppercase tracking-[0.05em]">{d.orderBuyer}</h3>
                        <button
                          class="btn btn--ghost btn--sm order-edit-buyer-btn"
                          type="button"
                          data-order-id={order.id}
                          data-store-slug={store!.slug}
                          data-buyer-name={order.buyerName}
                          data-buyer-email={order.buyerEmail}
                          data-buyer-phone={order.buyerPhone}
                          data-buyer-city={order.buyerAddress.city}
                          data-buyer-street={order.buyerAddress.street}
                          data-buyer-zip={order.buyerAddress.zip ?? ''}
                          data-items={JSON.stringify(storeItems)}
                          data-shipping={String(storeSub?.shipping ?? 0)}
                          data-discount-type={storeSub?.discount?.type ?? 'percent'}
                          data-discount-value={String(storeSub?.discount?.value ?? 0)}
                          style="font-size:0.75rem"
                        >
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                          ערוך פרטים
                        </button>
                      </div>
                      <p class="order-card__info-line order-buyer-name text-sm text-[color:var(--color-text)] my-[0.1rem]"><strong>{order.buyerName}</strong></p>
                      <p class="order-card__info-line order-buyer-email text-sm text-[color:var(--color-text)] my-[0.1rem]">{order.buyerEmail}</p>
                      <p class="order-card__info-line order-buyer-phone text-sm text-[color:var(--color-text)] my-[0.1rem]">{d.orderPhone}: {order.buyerPhone}</p>
                      <p class="order-card__info-line order-buyer-address text-sm text-[color:var(--color-text)] my-[0.1rem]">{d.orderAddress}: {order.buyerAddress.street}, {order.buyerAddress.city}{order.buyerAddress.zip ? ` ${order.buyerAddress.zip}` : ''}</p>
                    </div>
                    <div>
                      <h3 class="text-[0.78rem] font-bold text-[color:var(--color-muted)] uppercase tracking-[0.05em] mb-2">{d.orderItems}</h3>
                      <ul class="order-card__items list-none p-0 flex flex-col gap-2">
                        {storeItems.map((item) => (
                          <li class="flex items-center gap-2.5 text-sm">
                            {item.image && <img src={cdnThumb(item.image, 72, 72)} alt="" width="36" height="36" loading="lazy" decoding="async" class="w-9 h-9 object-cover rounded-[var(--radius-sm)] shrink-0 border [border-color:var(--color-border)] bg-[color:var(--color-surface)]" />}
                            <span class="flex-1 text-[color:var(--color-text)]">{item.productName}</span>
                            <span class="text-[color:var(--color-muted)] text-[0.8rem]">×{item.qty}</span>
                            <span class="font-bold text-[color:var(--color-text)] ms-auto">{formatPrice(item.price * item.qty)}</span>
                          </li>
                        ))}
                      </ul>
                      {storeSub && (
                        <div class="order-card__subtotals flex justify-between items-center mt-2.5 pt-2.5 border-t border-[color:var(--color-border)] text-sm text-[color:var(--color-muted)]">
                          <span>{d.orderShipping}: {storeSub.shipping === 0 ? 'חינם' : formatPrice(storeSub.shipping)}</span>
                          <strong class="text-[color:var(--color-text)] text-[0.9375rem]">{d.orderTotal}: {formatPrice(storeSub.subtotal + storeSub.shipping)}</strong>
                        </div>
                      )}
                    </div>
                    <div class="bg-[color:var(--color-bg)] rounded-b-[calc(var(--radius)-1.5px)] p-[0.875rem] overflow-visible">
                      {/* Multi-note UI: a list of private notes (each an inline line with
                          its own delete ✗), an always-visible "add note" button, and an
                          on-demand editor (textarea + ✓/✗) that APPENDS a new note. Notes
                          persist independently of the status/tracking save — each add/delete
                          is its own note-only PATCH (owner feedback). */}
                      <div class="order-note mb-3">
                        <ul class="order-note-list flex flex-col gap-1 mb-1" hidden={noteList.length === 0}>
                          {noteList.map((n) => (
                            <li class="order-note-item flex items-start gap-1.5 text-[0.82rem]">
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 mt-[0.15rem] [color:var(--color-muted)]"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                              <span class="order-note-text flex-1 min-w-0 [color:var(--color-text)] whitespace-pre-wrap break-words">{n}</span>
                              <button type="button" class="order-note-edit shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-[var(--radius-sm)] [color:var(--color-muted)] bg-transparent border-0 cursor-pointer transition-colors duration-100 hover:[color:var(--color-primary)]" aria-label={d.orderEditNote} title={d.orderEditNote}><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg></button>
                              <button type="button" class="order-note-del shrink-0 inline-flex items-center justify-center w-5 h-5 rounded-[var(--radius-sm)] [color:var(--color-muted)] bg-transparent border-0 cursor-pointer transition-colors duration-100 hover:[color:var(--color-danger)]" aria-label={d.orderNoteDelete} title={d.orderNoteDelete}><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                            </li>
                          ))}
                        </ul>
                        <button type="button" class="order-note-add inline-flex items-center gap-1.5 text-[0.82rem] font-semibold [color:var(--color-primary)] bg-transparent border-0 cursor-pointer py-1 hover:underline">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                          {d.orderAddNote}
                        </button>
                        <div class="order-note-editor mt-1.5" hidden>
                          <textarea class="order-note-input input w-full !resize-none" rows="2" maxlength="2000"></textarea>
                          <div class="flex items-center justify-between gap-2 mt-1.5">
                            <span class="text-[0.72rem] [color:var(--color-muted)]">{d.orderNotePrivateHint}</span>
                            <div class="flex items-center gap-1.5">
                              <button type="button" class="order-note-cancel inline-flex items-center justify-center w-7 h-7 rounded-[var(--radius-sm)] bg-transparent [color:var(--color-muted)] border border-[color:var(--color-border)] cursor-pointer transition-colors duration-100 hover:bg-[color:var(--color-surface)] hover:[color:var(--color-text)]" aria-label={d.orderNoteCancel} title={d.orderNoteCancel}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                              <button type="button" class="order-note-save inline-flex items-center justify-center w-7 h-7 rounded-[var(--radius-sm)] bg-[color:var(--color-primary)] text-white border-0 cursor-pointer transition-[filter] duration-100 hover:brightness-95" aria-label={d.orderAddNote} title={d.orderAddNote}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
                            </div>
                          </div>
                        </div>
                      </div>
                      <h3 class="text-[0.78rem] font-bold text-[color:var(--color-muted)] uppercase tracking-[0.05em] mb-2">{d.orderTracking}</h3>
                      <div class="relative">
                        <input type="text" class="order-tracking-input input w-full !pe-10" data-field="trackingNumber" value={order.trackingNumber ?? ''} placeholder={d.orderTrackingPlaceholder} />
                        <button class="order-copy-track absolute end-1 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-8 h-8 rounded-[var(--radius-sm)] bg-transparent border-0 cursor-pointer [color:var(--color-muted)] hover:[color:var(--color-primary)] hover:bg-[color:var(--color-bg)] transition-colors duration-100" type="button" aria-label={d.orderCopyTracking} title={d.orderCopyTracking} data-copied-label={d.orderCopiedTracking}>
                          <svg class="order-copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                          <svg class="order-copy-check hidden [color:var(--color-success)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        </button>
                      </div>
                      <h3 class="text-[0.78rem] font-bold text-[color:var(--color-muted)] uppercase tracking-[0.05em] mt-3 mb-2">{d.orderShippingStatus}</h3>
                      <div class="flex gap-2 items-center flex-wrap">
                        <div class="order-status-dropdown">
                          <button class="order-status-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                            <span class="order-status-dot" style={`background:${orderStatusColors[order.shippingStatus] ?? '#888'}`}></span>
                            <span class="order-status-label">{orderShippingLabels[order.shippingStatus] ?? order.shippingStatus}</span>
                            <svg class="order-status-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                          </button>
                          <input type="hidden" class="order-status-select" data-field="shippingStatus" value={order.shippingStatus} />
                        </div>
                        <button class="order-save-btn btn btn--sm btn--accent ms-auto" type="button">{d.orderSave}</button>
                      </div>
                      <p class="order-save-status text-[0.8rem] font-semibold text-[color:var(--color-success)] mt-[0.4rem]" hidden aria-live="polite">{d.orderSaved}</p>
                      {['pending', 'processing', 'ready'].includes(order.shippingStatus) && (
                        <button class="order-cancel-btn mt-3 inline-flex items-center gap-[0.3rem] bg-transparent border-0 p-0 cursor-pointer text-[0.78rem] font-semibold text-[color:var(--color-danger)] hover:underline" type="button" data-order-id={order.id} data-store-slug={store!.slug}>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                          {d.orderCancel}
                        </button>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
          <nav id="orders-pagination" class="flex items-center justify-center gap-4 pt-4 pb-1" aria-label={d.ordersTitle} data-page={ordersPage.page} data-total-pages={ordersPage.totalPages} hidden></nav>
          </Fragment>
        )}
      </div>

      <!-- ── Panel: Performance ── -->
      <div id="dash-panel-performance" class="dash-panel" role="tabpanel" aria-labelledby="tab-performance" hidden={initialPanel !== 'performance'}>
        {showTabHints && <TabHint text={d.tabHintPerformance} />}
        <div class="dash-panel-head mb-5 py-[0.6rem] border-b [border-color:var(--color-border)] flex items-center justify-between gap-3 flex-wrap">
          <div>
            <h2 class="m-0 text-base font-semibold">{d.perfTitle}</h2>
            <p class="muted text-[0.82rem] m-0 mt-1">{d.perfSubtitle}</p>
          </div>
          <div id="perf-range-picker" data-store-slug={store.slug} data-active-preset="thisMonth">
          <button
            type="button"
            id="perf-range-trigger"
            class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span id="perf-range-label">{d.perfPresetThisMonth}</span>
            <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <input type="hidden" id="perf-from-input" value={perfFromISO} />
          <input type="hidden" id="perf-to-input" value={perfToISO} />
          </div>
        </div>

        <dl id="perf-kpis" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-5" aria-live="polite">
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
            <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfRevenue}</dt>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-revenue">{perfSummary && formatPrice(perfSummary.totalRevenue)}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
            <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfOrders}</dt>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-orders">{perfSummary?.totalOrders ?? 0}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
            <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfAvgOrder}</dt>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-avg">{perfSummary && formatPrice(perfSummary.avgOrderValue)}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
            <div class="flex items-center gap-1 mb-1">
              <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfVisitors}</dt>
              <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfVisitsHint} aria-label={d.perfVisitsHint}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
              </button>
            </div>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-visitors">{perfSummary?.totalViews ?? 0}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
            <div class="flex items-center gap-1 mb-1">
              <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfUniqueVisitors}</dt>
              <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfUniqueVisitorsHint} aria-label={d.perfUniqueVisitorsHint}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
              </button>
            </div>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-unique">{perfSummary?.totalUniqueVisitors ?? 0}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
            <div class="flex items-center gap-1 mb-1">
              <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfConversion}</dt>
              <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfConversionHint} aria-label={d.perfConversionHint}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
              </button>
            </div>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-conversion">{(perfSummary?.conversionRate ?? 0).toFixed(1)}%</dd>
          </div>
        </dl>

        {/* Profitability breakdown — a compact "receipt": gross revenue less the
            platform commission (the seller's only platform-side expense in the
            split-payment model) equals the net the seller actually receives.
            Reporting only; the real deduction happens at the processor. */}
        <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4 mb-5 [background:color-mix(in_srgb,var(--color-success)_4%,transparent)]">
          <div class="flex items-center gap-1 mb-3">
            <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfProfitTitle}</h3>
            <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfProfitHint} aria-label={d.perfProfitHint}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
            </button>
          </div>
          <dl class="m-0 flex flex-col gap-2 text-[0.86rem]">
            <div class="flex items-center justify-between gap-3">
              <dt class="[color:var(--color-muted)]">{d.perfGrossRevenue}</dt>
              <dd class="m-0 font-medium" id="perf-gross">{perfSummary && formatPrice(perfSummary.totalRevenue)}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="[color:var(--color-muted)]">{d.perfCommission} <span class="text-[0.78rem]">(<span id="perf-commission-rate">{perfSummary?.commissionRate ?? 0}</span>%)</span></dt>
              <dd class="m-0 font-medium" id="perf-commission">{perfSummary && `(${formatPrice(perfSummary.platformCommission)})`}</dd>
            </div>
            <div class="flex items-center justify-between gap-3 pt-2 border-t [border-color:var(--color-border)]">
              <dt class="font-semibold">{d.perfNetProfit}</dt>
              <dd class="m-0 font-bold text-[1.02rem] [color:var(--color-success)]" id="perf-net">{perfSummary && formatPrice(perfSummary.netProfit)}</dd>
            </div>
          </dl>
        </div>

        {/* Initial summary — lets performance.ts re-render both charts at the
            container's real pixel width (crisp, no downscaled text) once the
            panel is visible, and again on resize (ResizeObserver). */}
        <script type="application/json" id="perf-initial-summary" set:html={jsonForScript(perfSummary ?? null)} />
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5" data-perf-rtl={perfIsRtl ? '1' : '0'}>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4">
            <h3 class="m-0 mb-3 text-[0.9rem] font-semibold">{d.perfRevenueChartTitle}</h3>
            <div id="perf-revenue-chart" set:html={perfRevenueChartSvg || perfChartSkeleton}></div>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4">
            <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
              <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfVisitorsChartTitle}</h3>
              <div class="flex items-center gap-3 text-[0.72rem] [color:var(--color-muted)]">
                <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-[3px] rounded-full [background:var(--color-accent)]"></span>{d.perfUniqueVisitors}</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0 border-t-2 border-dashed [border-color:var(--color-muted)]"></span>{d.perfVisitors}</span>
              </div>
            </div>
            <div id="perf-visitors-chart" set:html={perfVisitorsChartSvg || perfChartSkeleton}></div>
          </div>
        </div>

        <div>
          <h3 class="m-0 mb-3 text-[0.9rem] font-semibold">{d.perfTopProducts}</h3>
          <div id="perf-top-products" class="flex flex-col gap-2">
            {perfSummary && perfSummary.topProducts.length === 0 && (
              <p class="muted text-[0.85rem] m-0">{d.perfTopProductsEmpty}</p>
            )}
            {perfSummary?.topProducts.map((tp, tpIdx) => {
              const totalRevenue = Math.max(perfSummary.topProducts.reduce((s, x) => s + x.revenue, 0), 1);
              const pct = Math.round((tp.revenue / totalRevenue) * 100);
              return (
                <div class="relative rounded-[var(--radius)] border [border-color:var(--color-border)] overflow-hidden">
                  <div class="absolute inset-y-0 start-0 [background:color-mix(in_srgb,var(--color-primary)_12%,transparent)] animate-top-bar-grow" style={`width:${pct}%;--tw:${pct}%;animation-delay:${Math.min(tpIdx * 60, 300)}ms`}></div>
                  <div class="relative flex items-center justify-between gap-3 py-2 px-3 text-[0.85rem]">
                    <span class="font-medium overflow-hidden text-ellipsis whitespace-nowrap">{tp.name}</span>
                    <span class="shrink-0 [color:var(--color-muted)]"><strong class="[color:var(--color-text)]">{pct}%</strong> · {tp.units} {d.perfUnitsSold} · {formatPrice(tp.revenue)}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {store && <PerfProductSection products={products} />}
      </div>

      <!-- ── Panel: Advertising ── -->
      <div id="dash-panel-advertising" class="dash-panel" role="tabpanel" aria-labelledby="tab-advertising" hidden={initialPanel !== 'advertising'}>
        {showTabHints && <TabHint text={d.tabHintAdvertising} />}
        <div class="dash-panel-head mb-4 py-[0.6rem] border-b [border-color:var(--color-border)]">
          <h2 class="m-0 text-base font-semibold">{d.adTitle}</h2>
          <p class="muted text-[0.82rem] m-0 mt-1">{d.adSubtitle}</p>
        </div>

        <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4 mb-4 [background:color-mix(in_srgb,var(--color-success)_6%,transparent)]">
          <div class="flex items-center gap-2 flex-wrap mb-2">
            <h3 class="m-0 text-[0.9rem] font-semibold inline-flex items-center gap-1.5">
              <svg class="shrink-0 [color:var(--color-success)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 7.7 8 9 4.6-1.3 8-4 8-9V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
              {d.adBaselineTitle}
            </h3>
            <span class="inline-flex items-center gap-1.5 text-[0.72rem] font-bold [color:var(--color-success)] py-[.15rem] px-[.5rem] rounded-full [background:color-mix(in_srgb,var(--color-success)_14%,transparent)]">
              <span class="w-[7px] h-[7px] rounded-full [background:var(--color-success)]"></span>
              {d.adBaselineActive}
            </span>
          </div>
          {/* One clear explanation, in one place only (CURRENT_TASK): the baseline
              is part of the platform-wide campaign across Google/Meta/AI engines
              and guarantees no per-product priority — followed by a single pointer
              to the boost. No duplicate info tooltips or extra notes. */}
          <p class="text-[0.85rem] leading-relaxed m-0 [color:var(--color-text)]">{d.adBaselineLead}</p>
          {/* Clickable CTA — scrolls to the boost form below (initAdvertisingTab
              in advertising.ts). Button (not link): it triggers an in-page scroll,
              not navigation. Underline appears on hover only. */}
          <button type="button" id="ad-boost-jump" class="text-start bg-transparent border-0 p-0 cursor-pointer text-[0.85rem] leading-relaxed mt-2 font-bold [color:var(--color-text)] flex items-center gap-2 group">
            <svg class="shrink-0 [color:var(--color-accent)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
            <span class="group-hover:underline underline-offset-4 decoration-[color:var(--color-accent)]">{d.adBaselineBoostHint}</span>
          </button>
          <p class="m-0 mt-3 pt-3 border-t [border-color:color-mix(in_srgb,var(--color-success)_20%,transparent)] text-[0.82rem]">
            <span class="muted">{d.adBaselineImpressions}:</span>
            <strong id="ad-baseline-impressions" class="ms-1">{adBaselineImpressions.toLocaleString('he-IL')}</strong>
          </p>
        </div>

        <div id="ad-boost-card" class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4 mb-4">
          <div class="flex items-center gap-1 mb-1">
            <h3 class="m-0 text-[0.9rem] font-semibold">{d.adBoostTitle}</h3>
            <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.adBoostWhySep} aria-label={d.adBoostWhySep}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
            </button>
          </div>
          <p class="muted text-[0.82rem] m-0 mb-3">{d.adBoostDesc}</p>

          <form id="ad-create-form" class="flex flex-col gap-3 [&_.field>span]:text-[0.8rem]" data-store-slug={store.slug} data-unsaved-guard>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="field">
                <span>{d.adScopeStore} / {d.adScopeProduct}</span>
                <select id="ad-scope-select" name="scope" class="input">
                  <option value="store">{d.adScopeStore}</option>
                  <option value="product">{d.adScopeProduct}</option>
                </select>
              </label>
              <label class="field" id="ad-product-field" hidden>
                <span>{d.adSelectProduct}</span>
                <select id="ad-product-select" name="productId" class="input">
                  {adEligibleProducts.map((p) => <option value={p.id} data-infer-gender={adProductInferredGender.get(p.id)} data-infer-age={adProductInferredAge.get(p.id)}>{p.name}</option>)}
                </select>
              </label>
              <label class="field">
                <span>{d.adPlatform}</span>
                <select id="ad-platform-select" name="platform" class="input">
                  <option value="both">{d.adPlatformBoth}</option>
                  <option value="google">{d.adPlatformGoogle}</option>
                  <option value="meta">{d.adPlatformMeta}</option>
                </select>
              </label>
              <label class="field">
                <span class="inline-flex items-center">
                  <span id="ad-budget-label">{d.adBudgetMonthlyFieldLabel}</span>
                  <button type="button" class="ms-[5px] inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={adBudgetFeeTipText} aria-label={adBudgetFeeTipText}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
                  </button>
                </span>
                <input type="number" id="ad-budget-input" name="monthlyBudget" class="input" min="50" step="10" value="200" dir="ltr" />
              </label>
              <label class="field">
                <span>{d.adDurationLabel}</span>
                <select id="ad-duration-select" name="durationDays" class="input">
                  <option value="">{d.adDurationOngoing}</option>
                  <option value="7">{d.adDuration7}</option>
                  <option value="14">{d.adDuration14}</option>
                  <option value="30">{d.adDuration30}</option>
                </select>
              </label>
              <p id="ad-budget-mode-note" class="sm:col-span-2 muted text-[0.76rem] m-0 -mt-1">{d.adBudgetMonthlyHint}</p>
              <label class="field" id="ad-gender-field" hidden>
                <span>{d.adAudienceGender}</span>
                <select id="ad-gender-select" name="gender" class="input">
                  <option value="all">{d.adGenderAll}</option>
                  <option value="women">{d.adGenderWomen}</option>
                  <option value="men">{d.adGenderMen}</option>
                </select>
                <small id="ad-infer-note" class="text-[0.72rem] [color:var(--color-success)] mt-1" hidden>{d.adAudienceAutoNote}</small>
              </label>
              <label class="field" id="ad-age-field" hidden>
                <span>{d.adAudienceAge}</span>
                <select id="ad-age-select" name="age" class="input">
                  <option value="all">{d.adAgeAll}</option>
                  <option value="infant">{d.adAgeInfant}</option>
                  <option value="kids">{d.adAgeKids}</option>
                  <option value="adult">{d.adAgeAdult}</option>
                </select>
              </label>
            </div>
            <p id="ad-store-auto-note" class="text-[0.78rem] m-0 [color:var(--color-success)]">{d.adStoreAutoNote}</p>
            <div class="flex justify-end pt-1">
              <button type="submit" class="btn btn--accent gap-1.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                {d.adCreateCampaign}
              </button>
            </div>
          </form>
        </div>

        <div>
          {/* Section header carries the range picker (relocated here from the top
              of the tab, CURRENT_TASK.md item 2) — it windows THESE campaign cards.
              Default "מאז ההשקה" = each campaign's stable lifetime totals (item 3).
              Same trigger + floating-portal component as the Performance picker. */}
          <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
            <h3 class="m-0 text-[0.9rem] font-semibold">{d.adYourCampaigns}</h3>
            <div id="ad-range-picker" data-store-slug={store.slug} data-active-preset="lifetime">
              <button
                type="button"
                id="ad-range-trigger"
                class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span id="ad-range-label">{d.adPresetLifetime}</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          </div>
          <details class="mb-3 border [border-color:var(--color-border)] rounded-[var(--radius)] [background:var(--color-bg)]">
            <summary class="text-[0.82rem] font-medium px-3 py-2 cursor-pointer select-none [color:var(--color-muted)] hover:[color:var(--color-text)]">{d.adGlossaryTitle}</summary>
            <dl class="m-0 px-3 pb-3 pt-1 flex flex-col gap-2 text-[0.8rem]">
              {d.adGlossary.map((g) => (
                <div>
                  <dt class="font-semibold [color:var(--color-text)]">{g.t}</dt>
                  <dd class="m-0 muted">{g.d}</dd>
                </div>
              ))}
            </dl>
          </details>
          <div id="ad-campaigns-list" class="flex flex-col gap-3" data-store-slug={store.slug} data-ssr-loaded={advIsInitial ? '1' : '0'}>
            {!advIsInitial && <div class="skeleton-shimmer" style="height:88px;border-radius:var(--radius)"></div>}
            {advIsInitial && adCampaigns.length === 0 && <p class="muted text-[0.85rem] m-0" id="ad-empty-msg">{d.adNoCampaigns}</p>}
            {adCampaigns.map((c) => (
              <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3" data-campaign-id={c.id} data-status={c.status}>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between mb-2">
                  <div class="flex items-center gap-2 flex-wrap min-w-0">
                    <span class="text-[0.85rem] font-semibold">{c.scope === 'product' ? c.productName : d.adScopeStore}</span>
                    <span class="text-[0.72rem] font-medium [color:var(--color-muted)]">{c.platform === 'google' ? d.adPlatformGoogle : c.platform === 'meta' ? d.adPlatformMeta : d.adPlatformBoth}</span>
                    <span class={`text-[0.68rem] font-bold py-[.1rem] px-[.5rem] rounded-full ${c.status === 'active' ? '[color:var(--color-success)] [background:color-mix(in_srgb,var(--color-success)_14%,transparent)]' : '[color:var(--color-muted)] [background:color-mix(in_srgb,var(--color-muted)_14%,transparent)]'}`}>
                      {c.status === 'active' ? d.adStatusActive : d.adStatusPaused}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <button type="button" class="btn btn--ghost btn--sm" data-ad-action="edit-budget" data-campaign-id={c.id}>{d.adEditBudget}</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-ad-action="toggle" data-campaign-id={c.id}>{c.status === 'active' ? d.adPauseCampaign : d.adResumeCampaign}</button>
                    <button type="button" class="btn btn--ghost btn--sm !text-[color:var(--color-danger)]" data-ad-action="delete" data-campaign-id={c.id}>{d.adDeleteCampaign}</button>
                  </div>
                </div>
                <p class="text-[0.74rem] [color:var(--color-muted)] m-0 mb-2 flex items-center gap-1.5 flex-wrap">
                  <span>{adTargetingLabel(c)}</span>
                  {c.runPeriod && (
                    <Fragment>
                      <span aria-hidden="true">·</span>
                      <span class="inline-flex items-center gap-1">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        {adRunPeriodLabel(c)}
                      </span>
                    </Fragment>
                  )}
                </p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-[0.82rem]">
                  <div data-budget-cell data-budget={c.monthlyBudget}><span class="[color:var(--color-muted)]">{adBudgetLabelFor(c)}</span><br /><strong>{formatPrice(c.monthlyBudget)}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adImpressions}</span><br /><strong>{c.stats.impressions.toLocaleString('he-IL')}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adClicks}</span><br /><strong>{c.stats.clicks.toLocaleString('he-IL')}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adCtr}</span><br /><strong>{c.stats.ctr}%</strong><Fragment set:html={ctrTierChipHtml(c.stats.ctr, { low: d.adTierLow, mid: d.adTierMid, high: d.adTierHigh })} /></div>
                  <div><span class="[color:var(--color-muted)]">{d.adSpend}</span><br /><strong>{formatPrice(c.stats.spend)}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adCpc}</span><br /><strong>{formatPrice(c.stats.cpc)}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adConversions}</span><br /><strong>{c.stats.conversions.toLocaleString('he-IL')}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adRoas}</span><br /><strong>x{c.stats.roas}</strong><Fragment set:html={roasTierChipHtml(c.stats.roas, { low: d.adTierLow, mid: d.adTierMid, high: d.adTierHigh })} /></div>
                </div>
              </div>
            ))}
          </div>
          <p class="muted text-[0.76rem] mt-3">{d.adDemoDataNote}</p>
        </div>
      </div>

      <!-- ── Panel: Messages ── -->
      <div id="dash-panel-messages" class="dash-panel" role="tabpanel" aria-labelledby="tab-messages" hidden={initialPanel !== 'messages'}>
        {showTabHints && <TabHint text={d.tabHintMessages} />}
        {/* Sticky header carrying the search + sort/filter, matching Orders
            (CURRENT_TASK 2 — Messages previously had neither a sticky head nor
            a one-row toolbar on mobile). */}
        <div class="dash-panel-head mb-4 py-[0.6rem] border-b [border-color:var(--color-border)] flex flex-col items-start gap-[0.6rem]">
          <h2 class="m-0 text-base font-semibold">הודעות</h2>
          <div class="dash-toolbar w-full">
            <div class="relative flex-1 min-w-[110px] max-w-[280px]">
              <svg class="absolute top-1/2 -translate-y-1/2 start-[0.7rem] pointer-events-none" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="color:var(--color-muted)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="search" id="msg-search-input" value={sellerMessageQuery.q} placeholder={d.msgSearchPlaceholder ?? 'חיפוש הודעות…'} class="w-full font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] ps-[1.9rem] pe-[.85rem] outline-none transition-colors duration-[120ms] focus:border-[color:var(--color-primary)]" />
            </div>
            <div class="table-toolbar" data-mixed-status={String(showMsgStatusControls)}>
              <button type="button" id="msg-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
                <span id="msg-sort-label" class="toolbar-btn-label">{d.msgSortOptDateDesc}</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <button type="button" id="msg-filter-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="true" aria-expanded="false">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                <span class="toolbar-btn-label">{d.filterByLabel}</span>
                <span id="msg-filter-count" class="filter-count-badge inline-flex items-center justify-center min-w-4 h-4 px-1 rounded-full bg-[color:var(--color-primary)] text-white text-[.68rem] font-bold leading-none" hidden>0</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          </div>
        </div>
        <script type="application/json" id="msg-filter-values-data" set:html={jsonForScript({ product: msgDistinctProducts, from: msgDistinctFrom })} />

          <div class="msg-table-wrap">
            <table class="msg-table">
              <thead>
                <tr>
                  <th class="msg-table__th msg-table__th--status">
                    {showMsgStatusControls && (
                      <div style="display:flex;align-items:center;justify-content:center;gap:0.2rem">
                        <button type="button" class="sort-btn" data-sort-col="unread" aria-label={d.filterColStatus ?? 'סטטוס'}>
                          <svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                        </button>
                        <button type="button" class="combo-filter-btn" data-filter-funnel-col="status" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.filterColStatus ?? 'סטטוס'}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        </button>
                      </div>
                    )}
                  </th>
                  <th class="msg-table__th">
                    <div style="display:flex;align-items:center;gap:0.25rem">
                      שולח
                      <button type="button" class="combo-filter-btn" data-filter-funnel-col="from" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.filterColFrom ?? 'שולח'}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                      </button>
                    </div>
                  </th>
                  <th class="msg-table__th">נושא</th>
                  <th class="msg-table__th">תוכן</th>
                  <th class="msg-table__th">
                    <div style="display:flex;align-items:center;gap:0.25rem">
                      <button type="button" class="sort-btn" data-sort-col="product">{d.filterColProduct ?? 'מוצר'}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                      <button type="button" class="combo-filter-btn" data-filter-funnel-col="product" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.filterColProduct ?? 'מוצר'}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                      </button>
                    </div>
                  </th>
                  <th class="msg-table__th">
                    <button type="button" class="sort-btn" data-sort-col="date">תאריך<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                  </th>
                  <th class="msg-table__th msg-table__th--actions"></th>
                </tr>
              </thead>
              <tbody>
                {messagesPage.items.map((row) => <SellerMessageRow row={row} />)}
              </tbody>
            </table>
          </div>
          <p class="seller-msg-empty" id="msg-filter-empty" hidden={messagesPage.total > 0}>{messageRows.length === 0 ? 'אין הודעות עדיין.' : 'אין הודעות שתואמות לחיפוש/סינון.'}</p>
          <nav id="msg-pagination" class="flex items-center justify-center gap-4 pt-4 pb-1" aria-label="הודעות" data-page={messagesPage.page} data-total-pages={messagesPage.totalPages} hidden></nav>
      </div>

      <!-- ── Panel: Settings ── -->
      <div id="dash-panel-settings" class="dash-panel" role="tabpanel" aria-labelledby="tab-settings" hidden={initialPanel !== 'settings'}>
        {showTabHints && <TabHint text={d.tabHintSettings} />}
        {/* Head stays INSIDE the form on purpose: its sticky scope is the form, so the
            "save changes" bar rides only over the fields it actually saves and releases
            at the form's end — the categories tree + custom-domain below save live per
            action (own APIs), so the button must not appear to govern them. */}
        <form method="POST" action="/api/store" class="mt-4" id="settings-form" style="margin-top:0" data-unsaved-guard>
          <input type="hidden" name="_action" value="save-settings" />
          <input type="hidden" name="storeId" value={store.id} />

          <div class="dash-panel-head mb-5 py-[0.6rem] border-b border-[color:var(--color-border)] flex items-center justify-between gap-3 flex-wrap">
            <h2 class="text-[color:var(--color-text)] m-0">{d.tabSettings}</h2>
            <div class="flex items-center gap-3">
              <button class="btn btn--sm" type="submit" form="settings-form" id="settings-save-btn">{d.saveChanges}</button>
            </div>
          </div>

          <div class="field">
            <span>{d.storeBanner}</span>
            <p class="muted" style="margin:0.15rem 0 0.6rem;font-size:0.8rem">{d.storeBannerHint}</p>
            <div
              id="banner-frame"
              class="w-full max-w-[420px] overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)]"
              style="aspect-ratio:3/1"
            >
              {store.bannerImage && (
                <img src={cdnSrc(store.bannerImage, 900)} alt="" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" />
              )}
            </div>
            <div class="flex gap-2" style="margin-top:1.1rem">
              <button type="button" class="btn btn--sm btn--ghost" id="banner-upload-btn">{store.bannerImage ? d.storeImageChange : d.uploadImage}</button>
              <button type="button" class="btn btn--sm btn--ghost" id="banner-remove-btn" hidden={!store.bannerImage}>{d.removeImage}</button>
            </div>
            <input type="file" accept="image/*" id="banner-file-input" hidden />
            <input type="hidden" name="bannerImage" id="banner-image-input" value={store.bannerImage ?? ''} />
          </div>

          <div class="field">
            <span>{d.storeProfileImage}</span>
            <p class="muted" style="margin:0.15rem 0 0.6rem;font-size:0.8rem">{d.storeProfileImageHint}</p>
            <!-- The store's generated mark sits UNDER the frame as a background, not as a
                 child: the upload widget owns this element's innerHTML (store-image.ts), so
                 the seller sees exactly the colour buyers and ad platforms get while the
                 slot is empty — including right after "remove image". -->
            <div
              id="avatar-frame"
              class="h-20 w-20 overflow-hidden rounded-full border border-[var(--color-border)]"
              style={`background:${storeMarkGradient(storeMark(store.slug, store.name))}`}
            >
              {store.profileImage && (
                <img src={cdnSrc(store.profileImage, 200)} alt="" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" />
              )}
            </div>
            <div class="flex gap-2" style="margin-top:1.1rem">
              <button type="button" class="btn btn--sm btn--ghost" id="avatar-upload-btn">{store.profileImage ? d.storeImageChange : d.uploadImage}</button>
              <button type="button" class="btn btn--sm btn--ghost" id="avatar-remove-btn" hidden={!store.profileImage}>{d.removeImage}</button>
            </div>
            <input type="file" accept="image/*" id="avatar-file-input" hidden />
            <input type="hidden" name="profileImage" id="avatar-image-input" value={store.profileImage ?? ''} />
          </div>

          <label class="field">
            <span>{d.storeName}</span>
            <input class="input" name="name" value={store.name} required />
          </label>

          <label class="field">
            <span>{d.tagline}</span>
            <input
              class="input"
              name="tagline"
              value={store.tagline}
              placeholder={d.descPlaceholder}
            />
          </label>

          <label class="field">
            <span>{d.description}</span>
            <textarea class="input" name="description" rows="3">{store.description}</textarea>
          </label>

          <div class="field">
            <span>{d.storeCategories}</span>
            <StoreCategoryPicker vocabulary={categoryVocabulary} selected={store.categories ?? []} id="settings-store-cats" />
          </div>

          <div class="field">
            <label class="inline-flex items-center gap-[.55rem] font-semibold text-[.9rem] cursor-pointer">
              <input type="checkbox" name="addressVisible" id="address-visible-toggle" checked={!!store.addressVisible} />
              <span>{d.showStoreAddress}</span>
            </label>
          </div>

          <div id="store-address-field" class="mt-[.9rem] ps-4 border-s-2 border-[color:var(--color-border)] transition-opacity duration-150 data-[open=false]:opacity-55" data-open={String(!!store.addressVisible)}>
            <label class="field">
              <span>{d.storeAddress}</span>
              <input class="input" name="address" value={store.address ?? ''} placeholder={d.storeAddressPlaceholder} />
            </label>
          </div>

          <div class="field">
            <label class="inline-flex items-center gap-[.55rem] font-semibold text-[.9rem] cursor-pointer">
              <input type="checkbox" name="selfPickup" id="self-pickup-toggle" checked={!!store.shipping?.selfPickup} />
              <span>{d.offerSelfPickup}</span>
            </label>
            <p class="[color:var(--color-muted)] mt-[.35rem] text-[.8rem]">{d.offerSelfPickupHint}</p>
          </div>

          <div class="field">
            <label class="inline-flex items-center gap-[.55rem] font-semibold text-[.9rem] cursor-pointer">
              <input type="checkbox" name="hoursVisible" id="hours-visible-toggle" checked={!!store.hoursVisible} />
              <span>{d.showStoreHours}</span>
            </label>
          </div>

          <div id="store-hours-field" class="mt-[.9rem] ps-4 border-s-2 border-[color:var(--color-border)] transition-opacity duration-150 data-[open=false]:opacity-55" data-open={String(!!store.hoursVisible)}>
            <div class="field">
              <span>{d.storeHours}</span>
              <div id="hours-editor" class="hours-editor flex flex-col gap-2">
                {STORE_WEEKDAYS.map((day) => {
                  const dh = (store.hours ?? DEFAULT_STORE_HOURS)[day];
                  return (
                    <div class="hours-row flex items-center gap-[.6rem] flex-wrap" data-day={day}>
                      <span class="min-w-[3.2rem] text-[.85rem] font-semibold text-[color:var(--color-text)] shrink-0">{d.storeHoursDay[day]}</span>
                      <input class="input hours-time w-auto max-w-[8.5rem] py-[.4rem] px-[.6rem] disabled:opacity-45" type="time" name={`hours_${day}_open`} value={dh.open} disabled={dh.closed} />
                      <span class="text-[color:var(--color-muted)] shrink-0">–</span>
                      <input class="input hours-time w-auto max-w-[8.5rem] py-[.4rem] px-[.6rem] disabled:opacity-45" type="time" name={`hours_${day}_close`} value={dh.close} disabled={dh.closed} />
                      <label class="inline-flex items-center gap-[.35rem] ms-auto max-[480px]:ms-0 text-[.8rem] text-[color:var(--color-muted)] cursor-pointer whitespace-nowrap">
                        <input type="checkbox" class="hours-closed-toggle" name={`hours_${day}_closed`} checked={dh.closed} />
                        {d.storeHoursClosed}
                      </label>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>

        </form>

        <div class="mt-8 mb-5 pb-[.875rem] border-b border-[color:var(--color-border)] flex items-center justify-between gap-3 flex-wrap">
          <h2 class="text-base font-semibold text-[color:var(--color-text)] m-0">{d.categoriesTitle}</h2>
          <span class="inline-flex items-center gap-1 text-[0.7rem] font-medium text-[color:var(--color-muted)] bg-[color:var(--color-bg)] border border-[color:var(--color-border)] rounded-full py-[0.15rem] px-[0.5rem]">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {d.settingsAutoSaved}
          </span>
        </div>
        <p class="muted" style="margin:0 0 1rem;font-size:0.85rem">{d.categoriesHint}</p>

        {store && (
          <div id="category-tree-editor" class="category-tree-editor flex flex-col gap-3" data-store-id={store.id}>
            <div id="category-tree-list" class="category-tree-list"></div>
            <form id="add-root-category-form" class="category-add-form flex gap-2 max-w-[24rem]">
              <input type="text" class="input flex-1" id="add-root-category-input" placeholder={d.categoryNamePlaceholder} maxlength="40" style="padding-block:0.4rem" />
              <button type="submit" class="btn btn--sm btn--ghost" style="gap:0.3rem">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                {d.addRootCategory}
              </button>
            </form>
          </div>
        )}
        <script type="application/json" id="category-tree-data" set:html={jsonForScript(categoryTree)} />

        {store && (
        <div id="store-url" class="mt-8" data-store-id={store.id} data-host={new URL(platformConfig.url).hostname} data-current-slug={store.slug}>
          <!-- Settings carries TWO "addresses" — the physical one in the store-details
               form above and this web one. They used to share the literal same Hebrew
               label ("כתובת החנות"); now they're named apart (כתובת פיזית / כתובת האתר)
               and this subtitle spells the split out once, where the confusion lands. -->
          <div class="mb-4 pb-[.875rem] border-b border-[color:var(--color-border)]">
            <h2 class="text-base font-semibold text-[color:var(--color-text)] m-0">{d.storeUrlTitle}</h2>
            <p class="muted text-[0.8rem] leading-[1.5] mt-1 mb-0">{d.storeUrlSubtitle}</p>
          </div>
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <code id="store-url-current" class="font-mono text-[0.85rem] [color:var(--color-text)]">{`${new URL(platformConfig.url).hostname}/${store.slug}`}</code>
            <button type="button" id="store-url-edit" class="btn btn--ghost btn--sm">{d.edit}</button>
          </div>
          <p class="muted text-[0.8rem] leading-[1.5]">{d.storeUrlEditHint}</p>

          <div id="store-url-editor" hidden class="flex flex-col gap-2 mt-3 max-w-[30rem]">
            <input id="store-url-input" class="input" dir="ltr" autocomplete="off" spellcheck="false" value={store.slug} />
            <p class="muted text-[0.78rem]" dir="ltr" style="text-align:start"><span id="store-url-preview" class="font-mono [color:var(--color-text)]">{`${new URL(platformConfig.url).hostname}/${store.slug}`}</span></p>
            <div class="flex gap-2">
              <button type="button" id="store-url-save" class="btn btn--sm">{d.save}</button>
              <button type="button" id="store-url-cancel" class="btn btn--ghost btn--sm">{d.cancel}</button>
            </div>
            <p id="store-url-msg" role="status" aria-live="polite" hidden class="text-[0.82rem] mt-1 py-2 px-[.85rem] rounded-[var(--radius)]"></p>
          </div>
        </div>
        )}

        {store && (() => {
          const cd = store.customDomain;
          const cdTarget = cnameTarget();
          const cdActive = cd?.status === 'active';
          return (
        <div id="custom-domain" class="mt-8" data-store-id={store.id} data-store-slug={store.slug} data-platform-url={platformConfig.url} data-cname-target={cdTarget} data-cd-status={cd?.status ?? ''}>
          <div class="mb-4 pb-[.875rem] border-b border-[color:var(--color-border)] flex items-center justify-between gap-3 flex-wrap">
            <h2 class="text-base font-semibold text-[color:var(--color-text)] m-0">{d.cdTitle}</h2>
            <span class="inline-flex items-center gap-1 text-[0.7rem] font-medium text-[color:var(--color-muted)] bg-[color:var(--color-bg)] border border-[color:var(--color-border)] rounded-full py-[0.15rem] px-[0.5rem]">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {d.settingsAutoSaved}
            </span>
          </div>
          <p class="muted text-[0.85rem] leading-[1.6] mb-3" set:html={d.cdLead}></p>

          {/* The always-live local address — the point of the whole feature: a custom domain never replaces it. */}
          <div class="flex flex-col gap-1 mb-4 text-[0.82rem]">
            <span class="muted">{d.cdLocalLabel}</span>
            <code id="cd-local-addr" class="font-mono text-[0.8rem] [color:var(--color-text)] bg-[color:var(--color-bg)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] py-[.35rem] px-[.6rem] w-fit max-w-full overflow-hidden text-ellipsis whitespace-nowrap">{`${platformConfig.url}/${store.slug}`}</code>
          </div>

          {/* State A — no domain connected yet */}
          <div id="cd-setup" hidden={!!cd} class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center max-w-[30rem]">
            <input type="text" id="cd-input" inputmode="url" autocomplete="off" spellcheck="false" placeholder={d.cdInputPlaceholder}
              class="flex-1 min-w-0 font-mono text-[.8rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] py-[.5rem] px-[.6rem] outline-none focus:[border-color:var(--color-accent)]" />
            <button type="button" class="btn btn--sm shrink-0" id="cd-connect">{d.cdConnect}</button>
          </div>

          {/* State B/C — a domain exists (pending or active) */}
          <div id="cd-connected" hidden={!cd} class="flex flex-col gap-3">
            <div class="flex items-center gap-2 flex-wrap">
              <code id="cd-hostname" class="font-mono text-[0.85rem] font-semibold [color:var(--color-text)]">{cd?.hostname ?? ''}</code>
              <span id="cd-badge" class={`inline-flex items-center gap-[.35rem] text-[0.75rem] font-semibold py-[.2rem] px-[.55rem] rounded-full ${cdActive ? 'bg-[#f0fdf4] text-[#166534]' : 'bg-[#fffbeb] text-[#92400e]'}`}>
                <span class={`w-[7px] h-[7px] rounded-full ${cdActive ? 'bg-[#16a34a]' : 'bg-[#d97706]'}`}></span>
                <span id="cd-badge-text">{cdActive ? d.cdStatusActive : d.cdStatusPending}</span>
              </span>
            </div>

            {/* When verified: the custom domain is now the store's primary public address. */}
            <div id="cd-primary" hidden={!cdActive} class="flex items-start gap-2 text-[0.82rem] leading-[1.5] bg-[#f0fdf4] border border-[#bbf7d0] rounded-[var(--radius)] py-2 px-3">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[0.1rem]" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="[color:#166534]">{d.cdPrimaryNote} <code id="cd-primary-host" class="font-mono font-semibold">{cd?.hostname ?? ''}</code></span>
            </div>

            {/* DNS instructions — meaningful until verified; kept visible so a seller can re-check the record. */}
            <div id="cd-dns" hidden={cdActive}>
              <p class="muted text-[0.82rem] leading-[1.5] mb-2">{d.cdDnsHint}</p>
              <div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-[.4rem] items-center text-[0.8rem] max-w-[34rem]">
                <span class="muted">{d.cdDnsType}</span>
                <code class="font-mono [color:var(--color-text)]">CNAME</code>
                <span class="muted">{d.cdDnsName}</span>
                <code class="font-mono [color:var(--color-text)] overflow-hidden text-ellipsis whitespace-nowrap">{cd?.hostname ?? ''}</code>
                <span class="muted">{d.cdDnsValue}</span>
                <span class="flex items-center gap-2 min-w-0">
                  <code id="cd-cname-value" class="font-mono [color:var(--color-text)] bg-[color:var(--color-bg)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] py-[.3rem] px-[.5rem] overflow-hidden text-ellipsis whitespace-nowrap">{cdTarget}</code>
                  <button type="button" class="btn btn--ghost btn--sm shrink-0" id="cd-copy" aria-label={d.cdCopy}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                </span>
              </div>
              <p class="muted text-[0.78rem] leading-[1.5] mt-2">{d.cdPendingNote}</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <a id="cd-visit" href={cd ? `https://${cd.hostname}` : '#'} target="_blank" rel="noopener" hidden={!cdActive} class="btn btn--ghost btn--sm">{d.cdVisit}</a>
              <button type="button" class="btn btn--ghost btn--sm" id="cd-check" hidden={cdActive}>{d.cdCheck}</button>
              <button type="button" class="btn btn--ghost btn--sm !text-[color:var(--color-danger)]" id="cd-remove">{d.cdRemove}</button>
            </div>
            <p class="muted text-[0.78rem] leading-[1.5]">{d.cdCanonicalNote}</p>
          </div>

          <p id="cd-msg" role="status" aria-live="polite" hidden class="text-[0.82rem] mt-3 py-2 px-[.85rem] rounded-[var(--radius)]"></p>
        </div>
          );
        })()}
      </div>

    </div>
  </section>
  </Fragment>
  ) : null}
</BaseLayout>

<style is:global>
  /* ── Orders panel: shared card/toolbar chrome (.orders-panel-head,
     .orders-toolbar, .orders-list, .order-card*, .order-new-dot, the
     #dash-main-card hover-suppression) moved to dashboard.css (2026-07-14) so
     the admin dashboard's orders tab can reuse the exact same classes without
     duplicating CSS — Astro component-local <style> only ships on pages that
     render this component, so admin/index.astro (which never imports
     dashboard.astro) couldn't see rules defined here. ── */

  /* ── Order status custom dropdown ── */
  .order-status-dropdown { position: relative; }
  .order-status-trigger {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: 9999px; cursor: pointer;
    font-family: inherit; font-size: 0.83rem; font-weight: 500;
    color: var(--color-text); white-space: nowrap;
    transition: border-color 0.12s;
  }
  .order-status-trigger:hover { border-color: var(--color-muted); }
  .order-status-trigger[aria-expanded="true"] { border-color: var(--color-accent); }
  .order-status-chevron {
    flex-shrink: 0; color: var(--color-muted);
    transition: transform 150ms cubic-bezier(0.34,1.56,0.64,1);
  }
  .order-status-trigger[aria-expanded="true"] .order-status-chevron { transform: rotate(180deg); }

  /* Option list itself now lives in the shared floating portal
     (#order-status-portal, .product-menu__item — see products.css) so it's
     never clipped by the bottom of the viewport; only the small color dot
     class is still needed here (also reused inside the portal's HTML). */
  .order-status-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  }

  /* ── Edit order modal centering ── */
  #edit-order-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    max-height: 90vh;
    overflow: visible;
  }
  #edit-order-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  /* ── Edit-order item rows ── */
  .eom-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: opacity 0.15s;
  }
  .eom-item:last-child { border-bottom: none; }
  .eom-item--deleted { opacity: 0.4; }
  .eom-item--deleted .eom-item__name { text-decoration: line-through; }
  .eom-item__img {
    width: 34px; height: 34px; object-fit: cover;
    border-radius: var(--radius-sm); flex-shrink: 0;
    border: 1px solid var(--color-border);
  }
  .eom-item__img-ph {
    width: 34px; height: 34px; border-radius: var(--radius-sm); flex-shrink: 0;
    background: var(--color-bg); border: 1px solid var(--color-border);
  }
  .eom-item__name { flex: 1; font-size: 0.82rem; font-weight: 500; color: var(--color-text); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eom-item__meta { font-size: 0.78rem; color: var(--color-muted); flex-shrink: 0; white-space: nowrap; }
  .eom-item__del {
    width: 24px; height: 24px; border-radius: var(--radius-sm); flex-shrink: 0;
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-muted); cursor: pointer; display: flex;
    align-items: center; justify-content: center;
    transition: background 0.1s, color 0.1s, border-color 0.1s;
  }
  .eom-item__del:hover { background: #fee2e2; color: #dc2626; border-color: #fca5a5; }
  .eom-item--deleted .eom-item__del { background: var(--color-bg); color: var(--color-accent); border-color: var(--color-accent); }

  /* Discount type toggle */
  .eom-dtype-btn { background: var(--color-surface); color: var(--color-muted); }
  .eom-dtype-btn--active { background: var(--color-text); color: var(--color-surface); }

  /* A seller-hidden product stays fully interactive (so it can be un-hidden)
     but its thumbnail + name read dimmed, signalling "off the shelf" at a glance
     alongside the "מוסתר" chip. */
  .is-product-hidden .product-thumb,
  .is-product-hidden .product-name { opacity: 0.5; }

  /* The visibility menu item shows the "hide" icon+label for a visible product
     and the "show" icon for a hidden one — driven purely off the button's own
     data-hidden so a toggle only has to flip that one attribute (no per-icon JS,
     works identically for SSR and AJAX-built rows). */
  .product-menu__item--visibility .menu-icon-show { display: none; }
  .product-menu__item--visibility[data-hidden="1"] .menu-icon-hide { display: none; }
  .product-menu__item--visibility[data-hidden="1"] .menu-icon-show { display: inline; }

  .dash-tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ef4444;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    min-width: 16px;
    height: 16px;
    border-radius: 20px;
    padding: 0 4px;
    margin-inline-start: 4px;
    vertical-align: middle;
  }

  /* ── Store-switcher alert dots ── */
  .store-switcher__alert-dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: #ef4444;
    border-radius: 50%;
    flex-shrink: 0;
    margin-inline-start: 0.15rem;
    align-self: center;
  }
  .store-switcher__item-dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: #ef4444;
    border-radius: 50%;
    flex-shrink: 0;
  }

</style>

