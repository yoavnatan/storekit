---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getStoresBySellerId, createStore, updateStore } from '../../lib/stores.js';
import {
  getProductsByStoreId,
  createProduct,
  updateProduct,
  deleteProduct,
} from '../../lib/store-products.js';
import { formatPrice } from '../../config/store.config.js';
import { galleryWidgetHtml } from '../../lib/gallery-widget.js';
import { getLang, getT } from '../../i18n/index.js';
import { getAllWishlistCounts } from '../../lib/wishlist-counts.js';
import { getFavoriteStoreCount } from '../../lib/store-favorite-counts.js';
import { thumbUrl } from '../../lib/cloudinary.js';
import { getMessagesBySeller, getMessageReplies } from '../../lib/messages.js';
import { getOrdersByStoreSlug } from '../../lib/orders.js';
import type { Order } from '../../lib/orders.js';
import { getSellerStoreAlerts } from '../../lib/seller-alerts.js';

const lang = getLang(Astro.cookies);
const t    = getT(lang);
const d    = t.dashboard;
const g    = t.gallery;

const sellerId = getSellerSession(Astro.cookies);
if (!sellerId) return Astro.redirect('/seller/login');

const cloudinaryCloud = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? '';
const cloudinaryPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET ?? '';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'save-settings');

  if (action === 'save-settings') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    if (!name) {
      error = d.storeNameRequired;
    } else {
      const stores = getStoresBySellerId(sellerId);
      const target = stores.find((s) => s.id === storeId) ?? stores[0];
      if (target) {
        updateStore(target.id, { name, tagline, description, colors: target.colors });
        return Astro.redirect(`/seller/dashboard?store=${target.id}&saved=1`);
      }
    }
  } else if (action === 'create-store') {
    const name = String(form.get('name') || '').trim();
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    if (!name) {
      error = d.storeNameRequired;
    } else {
      const { id: newStoreId } = createStore(sellerId, { name, tagline, description });
      return Astro.redirect(`/seller/dashboard?store=${newStoreId}`);
    }
  } else if (action === 'add-product') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else {
      createProduct(storeId, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      return Astro.redirect(`/seller/dashboard?store=${storeId}&added=1`);
    }
  } else if (action === 'edit-product') {
    const productId = String(form.get('productId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else {
      updateProduct(productId, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      const sid = Astro.url.searchParams.get('store') ?? '';
      return Astro.redirect(sid ? `/seller/dashboard?store=${sid}` : '/seller/dashboard');
    }
  } else if (action === 'delete-product') {
    const productId = String(form.get('productId') || '');
    const sid = String(form.get('storeId') || '');
    deleteProduct(productId);
    return Astro.redirect(sid ? `/seller/dashboard?store=${sid}` : '/seller/dashboard');
  }
}

const allStores = getStoresBySellerId(sellerId);
const hasNoStore = allStores.length === 0;

const activeStoreId = hasNoStore ? '' : (Astro.url.searchParams.get('store') ?? '');
const store = hasNoStore ? undefined : (allStores.find((s) => s.id === activeStoreId) ?? allStores[0]);
const settingsSuccess = !hasNoStore && Astro.url.searchParams.get('saved') === '1';
const productSuccess = !hasNoStore && Astro.url.searchParams.get('added') === '1';
const products = store ? getProductsByStoreId(store.id) : [];
const wishlistCounts = store ? getAllWishlistCounts() : ({} as Record<string, number>);
const storeFavoriteCount = store ? getFavoriteStoreCount(store.slug) : 0;
const productCount = products.length;
const inStockCount = products.filter((p) => p.stock > 0).length;
const totalStockValue = products.reduce((sum, p) => sum + p.price * p.stock, 0);
const initialPanel = Astro.url.searchParams.get('panel') ?? 'products';
const storeMessages = store
  ? getMessagesBySeller(sellerId)
      .filter((m) => !m.replyToId)
      .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  : [];
const messageReplies: Record<string, ReturnType<typeof getMessageReplies>> =
  Object.fromEntries(storeMessages.map((m) => [m.id, getMessageReplies(m.id)]));
// Replies carry no readable "unread" signal at the root level — a thread the
// seller already read can still have an unread follow-up reply from the
// buyer, so the tab dot must check those too, not just the root message.
const unreadMessagesCount = storeMessages.filter((m) =>
  !m.readBySeller || messageReplies[m.id]!.some((r) => r.toSellerId === sellerId && !r.readBySeller)
).length;
const storeOrders: Order[] = store ? getOrdersByStoreSlug(store.slug) : [];
const newOrdersCount = storeOrders.filter((o) => o.shippingStatus === 'pending').length;

// Alerts per store for store-switcher dots (pending orders or unread messages)
const storeAlerts: Record<string, boolean> = allStores.length > 1 ? getSellerStoreAlerts(sellerId) : {};
// The header dot should point the seller TO the alert — so it only fires when
// a store OTHER than the one currently open has something unhandled. If the
// seller is already looking at the store with the alert, they can already
// see it there (tab badge / order dot), so the header dot would be redundant.
const hasAnyNonCurrentAlert = store
  ? Object.entries(storeAlerts).some(([id, v]) => v && id !== store.id)
  : false;

const orderShippingLabels: Record<string, string> = {
  pending: d.shippingPending,
  processing: d.shippingProcessing,
  ready: d.shippingReady,
  shipped: d.shippingShipped,
  delivered: d.shippingDelivered,
};

const orderStatusColors: Record<string, string> = {
  pending: '#ef4444',
  processing: '#3b82f6',
  ready: '#f59e0b',
  shipped: '#8b5cf6',
  delivered: '#16a34a',
};

---

<BaseLayout title={hasNoStore ? d.noStoreTitle : d.title} noindex={true} isLoggedIn={true} hasStore={!hasNoStore} sellerMode={true}>
  {hasNoStore ? (
    <section class="section container">
      <div class="card" style="max-width:520px;margin:2rem auto;padding:2.5rem 2rem;text-align:center">
        {error && <p class="dash-error" style="margin-bottom:1.5rem;text-align:start">{error}</p>}
        <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-accent);margin:0 auto 1.25rem;display:block" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <h1 style="font-size:1.5rem;margin:0 0 0.5rem">{d.noStoreTitle}</h1>
        <p class="muted" style="margin-bottom:2rem">{d.noStoreDesc}</p>
        <form method="POST" class="dash-form" style="text-align:start">
          <input type="hidden" name="_action" value="create-store" />
          <label class="field">
            <span>{d.storeNameReq}</span>
            <input class="input" name="name" required placeholder={d.storeNamePlaceholder} autofocus />
          </label>
          <button class="btn btn--accent" type="submit" style="width:100%;margin-top:0.25rem">{d.createStoreBtn}</button>
        </form>
      </div>
    </section>
  ) : store ? (
  <Fragment>
  <div id="upload-config" data-cloud={cloudinaryCloud} data-preset={cloudinaryPreset} data-store-slug={store.slug} data-store-name={store.name} data-seller-id={sellerId} hidden></div>
  <section class="section container dash-section">
    <div id="dash-main-card" class="card" style="margin-bottom:1.5rem">

      <!-- ── Store header ── -->
      <div class="dash-head">
        <div class="dash-head__top">
          {allStores.length === 1 ? (
            <h1 class="dash-store-name">{store.name}</h1>
          ) : (
            <div class="store-switcher" id="store-switcher">
              <button
                class="store-switcher__btn"
                id="store-switcher-btn"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label={lang === 'he' ? 'החלף חנות' : 'Switch store'}
              >
                <span class="dash-store-name">{store.name}</span>
                <svg class="store-switcher__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
                {hasAnyNonCurrentAlert && (
                  <span class="store-switcher__alert-dot" aria-label="יש התראות בחנויות אחרות"></span>
                )}
              </button>
              <ul class="store-switcher__menu" id="store-switcher-menu" role="listbox" hidden>
                {allStores.map((s) => (
                  <li>
                    <a
                      href={`/seller/dashboard?store=${s.id}`}
                      role="option"
                      aria-selected={s.id === store.id}
                      class={s.id === store.id ? 'store-option--current' : ''}
                    >
                      <span>{s.name}</span>
                      <span class="store-switcher__item-actions" style="display:flex;align-items:center;gap:0.35rem;flex-shrink:0">
                        {storeAlerts[s.id] && (
                          <span class="store-switcher__item-dot" aria-label="יש התראות"></span>
                        )}
                        {s.id === store.id && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <a href={`/store/${store.slug}`} class="btn btn--sm" target="_blank" rel="noopener">
            {d.viewLive}
          </a>
        </div>
        <p class="muted" style="margin:0.25rem 0 0;font-size:0.82rem">{d.storeSubtitle} · <code style="font-size:0.78rem">/store/{store.slug}</code></p>

        {settingsSuccess && <p class="dash-success" style="margin-top:1rem;margin-bottom:0">{d.settingsSaved}</p>}
        {productSuccess && <p class="dash-success" style="margin-top:1rem;margin-bottom:0">{d.productAdded}</p>}
        {error && <p class="dash-error" style="margin-top:1rem;margin-bottom:0">{error}</p>}
      </div>

      <!-- ── Section tabs ── -->
      <div class="dash-tabs" role="tablist">
        <button
          class={`dash-tab${initialPanel === 'products' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-products"
          data-panel="products"
          aria-selected={initialPanel === 'products'}
          tabindex={initialPanel === 'products' ? 0 : -1}
        >{d.tabProducts}</button>
        <button
          class={`dash-tab${initialPanel === 'orders' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-orders"
          data-panel="orders"
          aria-selected={initialPanel === 'orders'}
          tabindex={initialPanel === 'orders' ? 0 : -1}
          style="position:relative"
        >
          {d.tabOrders}
          {newOrdersCount > 0 && (
            <span class="dash-tab-badge" aria-label={`${newOrdersCount} הזמנות חדשות`}>{newOrdersCount}</span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'messages' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-messages"
          data-panel="messages"
          aria-selected={initialPanel === 'messages'}
          tabindex={initialPanel === 'messages' ? 0 : -1}
          style="position:relative"
        >
          הודעות
          {unreadMessagesCount > 0 && (
            <span style="position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:#ef4444;border-radius:50%" aria-label={`${unreadMessagesCount} הודעות שלא נקראו`}></span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'settings' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-settings"
          data-panel="settings"
          aria-selected={initialPanel === 'settings'}
          tabindex={initialPanel === 'settings' ? 0 : -1}
        >{d.tabSettings}</button>
      </div>

      <!-- ── Panel: Store data + Products ── -->
      <div id="dash-panel-products" class="dash-panel" role="tabpanel" aria-labelledby="tab-products" hidden={initialPanel !== 'products'}>

        <!-- Quick overview row -->
        <div class="dash-overview-row">
          <dl class="dash-stats">
            <div>
              <dt>{d.products}</dt>
              <dd>{productCount}</dd>
            </div>
            <div>
              <dt>{d.inStock}</dt>
              <dd>{inStockCount}</dd>
            </div>
            <div>
              <dt>{d.stockValue}</dt>
              <dd>{formatPrice(totalStockValue)}</dd>
            </div>
            <div>
              <dt>{d.favoritedBy}</dt>
              <dd>{storeFavoriteCount}</dd>
            </div>
          </dl>
        </div>

        <!-- Products section -->
        <div style="border-top:1px solid var(--color-border);padding-top:1.25rem">
          <div class="products-header">
            <div class="products-header__title">
              <input type="checkbox" id="bulk-select-all" class="bulk-select-all" aria-label={d.bulkSelectAll} style="cursor:pointer;width:15px;height:15px;flex-shrink:0">
              <span class="bulk-count-paren" id="bulk-count-paren" aria-hidden="true"></span>
              <h2>{d.productsTitle}</h2>
              <span class="bulk-count-badge" id="bulk-count-badge" hidden>
                <strong id="bulk-count">0</strong> {d.bulkSelected}
              </span>
            </div>
            <div class="products-header__actions">
              <button id="bulk-edit-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkEdit}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span id="bulk-edit-label" class="bulk-btn__label" aria-hidden="true">{d.bulkEdit}</span>
              </button>
              <button id="bulk-upload-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkUploadImages}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.bulkUploadImages}</span>
              </button>
              <button id="bulk-delete-btn" type="button" class="btn btn--sm btn--danger bulk-btn" hidden aria-label={d.bulkDelete}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.bulkDelete}</span>
              </button>
              <span class="products-header__sep" id="bulk-sep" aria-hidden="true" hidden></span>
              <button class="btn btn--sm add-product-btn" id="toggle-add-form" aria-label={d.addProduct}>
                <span class="add-product-btn__icon" aria-hidden="true">+</span>
                <span class="add-product-btn__label" aria-hidden="true">{d.addProduct}</span>
              </button>
            </div>
          </div>

          <div id="add-product-form" class="add-form" hidden>
            <h3>{d.newProduct}</h3>
            <form method="POST" class="dash-form">
              <input type="hidden" name="_action" value="add-product" />
              <input type="hidden" name="storeId" value={store.id} />

              <div class="field-row">
                <label class="field">
                  <span>{d.nameReq}</span>
                  <input class="input" name="name" required placeholder={d.namePlaceholder} />
                </label>
                <label class="field">
                  <span>{d.priceLabel}</span>
                  <input
                    class="input"
                    name="price"
                    type="number"
                    min="0"
                    step="0.01"
                    placeholder="0.00"
                  />
                </label>
                <label class="field">
                  <span>{d.colStock}</span>
                  <input class="input" name="stock" type="number" min="0" step="1" placeholder="0" />
                </label>
              </div>

              <label class="field">
                <span>{d.descLabel}</span>
                <textarea
                  class="input"
                  name="description"
                  rows="2"
                  placeholder={d.descPlaceholderProduct}></textarea>
              </label>

              <label class="field">
                <span>{d.categoryLabel}</span>
                <input class="input" name="category" placeholder={d.categoryPlaceholder} list="store-categories-list" />
              </label>

              <label class="field">
                <span>{d.tagsLabel}</span>
                <input class="input" name="tags" placeholder={d.tagsPlaceholder} />
              </label>

              <div class="field">
                <span class="field-label">{d.variantsLabel}</span>
                <div class="variants-list"></div>
                <button type="button" class="variants-add-btn btn btn--ghost btn--sm" style="margin-top:0.5rem">{d.variantAddBtn}</button>
              </div>

              <div class="field">
                <span class="field-label">{d.specsLabel}</span>
                <div class="specs-rows"
                     data-label-placeholder={d.specsLabelPlaceholder}
                     data-value-placeholder={d.specsValuePlaceholder}></div>
                <button type="button" class="btn btn--ghost btn--sm specs-add-row" style="margin-top:0.5rem">{d.specsAddRow}</button>
              </div>

              <div class="field">
                <span class="field-label">{d.productImages}</span>
                <div set:html={galleryWidgetHtml([], g)}></div>
              </div>

              <div class="form-actions">
                <button class="btn" type="submit">{d.addProductBtn}</button>
                <button class="btn btn--ghost" type="button" id="cancel-add">{d.cancel}</button>
              </div>
            </form>
          </div>

          <p id="empty-products" class="empty-products" hidden={products.length > 0}>{d.noProducts}</p>

          {/* Bulk image upload panel */}
          <div id="bulk-upload-panel" class="bulk-upload-panel" hidden></div>

          {/* Category filter bar — rendered by JS when products have categories */}
          <div class="cat-filter-bar" id="cat-filter-bar" hidden></div>

          <table id="products-table" class="products-table" hidden={products.length === 0}>
            <thead>
              <tr>
                <th class="check-col" aria-hidden="true"></th>
                <th class="num row-num" style="width:2rem">#</th>
                <th class="thumb-col"></th>
                <th>
                  <button type="button" class="sort-btn" data-sort-col="name">{d.colName}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="cat-col">
                  <button type="button" class="sort-btn" data-sort-col="category">{d.categoryLabel}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th>
                  <button type="button" class="sort-btn" data-sort-col="price">{d.colPrice}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th>
                  <button type="button" class="sort-btn" data-sort-col="stock">{d.colStock}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="num wishlist-col">
                  <button type="button" class="sort-btn" data-sort-col="wishlist">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    <svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                  </button>
                </th>
                <th class="date-col">
                  <button type="button" class="sort-btn" data-sort-col="createdAt">{d.colDateAdded}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th />
              </tr>
            </thead>
            <tbody id="products-tbody">
              {products.map((p, idx) => {
                const fmtDateAdded = (iso: string) => new Date(iso).toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit' });
                return (
                <>
                  <tr data-product-display={p.id} data-store-id={store.id} data-images={JSON.stringify(p.images ?? [])} data-sort-name={p.name.toLowerCase()} data-sort-price={String(p.price)} data-sort-stock={String(p.stock)} data-sort-wishlist={String(wishlistCounts[p.slug] ?? 0)} data-sort-created-at={p.createdAt} data-category={p.category ?? ''} data-product-slug={p.slug} data-store-slug={store.slug} data-store-name={store.name}>
                    <td class="check-col"><input type="checkbox" class="bulk-check" data-bulk-check={p.id} aria-label={p.name} style="cursor:pointer;width:15px;height:15px"></td>
                    <td class="num row-num">{idx + 1}</td>
                    <td class="thumb-col">
                      {p.images?.[0] && <span class="thumb-wrap"><img src={thumbUrl(p.images[0])} alt="" class="product-thumb" width="42" height="42" loading="lazy" /></span>}
                    </td>
                    <td class="name-col">
                      <span class="product-name">{p.name}</span>
                      {p.description && <span class="product-desc">{p.description}</span>}
                    </td>
                    <td class="cat-col">{p.category ? <span class="product-cat-chip">{p.category}</span> : <span style="color:var(--color-border)">—</span>}</td>
                    <td class="num product-price">{formatPrice(p.price)}</td>
                    <td class="num product-stock">
                      <span style="display:inline-flex;align-items:center;gap:0.3rem">
                        <span>{p.stock}</span>
                        {p.stock <= 0 && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={d.outOfStock} style="color:var(--color-danger);flex-shrink:0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        )}
                      </span>
                    </td>
                    <td class="num wishlist-col" style="color:var(--color-muted);font-size:0.82rem">
                      {(wishlistCounts[p.slug] ?? 0) > 0
                        ? <span style="display:inline-flex;align-items:center;gap:0.25rem;color:var(--color-accent)">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            {wishlistCounts[p.slug]}
                          </span>
                        : <span style="color:var(--color-border)">—</span>
                      }
                    </td>
                    <td class="date-col">{fmtDateAdded(p.createdAt)}</td>
                    <td class="actions">
                      <div class="product-menu">
                        <button class="product-menu__btn" type="button" aria-label={d.menuLabel ?? 'אפשרויות'} aria-expanded="false" aria-haspopup="true">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
                        </button>
                        <ul class="product-menu__dropdown" hidden role="menu">
                          <li role="none"><button class="product-menu__item" type="button" data-view-product={p.id} role="menuitem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>{d.viewProduct}</button></li>
                          <li role="none"><button class="product-menu__item" type="button" data-edit-toggle={p.id} role="menuitem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>{d.edit}</button></li>
                          <li role="none"><button class="product-menu__item product-menu__item--danger" type="button" data-delete-product={p.id} data-store-id={store.id} role="menuitem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>{d.delete}</button></li>
                        </ul>
                      </div>
                    </td>
                  </tr>
                  <tr class="edit-row" data-product-edit={p.id} hidden>
                    <td class="num row-num">{idx + 1}</td>
                    <td colspan="20">
                      <form method="POST" action="/api/product" class="dash-form inline-edit-form">
                        <input type="hidden" name="_action" value="edit-product" />
                        <input type="hidden" name="productId" value={p.id} />
                        <div class="edit-row-header">
                          {p.images?.[0] && <img src={thumbUrl(p.images[0], 72, 72)} alt="" width="36" height="36" loading="lazy" style="width:36px;height:36px;object-fit:cover;border-radius:4px;flex-shrink:0">}
                          <span class="edit-row-title">{p.name}</span>
                        </div>
                        <div class="field-row">
                          <label class="field">
                            <span>{d.nameReq}</span>
                            <input class="input" name="name" value={p.name} required />
                          </label>
                          <label class="field">
                            <span>{d.priceLabel}</span>
                            <input class="input" name="price" type="number" min="0" step="0.01" value={p.price} />
                          </label>
                          <label class="field">
                            <span>{d.colStock}</span>
                            <input class="input" name="stock" type="number" min="0" step="1" value={p.stock} />
                          </label>
                        </div>
                        <label class="field">
                          <span>{d.descLabel}</span>
                          <textarea class="input" name="description" rows="2">{p.description}</textarea>
                        </label>

                        <label class="field">
                          <span>{d.categoryLabel}</span>
                          <input class="input" name="category" value={p.category ?? ''} placeholder={d.categoryPlaceholder} list="store-categories-list" />
                        </label>

                        <label class="field">
                          <span>{d.tagsLabel}</span>
                          <input class="input" name="tags" value={p.tags?.join(', ') ?? ''} placeholder={d.tagsPlaceholder} />
                        </label>

                        <div class="field">
                          <span class="field-label">{d.variantsLabel}</span>
                          <div class="variants-list">
                            {(p.variants ?? []).map((v) => (
                              <div class="variant-block" style="border:1px solid var(--color-border);border-radius:var(--radius);padding:0.65rem;margin-bottom:0.5rem">
                                <div style="display:flex;gap:0.5rem;align-items:flex-end">
                                  <label class="field" style="flex:1;margin:0">
                                    <span>{d.variantNameLabel}</span>
                                    <input class="input" name="variant_name" value={v.name} placeholder={d.variantNamePlaceholder} />
                                  </label>
                                  <label class="field" style="flex:2;margin:0">
                                    <span>{d.variantOptionsLabel}</span>
                                    <input class="input" name="variant_options" value={v.options.join(', ')} placeholder={d.variantOptionsPlaceholder} />
                                  </label>
                                  <button type="button" class="variant-remove-btn btn btn--ghost btn--sm" aria-label={d.variantRemove} style="flex-shrink:0;margin-bottom:0.1rem">×</button>
                                </div>
                              </div>
                            ))}
                          </div>
                          <button type="button" class="variants-add-btn btn btn--ghost btn--sm" style="margin-top:0.5rem">{d.variantAddBtn}</button>
                        </div>

                        <div class="field">
                          <span class="field-label">{d.specsLabel}</span>
                          <div class="specs-rows"
                               data-label-placeholder={d.specsLabelPlaceholder}
                               data-value-placeholder={d.specsValuePlaceholder}>
                            {(p.specs ?? []).map((s) => (
                              <div class="specs-row" style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem">
                                <input class="input" name="specs_label" value={s.label} placeholder={d.specsLabelPlaceholder} style="flex:1" />
                                <input class="input" name="specs_value" value={s.value} placeholder={d.specsValuePlaceholder} style="flex:1" />
                                <button type="button" class="specs-remove-row btn btn--ghost btn--sm" aria-label={d.specsRemoveRow}>×</button>
                              </div>
                            ))}
                          </div>
                          <button type="button" class="specs-add-row btn btn--ghost btn--sm" style="margin-top:0.5rem">{d.specsAddRow}</button>
                        </div>

                        <div class="field">
                          <span class="field-label">{d.productImages}</span>
                          <div set:html={galleryWidgetHtml(p.images ?? [], g)}></div>
                        </div>
                        <div class="form-actions">
                          <button class="btn btn--sm" type="submit" style="min-width:5rem;text-align:center">{d.save}</button>
                          <button class="btn btn--ghost btn--sm" type="button" data-cancel-edit={p.id}>{d.cancel}</button>
                        </div>
                      </form>
                    </td>
                  </tr>
                </>
                );
              })}
            </tbody>
          </table>

          <nav id="products-pagination" class="products-pagination" aria-label={d.productsTitle} hidden></nav>
        </div>
      </div>

      <!-- ── Panel: Orders ── -->
      <div id="dash-panel-orders" class="dash-panel" role="tabpanel" aria-labelledby="tab-orders" hidden={initialPanel !== 'orders'}>
        <div class="orders-panel-head">
          <h2 style="font-size:1rem;font-weight:600;margin:0">{d.ordersTitle}</h2>
          {storeOrders.length > 0 && (
            <div class="order-filter-bar" id="order-filter-bar" role="group" aria-label="סנן הזמנות">
              <button class="order-filter-btn order-filter-btn--sel" data-filter="active" type="button">פעילות</button>
              <button class="order-filter-btn" data-filter="completed" type="button">הושלמו</button>
              <button class="order-filter-btn" data-filter="all" type="button">הכל</button>
            </div>
          )}
        </div>
        {storeOrders.length === 0 ? (
          <p class="seller-msg-empty">{d.noOrders}</p>
        ) : (
          <Fragment>
          <p class="seller-msg-empty" id="orders-filter-empty" hidden>אין הזמנות בקטגוריה זו.</p>
          <div class="orders-list" id="orders-list">
            {storeOrders.map((order) => {
              const storeItems = order.items.filter((i) => i.storeSlug === store!.slug);
              const storeSub   = order.storeSubtotals[store!.slug];
              const fmtDate    = (iso: string) => new Date(iso).toLocaleString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
              const shortId    = order.checkoutRef ?? order.id.slice(0, 8).toUpperCase();
              return (
                <div class="order-card" data-order-id={order.id} data-store-slug={store!.slug} data-shipping-status={order.shippingStatus}>
                  <div class="order-card__header" role="button" tabindex="0" aria-expanded="false">
                    <div class="order-card__meta">
                      <span class="order-card__id">
                        #{shortId}
                        {order.shippingStatus === 'pending' && (
                          <span class="order-new-dot" aria-label="הזמנה חדשה"></span>
                        )}
                      </span>
                      <span class="order-card__date">{fmtDate(order.createdAt)}</span>
                    </div>
                    <div class="order-card__summary">
                      <span class="order-card__buyer">{order.buyerName}</span>
                      <span class="order-card__amount">{formatPrice(storeSub ? storeSub.subtotal + storeSub.shipping : 0)}</span>
                      <span class="order-card__status-badge" style={`background:${orderStatusColors[order.shippingStatus] ?? '#888'}1a;color:${orderStatusColors[order.shippingStatus] ?? '#888'};`}>
                        {orderShippingLabels[order.shippingStatus] ?? order.shippingStatus}
                      </span>
                    </div>
                    <svg class="order-card__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </div>
                  <div class="order-card__body" hidden>
                    <div class="order-card__section">
                      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
                        <h3 class="order-card__section-title" style="margin:0">{d.orderBuyer}</h3>
                        <button
                          class="btn btn--ghost btn--sm order-edit-buyer-btn"
                          type="button"
                          data-order-id={order.id}
                          data-store-slug={store!.slug}
                          data-buyer-name={order.buyerName}
                          data-buyer-email={order.buyerEmail}
                          data-buyer-phone={order.buyerPhone}
                          data-buyer-city={order.buyerAddress.city}
                          data-buyer-street={order.buyerAddress.street}
                          data-buyer-zip={order.buyerAddress.zip ?? ''}
                          data-items={JSON.stringify(storeItems)}
                          data-shipping={String(storeSub?.shipping ?? 0)}
                          data-discount-type={storeSub?.discount?.type ?? 'percent'}
                          data-discount-value={String(storeSub?.discount?.value ?? 0)}
                          style="font-size:0.75rem"
                        >
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                          ערוך פרטים
                        </button>
                      </div>
                      <p class="order-card__info-line order-buyer-name"><strong>{order.buyerName}</strong></p>
                      <p class="order-card__info-line order-buyer-email">{order.buyerEmail}</p>
                      <p class="order-card__info-line order-buyer-phone">{d.orderPhone}: {order.buyerPhone}</p>
                      <p class="order-card__info-line order-buyer-address">{d.orderAddress}: {order.buyerAddress.street}, {order.buyerAddress.city}{order.buyerAddress.zip ? ` ${order.buyerAddress.zip}` : ''}</p>
                    </div>
                    <div class="order-card__section">
                      <h3 class="order-card__section-title">{d.orderItems}</h3>
                      <ul class="order-card__items">
                        {storeItems.map((item) => (
                          <li class="order-card__item">
                            {item.image && <img src={item.image} alt="" width="36" height="36" loading="lazy" class="order-card__item-img" />}
                            <span class="order-card__item-name">{item.productName}</span>
                            <span class="order-card__item-qty">×{item.qty}</span>
                            <span class="order-card__item-price">{formatPrice(item.price * item.qty)}</span>
                          </li>
                        ))}
                      </ul>
                      {storeSub && (
                        <div class="order-card__subtotals">
                          <span>{d.orderShipping}: {storeSub.shipping === 0 ? 'חינם' : formatPrice(storeSub.shipping)}</span>
                          <strong>{d.orderTotal}: {formatPrice(storeSub.subtotal + storeSub.shipping)}</strong>
                        </div>
                      )}
                    </div>
                    <div class="order-card__section order-card__section--controls">
                      <h3 class="order-card__section-title">{d.orderShippingStatus}</h3>
                      <div class="order-card__control-row">
                        <div class="order-status-dropdown">
                          <button class="order-status-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                            <span class="order-status-dot" style={`background:${orderStatusColors[order.shippingStatus] ?? '#888'}`}></span>
                            <span class="order-status-label">{orderShippingLabels[order.shippingStatus] ?? order.shippingStatus}</span>
                            <svg class="order-status-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                          </button>
                          <ul class="order-status-menu" role="listbox" hidden>
                            {(['pending','processing','ready','shipped','delivered'] as const).map((v) => (
                              <li role="none">
                                <button class="order-status-option" type="button" role="option" data-value={v} aria-selected={order.shippingStatus === v}>
                                  <span class="order-status-dot" style={`background:${orderStatusColors[v]}`}></span>
                                  {orderShippingLabels[v]}
                                </button>
                              </li>
                            ))}
                          </ul>
                          <input type="hidden" class="order-status-select" data-field="shippingStatus" value={order.shippingStatus} />
                        </div>
                      </div>
                      <h3 class="order-card__section-title" style="margin-top:0.75rem">{d.orderTracking}</h3>
                      <div class="order-card__control-row">
                        <input type="text" class="order-tracking-input input" data-field="trackingNumber" value={order.trackingNumber ?? ''} placeholder={d.orderTrackingPlaceholder} style="flex:1" />
                        <button class="order-save-btn btn btn--sm btn--accent" type="button">{d.orderSave}</button>
                      </div>
                      <p class="order-save-status" hidden aria-live="polite">{d.orderSaved}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
          </Fragment>
        )}
      </div>

      <!-- ── Panel: Messages ── -->
      <div id="dash-panel-messages" class="dash-panel" role="tabpanel" aria-labelledby="tab-messages" hidden={initialPanel !== 'messages'}>
        <h2 style="font-size:1rem;font-weight:600;margin:0 0 1rem">הודעות מקונים</h2>
        {storeMessages.length === 0 ? (
          <p class="seller-msg-empty">אין הודעות עדיין.</p>
        ) : (
          <div class="msg-table-wrap">
            <table class="msg-table">
              <thead>
                <tr>
                  <th class="msg-table__th msg-table__th--status"></th>
                  <th class="msg-table__th">שולח</th>
                  <th class="msg-table__th">נושא</th>
                  <th class="msg-table__th">תוכן</th>
                  <th class="msg-table__th">מוצר</th>
                  <th class="msg-table__th">תאריך</th>
                  <th class="msg-table__th msg-table__th--actions"></th>
                </tr>
              </thead>
              <tbody>
                {storeMessages.map((msg) => {
                  const replies = messageReplies[msg.id] ?? [];
                  const fmtDate = (iso: string) => new Date(iso).toLocaleString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
                  const hasUnread = !msg.readBySeller || replies.some((r) => r.toSellerId === sellerId && !r.readBySeller);
                  const lastMsg = replies.length > 0 ? replies[replies.length - 1]! : msg;
                  return (
                    <Fragment>
                      <tr
                        class={`msg-table__row${hasUnread ? ' msg-table__row--unread' : ''}`}
                        data-msg-id={msg.id}
                        tabindex="0"
                        role="button"
                        aria-expanded="false"
                      >
                        <td class="msg-table__td msg-table__td--status">
                          {hasUnread && <span class="msg-table__unread-dot" aria-label="לא נקרא"></span>}
                        </td>
                        <td class="msg-table__td msg-table__td--from">{msg.fromName}</td>
                        <td class="msg-table__td msg-table__td--subject">{msg.subject}</td>
                        <td class="msg-table__td msg-table__td--preview">{lastMsg.content}</td>
                        <td class="msg-table__td msg-table__td--product">
                          {msg.productRef
                            ? <a href={`/store/${msg.productRef.storeSlug}/${msg.productRef.productSlug}`} target="_blank" rel="noopener" style="color:inherit;text-decoration:none" onclick="event.stopPropagation()">{msg.productRef.productName}</a>
                            : <span style="color:var(--color-muted)">—</span>
                          }
                        </td>
                        <td class="msg-table__td msg-table__td--date">{fmtDate(msg.createdAt)}</td>
                        <td class="msg-table__td msg-table__td--actions">
                          <button class="seller-msg-delete" data-delete-msg-id={msg.id} type="button" aria-label="מחק שיחה" title="מחק שיחה">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                          </button>
                        </td>
                      </tr>
                      <tr class="msg-thread-row" id={`msg-detail-${msg.id}`} hidden>
                        <td colspan="7">
                          <div class="msg-thread msg-thread--seller-pov" id={`replies-${msg.id}`}>
                            <div class="msg-thread-entry msg-thread-entry--buyer">
                              <div class="msg-thread-entry__header">
                                <span class="msg-thread-entry__who">{msg.fromName}</span>
                                {!msg.readBySeller && <span class="msg-thread-unread-dot" aria-label="לא נקרא"></span>}
                                <span class="msg-thread-entry__date">{fmtDate(msg.createdAt)}</span>
                              </div>
                              <div class="msg-thread-entry__body">{msg.content}</div>
                            </div>
                            {replies.map((r) => {
                              const isSellerReply = r.fromUserId === sellerId;
                              const isUnreadBuyerMsg = !isSellerReply && !r.readBySeller;
                              return (
                                <div class={`msg-thread-entry ${isSellerReply ? 'msg-thread-entry--seller' : 'msg-thread-entry--buyer'}`}>
                                  <div class="msg-thread-entry__header">
                                    <span class="msg-thread-entry__who">{isSellerReply ? 'אתה' : r.fromName}</span>
                                    {isUnreadBuyerMsg && <span class="msg-thread-unread-dot" aria-label="לא נקרא"></span>}
                                    <span class="msg-thread-entry__date">{fmtDate(r.createdAt)}</span>
                                  </div>
                                  <div class="msg-thread-entry__body">{r.content}</div>
                                </div>
                              );
                            })}
                          </div>
                          <div class="seller-msg-reply-form" data-reply-for={msg.id} style="padding:0.75rem 1rem;border-top:1px solid var(--color-border)">
                            <textarea class="seller-msg-reply-textarea" placeholder="כתוב תשובה..." rows="3"></textarea>
                            <button class="seller-msg-reply-send" type="button">שלח תשובה</button>
                          </div>
                        </td>
                      </tr>
                    </Fragment>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <!-- ── Panel: Settings ── -->
      <div id="dash-panel-settings" class="dash-panel" role="tabpanel" aria-labelledby="tab-settings" hidden={initialPanel !== 'settings'}>
        <form method="POST" action="/api/store" class="dash-form" id="settings-form" style="margin-top:0">
          <input type="hidden" name="_action" value="save-settings" />
          <input type="hidden" name="storeId" value={store.id} />

          <div class="dash-panel-header">
            <h2 class="dash-panel-header__title">{d.tabSettings}</h2>
            <button class="btn btn--sm" type="submit" id="settings-save-btn">{d.saveChanges}</button>
          </div>

          <label class="field">
            <span>{d.storeName}</span>
            <input class="input" name="name" value={store.name} required />
          </label>

          <label class="field">
            <span>{d.tagline}</span>
            <input
              class="input"
              name="tagline"
              value={store.tagline}
              placeholder={d.descPlaceholder}
            />
          </label>

          <label class="field">
            <span>{d.description}</span>
            <textarea class="input" name="description" rows="3">{store.description}</textarea>
          </label>

          <label class="field">
            <span>{d.storeCategories}</span>
            <input class="input" name="categories" value={store.categories?.join(', ') ?? ''} placeholder={d.storeCategoriesPlaceholder} />
          </label>

          <p id="settings-status" hidden></p>
        </form>
      </div>

    </div>
  </section>
  </Fragment>
  ) : null}
</BaseLayout>

<style is:global>
  /* ── Orders panel ── */
  .orders-panel-head {
    display: flex; flex-direction: column; align-items: flex-start;
    margin-bottom: 1rem; gap: 0.6rem;
  }
  .order-filter-bar { display: flex; gap: 0.25rem; }
  .order-filter-btn {
    font-size: 0.78rem; font-weight: 500;
    padding: 0.25rem 0.75rem; border-radius: 20px;
    border: 1.5px solid var(--color-border);
    background: var(--color-surface); color: var(--color-muted);
    cursor: pointer; font-family: inherit;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
  }
  .order-filter-btn:not(.order-filter-btn--sel):hover { background: var(--color-bg); color: var(--color-text); }
  .order-filter-btn--sel { background: var(--color-text); color: var(--color-surface); border-color: var(--color-text); cursor: default; }

  .orders-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .order-card {
    border: 1.5px solid var(--color-border);
    border-radius: 12px;
    overflow: visible;
    background: #fff;
    transition: box-shadow 150ms;
  }
  .order-card__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    cursor: pointer;
    user-select: none;
    border-radius: 11px 11px 0 0;
  }
  .order-card:not(.order-card--open) .order-card__header { border-radius: 11px; }
  .order-card__header:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }

  .order-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 5rem;
    flex-shrink: 0;
  }
  .order-card__id { font-size: 0.8rem; font-weight: 700; color: var(--color-text); font-family: monospace; }
  .order-card__date { font-size: 0.72rem; color: var(--color-muted); }

  .order-card__summary {
    flex: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
  }
  .order-card__buyer { font-size: 0.875rem; font-weight: 600; color: var(--color-text); }
  .order-card__amount { font-size: 0.875rem; font-weight: 700; color: var(--color-text); margin-inline-start: auto; }
  .order-card__status-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 20px;
  }
  .order-card__chevron {
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform 220ms cubic-bezier(0.34,1.56,0.64,1);
  }
  .order-card--open .order-card__chevron { transform: rotate(180deg); }

  .order-card__body {
    border-top: 1px solid var(--color-border);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .order-card__section { }
  .order-card__section-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem;
  }
  .order-card__info-line { font-size: 0.875rem; color: var(--color-text); margin: 0.1rem 0; }

  .order-card__items { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .order-card__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
  }
  .order-card__item-img {
    width: 36px; height: 36px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .order-card__item-name { flex: 1; color: var(--color-text); }
  .order-card__item-qty { color: var(--color-muted); font-size: 0.8rem; }
  .order-card__item-price { font-weight: 700; color: var(--color-text); margin-inline-start: auto; }

  .order-card__subtotals {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.625rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .order-card__subtotals strong { color: var(--color-text); font-size: 0.9375rem; }

  .order-card__section--controls { background: var(--color-bg); border-radius: 0 0 11px 11px; padding: 0.875rem; overflow: visible; }
  .order-card__control-row { display: flex; gap: 0.5rem; align-items: center; }

  .order-save-status {
    font-size: 0.8rem;
    font-weight: 600;
    color: #16a34a;
    margin-top: 0.4rem;
  }

  .order-new-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
    margin-inline-start: 5px;
    vertical-align: middle;
    flex-shrink: 0;
  }

  /* no hover / no overflow clip on main dashboard wrapper */
  #dash-main-card { transition: none; overflow: visible; }
  #dash-main-card:hover { box-shadow: none; }
  /* restore hover on individual order cards */
  .order-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.08); }

  /* ── Order status custom dropdown ── */
  .order-status-dropdown { position: relative; }
  .order-status-trigger {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: 9999px; cursor: pointer;
    font-family: inherit; font-size: 0.83rem; font-weight: 500;
    color: var(--color-text); white-space: nowrap;
    transition: border-color 0.12s;
  }
  .order-status-trigger:hover { border-color: var(--color-muted); }
  .order-status-trigger[aria-expanded="true"] { border-color: var(--color-accent); }
  .order-status-chevron {
    flex-shrink: 0; color: var(--color-muted);
    transition: transform 150ms cubic-bezier(0.34,1.56,0.64,1);
  }
  .order-status-trigger[aria-expanded="true"] .order-status-chevron { transform: rotate(180deg); }

  .order-status-menu {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 5px);
    min-width: 11rem; white-space: nowrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.3rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    z-index: 60;
    list-style: none; margin: 0;
    animation: status-pop 0.13s cubic-bezier(0.34,1.56,0.64,1) forwards;
  }
  @keyframes status-pop {
    from { opacity: 0; transform: translateY(-5px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }
  .order-status-option {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.75rem; border-radius: 4px;
    font-size: 0.84rem; font-weight: 500;
    cursor: pointer; font-family: inherit;
    color: var(--color-text); background: none; border: none;
    width: 100%; text-align: start;
    transition: background 0.1s;
  }
  .order-status-option:hover { background: var(--color-bg); }
  .order-status-option[aria-selected="true"] { font-weight: 700; }
  .order-status-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  }

  /* ── Edit order modal centering ── */
  #edit-order-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    max-height: 90vh;
    overflow: visible;
  }
  #edit-order-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  /* ── Edit-order item rows ── */
  .eom-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: opacity 0.15s;
  }
  .eom-item:last-child { border-bottom: none; }
  .eom-item--deleted { opacity: 0.4; }
  .eom-item--deleted .eom-item__name { text-decoration: line-through; }
  .eom-item__img {
    width: 34px; height: 34px; object-fit: cover;
    border-radius: 6px; flex-shrink: 0;
    border: 1px solid var(--color-border);
  }
  .eom-item__img-ph {
    width: 34px; height: 34px; border-radius: 6px; flex-shrink: 0;
    background: var(--color-bg); border: 1px solid var(--color-border);
  }
  .eom-item__name { flex: 1; font-size: 0.82rem; font-weight: 500; color: var(--color-text); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eom-item__meta { font-size: 0.78rem; color: var(--color-muted); flex-shrink: 0; white-space: nowrap; }
  .eom-item__del {
    width: 24px; height: 24px; border-radius: 5px; flex-shrink: 0;
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-muted); cursor: pointer; display: flex;
    align-items: center; justify-content: center;
    transition: background 0.1s, color 0.1s, border-color 0.1s;
  }
  .eom-item__del:hover { background: #fee2e2; color: #dc2626; border-color: #fca5a5; }
  .eom-item--deleted .eom-item__del { background: var(--color-bg); color: var(--color-accent); border-color: var(--color-accent); }

  /* Discount type toggle */
  .eom-dtype-btn { background: var(--color-surface); color: var(--color-muted); }
  .eom-dtype-btn--active { background: var(--color-text); color: var(--color-surface); }

  .dash-tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ef4444;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    min-width: 16px;
    height: 16px;
    border-radius: 20px;
    padding: 0 4px;
    margin-inline-start: 4px;
    vertical-align: middle;
  }

  /* ── Store-switcher alert dots ── */
  .store-switcher__alert-dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: #ef4444;
    border-radius: 50%;
    flex-shrink: 0;
    margin-inline-start: 0.15rem;
    align-self: center;
  }
  .store-switcher__item-dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: #ef4444;
    border-radius: 50%;
    flex-shrink: 0;
  }

</style>

