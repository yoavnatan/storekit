---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PerfProductSection from '../../components/dashboard/PerfProductSection.astro';
import OnboardingChecklist from '../../components/dashboard/OnboardingChecklist.astro';
import CreateStoreCard from '../../components/dashboard/CreateStoreCard.astro';
import TabHint from '../../components/dashboard/TabHint.astro';
import { buildOnboardingSteps, onboardingProgress } from '../../lib/seller-onboarding.js';
import { getSellerById, getSellerSession } from '../../lib/seller-auth.js';
import { commissionPercentForTier } from '../../lib/pricing.js';
import { getStoresBySellerId, createStore, updateStore, normalizeSlug, canOpenAnotherStore, MAX_STORES_PER_SELLER, STORE_WEEKDAYS } from '../../lib/stores.js';
import { cnameTarget, storeHomeHref } from '../../lib/custom-domain.js';
import { DEFAULT_STORE_HOURS } from '../../lib/store-hours.js';
import {
  getProductsByStoreId,
  createProduct,
  updateProduct,
  deleteProduct,
  countStockAlerts,
  isProductVisible,
} from '../../lib/store-products.js';
import { formatPrice, cdnSrc, cdnThumb, store as platformConfig } from '../../config/store.config.js';
import { jsonForScript } from '../../lib/json-script.js';
import { galleryWidgetHtml } from '../../lib/gallery-widget.js';
import { storeMark, storeMarkGradient } from '../../lib/store-mark.js';
import { getLang, getT, getDir } from '../../i18n/index.js';
import { getAllWishlistCounts } from '../../lib/wishlist-counts.js';
import { getFavoriteStoreCount } from '../../lib/store-favorite-counts.js';
import { thumbUrl } from '../../lib/cloudinary.js';
import { getMessagesBySeller, getMessageReplies } from '../../lib/messages.js';
import { getAdminThreadsForSeller } from '../../lib/admin-messages.js';
import SellerMessageRow from '../../components/dashboard/SellerMessageRow.astro';
import { getOrdersByStoreSlug, getPurchasedCountsByStoreSlug, orderStoreNotes } from '../../lib/orders.js';
import type { Order } from '../../lib/orders.js';
import { filterAndSortSellerProducts, parseSellerProductQuery } from '../../lib/seller-products-query.js';
import { filterAndSortSellerOrders, parseSellerOrderQuery } from '../../lib/seller-orders-query.js';
import { buildSellerMessageRows, buildSystemMessageRows, filterAndSortSellerMessages, parseSellerMessageQuery } from '../../lib/seller-messages-query.js';
import { paginate, parsePage } from '../../lib/pagination.js';
import { getSellerStoreAlerts } from '../../lib/seller-alerts.js';
import { resolveVariantColor, isColorVariant } from '../../lib/color-variants.js';
import { comboKey, generateCombos, LOW_STOCK_THRESHOLD, type VariantDimension } from '../../lib/variant-combo.js';
import { getCategoriesByStoreId, buildCategoryTree, categoryPath } from '../../lib/store-categories.js';
import { inferAudienceGender, inferAgeGroup } from '../../lib/audience-infer.js';
import { buildPerformanceSummary, pickGranularity } from '../../lib/seller-performance.js';
import { getCampaignsByStoreId, getMockBaselineImpressions } from '../../lib/ad-campaigns.js';
import { campaignLifetimeStats, campaignRunPeriod } from '../../lib/ad-metrics.js';
import { shortDate } from '../../lib/date-range.js';
import { roasTierChipHtml, ctrTierChipHtml } from '../../lib/ad-tier.js';
import { orderAgeChipHtml } from '../../lib/order-age.js';
import { buildBarChartSvg, buildMultiLineChartSvg } from '../../lib/chart-svg.js';
import StoreCategoryPicker from '../../components/StoreCategoryPicker.astro';
import { buildVocabulary, sanitizeStoreCategories } from '../../lib/store-taxonomy.js';
import { getVisibleStores } from '../../lib/stores.js';

// Splits `total` across `count` rows as evenly as possible (remainder to the
// first rows) so seeding legacy combos never silently changes the sum.
function evenSplit(count: number, total: number): number[] {
  if (count <= 0) return [];
  const base = Math.floor(total / count);
  const remainder = total - base * count;
  return Array.from({ length: count }, (_, i) => base + (i < remainder ? 1 : 0));
}

// Color dimensions must go through resolveVariantColor() before display — a
// custom color assigned via the picker is stored as "name #hex", and without
// stripping it the hex code leaks straight into the label. Each part also
// carries its resolved hex (color dimensions only) so the template can render
// a small swatch right next to the color name, easy to tell apart at a glance.
interface ComboLabelPart { text: string; hex: string | null }

function comboLabelParts(dims: VariantDimension[], combo: Record<string, string>): ComboLabelPart[] {
  return dims.map((d) => {
    const raw = combo[d.name] ?? '';
    if (!isColorVariant(d.name)) return { text: raw, hex: null };
    const { display, hex } = resolveVariantColor(raw);
    return { text: display, hex };
  });
}

function variantCombosData(variants: VariantDimension[], variantStock: Record<string, number> | undefined, totalStock: number) {
  const stockMap = variantStock ?? {};
  const hasAnyStock = Object.keys(stockMap).length > 0;
  const rawCombos = variants.length ? generateCombos(variants) : [];
  const splitDefaults = hasAnyStock ? [] : evenSplit(rawCombos.length, totalStock);
  const combos = rawCombos.map((combo, idx) => {
    const key = comboKey(combo);
    const parts = comboLabelParts(variants, combo);
    const value = key in stockMap ? stockMap[key] : (hasAnyStock ? 0 : (splitDefaults[idx] ?? 0));
    return { key, parts, value };
  });
  return { hasAnyStock, combos };
}

const categoryUsage: Record<string, number> = {};
for (const s of getVisibleStores()) {
  for (const c of s.categories ?? []) {
    const key = c.trim();
    if (key) categoryUsage[key] = (categoryUsage[key] ?? 0) + 1;
  }
}
const categoryVocabulary = buildVocabulary(categoryUsage);

const lang = getLang(Astro.cookies);
const t    = getT(lang);
const d    = t.dashboard;
const g    = t.gallery;

const sellerId = getSellerSession(Astro.cookies);
if (!sellerId) return Astro.redirect('/seller/login');

const cloudinaryCloud = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? '';
const cloudinaryPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET ?? '';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'save-settings');

  if (action === 'save-settings') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    if (!name) {
      error = d.storeNameRequired;
    } else {
      const stores = getStoresBySellerId(sellerId);
      const target = stores.find((s) => s.id === storeId) ?? stores[0];
      if (target) {
        updateStore(target.id, { name, tagline, description, colors: target.colors });
        return Astro.redirect(`/seller/dashboard?store=${target.id}&saved=1`);
      }
    }
  } else if (action === 'create-store') {
    const name = String(form.get('name') || '').trim();
    const slug = normalizeSlug(String(form.get('slug') || ''));
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    if (!name) {
      error = d.storeNameRequired;
    } else if (!slug) {
      error = d.storeUrlRequired;
    } else if (!canOpenAnotherStore(sellerId)) {
      // Server-side gate — the entry point is hidden at the cap, but a hidden link is not a guard.
      error = d.storeLimitReached;
    } else {
      const { id: newStoreId } = createStore(sellerId, { name, slug, tagline, description });
      // Same sanitizer the settings endpoint uses — the picker is convenience, this is the rule.
      const initialCategories = sanitizeStoreCategories(String(form.get('categories') ?? '').split(','));
      if (initialCategories.length) updateStore(newStoreId, { categories: initialCategories });
      return Astro.redirect(`/seller/dashboard?store=${newStoreId}`);
    }
  } else if (action === 'add-product') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else {
      createProduct(storeId, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      return Astro.redirect(`/seller/dashboard?store=${storeId}&added=1`);
    }
  } else if (action === 'edit-product') {
    const productId = String(form.get('productId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else {
      updateProduct(productId, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      const sid = Astro.url.searchParams.get('store') ?? '';
      return Astro.redirect(sid ? `/seller/dashboard?store=${sid}` : '/seller/dashboard');
    }
  } else if (action === 'delete-product') {
    const productId = String(form.get('productId') || '');
    const sid = String(form.get('storeId') || '');
    deleteProduct(productId);
    return Astro.redirect(sid ? `/seller/dashboard?store=${sid}` : '/seller/dashboard');
  }
}

const allStores = getStoresBySellerId(sellerId);
const hasNoStore = allStores.length === 0;
// `?new=1` opens the SAME store-creation card an empty account gets — that's the entry point
// for a seller opening an additional store (store switcher → "פתיחת חנות נוספת"). All of a
// seller's stores bill through their one registered business, so extra stores are extra brands,
// not extra legal entities — capped at MAX_STORES_PER_SELLER (see stores.ts for why).
const atStoreLimit = allStores.length >= MAX_STORES_PER_SELLER;
const showCreateStore = hasNoStore || (Astro.url.searchParams.get('new') === '1' && !atStoreLimit);

// No ?store= in the URL (e.g. arriving fresh via the header's "seller
// dashboard" link) falls back to whichever store the seller was last on,
// not always the first one — persisted via a cookie since this is an SSR
// redirect target, not something a client-side script can decide before
// the page renders.
const LAST_STORE_COOKIE = 'seller_last_store';
const queryStoreId = Astro.url.searchParams.get('store');
const lastStoreId = Astro.cookies.get(LAST_STORE_COOKIE)?.value ?? '';
const activeStoreId = hasNoStore ? '' : (queryStoreId ?? lastStoreId);
const store = hasNoStore ? undefined : (allStores.find((s) => s.id === activeStoreId) ?? allStores[0]);
if (store && store.id !== lastStoreId) {
  Astro.cookies.set(LAST_STORE_COOKIE, store.id, {
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: 'lax',
    path: '/',
    maxAge: 60 * 60 * 24 * 180,
  });
}
const settingsSuccess = !hasNoStore && Astro.url.searchParams.get('saved') === '1';
const productSuccess = !hasNoStore && Astro.url.searchParams.get('added') === '1';
const products = store
  ? getProductsByStoreId(store.id).sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  : [];
const storeCategoryList = store ? getCategoriesByStoreId(store.id) : [];
const categoryTree = buildCategoryTree(storeCategoryList);
const productCategoryPaths = new Map(products.map((p) => [p.id, p.categoryId ? categoryPath(storeCategoryList, p.categoryId) : '']));
const wishlistCounts = store ? getAllWishlistCounts() : ({} as Record<string, number>);
const purchasedCounts = store ? getPurchasedCountsByStoreSlug(store.slug) : ({} as Record<string, number>);
const storeFavoriteCount = store ? getFavoriteStoreCount(store.slug) : 0;
const productCount = products.length;
const inStockCount = products.filter((p) => p.stock > 0).length;
const totalStockValue = products.reduce((sum, p) => sum + p.price * p.stock, 0);
// Products-tab stock-alert badge count — products that are actually on sale
// (not seller-hidden, not admin-blocked) yet are out of / low on stock. A
// deliberately taken-down product (hidden) is intentionally excluded so it
// never nags, which is the whole point of the hidden switch (CURRENT_TASK.md,
// סשן א׳). Mirrors the per-row danger indicator's own `stock <= threshold` rule
// so the badge count and the red rows always agree. countStockAlerts() is the
// shared definition each mutating /api/product action also returns, so the badge
// stays live after an inline stock edit / hide without a full reload.
const stockAlertCount = store ? countStockAlerts(store.id, LOW_STOCK_THRESHOLD) : 0;
// "First steps" checklist (Overview tab) — derived live from the store's own data, never
// stored (see lib/seller-onboarding.ts). Renders nothing once every step is satisfied.
const onboardingSteps = store
  ? buildOnboardingSteps({
      // Visible, not total — a catalog of hidden products leaves the store undiscoverable, so
      // the checklist must not call the step done (see lib/store-readiness.ts).
      visibleProductCount: products.filter(isProductVisible).length,
      hasProfileImage: !!store.profileImage,
      tagline: store.tagline ?? '',
      description: store.description ?? '',
      categoryCount: storeCategoryList.length,
      address: store.address ?? '',
    })
  : [];
// The per-tab "what this tab does" explainers are for a seller meeting this dashboard for the
// FIRST time, so they need both: an unfinished store AND no second store. Opening another store
// is itself proof the seller already knows the tabs — the checklist still shows there (the new
// store really is empty), but re-explaining the UI would be nagging. Nothing stored either way.
const showTabHints =
  allStores.length === 1 && onboardingSteps.length > 0 && !onboardingProgress(onboardingSteps).complete;
// Products tab pagination — mirrors the admin dashboard's server-paginated
// list tabs (src/lib/pagination.ts) so /api/seller/products (AJAX page/sort/
// filter/search) and this initial SSR render never drift. `products` above
// stays the full unfiltered list (category tree, CSV export, stats all still
// need it); only the table body renders off `productsPage.items`.
const sellerProductQuery = parseSellerProductQuery(Astro.url.searchParams);
const PRODUCTS_PAGE_SIZE_OPTIONS = [10, 20, 50, 100];
const requestedPageSize = parseInt(Astro.url.searchParams.get('psize') ?? '20', 10);
const productsPageSize = PRODUCTS_PAGE_SIZE_OPTIONS.includes(requestedPageSize) ? requestedPageSize : 20;
const filteredSortedProducts = filterAndSortSellerProducts(products, productCategoryPaths, wishlistCounts, purchasedCounts, sellerProductQuery);
const productsPage = paginate(filteredSortedProducts, parsePage(Astro.url.searchParams, 'ppage'), productsPageSize);
const initialPanel = Astro.url.searchParams.get('panel') ?? 'overview';
// Performance + Advertising are the two heaviest tabs to render server-side —
// buildPerformanceSummary() reads the page-view buckets and aggregates every
// order, and the ad cards each run a seeded mock-metrics pass. They're rarely
// the tab a seller lands on, so their data is computed SSR ONLY when deep-linked
// (?panel=performance/advertising) and otherwise left empty; the client
// (performance.ts / advertising.ts) lazy-fetches it the first time the tab is
// actually revealed. This keeps the common landing (overview/products) off that
// cost while tab switches for the light tabs stay instant. (CURRENT_TASK item 1)
const perfIsInitial = initialPanel === 'performance';
const advIsInitial = initialPanel === 'advertising';
const storeMessages = store
  ? getMessagesBySeller(sellerId)
      .filter((m) => !m.replyToId && m.toStoreId === store.id)
      .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  : [];
const messageReplies: Record<string, ReturnType<typeof getMessageReplies>> =
  Object.fromEntries(storeMessages.map((m) => [m.id, getMessageReplies(m.id)]));
// Admin<->seller "system" threads live in the SAME table as the buyer ones,
// normalized to the same row shape (seller-messages-query.ts) — one thread
// per subject, sorted/searched/paginated together with everything else, and
// nothing at all rendered for a seller who never got one. They used to be a
// single permanently pinned row outside this pipeline (CURRENT_TASK "סשן ד׳").
const adminThreads = sellerId ? getAdminThreadsForSeller(sellerId) : [];
// Messages tab pagination — same server-paginated approach as Products/Orders
// above (src/lib/seller-messages-query.ts).
const sellerMessageQuery = parseSellerMessageQuery(Astro.url.searchParams);
const messageRows = [
  ...buildSellerMessageRows(storeMessages, messageReplies, sellerId),
  ...buildSystemMessageRows(adminThreads),
];
// A thread the seller already read can still have an unread follow-up reply,
// so the tab dot counts rows with ANY unread entry, not just unread roots.
const unreadMsgRows = messageRows.filter((r) => r.hasUnread).length;
// Sorting/filtering by read-status is only meaningful when the table actually
// has a mix of both — with everything read (or everything unread) there's
// nothing to sort or filter, so hide those controls entirely rather than
// leave a dead, functionless option in the menu.
const showMsgStatusControls = unreadMsgRows > 0 && unreadMsgRows < messageRows.length;
const filteredMessageRows = filterAndSortSellerMessages(messageRows, sellerMessageQuery);
const messagesPage = paginate(filteredMessageRows, parsePage(Astro.url.searchParams, 'mpage'), 15);
// Distinct filter-dropdown values must come from the full (unpaginated) set,
// not just the current page's rows — same reasoning as Products' category
// filter (allCategoryPaths() in products.ts) once only one page's worth of
// rows live in the DOM at a time.
const msgDistinctProducts = [...new Set(messageRows.map((r) => r.productName))].sort((a, b) => a.localeCompare(b, 'he'));
const msgDistinctFrom = [...new Set(messageRows.map((r) => r.fromName))].sort((a, b) => a.localeCompare(b, 'he'));
const storeOrders: Order[] = store ? getOrdersByStoreSlug(store.slug) : [];

// Performance tab — SSR renders the default "this month" range so it's never
// a blank flash before JS runs; range-picker changes re-fetch from
// /api/seller/performance and re-render client-side (same AJAX pattern as
// Products/Orders/Messages, no full page nav). Default is "this month" to
// match the range picker's own default preset (performance.ts) — the two must
// agree or the SSR chart wouldn't match the picker label on first paint.
const perfToday = new Date();
// Local-calendar ISO (not toISOString, which is UTC and would shift the 1st of
// the month back a day in positive-UTC timezones) — must match performance.ts's
// own toISODate so SSR and the picker's "this month" preset agree exactly.
const toLocalISO = (dt: Date) => `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}`;
const perfToISO = toLocalISO(perfToday);
const perfFromISO = toLocalISO(new Date(perfToday.getFullYear(), perfToday.getMonth(), 1));
const perfGranularity = pickGranularity(perfFromISO, perfToISO);
const perfSummary = (store && perfIsInitial) ? buildPerformanceSummary(storeOrders, store.slug, perfFromISO, perfToISO, perfGranularity, commissionPercentForTier(getSellerById(sellerId)?.tier)) : undefined;

// Advertising tab — campaigns + mock stats (see ad-campaigns.ts; no real
// Google Ads/Meta API wired up yet).
// Each campaign card defaults to LIFETIME ("since launch") totals — the stable
// "what did this specific campaign achieve" figure (CURRENT_TASK.md item 3),
// which pausing FREEZES rather than erases (item 1). The range picker above the
// list re-fetches a windowed "recent activity" view over other periods.
const adCampaigns = (store && advIsInitial) ? getCampaignsByStoreId(store.id).map((c) => ({ ...c, stats: campaignLifetimeStats(c), runPeriod: campaignRunPeriod(c) })) : [];
// Baseline is the platform-funded free exposure the store has accrued to date —
// a stable lifetime total, deliberately NOT windowed by the campaign picker.
const adBaselineImpressions = store ? getMockBaselineImpressions(store.id) : 0;
// Budget-fee note: show the real management-fee % once it's set in the config;
// until then (null = undecided) fall back to the rate-less phrasing.
const adBudgetFeePct = platformConfig.ads?.boostCommissionPercent;
const adBudgetFeeTipText = adBudgetFeePct != null
  ? d.adBudgetFeeTipRate.replace('{pct}', String(adBudgetFeePct))
  : d.adBudgetFeeTip;
// A boost only makes sense for a product a shopper can actually reach and buy —
// so exclude anything off the storefront (seller-hidden or admin-blocked), not
// just out-of-stock items.
const adEligibleProducts = store ? products.filter((p) => p.stock > 0 && !p.hidden && !p.blocked) : [];
// Gender the product's own text (category path it sits under + name + tags)
// implies — pre-fills the campaign audience so a seller who already categorized
// under "גברים"/"נשים" never re-enters it (no duplicate input). '' = no signal /
// ambiguous → leave "all". Resolved server-side because category names live in
// the fs-backed tree; surfaced to the client form via a data attr per option.
const adInferTexts = (p: typeof adEligibleProducts[number]) => [productCategoryPaths.get(p.id), p.name, ...(p.tags ?? [])];
const adProductInferredGender = new Map(adEligibleProducts.map((p) => [p.id, inferAudienceGender(adInferTexts(p)) ?? ''] as const));
const adProductInferredAge = new Map(adEligibleProducts.map((p) => [p.id, inferAgeGroup(adInferTexts(p)) ?? ''] as const));
// Compact "women · kids · 14 days" targeting summary — mirrors targetingLabel()
// in advertising.ts (client card rebuild) and the same helper in admin advertising.astro.
const adAgeLabels: Record<string, string> = { infant: d.adAgeInfant, kids: d.adAgeKids, adult: d.adAgeAdult };
const adTargetingLabel = (c: { scope?: string; durationDays?: number; audience?: { gender: string; age: string } }): string => {
  const parts: string[] = [];
  if (c.scope === 'store') {
    parts.push(d.adAutoPerProduct);
  } else {
    if (c.audience?.gender === 'women') parts.push(d.adGenderWomen);
    else if (c.audience?.gender === 'men') parts.push(d.adGenderMen);
    if (c.audience?.age && adAgeLabels[c.audience.age]) parts.push(adAgeLabels[c.audience.age]!);
    if (parts.length === 0) parts.push(d.adAudienceAll);
  }
  parts.push(c.durationDays === 7 ? d.adDuration7 : c.durationDays === 14 ? d.adDuration14 : c.durationDays === 30 ? d.adDuration30 : d.adDurationOngoing);
  return parts.filter(Boolean).join(' · ');
};
// Budget label reflecting billing mode (mirrors budgetLabel() in advertising.ts):
// a fixed-duration boost is a one-time TOTAL, ongoing is a recurring MONTHLY.
const adBudgetLabelFor = (c: { durationDays?: number }): string => (c.durationDays ? d.adBudgetTotal : d.adBudgetMonthly);
// Run-period label (mirrors runPeriodLabel() in advertising.ts): "מאז 8.7" while
// running, "8.7–17.7" once paused/ended — the period the lifetime numbers cover.
const adRunPeriodLabel = (c: { status: string; runPeriod?: { start: string; end: string } }): string => {
  if (!c.runPeriod) return '';
  return c.status === 'active' ? `${d.adRunSince} ${shortDate(c.runPeriod.start)}` : `${shortDate(c.runPeriod.start)}–${shortDate(c.runPeriod.end)}`;
};

const perfIsRtl = getDir(lang) === 'rtl';
const perfRevenueChartSvg = perfSummary
  ? buildBarChartSvg(perfSummary.points.map((p) => ({ label: p.label, value: p.revenue, key: p.key })), { color: 'var(--color-primary)', valueFormatter: formatPrice, emptyMessage: d.perfNoData, rtl: perfIsRtl })
  : '';
const perfVisitorsChartSvg = perfSummary
  ? buildMultiLineChartSvg([
      { points: perfSummary.points.map((p) => ({ label: p.label, value: p.uniqueVisitors })), color: 'var(--color-accent)', fill: true, label: d.perfUniqueVisitors },
      { points: perfSummary.points.map((p) => ({ label: p.label, value: p.views })), color: 'var(--color-muted)', dashed: true, label: d.perfVisitors },
    ], { valueFormatter: (v) => String(v), emptyMessage: d.perfNoData, rtl: perfIsRtl })
  : '';
// Shown in the chart slots while the tab is lazy-loading its data (perfSummary
// undefined because this wasn't the landing tab). Replaced wholesale by
// performance.ts#paintCharts once the fetch resolves on first reveal.
const perfChartSkeleton = '<div class="skeleton-shimmer" style="height:180px;border-radius:var(--radius)"></div>';
const newOrdersCount = storeOrders.filter((o) => o.shippingStatus === 'pending').length;
// Overview "orders needing attention" square (CURRENT_TASK item 4): 'processing'
// (בטיפול) = started but not yet shipped, the second attention stage after the
// new-orders ('pending') count above. 'ready' (ממתין לאיסוף) is omitted for the
// same reason the Orders filter omits it — no seller can reach it today (carrier-
// driven once Sendit is wired). Clicking a square jumps to the Orders tab filtered
// to exactly that status, so the count and the filtered list always agree.
const unshippedOrdersCount = storeOrders.filter((o) => o.shippingStatus === 'processing').length;
// Orders tab pagination — same server-paginated approach as Products above
// (src/lib/seller-orders-query.ts mirrors admin-orders-filter.ts), fixed at
// 15/page like the admin dashboard's own list tabs (no items-per-page
// control here — that was only asked for on Products).
const sellerOrderQuery = parseSellerOrderQuery(Astro.url.searchParams);
const filteredSortedOrders = filterAndSortSellerOrders(storeOrders, store?.slug ?? '', sellerOrderQuery);
const ordersPage = paginate(filteredSortedOrders, parsePage(Astro.url.searchParams, 'opage'), 15);

// Alerts per store for store-switcher dots (pending orders or unread messages)
const storeAlerts: Record<string, boolean> = allStores.length > 1 ? getSellerStoreAlerts(sellerId) : {};
// The header dot should point the seller TO the alert — so it only fires when
// a store OTHER than the one currently open has something unhandled. If the
// seller is already looking at the store with the alert, they can already
// see it there (tab badge / order dot), so the header dot would be redundant.
const hasAnyNonCurrentAlert = store
  ? Object.entries(storeAlerts).some(([id, v]) => v && id !== store.id)
  : false;

const orderShippingLabels: Record<string, string> = {
  pending: d.shippingPending,
  processing: d.shippingProcessing,
  ready: d.shippingReady,
  shipped: d.shippingShipped,
  delivered: d.shippingDelivered,
  cancelled: d.shippingCancelled,
};

const orderStatusColors: Record<string, string> = {
  pending: '#ef4444',
  processing: '#3b82f6',
  ready: '#f59e0b',
  shipped: '#8b5cf6',
  delivered: '#16a34a',
  cancelled: '#6b7280',
};

---

<BaseLayout title={hasNoStore ? d.noStoreTitle : d.title} noindex={true} isLoggedIn={true} hasStore={!hasNoStore} storeMode={true} sellerMode={true}>
  {showCreateStore ? (
    <CreateStoreCard first={hasNoStore} error={error} vocabulary={categoryVocabulary} />
  ) : store ? (
  <Fragment>
  <div id="upload-config" data-cloud={cloudinaryCloud} data-preset={cloudinaryPreset} data-store-slug={store.slug} data-store-id={store.id} data-store-name={store.name} data-seller-id={sellerId} data-bg-colors={JSON.stringify(store.bgColors ?? [])} hidden></div>
  <section class="section container dash-section">
    <div id="dash-main-card" class="card seller-dash" style="margin-bottom:1.5rem">

      <!-- ── Store header ── -->
      <div class="dash-head">
        <div class="dash-head__top">
          {/* The switcher renders even for a single-store seller — it is the only entry point to
              "open another store", and one mechanism beats a second entry point hidden elsewhere. */}
          <div class="relative inline-block" id="store-switcher">
              <button
                class="group inline-flex items-center gap-[.3rem] bg-transparent border-0 p-0 cursor-pointer font-[inherit] text-[color:var(--color-text)] transition-colors duration-150 hover:text-[color:var(--color-accent)]"
                id="store-switcher-btn"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label={lang === 'he' ? 'החלף חנות' : 'Switch store'}
              >
                <span class="dash-store-name text-[1.3rem] font-bold m-0 leading-[1.2]">{store.name}</span>
                <svg class="store-switcher__chevron text-[color:var(--color-muted)] shrink-0 mt-px [transition:transform_.2s_ease,color_.15s] group-hover:text-[color:var(--color-accent)] group-aria-expanded:rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
                {hasAnyNonCurrentAlert && (
                  <span class="store-switcher__alert-dot" aria-label="יש התראות בחנויות אחרות"></span>
                )}
              </button>
              <ul class="absolute top-[calc(100%+0.5rem)] start-0 min-w-[200px] bg-[color:var(--color-surface)] border border-[color:var(--color-border)] rounded-[var(--radius)] shadow-[0_4px_20px_rgba(0,0,0,0.1)] z-20 list-none m-0 p-[.35rem] [&:not([hidden])]:animate-[user-dropdown-open_130ms_cubic-bezier(0.34,1.56,0.64,1)]" id="store-switcher-menu" role="listbox" hidden>
                {allStores.map((s) => (
                  <li>
                    <a
                      href={`/seller/dashboard?store=${s.id}&panel=${initialPanel}`}
                      role="option"
                      aria-selected={s.id === store.id}
                      class={s.id === store.id
                        /* `store-option--current` is a JS-only marker (no CSS) — updateSwitcherAlertDot() below finds the current row through it. */
                        ? 'store-option--current flex items-center justify-between gap-2 py-[.45rem] px-3 rounded-[var(--radius-sm)] no-underline text-[.9rem] transition-colors duration-100 hover:bg-[color:var(--color-bg)] font-semibold text-[color:var(--color-primary)]'
                        : 'flex items-center justify-between gap-2 py-[.45rem] px-3 rounded-[var(--radius-sm)] text-[color:var(--color-text)] no-underline text-[.9rem] transition-colors duration-100 hover:bg-[color:var(--color-bg)]'}
                    >
                      <span>{s.name}</span>
                      <span class="store-switcher__item-actions" style="display:flex;align-items:center;gap:0.35rem;flex-shrink:0">
                        {storeAlerts[s.id] && (
                          <span class="store-switcher__item-dot" aria-label="יש התראות"></span>
                        )}
                        {s.id === store.id && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
                <li class="mt-[.2rem] pt-[.2rem] border-t [border-color:var(--color-border)]">
                  {atStoreLimit ? (
                  <p class="m-0 py-[.45rem] px-3 text-[.8rem] leading-[1.4] [color:var(--color-muted)]">{d.storeLimitReached}</p>
                  ) : (
                  <a
                    href="/seller/dashboard?new=1"
                    class="flex items-center gap-2 py-[.45rem] px-3 rounded-[var(--radius-sm)] no-underline text-[.9rem] [color:var(--color-accent)] font-medium transition-colors duration-100 hover:bg-[color:var(--color-bg)]"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>{d.addStore}</span>
                  </a>
                  )}
                </li>
              </ul>
            </div>
          {/* A NAMED target, not _blank: every click reuses the same preview tab instead of
              opening another one — on mobile, where tabs are out of sight, _blank quietly piled
              them up. The store page shows the owner a "back to dashboard" bar (see
              [storeSlug]/index.astro) that closes this tab and returns here.
              NO rel="noopener": it makes the browser ignore the target name and open a fresh
              context anyway (measured), which is the whole thing we're avoiding. Safe here
              because the destination is our own store page, never third-party — and the opener
              link is what lets initStorePreviewLink's window.open reuse and close the tab. */}
          <a id="dash-view-store" href={storeHomeHref(store)} class="btn btn--sm" target="dezabin-store-preview">
            {d.viewLive}
          </a>
        </div>
        {/* The store's public address — the seller's own domain once verified, else the platform path. */}
        <p class="muted" style="margin:0.25rem 0 0;font-size:0.82rem">{d.storeSubtitle} · <code id="dash-store-address" data-has-custom-domain={store.customDomain?.status === 'active' ? '1' : ''} style="font-size:0.78rem">{store.customDomain?.status === 'active' ? store.customDomain.hostname : `/${store.slug}`}</code></p>

        {settingsSuccess && <p class="dash-success bg-[#f0fdf4] text-[#166534] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#bbf7d0] text-sm" style="margin-top:1rem;margin-bottom:0">{d.settingsSaved}</p>}
        {productSuccess && <p class="dash-success bg-[#f0fdf4] text-[#166534] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#bbf7d0] text-sm" style="margin-top:1rem;margin-bottom:0">{d.productAdded}</p>}
        {error && <p class="dash-error bg-[#fef2f2] text-[color:var(--color-danger)] py-2 px-[.85rem] rounded-[var(--radius)] border border-[#fecaca] text-sm" style="margin-top:1rem;margin-bottom:0">{error}</p>}
      </div>

      <!-- ── Section tabs ── -->
      <div class="dash-tabs max-sm:!px-0" role="tablist">
        <button
          class={`dash-tab${initialPanel === 'overview' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-overview"
          data-panel="overview"
          aria-selected={initialPanel === 'overview'}
          tabindex={initialPanel === 'overview' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>{d.tabOverview}</button>
        <button
          class={`dash-tab${initialPanel === 'products' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-products"
          data-panel="products"
          aria-selected={initialPanel === 'products'}
          tabindex={initialPanel === 'products' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>{d.tabProducts}
          <span id="products-stock-badge" class="dash-tab-badge ![background:var(--color-warning)]" data-tooltip={d.stockAlertBadge} aria-label={d.stockAlertBadge} hidden={stockAlertCount === 0}>{stockAlertCount}</span>
        </button>
        <button
          class={`dash-tab${initialPanel === 'orders' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-orders"
          data-panel="orders"
          aria-selected={initialPanel === 'orders'}
          tabindex={initialPanel === 'orders' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>{d.tabOrders}
          {newOrdersCount > 0 && (
            <span class="dash-tab-badge" aria-label={`${newOrdersCount} הזמנות חדשות`}>{newOrdersCount}</span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'performance' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-performance"
          data-panel="performance"
          aria-selected={initialPanel === 'performance'}
          tabindex={initialPanel === 'performance' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>{d.tabPerformance}</button>
        <button
          class={`dash-tab${initialPanel === 'advertising' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-advertising"
          data-panel="advertising"
          aria-selected={initialPanel === 'advertising'}
          tabindex={initialPanel === 'advertising' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>{d.tabAdvertising}</button>
        <button
          class={`dash-tab${initialPanel === 'messages' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-messages"
          data-panel="messages"
          aria-selected={initialPanel === 'messages'}
          tabindex={initialPanel === 'messages' ? 0 : -1}
          style="position:relative"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>הודעות
          {unreadMsgRows > 0 && (
            <span style="position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:var(--color-danger);border-radius:50%" aria-label={`${unreadMsgRows} הודעות שלא נקראו`}></span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'settings' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-settings"
          data-panel="settings"
          aria-selected={initialPanel === 'settings'}
          tabindex={initialPanel === 'settings' ? 0 : -1}
        ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>{d.tabSettings}</button>
      </div>

      <!-- ── Panel: Overview ── -->
      <div id="dash-panel-overview" class="dash-panel" role="tabpanel" aria-labelledby="tab-overview" hidden={initialPanel !== 'overview'}>
        <OnboardingChecklist steps={onboardingSteps} />
        {showTabHints && <TabHint text={d.tabHintOverview} />}
        {false && (<div class="mb-4 pb-[0.6rem] border-b [border-color:var(--color-border)]">
          <h2 class="m-0 text-base font-semibold">{d.storeOverview}</h2>
        </div>)}
        {/* Each card jumps to its tab (data-goto-panel, initGotoPanelLinks() in ui.ts) — same pattern as AdminOverviewPanel.astro. favoritedBy has no dedicated tab of its own, so it stays a plain (non-button) stat. Box style matches the performance tab's KPI cards (perf-kpis below) for visual consistency between the two stat grids. */}
        <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {/* Orders group first (total → new → not-yet-shipped): the total, then its
              two attention breakdowns. The attention cards jump to their tab AND apply
              the matching filter (wired in the inline script below), so a click lands on
              exactly the counted rows; their number turns coloured only when there's
              something to act on, muted "all clear" otherwise. */}
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)] cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-card-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="orders">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.tabOrders}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{storeOrders.length}</dd>
          </button>
          <button type="button" id="ov-new-orders" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)] cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-card-hover)] hover:[border-color:var(--color-primary)]">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.ovNewOrders}</dt>
            <dd class={`m-0 text-[1.15rem] font-bold ${newOrdersCount > 0 ? '[color:var(--color-accent)]' : '[color:var(--color-muted)]'}`}>{newOrdersCount}</dd>
          </button>
          <button type="button" id="ov-unshipped" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)] cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-card-hover)] hover:[border-color:var(--color-primary)]">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.ovUnshipped}</dt>
            <dd class={`m-0 text-[1.15rem] font-bold ${unshippedOrdersCount > 0 ? '[color:var(--color-warning)]' : '[color:var(--color-muted)]'}`}>{unshippedOrdersCount}</dd>
          </button>
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)] cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-card-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="products">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.products}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{productCount}</dd>
          </button>
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)] cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-card-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="products">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.inStock}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{inStockCount}</dd>
          </button>
          <button type="button" id="ov-stock-attention" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)] cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-card-hover)] hover:[border-color:var(--color-primary)]">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.ovStockAttention}</dt>
            <dd class={`m-0 text-[1.15rem] font-bold ${stockAlertCount > 0 ? '[color:var(--color-danger)]' : '[color:var(--color-muted)]'}`}>{stockAlertCount}</dd>
          </button>
          <button type="button" class="text-start bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)] cursor-pointer transition-[box-shadow,border-color] duration-200 hover:[box-shadow:var(--shadow-card-hover)] hover:[border-color:var(--color-primary)]" data-goto-panel="products">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.stockValue}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{formatPrice(totalStockValue)}</dd>
          </button>
          <div class="bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-3 shadow-[var(--shadow-xs)]">
            <dt class="text-[0.78rem] [color:var(--color-muted)] font-medium mb-1">{d.favoritedBy}</dt>
            <dd class="m-0 text-[1.15rem] font-bold [color:var(--color-text)]">{storeFavoriteCount}</dd>
          </div>
        </dl>
      </div>

      <!-- ── Panel: Products ── -->
      <div id="dash-panel-products" class="dash-panel" role="tabpanel" aria-labelledby="tab-products" hidden={initialPanel !== 'products'}>
        {showTabHints && <TabHint text={d.tabHintProducts} />}

        <div>
          <div class="products-header">
            <div class="products-header__title">
              <input type="checkbox" id="bulk-select-all-mobile" class="bulk-select-all bulk-select-all--mobile" aria-label={d.bulkSelectAll} style="cursor:pointer;width:15px;height:15px;flex-shrink:0">
              <span class="bulk-count-paren" id="bulk-count-paren" aria-hidden="true"></span>
              <h2>{d.productsTitle}</h2>
              <span class="bulk-count-badge" id="bulk-count-badge" hidden>
                <strong id="bulk-count">0</strong> {d.bulkSelected}
              </span>
            </div>
            <div class="products-header__actions">
              <button id="bulk-edit-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkEdit}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span id="bulk-edit-label" class="bulk-btn__label" aria-hidden="true">{d.bulkEdit}</span>
              </button>
              <button id="bulk-upload-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkUploadImages}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span id="bulk-upload-label" class="bulk-btn__label" aria-hidden="true">{d.bulkUploadImages}</span>
              </button>
              <button id="bulk-delete-btn" type="button" class="btn btn--sm btn--danger bulk-btn !bg-[color:var(--color-danger)] hover:opacity-90" hidden aria-label={d.bulkDelete}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.bulkDelete}</span>
              </button>
              <span class="products-header__sep" id="bulk-sep" aria-hidden="true" hidden></span>
              {/* Primary action first; the two panel-toggles follow it and go icon-only on mobile
                  (see dashboard.css mobile block) so the strip stays compact when nothing's selected. */}
              <button class="btn btn--sm add-product-btn" id="toggle-add-form" aria-label={d.addProduct}>
                <svg class="add-product-btn__icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span class="add-product-btn__label" aria-hidden="true">{d.addProduct}</span>
              </button>
              <button class="btn btn--sm bulk-btn" id="toggle-csv-panel" aria-label={d.csvImportExport}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9.5 14.5 12 17 14.5 14.5"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.csvImportExport}</span>
              </button>
              <button class="btn btn--sm bulk-btn" id="toggle-feed-panel" aria-label={d.feedSyncTitle}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.feedSyncTitle}</span>
              </button>
            </div>
          </div>

          <div id="add-product-form" class="bg-[color:var(--color-surface)] border border-[color:var(--color-border)] rounded-[var(--radius)] p-5 mb-6" hidden>
            <h3 class="m-0 mb-3 text-base">{d.newProduct}</h3>
            <form method="POST" class="mt-4" data-unsaved-guard>
              <input type="hidden" name="_action" value="add-product" />
              <input type="hidden" name="storeId" value={store.id} />

              <div class="grid grid-cols-[2fr_1fr_1fr] gap-4">
                <label class="field">
                  <span>{d.nameReq}</span>
                  <input class="input" name="name" required placeholder={d.namePlaceholder} />
                </label>
                <label class="field">
                  <span>{d.priceLabel}</span>
                  <input
                    class="input"
                    name="price"
                    type="number"
                    min="0"
                    step="0.01"
                    placeholder="0.00"
                  />
                </label>
                <label class="field">
                  <span>{d.colStock}</span>
                  <input class="input" name="stock" type="number" min="0" step="1" placeholder="0" />
                </label>
              </div>

              <label class="field">
                <span>{d.descLabel}</span>
                <textarea
                  class="input"
                  name="description"
                  rows="2"
                  placeholder={d.descPlaceholderProduct}></textarea>
              </label>

              <div class="grid grid-cols-[2fr_1fr_1fr] gap-4">
                <div class="field max-w-[280px]">
                  <span>{d.categoryLabel}</span>
                  <div class="category-picker relative" data-category-picker>
                    <input type="hidden" name="categoryId" value="" />
                    <button type="button" class="category-picker__trigger group flex items-center justify-between gap-2 w-full px-[0.7rem] py-2 bg-[color:var(--color-bg)] border border-[var(--color-border)] rounded-[var(--radius)] cursor-pointer text-sm text-[color:var(--color-text)] text-start transition-colors duration-[120ms] hover:border-[var(--color-muted)] aria-expanded:border-[var(--color-accent)]" aria-haspopup="true" aria-expanded="false">
                      <span class="category-picker__label overflow-hidden text-ellipsis whitespace-nowrap">{d.categoryNone}</span>
                      <svg class="category-picker__chevron shrink-0 text-[color:var(--color-muted)] transition-transform duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="category-picker__menu absolute start-0 top-[calc(100%+5px)] w-max min-w-full max-w-[20rem] max-h-[18rem] overflow-y-auto bg-[color:var(--color-surface)] border border-[color:var(--color-border)] rounded-[var(--radius)] p-[0.3rem] shadow-[0_4px_20px_rgba(0,0,0,0.12)] z-[60] animate-status-pop" hidden></div>
                  </div>
                  <p class="muted" style="margin:0.3rem 0 0;font-size:0.76rem">{d.categoryEditHint}</p>
                </div>
                <label class="field max-w-[280px]">
                  <span>{d.skuLabel}</span>
                  <input class="input" name="sku" placeholder={d.skuPlaceholder} />
                </label>
              </div>

              <div class="field max-w-none" data-tags-field>
                <span>{d.tagsLabel}</span>
                <div class="variant-chips" data-tag-chips style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
                  <span data-tag-adder>
                    <button type="button" class="variant-chip-add-trigger btn btn--ghost btn--sm" data-tag-add-trigger style="border-radius:999px">{d.variantValueAddBtn}</button>
                  </span>
                </div>
                <div data-tag-suggestions style="display:none;flex-wrap:wrap;gap:0.4rem;align-items:center;margin-top:0.45rem"></div>
                <input type="hidden" name="tags" value="" />
              </div>

              <div class="field variants-editor" data-variants-editor>
                <span class="field-label">{d.variantsLabel}</span>
                <div class="variant-dims" data-variant-dims></div>
                <button type="button" class="variants-add-btn btn btn--ghost btn--sm" style="margin-top:0.25rem">{d.variantAddBtn}</button>
                <div class="variant-combos" data-variant-combos style="margin-top:0.75rem" hidden>
                  <p class="field-label" style="margin:0 0 0.3rem">{d.variantComboLabel}</p>
                  <p class="muted" data-variant-combo-hint style="font-size:0.78rem;margin:0 0 0.5rem" hidden>{d.variantComboHint}</p>
                  <div style="max-height:260px;overflow:auto;border:1px solid var(--color-border);border-radius:var(--radius)">
                    <table style="width:100%;border-collapse:separate;border-spacing:0">
                      <thead data-variant-combo-thead></thead>
                      <tbody data-variant-combo-rows></tbody>
                      <tfoot data-variant-combo-tfoot></tfoot>
                    </table>
                  </div>
                </div>
              </div>

              <div class="field">
                <span class="field-label">{d.specsLabel}</span>
                <div class="specs-rows"
                     data-label-placeholder={d.specsLabelPlaceholder}
                     data-value-placeholder={d.specsValuePlaceholder}></div>
                <button type="button" class="btn btn--ghost btn--sm specs-add-row" style="margin-top:0.5rem">{d.specsAddRow}</button>
              </div>

              <label class="field max-w-none">
                <span class="inline-flex items-center gap-[0.35rem]">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;color:var(--color-muted)"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                  {d.sellerNoteLabel}
                </span>
                <textarea class="input resize-none" name="sellerNote" rows="2" maxlength="2000" placeholder={d.sellerNotePlaceholder}></textarea>
              </label>

              <div class="field">
                <span class="field-label">{d.productImages}</span>
                <div set:html={galleryWidgetHtml([], g)}></div>
              </div>

              <div class="flex gap-2 mt-2">
                <button class="btn" type="submit">{d.addProductBtn}</button>
                <button class="btn btn--ghost" type="button" id="cancel-add">{d.cancel}</button>
              </div>
            </form>
          </div>

          <p id="empty-products" class="empty-products" hidden={products.length > 0}>{d.noProducts}</p>
          <p id="empty-products-search" class="empty-products" hidden={products.length === 0 || productsPage.total > 0}>{d.noProductsMatch}</p>

          {/* CSV bulk import/export panel */}
          <div id="csv-panel" class="csv-panel border [border-color:var(--color-border)] rounded-[var(--radius)] p-[0.8rem] mb-3 bg-[color:var(--color-bg)] animate-bulk-bar-in" hidden data-store-id={store.id}>
            <div class="csv-panel__header flex items-center justify-between text-[0.85rem] font-semibold [color:var(--color-muted)] uppercase tracking-[0.04em] mb-2">
              <span>{d.csvImportExport}</span>
              <button type="button" class="btn btn--ghost btn--sm" id="csv-panel-close" aria-label={d.csvClose}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <p class="csv-panel__hint muted text-[0.82rem] leading-[1.5] mb-1">{d.csvImportLead}</p>
            <ul class="muted text-[0.82rem] leading-[1.5] m-0 mb-3 ps-[1.1rem] space-y-1 list-disc marker:[color:var(--color-primary)]">
              {d.csvImportPoints.map((p) => (typeof p === 'string' ? <li>{p}</li> : (
                <li>{p.text}
                  <ul class="mt-1 ps-[1.1rem] space-y-1 list-[circle] marker:[color:var(--color-primary)]">
                    {p.sub.map((s) => <li>{s}</li>)}
                  </ul>
                </li>
              )))}
            </ul>
            <div class="csv-panel__actions flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:flex-wrap">
              <a class="btn btn--ghost btn--sm sm:!justify-start" id="csv-export-link" href={`/api/store-product/bulk?storeId=${store.id}`} download="products.csv">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                {d.csvExport}
              </a>
              <button type="button" class="btn btn--ghost btn--sm sm:!justify-start" id="csv-template-btn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
                {d.csvTemplate}
              </button>
              <label class="btn btn--ghost btn--sm sm:!justify-start" for="csv-file-input">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                {d.csvChooseFile}
              </label>
              <input type="file" id="csv-file-input" accept=".csv,text/csv" hidden />
              <span id="csv-file-name" class="muted text-[0.8rem] overflow-hidden text-ellipsis whitespace-nowrap" aria-live="polite"></span>
            </div>
            <div id="csv-preview" class="csv-preview mt-[0.9rem]" hidden></div>
          </div>

          {/* External-inventory sync panel — for a store that manages its stock in another system
              (POS/ERP/Shopify/Woo/spreadsheet). Deliberately separate from the CSV panel above: that
              one is our own catalog round-trip; this one translates a FOREIGN feed (any column names)
              and matches by SKU. See feed-mapping.ts / feed-sync.ts. */}
          <div id="feed-panel" class="feed-panel border [border-color:var(--color-border)] rounded-[var(--radius)] p-[0.8rem] mb-3 bg-[color:var(--color-bg)] animate-bulk-bar-in" hidden
               data-store-id={store.id}
               data-feed-url={store.feedSync?.url ?? ''}
               data-feed-mapping={JSON.stringify(store.feedSync?.mapping ?? {})}
               data-last-sync={store.feedSync?.lastSyncAt ?? ''}>
            <div class="flex items-center justify-between text-[0.85rem] font-semibold [color:var(--color-muted)] uppercase tracking-[0.04em] mb-2">
              <span>{d.feedSyncTitle}</span>
              <button type="button" class="btn btn--ghost btn--sm" id="feed-panel-close" aria-label={d.csvClose}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <p class="muted text-[0.82rem] leading-[1.5] mb-3">{d.feedSyncLead}</p>

            {/* Live feed URL — the near-live path (a saved URL we pull on demand / on a future timer) */}
            <div class="flex flex-col gap-2 pb-3 mb-3 border-b [border-color:var(--color-border)]">
              <label for="feed-url-input" class="text-[0.82rem] font-semibold [color:var(--color-text)]">{d.feedUrlLabel}</label>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <input type="url" id="feed-url-input" inputmode="url" placeholder="https://…/inventory.csv" value={store.feedSync?.url ?? ''}
                  class="flex-1 min-w-0 font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] py-[.4rem] px-[.7rem] outline-none transition-colors duration-[120ms] focus:border-[color:var(--color-primary)]" />
                <button type="button" class="btn btn--ghost btn--sm shrink-0" id="feed-save-btn">{d.feedSaveUrl}</button>
                <button type="button" class="btn btn--sm shrink-0" id="feed-sync-now-btn">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                  {d.feedSyncNow}
                </button>
              </div>
              <span id="feed-last-sync" class="muted text-[0.78rem]" aria-live="polite"></span>
              <p class="muted text-[0.75rem] leading-[1.5] flex items-start gap-[0.3rem]">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[0.15rem]" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                <span>{d.feedManualNote}</span>
              </p>
            </div>

            {/* One-off upload — also how a seller sets/corrects the column mapping from a sample export */}
            <p class="muted text-[0.82rem] leading-[1.5] mb-2">{d.feedUploadHint}</p>
            <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:flex-wrap">
              <label class="btn btn--ghost btn--sm sm:!justify-start" for="feed-file-input">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                {d.csvChooseFile}
              </label>
              <input type="file" id="feed-file-input" accept=".csv,text/csv" hidden />
              <span id="feed-file-name" class="muted text-[0.8rem] overflow-hidden text-ellipsis whitespace-nowrap" aria-live="polite"></span>
            </div>

            {/* Outbound: share THIS store's live inventory OUT to another system via a tokenized,
                login-free URL (mirror of the inbound sync above). See /api/store-feed/[token].ts. */}
            <div id="feed-export" class="border-t [border-color:var(--color-border)] pt-[0.8rem] mt-[0.9rem]" data-store-id={store.id} data-feed-base={`${platformConfig.url}/api/store-feed/`}>
              <p class="text-[0.85rem] font-semibold [color:var(--color-muted)] uppercase tracking-[0.04em] mb-1">{d.feedExportTitle}</p>
              <p class="muted text-[0.82rem] leading-[1.5] mb-2">{d.feedExportLead}</p>
              <button type="button" class="btn btn--ghost btn--sm" id="feed-export-gen" hidden={!!store.feedExportToken}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                {d.feedExportCreate}
              </button>
              <div id="feed-export-active" hidden={!store.feedExportToken} class="flex flex-col gap-2">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                  <input type="text" id="feed-export-url" readonly value={store.feedExportToken ? `${platformConfig.url}/api/store-feed/${store.feedExportToken}` : ''}
                    class="flex-1 min-w-0 font-mono text-[.76rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] py-[.4rem] px-[.6rem] outline-none" />
                  <button type="button" class="btn btn--ghost btn--sm shrink-0" id="feed-export-copy">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    {d.feedExportCopy}
                  </button>
                </div>
                <p class="muted text-[0.78rem] leading-[1.5]">{d.feedExportFormatHint}</p>
                <div class="flex flex-wrap gap-2">
                  <button type="button" class="btn btn--ghost btn--sm" id="feed-export-regen">{d.feedExportRegen}</button>
                  <button type="button" class="btn btn--ghost btn--sm !text-[color:var(--color-danger)]" id="feed-export-revoke">{d.feedExportRevoke}</button>
                </div>
              </div>
            </div>

            <div id="feed-mapping" class="mt-[0.9rem]" hidden></div>
            <div id="feed-preview" class="mt-[0.9rem]" hidden></div>
          </div>

          {/* Bulk image upload panel */}
          <div id="bulk-upload-panel" class="bulk-upload-panel border [border-color:var(--color-border)] rounded-[var(--radius)] p-[0.8rem] mb-3 bg-[color:var(--color-bg)] animate-bulk-bar-in" hidden></div>

          {/* Unified toolbar row (CURRENT_TASK 2) — search + page-size + sort/
              filter all on ONE line. Search + page-size have no desktop-only
              home so they show at every width; sort/filter live in the table
              header on desktop (.table-toolbar is display:none there) and only
              join this row once the table collapses to cards ≤640px, where
              every control but the search goes icon/compact. All drive the same
              server refetch (initProductsToolbar / initPagination in
              products.ts). */}
          <div class="dash-toolbar" hidden={products.length === 0}>
            <div class="relative flex-1 min-w-[110px] max-w-[280px]">
              <svg class="absolute top-1/2 -translate-y-1/2 start-[0.7rem] pointer-events-none" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="color:var(--color-muted)"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="search" id="products-search-input" value={sellerProductQuery.q} placeholder={d.productsSearchPlaceholder ?? 'חיפוש מוצרים…'} class="w-full font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] ps-[1.9rem] pe-[.85rem] outline-none transition-colors duration-[120ms] focus:border-[color:var(--color-primary)]" />
            </div>
            <div class="inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-muted)] shrink-0 ms-auto">
              <span class="toolbar-btn-label">{d.itemsPerPageLabel ?? 'בעמוד:'}</span>
              <select id="products-page-size" class="font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.3rem] ps-[.6rem] pe-[1.6rem] outline-none cursor-pointer">
                {PRODUCTS_PAGE_SIZE_OPTIONS.map((n) => <option value={n} selected={n === productsPageSize}>{n}</option>)}
              </select>
            </div>
            {/* Sort/filter — display:none on desktop (they live in the table
                header there); flex only ≤640px where they join this row. */}
            <div class="table-toolbar">
            <button type="button" id="products-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
              <span id="products-sort-label" class="toolbar-btn-label">{d.sortOptDateDesc}</span>
              <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <button type="button" id="products-filter-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="true" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              <span class="toolbar-btn-label">{d.filterByLabel}</span>
              <span id="products-filter-count" class="filter-count-badge inline-flex items-center justify-center min-w-4 h-4 px-1 rounded-full bg-[color:var(--color-primary)] text-white text-[.68rem] font-bold leading-none" hidden>0</span>
