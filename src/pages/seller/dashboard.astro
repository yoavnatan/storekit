              <select id="products-page-size" aria-label={d.itemsPerPageLabel ?? 'בעמוד:'} class="font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.3rem] ps-[.6rem] pe-[1.6rem] outline-none cursor-pointer">
