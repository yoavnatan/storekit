{/* Revenue-breakdown modal — opened by clicking a bar in the "revenue over
    time" chart (performance.ts). Shows a donut of which products made up that
    day/month's revenue. Content is injected client-side. */}
<dialog id="perf-breakdown-modal" aria-labelledby="pbm-title" style="border:none;border-radius:14px;padding:0;width:min(440px,96vw);box-shadow:0 16px 56px rgba(0,0,0,0.26);background:var(--color-surface);margin:auto">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border)">
    <div>
      <h2 id="pbm-title" style="font-size:0.95rem;font-weight:700;margin:0">{d.perfBreakdownTitle}</h2>
      <p id="pbm-subtitle" class="muted" style="font-size:0.78rem;margin:0.15rem 0 0"></p>
    </div>
    <button id="perf-breakdown-close" type="button" aria-label={d.perfBreakdownClose} style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:none;background:none;color:var(--color-muted);cursor:pointer;flex-shrink:0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  {/* min-height keeps the dialog from resizing/recentering as content swaps
      (loading/empty ↔ donut), which read as a flicker on open.
      autofocus + tabindex=-1 catch showModal()'s initial focus here (outline
      suppressed) instead of on the close button, which otherwise opened with a
      visible focus ring. Keyboard Tab still reaches the close button normally. */}
  <div id="perf-breakdown-body" tabindex="-1" autofocus style="padding:1.25rem;min-height:19rem;display:flex;flex-direction:column;justify-content:center;outline:none"></div>
</dialog>

