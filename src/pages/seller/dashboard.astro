<script>
  /* ── Why this file loads in two stages ────────────────────────────────────
     Everything below used to be one module: 21 static imports, ~245 KB raw /
     61 KB gzipped, all of it downloaded and executed before ANY control on the
     page answered a click. Only one panel is ever on screen, so the seller was
     waiting on the JS of seven panels to use one — on a weak connection that
     showed up as dropdowns that simply did not open (owner, 2026-07-31).

     Stage 1 (static, below) is the shell only: tabs, the store switcher, the
     settings form, the cross-tab sync. Stage 2 is one dynamic import per panel,
     run when that panel is first shown — so the open tab is interactive after
     its own chunk, not after all of them. The rest are pulled in on idle, so a
     later tab switch is still instant.

     Adding a panel feature: put its module in that panel's LOADERS entry, not
     in the static list up here — a static import silently moves it back into
     the blocking bundle and undoes this. Order INSIDE a loader still matters
     (see the products one). */
  import { initSettingsForm, initFormToggles, initStoreSwitcher, initAutoHideStatus, initDashTabs, initStoreHours, initGotoPanelLinks, initStorePreviewLink } from '../../scripts/dashboard/ui.js';
  import { initInfoTooltips } from '../../scripts/tooltip.js';
  import { initUnsavedGuard } from '../../scripts/dashboard/unsaved-guard.js';
  import { initDashBarStack } from '../../scripts/dashboard/bar-stack.js';
  import { initCopyValueButtons } from '../../scripts/dashboard/copy-value.js';
  import { initDashTabSync } from '../../scripts/dashboard/tab-sync.js';
  import { initStickyOffsets } from '../../scripts/dashboard/sticky-offsets.js';
  import { initDiscountFields, refreshDiscountFieldsIn } from '../../scripts/dashboard/discount-field.js';
  // The panel filler. Stage 1 on purpose: a panel that has never been opened has no chunk of its
  // own yet, so the thing that FETCHES one cannot live inside it.
  import { swapPanel } from '../../lib/panel-swap.js';
  // Stage 1 on purpose, small as it is: it is what reports a STAGE 2 chunk that
  // never arrived, so it cannot be behind the same dynamic import that failed.
  import { showErrorToast } from '../../lib/toast.js';

  const uploadCfg = document.getElementById('upload-config');
  const CLOUD  = uploadCfg?.dataset.cloud  ?? '';
  const PRESET = uploadCfg?.dataset.preset ?? '';

  function dashI18n(): Record<string, string> {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}').dashboard ?? {}; }
    catch { return {}; }
  }

  // clean status params from URL + handle deep-link params
  {
    const u = new URL(window.location.href);
    if (u.searchParams.has('saved') || u.searchParams.has('added')) {
      u.searchParams.delete('saved'); u.searchParams.delete('added'); history.replaceState(null, '', u.toString());
    }
  }

  // First: it observes fetch, so it should be in place before anything can save.
  initDashTabSync(uploadCfg?.dataset.storeId ?? '');
  initDashTabs();
  // **At page LOAD, not when the products panel opens** (owner, סשן ד׳: a small gap above a
  // panel's pinned title, *"שכשגוללים רואים תוכן שעובר מאחורה"*). This measures the site header
  // and the tab strip into the two custom properties every sticky `top:` on this page is written
  // against. It used to run only inside the products panel's loader — so on any OTHER tab the CSS
  // fell back to its guessed heights (3.3rem/2.9rem against a real 54.39px/45.17px), the strip
  // pinned 1.59px under the header and the panel title 1.2px under the strip. 1.2px of daylight is
  // not a misaligned edge: the page scrolls through it, so it reads as a moving line.
  initStickyOffsets();
  // The document-level halves, which have nothing to do with which panel is on screen and must be
  // registered exactly once.
  initDiscountFields();
  initUnsavedGuard();
  // The three floating notices are raised by three unrelated owners (one of them the inline draft
  // guard); this is the one thing that knows where each of them SITS, so that two showing at once
  // stack tight and one showing alone sits on the bottom edge.
  initDashBarStack();
  // Delegated, so it covers the copy button in the header AND the ones in the settings panel,
  // which only exists after the click that opens it.
  initCopyValueButtons();
  initStorePreviewLink();
  initStoreSwitcher();
  initAutoHideStatus();
  // And the panel-scoped ones, for whichever panel the server rendered into this response. The
  // other nine get the same pass as each is filled — see `wireSharedControls`.
  // (The Products tab carries its own "(i)" explanations — SKU / tags / variants / specs — and
  // those are the terms a first-time seller does not know. `initInfoTooltips` used to run only from
  // the advertising and performance tabs' own lazy init, so a tooltip outside those two was inert
  // markup, the stock-alert badge's own included.)
  wireSharedControls();

  // Keeps the store-switcher title dot (and this store's own row-dot in the dropdown) in sync as
  // orders get handled, messages get read and stock gets restocked — without a page reload.
  //
  // **The current store's level is read off its own TAB STRIP, and that is the whole design.** It
  // used to count `.order-new-dot` / `.msg-table__row--unread` in the document, which are rows
  // inside PANELS — and nine of the ten panels only arrive on the click that opens them
  // (`fillPanel`; until then the shell carries `data-lazy`). So on any other tab those selectors
  // match nothing whether or not the shop has pending orders, and the old code read that silence as
  // "nothing waiting": handling an order on the Orders tab already cleared a dot that unread MAIL
  // was holding up, and adding stock to the dot would have made the same mistake routine, since an
  // inline stock edit re-runs this from a panel that can see neither.
  //
  // The strip is rendered whichever panel is open, and `orders.ts` / `messages.ts` / `products.ts`
  // all already maintain their marker there — so it is the one surface that is both always present
  // and always current, and each marker declares its own severity in the same vocabulary the server
  // uses (`data-tab-alert`, lib/seller-alerts.ts). A dot in the switcher now means exactly what the
  // seller would see on that shop's tabs, which is also what makes it impossible for the two to
  // disagree.
  const PER_STORE_TABS = ['tab-orders', 'tab-returns', 'tab-messages', 'tab-products', 'tab-advertising'];
  const TAB_RANK: Record<string, number> = { danger: 2, warning: 1 };

  /** The loudest live marker on this store's tabs, or null. */
  function currentStoreTabLevel(): string | null {
    let level: string | null = null;
    for (const tabId of PER_STORE_TABS) {
      // Named tabs, never the whole strip: the Payments tab's dot is the missing BANK DETAILS,
      // which is account-wide and covers every shop at once. `seller-alerts.ts` keeps it out of the
      // per-store map for that reason — the same flag on every row says "all of your stores" when
      // the truth is "none of them" — and reading the strip wholesale would put it back.
      document.querySelectorAll<HTMLElement>(`#${tabId} [data-tab-alert]`).forEach((marker) => {
        if (marker.hidden) return;
        const sev = marker.getAttribute('data-tab-alert');
        if (!sev || !(sev in TAB_RANK)) return;
        if (!level || TAB_RANK[sev] > TAB_RANK[level]) level = sev;
      });
    }
    return level;
  }

  function updateSwitcherAlertDot(): void {
    const switcherBtn = document.getElementById('store-switcher-btn');
    const menu        = document.getElementById('store-switcher-menu');
    if (!switcherBtn || !menu) return;

    const label = (level: string, other: boolean): string => {
      const key = other
        ? (level === 'danger' ? menu.dataset.strAlertDotOther : menu.dataset.strAlertDotOtherWarning)
        : (level === 'danger' ? menu.dataset.strAlertDot : menu.dataset.strAlertDotWarning);
      return key ?? 'יש התראות';
    };
    // A dot that exists but declares nothing is red, matching the CSS default.
    const levelOf = (dot: HTMLElement): string => dot.dataset.level || 'danger';

    const currentLink = menu.querySelector<HTMLElement>('a.store-option--current');
    if (currentLink) {
      const dotHost = currentLink.querySelector<HTMLElement>('.store-switcher__item-actions');
      const dot     = currentLink.querySelector<HTMLElement>('.store-switcher__item-dot');
      const currentLevel = currentStoreTabLevel();
      if (currentLevel && !dot && dotHost) {
        const newDot = document.createElement('span');
        newDot.className = 'store-switcher__item-dot';
        newDot.dataset.level = currentLevel;
        // Wording off the menu's own data attributes, so this rebuild and the
        // server-rendered dot above it can never disagree.
        newDot.setAttribute('aria-label', label(currentLevel, false));
        dotHost.prepend(newDot);
      } else if (currentLevel && dot && levelOf(dot) !== currentLevel) {
        // The last pending order handled on a shop that is also low on stock demotes the dot
        // rather than removing it — without this it would stay red over an amber fact.
        dot.dataset.level = currentLevel;
        dot.setAttribute('aria-label', label(currentLevel, false));
      } else if (!currentLevel && dot) {
        dot.remove();
      }
    }

    // Button dot only reflects OTHER stores — the whole point is to send the
    // seller there. If it's the current store's own alert, they're already
    // looking at it, so it's excluded here (see otherStoresLevel above).
    const otherDots = Array.from(menu.querySelectorAll<HTMLElement>('.store-switcher__item-dot'))
      .filter((dot) => !dot.closest('a')?.classList.contains('store-option--current'));
    const otherLevel = otherDots.some((dot) => levelOf(dot) === 'danger')
      ? 'danger'
      : otherDots.length > 0 ? 'warning' : null;
    let btnDot = switcherBtn.querySelector<HTMLElement>('.store-switcher__alert-dot');
    if (otherLevel && !btnDot) {
      btnDot = document.createElement('span');
      btnDot.className = 'store-switcher__alert-dot';
      btnDot.dataset.level = otherLevel;
      btnDot.setAttribute('aria-label', label(otherLevel, true));
      switcherBtn.querySelector('.store-switcher__chevron')?.after(btnDot);
    } else if (otherLevel && btnDot && levelOf(btnDot) !== otherLevel) {
      btnDot.dataset.level = otherLevel;
      btnDot.setAttribute('aria-label', label(otherLevel, true));
    } else if (!otherLevel && btnDot) {
      btnDot.remove();
    }
  }

  // The warning half of the current store's dot is read off the TAB STRIP's own markers, and the
  // strip is written to by code that knows nothing about the switcher — `updateStockBadge` in
  // products.ts flips the badge's `hidden` after an inline stock edit. Watching the strip instead
  // of threading a callback through every one of those writers is what keeps the two in step, and
  // it is the same observation `tab-alert-edges.ts` already makes for the off-screen beacon. The
  // danger half stays on its explicit callbacks: those markers live inside the panels, not here.
  const alertStrip = document.querySelector<HTMLElement>('.dash-tabs');
  if (alertStrip && 'MutationObserver' in window) {
    new MutationObserver(updateSwitcherAlertDot).observe(alertStrip, {
      subtree: true,
      childList: true,
      attributes: true,
      attributeFilter: ['hidden', 'data-tab-alert'],
    });
  }

  // ── Stage 2: one chunk per panel ─────────────────────────────────────────
  // The image editors are shared (product photos in Products, banner/avatar in
  // Settings), so they get their own memoised loader rather than being pulled
  // into whichever panel happens to hydrate first.
  let editorsPromise: Promise<void> | null = null;
  function imageEditors(): Promise<void> {
    editorsPromise ??= (async () => {
      const [crop, cleanup] = await Promise.all([
        import('../../scripts/dashboard/crop-modal.js'),
        import('../../scripts/dashboard/cleanup-modal.js'),
      ]);
      crop.initCropModal();
      cleanup.initCleanupModal();
    })();
    return editorsPromise;
  }

  /**
   * A panel's client side, in TWO steps: fetch its chunk, then wire what arrived.
   *
   * It used to be one step, and one step stopped working the day the panel's HTML stopped being
   * server-rendered (2026-08-11). Every `init*` below binds against elements that have to already
   * exist, so wiring a panel that has not been filled yet wires nothing — and since the wiring runs
   * once, nothing would ever wire it again. Splitting the two lets the fill and the chunk travel at
   * the same time and the wiring happen after BOTH, which is the only order that works.
   *
   * The wiring step is deliberately NOT re-runnable: about thirty of these listeners are delegated
   * at the document, so calling a panel's init twice would answer every click twice.
   */
  const LOADERS: Record<string, () => Promise<() => void>> = {
    products: async () => {
      const [p, gallery, csv, picker, select, seo, feed, specs] = await Promise.all([
        import('../../scripts/dashboard/products.js'),
        import('../../scripts/dashboard/gallery.js'),
        import('../../scripts/dashboard/csv-import.js'),
        import('../../scripts/dashboard/category-picker.js'),
        import('../../scripts/dashboard/select-dropdown.js'),
        import('../../scripts/dashboard/product-seo.js'),
        // The external-inventory panel is rendered by THIS panel (#feed-panel, beside the CSV one)
        // and was being wired by `settings` — so on a fresh load the "סנכרון מלאי חיצוני" button
        // was dead: `initFeedSync` binds `#toggle-feed-panel`, which nothing had imported yet.
        // Opening Settings first happened to fix it, which is why it survived every test and every
        // demo. Found 2026-08-19 by driving the panel in a browser rather than reasoning about it.
        import('../../scripts/dashboard/feed-sync.js'),
        import('../../scripts/dashboard/spec-suggest.js'),
        imageEditors(),
      ]);
      return () => {
      // Delegated at the document, so it covers rows the table rebuilds later too. Registered
      // first because it only ever reads the form and rewrites a block of static text — it can
      // never interfere with an editor below, and every one of them writes fields it reads.
      seo.initProductSeoHints();
      p.initSpecsEditors();
      // After the spec editor, before the rest: it only reads the מפרט rows and writes into them,
      // and its own listeners are delegated at the document like the editors' are.
      specs.initSpecSuggestions();
      // Registered before the editors below: its document-level click listener
      // must see the pre-click "is anything armed?" state before either editor's
      // own listener arms a *new* confirm on this same click — otherwise the
      // just-armed span looks like a stale one (its trigger element just got
      // replaced) and gets cancelled in the same event that armed it.
      p.initRemoveConfirm();
      p.initVariantEditors();
      p.initLockedStockHint();
      p.initTagsEditor();
      p.initStockBreakdowns();
      // Panel-scoped for the same reason as the pickers below — every gallery widget happens to
      // live in this panel today, so this changes nothing now and stops the sweep from becoming
      // the reason a widget in some other panel appears to work.
      document.querySelectorAll<Element>('#dash-panel-products .gallery-widget').forEach((g) => gallery.initGalleryWidget(g));
      p.bindExistingRows(CLOUD, PRESET);
      // The inline draft guard's way in: it can tell the seller a product has unsaved work waiting
      // from last time, but only this panel can open the row it belongs in.
      window.__dashOpenProductEdit = p.openProductEditRow;
      // …and the other half of the same answer: a mark on every row whose product has unsaved work
      // waiting, so several of them are one glance rather than one notice at a time.
      p.initDraftMarks();
      // Scoped to THIS panel, and that is part of the fix rather than a tidy-up: while it swept the
      // whole document it also bound the pickers of two panels that wire none of their own, so
      // those worked or did not depending on which tab the seller opened first — and in the
      // ordinary order they did not (see category-picker.ts#bindCategoryPickersIn).
      picker.bindCategoryPickersIn('dash-panel-products');
      p.initAddProduct(CLOUD, PRESET);
      p.initProductMenus();
      p.initDeleteProduct();
      p.initProductVisibilityToggle();
      p.initProductFeatureToggle();
      p.initProductsToolbar();
      p.initBulkSelect(CLOUD, PRESET);
      csv.initCsvImport();
      // Beside its twin, because they are the same shape: two panels rendered by this tab, each
      // wired by the tab that renders it.
      feed.initFeedSync();
      p.initThumbs();
      // The chips the SERVER rendered — the client sweep only covers rows it rebuilt itself.
      p.initCategoryChipTips();
      p.initInlineEdit();
      p.initPagination();
      // Page-size native <select> → app dropdown (compact pill matching the
      // sort/filter chips beside it). Keeps the select as value source, so
      // initPagination's `change` listener is untouched (CURRENT_TASK 2).
      const pageSizeSelect = document.getElementById('products-page-size') as HTMLSelectElement | null;
      // menuAutoWidth + menuHeading, both for the same ≤640px problem: the trigger is a pill
      // holding one short number, the menu was pinned to that width (so "100" clipped to an
      // ellipsis), and the text label beside it is hidden at that width (so the open list was four
      // unexplained numbers). The heading names them and the auto width lets them all fit.
      if (pageSizeSelect) select.initSelectDropdown(pageSizeSelect, {
        triggerClassName: select.COMPACT_TRIGGER_CLASS,
        menuAutoWidth: true,
        menuHeading: dashI18n().itemsPerPageLabel,
      });
      // Called again here, and only for one of the three bars it measures: `.products-header`
      // lives INSIDE this panel, so at page load it does not exist yet and its var falls back.
      // The header and the strip were already measured then and are not observed twice.
      p.initStickyOffsets();
      p.initViewProduct();
      };
    },

    orders: async () => {
      const { initOrdersTab } = await import('../../scripts/dashboard/orders.js');
      return () => initOrdersTab(updateSwitcherAlertDot);
    },

    returns: async () => {
      const { initReturnsTab } = await import('../../scripts/dashboard/returns.js');
      return () => initReturnsTab();
    },

    messages: async () => {
      const [{ initMessagesTab }, { initPlatformInquiry }] = await Promise.all([
        import('../../scripts/dashboard/messages.js'),
        import('../../scripts/dashboard/platform-inquiry.js'),
      ]);
      return () => { initMessagesTab(updateSwitcherAlertDot); initPlatformInquiry(); };
    },

    performance: async () => {
      const { initPerformanceTab } = await import('../../scripts/dashboard/performance.js');
      return () => initPerformanceTab();
    },

    reports: async () => {
      const { initReportsTab } = await import('../../scripts/dashboard/reports.js');
      return () => initReportsTab();
    },

    advertising: async () => {
      const { initAdvertisingTab } = await import('../../scripts/dashboard/advertising.js');
      return () => initAdvertisingTab();
    },

    promotions: async () => {
      // Two modules for one tab, loaded together: the coupon card fetches its own list on first
      // open (it is not rendered server-side — see CouponsCard.astro), so it has to be booted with
      // the tab and not on some later interaction.
      const [promo, coupons] = await Promise.all([
        import('../../scripts/dashboard/promotions.js'),
        import('../../scripts/dashboard/coupons.js'),
      ]);
      return () => {
        promo.initPromotionsTab();
        coupons.initCouponsCard();
      };
    },

    payouts: async () => {
      const { initPayoutsTab, watchPayoutsFreshness } = await import('../../scripts/dashboard/payouts.js');
      return () => {
        initPayoutsTab();
        // Once per page: it survives the panel being replaced by a refresh, which `initPayoutsTab`
        // deliberately does not (it binds the form that was just swapped out).
        watchPayoutsFreshness();
      };
    },

    settings: async () => {
      // No feed-sync here: its panel is rendered by `products`, which now wires it. Binding it from
      // both would answer every click twice, which is the documented cost of a second init.
      const [img, tree, domain, lifecycle, url, storeCats, headerLogo] = await Promise.all([
        import('../../scripts/dashboard/store-image.js'),
        import('../../scripts/dashboard/category-tree.js'),
        import('../../scripts/dashboard/custom-domain.js'),
        import('../../scripts/dashboard/store-lifecycle.js'),
        import('../../scripts/dashboard/store-url.js'),
        import('../../scripts/store-category-picker.js'),
        import('../../scripts/dashboard/header-logo.js'),
        imageEditors(),
      ]);
      return () => {
      const i18n = dashI18n();
      const labels = {
        upload: i18n.uploadImage ?? 'Upload image',
        change: i18n.storeImageChange ?? 'Change image',
        adjust: i18n.adjustImage ?? 'Adjust',
        remove: i18n.removeImage ?? 'Remove',
        uploading: i18n.uploadingImage ?? 'Uploading image…',
        loading: i18n.loadingImage ?? 'Loading image…',
        failed: i18n.uploadFailed ?? 'Image upload failed',
        loadFailed: i18n.imageLoadFailed ?? 'Could not load the image',
        removingBg: i18n.removingBg ?? 'Removing background…',
        bgFailed: i18n.removeBackgroundFailed ?? 'Could not remove the background',
      };
      img.initStoreImageWidget({
        frameId: 'banner-frame', fileInputId: 'banner-file-input', hiddenInputId: 'banner-image-input',
        sourceInputId: 'banner-source-input', uploadBtnId: 'banner-upload-btn',
        adjustBtnId: 'banner-adjust-btn', removeBtnId: 'banner-remove-btn',
        aspect: 3, vpWidth: 420, previewWidth: 900, cloud: CLOUD, preset: PRESET, labels,
      });
      img.initStoreImageWidget({
        frameId: 'avatar-frame', fileInputId: 'avatar-file-input', hiddenInputId: 'avatar-image-input',
        sourceInputId: 'avatar-source-input', uploadBtnId: 'avatar-upload-btn',
        adjustBtnId: 'avatar-adjust-btn', removeBgBtnId: 'avatar-bg-btn', removeBtnId: 'avatar-remove-btn',
        // `round`: the avatar is drawn in a circle everywhere on the site (StoreAvatar), so the
        // crop tool has to show a circle. Framing to a square and rendering a circle is what made
        // the picture "not sit right" — a fifth of what the seller lined up was cut by a shape
        // that was never on screen.
        aspect: 1, vpWidth: 220, previewWidth: 200, round: true, cloud: CLOUD, preset: PRESET, labels,
      });
      // Its own module, not a third `initStoreImageWidget` call: a logo is never cropped, so it
      // shares that widget's uploader and background worker by import and none of its crop flow
      // (header-logo.ts's header says why in full).
      headerLogo.initHeaderLogoCard({ cloud: CLOUD, preset: PRESET, labels });
      tree.initCategoryTreeEditor();
      domain.initCustomDomain();
      lifecycle.initStoreLifecycle();
      url.initStoreUrl();
      storeCats.initAllStoreCategoryPickers();
      };
    },
  };

  // A panel's chunk, fetched at most once — separately from wiring it, so the idle prefetch below
  // can warm a tab the seller has not opened without wiring an empty container.
  // Object.hasOwn, not a bare lookup: `panel` comes from a DOM id, and a plain object literal
  // answers "constructor"/"toString" from its prototype — calling one of those would throw where an
  // unknown panel should simply do nothing.
  const chunks = new Map<string, Promise<() => void>>();
  function panelChunk(panel: string): Promise<() => void> {
    let loading = chunks.get(panel);
    if (!loading) {
      const loader = Object.hasOwn(LOADERS, panel) ? LOADERS[panel] : undefined;
      loading = loader?.() ?? Promise.resolve(() => { /* nothing to wire */ });
      chunks.set(panel, loading);
    }
    return loading;
  }

  /**
   * Ask the server for ONE panel and put its contents in the shell it left empty.
   *
   * The page renders one panel's data per request (`?panel=X`, SELLER_LAZY_PANELS_PLAN.md) — it
   * used to build all ten and let the tab strip hide nine, which is ~865KB of HTML for one tab's
   * worth of answer. The other nine arrive here, on the click that opens them.
   *
   * **The URL carries no params but the store and the panel.** A panel being opened for the first
   * time has no filter state of its own — anything else in the address bar belongs to the tab being
   * LEFT. A deep link like `?panel=orders&opay=unshipped` is a different case entirely: that panel
   * is the one the server already rendered, so it is never lazy.
   *
   * `data-lazy` is removed BEFORE the fetch starts, so a double click cannot start two loads. On
   * failure `swapPanel` falls back to a real navigation, which is the one thing guaranteed to
   * produce a filled panel.
   */
  function fillPanel(panel: string): Promise<void> {
    const el = document.getElementById(`dash-panel-${panel}`);
    if (!el?.hasAttribute('data-lazy')) return Promise.resolve();
    el.removeAttribute('data-lazy');
    const params = new URLSearchParams({ panel });
    const storeId = document.getElementById('upload-config')?.dataset.storeId;
    if (storeId) params.set('store', storeId);
    // `pushUrl: false` — <DashTabsBoot> already wrote `?panel=` into the address bar the moment the
    // tab was activated, and a second entry for the same place is a back button that has to be
    // pressed twice. `busy: false` — the shell is showing its placeholder, which already says
    // "loading" without a chip on top of it.
    return swapPanel(`/seller/dashboard?${params.toString()}`, el.id, () => {
      wireSharedControls(el);
      // Forms the draft guard has never seen. Without this a crash would lose work typed into any
      // tab but the one the page was opened on, and nothing anywhere would report it.
      //
      // Only here, never from the load-time call above: this module is a DEFERRED script, so it
      // runs BEFORE `DOMContentLoaded` — and the guard's own load scan, which fires there, resets
      // its offer table without taking down any bar an earlier scan had already inserted. A scan
      // from stage 1 would therefore leave the seller looking at two identical "restore your
      // draft?" bars in one form.
      window.__dashScanDrafts?.(el);
    }, { busy: false, pushUrl: false });
  }

  /**
   * The controls the SHELL script owns that happen to live inside a panel — the settings form, the
   * add-product toggle, the opening-hours editor, the overview's jump-to-tab cards, the "(i)"
   * tooltips and the discount readouts.
   *
   * They are wired once at load for the panel the server rendered, and again for each panel as it
   * is filled, because none of those elements existed when the page loaded. Every one of them is
   * safe to call twice: the `ui.ts` group mark the element they bound (`bindOnce`) and the tooltip
   * and discount initialisers have always done so.
   */
  function wireSharedControls(root: ParentNode = document): void {
    initSettingsForm();
    initFormToggles();
    initStoreHours();
    initGotoPanelLinks();
    initInfoTooltips(root);
    // Paint the "-25% → ₪X" readout on the blocks that just arrived, and turn their <select> into
    // the app dropdown — the document-level listener behind them was registered at load and covers
    // them already, but nothing has drawn them yet.
    refreshDiscountFieldsIn(root);
  }

  const hydrated = new Map<string, Promise<void>>();
  function hydrate(panel: string): Promise<void> {
    let running = hydrated.get(panel);
    if (!running) {
      // A panel that fails to load must not block the others, and must not be
      // retried on every tab switch — the entry stays, rejected once, logged once.
      //
      // The fill and the chunk travel TOGETHER and the wiring happens after both: every `init*` in
      // this panel binds against elements that must already exist, so wiring before the fill lands
      // wires nothing — and the wiring runs once, so nothing would ever come back for it.
      let failed = false;
      running = Promise.all([fillPanel(panel), panelChunk(panel)])
        .then(([, wire]) => { wire(); })
        .catch((err) => { failed = true; console.error(`panel "${panel}" failed to load`, err); })
        .then(() => {
          const el = document.getElementById(`dash-panel-${panel}`);
          el?.removeAttribute('data-hydrating');
          // Every control in this tab is now permanently dead — the chunk is not
          // coming and nothing retries it. A console line is not a user-facing
          // message, and silence here is the same dead-button report the pulse
          // and the replay below exist to answer, only unrecoverable. Say it,
          // and only when the seller is actually looking at this tab: the idle
          // prefetch warms all seven, and a toast for one they never opened is
          // noise about a problem they do not have yet.
          if (failed && el && !el.hidden) {
            showErrorToast(dashI18n().dashPanelLoadFailed ?? 'This tab did not load. Please reload the page and try again.');
          }
          // A menu the seller already tried to open while this panel was still
          // arriving (recorded by <DashTabsBoot />). Now that its handler exists,
          // give them what they asked for instead of a tap that vanished.
          // …but only while that panel is still the one on screen. A menu
          // popping open inside a hidden panel — or in a tab the seller left
          // ten seconds ago — is a surprise, not the thing they asked for.
          const pending = window.__dashPendingClick;
          const replay = pending?.isConnected && el && !el.hidden && el.contains(pending) ? pending : null;
          // The waiting pulse stops BEFORE the replay, not after: the replayed
          // handler is arbitrary panel code, and if it throws, a control left
          // pulsing forever on top of the failure is the worse of the two bugs.
          el?.querySelectorAll<HTMLElement>('[data-opening]').forEach((n) => n.removeAttribute('data-opening'));
          if (replay) { window.__dashPendingClick = null; replay.click(); }
        })
        // A throw in any of the above must not leave an unhandled rejection —
        // silent there, and it hides exactly this kind of ordering bug.
        .catch((err) => { console.error(`panel "${panel}" post-load step failed`, err); });
      hydrated.set(panel, running);
    }
    return running;
  }

  // A panel switched to later hydrates on the way in. Registered before the
  // deep-link block below, which relies on it.
  document.addEventListener('dashtab:show', (e) => {
    const id = (e.target as HTMLElement | null)?.id ?? '';
    if (id.startsWith('dash-panel-')) void hydrate(id.slice('dash-panel-'.length));
  });

  // What the seller is actually looking at goes first — including a tab the
  // inline <DashTabsBoot /> already switched to while this module was still in
  // flight. The bar goes only when that panel can answer a click.
  {
    const open = document.querySelector<HTMLElement>('[role="tab"].dash-tab--active')?.dataset.panel;
    void (open ? hydrate(open) : Promise.resolve()).then(() => {
      // The sweep goes, the 3px track stays: removing the whole bar would shift
      // every panel up by its height the instant hydration finished.
      const bar = document.getElementById('dash-hydrating-bar');
      bar?.firstElementChild?.remove();
      bar?.removeAttribute('role');
      // Every other panel's CHUNK, once the browser is idle: a later tab switch then pays only for
      // its HTML, without any of this competing with the panel on screen. Deliberately the chunk
      // and not `hydrate` — the other nine are empty shells until they are opened, and wiring an
      // empty container binds nothing while spending the one wiring each panel gets.
      const idle = window.requestIdleCallback ?? ((cb: () => void) => window.setTimeout(cb, 1500));
      idle(() => { Object.keys(LOADERS).forEach((id) => void panelChunk(id).catch(() => { /* reported when the tab is opened */ })); });
    });
  }

  // Deep-link: ?panel=messages&msg=<id>
  {
    const params = new URLSearchParams(window.location.search);
    const panel  = params.get('panel');
    const msgId  = params.get('msg');
    if (panel) {
      // CSS.escape: `panel` is request-supplied, and a value carrying a quote or
      // bracket makes this an invalid selector — querySelector then THROWS, and
      // everything initialised after this block silently never runs. Same
      // treatment `msgId` already gets below.
      const tabBtn = document.querySelector<HTMLButtonElement>(`[role="tab"][data-panel="${CSS.escape(panel)}"]`);
      // The SERVER already renders ?panel=… as the open tab, so clicking it here
      // re-activated a tab that was already active — a no-op the seller could see
      // (feedback_noop_interactions_invisible), and on a refresh it ran while the
      // browser was still restoring the scroll position. The panel's own lazy
      // loaders listen for `dashtab:show`, so fire just that for the tab that is
      // already open, and click only when the deep link disagrees with the DOM.
      if (tabBtn && !tabBtn.classList.contains('dash-tab--active')) tabBtn.click();
      else document.getElementById(`dash-panel-${panel}`)?.dispatchEvent(new CustomEvent('dashtab:show', { bubbles: true }));
      if (msgId && panel === 'messages') {
        // After the messages chunk, not on the next frame: the thread card's own
        // click handler ships with that module.
        void hydrate('messages').then(() => requestAnimationFrame(() => {
          const card = document.querySelector<HTMLElement>(`[data-msg-id="${CSS.escape(msgId)}"]`);
          if (card) { card.click(); card.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        }));
      }
    }
    if (msgId) {
      const u = new URL(window.location.href);
      u.searchParams.delete('msg');
      history.replaceState(null, '', u.toString());
    }
  }
</script>
