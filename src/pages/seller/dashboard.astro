---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getStoresBySellerId, createStore, updateStore, STORE_WEEKDAYS } from '../../lib/stores.js';
import { DEFAULT_STORE_HOURS } from '../../lib/store-hours.js';
import {
  getProductsByStoreId,
  createProduct,
  updateProduct,
  deleteProduct,
} from '../../lib/store-products.js';
import { formatPrice, cdnSrc } from '../../config/store.config.js';
import { galleryWidgetHtml } from '../../lib/gallery-widget.js';
import { getLang, getT } from '../../i18n/index.js';
import { getAllWishlistCounts } from '../../lib/wishlist-counts.js';
import { getFavoriteStoreCount } from '../../lib/store-favorite-counts.js';
import { thumbUrl } from '../../lib/cloudinary.js';
import { getMessagesBySeller, getMessageReplies } from '../../lib/messages.js';
import { getAdminMessagesForSeller, getUnreadCountForSellerFromAdmin } from '../../lib/admin-messages.js';
import { formatHeDateTime } from '../../lib/format-date.js';
import { getOrdersByStoreSlug } from '../../lib/orders.js';
import type { Order } from '../../lib/orders.js';
import { getSellerStoreAlerts } from '../../lib/seller-alerts.js';
import { resolveVariantColor, isColorVariant } from '../../lib/color-variants.js';
import { comboKey, generateCombos, LOW_STOCK_THRESHOLD, type VariantDimension } from '../../lib/variant-combo.js';
import { getCategoriesByStoreId, buildCategoryTree, categoryPath } from '../../lib/store-categories.js';

// Splits `total` across `count` rows as evenly as possible (remainder to the
// first rows) so seeding legacy combos never silently changes the sum.
function evenSplit(count: number, total: number): number[] {
  if (count <= 0) return [];
  const base = Math.floor(total / count);
  const remainder = total - base * count;
  return Array.from({ length: count }, (_, i) => base + (i < remainder ? 1 : 0));
}

// Color dimensions must go through resolveVariantColor() before display — a
// custom color assigned via the picker is stored as "name #hex", and without
// stripping it the hex code leaks straight into the label. Each part also
// carries its resolved hex (color dimensions only) so the template can render
// a small swatch right next to the color name, easy to tell apart at a glance.
interface ComboLabelPart { text: string; hex: string | null }

function comboLabelParts(dims: VariantDimension[], combo: Record<string, string>): ComboLabelPart[] {
  return dims.map((d) => {
    const raw = combo[d.name] ?? '';
    if (!isColorVariant(d.name)) return { text: raw, hex: null };
    const { display, hex } = resolveVariantColor(raw);
    return { text: display, hex };
  });
}

function variantCombosData(variants: VariantDimension[], variantStock: Record<string, number> | undefined, totalStock: number) {
  const stockMap = variantStock ?? {};
  const hasAnyStock = Object.keys(stockMap).length > 0;
  const rawCombos = variants.length ? generateCombos(variants) : [];
  const splitDefaults = hasAnyStock ? [] : evenSplit(rawCombos.length, totalStock);
  const combos = rawCombos.map((combo, idx) => {
    const key = comboKey(combo);
    const parts = comboLabelParts(variants, combo);
    const value = key in stockMap ? stockMap[key] : (hasAnyStock ? 0 : (splitDefaults[idx] ?? 0));
    return { key, parts, value };
  });
  return { hasAnyStock, combos };
}

const lang = getLang(Astro.cookies);
const t    = getT(lang);
const d    = t.dashboard;
const g    = t.gallery;

const sellerId = getSellerSession(Astro.cookies);
if (!sellerId) return Astro.redirect('/seller/login');

const cloudinaryCloud = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? '';
const cloudinaryPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET ?? '';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'save-settings');

  if (action === 'save-settings') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    if (!name) {
      error = d.storeNameRequired;
    } else {
      const stores = getStoresBySellerId(sellerId);
      const target = stores.find((s) => s.id === storeId) ?? stores[0];
      if (target) {
        updateStore(target.id, { name, tagline, description, colors: target.colors });
        return Astro.redirect(`/seller/dashboard?store=${target.id}&saved=1`);
      }
    }
  } else if (action === 'create-store') {
    const name = String(form.get('name') || '').trim();
    const tagline = String(form.get('tagline') || '').trim();
    const description = String(form.get('description') || '').trim();
    if (!name) {
      error = d.storeNameRequired;
    } else {
      const { id: newStoreId } = createStore(sellerId, { name, tagline, description });
      return Astro.redirect(`/seller/dashboard?store=${newStoreId}`);
    }
  } else if (action === 'add-product') {
    const storeId = String(form.get('storeId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else {
      createProduct(storeId, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      return Astro.redirect(`/seller/dashboard?store=${storeId}&added=1`);
    }
  } else if (action === 'edit-product') {
    const productId = String(form.get('productId') || '');
    const name = String(form.get('name') || '').trim();
    const description = String(form.get('description') || '').trim();
    const price = parseFloat(String(form.get('price') || '0'));
    const stock = parseInt(String(form.get('stock') || '0'), 10);

    if (!name) {
      error = d.productNameRequired;
    } else if (isNaN(price) || price < 0) {
      error = d.priceInvalid;
    } else {
      updateProduct(productId, { name, description, price, stock: isNaN(stock) ? 0 : stock });
      const sid = Astro.url.searchParams.get('store') ?? '';
      return Astro.redirect(sid ? `/seller/dashboard?store=${sid}` : '/seller/dashboard');
    }
  } else if (action === 'delete-product') {
    const productId = String(form.get('productId') || '');
    const sid = String(form.get('storeId') || '');
    deleteProduct(productId);
    return Astro.redirect(sid ? `/seller/dashboard?store=${sid}` : '/seller/dashboard');
  }
}

const allStores = getStoresBySellerId(sellerId);
const hasNoStore = allStores.length === 0;

// No ?store= in the URL (e.g. arriving fresh via the header's "seller
// dashboard" link) falls back to whichever store the seller was last on,
// not always the first one — persisted via a cookie since this is an SSR
// redirect target, not something a client-side script can decide before
// the page renders.
const LAST_STORE_COOKIE = 'seller_last_store';
const queryStoreId = Astro.url.searchParams.get('store');
const lastStoreId = Astro.cookies.get(LAST_STORE_COOKIE)?.value ?? '';
const activeStoreId = hasNoStore ? '' : (queryStoreId ?? lastStoreId);
const store = hasNoStore ? undefined : (allStores.find((s) => s.id === activeStoreId) ?? allStores[0]);
if (store && store.id !== lastStoreId) {
  Astro.cookies.set(LAST_STORE_COOKIE, store.id, {
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: 'lax',
    path: '/',
    maxAge: 60 * 60 * 24 * 180,
  });
}
const settingsSuccess = !hasNoStore && Astro.url.searchParams.get('saved') === '1';
const productSuccess = !hasNoStore && Astro.url.searchParams.get('added') === '1';
const products = store
  ? getProductsByStoreId(store.id).sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  : [];
const storeCategoryList = store ? getCategoriesByStoreId(store.id) : [];
const categoryTree = buildCategoryTree(storeCategoryList);
const productCategoryPaths = new Map(products.map((p) => [p.id, p.categoryId ? categoryPath(storeCategoryList, p.categoryId) : '']));
const wishlistCounts = store ? getAllWishlistCounts() : ({} as Record<string, number>);
const storeFavoriteCount = store ? getFavoriteStoreCount(store.slug) : 0;
const productCount = products.length;
const inStockCount = products.filter((p) => p.stock > 0).length;
const totalStockValue = products.reduce((sum, p) => sum + p.price * p.stock, 0);
const initialPanel = Astro.url.searchParams.get('panel') ?? 'products';
const storeMessages = store
  ? getMessagesBySeller(sellerId)
      .filter((m) => !m.replyToId && m.toStoreId === store.id)
      .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  : [];
const messageReplies: Record<string, ReturnType<typeof getMessageReplies>> =
  Object.fromEntries(storeMessages.map((m) => [m.id, getMessageReplies(m.id)]));
// Replies carry no readable "unread" signal at the root level — a thread the
// seller already read can still have an unread follow-up reply from the
// buyer, so the tab dot must check those too, not just the root message.
const unreadMessagesCount = storeMessages.filter((m) =>
  !m.readBySeller || messageReplies[m.id]!.some((r) => r.toSellerId === sellerId && !r.readBySeller)
).length;
// Sorting/filtering by read-status is only meaningful when the store actually
// has a mix of both — with everything read (or everything unread) there's
// nothing to sort or filter, so hide those controls entirely rather than
// leave a dead, functionless option in the menu.
const showMsgStatusControls = unreadMessagesCount > 0 && unreadMessagesCount < storeMessages.length;
const adminMessages = sellerId ? getAdminMessagesForSeller(sellerId) : [];
const unreadAdminMsgCount = sellerId ? getUnreadCountForSellerFromAdmin(sellerId) : 0;
const storeOrders: Order[] = store ? getOrdersByStoreSlug(store.slug) : [];
const newOrdersCount = storeOrders.filter((o) => o.shippingStatus === 'pending').length;

// Alerts per store for store-switcher dots (pending orders or unread messages)
const storeAlerts: Record<string, boolean> = allStores.length > 1 ? getSellerStoreAlerts(sellerId) : {};
// The header dot should point the seller TO the alert — so it only fires when
// a store OTHER than the one currently open has something unhandled. If the
// seller is already looking at the store with the alert, they can already
// see it there (tab badge / order dot), so the header dot would be redundant.
const hasAnyNonCurrentAlert = store
  ? Object.entries(storeAlerts).some(([id, v]) => v && id !== store.id)
  : false;

const orderShippingLabels: Record<string, string> = {
  pending: d.shippingPending,
  processing: d.shippingProcessing,
  ready: d.shippingReady,
  shipped: d.shippingShipped,
  delivered: d.shippingDelivered,
};

const orderStatusColors: Record<string, string> = {
  pending: '#ef4444',
  processing: '#3b82f6',
  ready: '#f59e0b',
  shipped: '#8b5cf6',
  delivered: '#16a34a',
};

---

<BaseLayout title={hasNoStore ? d.noStoreTitle : d.title} noindex={true} isLoggedIn={true} hasStore={!hasNoStore} sellerMode={true}>
  {hasNoStore ? (
    <section class="section container">
      <div class="card" style="max-width:520px;margin:2rem auto;padding:2.5rem 2rem;text-align:center">
        {error && <p class="dash-error" style="margin-bottom:1.5rem;text-align:start">{error}</p>}
        <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-accent);margin:0 auto 1.25rem;display:block" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <h1 style="font-size:1.5rem;margin:0 0 0.5rem">{d.noStoreTitle}</h1>
        <p class="muted" style="margin-bottom:2rem">{d.noStoreDesc}</p>
        <form method="POST" class="dash-form" style="text-align:start">
          <input type="hidden" name="_action" value="create-store" />
          <label class="field">
            <span>{d.storeNameReq}</span>
            <input class="input" name="name" required placeholder={d.storeNamePlaceholder} autofocus />
          </label>
          <button class="btn btn--accent" type="submit" style="width:100%;margin-top:0.25rem">{d.createStoreBtn}</button>
        </form>
      </div>
    </section>
  ) : store ? (
  <Fragment>
  <div id="upload-config" data-cloud={cloudinaryCloud} data-preset={cloudinaryPreset} data-store-slug={store.slug} data-store-id={store.id} data-store-name={store.name} data-seller-id={sellerId} hidden></div>
  <section class="section container dash-section">
    <div id="dash-main-card" class="card" style="margin-bottom:1.5rem">

      <!-- ── Store header ── -->
      <div class="dash-head">
        <div class="dash-head__top">
          {allStores.length === 1 ? (
            <h1 class="dash-store-name">{store.name}</h1>
          ) : (
            <div class="store-switcher" id="store-switcher">
              <button
                class="store-switcher__btn"
                id="store-switcher-btn"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label={lang === 'he' ? 'החלף חנות' : 'Switch store'}
              >
                <span class="dash-store-name">{store.name}</span>
                <svg class="store-switcher__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
                {hasAnyNonCurrentAlert && (
                  <span class="store-switcher__alert-dot" aria-label="יש התראות בחנויות אחרות"></span>
                )}
              </button>
              <ul class="store-switcher__menu" id="store-switcher-menu" role="listbox" hidden>
                {allStores.map((s) => (
                  <li>
                    <a
                      href={`/seller/dashboard?store=${s.id}&panel=${initialPanel}`}
                      role="option"
                      aria-selected={s.id === store.id}
                      class={s.id === store.id ? 'store-option--current' : ''}
                    >
                      <span>{s.name}</span>
                      <span class="store-switcher__item-actions" style="display:flex;align-items:center;gap:0.35rem;flex-shrink:0">
                        {storeAlerts[s.id] && (
                          <span class="store-switcher__item-dot" aria-label="יש התראות"></span>
                        )}
                        {s.id === store.id && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <a href={`/store/${store.slug}`} class="btn btn--sm" target="_blank" rel="noopener">
            {d.viewLive}
          </a>
        </div>
        <p class="muted" style="margin:0.25rem 0 0;font-size:0.82rem">{d.storeSubtitle} · <code style="font-size:0.78rem">/store/{store.slug}</code></p>

        {settingsSuccess && <p class="dash-success" style="margin-top:1rem;margin-bottom:0">{d.settingsSaved}</p>}
        {productSuccess && <p class="dash-success" style="margin-top:1rem;margin-bottom:0">{d.productAdded}</p>}
        {error && <p class="dash-error" style="margin-top:1rem;margin-bottom:0">{error}</p>}
      </div>

      <!-- ── Section tabs ── -->
      <div class="dash-tabs" role="tablist">
        <button
          class={`dash-tab${initialPanel === 'products' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-products"
          data-panel="products"
          aria-selected={initialPanel === 'products'}
          tabindex={initialPanel === 'products' ? 0 : -1}
        >{d.tabProducts}</button>
        <button
          class={`dash-tab${initialPanel === 'orders' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-orders"
          data-panel="orders"
          aria-selected={initialPanel === 'orders'}
          tabindex={initialPanel === 'orders' ? 0 : -1}
          style="position:relative"
        >
          {d.tabOrders}
          {newOrdersCount > 0 && (
            <span class="dash-tab-badge" aria-label={`${newOrdersCount} הזמנות חדשות`}>{newOrdersCount}</span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'messages' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-messages"
          data-panel="messages"
          aria-selected={initialPanel === 'messages'}
          tabindex={initialPanel === 'messages' ? 0 : -1}
          style="position:relative"
        >
          הודעות
          {unreadMessagesCount > 0 && (
            <span style="position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:var(--color-danger);border-radius:50%" aria-label={`${unreadMessagesCount} הודעות שלא נקראו`}></span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'admin-messages' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-admin-messages"
          data-panel="admin-messages"
          aria-selected={initialPanel === 'admin-messages'}
          tabindex={initialPanel === 'admin-messages' ? 0 : -1}
          style="position:relative"
        >
          הודעות מהמנהל
          {unreadAdminMsgCount > 0 && (
            <span style="position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:var(--color-danger);border-radius:50%" aria-label={`${unreadAdminMsgCount} הודעות שלא נקראו מהמנהל`}></span>
          )}
        </button>
        <button
          class={`dash-tab${initialPanel === 'settings' ? ' dash-tab--active' : ''}`}
          role="tab"
          id="tab-settings"
          data-panel="settings"
          aria-selected={initialPanel === 'settings'}
          tabindex={initialPanel === 'settings' ? 0 : -1}
        >{d.tabSettings}</button>
      </div>

      <!-- ── Panel: Store data + Products ── -->
      <div id="dash-panel-products" class="dash-panel" role="tabpanel" aria-labelledby="tab-products" hidden={initialPanel !== 'products'}>

        <!-- Quick overview row -->
        <div class="dash-overview-row">
          <dl class="dash-stats">
            <div>
              <dt>{d.products}</dt>
              <dd>{productCount}</dd>
            </div>
            <div>
              <dt>{d.inStock}</dt>
              <dd>{inStockCount}</dd>
            </div>
            <div>
              <dt>{d.stockValue}</dt>
              <dd>{formatPrice(totalStockValue)}</dd>
            </div>
            <div>
              <dt>{d.favoritedBy}</dt>
              <dd>{storeFavoriteCount}</dd>
            </div>
          </dl>
        </div>

        <!-- Products section -->
        <div style="border-top:1px solid var(--color-border);padding-top:1.25rem">
          <div class="products-header">
            <div class="products-header__title">
              <input type="checkbox" id="bulk-select-all-mobile" class="bulk-select-all bulk-select-all--mobile" aria-label={d.bulkSelectAll} style="cursor:pointer;width:15px;height:15px;flex-shrink:0">
              <span class="bulk-count-paren" id="bulk-count-paren" aria-hidden="true"></span>
              <h2>{d.productsTitle}</h2>
              <span class="bulk-count-badge" id="bulk-count-badge" hidden>
                <strong id="bulk-count">0</strong> {d.bulkSelected}
              </span>
            </div>
            <div class="products-header__actions">
              <button id="bulk-edit-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkEdit}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span id="bulk-edit-label" class="bulk-btn__label" aria-hidden="true">{d.bulkEdit}</span>
              </button>
              <button id="bulk-upload-btn" type="button" class="btn btn--sm bulk-btn" hidden aria-label={d.bulkUploadImages}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span id="bulk-upload-label" class="bulk-btn__label" aria-hidden="true">{d.bulkUploadImages}</span>
              </button>
              <button id="bulk-delete-btn" type="button" class="btn btn--sm btn--danger bulk-btn" hidden aria-label={d.bulkDelete}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.bulkDelete}</span>
              </button>
              <span class="products-header__sep" id="bulk-sep" aria-hidden="true" hidden></span>
              <button class="btn btn--sm bulk-btn" id="toggle-csv-panel" aria-label={d.csvImportExport}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="11" x2="12" y2="17"/><polyline points="9.5 14.5 12 17 14.5 14.5"/></svg>
                <span class="bulk-btn__label" aria-hidden="true">{d.csvImportExport}</span>
              </button>
              <button class="btn btn--sm add-product-btn" id="toggle-add-form" aria-label={d.addProduct}>
                <span class="add-product-btn__icon" aria-hidden="true">+</span>
                <span class="add-product-btn__label" aria-hidden="true">{d.addProduct}</span>
              </button>
            </div>
          </div>

          <div id="add-product-form" class="add-form" hidden>
            <h3>{d.newProduct}</h3>
            <form method="POST" class="dash-form">
              <input type="hidden" name="_action" value="add-product" />
              <input type="hidden" name="storeId" value={store.id} />

              <div class="field-row">
                <label class="field">
                  <span>{d.nameReq}</span>
                  <input class="input" name="name" required placeholder={d.namePlaceholder} />
                </label>
                <label class="field">
                  <span>{d.priceLabel}</span>
                  <input
                    class="input"
                    name="price"
                    type="number"
                    min="0"
                    step="0.01"
                    placeholder="0.00"
                  />
                </label>
                <label class="field">
                  <span>{d.colStock}</span>
                  <input class="input" name="stock" type="number" min="0" step="1" placeholder="0" />
                </label>
              </div>

              <label class="field">
                <span>{d.descLabel}</span>
                <textarea
                  class="input"
                  name="description"
                  rows="2"
                  placeholder={d.descPlaceholderProduct}></textarea>
              </label>

              <div class="field-row">
                <div class="field field--narrow">
                  <span>{d.categoryLabel}</span>
                  <div class="category-picker" data-category-picker>
                    <input type="hidden" name="categoryId" value="" />
                    <button type="button" class="category-picker__trigger" aria-haspopup="true" aria-expanded="false">
                      <span class="category-picker__label">{d.categoryNone}</span>
                      <svg class="category-picker__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="category-picker__menu" hidden></div>
                  </div>
                  <p class="muted" style="margin:0.3rem 0 0;font-size:0.76rem">{d.categoryEditHint}</p>
                </div>
                <label class="field field--narrow">
                  <span>{d.skuLabel}</span>
                  <input class="input" name="sku" placeholder={d.skuPlaceholder} />
                </label>
              </div>

              <div class="field field--tags" data-tags-field>
                <span>{d.tagsLabel}</span>
                <div class="variant-chips" data-tag-chips style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
                  <span data-tag-adder>
                    <button type="button" class="variant-chip-add-trigger btn btn--ghost btn--sm" data-tag-add-trigger style="border-radius:999px">{d.variantValueAddBtn}</button>
                  </span>
                </div>
                <input type="hidden" name="tags" value="" />
              </div>

              <div class="field variants-editor" data-variants-editor>
                <span class="field-label">{d.variantsLabel}</span>
                <div class="variant-dims" data-variant-dims></div>
                <button type="button" class="variants-add-btn btn btn--ghost btn--sm" style="margin-top:0.25rem">{d.variantAddBtn}</button>
                <div class="variant-combos" data-variant-combos style="margin-top:0.75rem" hidden>
                  <p class="field-label" style="margin:0 0 0.3rem">{d.variantComboLabel}</p>
                  <p class="muted" data-variant-combo-hint style="font-size:0.78rem;margin:0 0 0.5rem" hidden>{d.variantComboHint}</p>
                  <div style="max-height:260px;overflow:auto;border:1px solid var(--color-border);border-radius:var(--radius)">
                    <table style="width:100%;border-collapse:separate;border-spacing:0">
                      <thead data-variant-combo-thead></thead>
                      <tbody data-variant-combo-rows></tbody>
                      <tfoot data-variant-combo-tfoot></tfoot>
                    </table>
                  </div>
                </div>
              </div>

              <div class="field">
                <span class="field-label">{d.specsLabel}</span>
                <div class="specs-rows"
                     data-label-placeholder={d.specsLabelPlaceholder}
                     data-value-placeholder={d.specsValuePlaceholder}></div>
                <button type="button" class="btn btn--ghost btn--sm specs-add-row" style="margin-top:0.5rem">{d.specsAddRow}</button>
              </div>

              <div class="field">
                <span class="field-label">{d.productImages}</span>
                <div set:html={galleryWidgetHtml([], g)}></div>
              </div>

              <div class="form-actions">
                <button class="btn" type="submit">{d.addProductBtn}</button>
                <button class="btn btn--ghost" type="button" id="cancel-add">{d.cancel}</button>
              </div>
            </form>
          </div>

          <p id="empty-products" class="empty-products" hidden={products.length > 0}>{d.noProducts}</p>

          {/* CSV bulk import/export panel */}
          <div id="csv-panel" class="csv-panel" hidden data-store-id={store.id}>
            <div class="csv-panel__header">
              <span>{d.csvImportExport}</span>
              <button type="button" class="btn btn--ghost btn--sm" id="csv-panel-close" aria-label={d.csvClose}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <p class="csv-panel__hint muted">{d.csvImportHint}</p>
            <div class="csv-panel__actions">
              <a class="btn btn--ghost btn--sm" id="csv-export-link" href={`/api/store-product/bulk?storeId=${store.id}`} download="products.csv">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                {d.csvExport}
              </a>
              <button type="button" class="btn btn--ghost btn--sm" id="csv-template-btn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
                {d.csvTemplate}
              </button>
              <label class="btn btn--ghost btn--sm" for="csv-file-input">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                {d.csvChooseFile}
              </label>
              <input type="file" id="csv-file-input" accept=".csv,text/csv" hidden />
              <span id="csv-file-name" class="muted" aria-live="polite"></span>
            </div>
            <div id="csv-preview" class="csv-preview" hidden></div>
          </div>

          {/* Bulk image upload panel */}
          <div id="bulk-upload-panel" class="bulk-upload-panel" hidden></div>

          {/* Mobile-only sort/filter toolbar (≤640px) — sits above the table,
              outside <thead>, so it's reachable once the table collapses to
              cards (thead is display:none below 640px). On desktop, sort and
              filter instead live directly in the table header (.sort-btn per
              column + a funnel button on the category column, same as the
              variant-combo table's own per-column filter). Both surfaces
              share the same JS state (initProductsToolbar in products.ts) so
              they can't diverge across a window resize. Dropdown content
              itself is built + positioned in JS (a single body-anchored
              portal, clamped to the viewport) — see toolbarPortal helpers. */}
          <div class="table-toolbar" hidden={products.length === 0}>
            <button type="button" id="products-sort-trigger" class="table-toolbar-btn" aria-haspopup="listbox" aria-expanded="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
              <span id="products-sort-label">{d.sortOptDateDesc}</span>
              <svg class="table-toolbar-btn__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <button type="button" id="products-filter-trigger" class="table-toolbar-btn" aria-haspopup="true" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              <span>{d.filterByLabel}</span>
              <span id="products-filter-count" class="filter-count-badge" hidden>0</span>
              <svg class="table-toolbar-btn__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
          </div>

          <table id="products-table" class="products-table" hidden={products.length === 0}>
            <thead>
              <tr>
                <th class="check-col"><input type="checkbox" id="bulk-select-all" class="bulk-select-all" aria-label={d.bulkSelectAll} style="cursor:pointer;width:15px;height:15px;flex-shrink:0"></th>
                <th class="num row-num" style="width:2rem">#</th>
                <th class="thumb-col"></th>
                <th class="name-col">
                  <button type="button" class="sort-btn" data-sort-col="name">{d.colName}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="sku-col">{d.skuLabel}</th>
                <th class="cat-col">
                  <div style="display:flex;align-items:center;gap:0.25rem">
                    <button type="button" class="sort-btn" data-sort-col="category">{d.categoryLabel}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                    <button type="button" class="combo-filter-btn" data-filter-funnel-col="category" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.categoryLabel}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    </button>
                  </div>
                </th>
                <th class="price-col">
                  <button type="button" class="sort-btn" data-sort-col="price">{d.colPrice}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="stock-col">
                  <button type="button" class="sort-btn" data-sort-col="stock">{d.colStock}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="num wishlist-col">
                  <button type="button" class="sort-btn" data-sort-col="wishlist">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    <svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                  </button>
                </th>
                <th class="date-col">
                  <button type="button" class="sort-btn" data-sort-col="createdAt">{d.colDateAdded}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                </th>
                <th class="actions-col" />
              </tr>
            </thead>
            <tbody id="products-tbody">
              {products.map((p, idx) => {
                const fmtDateAdded = (iso: string) => new Date(iso).toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit' });
                const { hasAnyStock: pHasVariantStock, combos: pVariantCombos } = variantCombosData(p.variants ?? [], p.variantStock, p.stock);
                const pVariantColumns = (p.variants ?? []).map((v) => v.name);
                const pHasVariants = (p.variants ?? []).length > 0;
                const pStockFieldValue = pHasVariants ? pVariantCombos.reduce((s, c) => s + c.value, 0) : p.stock;
                return (
                <>
                  <tr data-product-display={p.id} data-store-id={store.id} data-images={JSON.stringify(p.images ?? [])} data-sort-name={p.name.toLowerCase()} data-sort-price={String(p.price)} data-sort-stock={String(p.stock)} data-sort-wishlist={String(wishlistCounts[p.slug] ?? 0)} data-sort-created-at={p.createdAt} data-category={productCategoryPaths.get(p.id) ?? ''} data-category-id={p.categoryId ?? ''} data-product-slug={p.slug} data-store-slug={store.slug} data-store-name={store.name} data-has-variants={(p.variants ?? []).length ? '1' : ''}>
                    <td class="check-col"><input type="checkbox" class="bulk-check" data-bulk-check={p.id} aria-label={p.name} style="cursor:pointer;width:15px;height:15px"></td>
                    <td class="num row-num">{idx + 1}</td>
                    <td class="thumb-col">
                      {p.images?.[0] && <span class="thumb-wrap"><img src={thumbUrl(p.images[0])} alt="" class="product-thumb" width="42" height="42" loading="lazy" /></span>}
                    </td>
                    <td class="name-col">
                      <span class="product-name">{p.name}</span>
                      {p.description && <span class="product-desc">{p.description}</span>}
                    </td>
                    <td class="sku-col">{p.sku || <span style="color:var(--color-border)">—</span>}</td>
                    <td class="cat-col">{productCategoryPaths.get(p.id) ? <span class="product-cat-chip">{productCategoryPaths.get(p.id)}</span> : <span style="color:var(--color-border)">—</span>}</td>
                    <td class="num product-price price-col">{formatPrice(p.price)}</td>
                    <td class="num product-stock stock-col">
                      <span style="display:inline-flex;align-items:center;gap:0.3rem">
                        <span style={p.stock <= LOW_STOCK_THRESHOLD ? 'color:var(--color-danger)' : undefined}>{p.stock}</span>
                        {p.stock <= 0 && (
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={d.outOfStock} style="color:var(--color-danger);flex-shrink:0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        )}
                        {(p.variants ?? []).length > 0 && (
                          <span class="stock-breakdown" data-stock-breakdown>
                            <button type="button" class="stock-breakdown__btn" aria-expanded="false" aria-haspopup="true" aria-label={d.stockBreakdownLabel}>
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                            </button>
                            <div class="stock-breakdown__dropdown" role="menu" hidden>
                              {pVariantCombos.map((c) => (
                                <div class="stock-breakdown__row">
                                  <span style="display:inline-flex;align-items:center;gap:0.35rem">
                                    {c.parts.map((part, i) => (
                                      <>
                                        {i > 0 && ' · '}
                                        <span style="display:inline-flex;align-items:center;gap:0.3rem">
                                          {part.hex && <span aria-hidden="true" style={`display:inline-block;width:10px;height:10px;border-radius:3px;background:${part.hex};border:1px solid rgba(0,0,0,0.15);flex-shrink:0`}></span>}
                                          {part.text}
                                        </span>
                                      </>
                                    ))}
                                  </span>
                                  <span style="display:inline-flex;align-items:center;gap:0.3rem">
                                    {c.value}
                                    {c.value <= 0 && (
                                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={d.outOfStock} style="color:var(--color-danger);flex-shrink:0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                    )}
                                  </span>
                                </div>
                              ))}
                            </div>
                          </span>
                        )}
                      </span>
                    </td>
                    <td class="num wishlist-col" style="color:var(--color-muted);font-size:0.82rem">
                      {(wishlistCounts[p.slug] ?? 0) > 0
                        ? <span style="display:inline-flex;align-items:center;gap:0.25rem;color:var(--color-accent)">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            {wishlistCounts[p.slug]}
                          </span>
                        : <span style="color:var(--color-border)">—</span>
                      }
                    </td>
                    <td class="date-col">{fmtDateAdded(p.createdAt)}</td>
                    <td class="actions actions-col">
                      <div class="product-menu">
                        <button class="product-menu__btn" type="button" aria-label={d.menuLabel ?? 'אפשרויות'} aria-expanded="false" aria-haspopup="true">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
                        </button>
                        <ul class="product-menu__dropdown" hidden role="menu">
                          <li role="none"><button class="product-menu__item" type="button" data-view-product={p.id} role="menuitem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>{d.viewProduct}</button></li>
                          <li role="none"><button class="product-menu__item" type="button" data-edit-toggle={p.id} role="menuitem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>{d.edit}</button></li>
                          <li role="none"><button class="product-menu__item product-menu__item--danger" type="button" data-delete-product={p.id} data-store-id={store.id} role="menuitem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>{d.delete}</button></li>
                        </ul>
                      </div>
                    </td>
                  </tr>
                  <tr class="edit-row" data-product-edit={p.id} hidden>
                    <td class="num row-num">{idx + 1}</td>
                    <td colspan="20">
                      <form method="POST" action="/api/product" class="dash-form inline-edit-form">
                        <input type="hidden" name="_action" value="edit-product" />
                        <input type="hidden" name="productId" value={p.id} />
                        <div class="edit-row-header">
                          {p.images?.[0] && <img src={thumbUrl(p.images[0], 72, 72)} alt="" width="36" height="36" loading="lazy" style="width:36px;height:36px;object-fit:cover;border-radius:4px;flex-shrink:0">}
                          <span class="edit-row-title">{p.name}</span>
                          <div class="form-actions" style="margin-inline-start:auto;margin-top:0">
                            <button class="btn btn--sm" type="submit" style="min-width:5rem;text-align:center">{d.save}</button>
                            <button class="btn btn--ghost btn--sm" type="button" data-cancel-edit={p.id}>{d.cancel}</button>
                          </div>
                        </div>
                        <div class="field-row">
                          <label class="field">
                            <span>{d.nameReq}</span>
                            <input class="input" name="name" value={p.name} required />
                          </label>
                          <label class="field">
                            <span>{d.priceLabel}</span>
                            <input class="input" name="price" type="number" min="0" step="0.01" value={p.price} />
                          </label>
                          <label class="field">
                            <span>{d.colStock}</span>
                            <input class="input" name="stock" type="number" min="0" step="1" value={pStockFieldValue} readonly={pHasVariants} style={pHasVariants ? 'background:var(--color-bg)' : undefined} />
                          </label>
                        </div>
                        <label class="field">
                          <span>{d.descLabel}</span>
                          <textarea class="input" name="description" rows="2">{p.description}</textarea>
                        </label>

                        <div class="field-row">
                          <div class="field field--narrow">
                            <span>{d.categoryLabel}</span>
                            <div class="category-picker" data-category-picker>
                              <input type="hidden" name="categoryId" value={p.categoryId ?? ''} />
                              <button type="button" class="category-picker__trigger" aria-haspopup="true" aria-expanded="false">
                                <span class="category-picker__label">{(p.categoryId && productCategoryPaths.get(p.id)) || d.categoryNone}</span>
                                <svg class="category-picker__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                              </button>
                              <div class="category-picker__menu" hidden></div>
                            </div>
                            <p class="muted" style="margin:0.3rem 0 0;font-size:0.76rem">{d.categoryEditHint}</p>
                          </div>
                          <label class="field field--narrow">
                            <span>{d.skuLabel}</span>
                            <input class="input" name="sku" value={p.sku ?? ''} placeholder={d.skuPlaceholder} />
                          </label>
                        </div>

                        <div class="field field--tags" data-tags-field>
                          <span>{d.tagsLabel}</span>
                          <div class="variant-chips" data-tag-chips style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
                            {(p.tags ?? []).map((tag) => (
                              <span class="variant-chip" data-tag-chip data-value={tag} style="display:inline-flex;align-items:center;gap:0.35rem;border:1px solid var(--color-border);border-radius:999px;padding:0.25rem 0.5rem 0.25rem 0.4rem;font-size:0.82rem">
                                <span class="variant-chip-label">{tag}</span>
                                <button type="button" class="variant-chip-remove" data-tag-chip-remove aria-label={d.variantChipRemove} style="display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;border:none;background:none;color:var(--color-muted);cursor:pointer;font-size:0.85rem;line-height:1;padding:0">×</button>
                              </span>
                            ))}
                            <span data-tag-adder>
                              <button type="button" class="variant-chip-add-trigger btn btn--ghost btn--sm" data-tag-add-trigger style="border-radius:999px">{d.variantValueAddBtn}</button>
                            </span>
                          </div>
                          <input type="hidden" name="tags" value={p.tags?.join(',') ?? ''} />
                        </div>

                        <div class="field variants-editor" data-variants-editor>
                          <span class="field-label">{d.variantsLabel}</span>
                          <div class="variant-dims" data-variant-dims>
                            {(p.variants ?? []).map((v) => (
                              <div class="variant-dim" data-variant-dim style="border:1px solid var(--color-border);border-radius:var(--radius);padding:0.65rem;margin-bottom:0.5rem">
                                <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem">
                                  <input class="input" data-dim-name value={v.name} placeholder={d.variantNamePlaceholder} style="width:130px;flex:0 0 auto" />
                                  <button type="button" class="variant-dim-remove btn btn--ghost btn--sm" aria-label={d.variantRemove} style="flex-shrink:0">×</button>
                                </div>
                                <div class="variant-chips" data-variant-chips style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
                                  {v.options.map((opt) => {
                                    const isColor = isColorVariant(v.name);
                                    const resolved = isColor ? resolveVariantColor(opt) : { display: opt, hex: null as string | null };
                                    return (
                                      <span class="variant-chip" data-variant-chip data-value={opt} style="display:inline-flex;align-items:center;gap:0.35rem;border:1px solid var(--color-border);border-radius:999px;padding:0.25rem 0.5rem 0.25rem 0.4rem;font-size:0.82rem">
                                        {isColor && (resolved.hex
                                          ? <span class="variant-chip-swatch" aria-hidden="true" style={`width:14px;height:14px;border-radius:3px;background:${resolved.hex};border:1px solid rgba(0,0,0,0.15);flex-shrink:0;display:inline-block`}></span>
                                          : <input type="color" class="variant-chip-color-input" value="#9ca3af" aria-label={d.variantColorPicker} style="width:16px;height:16px;padding:0;border:1px solid rgba(0,0,0,0.15);border-radius:3px;flex-shrink:0;cursor:pointer;background:none" />
                                        )}
                                        <span class="variant-chip-label">{resolved.display}</span>
                                        <button type="button" class="variant-chip-remove" aria-label={d.variantChipRemove} style="display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;border:none;background:none;color:var(--color-muted);cursor:pointer;font-size:0.85rem;line-height:1;padding:0">×</button>
                                      </span>
                                    );
                                  })}
                                  <span data-dim-value-adder>
                                    <button type="button" class="variant-chip-add-trigger btn btn--ghost btn--sm" data-dim-value-trigger style="border-radius:999px">{d.variantValueAddBtn}</button>
                                  </span>
                                </div>
                              </div>
                            ))}
                          </div>
                          <button type="button" class="variants-add-btn btn btn--ghost btn--sm" style="margin-top:0.25rem">{d.variantAddBtn}</button>
                          <div class="variant-combos" data-variant-combos style="margin-top:0.75rem" hidden={!(p.variants ?? []).length}>
                            <p class="field-label" style="margin:0 0 0.3rem">{d.variantComboLabel}</p>
                            <p class="muted" data-variant-combo-hint style="font-size:0.78rem;margin:0 0 0.5rem" hidden={pHasVariantStock}>{d.variantComboHint}</p>
                            <div style="max-height:260px;overflow:auto;border:1px solid var(--color-border);border-radius:var(--radius)">
                              <table style="width:100%;border-collapse:separate;border-spacing:0">
                                <thead data-variant-combo-thead>
                                  <tr data-variant-combo-header>
                                    {pVariantColumns.map((col, i) => (
                                      <th style="padding:0.4rem 0.6rem;text-align:start;border-bottom:1px solid var(--color-border);white-space:nowrap">
                                        <div style="display:flex;align-items:center;gap:0.25rem">
                                          <button type="button" class="combo-sort-btn" data-combo-sort-col={i}>{col}<svg class="combo-sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                                          <span class="combo-filter" data-combo-filter data-filter-col={i} style="display:inline-flex">
                                            <button type="button" class="combo-filter-btn" aria-expanded="false" aria-haspopup="true" aria-label={`${d.variantFilterAriaPrefix} ${col}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                                              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                                            </button>
                                          </span>
                                        </div>
                                      </th>
                                    ))}
                                    <th style="padding:0.4rem 0.6rem;text-align:end;border-bottom:1px solid var(--color-border);white-space:nowrap;position:sticky;inset-inline-end:0;background:var(--color-surface);z-index:2">
                                      <button type="button" class="combo-sort-btn" data-combo-sort-col="stock">{d.variantStockColLabel}<svg class="combo-sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                                    </th>
                                  </tr>
                                </thead>
                                <tbody data-variant-combo-rows>
                                  {pVariantCombos.map((c) => (
                                    <tr class="variant-combo-row" data-variant-combo-row data-combo-key={c.key}>
                                      {c.parts.map((part) => (
                                        <td style="padding:0.4rem 0.6rem;font-size:0.85rem;color:var(--color-text);white-space:nowrap;vertical-align:middle">
                                          {part.hex
                                            ? <span style="display:inline-flex;align-items:center;gap:0.3rem"><span aria-hidden="true" style={`display:inline-block;width:10px;height:10px;border-radius:3px;background:${part.hex};border:1px solid rgba(0,0,0,0.15);flex-shrink:0`}></span>{part.text}</span>
                                            : part.text}
                                        </td>
                                      ))}
                                      <td style="padding:0.4rem 0.6rem;text-align:end;vertical-align:middle;position:sticky;inset-inline-end:0;background:var(--color-surface);z-index:1"><input type="number" min="0" step="1" class="input" data-combo-stock value={c.value} style="width:80px;text-align:center;padding:0.3rem 0.4rem" /></td>
                                    </tr>
                                  ))}
                                </tbody>
                                <tfoot data-variant-combo-tfoot>
                                  <tr data-variant-combo-total-row>
                                    <td colspan={pVariantColumns.length} data-variant-combo-total-label style="padding:0.4rem 0.6rem;font-size:0.82rem;font-weight:600;color:var(--color-text);white-space:nowrap;border-top:1px solid var(--color-border);position:sticky;bottom:0;background:var(--color-surface)">{`${d.variantComboTotal} (${d.variantFilterAll})`}</td>
                                    <td data-variant-combo-total-value style="padding:0.4rem 0.6rem;text-align:end;font-weight:600;color:var(--color-text);border-top:1px solid var(--color-border);position:sticky;inset-inline-end:0;bottom:0;background:var(--color-surface);z-index:1">{pVariantCombos.reduce((s, c) => s + c.value, 0)}</td>
                                  </tr>
                                </tfoot>
                              </table>
                            </div>
                          </div>
                        </div>

                        <div class="field">
                          <span class="field-label">{d.specsLabel}</span>
                          <div class="specs-rows"
                               data-label-placeholder={d.specsLabelPlaceholder}
                               data-value-placeholder={d.specsValuePlaceholder}>
                            {(p.specs ?? []).map((s) => (
                              <div class="specs-row" style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem">
                                <input class="input" name="specs_label" value={s.label} placeholder={d.specsLabelPlaceholder} style="width:170px;flex:0 0 auto" />
                                <input class="input" name="specs_value" value={s.value} placeholder={d.specsValuePlaceholder} style="width:220px;flex:0 0 auto" />
                                <button type="button" class="specs-remove-row btn btn--ghost btn--sm" aria-label={d.specsRemoveRow}>×</button>
                              </div>
                            ))}
                          </div>
                          <button type="button" class="specs-add-row btn btn--ghost btn--sm" style="margin-top:0.5rem">{d.specsAddRow}</button>
                        </div>

                        <div class="field">
                          <span class="field-label">{d.productImages}</span>
                          <div set:html={galleryWidgetHtml(p.images ?? [], g)}></div>
                        </div>
                        <div class="form-actions">
                          <button class="btn btn--sm" type="submit" style="min-width:5rem;text-align:center">{d.save}</button>
                          <button class="btn btn--ghost btn--sm" type="button" data-cancel-edit={p.id}>{d.cancel}</button>
                        </div>
                      </form>
                    </td>
                  </tr>
                </>
                );
              })}
            </tbody>
          </table>

          <nav id="products-pagination" class="products-pagination" aria-label={d.productsTitle} hidden></nav>
        </div>
      </div>

      <!-- ── Panel: Orders ── -->
      <div id="dash-panel-orders" class="dash-panel" role="tabpanel" aria-labelledby="tab-orders" hidden={initialPanel !== 'orders'}>
        <div class="orders-panel-head">
          <h2 style="font-size:1rem;font-weight:600;margin:0">{d.ordersTitle}</h2>
          {/* Orders is cards-only at every screen size (no table/header to fall
              back to), so this toolbar is always visible — unlike
              .table-toolbar (products/messages), it's not display:none above
              640px. Default filter selection = the old "active" preset
              (pending/processing/ready/shipped), matching today's default. */}
          {storeOrders.length > 0 && (
            <div class="orders-toolbar" id="orders-toolbar">
              <button type="button" id="orders-sort-trigger" class="table-toolbar-btn" aria-haspopup="listbox" aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
                <span id="orders-sort-label">{d.orderSortOptDateDesc}</span>
                <svg class="table-toolbar-btn__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <button type="button" id="orders-filter-trigger" class="table-toolbar-btn" aria-haspopup="true" aria-expanded="false">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                <span>{d.filterByLabel}</span>
                <span id="orders-filter-count" class="filter-count-badge" hidden>0</span>
                <svg class="table-toolbar-btn__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          )}
        </div>
        {storeOrders.length === 0 ? (
          <p class="seller-msg-empty">{d.noOrders}</p>
        ) : (
          <Fragment>
          <p class="seller-msg-empty" id="orders-filter-empty" hidden>אין הזמנות בקטגוריה זו.</p>
          <div class="orders-list" id="orders-list">
            {storeOrders.map((order) => {
              const storeItems = order.items.filter((i) => i.storeSlug === store!.slug);
              const storeSub   = order.storeSubtotals[store!.slug];
              const fmtDate    = (iso: string) => new Date(iso).toLocaleString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
              const shortId    = order.checkoutRef ?? order.id.slice(0, 8).toUpperCase();
              return (
                <div class="order-card" data-order-id={order.id} data-store-slug={store!.slug} data-shipping-status={order.shippingStatus} data-sort-date={order.createdAt} data-sort-amount={storeSub ? storeSub.subtotal + storeSub.shipping : 0}>
                  <div class="order-card__header" role="button" tabindex="0" aria-expanded="false">
                    <div class="order-card__meta">
                      <span class="order-card__id">
                        #{shortId}
                        {order.shippingStatus === 'pending' && (
                          <span class="order-new-dot" aria-label="הזמנה חדשה"></span>
                        )}
                      </span>
                      <span class="order-card__date">{fmtDate(order.createdAt)}</span>
                    </div>
                    <div class="order-card__summary">
                      <span class="order-card__buyer">{order.buyerName}</span>
                      <span class="order-card__amount">{formatPrice(storeSub ? storeSub.subtotal + storeSub.shipping : 0)}</span>
                      <span class="order-card__status-badge" style={`background:${orderStatusColors[order.shippingStatus] ?? '#888'}1a;color:${orderStatusColors[order.shippingStatus] ?? '#888'};`}>
                        {orderShippingLabels[order.shippingStatus] ?? order.shippingStatus}
                      </span>
                    </div>
                    <svg class="order-card__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </div>
                  <div class="order-card__body" hidden>
                    <div class="order-card__section">
                      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
                        <h3 class="order-card__section-title" style="margin:0">{d.orderBuyer}</h3>
                        <button
                          class="btn btn--ghost btn--sm order-edit-buyer-btn"
                          type="button"
                          data-order-id={order.id}
                          data-store-slug={store!.slug}
                          data-buyer-name={order.buyerName}
                          data-buyer-email={order.buyerEmail}
                          data-buyer-phone={order.buyerPhone}
                          data-buyer-city={order.buyerAddress.city}
                          data-buyer-street={order.buyerAddress.street}
                          data-buyer-zip={order.buyerAddress.zip ?? ''}
                          data-items={JSON.stringify(storeItems)}
                          data-shipping={String(storeSub?.shipping ?? 0)}
                          data-discount-type={storeSub?.discount?.type ?? 'percent'}
                          data-discount-value={String(storeSub?.discount?.value ?? 0)}
                          style="font-size:0.75rem"
                        >
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                          ערוך פרטים
                        </button>
                      </div>
                      <p class="order-card__info-line order-buyer-name"><strong>{order.buyerName}</strong></p>
                      <p class="order-card__info-line order-buyer-email">{order.buyerEmail}</p>
                      <p class="order-card__info-line order-buyer-phone">{d.orderPhone}: {order.buyerPhone}</p>
                      <p class="order-card__info-line order-buyer-address">{d.orderAddress}: {order.buyerAddress.street}, {order.buyerAddress.city}{order.buyerAddress.zip ? ` ${order.buyerAddress.zip}` : ''}</p>
                    </div>
                    <div class="order-card__section">
                      <h3 class="order-card__section-title">{d.orderItems}</h3>
                      <ul class="order-card__items">
                        {storeItems.map((item) => (
                          <li class="order-card__item">
                            {item.image && <img src={item.image} alt="" width="36" height="36" loading="lazy" class="order-card__item-img" />}
                            <span class="order-card__item-name">{item.productName}</span>
                            <span class="order-card__item-qty">×{item.qty}</span>
                            <span class="order-card__item-price">{formatPrice(item.price * item.qty)}</span>
                          </li>
                        ))}
                      </ul>
                      {storeSub && (
                        <div class="order-card__subtotals">
                          <span>{d.orderShipping}: {storeSub.shipping === 0 ? 'חינם' : formatPrice(storeSub.shipping)}</span>
                          <strong>{d.orderTotal}: {formatPrice(storeSub.subtotal + storeSub.shipping)}</strong>
                        </div>
                      )}
                    </div>
                    <div class="order-card__section order-card__section--controls">
                      <h3 class="order-card__section-title">{d.orderShippingStatus}</h3>
                      <div class="order-card__control-row">
                        <div class="order-status-dropdown">
                          <button class="order-status-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                            <span class="order-status-dot" style={`background:${orderStatusColors[order.shippingStatus] ?? '#888'}`}></span>
                            <span class="order-status-label">{orderShippingLabels[order.shippingStatus] ?? order.shippingStatus}</span>
                            <svg class="order-status-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                          </button>
                          <ul class="order-status-menu" role="listbox" hidden>
                            {(['pending','processing','ready','shipped','delivered'] as const).map((v) => (
                              <li role="none">
                                <button class="order-status-option" type="button" role="option" data-value={v} aria-selected={order.shippingStatus === v}>
                                  <span class="order-status-dot" style={`background:${orderStatusColors[v]}`}></span>
                                  {orderShippingLabels[v]}
                                </button>
                              </li>
                            ))}
                          </ul>
                          <input type="hidden" class="order-status-select" data-field="shippingStatus" value={order.shippingStatus} />
                        </div>
                      </div>
                      <h3 class="order-card__section-title" style="margin-top:0.75rem">{d.orderTracking}</h3>
                      <div class="order-card__control-row">
                        <input type="text" class="order-tracking-input input" data-field="trackingNumber" value={order.trackingNumber ?? ''} placeholder={d.orderTrackingPlaceholder} style="flex:1" />
                        <button class="order-save-btn btn btn--sm btn--accent" type="button">{d.orderSave}</button>
                      </div>
                      <p class="order-save-status" hidden aria-live="polite">{d.orderSaved}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
          </Fragment>
        )}
      </div>

      <!-- ── Panel: Messages ── -->
      <div id="dash-panel-messages" class="dash-panel" role="tabpanel" aria-labelledby="tab-messages" hidden={initialPanel !== 'messages'}>
        <h2 style="font-size:1rem;font-weight:600;margin:0 0 1rem">הודעות מקונים</h2>
        {storeMessages.length === 0 ? (
          <p class="seller-msg-empty">אין הודעות עדיין.</p>
        ) : (
          /* Mobile-only sort/filter toolbar — mirrors the products table's own
             (see the comment there): on desktop, sort/filter live in the
             header row itself instead (.sort-btn on the date column, a
             funnel button on the status column). */
          <div class="table-toolbar" data-mixed-status={String(showMsgStatusControls)}>
            <button type="button" id="msg-sort-trigger" class="table-toolbar-btn" aria-haspopup="listbox" aria-expanded="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
              <span id="msg-sort-label">{d.msgSortOptDateDesc}</span>
              <svg class="table-toolbar-btn__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <button type="button" id="msg-filter-trigger" class="table-toolbar-btn" aria-haspopup="true" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              <span>{d.filterByLabel}</span>
              <span id="msg-filter-count" class="filter-count-badge" hidden>0</span>
              <svg class="table-toolbar-btn__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
          </div>

          <div class="msg-table-wrap">
            <table class="msg-table">
              <thead>
                <tr>
                  <th class="msg-table__th msg-table__th--status">
                    {showMsgStatusControls && (
                      <div style="display:flex;align-items:center;justify-content:center;gap:0.2rem">
                        <button type="button" class="sort-btn" data-sort-col="unread" aria-label={d.filterColStatus ?? 'סטטוס'}>
                          <svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                        </button>
                        <button type="button" class="combo-filter-btn" data-filter-funnel-col="status" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.filterColStatus ?? 'סטטוס'}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        </button>
                      </div>
                    )}
                  </th>
                  <th class="msg-table__th">
                    <div style="display:flex;align-items:center;gap:0.25rem">
                      שולח
                      <button type="button" class="combo-filter-btn" data-filter-funnel-col="from" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.filterColFrom ?? 'שולח'}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                      </button>
                    </div>
                  </th>
                  <th class="msg-table__th">נושא</th>
                  <th class="msg-table__th">תוכן</th>
                  <th class="msg-table__th">
                    <div style="display:flex;align-items:center;gap:0.25rem">
                      <button type="button" class="sort-btn" data-sort-col="product">{d.filterColProduct ?? 'מוצר'}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                      <button type="button" class="combo-filter-btn" data-filter-funnel-col="product" aria-expanded="false" aria-haspopup="true" aria-label={`${d.filterByLabel ?? 'סנן לפי'} ${d.filterColProduct ?? 'מוצר'}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                      </button>
                    </div>
                  </th>
                  <th class="msg-table__th">
                    <button type="button" class="sort-btn" data-sort-col="date">תאריך<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                  </th>
                  <th class="msg-table__th msg-table__th--actions"></th>
                </tr>
              </thead>
              <tbody>
                {storeMessages.map((msg) => {
                  const replies = messageReplies[msg.id] ?? [];
                  const fmtDate = (iso: string) => new Date(iso).toLocaleString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
                  const hasUnread = !msg.readBySeller || replies.some((r) => r.toSellerId === sellerId && !r.readBySeller);
                  const lastMsg = replies.length > 0 ? replies[replies.length - 1]! : msg;
                  return (
                    <Fragment>
                      <tr
                        class={`msg-table__row${hasUnread ? ' msg-table__row--unread' : ''}`}
                        data-msg-id={msg.id}
                        data-sort-date={lastMsg.createdAt}
                        data-sort-product={(msg.productRef?.productName ?? '').toLowerCase()}
                        data-filter-product={msg.productRef?.productName ?? ''}
                        data-filter-from={msg.fromName}
                        tabindex="0"
                        role="button"
                        aria-expanded="false"
                      >
                        <td class="msg-table__td msg-table__td--status"></td>
                        <td class="msg-table__td msg-table__td--from">
                          {hasUnread && <span class="visually-hidden msg-unread-sr">לא נקרא · </span>}
                          {msg.fromName}
                        </td>
                        <td class="msg-table__td msg-table__td--subject">{msg.subject}</td>
                        <td class="msg-table__td msg-table__td--preview">
                          {lastMsg.content}
                          {lastMsg.fromUserId === sellerId && <span class="msg-table__preview-you"> (אתה)</span>}
                        </td>
                        <td class="msg-table__td msg-table__td--product">
                          {msg.productRef
                            ? <a href={`/store/${msg.productRef.storeSlug}/${msg.productRef.productSlug}`} target="_blank" rel="noopener" style="color:inherit;text-decoration:none" onclick="event.stopPropagation()">{msg.productRef.productName}</a>
                            : <span style="color:var(--color-muted)">—</span>
                          }
                        </td>
                        <td class="msg-table__td msg-table__td--date">{fmtDate(lastMsg.createdAt)}</td>
                        <td class="msg-table__td msg-table__td--actions">
                          <button class="seller-msg-delete" data-delete-msg-id={msg.id} type="button" aria-label="מחק שיחה" title="מחק שיחה">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                          </button>
                        </td>
                      </tr>
                      <tr class="msg-thread-row" id={`msg-detail-${msg.id}`} hidden>
                        <td colspan="7">
                          <div class="msg-thread msg-thread--seller-pov" id={`replies-${msg.id}`}>
                            <div class="msg-thread-entry msg-thread-entry--buyer">
                              <div class="msg-thread-entry__header">
                                <span class="msg-thread-entry__who">{msg.fromName}</span>
                                {!msg.readBySeller && <span class="msg-thread-unread-dot" aria-label="לא נקרא"></span>}
                                <span class="msg-thread-entry__date">{fmtDate(msg.createdAt)}</span>
                              </div>
                              <div class="msg-thread-entry__body">{msg.content}</div>
                            </div>
                            {replies.map((r) => {
                              const isSellerReply = r.fromUserId === sellerId;
                              const isUnreadBuyerMsg = !isSellerReply && !r.readBySeller;
                              return (
                                <div class={`msg-thread-entry ${isSellerReply ? 'msg-thread-entry--seller' : 'msg-thread-entry--buyer'}`}>
                                  <div class="msg-thread-entry__header">
                                    <span class="msg-thread-entry__who">{isSellerReply ? 'אתה' : r.fromName}</span>
                                    {isUnreadBuyerMsg && <span class="msg-thread-unread-dot" aria-label="לא נקרא"></span>}
                                    <span class="msg-thread-entry__date">{fmtDate(r.createdAt)}</span>
                                  </div>
                                  <div class="msg-thread-entry__body">{r.content}</div>
                                </div>
                              );
                            })}
                          </div>
                          <div class="seller-msg-reply-form" data-reply-for={msg.id} style="padding:0.75rem 1rem;border-top:1px solid var(--color-border)">
                            <textarea class="seller-msg-reply-textarea" placeholder="כתוב תשובה..." rows="3"></textarea>
                            <div style="display:flex;justify-content:flex-end;gap:0.5rem">
                              <button class="seller-msg-reply-close" type="button">סגור שיחה</button>
                              <button class="seller-msg-reply-send" type="button">שלח</button>
                            </div>
                          </div>
                        </td>
                      </tr>
                    </Fragment>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <!-- ── Panel: Messages from admin (single flat conversation, not subject-based like buyer messages) ── -->
      <div id="dash-panel-admin-messages" class="dash-panel" role="tabpanel" aria-labelledby="tab-admin-messages" hidden={initialPanel !== 'admin-messages'}>
        <h2 style="font-size:1rem;font-weight:600;margin:0 0 1rem">הודעות מהמנהל</h2>
        {adminMessages.length === 0 && <p class="seller-msg-empty" id="admin-msg-seller-empty">אין הודעות מהמנהל עדיין.</p>}
        <div class="msg-thread" id="admin-msg-thread-seller">
          {adminMessages.map((m) => (
            <div class={`msg-thread-entry ${m.fromRole === 'seller' ? 'msg-thread-entry--seller' : 'msg-thread-entry--buyer'}`}>
              <div class="msg-thread-entry__header">
                <span class="msg-thread-entry__who">{m.fromRole === 'seller' ? 'אתה' : 'המנהל'}</span>
                <span class="msg-thread-entry__date">{formatHeDateTime(m.createdAt)}</span>
              </div>
              <div class="msg-thread-entry__body">{m.content}</div>
            </div>
          ))}
        </div>
        <div class="seller-msg-reply-form" style="padding:0.75rem 0;border-top:1px solid var(--color-border);margin-top:1rem">
          <textarea class="seller-msg-reply-textarea" id="admin-msg-seller-textarea" placeholder="כתוב הודעה למנהל..." rows="3"></textarea>
          <div style="display:flex;justify-content:flex-end">
            <button class="seller-msg-reply-send" id="admin-msg-seller-send" type="button">שלח</button>
          </div>
        </div>
      </div>

      <!-- ── Panel: Settings ── -->
      <div id="dash-panel-settings" class="dash-panel" role="tabpanel" aria-labelledby="tab-settings" hidden={initialPanel !== 'settings'}>
        <form method="POST" action="/api/store" class="dash-form" id="settings-form" style="margin-top:0">
          <input type="hidden" name="_action" value="save-settings" />
          <input type="hidden" name="storeId" value={store.id} />

          <div class="dash-panel-header">
            <h2 class="dash-panel-header__title">{d.tabSettings}</h2>
            <button class="btn btn--sm" type="submit" id="settings-save-btn">{d.saveChanges}</button>
          </div>

          <div class="field">
            <span>{d.storeBanner}</span>
            <p class="muted" style="margin:0.15rem 0 0.6rem;font-size:0.8rem">{d.storeBannerHint}</p>
            <div
              id="banner-frame"
              class="w-full max-w-[420px] overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)]"
              style="aspect-ratio:3/1"
            >
              {store.bannerImage && (
                <img src={cdnSrc(store.bannerImage, 900)} alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" />
              )}
            </div>
            <div class="flex gap-2" style="margin-top:1.1rem">
              <button type="button" class="btn btn--sm btn--ghost" id="banner-upload-btn">{store.bannerImage ? d.storeImageChange : d.uploadImage}</button>
              <button type="button" class="btn btn--sm btn--ghost" id="banner-remove-btn" hidden={!store.bannerImage}>{d.removeImage}</button>
            </div>
            <input type="file" accept="image/*" id="banner-file-input" hidden />
            <input type="hidden" name="bannerImage" id="banner-image-input" value={store.bannerImage ?? ''} />
          </div>

          <div class="field">
            <span>{d.storeProfileImage}</span>
            <p class="muted" style="margin:0.15rem 0 0.6rem;font-size:0.8rem">{d.storeProfileImageHint}</p>
            <div
              id="avatar-frame"
              class="h-20 w-20 overflow-hidden rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]"
            >
              {store.profileImage && (
                <img src={cdnSrc(store.profileImage, 200)} alt="" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" />
              )}
            </div>
            <div class="flex gap-2" style="margin-top:1.1rem">
              <button type="button" class="btn btn--sm btn--ghost" id="avatar-upload-btn">{store.profileImage ? d.storeImageChange : d.uploadImage}</button>
              <button type="button" class="btn btn--sm btn--ghost" id="avatar-remove-btn" hidden={!store.profileImage}>{d.removeImage}</button>
            </div>
            <input type="file" accept="image/*" id="avatar-file-input" hidden />
            <input type="hidden" name="profileImage" id="avatar-image-input" value={store.profileImage ?? ''} />
          </div>

          <label class="field">
            <span>{d.storeName}</span>
            <input class="input" name="name" value={store.name} required />
          </label>

          <label class="field">
            <span>{d.tagline}</span>
            <input
              class="input"
              name="tagline"
              value={store.tagline}
              placeholder={d.descPlaceholder}
            />
          </label>

          <label class="field">
            <span>{d.description}</span>
            <textarea class="input" name="description" rows="3">{store.description}</textarea>
          </label>

          <label class="field">
            <span>{d.storeCategories}</span>
            <input class="input" name="categories" value={store.categories?.join(', ') ?? ''} placeholder={d.storeCategoriesPlaceholder} />
          </label>

          <div class="field">
            <label class="details-visible-toggle">
              <input type="checkbox" name="addressVisible" id="address-visible-toggle" checked={!!store.addressVisible} />
              <span>{d.showStoreAddress}</span>
            </label>
          </div>

          <div id="store-address-field" class="store-details-fields" data-open={String(!!store.addressVisible)}>
            <label class="field">
              <span>{d.storeAddress}</span>
              <input class="input" name="address" value={store.address ?? ''} placeholder={d.storeAddressPlaceholder} />
            </label>
          </div>

          <div class="field">
            <label class="details-visible-toggle">
              <input type="checkbox" name="hoursVisible" id="hours-visible-toggle" checked={!!store.hoursVisible} />
              <span>{d.showStoreHours}</span>
            </label>
          </div>

          <div id="store-hours-field" class="store-details-fields" data-open={String(!!store.hoursVisible)}>
            <div class="field">
              <span>{d.storeHours}</span>
              <div id="hours-editor" class="hours-editor">
                {STORE_WEEKDAYS.map((day) => {
                  const dh = (store.hours ?? DEFAULT_STORE_HOURS)[day];
                  return (
                    <div class="hours-row" data-day={day}>
                      <span class="hours-row__label">{d.storeHoursDay[day]}</span>
                      <input class="input hours-time" type="time" name={`hours_${day}_open`} value={dh.open} disabled={dh.closed} />
                      <span class="hours-row__sep">–</span>
                      <input class="input hours-time" type="time" name={`hours_${day}_close`} value={dh.close} disabled={dh.closed} />
                      <label class="hours-row__closed">
                        <input type="checkbox" class="hours-closed-toggle" name={`hours_${day}_closed`} checked={dh.closed} />
                        {d.storeHoursClosed}
                      </label>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button class="btn btn--sm" type="submit">{d.saveChanges}</button>
          </div>

          <p id="settings-status" hidden></p>
        </form>

        <div class="dash-panel-header" style="margin-top:2rem">
          <h2 class="dash-panel-header__title">{d.categoriesTitle}</h2>
        </div>
        <p class="muted" style="margin:0 0 1rem;font-size:0.85rem">{d.categoriesHint}</p>

        {store && (
          <div id="category-tree-editor" class="category-tree-editor" data-store-id={store.id}>
            <div id="category-tree-list" class="category-tree-list"></div>
            <form id="add-root-category-form" class="category-add-form">
              <input type="text" class="input" id="add-root-category-input" placeholder={d.categoryNamePlaceholder} maxlength="40" />
              <button type="submit" class="btn btn--sm btn--ghost">{d.addRootCategory}</button>
            </form>
          </div>
        )}
        <script type="application/json" id="category-tree-data" set:html={JSON.stringify(categoryTree)} />
      </div>

    </div>
  </section>
  </Fragment>
  ) : null}
</BaseLayout>

<style is:global>
  /* ── Orders panel: shared card/toolbar chrome (.orders-panel-head,
     .orders-toolbar, .orders-list, .order-card*, .order-new-dot, the
     #dash-main-card hover-suppression) moved to dashboard.css (2026-07-14) so
     the admin dashboard's orders tab can reuse the exact same classes without
     duplicating CSS — Astro component-local <style> only ships on pages that
     render this component, so admin/index.astro (which never imports
     dashboard.astro) couldn't see rules defined here. ── */

  /* ── Order status custom dropdown ── */
  .order-status-dropdown { position: relative; }
  .order-status-trigger {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: 9999px; cursor: pointer;
    font-family: inherit; font-size: 0.83rem; font-weight: 500;
    color: var(--color-text); white-space: nowrap;
    transition: border-color 0.12s;
  }
  .order-status-trigger:hover { border-color: var(--color-muted); }
  .order-status-trigger[aria-expanded="true"] { border-color: var(--color-accent); }
  .order-status-chevron {
    flex-shrink: 0; color: var(--color-muted);
    transition: transform 150ms cubic-bezier(0.34,1.56,0.64,1);
  }
  .order-status-trigger[aria-expanded="true"] .order-status-chevron { transform: rotate(180deg); }

  .order-status-menu {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 5px);
    min-width: 11rem; white-space: nowrap;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.3rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    z-index: 60;
    list-style: none; margin: 0;
    animation: status-pop 0.13s cubic-bezier(0.34,1.56,0.64,1) forwards;
  }
  @keyframes status-pop {
    from { opacity: 0; transform: translateY(-5px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }
  .order-status-option {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.75rem; border-radius: 4px;
    font-size: 0.84rem; font-weight: 500;
    cursor: pointer; font-family: inherit;
    color: var(--color-text); background: none; border: none;
    width: 100%; text-align: start;
    transition: background 0.1s;
  }
  .order-status-option:hover { background: var(--color-bg); }
  .order-status-option[aria-selected="true"] { font-weight: 700; }
  .order-status-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  }

  /* ── Edit order modal centering ── */
  #edit-order-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    max-height: 90vh;
    overflow: visible;
  }
  #edit-order-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  /* ── Edit-order item rows ── */
  .eom-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: opacity 0.15s;
  }
  .eom-item:last-child { border-bottom: none; }
  .eom-item--deleted { opacity: 0.4; }
  .eom-item--deleted .eom-item__name { text-decoration: line-through; }
  .eom-item__img {
    width: 34px; height: 34px; object-fit: cover;
    border-radius: 6px; flex-shrink: 0;
    border: 1px solid var(--color-border);
  }
  .eom-item__img-ph {
    width: 34px; height: 34px; border-radius: 6px; flex-shrink: 0;
    background: var(--color-bg); border: 1px solid var(--color-border);
  }
  .eom-item__name { flex: 1; font-size: 0.82rem; font-weight: 500; color: var(--color-text); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eom-item__meta { font-size: 0.78rem; color: var(--color-muted); flex-shrink: 0; white-space: nowrap; }
  .eom-item__del {
    width: 24px; height: 24px; border-radius: 5px; flex-shrink: 0;
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-muted); cursor: pointer; display: flex;
    align-items: center; justify-content: center;
    transition: background 0.1s, color 0.1s, border-color 0.1s;
  }
  .eom-item__del:hover { background: #fee2e2; color: #dc2626; border-color: #fca5a5; }
  .eom-item--deleted .eom-item__del { background: var(--color-bg); color: var(--color-accent); border-color: var(--color-accent); }

  /* Discount type toggle */
  .eom-dtype-btn { background: var(--color-surface); color: var(--color-muted); }
  .eom-dtype-btn--active { background: var(--color-text); color: var(--color-surface); }

  .dash-tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ef4444;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    min-width: 16px;
    height: 16px;
    border-radius: 20px;
    padding: 0 4px;
    margin-inline-start: 4px;
    vertical-align: middle;
  }

  /* ── Store-switcher alert dots ── */
  .store-switcher__alert-dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: #ef4444;
    border-radius: 50%;
    flex-shrink: 0;
    margin-inline-start: 0.15rem;
    align-self: center;
  }
  .store-switcher__item-dot {
    display: inline-block;
    width: 7px; height: 7px;
    background: #ef4444;
    border-radius: 50%;
    flex-shrink: 0;
  }

</style>

<div class="crop-modal" id="crop-modal" hidden aria-modal="true" role="dialog">
  <div class="crop-panel">
    <h3>{d.cropTitle}</h3>
    <div class="crop-viewport" id="crop-viewport">
      <img class="crop-img" id="crop-img" alt="" />
      <div class="crop-hint" id="crop-hint" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20"/></svg>
        {lang === 'he' ? 'גרור למיקום · גלול לזום' : 'Drag to reposition · Scroll to zoom'}
      </div>
    </div>
    <div class="crop-controls">
      <label class="crop-zoom-label">
        {d.cropZoom}
        <input type="range" class="crop-zoom-input" id="crop-zoom" min="1" max="3" step="0.01" value="1" />
      </label>
    </div>
    <div class="crop-actions">
      <button class="btn btn--sm" id="crop-apply" type="button">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        {d.cropApply}
      </button>
      <button class="btn btn--ghost btn--sm" id="crop-cancel" type="button">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        {d.cancel}
      </button>
    </div>
  </div>
</div>

<div class="cleanup-modal" id="cleanup-modal" hidden aria-modal="true" role="dialog">
  <div class="cleanup-panel">
    <h3>{d.cleanupTitle}</h3>
    <div class="cleanup-viewport" id="cleanup-viewport">
      <canvas id="cleanup-canvas"></canvas>
      <div class="cleanup-brush-cursor" id="cleanup-brush-cursor" hidden aria-hidden="true"></div>
    </div>
    <div class="cleanup-controls">
      <div class="cleanup-mode-toggle" role="group" aria-label={d.cleanupTitle}>
        <button type="button" class="cleanup-mode-btn cleanup-mode-btn--active" id="cleanup-mode-erase" data-mode="erase">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/><path d="M22 21H7"/><path d="m5 11 9 9"/></svg>
          {d.cleanupErase}
        </button>
        <button type="button" class="cleanup-mode-btn" id="cleanup-mode-restore" data-mode="restore">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"/><path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z"/></svg>
          {d.cleanupRestore}
        </button>
        <button type="button" class="cleanup-mode-btn" id="cleanup-mode-pan" data-mode="pan" disabled>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/><polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
          {d.cleanupPan}
        </button>
      </div>
      <label class="cleanup-brush-label">
        {d.cleanupZoom}
        <input type="range" class="cleanup-brush-input" id="cleanup-zoom" min="1" max="4" step="0.1" value="1" />
      </label>
      <label class="cleanup-brush-label">
        {d.cleanupBrushSize}
        <input type="range" class="cleanup-brush-input" id="cleanup-brush-size" min="6" max="80" step="1" value="24" />
      </label>
    </div>
    <div class="cleanup-actions">
      <button class="btn btn--sm" id="cleanup-apply" type="button">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        {d.cleanupApply}
      </button>
      <button class="btn btn--ghost btn--sm" id="cleanup-reset" type="button">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        {d.cleanupReset}
      </button>
      <button class="btn btn--ghost btn--sm" id="cleanup-cancel" type="button">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        {d.cancel}
      </button>
    </div>
  </div>
</div>

<!-- ── Edit Order Details Modal ── -->
<dialog id="edit-order-modal" aria-labelledby="eom-title" style="border:none;border-radius:14px;padding:0;width:min(520px,96vw);box-shadow:0 16px 56px rgba(0,0,0,0.26);background:var(--color-surface);margin:auto">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border);flex-shrink:0">
    <h2 id="eom-title" style="font-size:0.95rem;font-weight:700;margin:0">ערוך פרטי הזמנה</h2>
    <button id="edit-order-modal-close" type="button" aria-label="סגור" style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:none;background:none;color:var(--color-muted);cursor:pointer;transition:background 0.1s">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <form id="edit-order-form" style="padding:1.25rem;display:flex;flex-direction:column;gap:0.75rem;overflow-y:auto;max-height:calc(85vh - 4rem)">
    <input type="hidden" id="edit-order-id" value="" />
    <input type="hidden" id="edit-order-store-slug" value="" />

    <!-- Buyer details -->
    <p style="font-size:0.75rem;font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0">פרטי לקוח</p>
    <div class="field-row">
      <label class="field" style="flex:1">
        <span>שם מלא</span>
        <input class="input" id="eob-name" name="buyerName" required placeholder="שם מלא" />
      </label>
      <label class="field" style="flex:1">
        <span>טלפון</span>
        <input class="input" id="eob-phone" name="buyerPhone" placeholder="טלפון" />
      </label>
    </div>
    <label class="field">
      <span>אימייל</span>
      <input class="input" id="eob-email" name="buyerEmail" type="email" placeholder="אימייל" />
    </label>
    <div class="field-row">
      <label class="field" style="flex:2">
        <span>רחוב ומספר</span>
        <input class="input" id="eob-street" name="buyerStreet" placeholder="רחוב ומספר" />
      </label>
      <label class="field" style="flex:1">
        <span>עיר</span>
        <input class="input" id="eob-city" name="buyerCity" placeholder="עיר" />
      </label>
      <label class="field" style="flex:1">
        <span>מיקוד</span>
        <input class="input" id="eob-zip" name="buyerZip" placeholder="מיקוד" />
      </label>
    </div>

    <!-- Items (delete only) -->
    <div style="border-top:1px solid var(--color-border);padding-top:0.75rem;margin-top:0.1rem">
      <p style="font-size:0.75rem;font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0 0 0.5rem">פריטים</p>
      <div id="eom-items-list"></div>
    </div>

    <!-- Shipping method (placeholder — wired later) -->
    <div style="border-top:1px solid var(--color-border);padding-top:0.75rem">
      <p style="font-size:0.75rem;font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0 0 0.5rem">שיטת משלוח</p>
      <div style="display:flex;align-items:center;justify-content:space-between;background:var(--color-bg);border:1px solid var(--color-border);border-radius:10px;padding:0.6rem 0.85rem;gap:0.75rem">
        <div style="display:flex;align-items:center;gap:0.55rem">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-muted);flex-shrink:0" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span id="eom-shipping-label" style="font-size:0.85rem;font-weight:500;color:var(--color-text)">משלוח רגיל</span>
          <span id="eom-shipping-amount" style="font-size:0.82rem;color:var(--color-muted)"></span>
        </div>
        <button
          type="button"
          disabled
          title="בקרוב"
          style="font-size:0.75rem;font-weight:500;color:var(--color-muted);background:none;border:1px solid var(--color-border);border-radius:6px;padding:0.25rem 0.6rem;cursor:not-allowed;font-family:inherit;opacity:0.6;flex-shrink:0"
        >שנה שיטת משלוח</button>
      </div>
    </div>

    <!-- Discount -->
    <div style="border-top:1px solid var(--color-border);padding-top:0.75rem">
      <p style="font-size:0.75rem;font-weight:700;color:var(--color-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0 0 0.5rem">הנחה</p>
      <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
        <div style="display:flex;border:1px solid var(--color-border);border-radius:8px;overflow:hidden;flex-shrink:0">
          <button type="button" id="eom-dtype-pct" class="eom-dtype-btn eom-dtype-btn--active" style="padding:0.3rem 0.65rem;font-size:0.82rem;font-weight:600;border:none;cursor:pointer;font-family:inherit;transition:background 0.1s,color 0.1s">%</button>
          <button type="button" id="eom-dtype-amt" class="eom-dtype-btn" style="padding:0.3rem 0.65rem;font-size:0.82rem;font-weight:600;border:none;border-right:1px solid var(--color-border);cursor:pointer;font-family:inherit;transition:background 0.1s,color 0.1s">₪</button>
        </div>
        <input class="input" id="eom-discount-val" type="number" min="0" step="1" placeholder="0" style="width:90px" />
        <span id="eom-discount-preview" style="font-size:0.82rem;color:var(--color-muted)"></span>
      </div>
    </div>

    <p id="edit-order-error" style="font-size:0.8rem;color:#dc2626;margin:0;display:none"></p>
    <p id="edit-order-success" style="font-size:0.8rem;color:#16a34a;margin:0;text-align:center;display:none">ההזמנה עודכנה בהצלחה ✓</p>
    <div style="display:flex;gap:0.5rem;justify-content:flex-end;padding-top:0.25rem;border-top:1px solid var(--color-border)">
      <button class="btn btn--ghost btn--sm" type="button" id="edit-order-cancel">ביטול</button>
      <button class="btn btn--accent btn--sm" type="submit" id="edit-order-save">שמור שינויים</button>
    </div>
  </form>
</dialog>

<script>
  import { initCropModal } from '../../scripts/dashboard/crop-modal.js';
  import { initCleanupModal } from '../../scripts/dashboard/cleanup-modal.js';
  import { initGalleryWidget } from '../../scripts/dashboard/gallery.js';
  import { bindExistingRows, initAddProduct, initDeleteProduct, initProductMenus, initProductsToolbar, initSpecsEditors, initVariantEditors, initTagsEditor, initRemoveConfirm, initStockBreakdowns, initBulkSelect, initThumbs, initInlineEdit, initViewProduct, initPagination, initStickyOffsets } from '../../scripts/dashboard/products.js';
  import { initCsvImport } from '../../scripts/dashboard/csv-import.js';
  import { initSettingsForm, initFormToggles, initStoreSwitcher, initAutoHideStatus, initDashTabs, initStoreHours } from '../../scripts/dashboard/ui.js';
  import { initStoreImageWidget } from '../../scripts/dashboard/store-image.js';
  import { initCategoryTreeEditor } from '../../scripts/dashboard/category-tree.js';
  import { initCategoryPicker } from '../../scripts/dashboard/category-picker.js';
  import { createFloatingPortal } from '../../lib/toolbar-portal.js';
  import { escapeHtml } from '../../lib/html-escape.js';
  import { formatHeDateTime } from '../../lib/format-date.js';

  const uploadCfg = document.getElementById('upload-config');
  const CLOUD  = uploadCfg?.dataset.cloud  ?? '';
  const PRESET = uploadCfg?.dataset.preset ?? '';

  // clean status params from URL + handle deep-link params
  {
    const u = new URL(window.location.href);
    if (u.searchParams.has('saved') || u.searchParams.has('added')) {
      u.searchParams.delete('saved'); u.searchParams.delete('added'); history.replaceState(null, '', u.toString());
    }
  }

  initDashTabs();

  // Deep-link: ?panel=messages&msg=<id>
  {
    const params = new URLSearchParams(window.location.search);
    const panel  = params.get('panel');
    const msgId  = params.get('msg');
    if (panel) {
      const tabBtn = document.querySelector<HTMLButtonElement>(`[role="tab"][data-panel="${panel}"]`);
      if (tabBtn) tabBtn.click();
      if (msgId && panel === 'messages') {
        requestAnimationFrame(() => {
          const card = document.querySelector<HTMLElement>(`[data-msg-id="${CSS.escape(msgId)}"]`);
          if (card) { card.click(); card.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        });
      }
    }
    if (msgId) {
      const u = new URL(window.location.href);
      u.searchParams.delete('msg');
      history.replaceState(null, '', u.toString());
    }
  }
  // Admin↔seller messages — single flat conversation (see AdminMessage in
  // admin-messages.ts), so unlike the buyer-messages tab there's just one
  // thread to render/reply to, not a table of subject-based threads.
  {
    const sendBtn  = document.getElementById('admin-msg-seller-send') as HTMLButtonElement | null;
    const textarea = document.getElementById('admin-msg-seller-textarea') as HTMLTextAreaElement | null;
    const threadEl = document.getElementById('admin-msg-thread-seller');
    const tabBtn   = document.getElementById('tab-admin-messages');

    function markAdminMsgsRead() {
      fetch('/api/admin-messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'mark-read' }),
      }).then(() => {
        document.querySelector('#tab-admin-messages span[aria-label]')?.remove();
        window.dispatchEvent(new CustomEvent('notif-refreshed'));
      }).catch(() => {});
    }

    if (tabBtn?.classList.contains('dash-tab--active')) markAdminMsgsRead();
    tabBtn?.addEventListener('click', markAdminMsgsRead);

    sendBtn?.addEventListener('click', async () => {
      const content = textarea?.value.trim() ?? '';
      if (!content || !threadEl) return;
      sendBtn.disabled = true;
      try {
        const res = await fetch('/api/admin-messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        const data = await res.json() as { message?: { content: string; createdAt: string } };
        if (res.ok && data.message) {
          document.getElementById('admin-msg-seller-empty')?.remove();
          const div = document.createElement('div');
          div.className = 'msg-thread-entry msg-thread-entry--seller';
          div.innerHTML = `<div class="msg-thread-entry__header"><span class="msg-thread-entry__who">אתה</span><span class="msg-thread-entry__date">${escapeHtml(formatHeDateTime(data.message.createdAt))}</span></div><div class="msg-thread-entry__body">${escapeHtml(data.message.content)}</div>`;
          threadEl.appendChild(div);
          if (textarea) textarea.value = '';
        }
      } catch { /* ignore */ } finally {
        sendBtn.disabled = false;
      }
    });
  }

  initCropModal();
  initCleanupModal();

  {
    let dashI18n: Record<string, string> = {};
    try { dashI18n = JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}').dashboard ?? {}; } catch { /* noop */ }
    const labels = {
      upload: dashI18n.uploadImage ?? 'Upload image',
      change: dashI18n.storeImageChange ?? 'Change image',
      remove: dashI18n.removeImage ?? 'Remove',
      uploading: dashI18n.uploadingImage ?? 'Uploading image…',
    };
    initStoreImageWidget({
      frameId: 'banner-frame', fileInputId: 'banner-file-input', hiddenInputId: 'banner-image-input',
      uploadBtnId: 'banner-upload-btn', removeBtnId: 'banner-remove-btn',
      aspect: 3, vpWidth: 420, previewWidth: 900, cloud: CLOUD, preset: PRESET, labels,
    });
    initStoreImageWidget({
      frameId: 'avatar-frame', fileInputId: 'avatar-file-input', hiddenInputId: 'avatar-image-input',
      uploadBtnId: 'avatar-upload-btn', removeBtnId: 'avatar-remove-btn',
      aspect: 1, vpWidth: 220, previewWidth: 200, cloud: CLOUD, preset: PRESET, labels,
    });
  }
  initSpecsEditors();
  // Registered before the editors below: its document-level click listener
  // must see the pre-click "is anything armed?" state before either editor's
  // own listener arms a *new* confirm on this same click — otherwise the
  // just-armed span looks like a stale one (its trigger element just got
  // replaced) and gets cancelled in the same event that armed it.
  initRemoveConfirm();
  initVariantEditors();
  initTagsEditor();
  initStockBreakdowns();
  document.querySelectorAll<Element>('.gallery-widget').forEach(g => initGalleryWidget(g));
  bindExistingRows(CLOUD, PRESET);
  document.querySelectorAll<HTMLElement>('.category-picker').forEach(initCategoryPicker);
  initAddProduct(CLOUD, PRESET);
  initProductMenus();
  initDeleteProduct();
  initSettingsForm();
  initStoreHours();
  initCategoryTreeEditor();
  initFormToggles();
  initStoreSwitcher();
  initAutoHideStatus();
  initProductsToolbar();
  initBulkSelect(CLOUD, PRESET);
  initCsvImport(CLOUD, PRESET);
  initThumbs();
  initInlineEdit();
  initPagination();
  initStickyOffsets();
  initViewProduct();

  // ── Order cards: accordion + save status/tracking ────────────
  const colorMap = { pending:'#ef4444', processing:'#3b82f6', ready:'#f59e0b', shipped:'#8b5cf6', delivered:'#16a34a' } as Record<string, string>;
  const labelMap = { pending:'חדשה', processing:'בטיפול', ready:'ממתין לאיסוף', shipped:'נשלח', delivered:'נמסר' } as Record<string, string>;
  const storeSlugForOrders = (document.getElementById('upload-config') as HTMLElement | null)?.dataset.storeSlug ?? '';

  function updateOrderTabBadge(): void {
    const remaining = document.querySelectorAll('.order-new-dot').length;
    const tabBadge  = document.querySelector<HTMLElement>('#tab-orders .dash-tab-badge');
    const tabBtn    = document.getElementById('tab-orders');
    if (remaining === 0) {
      tabBadge?.remove();
    } else if (tabBadge) {
      tabBadge.textContent = String(remaining);
    } else if (tabBtn) {
      const span = document.createElement('span');
      span.className = 'dash-tab-badge';
      span.setAttribute('aria-label', `${remaining} הזמנות חדשות`);
      span.textContent = String(remaining);
      tabBtn.appendChild(span);
    }
    updateSwitcherAlertDot();
  }

  // Keeps the store-switcher title dot (and this store's own row-dot in the
  // dropdown) in sync as orders get handled / messages get read — without a
  // page reload. Re-derives "does the current store still have an alert"
  // from what's actually left in the DOM (.order-new-dot / .msg-table__row--unread),
  // since those are already kept accurate by the order/message handlers.
  function updateSwitcherAlertDot(): void {
    const switcherBtn = document.getElementById('store-switcher-btn');
    const menu        = document.getElementById('store-switcher-menu');
    if (!switcherBtn || !menu) return;

    const currentLink = menu.querySelector<HTMLElement>('a.store-option--current');
    if (currentLink) {
      const dotHost = currentLink.querySelector<HTMLElement>('.store-switcher__item-actions');
      const dot     = currentLink.querySelector<HTMLElement>('.store-switcher__item-dot');
      const currentHasAlert =
        document.querySelectorAll('.order-new-dot').length > 0 ||
        document.querySelectorAll('.msg-table__row--unread').length > 0;
      if (currentHasAlert && !dot && dotHost) {
        const newDot = document.createElement('span');
        newDot.className = 'store-switcher__item-dot';
        newDot.setAttribute('aria-label', 'יש התראות');
        dotHost.prepend(newDot);
      } else if (!currentHasAlert && dot) {
        dot.remove();
      }
    }

    // Button dot only reflects OTHER stores — the whole point is to send the
    // seller there. If it's the current store's own alert, they're already
    // looking at it, so it's excluded here (see hasAnyNonCurrentAlert above).
    const anyOtherAlert = Array.from(menu.querySelectorAll<HTMLElement>('.store-switcher__item-dot'))
      .some((dot) => !dot.closest('a')?.classList.contains('store-option--current'));
    let btnDot = switcherBtn.querySelector<HTMLElement>('.store-switcher__alert-dot');
    if (anyOtherAlert && !btnDot) {
      btnDot = document.createElement('span');
      btnDot.className = 'store-switcher__alert-dot';
      btnDot.setAttribute('aria-label', 'יש התראות בחנויות אחרות');
      switcherBtn.querySelector('.store-switcher__chevron')?.after(btnDot);
    } else if (!anyOtherAlert && btnDot) {
      btnDot.remove();
    }
  }

  function bindOrderCard(card: HTMLElement): void {
    if (card.dataset.bound === '1') return;
    card.dataset.bound = '1';

    const header     = card.querySelector<HTMLElement>('.order-card__header');
    const body       = card.querySelector<HTMLElement>('.order-card__body');
    const saveBtn       = card.querySelector<HTMLButtonElement>('.order-save-btn');
    const saveStatus    = card.querySelector<HTMLElement>('.order-save-status');
    const statusInput   = card.querySelector<HTMLInputElement>('.order-status-select');
    const statusTrigger = card.querySelector<HTMLButtonElement>('.order-status-trigger');
    const statusMenu    = card.querySelector<HTMLUListElement>('.order-status-menu');
    const trackInput    = card.querySelector<HTMLInputElement>('.order-tracking-input');
    const orderId       = card.dataset.orderId ?? '';
    const storeSlug     = card.dataset.storeSlug ?? '';

    // status dropdown toggle
    statusTrigger?.addEventListener('click', (e: MouseEvent) => {
      e.stopPropagation();
      const isOpen = statusMenu && !statusMenu.hidden;
      // close any other open status menus first
      document.querySelectorAll<HTMLElement>('.order-status-menu:not([hidden])').forEach((m) => {
        if (m !== statusMenu) {
          m.hidden = true;
          m.closest('.order-status-dropdown')?.querySelector<HTMLButtonElement>('.order-status-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
      if (statusMenu) {
        statusMenu.hidden = !!isOpen;
        statusTrigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      }
    });

    // option selection
    statusMenu?.querySelectorAll<HTMLButtonElement>('.order-status-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        const val = opt.dataset.value ?? '';
        if (statusInput) statusInput.value = val;
        const col = colorMap[val] ?? '#888';
        const lbl = labelMap[val] ?? val;
        const dot = statusTrigger?.querySelector<HTMLElement>('.order-status-dot');
        const lbl_el = statusTrigger?.querySelector<HTMLElement>('.order-status-label');
        if (dot) dot.style.background = col;
        if (lbl_el) lbl_el.textContent = lbl;
        statusMenu.querySelectorAll<HTMLButtonElement>('[role="option"]').forEach((o) => o.setAttribute('aria-selected', 'false'));
        opt.setAttribute('aria-selected', 'true');
        statusMenu.hidden = true;
        statusTrigger?.setAttribute('aria-expanded', 'false');
      });
    });

    function closeCard(): void {
      card.classList.remove('order-card--open');
      if (body) body.hidden = true;
      header?.setAttribute('aria-expanded', 'false');
    }

    header?.addEventListener('click', () => {
      const isOpen = card.classList.contains('order-card--open');
      if (isOpen) {
        closeCard();
      } else {
        card.classList.add('order-card--open');
        if (body) body.hidden = false;
        header.setAttribute('aria-expanded', 'true');
      }
    });
    header?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); header.click(); }
    });

    saveBtn?.addEventListener('click', async () => {
      if (!orderId) return;
      saveBtn.disabled = true;
      const hadDot   = !!card.querySelector('.order-new-dot');
      const newStatus = statusInput?.value ?? '';
      try {
        const res = await fetch('/api/seller/orders', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId, storeSlug, shippingStatus: newStatus, trackingNumber: trackInput?.value ?? '' }),
        });
        if (res.ok) {
          if (saveStatus) { saveStatus.hidden = false; setTimeout(() => { saveStatus.hidden = true; }, 2500); }
          // update status badge color
          const badge = card.querySelector<HTMLElement>('.order-card__status-badge');
          if (badge && newStatus) {
            badge.style.background = `${colorMap[newStatus] ?? '#888'}1a`;
            badge.style.color = colorMap[newStatus] ?? '#888';
            badge.textContent = labelMap[newStatus] ?? newStatus;
          }
          // moving AWAY from pending → remove dot + delete notification
          if (hadDot && newStatus !== 'pending') {
            card.querySelector('.order-new-dot')?.remove();
            fetch('/api/notifications', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete-by-related', relatedId: orderId }),
            }).catch(() => {});
            window.dispatchEvent(new CustomEvent('notif-refreshed'));
          }
          // update data attribute + re-apply filter (may hide delivered in active view)
          card.dataset.shippingStatus = newStatus;
          applyOrdersFilter();
          // moving BACK to pending → re-add dot
          if (!hadDot && newStatus === 'pending') {
            const idSpan = card.querySelector('.order-card__id');
            if (idSpan && !idSpan.querySelector('.order-new-dot')) {
              const dot = document.createElement('span');
              dot.className = 'order-new-dot';
              dot.setAttribute('aria-label', 'הזמנה חדשה');
              idSpan.appendChild(dot);
            }
          }
          updateOrderTabBadge();
          setTimeout(closeCard, 700);
        }
      } catch { /* ignore */ } finally {
        saveBtn.disabled = false;
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.order-card').forEach(bindOrderCard);

  // close open status menus when clicking outside
  document.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.order-status-menu:not([hidden])').forEach((m) => {
      m.hidden = true;
      m.closest('.order-status-dropdown')?.querySelector<HTMLButtonElement>('.order-status-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });

  // ── Orders: sort + filter ────────────────────────────────────
  // Cards-only at every screen size (no table/header split like
  // products/messages), so one always-visible toolbar instead of a
  // desktop-header + mobile-dropdown pair. Filter uses the same
  // column-list → values drill-down as products'/messages' own "filter by"
  // (ORDER_FILTER_COLUMNS today only has 'status', but the mechanism is
  // ready for more columns later without restructuring). Default selection
  // replicates the old "active" preset.
  const ACTIVE_STATUSES = new Set(['pending', 'processing', 'ready', 'shipped']);
  const ORDER_STATUSES = ['pending', 'processing', 'ready', 'shipped', 'delivered'];
  const ORDER_STATUS_RANK: Record<string, number> = { pending: 0, processing: 1, ready: 2, shipped: 3, delivered: 4 };
  const ORDER_FILTER_COLUMNS = ['status']; // add more column keys here (+ a case in getOrderFilterValue) if warranted later
  const ordersFilters = new Map<string, Set<string>>([['status', new Set(ACTIVE_STATUSES)]]);
  let ordersSortCol: 'date' | 'amount' | 'status' = 'date';
  let ordersSortDir: 'asc' | 'desc' = 'desc';
  let ordersDashI18n: Record<string, string> = {};
  try { ordersDashI18n = JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}').dashboard ?? {}; } catch { /* noop */ }

  const ORDER_SORT_OPTIONS: { col: 'date' | 'amount' | 'status'; dir: 'asc' | 'desc'; label: () => string }[] = [
    { col: 'date', dir: 'desc', label: () => ordersDashI18n.orderSortOptDateDesc ?? 'תאריך: חדש — ישן' },
    { col: 'date', dir: 'asc', label: () => ordersDashI18n.orderSortOptDateAsc ?? 'תאריך: ישן — חדש' },
    { col: 'amount', dir: 'desc', label: () => ordersDashI18n.orderSortOptAmountDesc ?? 'סכום: גבוה — נמוך' },
    { col: 'amount', dir: 'asc', label: () => ordersDashI18n.orderSortOptAmountAsc ?? 'סכום: נמוך — גבוה' },
    { col: 'status', dir: 'asc', label: () => ordersDashI18n.orderSortOptStatusAsc ?? 'סטטוס: הזמנות חדשות קודם' },
  ];

  function getOrderSortValue(card: HTMLElement, col: 'date' | 'amount' | 'status'): string | number {
    if (col === 'amount') return parseFloat(card.dataset.sortAmount ?? '0');
    if (col === 'status') return ORDER_STATUS_RANK[card.dataset.shippingStatus ?? ''] ?? 99;
    return card.dataset.sortDate ?? '';
  }

  function getOrderFilterValue(card: HTMLElement, col: string): string {
    if (col === 'status') return card.dataset.shippingStatus ?? '';
    return '';
  }

  function orderFilterColumnLabel(col: string): string {
    if (col === 'status') return ordersDashI18n.filterColStatus ?? 'סטטוס';
    return col;
  }

  // 'status' is a fixed small enum, kept in workflow order (not alphabetical)
  // — a future free-text column would instead scan .order-card for its
  // distinct values, same as products'/messages' own getDistinctFilterValues.
  function getOrderDistinctValues(col: string): string[] {
    if (col === 'status') return ORDER_STATUSES;
    const values = new Set<string>();
    document.querySelectorAll<HTMLElement>('.order-card').forEach((card) => values.add(getOrderFilterValue(card, col)));
    return [...values].sort();
  }

  function orderFilterValueHtml(col: string, value: string): string {
    if (col === 'status') return `<span class="order-status-dot" style="background:${colorMap[value] ?? '#888'}"></span>${labelMap[value] ?? value}`;
    return value;
  }

  function rowMatchesOrderFilters(card: HTMLElement): boolean {
    for (const [col, values] of ordersFilters) {
      if (values.size === 0) continue;
      if (!values.has(getOrderFilterValue(card, col))) return false;
    }
    return true;
  }

  function refreshOrdersFilterBadge(): void {
    const badge = document.getElementById('orders-filter-count');
    if (!badge) return;
    const activeCols = [...ordersFilters.values()].filter((s) => s.size > 0).length;
    badge.hidden = activeCols === 0;
    badge.textContent = String(activeCols);
  }

  function applyOrdersFilter(): void {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.order-card').forEach((card) => {
      const show = rowMatchesOrderFilters(card);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const emptyEl = document.getElementById('orders-filter-empty');
    if (emptyEl) emptyEl.hidden = visible > 0;
    refreshOrdersFilterBadge();
  }

  function sortOrders(col: 'date' | 'amount' | 'status', dir: 'asc' | 'desc'): void {
    ordersSortCol = col;
    ordersSortDir = dir;
    const list = document.getElementById('orders-list');
    if (list) {
      const cards = Array.from(list.querySelectorAll<HTMLElement>('.order-card'));
      cards.sort((a, b) => {
        const va = getOrderSortValue(a, col);
        const vb = getOrderSortValue(b, col);
        const cmp = va < vb ? -1 : va > vb ? 1 : 0;
        return dir === 'asc' ? cmp : -cmp;
      });
      cards.forEach((card) => list.append(card));
    }
    const label = document.getElementById('orders-sort-label');
    if (label) {
      const opt = ORDER_SORT_OPTIONS.find((o) => o.col === col && o.dir === dir) ?? ORDER_SORT_OPTIONS[0]!;
      label.textContent = opt.label();
    }
  }

  const ordersPortal = createFloatingPortal('orders-toolbar-portal');

  function openOrdersSort(trigger: HTMLElement): void {
    ordersPortal.open(trigger, '13rem', () => ORDER_SORT_OPTIONS.map((o) => {
      const selected = o.col === ordersSortCol && o.dir === ordersSortDir;
      return `<button type="button" class="product-menu__item" data-sort-col="${o.col}" data-sort-dir="${o.dir}" style="cursor:pointer${selected ? ';font-weight:700;color:var(--color-primary)' : ''}">${o.label()}</button>`;
    }).join(''), (portal) => {
      portal.querySelectorAll<HTMLButtonElement>('[data-sort-col]').forEach((btn) => {
        btn.addEventListener('click', () => {
          sortOrders((btn.dataset.sortCol as 'date' | 'amount' | 'status') ?? 'date', (btn.dataset.sortDir as 'asc' | 'desc') ?? 'desc');
          ordersPortal.close();
        });
      });
    });
  }

  function ordersFilterValuesHtml(col: string): string {
    const values = getOrderDistinctValues(col);
    const selected = ordersFilters.get(col) ?? new Set<string>();
    const backRotate = document.documentElement.dir === 'rtl' ? -90 : 90;
    return [
      `<button type="button" class="product-menu__back" data-filter-back><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transform:rotate(${backRotate}deg)"><polyline points="6 9 12 15 18 9"/></svg>${orderFilterColumnLabel(col)}</button>`,
      `<div class="product-menu__divider"></div>`,
      ...values.map((v) => `<label class="product-menu__checkbox-item"><input type="checkbox" data-order-filter-value="${v}" ${selected.has(v) ? 'checked' : ''}>${orderFilterValueHtml(col, v)}</label>`),
      `<div class="product-menu__divider"></div>`,
      `<button type="button" class="product-menu__clear" data-orders-filter-clear-col>${ordersDashI18n.filterClearColumn ?? 'נקה סינון בעמודה זו'}</button>`,
    ].join('');
  }

  function ordersFilterColumnsHtml(): string {
    const chevronRotate = document.documentElement.dir === 'rtl' ? 90 : -90;
    return [
      ...ORDER_FILTER_COLUMNS.map((col) => {
        const active = (ordersFilters.get(col)?.size ?? 0) > 0;
        return `<div class="product-menu__item" data-filter-col="${col}" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
          <input type="checkbox" data-filter-col-toggle="${col}" ${active ? 'checked' : ''} style="cursor:pointer;flex-shrink:0">
          <span style="flex:1">${orderFilterColumnLabel(col)}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transform:rotate(${chevronRotate}deg)"><polyline points="6 9 12 15 18 9"/></svg>
        </div>`;
      }).join(''),
      `<div class="product-menu__divider"></div>`,
      `<button type="button" class="product-menu__clear" data-orders-filter-clear-all>${ordersDashI18n.filterClearAll ?? 'נקה הכל'}</button>`,
    ].join('');
  }

  function openOrdersFilterValues(trigger: HTMLElement, col: string): void {
    ordersPortal.open(trigger, '12rem', () => ordersFilterValuesHtml(col), (portal) => {
      portal.querySelectorAll<HTMLInputElement>('[data-order-filter-value]').forEach((cb) => {
        cb.addEventListener('change', () => {
          const set = ordersFilters.get(col) ?? new Set<string>();
          const v = cb.dataset.orderFilterValue ?? '';
          if (cb.checked) set.add(v); else set.delete(v);
          if (set.size) ordersFilters.set(col, set); else ordersFilters.delete(col);
          applyOrdersFilter();
        });
      });
      portal.querySelector('[data-filter-back]')?.addEventListener('click', () => openOrdersFilterColumns(trigger));
      portal.querySelector('[data-orders-filter-clear-col]')?.addEventListener('click', () => {
        ordersFilters.delete(col);
        applyOrdersFilter();
        openOrdersFilterValues(trigger, col);
      });
    });
  }

  function openOrdersFilterColumns(trigger: HTMLElement): void {
    ordersPortal.open(trigger, '12rem', ordersFilterColumnsHtml, (portal) => {
      portal.querySelectorAll<HTMLElement>('[data-filter-col]').forEach((row) => {
        const col = row.dataset.filterCol ?? '';
        row.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('[data-filter-col-toggle]')) return;
          openOrdersFilterValues(trigger, col);
        });
        const cb = row.querySelector<HTMLInputElement>('[data-filter-col-toggle]');
        cb?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (cb.checked) {
            cb.checked = false;
            openOrdersFilterValues(trigger, col);
            return;
          }
          ordersFilters.delete(col);
          applyOrdersFilter();
          openOrdersFilterColumns(trigger);
        });
      });
      portal.querySelector('[data-orders-filter-clear-all]')?.addEventListener('click', () => {
        ordersFilters.clear();
        applyOrdersFilter();
        openOrdersFilterColumns(trigger);
      });
    });
  }

  const ordersSortTrigger = document.getElementById('orders-sort-trigger') as HTMLButtonElement | null;
  ordersSortTrigger?.addEventListener('click', () => {
    if (ordersPortal.currentTrigger() === ordersSortTrigger) { ordersPortal.close(); return; }
    openOrdersSort(ordersSortTrigger);
  });

  const ordersFilterTrigger = document.getElementById('orders-filter-trigger') as HTMLButtonElement | null;
  ordersFilterTrigger?.addEventListener('click', () => {
    if (ordersPortal.currentTrigger() === ordersFilterTrigger) { ordersPortal.close(); return; }
    openOrdersFilterColumns(ordersFilterTrigger);
  });

  applyOrdersFilter();

  // ── Poll for new orders every 15s ────────────────────────────
  const ordersList = document.getElementById('orders-list');
  if (ordersList && storeSlugForOrders) {
    const knownIds = new Set(
      Array.from(document.querySelectorAll<HTMLElement>('.order-card')).map(c => c.dataset.orderId ?? '')
    );

    function fmtOrderDate(iso: string): string {
      return new Date(iso).toLocaleString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
    }
    function esc(s: unknown): string { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function fmtPrice(n: number): string { return n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',') + ' ₪'; }

    function buildOrderCard(o: {
      id: string; checkoutRef?: string; createdAt: string; buyerName: string; buyerEmail: string; buyerPhone: string;
      buyerAddress: { city: string; street: string; zip?: string };
      shippingStatus: string; items: { storeSlug: string; productName: string; qty: number; price: number; image?: string }[];
      storeSubtotals: Record<string, { subtotal: number; shipping: number; discount?: { type: string; value: number; applied: number } }>;
    }): string {
      const shortId  = o.checkoutRef ?? o.id.slice(0, 8).toUpperCase();
      const color    = colorMap[o.shippingStatus] ?? '#888';
      const label    = labelMap[o.shippingStatus] ?? o.shippingStatus;
      const storeSub = o.storeSubtotals[storeSlugForOrders] ?? { subtotal: 0, shipping: 0 };
      const total    = storeSub.subtotal + storeSub.shipping;
      const storeItems = o.items.filter(i => i.storeSlug === storeSlugForOrders);
      const isNew    = o.shippingStatus === 'pending';

      const itemsHtml = storeItems.map(item => `
        <li class="order-card__item">
          ${item.image ? `<img src="${esc(item.image)}" alt="" width="36" height="36" loading="lazy" class="order-card__item-img" />` : ''}
          <span class="order-card__item-name">${esc(item.productName)}</span>
          <span class="order-card__item-qty">×${item.qty}</span>
          <span class="order-card__item-price">${fmtPrice(item.price * item.qty)}</span>
        </li>`).join('');

      const statusEntries: [string, string][] = [
        ['pending','חדשה'],['processing','בטיפול'],['ready','ממתין לאיסוף'],['shipped','נשלח'],['delivered','נמסר']
      ];
      const statusDotHtml = (v: string) => `<span class="order-status-dot" style="background:${colorMap[v] ?? '#888'}"></span>`;
      const statusOpts = statusEntries.map(([v, l]) => `<li role="none"><button class="order-status-option" type="button" role="option" data-value="${esc(v)}" aria-selected="${o.shippingStatus === v}">${statusDotHtml(v)}${esc(l)}</button></li>`).join('');
      const statusDropdown = `<div class="order-status-dropdown">
        <button class="order-status-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
          ${statusDotHtml(o.shippingStatus)}<span class="order-status-label">${esc(label)}</span>
          <svg class="order-status-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <ul class="order-status-menu" role="listbox" hidden>${statusOpts}</ul>
        <input type="hidden" class="order-status-select" data-field="shippingStatus" value="${esc(o.shippingStatus)}" />
      </div>`;

      return `<div class="order-card" data-order-id="${esc(o.id)}" data-store-slug="${esc(storeSlugForOrders)}" data-shipping-status="${esc(o.shippingStatus)}" data-sort-date="${esc(o.createdAt)}" data-sort-amount="${total}">
        <div class="order-card__header" role="button" tabindex="0" aria-expanded="false">
          <div class="order-card__meta">
            <span class="order-card__id">#${esc(shortId)}${isNew ? '<span class="order-new-dot" aria-label="הזמנה חדשה"></span>' : ''}</span>
            <span class="order-card__date">${esc(fmtOrderDate(o.createdAt))}</span>
          </div>
          <div class="order-card__summary">
            <span class="order-card__buyer">${esc(o.buyerName)}</span>
            <span class="order-card__amount">${fmtPrice(total)}</span>
            <span class="order-card__status-badge" style="background:${esc(color)}1a;color:${esc(color)}">${esc(label)}</span>
          </div>
          <svg class="order-card__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="order-card__body" hidden>
          <div class="order-card__section">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
              <h3 class="order-card__section-title" style="margin:0">לקוח</h3>
              <button class="btn btn--ghost btn--sm order-edit-buyer-btn" type="button"
                data-order-id="${esc(o.id)}" data-store-slug="${esc(storeSlugForOrders)}"
                data-buyer-name="${esc(o.buyerName)}" data-buyer-email="${esc(o.buyerEmail)}"
                data-buyer-phone="${esc(o.buyerPhone)}" data-buyer-city="${esc(o.buyerAddress.city)}"
                data-buyer-street="${esc(o.buyerAddress.street)}" data-buyer-zip="${esc(o.buyerAddress.zip ?? '')}"
                data-items="${esc(JSON.stringify(storeItems))}"
                data-shipping="${esc(String(storeSub.shipping))}"
                data-discount-type="${esc(storeSub.discount?.type ?? 'percent')}"
                data-discount-value="${esc(String(storeSub.discount?.value ?? 0))}"
                style="font-size:0.75rem">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                ערוך פרטים
              </button>
            </div>
            <p class="order-card__info-line order-buyer-name"><strong>${esc(o.buyerName)}</strong></p>
            <p class="order-card__info-line order-buyer-email">${esc(o.buyerEmail)}</p>
            <p class="order-card__info-line order-buyer-phone">טלפון: ${esc(o.buyerPhone)}</p>
            <p class="order-card__info-line order-buyer-address">כתובת: ${esc(o.buyerAddress.street)}, ${esc(o.buyerAddress.city)}${o.buyerAddress.zip ? ' ' + esc(o.buyerAddress.zip) : ''}</p>
          </div>
          <div class="order-card__section">
            <h3 class="order-card__section-title">פריטים</h3>
            <ul class="order-card__items">${itemsHtml}</ul>
            <div class="order-card__subtotals">
              <span>משלוח: ${storeSub.shipping === 0 ? 'חינם' : fmtPrice(storeSub.shipping)}</span>
              <strong>סה"כ: ${fmtPrice(total)}</strong>
            </div>
          </div>
          <div class="order-card__section order-card__section--controls">
            <h3 class="order-card__section-title">סטטוס משלוח</h3>
            <div class="order-card__control-row">
              ${statusDropdown}
            </div>
            <h3 class="order-card__section-title" style="margin-top:0.75rem">מספר מעקב</h3>
            <div class="order-card__control-row">
              <input type="text" class="order-tracking-input input" data-field="trackingNumber" value="" placeholder="לדוגמה: IL1234567890" style="flex:1" />
              <button class="order-save-btn btn btn--sm btn--accent" type="button">שמור</button>
            </div>
            <p class="order-save-status" hidden aria-live="polite">נשמר ✓</p>
          </div>
        </div>
      </div>`;
    }

    async function pollOrders(): Promise<void> {
      if (!ordersList) return;
      try {
        const res = await fetch(`/api/seller/orders?storeSlug=${encodeURIComponent(storeSlugForOrders)}`);
        if (!res.ok) return;
        const { orders } = await res.json() as { orders: Parameters<typeof buildOrderCard>[0][] };
        const newOrders = orders.filter(o => !knownIds.has(o.id));
        if (!newOrders.length) return;
        newOrders.forEach(o => {
          knownIds.add(o.id);
          const tmp = document.createElement('div');
          tmp.innerHTML = buildOrderCard(o);
          const card = tmp.firstElementChild as HTMLElement | null;
          if (!card) return;
          ordersList.insertBefore(card, ordersList.firstChild);
          bindOrderCard(card);
          const storeSub = o.storeSubtotals[storeSlugForOrders] ?? { subtotal: 0, shipping: 0 };
          window.dispatchEvent(new CustomEvent('toast:show', { detail: {
            title: 'הזמנה חדשה!',
            body: `הזמנה מ-${o.buyerName} על סך ${fmtPrice(storeSub.subtotal + storeSub.shipping)}`,
            key: o.id,
            href: '/seller/dashboard?panel=orders',
          } }));
        });
        updateOrderTabBadge();
        applyOrdersFilter();
        // New cards always land at the top via insertBefore above, regardless
        // of the seller's chosen sort — re-sort so a poll-inserted order
        // doesn't silently jump the sort order the seller picked.
        sortOrders(ordersSortCol, ordersSortDir);
      } catch { /* ignore */ }
    }

    setInterval(pollOrders, 15000);
  }

  // ── Seller messages: expand / mark read / reply ──────────────
  function fmtDateJs(iso: string) {
    return new Date(iso).toLocaleString('he-IL', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
  }
  function escMsg(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  const currentSellerId = (document.getElementById('upload-config') as HTMLElement | null)?.dataset.sellerId ?? '';
  const currentStoreIdForMsgs = (document.getElementById('upload-config') as HTMLElement | null)?.dataset.storeId ?? '';
  const sellerThreadLoaders = new Map<string, (markRead: boolean, viaPoll?: boolean) => void>();

  // ── Messages: sort + filter — desktop uses header controls (.sort-btn on
  // date, a funnel button on status), mobile uses a "sort by"/"filter by"
  // toolbar dropdown (table-toolbar is display:none above 640px, see
  // dashboard.css). Both surfaces share the same state below, and every
  // dropdown (mobile or desktop funnel) renders through one body-anchored,
  // viewport-clamped portal — mirrors initProductsToolbar() in products.ts,
  // duplicated here rather than shared since this script and products.ts are
  // separate modules with their own row/DOM shape. ──
  const msgTbody = document.querySelector<HTMLTableSectionElement>('.msg-table tbody');
  const msgFilters = new Map<string, Set<string>>();
  // Sorting/filtering by read-status only makes sense when the store actually
  // has a mix of both — the header controls for it are server-omitted
  // entirely in that case (see showMsgStatusControls in the frontmatter); the
  // mobile dropdown's own options mirror that via this same flag, read off
  // the toolbar's data attribute rather than recomputed here.
  const msgMixedStatus = document.querySelector<HTMLElement>('#dash-panel-messages .table-toolbar')?.dataset.mixedStatus === 'true';
  const MSG_FILTER_COLUMNS: string[] = [...(msgMixedStatus ? ['status'] : []), 'product', 'from'];
  let msgSortCol: 'date' | 'unread' | 'product' = 'date';
  let msgSortDir: 'asc' | 'desc' = 'desc';
  let msgDashI18nDict: Record<string, string> = {};
  try { msgDashI18nDict = JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}').dashboard ?? {}; } catch { /* noop */ }
  const msgI18n = {
    filterClearAll: msgDashI18nDict.filterClearAll ?? 'נקה הכל',
    filterClearColumn: msgDashI18nDict.filterClearColumn ?? 'נקה סינון בעמודה זו',
    filterColStatus: msgDashI18nDict.filterColStatus ?? 'סטטוס',
    filterColProduct: msgDashI18nDict.filterColProduct ?? 'מוצר',
    filterColFrom: msgDashI18nDict.filterColFrom ?? 'שולח',
    filterNoProduct: msgDashI18nDict.filterNoProduct ?? 'ללא מוצר',
    filterValUnread: msgDashI18nDict.filterValUnread ?? 'לא נקרא',
    filterValRead: msgDashI18nDict.filterValRead ?? 'נקרא',
    msgSortOptDateDesc: msgDashI18nDict.msgSortOptDateDesc ?? 'תאריך: חדש — ישן',
    msgSortOptDateAsc: msgDashI18nDict.msgSortOptDateAsc ?? 'תאריך: ישן — חדש',
    msgSortOptUnreadFirst: msgDashI18nDict.msgSortOptUnreadFirst ?? 'לא נקראו קודם',
    msgSortOptProductAsc: msgDashI18nDict.msgSortOptProductAsc ?? 'מוצר: א — ת',
    msgSortOptProductDesc: msgDashI18nDict.msgSortOptProductDesc ?? 'מוצר: ת — א',
  };

  const MSG_SORT_OPTIONS: { col: 'date' | 'unread' | 'product'; dir: 'asc' | 'desc'; label: () => string }[] = [
    { col: 'date', dir: 'desc', label: () => msgI18n.msgSortOptDateDesc },
    { col: 'date', dir: 'asc', label: () => msgI18n.msgSortOptDateAsc },
    ...(msgMixedStatus ? [{ col: 'unread' as const, dir: 'desc' as const, label: () => msgI18n.msgSortOptUnreadFirst }] : []),
    { col: 'product', dir: 'asc', label: () => msgI18n.msgSortOptProductAsc },
    { col: 'product', dir: 'desc', label: () => msgI18n.msgSortOptProductDesc },
  ];

  function getMsgFilterValue(row: HTMLElement, col: string): string {
    if (col === 'status') return row.classList.contains('msg-table__row--unread') ? msgI18n.filterValUnread : msgI18n.filterValRead;
    if (col === 'product') return row.dataset.filterProduct || msgI18n.filterNoProduct;
    if (col === 'from') return row.dataset.filterFrom || '';
    return '';
  }

  function rowMatchesMsgFilters(row: HTMLElement): boolean {
    for (const [col, values] of msgFilters) {
      if (values.size === 0) continue;
      if (!values.has(getMsgFilterValue(row, col))) return false;
    }
    return true;
  }

  function applyMessagesFilter(): void {
    document.querySelectorAll<HTMLElement>('[data-msg-id]').forEach((row) => {
      // Never hide a thread the seller currently has open — becoming "read"
      // mid-view shouldn't make the row vanish out from under them.
      if (row.classList.contains('msg-table__row--open')) { row.hidden = false; return; }
      row.hidden = !rowMatchesMsgFilters(row);
    });
  }

  function refreshMsgFilterUI(): void {
    document.querySelectorAll<HTMLButtonElement>('.msg-table thead [data-filter-funnel-col]').forEach((btn) => {
      const col = btn.dataset.filterFunnelCol ?? '';
      if ((msgFilters.get(col)?.size ?? 0) > 0) btn.dataset.active = 'true'; else delete btn.dataset.active;
    });
    const badge = document.getElementById('msg-filter-count');
    if (badge) {
      const activeCols = [...msgFilters.values()].filter((s) => s.size > 0).length;
      badge.hidden = activeCols === 0;
      badge.textContent = String(activeCols);
    }
  }

  function getMsgSortValue(row: HTMLElement, col: 'date' | 'unread' | 'product'): string | number {
    if (col === 'date') return row.dataset.sortDate ?? '';
    if (col === 'unread') return row.classList.contains('msg-table__row--unread') ? 1 : 0;
    if (col === 'product') return row.dataset.sortProduct ?? '';
    return '';
  }

  function refreshMsgSortUI(): void {
    document.querySelectorAll<HTMLButtonElement>('.msg-table thead .sort-btn').forEach((btn) => {
      if (btn.dataset.sortCol === msgSortCol) { btn.dataset.active = 'true'; btn.dataset.dir = msgSortDir; }
      else { delete btn.dataset.active; delete btn.dataset.dir; }
    });
    const label = document.getElementById('msg-sort-label');
    if (label) {
      const opt = MSG_SORT_OPTIONS.find((o) => o.col === msgSortCol && o.dir === msgSortDir) ?? MSG_SORT_OPTIONS[0]!;
      label.textContent = opt.label();
    }
  }

  function sortMessages(col: 'date' | 'unread' | 'product', dir: 'asc' | 'desc') {
    msgSortCol = col;
    msgSortDir = dir;
    if (!msgTbody) { refreshMsgSortUI(); return; }
    const rows = Array.from(msgTbody.querySelectorAll<HTMLElement>('[data-msg-id]'));
    rows.sort((a, b) => {
      const va = getMsgSortValue(a, col);
      const vb = getMsgSortValue(b, col);
      const cmp = va < vb ? -1 : va > vb ? 1 : 0;
      return dir === 'asc' ? cmp : -cmp;
    });
    rows.forEach((row) => {
      msgTbody.append(row);
      const detail = document.getElementById(`msg-detail-${row.dataset.msgId}`);
      if (detail) msgTbody.append(detail);
    });
    refreshMsgSortUI();
  }

  function msgHeaderSortClick(col: 'date' | 'unread' | 'product'): void {
    const defaultDir: 'asc' | 'desc' = col === 'product' ? 'asc' : 'desc';
    const dir: 'asc' | 'desc' = msgSortCol === col ? (msgSortDir === 'asc' ? 'desc' : 'asc') : defaultDir;
    sortMessages(col, dir);
  }

  // ── Shared floating portal (own copy — see the comment above) ──
  let msgPortalTrigger: HTMLElement | null = null;

  function getMsgPortal(): HTMLElement {
    let portal = document.getElementById('msg-toolbar-portal');
    if (!portal) {
      portal = document.createElement('div');
      portal.id = 'msg-toolbar-portal';
      portal.className = 'toolbar-portal';
      portal.setAttribute('role', 'menu');
      portal.hidden = true;
      document.body.appendChild(portal);
    }
    return portal;
  }
  function positionMsgPortal(portal: HTMLElement, trigger: HTMLElement): void {
    const isRTL = getComputedStyle(document.documentElement).direction === 'rtl';
    const margin = 8;
    const triggerRect = trigger.getBoundingClientRect();
    const portalRect = portal.getBoundingClientRect();
    let left = isRTL ? triggerRect.right - portalRect.width : triggerRect.left;
    left = Math.max(margin, Math.min(left, window.innerWidth - portalRect.width - margin));
    let top = triggerRect.bottom + 4;
    top = Math.min(top, Math.max(margin, window.innerHeight - portalRect.height - margin));
    portal.style.left = `${left}px`;
    portal.style.top = `${top}px`;
  }
  function closeMsgPortal(): void {
    const portal = document.getElementById('msg-toolbar-portal');
    if (portal) portal.hidden = true;
    msgPortalTrigger?.setAttribute('aria-expanded', 'false');
    msgPortalTrigger = null;
  }
  function openMsgPortal(trigger: HTMLElement, minWidth: string, buildHtml: () => string, wire: (portal: HTMLElement) => void): void {
    const portal = getMsgPortal();
    portal.style.minWidth = minWidth;
    portal.style.maxHeight = '320px';
    portal.style.overflow = 'auto';
    portal.innerHTML = buildHtml();
    portal.hidden = false;
    positionMsgPortal(portal, trigger);
    trigger.setAttribute('aria-expanded', 'true');
    msgPortalTrigger = trigger;
    wire(portal);
  }
  document.addEventListener('click', (e) => {
    const portal = document.getElementById('msg-toolbar-portal');
    if (!portal || portal.hidden) return;
    // composedPath(), not target.contains() — a portal click that swaps
    // portal.innerHTML (e.g. drilling into a filter column) detaches the
    // original e.target from the document mid-bubble, so a containment check
    // done here (after that swap already ran) wrongly reads as "outside" and
    // closes the portal the instant it opens its next level.
    const path = e.composedPath();
    if (path.includes(portal)) return;
    if (msgPortalTrigger && path.includes(msgPortalTrigger)) return;
    closeMsgPortal();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMsgPortal(); });

  // ── Sort ──
  function openMobileMsgSort(trigger: HTMLElement): void {
    openMsgPortal(trigger, '13rem', () => {
      return MSG_SORT_OPTIONS.map((o) => {
        const selected = o.col === msgSortCol && o.dir === msgSortDir;
        return `<button type="button" class="product-menu__item" data-sort-col="${o.col}" data-sort-dir="${o.dir}" style="cursor:pointer${selected ? ';font-weight:700;color:var(--color-primary)' : ''}">${escMsg(o.label())}</button>`;
      }).join('');
    }, (portal) => {
      portal.querySelectorAll<HTMLButtonElement>('[data-sort-col]').forEach((btn) => {
        btn.addEventListener('click', () => {
          sortMessages((btn.dataset.sortCol as 'date' | 'unread' | 'product') ?? 'date', (btn.dataset.sortDir as 'asc' | 'desc') ?? 'desc');
          closeMsgPortal();
        });
      });
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.msg-table thead .sort-btn').forEach((btn) => {
    btn.addEventListener('click', () => msgHeaderSortClick((btn.dataset.sortCol as 'date' | 'unread' | 'product') ?? 'date'));
  });

  const msgSortTrigger = document.getElementById('msg-sort-trigger') as HTMLButtonElement | null;
  msgSortTrigger?.addEventListener('click', () => {
    if (msgPortalTrigger === msgSortTrigger) { closeMsgPortal(); return; }
    openMobileMsgSort(msgSortTrigger);
  });

  // ── Filter ──
  function msgFilterColumnLabel(col: string): string {
    if (col === 'status') return msgI18n.filterColStatus;
    if (col === 'product') return msgI18n.filterColProduct;
    if (col === 'from') return msgI18n.filterColFrom;
    return col;
  }
  function getMsgDistinctValues(col: string): string[] {
    const values = new Set<string>();
    document.querySelectorAll<HTMLElement>('[data-msg-id]').forEach((row) => values.add(getMsgFilterValue(row, col)));
    return [...values].sort();
  }
  function msgFilterValuesHtml(col: string, showBack: boolean): string {
    const label = msgFilterColumnLabel(col);
    const values = getMsgDistinctValues(col);
    const selected = msgFilters.get(col) ?? new Set<string>();
    const backRotate = document.documentElement.dir === 'rtl' ? -90 : 90;
    const backHtml = showBack
      ? `<button type="button" class="product-menu__back" data-filter-back><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transform:rotate(${backRotate}deg)"><polyline points="6 9 12 15 18 9"/></svg>${escMsg(label)}</button><div class="product-menu__divider"></div>`
      : '';
    return [
      backHtml,
      ...values.map((v) => `<label class="product-menu__checkbox-item"><input type="checkbox" data-filter-value="${escMsg(v)}" ${selected.has(v) ? 'checked' : ''}>${escMsg(v)}</label>`),
      `<div class="product-menu__divider"></div>`,
      `<button type="button" class="product-menu__clear" data-filter-clear-col>${escMsg(msgI18n.filterClearColumn)}</button>`,
    ].join('');
  }
  function wireMsgFilterValues(portal: HTMLElement, col: string, reopen: () => void, onBack?: () => void): void {
    portal.querySelectorAll<HTMLInputElement>('[data-filter-value]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const set = msgFilters.get(col) ?? new Set<string>();
        if (cb.checked) set.add(cb.dataset.filterValue ?? ''); else set.delete(cb.dataset.filterValue ?? '');
        if (set.size) msgFilters.set(col, set); else msgFilters.delete(col);
        applyMessagesFilter();
        refreshMsgFilterUI();
      });
    });
    portal.querySelector('[data-filter-clear-col]')?.addEventListener('click', () => {
      msgFilters.delete(col);
      applyMessagesFilter();
      refreshMsgFilterUI();
      reopen();
    });
    if (onBack) portal.querySelector('[data-filter-back]')?.addEventListener('click', onBack);
  }

  function openDesktopMsgFunnel(btn: HTMLButtonElement, col: string): void {
    openMsgPortal(btn, '10rem', () => msgFilterValuesHtml(col, false), (portal) => {
      wireMsgFilterValues(portal, col, () => openDesktopMsgFunnel(btn, col));
    });
  }

  // The checkbox here is real (not decorative) — unchecking it clears that
  // column's filter directly, without a drill-down into its values first.
  // Clicking it while off has nothing to filter by yet, so it opens the
  // values view instead of actually checking itself. A plain <div> row (not
  // <label>) on purpose: a <label> wrapping a checkbox forwards any click on
  // the row into a second, native toggle of the checkbox, double-handling
  // the same click.
  function msgFilterColumnsHtml(): string {
    const chevronRotate = document.documentElement.dir === 'rtl' ? 90 : -90;
    return [
      ...MSG_FILTER_COLUMNS.map((col) => {
        const active = (msgFilters.get(col)?.size ?? 0) > 0;
        return `<div class="product-menu__item" data-filter-col="${col}" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
          <input type="checkbox" data-filter-col-toggle="${col}" ${active ? 'checked' : ''} style="cursor:pointer;flex-shrink:0">
          <span style="flex:1">${escMsg(msgFilterColumnLabel(col))}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transform:rotate(${chevronRotate}deg)"><polyline points="6 9 12 15 18 9"/></svg>
        </div>`;
      }).join(''),
      `<div class="product-menu__divider"></div>`,
      `<button type="button" class="product-menu__clear" data-filter-clear-all>${escMsg(msgI18n.filterClearAll)}</button>`,
    ].join('');
  }

  function openMobileMsgFilterColumns(trigger: HTMLElement): void {
    openMsgPortal(trigger, '11rem', msgFilterColumnsHtml, (portal) => {
      portal.querySelectorAll<HTMLElement>('[data-filter-col]').forEach((row) => {
        const col = row.dataset.filterCol ?? '';
        row.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('[data-filter-col-toggle]')) return;
          openMobileMsgFilterValues(trigger, col);
        });
        const cb = row.querySelector<HTMLInputElement>('[data-filter-col-toggle]');
        cb?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (cb.checked) {
            cb.checked = false;
            openMobileMsgFilterValues(trigger, col);
            return;
          }
          msgFilters.delete(col);
          applyMessagesFilter();
          refreshMsgFilterUI();
          openMobileMsgFilterColumns(trigger);
        });
      });
      portal.querySelector('[data-filter-clear-all]')?.addEventListener('click', () => {
        msgFilters.clear();
        applyMessagesFilter();
        refreshMsgFilterUI();
        openMobileMsgFilterColumns(trigger);
      });
    });
  }
  function openMobileMsgFilterValues(trigger: HTMLElement, col: string): void {
    openMsgPortal(trigger, '11rem', () => msgFilterValuesHtml(col, true), (portal) => {
      wireMsgFilterValues(portal, col, () => openMobileMsgFilterValues(trigger, col), () => openMobileMsgFilterColumns(trigger));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.msg-table thead [data-filter-funnel-col]').forEach((btn) => {
    const col = btn.dataset.filterFunnelCol ?? '';
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (msgPortalTrigger === btn) { closeMsgPortal(); return; }
      openDesktopMsgFunnel(btn, col);
    });
  });

  const msgFilterTrigger = document.getElementById('msg-filter-trigger') as HTMLButtonElement | null;
  msgFilterTrigger?.addEventListener('click', () => {
    if (msgPortalTrigger === msgFilterTrigger) { closeMsgPortal(); return; }
    openMobileMsgFilterColumns(msgFilterTrigger);
  });

  refreshMsgSortUI();
  refreshMsgFilterUI();

  document.querySelectorAll<HTMLElement>('[data-msg-id]').forEach((row) => {
    const id        = row.dataset.msgId ?? '';
    const threadRow = document.getElementById(`msg-detail-${id}`) as HTMLTableRowElement | null;
    const repliesEl = document.getElementById(`replies-${id}`);
    let isOpen = false;

    // viaPoll = the live poll found new replies while this thread was already
    // open (the user isn't in the middle of opening it themselves) — that's
    // the one case that needs its own toast, keyed by the *reply's own* id so
    // it matches (and dedupes against) the site-wide notification poller.
    function loadThread(markRead: boolean, viaPoll = false) {
      fetch(`/api/messages?repliesFor=${id}`)
        .then((r) => r.json())
        .then(({ replies }: { replies: { id: string; fromUserId: string; fromName: string; content: string; createdAt: string; toSellerId?: string; readBySeller?: boolean }[] }) => {
          if (!repliesEl) return;
          [...repliesEl.children].slice(1).forEach((c) => c.remove());
          replies.forEach((r) => {
            const isSelf = r.fromUserId === currentSellerId;
            const div = document.createElement('div');
            div.className = `msg-thread-entry ${isSelf ? 'msg-thread-entry--seller' : 'msg-thread-entry--buyer'}`;
            div.innerHTML = `<div class="msg-thread-entry__header"><span class="msg-thread-entry__who">${escMsg(isSelf ? 'אתה' : r.fromName)}</span><span class="msg-thread-entry__date">${escMsg(fmtDateJs(r.createdAt))}</span></div><div class="msg-thread-entry__body">${escMsg(r.content)}</div>`;
            repliesEl.appendChild(div);
          });
          if (replies.length > 0) {
            const last = replies[replies.length - 1]!;
            const isSelf = last.fromUserId === currentSellerId;
            const previewTd = row.querySelector('.msg-table__td--preview');
            if (previewTd) previewTd.innerHTML = `${escMsg(last.content)}${isSelf ? ' <span class="msg-table__preview-you">(אתה)</span>' : ''}`;
            const dateTd = row.querySelector('.msg-table__td--date');
            if (dateTd) dateTd.textContent = fmtDateJs(last.createdAt);
            row.dataset.sortDate = last.createdAt;
            if (viaPoll && markRead && !isSelf) {
              window.dispatchEvent(new CustomEvent('toast:show', { detail: {
                title: 'יש לך הודעה חדשה מקונה', body: last.fromName, key: last.id,
                href: '/seller/dashboard?panel=messages',
              } }));
            }
          }
          if (markRead) {
            row.classList.remove('msg-table__row--unread');
            row.querySelector('.msg-unread-sr')?.remove();
            repliesEl.querySelectorAll('.msg-thread-unread-dot').forEach((el) => el.remove());
            document.querySelector('#tab-messages span[aria-label]')?.remove();
            updateSwitcherAlertDot();
            applyMessagesFilter();
            fetch('/api/messages', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'mark-read', id }) })
              .then(() => window.dispatchEvent(new CustomEvent('notif-refreshed'))).catch(() => {});
          }
          threadRow?.querySelector<HTMLElement>('[data-reply-for]')?.scrollIntoView({ behavior: 'smooth', block: 'end' });
          threadRow?.querySelector<HTMLTextAreaElement>('textarea')?.focus({ preventScroll: true });
        }).catch(() => {});
    }

    sellerThreadLoaders.set(id, loadThread);

    function open() {
      if (!threadRow) return;
      threadRow.hidden = false;
      row.setAttribute('aria-expanded', 'true');
      row.classList.add('msg-table__row--open');
      isOpen = true;
      loadThread(row.classList.contains('msg-table__row--unread'));
    }
    function close() {
      if (!threadRow) return;
      threadRow.hidden = true;
      row.setAttribute('aria-expanded', 'false');
      row.classList.remove('msg-table__row--open');
      isOpen = false;
    }

    row.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      isOpen ? close() : open();
    });
    row.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); isOpen ? close() : open(); }
    });

    const replyForm = threadRow?.querySelector<HTMLElement>('[data-reply-for]');
    if (replyForm) {
      const textarea = replyForm.querySelector<HTMLTextAreaElement>('textarea')!;
      const sendBtn  = replyForm.querySelector<HTMLButtonElement>('.seller-msg-reply-send')!;
      const closeBtn = replyForm.querySelector<HTMLButtonElement>('.seller-msg-reply-close')!;
      closeBtn.addEventListener('click', () => {
        close();
        row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      sendBtn.addEventListener('click', async () => {
        const content = textarea.value.trim();
        if (!content) return;
        sendBtn.disabled = true;
        try {
          const res = await fetch('/api/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ replyToId: id, content }),
          });
          const data = await res.json() as { ok?: boolean; message?: { content: string; createdAt: string } };
          if (res.ok && data.ok && data.message && repliesEl) {
            const div = document.createElement('div');
            div.className = 'msg-thread-entry msg-thread-entry--seller';
            div.innerHTML = `<div class="msg-thread-entry__header"><span class="msg-thread-entry__who">אתה</span><span class="msg-thread-entry__date">${escMsg(fmtDateJs(data.message.createdAt))}</span></div><div class="msg-thread-entry__body">${escMsg(data.message.content)}</div>`;
            repliesEl.appendChild(div);
            const previewTd = row.querySelector('.msg-table__td--preview');
            if (previewTd) previewTd.innerHTML = `${escMsg(data.message.content)} <span class="msg-table__preview-you">(אתה)</span>`;
            const dateTd = row.querySelector('.msg-table__td--date');
            if (dateTd) dateTd.textContent = fmtDateJs(data.message.createdAt);
            row.dataset.sortDate = data.message.createdAt;
            textarea.value = '';
          }
        } catch { /* ignore */ } finally {
          sendBtn.disabled = false;
        }
      });
    }
  });

  /* ── Delete message thread ── */
  document.querySelectorAll<HTMLButtonElement>('[data-delete-msg-id]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (!confirm('למחוק את השיחה הזו לצמיתות?')) return;
      const id = btn.dataset.deleteMsgId ?? '';
      try {
        const res = await fetch('/api/messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id }),
        });
        if (res.ok) {
          const row = btn.closest('tr');
          const nextRow = row?.nextElementSibling;
          row?.remove();
          if (nextRow?.classList.contains('msg-thread-row')) nextRow.remove();
        }
      } catch { /* ignore */ }
    });
  });

  // ── Edit Order Details Modal ─────────────────────────────────
  const editOrderModal    = document.getElementById('edit-order-modal') as HTMLDialogElement | null;
  const editOrderForm     = document.getElementById('edit-order-form') as HTMLFormElement | null;
  const editOrderError    = document.getElementById('edit-order-error') as HTMLElement | null;
  const editOrderSuccess  = document.getElementById('edit-order-success') as HTMLElement | null;
  const editOrderSaveBtn  = document.getElementById('edit-order-save') as HTMLButtonElement | null;

  type EomItem = { productId: string; productName: string; price: number; qty: number; image?: string; storeSlug?: string };

  function escEom(s: unknown) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function renderEomItems(items: EomItem[]) {
    const list = document.getElementById('eom-items-list');
    if (!list) return;
    if (!items.length) { list.innerHTML = '<p style="color:var(--color-muted);font-size:0.82rem;margin:0">אין פריטים</p>'; return; }
    list.innerHTML = items.map((item) => `
      <div class="eom-item" data-pid="${escEom(item.productId)}">
        ${item.image
          ? `<img class="eom-item__img" src="${escEom(item.image)}" alt="" width="34" height="34" loading="lazy">`
          : `<div class="eom-item__img-ph" aria-hidden="true"></div>`}
        <span class="eom-item__name" title="${escEom(item.productName)}">${escEom(item.productName)}</span>
        <span class="eom-item__meta">${item.price.toLocaleString('he-IL')} ₪ × ${item.qty}</span>
        <button type="button" class="eom-item__del" aria-label="מחק פריט" title="מחק פריט">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>`).join('');

    list.querySelectorAll<HTMLButtonElement>('.eom-item__del').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest<HTMLElement>('.eom-item');
        if (!row) return;
        const wasDeleted = row.classList.contains('eom-item--deleted');
        row.classList.toggle('eom-item--deleted', !wasDeleted);
        btn.setAttribute('title', wasDeleted ? 'מחק פריט' : 'בטל מחיקה');
        btn.setAttribute('aria-label', wasDeleted ? 'מחק פריט' : 'בטל מחיקה');
        updateDiscountPreview();
      });
    });
  }

  // ── Discount type toggle ──────────────────────────────────
  let eomDiscountType: 'percent' | 'amount' = 'percent';

  const eomPctBtn = document.getElementById('eom-dtype-pct') as HTMLButtonElement | null;
  const eomAmtBtn = document.getElementById('eom-dtype-amt') as HTMLButtonElement | null;
  const eomDiscountInput   = document.getElementById('eom-discount-val') as HTMLInputElement | null;
  const eomDiscountPreview = document.getElementById('eom-discount-preview') as HTMLElement | null;
  const eomShippingAmountEl = document.getElementById('eom-shipping-amount') as HTMLElement | null;
  let eomCurrentShipping = 0;

  function setDiscountType(type: 'percent' | 'amount') {
    eomDiscountType = type;
    eomPctBtn?.classList.toggle('eom-dtype-btn--active', type === 'percent');
    eomAmtBtn?.classList.toggle('eom-dtype-btn--active', type === 'amount');
    updateDiscountPreview();
  }
  eomPctBtn?.addEventListener('click', () => setDiscountType('percent'));
  eomAmtBtn?.addEventListener('click', () => setDiscountType('amount'));
  eomDiscountInput?.addEventListener('input', updateDiscountPreview);

  function calcEomBase(): number {
    let subtotal = 0;
    document.querySelectorAll<HTMLElement>('#eom-items-list .eom-item:not(.eom-item--deleted)').forEach((row) => {
      const meta = row.querySelector('.eom-item__meta')?.textContent ?? '';
      const m = meta.match(/([\d,]+)\s*₪\s*×\s*(\d+)/);
      if (m) subtotal += parseFloat(m[1]!.replace(/,/g,'')) * parseInt(m[2]!, 10);
    });
    return subtotal + eomCurrentShipping;
  }

  function updateDiscountPreview() {
    if (!eomDiscountPreview) return;
    const val = parseFloat(eomDiscountInput?.value ?? '0') || 0;
    if (!val) { eomDiscountPreview.textContent = ''; return; }
    const base = calcEomBase();
    const applied = eomDiscountType === 'percent'
      ? Math.min(base * val / 100, base)
      : Math.min(val, base);
    eomDiscountPreview.textContent = applied > 0 ? `= −${applied.toFixed(2).replace(/\.00$/, '')} ₪` : '';
  }

  function openEditOrderModal(btn: HTMLElement) {
    if (!editOrderModal) return;
    (document.getElementById('edit-order-id') as HTMLInputElement).value = btn.dataset.orderId ?? '';
    (document.getElementById('edit-order-store-slug') as HTMLInputElement).value = btn.dataset.storeSlug ?? '';
    (document.getElementById('eob-name') as HTMLInputElement).value    = btn.dataset.buyerName   ?? '';
    (document.getElementById('eob-email') as HTMLInputElement).value   = btn.dataset.buyerEmail  ?? '';
    (document.getElementById('eob-phone') as HTMLInputElement).value   = btn.dataset.buyerPhone  ?? '';
    (document.getElementById('eob-street') as HTMLInputElement).value  = btn.dataset.buyerStreet ?? '';
    (document.getElementById('eob-city') as HTMLInputElement).value    = btn.dataset.buyerCity   ?? '';
    (document.getElementById('eob-zip') as HTMLInputElement).value     = btn.dataset.buyerZip    ?? '';
    eomCurrentShipping = parseFloat(btn.dataset.shipping ?? '0') || 0;
    if (eomShippingAmountEl) eomShippingAmountEl.textContent = eomCurrentShipping > 0 ? `· ${eomCurrentShipping} ₪` : '· חינם';
    // Restore existing discount
    const existingDtype = (btn.dataset.discountType ?? 'percent') as 'percent' | 'amount';
    const existingDval  = btn.dataset.discountValue ?? '0';
    setDiscountType(existingDtype);
    if (eomDiscountInput) eomDiscountInput.value = existingDval === '0' ? '' : existingDval;
    if (editOrderError)   { editOrderError.style.display   = 'none'; editOrderError.textContent   = ''; }
    if (editOrderSuccess) { editOrderSuccess.style.display = 'none'; }
    try { renderEomItems(JSON.parse(btn.dataset.items ?? '[]') as EomItem[]); } catch { renderEomItems([]); }
    updateDiscountPreview();
    editOrderModal.showModal();
    (document.getElementById('eob-name') as HTMLInputElement | null)?.focus();
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.order-edit-buyer-btn');
    if (btn) { e.stopPropagation(); openEditOrderModal(btn); }
  });

  document.getElementById('edit-order-modal-close')?.addEventListener('click', () => editOrderModal?.close());
  document.getElementById('edit-order-cancel')?.addEventListener('click', () => editOrderModal?.close());
  editOrderModal?.addEventListener('click', (e) => { if (e.target === editOrderModal) editOrderModal.close(); });

  editOrderForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!editOrderSaveBtn) return;
    const orderId   = (document.getElementById('edit-order-id') as HTMLInputElement).value;
    const storeSlug = (document.getElementById('edit-order-store-slug') as HTMLInputElement).value;
    const name   = (document.getElementById('eob-name') as HTMLInputElement).value.trim();
    const email  = (document.getElementById('eob-email') as HTMLInputElement).value.trim();
    const phone  = (document.getElementById('eob-phone') as HTMLInputElement).value.trim();
    const street = (document.getElementById('eob-street') as HTMLInputElement).value.trim();
    const city   = (document.getElementById('eob-city') as HTMLInputElement).value.trim();
    const zip    = (document.getElementById('eob-zip') as HTMLInputElement).value.trim();

    if (!name || !city || !street) {
      if (editOrderError) { editOrderError.textContent = 'שם, עיר ורחוב הם שדות חובה'; editOrderError.style.display = 'block'; }
      return;
    }

    // Collect deleted item IDs
    const itemDeletes: string[] = [];
    document.querySelectorAll<HTMLElement>('#eom-items-list .eom-item--deleted').forEach((row) => {
      if (row.dataset.pid) itemDeletes.push(row.dataset.pid);
    });

    // Discount
    const discountVal = parseFloat(eomDiscountInput?.value ?? '') || 0;
    const discount = discountVal > 0
      ? { type: eomDiscountType, value: discountVal }
      : null;

    editOrderSaveBtn.disabled = true;
    if (editOrderError) editOrderError.style.display = 'none';

    try {
      const res = await fetch('/api/seller/orders', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, storeSlug, buyerName: name, buyerEmail: email, buyerPhone: phone, buyerAddress: { city, street, zip }, itemDeletes, discount }),
      });
      if (!res.ok) {
        const err = await res.json() as { error?: string };
        if (editOrderError) { editOrderError.textContent = err.error ?? 'שגיאה בשמירה'; editOrderError.style.display = 'block'; }
        return;
      }
      const { order: savedOrder } = await res.json() as { order: { buyerName: string; buyerEmail: string; buyerPhone: string; buyerAddress: { city: string; street: string; zip?: string }; items: EomItem[]; storeSubtotals: Record<string, { subtotal: number; shipping: number }>; totalAmount: number } };

      // Update the order card in DOM
      const card = document.querySelector<HTMLElement>(`.order-card[data-order-id="${CSS.escape(orderId)}"]`);
      if (card && savedOrder) {
        const buyerNameEl = card.querySelector('.order-buyer-name strong');
        const buyerEmailEl = card.querySelector('.order-buyer-email');
        const buyerPhoneEl = card.querySelector('.order-buyer-phone');
        const buyerAddrEl  = card.querySelector('.order-buyer-address');
        if (buyerNameEl) buyerNameEl.textContent = savedOrder.buyerName;
        if (buyerEmailEl) buyerEmailEl.textContent = savedOrder.buyerEmail;
        if (buyerPhoneEl) buyerPhoneEl.textContent = `טלפון: ${savedOrder.buyerPhone}`;
        if (buyerAddrEl) { const a = savedOrder.buyerAddress; buyerAddrEl.textContent = `כתובת: ${a.street}, ${a.city}${a.zip ? ` ${a.zip}` : ''}`; }

        // Update items list in card
        const cardItemsEl = card.querySelector('.order-card__items');
        if (cardItemsEl && savedOrder.items) {
          const storeItems = savedOrder.items.filter((i) => i.storeSlug === storeSlug);
          cardItemsEl.innerHTML = storeItems.map((item) => `
            <li class="order-card__item">
              ${item.image ? `<img src="${escEom(item.image)}" alt="" width="36" height="36" loading="lazy" class="order-card__item-img">` : ''}
              <span class="order-card__item-name">${escEom(item.productName)}</span>
              <span class="order-card__item-qty">×${item.qty}</span>
              <span class="order-card__item-price">${(item.price * item.qty).toFixed(2)} ₪</span>
            </li>`).join('');
        }
        // Update subtotal display
        const storeSub = savedOrder.storeSubtotals?.[storeSlug] as { subtotal: number; shipping: number; discount?: { type: string; value: number; applied: number } } | undefined;
        if (storeSub) {
          const discApplied = storeSub.discount?.applied ?? 0;
          const total = storeSub.subtotal + storeSub.shipping - discApplied;
          const subtotalsEl = card.querySelector<HTMLElement>('.order-card__subtotals');
          if (subtotalsEl) {
            subtotalsEl.innerHTML = `
              <span>משלוח: ${storeSub.shipping === 0 ? 'חינם' : `${storeSub.shipping.toFixed(2)} ₪`}</span>
              ${discApplied > 0 ? `<span style="color:#16a34a">הנחה: −${discApplied.toFixed(2)} ₪</span>` : ''}
              <strong>סה"כ: ${total.toFixed(2)} ₪</strong>`;
          }
          const amountEl = card.querySelector('.order-card__amount');
          if (amountEl) amountEl.textContent = `${total.toFixed(2)} ₪`;
        }

        // Update edit button data attributes
        const editBtn = card.querySelector<HTMLElement>('.order-edit-buyer-btn');
        if (editBtn && savedOrder) {
          editBtn.dataset.buyerName     = savedOrder.buyerName;
          editBtn.dataset.buyerEmail    = savedOrder.buyerEmail;
          editBtn.dataset.buyerPhone    = savedOrder.buyerPhone;
          editBtn.dataset.buyerStreet   = savedOrder.buyerAddress.street;
          editBtn.dataset.buyerCity     = savedOrder.buyerAddress.city;
          editBtn.dataset.buyerZip      = savedOrder.buyerAddress.zip ?? '';
          editBtn.dataset.shipping      = String(storeSub?.shipping ?? 0);
          editBtn.dataset.discountType  = storeSub?.discount?.type ?? 'percent';
          editBtn.dataset.discountValue = String(storeSub?.discount?.value ?? 0);
          if (savedOrder.items) editBtn.dataset.items = JSON.stringify(savedOrder.items.filter((i: EomItem) => i.storeSlug === storeSlug));
        }
      }

      if (editOrderSuccess) { editOrderSuccess.style.display = 'block'; }
      setTimeout(() => { editOrderModal?.close(); if (editOrderSuccess) editOrderSuccess.style.display = 'none'; }, 1400);
    } catch {
      if (editOrderError) { editOrderError.textContent = 'שגיאת רשת, נסה שוב'; editOrderError.style.display = 'block'; }
    } finally {
      editOrderSaveBtn.disabled = false;
    }
  });

  function refreshRowPreview(id: string, row: HTMLElement) {
    fetch(`/api/messages?repliesFor=${id}`)
      .then((r) => r.json())
      .then(({ replies }: { replies: { fromUserId: string; content: string; createdAt: string }[] }) => {
        if (replies.length === 0) return;
        const last = replies[replies.length - 1]!;
        const isSelf = last.fromUserId === currentSellerId;
        const previewTd = row.querySelector('.msg-table__td--preview');
        if (previewTd) previewTd.innerHTML = `${escMsg(last.content)}${isSelf ? ' <span class="msg-table__preview-you">(אתה)</span>' : ''}`;
        const dateTd = row.querySelector('.msg-table__td--date');
        if (dateTd) dateTd.textContent = fmtDateJs(last.createdAt);
        row.dataset.sortDate = last.createdAt;
      }).catch(() => {});
  }

  // Live unread polling
  function pollSellerUnread() {
    fetch(`/api/messages?role=seller&unread=1&storeId=${encodeURIComponent(currentStoreIdForMsgs)}`)
      .then((r) => r.json())
      .then(({ unreadIds }: { unreadIds: string[] }) => {
        const tabBtn = document.getElementById('tab-messages');
        const tabDot = tabBtn?.querySelector<HTMLElement>('span[aria-label]');
        if (unreadIds.length > 0 && !tabDot && tabBtn) {
          const dot = document.createElement('span');
          dot.setAttribute('aria-label', 'הודעות שלא נקראו');
          dot.style.cssText = 'position:absolute;top:0.45rem;inset-inline-end:0.6rem;width:7px;height:7px;background:#ef4444;border-radius:50%';
          tabBtn.appendChild(dot);
        } else if (unreadIds.length === 0) {
          tabDot?.remove();
        }
        document.querySelectorAll<HTMLElement>('[data-msg-id]').forEach((row) => {
          const id = row.dataset.msgId!;
          if (!unreadIds.includes(id)) return;
          if (row.classList.contains('msg-table__row--open')) {
            sellerThreadLoaders.get(id)?.(true, true);
          } else {
            row.classList.add('msg-table__row--unread');
            const fromTd = row.querySelector('.msg-table__td--from');
            if (fromTd && !fromTd.querySelector('.msg-unread-sr')) {
              const sr = document.createElement('span');
              sr.className = 'visually-hidden msg-unread-sr';
              sr.textContent = 'לא נקרא · ';
              fromTd.insertBefore(sr, fromTd.firstChild);
            }
            refreshRowPreview(id, row);
          }
        });
        applyMessagesFilter();
      }).catch(() => {});
  }
  pollSellerUnread();
  setInterval(pollSellerUnread, 15000);
</script>
