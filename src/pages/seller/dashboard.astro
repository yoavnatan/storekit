                      <Fragment set:html={orderInvoiceRowHtml(
                        invoiceStates.get(order.id) ?? null,
                        storeSub?.deliveryMethod ?? null,
                        {
                          title: d.orderInvoice, hint: d.orderInvoiceHint, owed: d.orderInvoiceOwed,
                          upload: d.orderInvoiceUpload, handedShip: d.orderInvoiceHandedShip,
                          handedPickup: d.orderInvoiceHandedPickup, uploaded: d.orderInvoiceUploaded,
