---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CsrfField from '../../components/CsrfField.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { getLang, getT } from '../../i18n/index.js';
import { MIN_PASSWORD_LENGTH } from '../../lib/seller-auth.js';
import { isPasswordResetTokenLive, redeemPasswordResetToken } from '../../lib/password-reset.js';

/**
 * Choose a new password, using the link from the mail.
 *
 * **The token travels in a hidden field on the POST, not in the query string of it.** It arrives in
 * the URL because a mail can only carry a link, and it is read there once — but the form posts to
 * the bare path, so the address bar after submitting holds no credential to be copied out of a
 * screenshot, a shared screen or a browser's history sync.
 *
 * The GET checks the token WITHOUT spending it (`isPasswordResetTokenLive`), so a dead link says so
 * immediately instead of after someone has typed a password twice. The POST is the only thing that
 * consumes it, and that check is inside the same statement that marks it used — two clicks cannot
 * both win (`lib/password-reset.ts`).
 *
 * A successful reset does NOT sign the seller in. Deliberate: they have just proved control of the
 * mailbox, not of the password they chose, and being handed a session for a value they may have
 * mistyped is how a person ends up with an account they cannot re-enter. They sign in, once, with
 * the new password — which also confirms it works while they are still on the page that set it.
 */

const lang = getLang(Astro.cookies);
const t = getT(lang);

let error = '';
let done = false;
// Falls back to the query string on the first GET; afterwards the form's own hidden field is the
// source, so a re-submit after a validation error still knows which link it is completing.
let token = Astro.url.searchParams.get('token') ?? '';
let live = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  token = String(form.get('token') || '');
  const password = String(form.get('password') || '');
  const confirm = String(form.get('confirm') || '');

  if (password !== confirm) {
    // Checked before the token is touched — a mistyped confirmation must not burn the only link.
    error = t.auth.resetMismatch;
    live = await isPasswordResetTokenLive(token);
  } else {
    const outcome = await redeemPasswordResetToken(token, password);
    if (outcome === 'ok') {
      done = true;
    } else if (outcome === 'weak') {
      error = t.auth.passwordTooShort;
      live = await isPasswordResetTokenLive(token);
    } else {
      error = t.auth.resetInvalid;
    }
  }
} else {
  live = await isPasswordResetTokenLive(token);
  if (!live) error = t.auth.resetInvalid;
}
---

<BaseLayout title={t.auth.resetTitle} noindex={true} isLoggedIn={false} hasStore={false} storeMode={true} sellerMode={true}>
  <section class="section container auth-wrap">
    <div class="auth-card">
      <header class="auth-head">
        <BrandLogo class="mb-[0.9rem]" size="1.45rem" />
        <h1>{t.auth.resetTitle}</h1>
        {live && !done && <p class="auth-subtitle">{t.auth.resetSubtitle}</p>}
      </header>

      {error && <p class="auth-error" role="alert">{error}</p>}

      {done ? (
        <Fragment>
          <p class="auth-notice" role="status">{t.auth.resetDone}</p>
          <p class="muted auth-switch"><a href="/seller/login">{t.auth.forgotBackToLogin}</a></p>
        </Fragment>
      ) : live ? (
        <form method="POST" class="auth-form">
          <CsrfField />
          <input type="hidden" name="token" value={token} />
          <label class="field">
            <span>{t.auth.newPassword}</span>
            <input class="input" type="password" name="password" required minlength={MIN_PASSWORD_LENGTH}
                   autocomplete="new-password" autofocus />
          </label>
          <label class="field">
            <span>{t.auth.confirmPassword}</span>
            <input class="input" type="password" name="confirm" required minlength={MIN_PASSWORD_LENGTH}
                   autocomplete="new-password" />
          </label>
          <button class="btn" type="submit">{t.auth.resetSubmit}</button>
        </form>
      ) : (
        <p class="muted auth-switch"><a href="/seller/forgot-password">{t.auth.resetRequestNew}</a></p>
      )}
    </div>
  </section>
</BaseLayout>
