---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CsrfField from '../../components/CsrfField.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getLang, getT } from '../../i18n/index.js';
import { clientIp } from '../../lib/client-ip.js';
import { isValidEmail } from '../../lib/email-address.js';
import { issuePasswordResetToken, passwordResetUrl } from '../../lib/password-reset.js';
import { sendPasswordResetEmail } from '../../lib/email/password-reset-email.js';
import {
  checkAuthRate, countAuthAttempt, retryAfterMinutes, passwordResetRules,
} from '../../lib/rate-limit.js';

/**
 * "שכחתי סיסמה" — ask for a link.
 *
 * **This page has exactly one visible outcome.** Whatever the address turns out to be, a submitted
 * form renders the same sentence: "if that address is registered, we sent it a link". A page that
 * says "no such account" for one address and "check your mail" for another is a free, unauthenticated
 * way to ask who sells here (`lib/password-reset.ts` carries the reasoning in full).
 *
 * That is also why the send is `void`ed rather than awaited. Awaiting it would make the registered
 * case take as long as a provider takes to answer and the unregistered case return instantly, and
 * the difference is measurable from outside — the same oracle, rebuilt out of a stopwatch.
 *
 * CSRF is checked once, in `middleware.ts`, for every mutating route.
 */

if (getSellerSession(Astro.cookies)) return Astro.redirect('/seller/dashboard');

const lang = getLang(Astro.cookies);
const t = getT(lang);

let error = '';
let sent = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') || '').trim();

  // Counted on EVERY attempt, including the ones that find nobody: what is being limited here is
  // mail-bombing one seller and walking a list of addresses, and both look like success.
  const rules = passwordResetRules(email, clientIp(Astro.request, Astro.clientAddress));
  const gate = await checkAuthRate(rules);
  if (!gate.allowed) {
    Astro.response.status = 429;
    error = t.auth.tooManyAttempts.replace('{n}', String(retryAfterMinutes(gate.retryAfterSec)));
  } else if (!isValidEmail(email)) {
    // Format only, and it gives nothing away: whether a string is a well-formed address is a fact
    // about the string, not about who is registered here. The two answers this page must never tell
    // apart are "registered" and "not registered", and both of those are well-formed.
    await countAuthAttempt(rules);
    error = t.auth.invalidEmail;
  } else {
    await countAuthAttempt(rules);
    const issued = await issuePasswordResetToken(email);
    if (issued) {
      void sendPasswordResetEmail({
        to: issued.seller.email,
        sellerName: issued.seller.name,
        // From the canonical origin, NOT from `Astro.url` — a `Host` header the caller chose would
        // put an attacker's domain in a real seller's real reset mail (`lib/password-reset.ts`).
        resetUrl: passwordResetUrl(issued.token),
        expiresInMinutes: issued.expiresInMinutes,
      });
    }
    // Outside the `if (issued)` on purpose — this is the sentence for both halves.
    sent = true;
  }
}
---

<BaseLayout title={t.auth.forgotTitle} noindex={true} isLoggedIn={false} hasStore={false} storeMode={true} sellerMode={true}>
  <section class="section container auth-wrap">
    <div class="auth-card">
      <header class="auth-head">
        <BrandLogo class="mb-[0.9rem]" size="1.45rem" />
        <h1>{t.auth.forgotTitle}</h1>
        <p class="auth-subtitle">{t.auth.forgotSubtitle}</p>
      </header>

      {error && <p class="auth-error" role="alert">{error}</p>}

      {sent ? (
        <Fragment>
          <p class="auth-notice" role="status">{t.auth.forgotSent}</p>
          <p class="muted auth-switch"><a href="/seller/login">{t.auth.forgotBackToLogin}</a></p>
        </Fragment>
      ) : (
        <form method="POST" class="auth-form">
          <CsrfField />
          <label class="field">
            <span>{t.auth.email}</span>
            <input class="input" type="email" name="email" required autocomplete="email" autofocus />
          </label>
          <button class="btn" type="submit">{t.auth.forgotSubmit}</button>
          <p class="muted auth-switch"><a href="/seller/login">{t.auth.forgotBackToLogin}</a></p>
        </form>
      )}
    </div>
  </section>
</BaseLayout>
