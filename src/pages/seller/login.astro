---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CsrfField from '../../components/CsrfField.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { loginSeller, setSellerSession, getSellerSession } from '../../lib/seller-auth.js';
import { getLang, getT } from '../../i18n/index.js';
import { safeRedirectPath } from '../../lib/safe-redirect.js';
import { isGoogleAuthEnabled } from '../../lib/google-oauth.js';
import { clientIp } from '../../lib/client-ip.js';
import {
  checkAuthRate, clearAuthRate, countAuthAttempt, retryAfterMinutes, sellerLoginRules,
} from '../../lib/rate-limit.js';

if (getSellerSession(Astro.cookies)) return Astro.redirect('/seller/dashboard');

const lang = getLang(Astro.cookies);
const t    = getT(lang);
const googleEnabled = isGoogleAuthEnabled();

// Only an in-site absolute path, and never back to this page itself (login → login loop).
// The rule lives in lib/safe-redirect.ts — it used to be three lines copy-pasted here, in
// register, in logout and in the Google route, which is how /api/lang ended up without it.
const safeNext = safeRedirectPath(Astro.url.searchParams.get('next'), '/', ['/seller/login']);

// Map OAuth error codes to user-facing messages
const oauthError = Astro.url.searchParams.get('error');
const oauthErrorMsg =
  oauthError === 'oauth_denied' ? t.auth.oauthDenied :
  oauthError ? t.auth.oauthFailed : '';

let error = oauthErrorMsg;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email    = String(form.get('email')    || '');
  const password = String(form.get('password') || '');

  // Asked BEFORE the password is verified — the cost being defended against is bcrypt's, so a gate
  // that checks first and refuses afterwards has already paid it (lib/rate-limit.ts).
  const rules = sellerLoginRules(email, clientIp(Astro.request, Astro.clientAddress));
  const gate = await checkAuthRate(rules);
  if (!gate.allowed) {
    Astro.response.status = 429;
    error = t.auth.tooManyAttempts.replace('{n}', String(retryAfterMinutes(gate.retryAfterSec)));
  } else {
    const seller = await loginSeller(email, password);
    if (seller) {
      // A correct password wipes the slate, so yesterday's typos can never add up to a lockout.
      await clearAuthRate(rules);
      setSellerSession(Astro.cookies, seller.id);
      return Astro.redirect(String(form.get('_next') || safeNext));
    }
    await countAuthAttempt(rules);
    error = t.auth.wrongCredentials;
  }
}
---

<BaseLayout title={t.auth.sellerLogin} noindex={true} isLoggedIn={false} hasStore={false} storeMode={true} sellerMode={true}>
  <section class="section container auth-wrap">
    <div class="auth-card">
      <header class="auth-head">
        <BrandLogo class="mb-[0.9rem]" size="1.45rem" />
        <h1>{t.auth.sellerLogin}</h1>
        <p class="auth-subtitle">{t.auth.loginSubtitle}</p>
      </header>

      {error && <p class="auth-error" role="alert">{error}</p>}

      {/* Only offered when the flow can actually complete: with no GOOGLE_CLIENT_ID/SECRET the
          route answers a bare 503, so an always-rendered button was a dead end (lib/google-oauth.ts). */}
      {googleEnabled && (
        <Fragment>
        <a href={`/api/auth/google?next=${encodeURIComponent(safeNext)}`} class="btn-google" aria-label={t.auth.continueWithGoogle}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          {t.auth.continueWithGoogle}
        </a>

        <div class="auth-divider"><span>{t.auth.orDivider}</span></div>
        </Fragment>
      )}

      <form method="POST" class="auth-form">
        <CsrfField />
        <input type="hidden" name="_next" value={safeNext} />
        <label class="field">
          <span>{t.auth.email}</span>
          <input class="input" type="email" name="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span>{t.auth.password}</span>
          <input class="input" type="password" name="password" required autocomplete="current-password" />
        </label>
        <button class="btn" type="submit">{t.auth.login}</button>
        <p class="muted auth-switch">{t.auth.noStore} <a href="/seller/register">{t.auth.openOne}</a></p>
      </form>
    </div>
  </section>
</BaseLayout>
