---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import CsrfField from '../components/CsrfField.astro';
import { isDemoMode, DEMO_SELLER_EMAIL, DEMO_BUYER_EMAIL } from '../lib/demo-mode.js';
import { getSellerByEmail, setSellerSession } from '../lib/seller-auth.js';
import { setAdminCookie } from '../lib/admin-auth.js';

/**
 * The way in — three buttons, no credentials.
 *
 * **This page grants an admin session on a button press, so the first line of it is the one that
 * matters.** Outside demo mode it does not exist at all: a 404, not a redirect and not a disabled
 * form, because a route that renders and refuses is a route somebody will eventually make render
 * and accept. `isDemoMode()` reads the live process environment, so the answer is a property of the
 * host rather than of the build, and the real site can never serve this by having been built from
 * the same commit.
 *
 * The owner chose buttons over a standing demo bar (2026-08-26), and over an unmarked site: a
 * visitor arriving from a portfolio link needs a door, and a person who lands on the homepage
 * instead should meet the shop rather than a notice about the shop.
 *
 * There is deliberately no "try building a store" button. The application already has that door and
 * it is called **פתח חנות** — the real registration flow, which in demo mode runs against the
 * stand-in clearing company all the way to a published shop. A second, shorter path to the same
 * place would be a demonstration of something this application does not do.
 */
if (!isDemoMode()) return new Response(null, { status: 404 });

let error = '';
if (Astro.request.method === 'POST') {
  const role = String((await Astro.request.formData()).get('role') ?? '');
  if (role === 'admin') {
    setAdminCookie(Astro.cookies);
    return Astro.redirect('/admin');
  }
  if (role === 'seller' || role === 'buyer') {
    const email = role === 'seller' ? DEMO_SELLER_EMAIL : DEMO_BUYER_EMAIL;
    const account = await getSellerByEmail(email);
    // A named failure rather than a redirect to the login form. The only way to reach it is a
    // database that has not been seeded, and "log in" silently becoming "please log in" is the
    // single most confusing thing this page could do to somebody who has just been handed a link.
    if (!account) error = `חשבון ההדגמה ${email} לא קיים — יש להריץ את זריעת תיק העבודות.`;
    else {
      setSellerSession(Astro.cookies, account.id);
      return Astro.redirect(role === 'seller' ? '/seller/dashboard' : '/buyer/dashboard');
    }
  }
}

const doors = [
  {
    role: 'seller',
    title: 'מסך הניהול של מוכר',
    body: 'ארבע חנויות שרצות כבר חודשים: הזמנות, מלאי, דוחות, קמפיינים, מנוי ותשלומים.',
  },
  {
    role: 'buyer',
    title: 'החשבון של קונה',
    body: 'הזמנות קודמות, מעקב משלוח, בקשת החזרה וכתיבת ביקורת.',
  },
  {
    role: 'admin',
    title: 'מסך הניהול של הפלטפורמה',
    body: 'כל המוכרים, כל ההזמנות, פניות, תקלות והביצועים של המתחם.',
  },
];
---

<BaseLayout title="הדגמה" noindex={true} isLoggedIn={false} storeMode={true}>
  <div class="mx-auto max-w-[46rem] px-4 py-12">
    <h1 class="text-[1.6rem] font-bold m-0 [color:var(--color-text)]">הדגמה חיה</h1>
    {/* Two sentences, and the second one is the one a visitor actually needs: what is safe to do
        here. `feedback_no_standing_screen_prose` forbids a paragraph above a screen — this IS the
        screen, and its content is the explanation. */}
    <p class="mt-2 mb-1 text-[.95rem] [color:var(--color-muted)]">
      זהו עותק מלא של המתחם, עם חנויות, מוצרים, הזמנות ונתונים אמיתיים לגמרי מבחינת המערכת.
    </p>
    <p class="mt-0 mb-8 text-[.95rem] [color:var(--color-muted)]">
      ניתן לקנות, לנהל, לפתוח חנות חדשה ולשנות כל דבר. אין חיוב, לא נאספים פרטי אשראי, והכול חוזר
      למצבו ההתחלתי מדי שעה.
    </p>

    {error && <p class="mb-6 text-[.9rem] [color:var(--color-danger)]" role="alert">{error}</p>}

    <div class="grid gap-3">
      {doors.map((door) => (
        <form method="POST" class="contents">
          <CsrfField />
          <input type="hidden" name="role" value={door.role} />
          {/* The whole card is the button. A card with a small button in the corner makes a visitor
              hunt for the target on a page whose only purpose is to be clicked. */}
          <button
            type="submit"
            class="text-start w-full bg-[color:var(--color-surface)] border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] p-5 cursor-pointer transition-colors duration-150 hover:[background:var(--color-bg)] focus-visible:outline-2 focus-visible:[outline-color:var(--color-accent)]"
          >
            <span class="block text-[1rem] font-semibold [color:var(--color-text)]">{door.title}</span>
            <span class="block mt-1 text-[.875rem] [color:var(--color-muted)]">{door.body}</span>
          </button>
        </form>
      ))}

      {/* Not a form: browsing needs no session at all, and giving it one would put a "logged in"
          header over a shopper's view of the site. */}
      <a
        href="/"
        class="block w-full bg-[color:var(--color-surface)] border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] p-5 no-underline transition-colors duration-150 hover:[background:var(--color-bg)]"
      >
        <span class="block text-[1rem] font-semibold [color:var(--color-text)]">סתם להסתובב באתר</span>
        <span class="block mt-1 text-[.875rem] [color:var(--color-muted)]">
          המתחם כפי שקונה רואה אותו. ניתן להוסיף לעגלה ולהשלים רכישה בלי להתחבר.
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
