---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewForm from '../../components/ReviewForm.astro';
import { getOrderById } from '../../lib/orders.js';
import { getSellerSession } from '../../lib/seller-auth.js';
import { verifyReviewToken } from '../../lib/review-token.js';
import { reviewableLines, orderIsReviewable } from '../../lib/review-eligibility.js';
import { getReviewedProductIds } from '../../lib/product-reviews.js';
import { REVIEW_INVITE_DAYS_AFTER_DISPATCH, REVIEW_INVITE_FALLBACK_DAYS_AFTER_PAYMENT } from '../../lib/review-timing.js';
import { getLang, getT } from '../../i18n/index.js';
import { cdnThumb } from '../../lib/cdn.js';

/**
 * "How was it?" — the page a buyer lands on from the review link in their order mail.
 *
 * **The one screen a guest can review from**, which is what makes the whole feature reachable by
 * the majority of buyers (guest checkout is the default here — `review-eligibility.ts` argues the
 * decision). A signed-in buyer reaches the same page from their orders list, and it behaves
 * identically; the only difference is which proof let them in.
 *
 * **`noindex`, and not because it is secret** — it is a personal, single-use screen with no content
 * worth a search result, and letting Google hold a URL that carries a signature is how a signature
 * ends up in a log somebody reads. It is excluded from the sitemap by the private-route filter for
 * the same reason.
 *
 * One form per purchased item, all on one screen: an order of three things is one visit and three
 * ratings, not three pages. Items already reviewed stay listed and marked — seeing "דורג" beside
 * the shirt is the answer to "did I already do this", and hiding them would make a returning buyer
 * think the link had broken.
 */

const { orderId } = Astro.params;
const lang = getLang(Astro.cookies);
const t = getT(lang);

const order = orderId ? await getOrderById(orderId) : null;
const userId = getSellerSession(Astro.cookies);
// Either proof will do, and neither is trusted further than "this person holds this order":
// everything about WHAT may be reviewed is re-derived below, and re-derived again by /api/review.
const allowed = !!order
  && (verifyReviewToken(orderId!, Astro.url.searchParams.get('t')) || (!!userId && order.buyerId === userId));

// One message for "no such order", "wrong signature" and "not yet delivered". They are the same
// thing to the person holding the link — nothing to do here yet — and three different oracles to
// anyone probing for a real order id.
const usable = allowed && orderIsReviewable(order!);
const reviewed = usable ? await getReviewedProductIds(orderId!) : [];
const lines = usable ? reviewableLines(order!, reviewed) : [];
const doneCount = usable ? reviewed.length : 0;

/**
 * The way OUT, for the buyer whose parcel never came (owner asked, 2026-08-17).
 *
 * Without it this page offers exactly one thing to do with a bad experience — press one star — and
 * a buyer who never received the goods will press it, because it is the only button in front of
 * them. That review says nothing about the product, it is permanent, it drags the seller's average
 * down for a failure that may not even be theirs, and it goes out in the Google feed. The
 * frustration is legitimate; the star is simply the wrong place to put it.
 *
 * The platform already has the right place: a return request with reason `not_arrived`, which the
 * returns decisions doc §8 puts on US rather than on the seller.
 *
 * ── One button, and the paragraph around it was DELETED (owner, 2026-08-17) ──
 * The first cut was a heading, a sentence of explanation and a button. "לא קיבלתי את ההזמנה" is
 * the whole thought; a person who did not receive their order does not need it explained to them,
 * and prose above a screen is a standing ban here (memory `feedback_no_standing_screen_prose`).
 *
 * ── WHEN it appears, which is the part that stops it being noise ──
 * Not while a parcel could reasonably still be in transit — offering "didn't arrive?" on day two is
 * the platform inviting a case that does not exist yet, and the owner's own bar is the right one:
 * a week and a half with nothing confirmed is strange, three days is not.
 *
 *   · Delivery CONFIRMED (`deliveredAt`) — a quiet line under the forms. The seller has said it
 *     arrived; leading with doubt would be planting one. But the buyer may still disagree, so the
 *     door is never absent.
 *   · Nothing confirmed, and payment older than the fallback window — the button, on its own,
 *     above the stars. This is precisely the state the invitation mail was sent in
 *     (`review-invite-run.ts`'s fallback clock), so the page and the mail agree by construction:
 *     the same constant decides both.
 *   · Nothing confirmed and recent — NOTHING. The buyer reached this page from their orders list
 *     rather than from the mail, and the parcel is simply still on its way.
 *
 * Measured from DISPATCH (`shipped_at`, migration 0036), which is the moment the wait actually
 * starts. It used to be measured from payment, and that quietly charged the buyer's patience for
 * the seller's packing time: five legitimate days in `processing` and the button appeared two days
 * into transit. An order with no dispatch stamp — self-pickup, which never passes through
 * `shipped`, or a row older than 0036 — falls through to the more patient payment clock.
 *
 * Where it points depends on who holds the link, because opening a return needs an account: a
 * signed-in buyer goes to their orders list, where the button already is; a guest goes to
 * `/contact`, which is unauthenticated by design and lands in the admin's alerts tab.
 */
const deliveryConfirmed = !!order?.deliveredAt;
const ageDays = (iso: string | undefined): number =>
  iso ? (Date.now() - new Date(iso).getTime()) / (24 * 60 * 60 * 1000) : -1;
// The same ladder the invite job walks, and the same constants — so the mail and this page can
// never disagree about whether a parcel is late (`review-timing.ts`).
const overdue = order?.shippedAt
  ? ageDays(order.shippedAt) >= REVIEW_INVITE_DAYS_AFTER_DISPATCH
  : ageDays(order?.paidAt) >= REVIEW_INVITE_FALLBACK_DAYS_AFTER_PAYMENT;
const notArrivedIsLikely = !deliveryConfirmed && overdue;
const notArrivedHref = userId ? '/buyer/dashboard?tab=orders' : '/contact';
---

<BaseLayout title={t.reviews.pageTitle} description={t.reviews.pageIntro} noindex={true} isLoggedIn={!!userId} storeMode={true}>
  <div class="mx-auto w-full px-4 py-8" style="max-width:44rem">
    <h1 style="font-size:1.35rem;font-weight:700;color:var(--color-text);margin:0 0 0.35rem">{t.reviews.pageTitle}</h1>

    {!usable && (
      <p style="color:var(--color-muted);font-size:0.95rem;margin:0.75rem 0 0">{t.reviews.pageInvalid}</p>
    )}

    {usable && lines.length === 0 && (
      <p style="color:var(--color-muted);font-size:0.95rem;margin:0.75rem 0 0">{t.reviews.pageDone}</p>
    )}

    {usable && lines.length > 0 && (
      <>
        <p style="color:var(--color-muted);font-size:0.95rem;margin:0 0 1rem">{t.reviews.pageIntro}</p>

        {notArrivedIsLikely && (
          <p style="margin:0 0 1.5rem">
            <a href={notArrivedHref} class="btn btn--ghost btn--sm">{t.reviews.notArrivedCta}</a>
          </p>
        )}

        <div class="flex flex-col gap-4">
          {lines.map((line) => (
            <section class="flex flex-col gap-3"
                     style="border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface);padding:1rem">
              <div class="flex items-center gap-3">
                {line.image && (
                  <img src={cdnThumb(line.image, 96, 96)} alt="" width="48" height="48" loading="lazy" decoding="async"
                       style="width:48px;height:48px;object-fit:cover;border-radius:var(--radius-sm);flex:0 0 auto;background:var(--color-surface)" />
                )}
                <div dir="auto" class="min-w-0">
                  <a href={`/${line.storeSlug}/${line.productSlug}`}
                     style="font-size:0.95rem;font-weight:600;color:var(--color-text);text-decoration:none;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{line.productName}</a>
                  <span style="font-size:0.78rem;color:var(--color-muted)">{line.storeName}</span>
                </div>
              </div>
              <ReviewForm
                productId={line.productId}
                orderId={orderId!}
                token={Astro.url.searchParams.get('t') ?? undefined}
                showVerifiedNote={false}
              />
            </section>
          ))}
        </div>
        {deliveryConfirmed && (
          <p style="margin:1.25rem 0 0;font-size:0.82rem">
            <a href={notArrivedHref} style="color:var(--color-muted);text-decoration:underline;text-underline-offset:3px">{t.reviews.notArrivedCta}</a>
          </p>
        )}

        {doneCount > 0 && (
          <p style="color:var(--color-muted);font-size:0.8rem;margin:1rem 0 0">
            {`${doneCount} · ${t.reviews.rated}`}
          </p>
        )}
      </>
    )}
  </div>

  <script>
    import { initReviewForms } from '../../scripts/review-form.js';
    initReviewForms();
  </script>
</BaseLayout>
