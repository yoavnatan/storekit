---
export const prerender = false;
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreAvatar from '../../components/StoreAvatar.astro';
import { getStoreBySlug } from '../../lib/stores.js';
import { formatStoreHours, formatStoreHoursSchema, googleMapsSearchUrl } from '../../lib/store-hours.js';
import { getProductsByStoreId } from '../../lib/store-products.js';
import { filterAndSortProducts, PRODUCTS_PAGE_SIZE } from '../../lib/product-listing.js';
import { getCategoriesByStoreId, buildCategoryTree, getAncestorChain, resolveCategoryFilterIds, categoryPath } from '../../lib/store-categories.js';
import { store as platform, formatPrice, cdnSrc } from '../../config/store.config.js';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getLang, getT, getDir } from '../../i18n/index.js';
import { getFavoriteStoresForUser } from '../../lib/user-carts.js';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const shopStore = getStoreBySlug(slug);
if (!shopStore) return Astro.redirect('/404');

const userId = getSellerSession(Astro.cookies);
const isLoggedIn = !!userId;
const isFavorited = userId ? getFavoriteStoresForUser(userId).includes(shopStore.slug) : false;

const allProducts = getProductsByStoreId(shopStore.id);
const storeCategories = getCategoriesByStoreId(shopStore.id);
const categoryTree = buildCategoryTree(storeCategories);

// Initial page render honors the same category/sort/q as the URL (deep links,
// back-navigation) — server-side, so first paint is already correct and fully
// crawlable. Beyond page 1, "load more" takes over via /api/store-products
// using this exact same filterAndSortProducts(), so results never drift.
const initCategory = Astro.url.searchParams.get('category') ?? '';
const initSort = Astro.url.searchParams.get('sort') ?? '';
const initQ = Astro.url.searchParams.get('q') ?? '';

// Drill-down: selecting a category shows it + its own children as the next
// chip row (breadcrumb above), not a flat list of every category at once.
const selectedCategory = initCategory ? storeCategories.find((c) => c.id === initCategory) ?? null : null;
const breadcrumbChain = selectedCategory ? getAncestorChain(storeCategories, selectedCategory.id) : [];
const chipLevelCategories = storeCategories
  .filter((c) => c.parentId === (selectedCategory ? selectedCategory.id : null))
  .sort((a, b) => a.order - b.order);

const categoryIds = selectedCategory ? resolveCategoryFilterIds(storeCategories, selectedCategory.id) : undefined;
const filteredProducts = filterAndSortProducts(allProducts, { categoryIds, sort: initSort, q: initQ });
const products = filteredProducts.slice(0, PRODUCTS_PAGE_SIZE);
const hasMoreProducts = filteredProducts.length > products.length;

const storeUrl = new URL(`/store/${shopStore.slug}`, Astro.url).href;
const today = new Date().toDateString();

const lang = getLang(Astro.cookies);
const dir  = getDir(lang);
const t    = getT(lang);

const showAddress = !!shopStore.addressVisible && !!shopStore.address;
const showHours = !!shopStore.hoursVisible && !!shopStore.hours;
const showDetails = showAddress || showHours;
const hoursRows = showHours && shopStore.hours ? formatStoreHours(shopStore.hours, t.store.hoursDay, t.store.hoursClosed) : null;
const mapsUrl = showAddress && shopStore.address ? googleMapsSearchUrl(shopStore.address) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: shopStore.name,
  description: shopStore.description || shopStore.tagline || `Shop at ${shopStore.name}`,
  url: storeUrl,
  ...(showAddress && shopStore.address ? { address: shopStore.address } : {}),
  ...(showHours && shopStore.hours ? { openingHours: formatStoreHoursSchema(shopStore.hours) } : {}),
};

const pmI18n = {
  addToCart: t.store.addToCart,
  addedToCart: t.store.addedToCart,
  toCheckout: t.store.toCheckout,
  outOfStock: t.store.outOfStock,
  inStockLabel: t.store.inStockLabel,
  addToWishlist: t.wishlist.addLabel,
  removeFromWishlist: t.wishlist.removeLabel,
  badgeNew: t.store.badgeNew,
  loadingMore: t.store.loadingMore,
  filterAll: t.store.filterAll,
  filterByCategory: t.store.filterByCategory,
  fullPage: lang === 'he' ? 'לדף המוצר המלא' : 'View full product page',
  close: lang === 'he' ? 'סגור' : 'Close',
  showMore: lang === 'he' ? 'עוד' : 'More',
  showLess: lang === 'he' ? 'פחות' : 'Less',
};
---

<BaseLayout
  title={shopStore.name}
  description={shopStore.tagline || shopStore.description || `Shop at ${shopStore.name} on ${platform.name}`}
  jsonLd={jsonLd}
  isLoggedIn={isLoggedIn}
  storeMode={true}
  storeName={shopStore.name}
  storeSlug={shopStore.slug}
  dataLayer={{ event: 'page_view', page_type: 'store', store_id: shopStore.id, store_name: shopStore.name, store_slug: shopStore.slug, currency: 'ILS' }}
>
  <script is:inline>
    // Anti-flash: if a scroll position is waiting to be restored for this store,
    // hide the page until the deferred script below has re-applied filters and
    // scrolled into place — otherwise the page paints at the top first and then
    // visibly snaps down once the module script catches up.
    (function () {
      try {
        var m = location.pathname.match(/^\/store\/([^/]+)\/?$/);
        if (m && sessionStorage.getItem('store_scroll_' + m[1])) {
          document.documentElement.style.visibility = 'hidden';
          setTimeout(function () { document.documentElement.style.visibility = ''; }, 500);
        }
      } catch (e) {}
    })();
  </script>
  <script is:inline type="application/json" id="pm-i18n" set:html={JSON.stringify(pmI18n)} />

  <div class="store-page" data-store-slug={shopStore.slug} data-store-name={shopStore.name} data-lang={lang}>

    <section class="store-banner" aria-labelledby="store-heading">
      <div class="container">
        {shopStore.bannerImage && (
          <div class="store-banner__image-wrap">
            <img
              src={cdnSrc(shopStore.bannerImage, 1200)}
              alt=""
              width="1200"
              height="400"
              class="store-banner__bg"
            />
          </div>
        )}
        <div class="store-banner__info">
          <div class="store-banner__identity">
            <StoreAvatar name={shopStore.name} profileImage={shopStore.profileImage} size={56} />
            <h1 id="store-heading" class="store-name" dir={dir}>{shopStore.name}</h1>
          </div>
          {shopStore.tagline && <p class="store-tagline" dir={dir}>{shopStore.tagline}</p>}
            {shopStore.description && shopStore.description !== shopStore.tagline && (
              <p class="store-desc" dir={dir}>{shopStore.description}</p>
            )}

            {showDetails && (
              <details class="store-details" dir={dir}>
                <summary class="store-details__summary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {t.store.moreDetails}
                  <svg class="store-details__chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="store-details__content">
                  {showAddress && (
                    <a
                      class:list={['store-details__item', { 'store-details__item--link': !!mapsUrl }]}
                      href={mapsUrl || undefined}
                      target={mapsUrl ? '_blank' : undefined}
                      rel={mapsUrl ? 'noopener noreferrer' : undefined}
                      aria-label={mapsUrl ? t.store.viewOnMap : undefined}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {shopStore.address}
                    </a>
                  )}
                  {hoursRows && (
                    <div class="store-details__item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:0.15rem"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      <ul class="store-details__hours-list">
                        {hoursRows.map((row) => <li>{row}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            )}

            <!-- Actions row -->
            <div class="store-banner__actions">
            <div style="position:relative;display:flex;align-items:center">
              <button
                id="fav-store-btn"
                type="button"
                class="store-banner-action-btn"
                data-slug={shopStore.slug}
                data-favorited={String(isFavorited)}
                data-login-url={`/seller/login?next=/store/${shopStore.slug}`}
                data-is-logged-in={String(isLoggedIn)}
                aria-label={isFavorited ? t.store.savedStore : t.store.saveStore}
                aria-pressed={isFavorited}
              >
                <svg id="fav-store-icon" width="13" height="13" viewBox="0 0 24 24" fill={isFavorited ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;transition:fill 0.18s">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                <span id="fav-store-label">{isFavorited ? t.store.savedStore : t.store.saveStore}</span>
              </button>
              <div
                id="fav-store-tooltip"
                role="status"
                aria-live="polite"
                style="position:absolute;top:calc(100% + 0.45rem);inset-inline-start:0;z-index:30;background:var(--color-surface);border:1px solid var(--color-border);border-radius:0.55rem;padding:0.45rem 0.8rem;white-space:nowrap;box-shadow:0 4px 18px rgba(0,0,0,0.11);font-size:0.8rem;color:var(--color-text);opacity:0;pointer-events:none;transform:translateY(-6px) scale(0.97);transition:opacity 0.17s,transform 0.22s cubic-bezier(0.34,1.56,0.64,1)"
              >
                {t.store.loginToSave} <a id="fav-store-tooltip-link" href={`/seller/login?next=/store/${shopStore.slug}`} style="color:var(--color-accent);font-weight:600">{t.store.loginToSaveLink}</a>
              </div>
            </div>

            {userId !== shopStore.sellerId && (
              <button
                type="button"
                class="store-banner-action-btn"
                id="contact-store-btn"
                data-store-id={shopStore.id}
                data-seller-id={shopStore.sellerId}
                data-store-name={shopStore.name}
                data-is-logged-in={String(isLoggedIn)}
                data-login-url={`/seller/login?next=/store/${shopStore.slug}`}
                aria-label={`צור קשר עם ${shopStore.name}`}
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                צור קשר
              </button>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="section container">
{allProducts.length === 0 ? (
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <p>{t.store.emptyStore}</p>
        </div>
      ) : (
        <Fragment>
          <div class="store-controls">
            {/* Hidden search input — driven by header search bar */}
            <input type="search" id="product-search" style="display:none" tabindex="-1" aria-hidden="true" autocomplete="off" />

            {breadcrumbChain.length > 0 && (
              <nav id="category-breadcrumb" class="category-breadcrumb" aria-label={t.store.filterByCategory}>
                <button type="button" class="category-breadcrumb__crumb" data-category-id="">{t.store.filterAll}</button>
                {breadcrumbChain.map((c, i) => (
                  <Fragment>
                    <span class="category-breadcrumb__sep" aria-hidden="true">›</span>
                    {i === breadcrumbChain.length - 1
                      ? <span class="category-breadcrumb__current">{c.name}</span>
                      : <button type="button" class="category-breadcrumb__crumb" data-category-id={c.id}>{c.name}</button>}
                  </Fragment>
                ))}
              </nav>
            )}

            <div class="store-controls__row">
              {storeCategories.length > 0 && (
                <div id="category-filters" class="category-filters-row" role="group" aria-label={t.store.filterByCategory}
                     hidden={chipLevelCategories.length === 0 && !selectedCategory}>
                  {!selectedCategory && (
                    <button type="button" class="category-chip" data-category-id="" aria-pressed="true">
                      {t.store.filterAll}
                    </button>
                  )}
                  {chipLevelCategories.map((cat) => (
                    <button type="button" class="category-chip" data-category-id={cat.id} aria-pressed="false">
                      {cat.name}
                    </button>
                  ))}
                </div>
              )}
              <script type="application/json" id="store-category-tree-data" set:html={JSON.stringify(categoryTree)} />

              <div class="sort-dropdown-wrap" id="sort-dropdown">
                <button
                  type="button"
                  id="sort-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  class="sort-trigger"
                  aria-label={t.store.sortDefault}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="flex-shrink:0"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
                  <svg id="sort-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transition:transform 0.15s ease"><polyline points="6 9 12 15 18 9"/></svg>
                  <span id="sort-label" class="visually-hidden">{t.store.sortDefault}</span>
                </button>
                <ul
                  id="sort-menu"
                  role="listbox"
                  aria-labelledby="sort-trigger"
                  hidden
                  class="absolute top-full z-20 mt-1"
                  style="inset-inline-end:0;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);box-shadow:0 4px 20px rgba(0,0,0,0.12);padding:0.3rem;animation:sort-menu-open 0.13s cubic-bezier(0.34,1.56,0.64,1);min-width:11rem;max-width:calc(100vw - 1.5rem);white-space:nowrap">
                  <li role="option" data-value="default" aria-selected="true" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[4px] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortDefault}</li>
                  <li role="option" data-value="name-asc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[4px] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortNameAsc}</li>
                  <li role="option" data-value="name-desc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[4px] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortNameDesc}</li>
                  <li role="option" data-value="price-asc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[4px] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortPriceAsc}</li>
                  <li role="option" data-value="price-desc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[4px] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortPriceDesc}</li>
                  <li role="option" data-value="newest" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[4px] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortNewest}</li>
                </ul>
              </div>
            </div>
          </div>
          <ul class="product-grid" role="list" hidden={products.length === 0}>
            {products.map((p, idx) => {
              const isNew = new Date(p.createdAt).toDateString() === today;
              const hasImages = !!(p.images?.length);
              return (
                <li class="product-card card"
                    data-images={hasImages ? JSON.stringify(p.images) : undefined}
                    data-product-name={p.name}
                    data-price={String(p.price)}
                    data-created-at={p.createdAt}
                    data-slug={p.slug}
                    data-description={p.description || ''}
                    data-stock={String(p.stock)}
                    data-category-id={p.categoryId ?? ''}
                    data-category-path={p.categoryId ? categoryPath(storeCategories, p.categoryId) : ''}
                    data-tags={p.tags?.length ? p.tags.join(',') : ''}
                    data-variants={p.variants?.length ? JSON.stringify(p.variants) : undefined}
                    data-variant-stock={p.variantStock ? JSON.stringify(p.variantStock) : undefined}
                    data-variant-images={p.variantImages ? JSON.stringify(p.variantImages) : undefined}>
                  <div class={`product-card__img-wrap${hasImages ? ' product-card__img-wrap--clickable is-loading' : ''}`}
                       role={hasImages ? 'button' : undefined}
                       aria-label={hasImages ? p.name : undefined}
                       tabindex={hasImages ? 0 : undefined}>
                    <div class="product-card__slides">
                      {hasImages
                        ? p.images!.map((img, imgIdx) => (
                            <div class="product-card__slide">
                              <Image src={cdnSrc(img)} alt={p.name} class="product-card__img" width={400} height={400} loading={idx < 4 && imgIdx === 0 ? 'eager' : 'lazy'} fetchpriority={idx < 2 && imgIdx === 0 ? 'high' : undefined} />
                            </div>
                          ))
                        : <div class="product-card__slide">
                            <div class="product-card__img-placeholder" aria-hidden="true">
                              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                <line x1="12" y1="22.08" x2="12" y2="12"/>
                              </svg>
                            </div>
                          </div>
                      }
                    </div>
                    {isNew && <span class="badge badge--new">{t.store.badgeNew}</span>}
                  <button
                    type="button"
                    class="wishlist-btn"
                    data-wishlist-slug={p.slug}
                    data-wishlist-name={p.name}
                    data-wishlist-price={String(p.price)}
                    data-wishlist-image={p.images?.[0] ? cdnSrc(p.images[0]) : ''}
                    data-wishlist-store-slug={shopStore.slug}
                    data-wishlist-store-name={shopStore.name}
                    data-wishlist-stock={String(p.stock)}
                    data-wishlisted="false"
                    aria-pressed="false"
                    aria-label={t.wishlist.addLabel}
                    style="position:absolute;top:0.45rem;inset-inline-end:0.45rem;z-index:2;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,0.9);color:var(--color-muted);transition:color 0.15s,background 0.15s,transform 0.15s"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </button>
                    {hasImages && (p.images?.length ?? 0) > 1 && (
                      <div class="product-card__dots" aria-hidden="true">
                        {p.images!.map((_, dotI) => <span class={`product-card__dot${dotI === 0 ? ' is-active' : ''}`}></span>)}
                      </div>
                    )}
                  </div>
                  <div class="product-card__body">
                    <a href={`/store/${shopStore.slug}/${p.slug}`}
                       class="product-modal-trigger hover:text-[var(--color-accent)] transition-colors duration-150"
                       style="color:inherit;text-decoration:none;display:block">
                      <h3 class="product-card__name" dir="auto">{p.name}</h3>
                    </a>
                    <div class="product-card__footer" style="flex-direction:column;align-items:stretch;gap:0.4rem">
                      <span class="product-card__price">{formatPrice(p.price)}</span>
                      {p.stock <= 0
                          ? <span class="badge badge--muted">{t.store.outOfStock}</span>
                          : <div dir="ltr" class="product-card__qtycart flex items-center" style="width:100%;height:2.25rem;border:1px solid var(--color-border);border-radius:var(--radius);overflow:hidden">
                              <button type="button" class="qty-dec flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label={t.cart.qtyDecrease} disabled>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                              </button>
                              <button
                                type="button"
                                class="product-card__add-btn add-to-cart-btn"
                                data-slug={p.slug}
                                data-name={p.name}
                                data-price={String(p.price)}
                                data-image={p.images?.[0] ? cdnSrc(p.images[0]) : ''}
                                data-stock={String(p.stock)}
                                data-label-added={t.store.addedToCart}
                                aria-label={t.store.addToCart}
                              >
                                <span class="btn-label" aria-hidden="true">
                                  <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                                    <circle cx="17" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                                    <path d="M1 3h2.4l2.72 13.4a2 2 0 0 0 2 1.6h7.76a2 2 0 0 0 2-1.6L20.4 7H5.1"/>
                                    <path d="M5.2 11.9h13.9M10.3 7.8L9.6 17.2M15 7.8L14.3 17.2" stroke-width="1.1"/>
                                  </svg>
                                </span>
                                <span class="qty-val text-sm font-semibold select-none" style="display:none" aria-live="polite" aria-atomic="true">1</span>
                              </button>
                              <button type="button" class="qty-inc flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label={t.cart.qtyIncrease}>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                              </button>
                            </div>
                      }
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
          <div id="no-results" class="empty-state" hidden={products.length > 0}>
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <p>{t.store.noProductsFound}</p>
          </div>
          <div id="load-more-wrap" class="load-more-wrap" hidden={!hasMoreProducts}>
            <button type="button" id="load-more-btn" class="load-more-btn" data-offset={String(products.length)}>
              <span id="load-more-label">{t.store.loadMore}</span>
            </button>
          </div>
        </Fragment>
      )}
    </section>

    <!-- Lightbox (kept for possible revert) -->
    <div id="lightbox" class="lightbox" hidden aria-modal="true" role="dialog" aria-label="Product image viewer">
      <div class="lightbox__backdrop" id="lightbox-backdrop"></div>
      <div class="lightbox__panel">
        <button class="lightbox__close" id="lightbox-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <button class="lightbox__arrow lightbox__arrow--prev" id="lightbox-prev" aria-label="Previous image">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <img class="lightbox__img" id="lightbox-img" src="" alt="" />
        <button class="lightbox__arrow lightbox__arrow--next" id="lightbox-next" aria-label="Next image">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <div class="lightbox__counter" id="lightbox-counter" hidden></div>
      </div>
    </div>

    <!-- Product Detail Modal -->
    <div id="product-modal" hidden role="dialog" aria-modal="true" aria-labelledby="pm-name"
         style="position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;padding:0.75rem">
      <div id="pm-backdrop"
           style="position:absolute;inset:0;background:rgba(0,0,0,0.58);cursor:pointer"></div>
      <div id="pm-panel"
           style="position:relative;z-index:1;background:white;border-radius:16px;width:min(100%,680px);max-height:90vh;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,0.35);display:flex;flex-direction:column">
        <button id="pm-close" aria-label={lang === 'he' ? 'סגור' : 'Close'}
                style="position:absolute;top:0.65rem;inset-inline-end:0.65rem;z-index:10;width:2rem;height:2rem;border-radius:50%;background:rgba(255,255,255,0.95);color:var(--color-muted);border:1px solid var(--color-border);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.15s,color 0.15s">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div id="pm-scroll" style="overflow-y:auto;flex:1 1 auto;min-height:0">
          <div id="pm-body"></div>
        </div>
        <div id="pm-footer" style="flex-shrink:0;padding:0.875rem 1.25rem 1.125rem;border-top:1px solid var(--color-border);box-shadow:0 -4px 16px rgba(0,0,0,0.06)"></div>
      </div>
    </div>

    <footer class="store-platform-note">
      <p>
        <a href="/" class="platform-link">{platform.name}</a> — {t.store.platformNote}
      </p>
    </footer>

  </div>
</BaseLayout>

<script is:inline type="application/json" id="header-search-products" set:html={JSON.stringify(
  allProducts.map((p) => ({
    slug: p.slug,
    name: p.name,
    price: p.price,
    image: p.images?.[0] ? cdnSrc(p.images[0], 72) : '',
  }))
)} />

<script>
  import { addItem, syncCartImages, getCartQty } from '../../lib/cart.js';
  import { isWishlisted, toggleWishlist } from '../../lib/wishlist.js';
  import { cdnSrc, formatPrice } from '../../config/store.config.js';
  import { spawnRipple } from '../../lib/ripple.js';
  import { spawnBurst } from '../../lib/burst.js';
  import { trackAddToCart } from '../../lib/tracking.js';
  import { resolveVariantColor, isColorVariant } from '../../lib/color-variants.js';
  import { comboKey } from '../../lib/variant-combo.js';
  import { initReadMore } from '../../lib/read-more.js';
  import { saveLastStore } from '../../lib/last-store.js';
  import { saveStoreScroll, applyStoreScrollQuery, restoreStoreScroll, peekStoreScrollState } from '../../lib/scroll-restore.js';
  import type { StoreProduct as StoreProductDTO } from '../../lib/store-products.js';
  import { PRODUCTS_PAGE_SIZE } from '../../lib/product-listing.js';

  document.querySelector<HTMLElement>('.store-page')?.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button:not([disabled]):not(#sort-trigger):not(.add-to-cart-btn):not(.pm-add-to-cart)');
    if (btn) spawnRipple(btn, e.clientX, e.clientY);
  });

  const storePage = document.querySelector<HTMLElement>('.store-page[data-store-slug]');
  const storeSlug = storePage?.dataset.storeSlug ?? '';
  const storeName = storePage?.dataset.storeName ?? '';

  // Tracks the store's own filter/sort/search query string (kept in sync by
  // syncUrl() below) — read at pagehide time instead of location.search,
  // since opening the product quick-view modal rewrites the address bar via
  // pushState to a /store/slug/product path with no query of its own.
  let lastQueryString = location.search;

  if (storeSlug) {
    saveLastStore({ slug: storeSlug, name: storeName, url: location.pathname + location.search });
    applyStoreScrollQuery(storeSlug);
    window.addEventListener('pagehide', () => saveStoreScroll(storeSlug, lastQueryString, loadedCount));
  }

  // ── Sync cart images ──────────────────────────────────────────
  const currentProducts = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.add-to-cart-btn')
  ).map((btn) => ({
    slug: btn.dataset.slug ?? '',
    name: btn.dataset.name ?? '',
    price: Number(btn.dataset.price ?? 0),
    image: btn.dataset.image ?? '',
  })).filter((p) => p.slug);
  if (storeSlug) syncCartImages(storeSlug, currentProducts);

  // ── Wishlist hearts ───────────────────────────────────────────
  function setHeartStyle(btn: HTMLElement, active: boolean) {
    const svg = btn.querySelector<SVGElement>('svg');
    if (!svg) return;
    if (active) {
      svg.style.fill = '#e53e3e';
      svg.style.stroke = '#e53e3e';
      btn.style.color = '#e53e3e';
      btn.style.background = 'rgba(255,255,255,0.95)';
    } else {
      svg.style.fill = 'none';
      svg.style.stroke = 'currentColor';
      btn.style.color = '';
      btn.style.background = 'rgba(255,255,255,0.85)';
    }
  }

  function getI18nWishlist() {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}')?.wishlist ?? {}; } catch { return {}; }
  }

  // Extracted so newly-appended "load more" cards can be wired up the same
  // way as the initial batch — see initNewProductCards() near the bottom.
  function initWishlistBtn(btn: HTMLButtonElement): void {
    const slug = btn.dataset.wishlistSlug ?? '';
    const active = isWishlisted(slug);
    btn.dataset.wishlisted = String(active);
    btn.setAttribute('aria-pressed', String(active));
    setHeartStyle(btn, active);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wi = getI18nWishlist();
      const item = {
        slug,
        name: btn.dataset.wishlistName ?? '',
        price: Number(btn.dataset.wishlistPrice ?? 0),
        image: btn.dataset.wishlistImage ?? '',
        storeSlug: btn.dataset.wishlistStoreSlug ?? '',
        storeName: btn.dataset.wishlistStoreName ?? '',
        stock: btn.dataset.wishlistStock !== undefined ? Number(btn.dataset.wishlistStock) : undefined,
      };
      const nowActive = toggleWishlist(item);
      btn.dataset.wishlisted = String(nowActive);
      btn.setAttribute('aria-pressed', String(nowActive));
      const newLabel = nowActive ? (wi.removeLabel ?? 'Remove from wishlist') : (wi.addLabel ?? 'Add to wishlist');
      btn.setAttribute('aria-label', newLabel);
      setHeartStyle(btn, nowActive);

      btn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.35)' }, { transform: 'scale(1)' }],
        { duration: 300, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );
      fetch('/api/wishlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: nowActive ? 'add' : 'remove', productSlug: slug }),
      });
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.wishlist-btn').forEach(initWishlistBtn);

  // ── Favorite store button ─────────────────────────────────────
  const favBtn = document.getElementById('fav-store-btn') as HTMLButtonElement | null;
  if (favBtn) {
    const isLoggedIn = favBtn.dataset.isLoggedIn === 'true';
    const favSlug = favBtn.dataset.slug ?? '';
    const favIcon = document.getElementById('fav-store-icon') as SVGElement | null;
    const favLabel = document.getElementById('fav-store-label');
    const favTooltip = document.getElementById('fav-store-tooltip') as HTMLElement | null;

    function setFavStyle(active: boolean) {
      if (!favIcon) return;
      favIcon.style.fill = active ? 'var(--color-accent)' : 'none';
      favIcon.style.stroke = active ? 'var(--color-accent)' : 'currentColor';
    }

    let tooltipTimer = 0;
    function showLoginTooltip() {
      if (!favTooltip) return;
      favTooltip.style.opacity = '1';
      favTooltip.style.pointerEvents = 'auto';
      favTooltip.style.transform = 'translateY(0) scale(1)';
      clearTimeout(tooltipTimer);
      tooltipTimer = window.setTimeout(hideLoginTooltip, 4000);
    }
    function hideLoginTooltip() {
      if (!favTooltip) return;
      favTooltip.style.opacity = '0';
      favTooltip.style.pointerEvents = 'none';
      favTooltip.style.transform = 'translateY(-6px) scale(0.97)';
    }
    document.addEventListener('click', (e) => {
      if (favTooltip && !favBtn.contains(e.target as Node) && !favTooltip.contains(e.target as Node)) {
        hideLoginTooltip();
      }
    });

    favBtn.addEventListener('click', () => {
      if (!isLoggedIn) { showLoginTooltip(); return; }
      const nowFav = favBtn.dataset.favorited !== 'true';
      favBtn.dataset.favorited = String(nowFav);
      favBtn.setAttribute('aria-pressed', String(nowFav));
      if (favLabel) favLabel.textContent = nowFav ? 'חנות שמורה' : 'שמור חנות';
      favBtn.setAttribute('aria-label', nowFav ? 'חנות שמורה' : 'שמור חנות');
      setFavStyle(nowFav);
      favBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.28)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34,1.56,0.64,1)' }
      );
      fetch('/api/favorite-store', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ storeSlug: favSlug }),
      })
        .then((r) => r.json() as Promise<{ favorited: boolean; count: number }>)
        .then(({ favorited }) => {
          favBtn.dataset.favorited = String(favorited);
          favBtn.setAttribute('aria-pressed', String(favorited));
          setFavStyle(favorited);
        })
        .catch(() => {
          favBtn.dataset.favorited = String(!nowFav);
          setFavStyle(!nowFav);
        });
    });
  }

  // ── Qty stepper + Add to cart (product grid) ──────────────────
  const checkSvg = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>';
  const cardCheckSvg = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

  function initProductCardCommerce(card: HTMLElement): void {
    const addBtn = card.querySelector<HTMLButtonElement>('.add-to-cart-btn');
    if (!addBtn) return;

    const qtyDec = card.querySelector<HTMLButtonElement>('.qty-dec');
    const qtyInc = card.querySelector<HTMLButtonElement>('.qty-inc');
    const qtyVal = card.querySelector<HTMLElement>('.qty-val');
    const slug = addBtn.dataset.slug ?? '';
    const maxStock = Math.max(1, parseInt(addBtn.dataset.stock ?? '99', 10) || 99);
    const cardCategory = card.dataset.categoryPath ?? '';
    let qty = 1;

    // Ceiling isn't just the product's total stock — it's what's left after
    // whatever quantity of this same product already sits in the cart (added
    // from here, the quick-view, or elsewhere), so repeated add-to-cart clicks
    // can't push the cart past real stock once every unit is already in it.
    function ceiling(): number {
      return Math.max(0, maxStock - getCartQty(storeSlug, slug));
    }

    function updateQty(n: number) {
      if (!addBtn) return;
      const cap = ceiling();
      qty = cap <= 0 ? 0 : Math.max(1, Math.min(n, cap));
      // Hide the "1" default — showing it on every idle card in the grid
      // reads as repetitive clutter; the number earns its place once the
      // buyer actually picks more than one.
      if (qtyVal) { qtyVal.textContent = String(qty); qtyVal.style.display = qty > 1 ? '' : 'none'; }
      if (qtyDec) qtyDec.disabled = qty <= 1;
      if (qtyInc) qtyInc.disabled = cap <= 0 || qty >= cap;
      addBtn.disabled = cap <= 0;
    }

    updateQty(1);
    window.addEventListener('cart:change', () => updateQty(Math.max(qty, 1)));

    qtyDec?.addEventListener('click', () => updateQty(qty - 1));
    qtyInc?.addEventListener('click', () => updateQty(qty + 1));

    const labelSpan = addBtn.querySelector<HTMLElement>('.btn-label');
    const originalIcon = labelSpan?.innerHTML ?? '';
    const originalAriaLabel = addBtn.getAttribute('aria-label') ?? '';

    addBtn.addEventListener('click', () => {
      if (addBtn.disabled) return;
      // Variant products (color/size/etc.) can't be added blind from the
      // card — there's no room for a picker here. Open the quick view
      // instead, where the picker + its own add-to-cart already live, so
      // choosing a variant is the very next thing the buyer does rather
      // than a dead-end error.
      if (card.dataset.variants) {
        openProductModal(card, true);
        return;
      }
      const { name = '', price = '0', image = '' } = addBtn.dataset;
      addItem(storeSlug, storeName, { slug, name, price: Number(price), image, stock: maxStock }, qty);
      trackAddToCart({ id: slug, name, price: Number(price), category: cardCategory }, qty);
      updateQty(1);

      if (labelSpan) labelSpan.innerHTML = cardCheckSvg;
      addBtn.setAttribute('aria-label', addBtn.dataset.labelAdded ?? originalAriaLabel);
      addBtn.disabled = true;
      addBtn.classList.add('btn--confirmed');
      spawnBurst(addBtn);

      addBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );

      setTimeout(() => {
        if (labelSpan) labelSpan.innerHTML = originalIcon;
        addBtn.setAttribute('aria-label', originalAriaLabel);
        addBtn.classList.remove('btn--confirmed');
        updateQty(1); // re-enables only if stock remains, not blindly
      }, 1400);
    });
  }

  document.querySelectorAll<HTMLElement>('.product-card').forEach(initProductCardCommerce);

  // ── Search + Sort ─────────────────────────────────────────────
  const searchInput = document.getElementById('product-search') as HTMLInputElement | null;
  const sortTrigger = document.getElementById('sort-trigger')   as HTMLButtonElement | null;
  const sortMenu    = document.getElementById('sort-menu')      as HTMLUListElement | null;
  const sortLabel   = document.getElementById('sort-label')     as HTMLSpanElement | null;
  const sortChevron = document.getElementById('sort-chevron')   as SVGElement | null;
  const productGrid = document.querySelector<HTMLElement>('.product-grid');
  const noResults   = document.getElementById('no-results');
  const loadMoreWrap = document.getElementById('load-more-wrap') as HTMLElement | null;
  const loadMoreBtn  = document.getElementById('load-more-btn')  as HTMLButtonElement | null;
  const loadMoreLabel = document.getElementById('load-more-label') as HTMLElement | null;

  let currentSort = 'default';
  let activeTag = '';
  // Server-paginated grid: this is how many cards are actually in the DOM right
  // now, not how many the store has in total — load-more/refetch keep it in sync.
  let loadedCount = productGrid?.children.length ?? 0;

  // ── Category filter — drill-down breadcrumb + chip row ─────────
  // Selecting a category re-renders the nav to show *its* children as the
  // next chip row (not a flat list of every category at once); the product
  // grid itself is what refreshFromServer() already refetches.
  interface StoreCategoryTreeNode { id: string; name: string; parentId: string | null; children: StoreCategoryTreeNode[] }
  let categoryTree: StoreCategoryTreeNode[] = [];
  try { categoryTree = JSON.parse(document.getElementById('store-category-tree-data')?.textContent ?? '[]') as StoreCategoryTreeNode[]; }
  catch { categoryTree = []; }

  function flattenTree(nodes: StoreCategoryTreeNode[]): StoreCategoryTreeNode[] {
    return nodes.flatMap((n) => [n, ...flattenTree(n.children)]);
  }
  const flatCategories = flattenTree(categoryTree);

  function categoryAncestorChain(categoryId: string): StoreCategoryTreeNode[] {
    const chain: StoreCategoryTreeNode[] = [];
    let current = flatCategories.find((c) => c.id === categoryId);
    while (current) {
      chain.unshift(current);
      current = current.parentId ? flatCategories.find((c) => c.id === current!.parentId) : undefined;
    }
    return chain;
  }

  function categoryPathFor(categoryId: string): string {
    return categoryAncestorChain(categoryId).map((c) => c.name).join(' › ');
  }

  const storeControls = document.querySelector<HTMLElement>('.store-controls');
  const categoryFilters = document.getElementById('category-filters') as HTMLElement | null;

  function renderCategoryNav(): void {
    if (!storeControls) return;
    const selected = activeTag ? flatCategories.find((c) => c.id === activeTag) ?? null : null;
    const chain = selected ? categoryAncestorChain(selected.id) : [];
    const children = selected ? selected.children : categoryTree;
    const i18n = getPMI18n();

    let breadcrumbEl = document.getElementById('category-breadcrumb');
    if (chain.length) {
      const breadcrumbHtml = `
          <button type="button" class="category-breadcrumb__crumb" data-category-id="">${escHtml(i18n?.filterAll ?? '')}</button>
          ${chain.map((c, i) => `
            <span class="category-breadcrumb__sep" aria-hidden="true">›</span>
            ${i === chain.length - 1
              ? `<span class="category-breadcrumb__current">${escHtml(c.name)}</span>`
              : `<button type="button" class="category-breadcrumb__crumb" data-category-id="${escHtml(c.id)}">${escHtml(c.name)}</button>`}
          `).join('')}
        `;
      if (!breadcrumbEl) {
        breadcrumbEl = document.createElement('nav');
        breadcrumbEl.id = 'category-breadcrumb';
        breadcrumbEl.className = 'category-breadcrumb';
        storeControls.insertBefore(breadcrumbEl, storeControls.firstElementChild?.nextSibling ?? null);
      }
      breadcrumbEl.setAttribute('aria-label', i18n?.filterByCategory ?? '');
      breadcrumbEl.innerHTML = breadcrumbHtml;
    } else {
      breadcrumbEl?.remove();
    }

    if (categoryFilters) {
      categoryFilters.hidden = children.length === 0 && !selected;
      categoryFilters.innerHTML = `
        ${!selected ? `<button type="button" class="category-chip" data-category-id="" aria-pressed="true">${escHtml(i18n?.filterAll ?? '')}</button>` : ''}
        ${children.map((c) => `<button type="button" class="category-chip" data-category-id="${escHtml(c.id)}" aria-pressed="false">${escHtml(c.name)}</button>`).join('')}
      `;
    }
  }

  storeControls?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-category-id]');
    if (!btn) return;
    activeTag = btn.dataset.categoryId ?? '';
    renderCategoryNav();
    refreshFromServer();
  });

  // ── Server-driven product cards (initial page + load more + refilter) ──
  // Card markup is duplicated here from the Astro template above by hand —
  // Astro has no client-side component reactivity, so this mirrors the same
  // pattern already used elsewhere on this site for dynamically-injected
  // rows (CartDrawer, WishlistDrawer, the quick-view modal body).
  function getI18nCart(): Record<string, string> {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}')?.cart ?? {}; }
    catch { return {}; }
  }

  function renderProductCardHTML(p: StoreProductDTO, isNew: boolean): string {
    const pi = getPMI18n();
    const ci = getI18nCart();
    const hasImages = !!(p.images && p.images.length);
    const firstImg = p.images?.[0] ? cdnSrc(p.images[0]) : '';

    const slidesHtml = hasImages
      ? p.images!.map((img) =>
          `<div class="product-card__slide"><img src="${escHtml(cdnSrc(img))}" alt="${escHtml(p.name)}" class="product-card__img" width="400" height="400" loading="lazy" /></div>`
        ).join('')
      : `<div class="product-card__slide"><div class="product-card__img-placeholder" aria-hidden="true"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div></div>`;

    const dotsHtml = hasImages && (p.images?.length ?? 0) > 1
      ? `<div class="product-card__dots" aria-hidden="true">${p.images!.map((_, i) => `<span class="product-card__dot${i === 0 ? ' is-active' : ''}"></span>`).join('')}</div>`
      : '';

    const stockHtml = p.stock <= 0
      ? `<span class="badge badge--muted">${escHtml(pi.outOfStock ?? '')}</span>`
      : `<div dir="ltr" class="product-card__qtycart flex items-center" style="width:100%;height:2.25rem;border:1px solid var(--color-border);border-radius:var(--radius);overflow:hidden">
          <button type="button" class="qty-dec flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label="${escHtml(ci.qtyDecrease ?? '')}" disabled>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <button type="button" class="product-card__add-btn add-to-cart-btn" data-slug="${escHtml(p.slug)}" data-name="${escHtml(p.name)}" data-price="${p.price}" data-image="${escHtml(firstImg)}" data-stock="${p.stock}" data-label-added="${escHtml(pi.addedToCart ?? '')}" aria-label="${escHtml(pi.addToCart ?? '')}">
            <span class="btn-label" aria-hidden="true">
              <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                <circle cx="17" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                <path d="M1 3h2.4l2.72 13.4a2 2 0 0 0 2 1.6h7.76a2 2 0 0 0 2-1.6L20.4 7H5.1"/>
                <path d="M5.2 11.9h13.9M10.3 7.8L9.6 17.2M15 7.8L14.3 17.2" stroke-width="1.1"/>
              </svg>
            </span>
            <span class="qty-val text-sm font-semibold select-none" style="display:none" aria-live="polite" aria-atomic="true">1</span>
          </button>
          <button type="button" class="qty-inc flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label="${escHtml(ci.qtyIncrease ?? '')}">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>`;

    return `<li class="product-card card"
        ${hasImages ? `data-images="${escHtml(JSON.stringify(p.images))}"` : ''}
        data-product-name="${escHtml(p.name)}"
        data-price="${p.price}"
        data-created-at="${escHtml(p.createdAt)}"
        data-slug="${escHtml(p.slug)}"
        data-description="${escHtml(p.description || '')}"
        data-stock="${p.stock}"
        data-category-id="${escHtml(p.categoryId ?? '')}"
        data-category-path="${escHtml(p.categoryId ? categoryPathFor(p.categoryId) : '')}"
        data-tags="${escHtml(p.tags?.length ? p.tags.join(',') : '')}"
        ${p.variants?.length ? `data-variants="${escHtml(JSON.stringify(p.variants))}"` : ''}
        ${p.variantStock ? `data-variant-stock="${escHtml(JSON.stringify(p.variantStock))}"` : ''}
        ${p.variantImages ? `data-variant-images="${escHtml(JSON.stringify(p.variantImages))}"` : ''}>
      <div class="product-card__img-wrap${hasImages ? ' product-card__img-wrap--clickable is-loading' : ''}" ${hasImages ? `role="button" aria-label="${escHtml(p.name)}" tabindex="0"` : ''}>
        <div class="product-card__slides">${slidesHtml}</div>
        ${isNew ? `<span class="badge badge--new">${escHtml(pi.badgeNew ?? '')}</span>` : ''}
        <button type="button" class="wishlist-btn" data-wishlist-slug="${escHtml(p.slug)}" data-wishlist-name="${escHtml(p.name)}" data-wishlist-price="${p.price}" data-wishlist-image="${escHtml(firstImg)}" data-wishlist-store-slug="${escHtml(storeSlug)}" data-wishlist-store-name="${escHtml(storeName)}" data-wishlist-stock="${p.stock}" data-wishlisted="false" aria-pressed="false" aria-label="${escHtml(pi.addToWishlist ?? '')}" style="position:absolute;top:0.45rem;inset-inline-end:0.45rem;z-index:2;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,0.9);color:var(--color-muted);transition:color 0.15s,background 0.15s,transform 0.15s">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        ${dotsHtml}
      </div>
      <div class="product-card__body">
        <a href="/store/${escHtml(storeSlug)}/${escHtml(p.slug)}" class="product-modal-trigger hover:text-[var(--color-accent)] transition-colors duration-150" style="color:inherit;text-decoration:none;display:block">
          <h3 class="product-card__name" dir="auto">${escHtml(p.name)}</h3>
        </a>
        <div class="product-card__footer" style="flex-direction:column;align-items:stretch;gap:0.4rem">
          <span class="product-card__price">${escHtml(formatPrice(p.price))}</span>
          ${stockHtml}
        </div>
      </div>
    </li>`;
  }

  function htmlToElement(html: string): HTMLElement {
    const template = document.createElement('template');
    template.innerHTML = html.trim();
    return template.content.firstElementChild as HTMLElement;
  }

  function initNewProductCards(cards: HTMLElement[]): void {
    cards.forEach((card) => {
      card.querySelectorAll<HTMLButtonElement>('.wishlist-btn').forEach(initWishlistBtn);
      initProductCardCommerce(card);
      initImageSkeleton(card);
      initCarouselDots(card);
      initCardClickToModal(card);
      card.querySelectorAll<HTMLElement>('.product-card__img-wrap--clickable').forEach(initImageClickToModal);
      card.querySelectorAll<HTMLAnchorElement>('.product-modal-trigger').forEach(initNameLinkToModal);
    });
  }

  function appendProductCards(newProducts: StoreProductDTO[], animate: boolean): HTMLElement[] {
    if (!productGrid) return [];
    const todayStr = new Date().toDateString();
    const cards = newProducts.map((p, i) => {
      const isNew = new Date(p.createdAt).toDateString() === todayStr;
      const card = htmlToElement(renderProductCardHTML(p, isNew));
      if (animate) {
        card.classList.add('product-card--entering');
        card.style.animationDelay = `${Math.min(i, 12) * 40}ms`;
        card.addEventListener('animationend', () => card.classList.remove('product-card--entering'), { once: true });
      }
      productGrid.appendChild(card);
      return card;
    });
    initNewProductCards(cards);
    loadedCount = productGrid.children.length;
    return cards;
  }

  function updateResultsState(hasMore: boolean): void {
    const hasAny = loadedCount > 0;
    if (productGrid) productGrid.hidden = !hasAny;
    if (noResults) noResults.hidden = hasAny;
    if (loadMoreWrap) loadMoreWrap.hidden = !hasMore;
    if (loadMoreBtn) loadMoreBtn.dataset.offset = String(loadedCount);
  }

  async function fetchProductsPage(offset: number): Promise<{ products: StoreProductDTO[]; hasMore: boolean }> {
    const params = new URLSearchParams({ store: storeSlug, offset: String(offset) });
    if (activeTag) params.set('category', activeTag);
    if (currentSort !== 'default') params.set('sort', currentSort);
    const q = searchInput?.value.trim() ?? '';
    if (q) params.set('q', q);
    try {
      const res = await fetch(`/api/store-products?${params.toString()}`);
      const data = await res.json() as { ok: boolean; products?: StoreProductDTO[]; hasMore?: boolean };
      if (!data.ok) return { products: [], hasMore: false };
      return { products: data.products ?? [], hasMore: !!data.hasMore };
    } catch {
      return { products: [], hasMore: false };
    }
  }

  // Guards against an older, slower request (e.g. rapid category clicks)
  // resolving after a newer one and clobbering the grid with stale results.
  let refreshToken = 0;

  async function refreshFromServer(): Promise<void> {
    syncUrl();
    const token = ++refreshToken;
    if (!productGrid) return;
    const { products: page, hasMore } = await fetchProductsPage(0);
    if (token !== refreshToken) return;
    productGrid.innerHTML = '';
    loadedCount = 0;
    appendProductCards(page, true);
    updateResultsState(hasMore);
  }

  loadMoreBtn?.addEventListener('click', async () => {
    const offset = Number(loadMoreBtn.dataset.offset ?? loadedCount);
    loadMoreBtn.disabled = true;
    const originalLabel = loadMoreLabel?.textContent ?? '';
    if (loadMoreLabel) {
      loadMoreLabel.innerHTML = `<span style="display:inline-flex;align-items:center;gap:0.5em">${escHtml(getPMI18n().loadingMore ?? '')}<span class="dot-pulse" role="status"><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span></span></span>`;
    }
    const { products: page, hasMore } = await fetchProductsPage(offset);
    appendProductCards(page, true);
    updateResultsState(hasMore);
    loadMoreBtn.disabled = false;
    if (loadMoreLabel) loadMoreLabel.textContent = originalLabel;
  });

  function syncUrl() {
    const params = new URLSearchParams();
    const q = searchInput?.value.trim() ?? '';
    if (q) params.set('q', q);
    if (activeTag) params.set('category', activeTag);
    if (currentSort !== 'default') params.set('sort', currentSort);
    const qs = params.toString();
    lastQueryString = qs ? `?${qs}` : '';
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  function openSort() {
    sortMenu?.removeAttribute('hidden');
    sortTrigger?.setAttribute('aria-expanded', 'true');
    if (sortChevron) (sortChevron as unknown as HTMLElement).style.transform = 'rotate(180deg)';
  }

  function closeSort() {
    sortMenu?.setAttribute('hidden', '');
    sortTrigger?.setAttribute('aria-expanded', 'false');
    if (sortChevron) (sortChevron as unknown as HTMLElement).style.transform = '';
  }

  const sortOptions = sortMenu
    ? Array.from(sortMenu.querySelectorAll<HTMLElement>('[role="option"]'))
    : [];

  function selectSortOption(opt: HTMLElement) {
    sortOptions.forEach(o => o.setAttribute('aria-selected', 'false'));
    opt.setAttribute('aria-selected', 'true');
    currentSort = opt.dataset.value ?? 'default';
    const label = opt.textContent?.trim() ?? '';
    if (sortLabel) sortLabel.textContent = label;
    if (sortTrigger) sortTrigger.setAttribute('aria-label', label);
    closeSort();
    sortTrigger?.focus();
    refreshFromServer();
  }

  sortTrigger?.addEventListener('click', () => {
    sortMenu?.hidden ? openSort() : closeSort();
  });

  sortTrigger?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (sortMenu?.hidden) openSort();
      const idx = e.key === 'ArrowDown' ? 0 : sortOptions.length - 1;
      sortOptions[idx]?.focus();
    }
  });

  sortOptions.forEach((opt, i) => {
    opt.setAttribute('tabindex', '-1');
    opt.addEventListener('click', () => selectSortOption(opt));
    opt.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSortOption(opt); }
      if (e.key === 'ArrowDown') { e.preventDefault(); sortOptions[(i + 1) % sortOptions.length]?.focus(); }
      if (e.key === 'ArrowUp')   { e.preventDefault(); sortOptions[(i - 1 + sortOptions.length) % sortOptions.length]?.focus(); }
      if (e.key === 'Home')      { e.preventDefault(); sortOptions[0]?.focus(); }
      if (e.key === 'End')       { e.preventDefault(); sortOptions[sortOptions.length - 1]?.focus(); }
      if (e.key === 'Tab')       { closeSort(); }
    });
  });

  document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('sort-dropdown');
    if (dropdown && !dropdown.contains(e.target as Node)) closeSort();
  });

  let searchDebounceTimer: ReturnType<typeof setTimeout> | undefined;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(refreshFromServer, 350);
  });

  // ── Init from URL params (q / sort / category) ────────────────
  {
    const urlParams   = new URLSearchParams(window.location.search);
    const initQ       = urlParams.get('q') ?? '';
    const initSortVal = urlParams.get('sort') ?? '';
    const initCat     = urlParams.get('category') ?? '';

    if (initQ && searchInput) searchInput.value = initQ;
    if (initQ) {
      const hInput = document.getElementById('header-search-input') as HTMLInputElement | null;
      if (hInput) hInput.value = initQ;
    }

    if (initSortVal) {
      const matchingOpt = sortOptions.find(o => o.dataset.value === initSortVal);
      if (matchingOpt) {
        sortOptions.forEach(o => o.setAttribute('aria-selected', 'false'));
        matchingOpt.setAttribute('aria-selected', 'true');
        currentSort = initSortVal;
        if (sortLabel) sortLabel.textContent = matchingOpt.textContent?.trim() ?? '';
      }
    }

    // The nav (breadcrumb + chip row) was already server-rendered matching
    // initCat exactly (see the Astro frontmatter above) — just sync the JS
    // state variable to match, no DOM rebuild needed for the initial paint.
    if (initCat && flatCategories.some((c) => c.id === initCat)) activeTag = initCat;

    // The grid's initial page was already server-rendered matching these exact
    // params (see the Astro frontmatter above) — no refetch needed here, just
    // catching load-more back up if the user had loaded further pages before
    // navigating away, then restoring scroll position once real content is there.
    // Fetched in parallel (not one-await-at-a-time) and capped — a session that
    // loaded hundreds of products before leaving shouldn't turn "back" into a
    // slow chain of round-trips; past the cap we just land wherever it ends.
    (async () => {
      const savedState = storeSlug ? peekStoreScrollState(storeSlug) : null;
      if (savedState && loadedCount < savedState.loadedCount) {
        const MAX_CATCHUP_PRODUCTS = 240;
        const target = Math.min(savedState.loadedCount, loadedCount + MAX_CATCHUP_PRODUCTS);
        const offsets: number[] = [];
        for (let o = loadedCount; o < target; o += PRODUCTS_PAGE_SIZE) offsets.push(o);
        const pages = await Promise.all(offsets.map((o) => fetchProductsPage(o)));
        for (const { products: page, hasMore } of pages) {
          if (!page.length) break;
          appendProductCards(page, false);
          updateResultsState(hasMore);
          if (!hasMore) break;
        }
      }
      if (storeSlug) restoreStoreScroll(storeSlug);
      document.documentElement.style.visibility = '';
    })();
  }

  // ── Skeleton: remove shimmer when image loads ─────────────────
  function initImageSkeleton(card: HTMLElement): void {
    card.querySelectorAll<HTMLImageElement>('.product-card__img').forEach((img) => {
      const wrap = img.closest<HTMLElement>('.product-card__img-wrap');
      if (!wrap) return;
      const done = () => wrap.classList.remove('is-loading');
      if (img.complete && img.naturalWidth > 0) {
        done();
      } else {
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.product-card').forEach(initImageSkeleton);

  // ── Lightbox (available for revert) ──────────────────────────
  const lightbox   = document.getElementById('lightbox') as HTMLDivElement | null;
  const lbImg      = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbPrev     = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
  const lbNext     = document.getElementById('lightbox-next') as HTMLButtonElement | null;
  const lbClose    = document.getElementById('lightbox-close') as HTMLButtonElement | null;
  const lbCounter  = document.getElementById('lightbox-counter') as HTMLDivElement | null;

  let lbImages: string[] = [];
  let lbProductName = '';
  let lbIndex = 0;
  let touchStartX = 0;
  let lbPrevFocus: HTMLElement | null = null;

  function getLightboxFocusable(): HTMLButtonElement[] {
    return [lbClose, lbPrev, lbNext].filter(
      (el): el is HTMLButtonElement => !!el && !el.hidden
    );
  }

  function openLightbox(images: string[], startIndex = 0) {
    lbImages = images;
    lbIndex = startIndex;
    lbPrevFocus = document.activeElement as HTMLElement;
    showLbImage();
    lightbox?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    lbClose?.focus();
  }

  function closeLightbox() {
    lightbox?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    lbImages = [];
    lbPrevFocus?.focus();
    lbPrevFocus = null;
  }

  function showLbImage() {
    const url = lbImages[lbIndex] ?? '';
    if (lbImg) { lbImg.src = url; lbImg.alt = lbProductName ? `${lbProductName} — ${lbIndex + 1}` : `Image ${lbIndex + 1}`; }
    const multi = lbImages.length > 1;
    if (lbPrev) lbPrev.hidden = !multi;
    if (lbNext) lbNext.hidden = !multi;
    if (lbCounter) {
      lbCounter.hidden = !multi;
      lbCounter.textContent = `${lbIndex + 1} / ${lbImages.length}`;
    }
  }

  function prevLbImage() { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; showLbImage(); }
  function nextLbImage() { lbIndex = (lbIndex + 1) % lbImages.length; showLbImage(); }

  lbClose?.addEventListener('click', closeLightbox);
  lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); prevLbImage(); });
  lbNext?.addEventListener('click', (e) => { e.stopPropagation(); nextLbImage(); });
  lightbox?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('.lightbox__arrow') && !t.closest('.lightbox__close')) closeLightbox();
  });

  lightbox?.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  lightbox?.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) dx < 0 ? nextLbImage() : prevLbImage();
  }, { passive: true });

  // ── Product Detail Modal ──────────────────────────────────────
  const productModal = document.getElementById('product-modal') as HTMLDivElement | null;
  const pmBackdrop   = document.getElementById('pm-backdrop')   as HTMLDivElement | null;
  const pmClose      = document.getElementById('pm-close')      as HTMLButtonElement | null;
  const pmBody       = document.getElementById('pm-body')       as HTMLDivElement | null;
  const pmFooter     = document.getElementById('pm-footer')     as HTMLDivElement | null;
  const pmPanel      = document.getElementById('pm-panel')      as HTMLDivElement | null;

  let pmPrevFocus: HTMLElement | null = null;
  let pmSavedTitle = '';

  function getPMI18n(): Record<string, string> {
    try { return JSON.parse(document.getElementById('pm-i18n')?.textContent ?? '{}') as Record<string, string>; }
    catch { return {}; }
  }

  function escHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ── Color variant resolution — shared with the main product page ──
  const resolveColor = resolveVariantColor;
  const isColorVariantName = isColorVariant;

  function fmtPrice(price: number): string {
    return new Intl.NumberFormat('he-IL', { style: 'currency', currency: 'ILS', minimumFractionDigits: 0 }).format(price);
  }

  function getPMFocusable(): HTMLElement[] {
    return Array.from(
      pmPanel?.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),input,[tabindex="0"]') ?? []
    ).filter(el => el.offsetParent !== null);
  }

  function openProductModal(card: HTMLElement, flagMissingOnOpen = false) {
    const images: string[] = card.dataset.images ? (JSON.parse(card.dataset.images) as string[]) : [];
    const name        = card.dataset.productName ?? '';
    const price       = Number(card.dataset.price ?? 0);
    const description = card.dataset.description ?? '';
    const stock       = Number(card.dataset.stock ?? 0);
    const slug        = card.dataset.slug ?? '';
    const category    = card.dataset.categoryPath ?? '';
    const pmVariants: Array<{ name: string; options: string[] }> = card.dataset.variants
      ? (JSON.parse(card.dataset.variants) as Array<{ name: string; options: string[] }>)
      : [];
    const pmVariantStock: Record<string, number> = card.dataset.variantStock
      ? (JSON.parse(card.dataset.variantStock) as Record<string, number>)
      : {};
    const pmVariantImages: Record<string, string> = card.dataset.variantImages
      ? (JSON.parse(card.dataset.variantImages) as Record<string, string>)
      : {};
    // No dimension pre-selected — buyer must actively choose before add-to-cart
    // proceeds (see pmFlagMissingVariants below) — except a single-option
    // dimension, which has no real choice to make.
    const pmSelectedVariants: Record<string, string> = {};
    pmVariants.forEach((v) => { if (v.options.length === 1) pmSelectedVariants[v.name] = v.options[0]; });

    // The combo's real stock — a per-combo variantStock override if the seller
    // set one, else the product's shared stock pool. Plain `stock` alone is
    // wrong here: a combo can have its own (lower or higher) override.
    function pmEffectiveStock(selection: Record<string, string>): number {
      if (!pmVariants.length || !Object.keys(pmVariantStock).length) return stock;
      const key = comboKey(selection);
      return key in pmVariantStock ? pmVariantStock[key]! : stock;
    }

    // What's actually still addable for this combo — nets out whatever qty of
    // this exact combo already sits in the cart (see pmCeiling below, which
    // is the same computation scoped to the currently-selected combo only).
    function pmRemainingFor(selection: Record<string, string>): number {
      const copy = Object.keys(selection).length ? selection : undefined;
      return Math.max(0, pmEffectiveStock(selection) - getCartQty(storeSlug, slug, copy));
    }

    // Disables (rather than hides) any option whose combo — combined with the
    // buyer's current picks for every other dimension — is out of stock, same
    // pattern as the full product page's updateVariantAvailability().
    function pmUpdateVariantAvailability(): void {
      pmBody?.querySelectorAll<HTMLButtonElement>('.pm-variant-opt').forEach((b) => {
        const bName = b.dataset.pvName ?? '';
        const bValue = b.dataset.pvValue ?? '';
        const available = pmRemainingFor({ ...pmSelectedVariants, [bName]: bValue }) > 0;
        b.disabled = !available;
        b.setAttribute('aria-disabled', String(!available));
        b.style.opacity = available ? '1' : '0.4';
        b.style.cursor = available ? 'pointer' : 'not-allowed';
        b.style.textDecoration = available ? 'none' : 'line-through';
      });
    }
    const i18n        = getPMI18n();
    const mainImgUrl  = images[0] ?? '';
    const hasImages   = images.length > 0;
    const hasMultiple = images.length > 1;
    const wishlisted  = isWishlisted(slug);
    const heartPath   = `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`;

    pmPrevFocus  = document.activeElement as HTMLElement;
    pmSavedTitle = document.title;

    history.pushState({ productModal: true, slug }, '', `/store/${storeSlug}/${slug}`);
    document.title = `${name} — ${storeName}`;

    const noImgSvg =`<svg style="color:var(--color-border)" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`;

    const mainImgHtml = hasImages
      ? `<div id="pm-img-wrap" style="position:relative;padding-top:62%;background:var(--color-surface);border-bottom:1px solid var(--color-border)">
           <div class="pm-slides" id="pm-slides" role="button" tabindex="0" style="cursor:zoom-in">
             ${images.map((img) => `<div class="pm-slide is-loading"><img data-src="${escHtml(img)}" alt="${escHtml(name)}" width="680" height="421" class="pm-main-img" decoding="async" /></div>`).join('')}
           </div>
           ${hasMultiple ? `<div class="pm-dots" aria-hidden="true">${images.map((_, i) => `<span class="pm-dot" style="width:${i === 0 ? 18 : 6}px;background:${i === 0 ? '#fff' : 'rgba(255,255,255,0.7)'}"></span>`).join('')}</div>` : ''}
         </div>`
      : `<div style="padding-top:62%;background:var(--color-surface);position:relative">
           <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center">${noImgSvg}</div>
         </div>`;

    const cartSection = stock > 0
      ? `<div>
          <p id="pm-stock-note" class="flex items-center gap-1.5 text-sm" style="margin:0 0 0.6rem">
            <span id="pm-stock-dot" aria-hidden="true" style="width:7px;height:7px;border-radius:50%;background:var(--color-success);flex-shrink:0;display:inline-block"></span>
            <svg id="pm-stock-warn" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="display:none">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span id="pm-stock-text"></span>
          </p>
          <div style="display:flex;gap:0.75rem;align-items:center;margin-bottom:0.6rem">
            <div dir="ltr" style="display:flex;align-items:center;border:1px solid var(--color-border);border-radius:var(--radius);overflow:hidden;flex-shrink:0">
              <button type="button" class="pm-qty-dec" disabled aria-label="הפחת"
                      style="width:2rem;height:2.25rem;display:flex;align-items:center;justify-content:center;background:none;border:none;cursor:pointer;color:var(--color-muted);transition:background 0.1s">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <span class="pm-qty-val" aria-live="polite"
                    style="min-width:2rem;text-align:center;font-weight:600;font-size:0.875rem;color:var(--color-text)">1</span>
              <button type="button" class="pm-qty-inc" aria-label="הוסף"
                      style="width:2rem;height:2.25rem;display:flex;align-items:center;justify-content:center;background:none;border:none;cursor:pointer;color:var(--color-muted);transition:background 0.1s">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
            <button type="button" class="btn pm-add-to-cart"
                    data-slug="${escHtml(slug)}" data-name="${escHtml(name)}" data-price="${price}" data-image="${escHtml(mainImgUrl)}" data-stock="${stock}"
                    style="flex:1;height:2.25rem;display:flex;align-items:center;justify-content:center;gap:4px">
              <span class="pm-btn-label">${i18n.addToCart ?? 'הוסף לעגלה'}</span>
            </button>
            <a href="/checkout" class="pm-to-checkout btn btn--accent btn--sm"
               style="display:none;height:2.25rem;white-space:nowrap;align-items:center;gap:0.3rem">
              ${i18n.toCheckout ?? 'לתשלום'}
            </a>
          </div>
          <button type="button" class="pm-wishlist-btn"
                  style="display:flex;align-items:center;justify-content:center;gap:0.4rem;width:100%;background:none;border:1px solid var(--color-border);border-radius:var(--radius);padding:0.4rem 0.85rem;cursor:pointer;font-size:0.8rem;color:${wishlisted ? '#e53e3e' : 'var(--color-muted)'};transition:all 0.15s">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="${wishlisted ? '#e53e3e' : 'none'}" stroke="${wishlisted ? '#e53e3e' : 'currentColor'}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${heartPath}</svg>
            <span class="pm-wish-label">${wishlisted ? (i18n.removeFromWishlist ?? 'הסר') : (i18n.addToWishlist ?? 'הוסף לרשימת משאלות')}</span>
          </button>
        </div>`
      : `<span class="badge badge--muted">${i18n.outOfStock ?? 'אזל מהמלאי'}</span>`;

    const descHtml = description
      ? `<p dir="auto" class="pm-desc" id="pm-desc">${escHtml(description)}</p>`
      : '';

    if (pmBody) {
      pmBody.innerHTML = `
        ${mainImgHtml}
        <div style="padding:0.875rem 1.25rem 1.25rem;display:flex;flex-direction:column;gap:0.5rem">
          <div style="padding-inline-end:1.75rem">
            <h2 id="pm-name" dir="auto" style="font-size:1.2rem;font-weight:700;color:var(--color-text);margin:0 0 0.4rem;line-height:1.35">${escHtml(name)}</h2>
            <p style="font-size:1.45rem;font-weight:700;color:var(--color-accent);margin:0">${fmtPrice(price)}</p>
          </div>
          ${descHtml}
          ${pmVariants.length ? `<div class="pm-variants" style="display:flex;flex-direction:column;gap:0.75rem">
            ${pmVariants.map(v => {
              const isCv = isColorVariantName(v.name);
              const isSingleOption = v.options.length === 1;
              return `<div class="variant-group" data-variant-group="${escHtml(v.name)}">
                <p style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-muted);margin:0 0 0.4rem">${escHtml(v.name)}</p>
                <div style="display:flex;flex-wrap:wrap;gap:0.4rem" role="group" aria-label="${escHtml(v.name)}">
                  ${v.options.map((opt) => {
                    const { display, hex } = resolveColor(opt);
                    const swatch = isCv && hex
                      ? `<span aria-hidden="true" style="width:11px;height:11px;border-radius:3px;background:${hex};border:1px solid rgba(0,0,0,0.12);flex-shrink:0;display:inline-block"></span>`
                      : '';
                    const activeBorder = hex ?? 'var(--color-primary)';
                    const activeBg = hex ? hex + '18' : 'transparent';
                    return `<button type="button" class="pm-variant-opt"
                            data-pv-name="${escHtml(v.name)}" data-pv-value="${escHtml(opt)}"
                            data-pv-hex="${escHtml(hex ?? '')}"
                            aria-pressed="${isSingleOption}"
                            style="display:inline-flex;align-items:center;gap:0.3rem;border:1.5px solid ${isSingleOption ? activeBorder : 'var(--color-border)'};border-radius:var(--radius);padding:${isCv && hex ? '0.26rem 0.6rem' : '0.26rem 0.7rem'};font-size:0.8rem;font-weight:${isSingleOption ? 600 : 500};cursor:pointer;background:${isSingleOption ? activeBg : 'none'};color:var(--color-text);transition:all 0.15s;white-space:nowrap">
                      ${swatch}${escHtml(display)}
                    </button>`;
                  }).join('')}
                </div>
              </div>`;
            }).join('')}
          </div>` : ''}
        </div>`;
    }

    if (pmFooter) {
      pmFooter.innerHTML = `
        ${cartSection}
        <a href="/store/${escHtml(storeSlug)}/${escHtml(slug)}"
           style="font-size:0.75rem;color:var(--color-muted);text-decoration:none;text-align:center;display:block;padding-top:0.5rem">
          ${i18n.fullPage ?? 'לדף המוצר המלא'}
        </a>`;
    }

    productModal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';

    pmPanel?.animate(
      [{ opacity: 0, transform: 'scale(0.95) translateY(12px)' }, { opacity: 1, transform: 'scale(1) translateY(0)' }],
      { duration: 240, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)', fill: 'forwards' }
    );

    pmClose?.focus();

    // Missing-selection feedback (subtle shake + ring) — mirrors the standalone
    // product page's flagMissingVariants, scoped to this modal's own DOM.
    function pmFlagMissingVariants(): boolean {
      // A `let` reassigned inside a forEach closure then read with a type
      // guard right after the loop is a known TS control-flow limitation —
      // narrows to `never` at the read site regardless of `if`/`?.` form.
      // Building the list functionally instead sidesteps it entirely.
      const groups = pmVariants
        .filter((v) => !pmSelectedVariants[v.name])
        .map((v) => pmBody?.querySelector<HTMLElement>(`.variant-group[data-variant-group="${CSS.escape(v.name)}"]`))
        .filter((g): g is HTMLElement => !!g);
      groups.forEach((group) => {
        group.classList.remove('variant-group--invalid');
        void group.offsetWidth;
        group.classList.add('variant-group--invalid');
        setTimeout(() => group.classList.remove('variant-group--invalid'), 650);
      });
      groups[0]?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return groups.length > 0;
    }

    // Opened because the buyer tried to add-to-cart from the card itself
    // (no picker there to fail against) — surface the same "pick this"
    // nudge they'd have gotten from the modal's own add-to-cart, so the
    // redirect doesn't feel like a dead end. Delayed past the open
    // animation (240ms) so the shake reads as its own distinct cue.
    if (flagMissingOnOpen && pmVariants.length) {
      setTimeout(() => pmFlagMissingVariants(), 260);
    }

    // Set once the slides carousel is wired up below (only exists with >1
    // image) — a color chip's own linked photo (see pmVariantImages) calls
    // this the same way clicking a dot would, so `let` + late assignment
    // instead of a hoisted `function`, since it depends on that carousel's
    // own closures (isRtl/getSlideW) rather than just this modal's data.
    let pmGoToImage: ((idx: number) => void) | null = null;

    // ── Modal variant selector ─────────────────────────────────────
    pmBody?.querySelectorAll<HTMLButtonElement>('.pm-variant-opt').forEach((btn) => {
      btn.addEventListener('click', () => {
        const vName = btn.dataset.pvName ?? '';
        const vValue = btn.dataset.pvValue ?? '';
        pmSelectedVariants[vName] = vValue;
        updatePmQty(1); // this combo may already have a different amount in the cart
        pmUpdateVariantAvailability(); // picking this dimension may sell out/free up options in the others
        pmBody?.querySelector<HTMLElement>(`.variant-group[data-variant-group="${CSS.escape(vName)}"]`)?.classList.remove('variant-group--invalid');
        pmBody?.querySelectorAll<HTMLButtonElement>(`.pm-variant-opt[data-pv-name="${CSS.escape(vName)}"]`).forEach((b) => {
          const active = b === btn;
          const hex = b.dataset.pvHex || null;
          b.setAttribute('aria-pressed', String(active));
          b.style.borderColor = active ? (hex ?? 'var(--color-primary)') : 'var(--color-border)';
          b.style.background = active ? (hex ? hex + '18' : 'transparent') : 'none';
          b.style.color = 'var(--color-text)';
          b.style.fontWeight = active ? '600' : '500';
        });
        if (isColorVariantName(vName)) {
          const url = pmVariantImages[vValue];
          const idx = url ? images.indexOf(url) : -1;
          if (idx !== -1) pmGoToImage?.(idx);
        }
      });
    });

    // Track current image index (for lightbox)
    let pmCurrentIdx = 0;

    // Skeleton: main slide images (data-src + decode, shimmer removed once loaded)
    const pmSlidesEl = document.getElementById('pm-slides');
    const pmSlideEls = pmSlidesEl ? Array.from(pmSlidesEl.querySelectorAll<HTMLElement>('.pm-slide')) : [];
    pmSlideEls.forEach((slide) => {
      const img = slide.querySelector<HTMLImageElement>('img[data-src]');
      if (img && img.dataset.src) {
        img.src = img.dataset.src;
        img.decode().then(() => slide.classList.remove('is-loading')).catch(() => slide.classList.remove('is-loading'));
      }
    });

    const pmDotsEl = pmBody?.querySelector<HTMLElement>('.pm-dots') ?? null;
    const pmDots   = pmDotsEl ? Array.from(pmDotsEl.querySelectorAll<HTMLElement>('.pm-dot')) : [];

    if (pmSlidesEl && pmSlideEls.length > 1) {
      const isRtl = getComputedStyle(pmSlidesEl).direction === 'rtl';
      const getSlideW = () => pmSlidesEl.offsetWidth || 1;

      const setPmActive = (idx: number) => {
        pmCurrentIdx = idx;
        pmDots.forEach((d, i) => {
          d.style.transition = 'width 220ms cubic-bezier(0.34,1.56,0.64,1)';
          d.style.width = `${i === idx ? ACTIVE_W : BASE_W}px`;
          d.style.background = i === idx ? '#fff' : 'rgba(255,255,255,0.7)';
        });
      };

      const scrollPmToIdx = (idx: number) => {
        pmSlidesEl.scrollTo({ left: (isRtl ? -1 : 1) * idx * getSlideW(), behavior: 'smooth' });
        setPmActive(idx);
      };
      pmGoToImage = scrollPmToIdx;

      let pmSnapTimer: ReturnType<typeof setTimeout> | undefined;
      pmSlidesEl.addEventListener('scroll', () => {
        clearTimeout(pmSnapTimer);
        pmSnapTimer = setTimeout(() => {
          const idx = Math.min(Math.round(Math.abs(pmSlidesEl.scrollLeft) / getSlideW()), pmSlideEls.length - 1);
          setPmActive(idx);
        }, 80);
      }, { passive: true });

      pmDots.forEach((dot, i) => dot.addEventListener('click', () => scrollPmToIdx(i)));

      // Touch — one slide at a time, no momentum skip
      let pmTStartX = 0, pmTStartScroll = 0;
      pmSlidesEl.addEventListener('touchstart', (e: TouchEvent) => {
        pmTStartX = e.touches[0].clientX;
        pmTStartScroll = pmSlidesEl.scrollLeft;
        pmSlidesEl.style.scrollSnapType = 'none';
      }, { passive: true });
      pmSlidesEl.addEventListener('touchend', (e: TouchEvent) => {
        const slideW = getSlideW();
        const dx = e.changedTouches[0].clientX - pmTStartX;
        const cur = Math.round(Math.abs(pmTStartScroll) / slideW);
        let tgt = cur;
        if (dx < -(slideW * 0.08)) tgt = Math.min(cur + 1, pmSlideEls.length - 1);
        if (dx >  (slideW * 0.08)) tgt = Math.max(cur - 1, 0);
        const left = (isRtl ? -1 : 1) * tgt * slideW;
        pmSlidesEl.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          pmSlidesEl.style.overflow = '';
          pmSlidesEl.scrollLeft = left;
          pmSlidesEl.style.scrollSnapType = '';
          setPmActive(tgt);
        });
      }, { passive: true });
    }

    // Main image click → lightbox
    pmSlidesEl?.addEventListener('click', () => {
      if (!images.length) return;
      lbProductName = name;
      openLightbox(images, pmCurrentIdx);
    });
    pmSlidesEl?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); (pmSlidesEl as HTMLElement).click(); }
    });

    const pmDescEl = pmBody?.querySelector<HTMLElement>('#pm-desc') ?? null;
    if (pmDescEl) {
      initReadMore(pmDescEl, 2, {
        more: i18n.showMore ?? 'עוד',
        less: i18n.showLess ?? 'פחות',
      });
    }

    // Qty stepper
    const pmQtyDec = pmFooter?.querySelector<HTMLButtonElement>('.pm-qty-dec');
    const pmQtyInc = pmFooter?.querySelector<HTMLButtonElement>('.pm-qty-inc');
    const pmQtyVal = pmFooter?.querySelector<HTMLElement>('.pm-qty-val');
    let pmQty = 1;

    // Ceiling accounts for whatever quantity of this exact combo is already
    // in the cart (added here, from the product grid, or elsewhere) — not
    // just the combo's raw stock — so repeated add-to-cart clicks can't push
    // the cart past real stock once every unit is already in it. Uses the
    // selected combo's own stock (pmEffectiveStock), not the product's flat
    // `stock` — a variant product can have a much higher/lower combo-specific
    // number than the shared pool.
    function pmCeiling(): number {
      return pmRemainingFor(pmSelectedVariants);
    }

    // Same dot/warning-triangle treatment as the full product page's
    // stock-status-note: green dot when comfortably in stock, amber "only N
    // left" once low, red "out of stock" once the cap hits zero.
    function pmUpdateStockNote(cap: number): void {
      const note = pmFooter?.querySelector<HTMLElement>('#pm-stock-note');
      const dot  = pmFooter?.querySelector<HTMLElement>('#pm-stock-dot');
      const warn = pmFooter?.querySelector<HTMLElement>('#pm-stock-warn');
      const text = pmFooter?.querySelector<HTMLElement>('#pm-stock-text');
      if (!note || !dot || !warn || !text) return;
      const outOfStock = cap <= 0;
      const isLow = !outOfStock && cap <= 5;
      note.style.fontWeight = outOfStock || isLow ? '600' : '500';
      dot.style.display = outOfStock || isLow ? 'none' : 'inline-block';
      warn.style.display = outOfStock || isLow ? 'block' : 'none';
      if (outOfStock) {
        note.style.color = 'var(--color-danger)';
        text.textContent = i18n.outOfStock ?? 'אזל מהמלאי';
      } else if (isLow) {
        note.style.color = 'var(--color-warning)';
        text.textContent = document.documentElement.lang === 'he' ? `נותרו ${cap} בלבד` : `Only ${cap} left`;
      } else {
        note.style.color = 'var(--color-muted)';
        text.textContent = i18n.inStockLabel ?? 'במלאי';
      }
    }

    function updatePmQty(n: number) {
      const cap = pmCeiling();
      pmQty = cap <= 0 ? 0 : Math.max(1, Math.min(n, cap));
      if (pmQtyVal) pmQtyVal.textContent = String(pmQty);
      if (pmQtyDec) pmQtyDec.disabled = pmQty <= 1;
      if (pmQtyInc) pmQtyInc.disabled = cap <= 0 || pmQty >= cap;
      if (pmAddBtn) pmAddBtn.disabled = cap <= 0;
      pmUpdateStockNote(cap);
    }
    pmQtyDec?.addEventListener('click', () => updatePmQty(pmQty - 1));
    pmQtyInc?.addEventListener('click', () => updatePmQty(pmQty + 1));

    // Add to cart
    const pmAddBtn  = pmFooter?.querySelector<HTMLButtonElement>('.pm-add-to-cart');
    const pmBtnLbl  = pmFooter?.querySelector<HTMLElement>('.pm-btn-label');
    const origLabel = pmBtnLbl?.textContent ?? '';
    if (pmBtnLbl) pmBtnLbl.style.cssText = 'display:inline-flex;align-items:center;gap:4px';

    pmAddBtn?.addEventListener('pointerdown', (e) => spawnRipple(pmAddBtn, e.clientX, e.clientY));
    const pmToCheckout = pmFooter?.querySelector<HTMLAnchorElement>('.pm-to-checkout');
    updatePmQty(1); // reflect already-in-cart state as soon as the modal opens
    pmUpdateVariantAvailability();

    pmAddBtn?.addEventListener('click', () => {
      if (pmAddBtn.disabled) return;
      if (pmVariants.length && pmFlagMissingVariants()) return;
      const pmVariantsCopy = Object.keys(pmSelectedVariants).length ? { ...pmSelectedVariants } : undefined;
      addItem(storeSlug, storeName, { slug, name, price, image: mainImgUrl, stock: pmEffectiveStock(pmSelectedVariants) }, pmQty, pmVariantsCopy, false);
      trackAddToCart({ id: slug, name, price, category }, pmQty);
      updatePmQty(1);
      pmAddBtn.disabled = true;
      pmAddBtn.classList.add('btn--confirmed');
      if (pmBtnLbl) pmBtnLbl.innerHTML = `${checkSvg}${i18n.addedToCart ?? 'נוסף!'}`;
      if (pmToCheckout) pmToCheckout.style.display = 'inline-flex';
      pmAddBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );
      setTimeout(() => {
        if (pmBtnLbl) pmBtnLbl.textContent = origLabel;
        pmAddBtn.classList.remove('btn--confirmed');
        updatePmQty(1); // re-enables only if stock remains, not blindly
      }, 1400);
    });

    // Wishlist
    const pmWishBtn  = pmFooter?.querySelector<HTMLButtonElement>('.pm-wishlist-btn');
    const pmWishLbl  = pmFooter?.querySelector<HTMLElement>('.pm-wish-label');
    pmWishBtn?.addEventListener('click', () => {
      const nowActive = toggleWishlist({ slug, name, price, image: mainImgUrl ? cdnSrc(mainImgUrl) : '', storeSlug, storeName, stock });
      const svg = pmWishBtn.querySelector<SVGElement>('svg');
      if (svg) { svg.style.fill = nowActive ? '#e53e3e' : 'none'; svg.style.stroke = nowActive ? '#e53e3e' : 'currentColor'; }
      pmWishBtn.style.color = nowActive ? '#e53e3e' : 'var(--color-muted)';
      if (pmWishLbl) pmWishLbl.textContent = nowActive ? (i18n.removeFromWishlist ?? 'הסר') : (i18n.addToWishlist ?? 'הוסף');
      fetch('/api/wishlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: nowActive ? 'add' : 'remove', productSlug: slug }),
      });
    });
  }

  function closeProductModal(updateHistory = true) {
    productModal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    if (pmBody) pmBody.innerHTML = '';
    if (pmFooter) pmFooter.innerHTML = '';
    if (pmSavedTitle) { document.title = pmSavedTitle; pmSavedTitle = ''; }
    pmPrevFocus?.focus();
    pmPrevFocus = null;
    if (updateHistory) history.back();
  }

  pmClose?.addEventListener('click', () => closeProductModal());
  pmBackdrop?.addEventListener('click', () => closeProductModal());

  // Browser back button while modal is open → close modal UI (history already moving back)
  window.addEventListener('popstate', () => {
    if (productModal?.hidden === false) closeProductModal(false);
  });

  // ── Carousel dots ─────────────────────────────────────────────
  const BASE_W = 6, ACTIVE_W = 18;

  function initCarouselDots(card: HTMLElement): void {
    const slides = card.querySelector<HTMLElement>('.product-card__slides');
    const dotsEl = card.querySelector<HTMLElement>('.product-card__dots');
    if (!slides || !dotsEl) return;

    const dots = Array.from(dotsEl.querySelectorAll<HTMLElement>('.product-card__dot'));
    if (dots.length < 2) return;

    dotsEl.addEventListener('click', (e) => e.stopPropagation());

    // Cache slide width — read once, never in scroll handler
    let slideW = slides.offsetWidth || 1;
    new ResizeObserver(() => { slideW = slides.offsetWidth || 1; }).observe(slides);

    // Cache direction — doesn't change at runtime
    const isRtl = getComputedStyle(slides).direction === 'rtl';

    let rafId: number | undefined;
    let snapTimer: ReturnType<typeof setTimeout> | undefined;

    function setDots(widths: number[], transition: boolean) {
      const tr = transition ? 'width 220ms cubic-bezier(0.34,1.56,0.64,1)' : 'none';
      dots.forEach((d, i) => {
        d.style.transition = tr;
        d.style.width = `${widths[i]}px`;
        d.style.background = widths[i] > BASE_W ? '#fff' : 'rgba(255,255,255,0.7)';
      });
    }

    slides.addEventListener('scroll', () => {
      clearTimeout(snapTimer);
      if (rafId !== undefined) cancelAnimationFrame(rafId);

      rafId = requestAnimationFrame(() => {
        rafId = undefined;
        const frac = Math.abs(slides.scrollLeft) / slideW;
        const src  = Math.min(Math.floor(frac), dots.length - 1);
        const tgt  = Math.min(src + 1, dots.length - 1);
        const t    = frac - Math.floor(frac);
        const w    = dots.map((_, i) => {
          if (src === tgt) return i === src ? ACTIVE_W : BASE_W;
          if (i === src)   return ACTIVE_W - (ACTIVE_W - BASE_W) * t;
          if (i === tgt)   return BASE_W   + (ACTIVE_W - BASE_W) * t;
          return BASE_W;
        });
        setDots(w, false);
      });

      snapTimer = setTimeout(() => {
        const idx = Math.min(Math.round(Math.abs(slides.scrollLeft) / slideW), dots.length - 1);
        setDots(dots.map((_, i) => i === idx ? ACTIVE_W : BASE_W), true);
      }, 80);
    }, { passive: true });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        slides.scrollTo({ left: (isRtl ? -1 : 1) * i * slideW, behavior: 'smooth' });
      });
    });

    // Touch — one slide at a time, no momentum skip
    let tStartX = 0, tStartScroll = 0;

    slides.addEventListener('touchstart', (e) => {
      tStartX = e.touches[0].clientX;
      tStartScroll = slides.scrollLeft;
      slides.style.scrollSnapType = 'none';
    }, { passive: true });

    slides.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - tStartX;
      const cur = Math.round(Math.abs(tStartScroll) / slideW);
      let tgt = cur;
      if (dx < -(slideW * 0.08)) tgt = Math.min(cur + 1, dots.length - 1);
      if (dx >  (slideW * 0.08)) tgt = Math.max(cur - 1, 0);
      const left = (isRtl ? -1 : 1) * tgt * slideW;
      slides.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        slides.style.overflow = '';
        slides.scrollLeft = left;
        slides.style.scrollSnapType = '';
      });
    }, { passive: true });
  }

  document.querySelectorAll<HTMLElement>('.product-card').forEach(initCarouselDots);

  // Anywhere else on the card → product modal too. Buttons/links each have
  // their own handler (qty stepper, wishlist heart, add-to-cart, the name
  // link, the image) so this only needs to skip those — everything else
  // (padding, gaps between elements, the price line) should still open it,
  // including out-of-stock cards that have no add-to-cart button at all.
  function initCardClickToModal(card: HTMLElement): void {
    card.addEventListener('click', (e) => {
      // Not e.target.closest(...) — a button's own click handler can mutate
      // its innerHTML (e.g. the add-to-cart icon swapping to a checkmark)
      // before this bubbles up here, detaching e.target from the tree and
      // breaking closest()'s walk to its ancestor button. composedPath() is
      // captured at dispatch time, so it's immune to that.
      const path = e.composedPath() as HTMLElement[];
      if (path.some((el) => el.tagName === 'BUTTON' || el.tagName === 'A' || el.getAttribute?.('role') === 'button')) return;
      openProductModal(card);
    });
  }

  document.querySelectorAll<HTMLElement>('.product-card').forEach(initCardClickToModal);

  // Image click → product modal (replaces lightbox)
  function initImageClickToModal(wrap: HTMLElement): void {
    const slides = wrap.querySelector<HTMLElement>('.product-card__slides');
    let scrollAtPress = 0;

    if (slides) {
      slides.addEventListener('pointerdown', () => {
        scrollAtPress = Math.abs(slides.scrollLeft);
      }, { passive: true });
    }

    wrap.addEventListener('click', () => {
      if (slides && Math.abs(Math.abs(slides.scrollLeft) - scrollAtPress) > 3) return;
      const card = wrap.closest<HTMLElement>('.product-card');
      if (card) openProductModal(card);
    });
    wrap.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        (e.currentTarget as HTMLElement).click();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.product-card__img-wrap--clickable').forEach(initImageClickToModal);

  // Name link click → product modal (prevents navigation)
  function initNameLinkToModal(link: HTMLAnchorElement): void {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const card = link.closest<HTMLElement>('.product-card');
      if (card) openProductModal(card);
    });
  }

  document.querySelectorAll<HTMLAnchorElement>('.product-modal-trigger').forEach(initNameLinkToModal);

  // ── Global keyboard handlers ──────────────────────────────────
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      if (productModal?.hidden === false) { closeProductModal(); return; }
      if (lightbox?.hidden === false)     { closeLightbox(); return; }
      if (sortMenu && !sortMenu.hidden)   { closeSort(); sortTrigger?.focus(); }
    }

    // Lightbox arrow keys
    if (lightbox?.hidden === false) {
      if (e.key === 'ArrowLeft')  { prevLbImage(); return; }
      if (e.key === 'ArrowRight') { nextLbImage(); return; }
    }

    // Focus traps
    if (e.key === 'Tab') {
      if (lightbox?.hidden === false) {
        const focusable = getLightboxFocusable();
        if (!focusable.length) return;
        const first = focusable[0]!;
        const last  = focusable[focusable.length - 1]!;
        if (e.shiftKey) {
          if (document.activeElement === first) { e.preventDefault(); last.focus(); }
        } else {
          if (document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      }
      if (productModal?.hidden === false) {
        const focusable = getPMFocusable();
        if (!focusable.length) return;
        const first = focusable[0]!;
        const last  = focusable[focusable.length - 1]!;
        if (e.shiftKey) {
          if (document.activeElement === first) { e.preventDefault(); last.focus(); }
        } else {
          if (document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      }
    }
  });

  // ── Login hint tooltip (for non-logged-in contact/ask buttons) ──
  function showLoginHint(btn: HTMLElement) {
    const existing = btn.parentElement?.querySelector('.login-hint-popup');
    if (existing) { existing.remove(); return; }
    const loginUrl = btn.dataset.loginUrl ?? '/seller/login';
    const hint = document.createElement('div');
    hint.className = 'login-hint-popup';
    hint.setAttribute('role', 'status');
    hint.innerHTML = `<span>כדי לשלוח הודעה יש <a href="${loginUrl}" style="color:var(--color-accent);font-weight:600;text-decoration:underline">להתחבר</a></span>`;
    hint.style.cssText = 'position:absolute;top:calc(100% + 0.4rem);inset-inline-start:0;z-index:50;background:var(--color-surface);border:1px solid var(--color-border);border-radius:0.55rem;padding:0.45rem 0.8rem;white-space:nowrap;box-shadow:0 4px 18px rgba(0,0,0,0.11);font-size:0.8rem;color:var(--color-text)';
    hint.animate([{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease', fill: 'forwards' });
    const container = btn.parentElement ?? btn;
    container.appendChild(hint);
    const dismiss = () => { hint.remove(); document.removeEventListener('click', outsideClick); };
    const outsideClick = (e: MouseEvent) => { if (!hint.contains(e.target as Node) && e.target !== btn) dismiss(); };
    setTimeout(() => document.addEventListener('click', outsideClick), 10);
    setTimeout(dismiss, 5000);
  }

  // ── Contact store button ──────────────────────────────────────
  const contactBtn = document.getElementById('contact-store-btn') as HTMLButtonElement | null;
  contactBtn?.addEventListener('click', () => {
    if (contactBtn.dataset.isLoggedIn !== 'true') {
      showLoginHint(contactBtn);
      return;
    }
    window.dispatchEvent(new CustomEvent('message:compose', {
      detail: {
        storeId: contactBtn.dataset.storeId ?? '',
        sellerId: contactBtn.dataset.sellerId ?? '',
        storeName: contactBtn.dataset.storeName ?? '',
      },
    }));
  });

</script>
