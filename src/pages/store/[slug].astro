  // ── Category filter chips ─────────────────────────────────────
  const categoryChips = Array.from(document.querySelectorAll<HTMLButtonElement>('.category-chip'));

  function setActiveChip(chip: HTMLButtonElement) {
    activeTag = chip.dataset.category ?? '';
    categoryChips.forEach((c) => {
      c.setAttribute('aria-pressed', String(c === chip));
      c.style.cssText = '';
    });
    filterAndSort();
  }

  categoryChips.forEach((chip) => chip.addEventListener('click', () => setActiveChip(chip)));

  // Normalize Hebrew text for search: remove nikud, normalize sofit letters, collapse punctuation
  function normalizeHe(str: string): string {
    return str
      .toLowerCase()
      .replace(/[ְ-ׇֽֿׁׂׅׄ]/g, '') // nikud
      .replace(/[ן]/g, 'נ').replace(/[ף]/g, 'פ').replace(/[ך]/g, 'כ')
      .replace(/[ם]/g, 'מ').replace(/[ץ]/g, 'צ')
      .replace(/[׳״’“”]/g, '') // geresh / quotes
      .replace(/[-_.,!?;:()\[\]{}/\\״׳]/g, ' ')
      .replace(/\s+/g, ' ').trim();
  }

  function matchesSearch(query: string, name: string, tags: string): boolean {
    if (!query) return true;
    const nQuery = normalizeHe(query);
    const nCombined = normalizeHe(name) + ' ' + normalizeHe(tags.replace(/,/g, ' '));
    // Every word in the query must appear somewhere in name+tags
    return nQuery.split(' ').every((word) => word && nCombined.includes(word));
  }

  function filterAndSort() {
    if (!productGrid) return;
    const query = (searchInput?.value ?? '').trim();

    const cards = currentSort === 'default'
      ? [...originalOrder]
      : Array.from(productGrid.querySelectorAll<HTMLElement>('li[data-product-name]'));

    if (currentSort !== 'default') {
      cards.sort((a, b) => {
        switch (currentSort) {
          case 'name-asc':   return (a.dataset.productName ?? '').localeCompare(b.dataset.productName ?? '');
          case 'name-desc':  return (b.dataset.productName ?? '').localeCompare(a.dataset.productName ?? '');
          case 'price-asc':  return Number(a.dataset.price ?? 0) - Number(b.dataset.price ?? 0);
          case 'price-desc': return Number(b.dataset.price ?? 0) - Number(a.dataset.price ?? 0);
          case 'newest':     return (b.dataset.createdAt ?? '') > (a.dataset.createdAt ?? '') ? 1 : -1;
          default: return 0;
        }
      });
    }

    cards.forEach(c => productGrid.appendChild(c));

    let visible = 0;
    cards.forEach(card => {
      const name = card.dataset.productName ?? '';
      const category = card.dataset.category ?? '';
      const tags = card.dataset.tags ?? '';
      const matchesQuery = matchesSearch(query, name, tags);
      const matchesTag = !activeTag || category === activeTag;
      const show = matchesQuery && matchesTag;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (noResults) noResults.hidden = visible > 0;
    const sortEl = document.getElementById('sort-dropdown') as HTMLElement | null;
    const catFilters = document.getElementById('category-filters') as HTMLElement | null;
    if (sortEl) sortEl.style.display = visible > 0 ? '' : 'none';
    if (catFilters) catFilters.style.display = visible > 0 ? '' : 'none';
    syncUrl();
  }

  function syncUrl() {
    const params = new URLSearchParams();
    const q = searchInput?.value.trim() ?? '';
    if (q) params.set('q', q);
    if (activeTag) params.set('category', activeTag);
    if (currentSort !== 'default') params.set('sort', currentSort);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  function openSort() {
    sortMenu?.removeAttribute('hidden');
    sortTrigger?.setAttribute('aria-expanded', 'true');
    if (sortChevron) (sortChevron as unknown as HTMLElement).style.transform = 'rotate(180deg)';
  }

  function closeSort() {
    sortMenu?.setAttribute('hidden', '');
    sortTrigger?.setAttribute('aria-expanded', 'false');
    if (sortChevron) (sortChevron as unknown as HTMLElement).style.transform = '';
  }

  const sortOptions = sortMenu
    ? Array.from(sortMenu.querySelectorAll<HTMLElement>('[role="option"]'))
    : [];

  function selectSortOption(opt: HTMLElement) {
    sortOptions.forEach(o => o.setAttribute('aria-selected', 'false'));
    opt.setAttribute('aria-selected', 'true');
    currentSort = opt.dataset.value ?? 'default';
    const label = opt.textContent?.trim() ?? '';
    if (sortLabel) sortLabel.textContent = label;
    if (sortTrigger) sortTrigger.setAttribute('aria-label', label);
    closeSort();
    sortTrigger?.focus();
    filterAndSort();
  }

  sortTrigger?.addEventListener('click', () => {
    sortMenu?.hidden ? openSort() : closeSort();
  });

  sortTrigger?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (sortMenu?.hidden) openSort();
      const idx = e.key === 'ArrowDown' ? 0 : sortOptions.length - 1;
      sortOptions[idx]?.focus();
    }
  });

  sortOptions.forEach((opt, i) => {
    opt.setAttribute('tabindex', '-1');
    opt.addEventListener('click', () => selectSortOption(opt));
    opt.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSortOption(opt); }
      if (e.key === 'ArrowDown') { e.preventDefault(); sortOptions[(i + 1) % sortOptions.length]?.focus(); }
      if (e.key === 'ArrowUp')   { e.preventDefault(); sortOptions[(i - 1 + sortOptions.length) % sortOptions.length]?.focus(); }
      if (e.key === 'Home')      { e.preventDefault(); sortOptions[0]?.focus(); }
      if (e.key === 'End')       { e.preventDefault(); sortOptions[sortOptions.length - 1]?.focus(); }
      if (e.key === 'Tab')       { closeSort(); }
    });
  });

  document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('sort-dropdown');
    if (dropdown && !dropdown.contains(e.target as Node)) closeSort();
  });

  searchInput?.addEventListener('input', filterAndSort);

  // ── Init from URL params (q / sort / category) ────────────────
  {
    const urlParams   = new URLSearchParams(window.location.search);
    const initQ       = urlParams.get('q') ?? '';
    const initSortVal = urlParams.get('sort') ?? '';
    const initCat     = urlParams.get('category') ?? '';

    if (initQ && searchInput) searchInput.value = initQ;
    if (initQ) {
      const hInput = document.getElementById('header-search-input') as HTMLInputElement | null;
      if (hInput) hInput.value = initQ;
    }

    if (initSortVal) {
      const matchingOpt = sortOptions.find(o => o.dataset.value === initSortVal);
      if (matchingOpt) {
        sortOptions.forEach(o => o.setAttribute('aria-selected', 'false'));
        matchingOpt.setAttribute('aria-selected', 'true');
        currentSort = initSortVal;
        if (sortLabel) sortLabel.textContent = matchingOpt.textContent?.trim() ?? '';
      }
    }

    if (initCat) {
      const matchingChip = categoryChips.find(c => c.dataset.category === initCat);
      if (matchingChip) {
        activeTag = initCat;
        categoryChips.forEach(c => {
          c.setAttribute('aria-pressed', String(c === matchingChip));
          c.style.cssText = '';
        });
      }
    }

    if (initQ || initSortVal || initCat) filterAndSort();
  }

  // ── Skeleton: remove shimmer when image loads ─────────────────
  document.querySelectorAll<HTMLImageElement>('.product-card__img').forEach((img) => {
    const wrap = img.closest<HTMLElement>('.product-card__img-wrap');
    if (!wrap) return;
    const done = () => wrap.classList.remove('is-loading');
    if (img.complete && img.naturalWidth > 0) {
      done();
    } else {
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
