---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoreBySlug } from '../../lib/stores.js';
import { store as platform } from '../../config/store.config.js';

const { slug } = Astro.params;
const shopStore = getStoreBySlug(slug);

if (!shopStore) return Astro.redirect('/404');

const storeUrl = new URL(`/store/${shopStore.slug}`, Astro.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: shopStore.name,
  description: shopStore.description || shopStore.tagline || `Shop at ${shopStore.name}`,
  url: storeUrl,
};
---

<BaseLayout
  title={shopStore.name}
  description={shopStore.tagline || shopStore.description || `Shop at ${shopStore.name} on ${platform.name}`}
  jsonLd={jsonLd}
  storeColors={shopStore.colors}
>
  <div class="store-page">

    <header class="store-banner">
      <div class="container">
        <h1 class="store-name">{shopStore.name}</h1>
        {shopStore.tagline && <p class="store-tagline">{shopStore.tagline}</p>}
      </div>
    </header>

    {shopStore.description && (
      <section class="section container store-about">
        <p class="store-desc">{shopStore.description}</p>
      </section>
    )}

    <section class="section container">
      <h2 class="products-heading">Products</h2>
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <p>This store is setting up. Check back soon.</p>
      </div>
    </section>

    <footer class="store-platform-note">
      <p>
        <a href="/" class="platform-link">{platform.name}</a> — open your own store today
      </p>
    </footer>

  </div>
</BaseLayout>

<style>
  .store-page { min-height: 60vh; }

  .store-banner {
    background: var(--color-primary);
    color: #fff;
    padding: 3rem 0 2.5rem;
  }

  .store-name {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .store-tagline {
    margin: 0.6rem 0 0;
    font-size: 1.15rem;
    opacity: 0.88;
  }

  .store-about {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }

  .store-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 680px;
    color: var(--color-muted);
  }

  .products-heading {
    margin-bottom: 1.5rem;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3rem 1rem;
    color: var(--color-muted);
    text-align: center;
  }

  .empty-state svg {
    opacity: 0.4;
  }

  .empty-state p {
    font-size: 1rem;
    margin: 0;
  }

  .store-platform-note {
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .store-platform-note p { margin: 0; }

  .platform-link {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .platform-link:hover { text-decoration: underline; }
</style>
