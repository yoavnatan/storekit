  // ── Color variant resolution ──────────────────────────────────
  const PM_COLOR_MAP: Record<string, string> = {
    'אדום':'#e53e3e','כחול':'#3b82f6','ירוק':'#22c55e','שחור':'#1f2937','לבן':'#f1f5f9',
