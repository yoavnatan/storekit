    'yellow':'#eab308','orange':'#f97316','purple':'#8b5cf6','pink':'#ec4899','brown':'#92400e',
    'gray':'#6b7280','grey':'#6b7280','beige':'#d4b89a','gold':'#d4a017','silver':'#9ca3af',
    'turquoise':'#06b6d4','teal':'#0d9488','navy':'#1e40af','mint':'#6ee7b7','lavender':'#c4b5fd',
    'coral':'#fb7185','mustard':'#ca8a04','cream':'#fef9c3','olive':'#65a30d','maroon':'#9f1239',
    'indigo':'#4f46e5','cyan':'#06b6d4','magenta':'#d946ef',
  };

  function resolveColor(opt: string): { display: string; hex: string | null } {
    const m = opt.match(/#([0-9a-fA-F]{3,6})\b/);
    if (m) return { display: opt.replace(/#([0-9a-fA-F]{3,6})\b/, '').trim() || opt, hex: '#' + m[1] };
    return { display: opt, hex: PM_COLOR_MAP[opt.trim().toLowerCase()] ?? null };
  }

  function isColorVariantName(name: string): boolean {
    const l = name.trim().toLowerCase();
    return l === 'צבע' || l === 'color' || l === 'colour';
  }

  function fmtPrice(price: number): string {
    return new Intl.NumberFormat('he-IL', { style: 'currency', currency: 'ILS', minimumFractionDigits: 0 }).format(price);
  }

