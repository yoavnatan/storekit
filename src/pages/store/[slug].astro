    'חרדל':'#ca8a04','כחול כהה':'#1e40af','כחול בהיר':'#bfdbfe','ירוק כהה':'#166534',
    'ירוק בהיר':'#bbf7d0','אדום כהה':'#991b1b','ורוד בהיר':'#fce7f3',
