---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoreBySlug } from '../../lib/stores.js';
import { getProductsByStoreId } from '../../lib/store-products.js';
import { store as platform, formatPrice } from '../../config/store.config.js';
import { getSellerSession } from '../../lib/seller-auth.js';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const shopStore = getStoreBySlug(slug);
if (!shopStore) return Astro.redirect('/404');

const isLoggedIn = !!getSellerSession(Astro.cookies);

const products = getProductsByStoreId(shopStore.id);
const storeUrl = new URL(`/store/${shopStore.slug}`, Astro.url).href;
const today = new Date().toDateString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: shopStore.name,
  description: shopStore.description || shopStore.tagline || `Shop at ${shopStore.name}`,
  url: storeUrl,
};
---

<BaseLayout
  title={shopStore.name}
  description={shopStore.tagline || shopStore.description || `Shop at ${shopStore.name} on ${platform.name}`}
  jsonLd={jsonLd}
  storeColors={shopStore.colors}
  isLoggedIn={isLoggedIn}
  storeMode={true}
>
  <div class="store-page">

    <header class="store-banner">
      <div class="container">
        <h1 class="store-name">{shopStore.name}</h1>
        {shopStore.tagline && <p class="store-tagline">{shopStore.tagline}</p>}
      </div>
    </header>

    {shopStore.description && (
      <section class="section container store-about">
        <p class="store-desc">{shopStore.description}</p>
      </section>
    )}

    <section class="section container">
      <h2 class="products-heading">Products</h2>
      {products.length === 0 ? (
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <p>This store is setting up. Check back soon.</p>
        </div>
      ) : (
        <ul class="product-grid" role="list">
          {products.map((p) => {
            const isNew = new Date(p.createdAt).toDateString() === today;
            return (
              <li class="product-card card">
                <div class="product-card__img-wrap">
                  {p.image
                    ? <img src={p.image} alt={p.name} class="product-card__img" width="400" height="400" loading="lazy" decoding="async" />
                    : <div class="product-card__img-placeholder" aria-hidden="true">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                          <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                          <line x1="12" y1="22.08" x2="12" y2="12"/>
                        </svg>
                      </div>
                  }
                </div>
                <div class="product-card__body">
                  {isNew && <span class="badge badge--new">New</span>}
                  <h3 class="product-card__name">{p.name}</h3>
                  {p.description && <p class="product-card__desc">{p.description}</p>}
                  <div class="product-card__footer">
                    <span class="product-card__price">{formatPrice(p.price)}</span>
                    {p.stock <= 0
                      ? <span class="badge badge--muted">Out of stock</span>
                      : <button
                          class="btn btn--sm add-to-cart-btn"
                          data-slug={p.slug}
                          data-name={p.name}
                          data-price={String(p.price)}
                          data-image={p.image ?? ''}
                        >Add to cart</button>}
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <footer class="store-platform-note">
      <p>
        <a href="/" class="platform-link">{platform.name}</a> — open your own store today
      </p>
    </footer>

  </div>
</BaseLayout>

<script>
  import { addItem } from '../../lib/cart.js';
  document.querySelectorAll<HTMLButtonElement>('.add-to-cart-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const { slug = '', name = '', price = '0', image = '' } = btn.dataset;
      addItem({ slug, name, price: Number(price), image });
      window.dispatchEvent(new CustomEvent('cart:open'));
    });
  });
</script>

