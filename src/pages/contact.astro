---
/** Contact — one of the two pages the site-wide footer has always linked to and neither of which
 *  existed until 2026-08-06. Both 404'd on every page of the platform.
 *
 *  **It is not only a broken link, and that is why it is a page and not a `mailto:`.** Google
 *  Merchant Center suspends an ACCOUNT (not an item) for "misrepresentation" when a shop does not
 *  publish who is behind it and how to reach them, and Meta's commerce eligibility asks for the
 *  same. One suspended account here is every seller's ads at once — the single-account model that
 *  lets a seller advertise without registering anywhere is also what makes that failure shared.
 *  A page a crawler can read is what both platforms look for.
 *
 *  Deliberately thin on promises: it names the one channel that really exists (email — there is no
 *  phone line and no ticketing system yet, see GO_LIVE §4) and does not invent a response time.
 *  A published SLA nobody is rostered to meet is the same misrepresentation in the other direction.
 *
 *  Hebrew copy, both languages: this is Israel-facing, and a machine-translated support page reads
 *  as a shell. The English UI gets the same text with an English lede.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import { getSellerSession } from '../lib/seller-auth.js';
import { getStoresBySellerId } from '../lib/stores.js';
import { getLang, getT } from '../i18n/index.js';
import { safeRedirectPath, safeRefererPath } from '../lib/safe-redirect.js';
import { store as platform } from '../config/store.config.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const dir = lang === 'he' ? 'rtl' : 'ltr';

// Which page the report is about — CAPTURED, never asked for, which is the whole reason this is a
// form and not a mail (ReportForm.astro). Two sources, in order:
//   `?report=<kind>&from=<path>` — an explicit "report this" link, which also preselects the kind;
//   the `Referer` otherwise — the footer's plain `/contact` link is on every page of the site, so
//   the page someone left to come and report is already known without adding a fifth footer link
//   or hanging a query string off one that every crawler follows.
// Both are request-supplied values this page RENDERS, so both go through the shared validators
// (Hard rules → Security review gate); a referrer from another origin degrades to nothing.
const reportKind = Astro.url.searchParams.get('report') ?? 'fault';
/**
 * "פנייה בנוגע להזמנה" arriving from a mailed link (`order-token.ts#orderHelpUrl`).
 *
 * Passed through UNVERIFIED and that is deliberate: `/api/returns` re-checks the signature before
 * anything is written, so verifying here as well would be a second copy of the rule — and one that
 * would then have to be kept in step with it. All this decides is whether the form asks for the
 * order number, or already knows it.
 */
const helpOrderId = Astro.url.searchParams.get('order') ?? '';
const helpToken = Astro.url.searchParams.get('t') ?? '';
const cameFrom = safeRedirectPath(Astro.url.searchParams.get('from'), '')
  || safeRefererPath(Astro.request.headers.get('referer'), Astro.url.origin, '');
// Arriving here from this page itself says nothing about what is being reported.
const reportPage = cameFrom.split('?')[0] === '/contact' ? '' : cameFrom;
// The response now differs by `Referer`, so it must say so. Nothing caches an SSR page in front of
// this app today — which is exactly why the header goes in now rather than after a CDN is put there
// and one visitor is shown the page another visitor came from.
Astro.response.headers.set('Vary', 'Referer');

const sellerId = getSellerSession(Astro.cookies);
const isLoggedIn = !!sellerId;
const hasStore = sellerId ? (await getStoresBySellerId(sellerId)).length > 0 : false;

const email = platform.business.email;
const title = lang === 'he' ? 'יצירת קשר' : 'Contact';
const description = lang === 'he'
  ? `איך יוצרים קשר עם ${platform.name} — קונים, מוכרים ופניות בנושא חנות.`
  : `How to reach ${platform.name} — buyers, sellers, and store enquiries.`;
---

<BaseLayout
  title={`${title} — ${platform.name}`}
  description={description}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
  showSearch={true}
>
  <section class="section container" dir={dir}>
    <h1 class="!text-[1.6rem] !font-semibold">{title}</h1>

    <p style="margin-top:1rem;max-width:60ch">
      {lang === 'he'
        ? `${platform.name} היא זירת מסחר: כל חנות מנוהלת בידי עסק עצמאי, ו${platform.name} מפעילה את הפלטפורמה שבתוכה החנויות פועלות.`
        : `${platform.name} is a marketplace: each store is run by an independent business, and ${platform.name} operates the platform they sell on.`}
    </p>

    <h2 class="!text-[1.05rem] !font-semibold" style="margin-top:1.75rem">
      {lang === 'he' ? 'שאלה על הזמנה שביצעת' : 'A question about an order you placed'}
    </h2>
    <p style="max-width:60ch">
      {lang === 'he'
        ? 'המוכר הוא הכתובת הראשונה — הוא זה שאורז ושולח. בכל מייל על ההזמנה יש קישור "פנייה בנוגע להזמנה" שמגיע ישירות אליו, בלי צורך בחשבון. יש לכם חשבון? הכפתור "צור קשר עם החנות" בעמוד החנות שומר את ההתכתבות באזור האישי.'
        : 'The seller is the first address — they are the one packing and shipping. Every email about the order carries a "question about this order" link that reaches them directly, with no account needed. If you do have an account, the "contact the store" button on a store page keeps the thread in your account area.'}
    </p>

    <h2 class="!text-[1.05rem] !font-semibold" style="margin-top:1.75rem">
      {lang === 'he' ? 'פנייה לפלטפורמה' : 'Reaching the platform'}
    </h2>
    <p style="max-width:60ch">
      {lang === 'he'
        ? 'לפתיחת חנות, שאלה על הפלטפורמה, או פנייה שהמוכר לא נענה לה:'
        : 'To open a store, ask about the platform, or follow up on an enquiry a seller has not answered:'}
    </p>
    <p style="margin-top:0.5rem;font-weight:553">
      <a href={`mailto:${email}`}>{email}</a>
    </p>

    {/* A fault or a content report leaves the mailto and gets a form, because those are the two
        kinds of message that are worthless without the context a person cannot type — see
        ReportForm.astro. The address above stays for everything else: a business enquiry does not
        want a ticket, and losing the published address is itself a Merchant Center risk (see this
        page's header). */}
    <h2 id="report" class="!text-[1.05rem] !font-semibold" style="margin-top:1.75rem">{t.report.title}</h2>
    <p class="muted" style="max-width:60ch">{t.report.lede}</p>
    {/* **The two doors are one inbox, and only the seller could not tell** (owner, סשן ד׳: *"מצד
        אחד הוא יכול ליצור קשר דרך הטופס ומצד שני לפתוח פנייה לדזבין — אולי כדאי להשאיר רק את צור
        קשר?"*, then: *"רק שיהיה ברור שעדיין מוכר צריך להיות מסוגל לדווח על תקלה דרך צור קשר"*).
        Neither door is removed: this page is what Merchant Center and Meta look for, it is what
        every buyer and guest uses, and a fault report belongs on it precisely because the context
        that makes a fault actionable — which page, which store, who — is captured here and typed
        nowhere.
        The sentence that was missing is now INSIDE the form, under the kind picker, because the
        answer differs by kind and the picker is what chooses: a fault is filed and never opens a
        conversation, everything else comes back to this seller's Messages tab. A paragraph up here
        could only have said one of the two, and would have been wrong half the time. */}
    <ReportForm kind={reportKind} page={reportPage} orderId={helpOrderId} orderToken={helpToken} sellerInbox={hasStore} />

    <h2 class="!text-[1.05rem] !font-semibold" style="margin-top:1.75rem">
      {lang === 'he' ? 'פרטי המפעיל' : 'Operator'}
    </h2>
    <p style="max-width:60ch">
      {platform.business.legalName}
      {platform.business.phone ? ` · ${platform.business.phone}` : ''}
      {platform.business.address ? ` · ${platform.business.address}` : ''}
    </p>

    <p style="margin-top:2rem">
      <a href="/terms" class="muted">{lang === 'he' ? 'תנאי שימוש' : 'Terms of use'}</a>
    </p>
  </section>
</BaseLayout>
