---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { store as platform } from '../config/store.config.js';
import { getSellerSession, getSellerById } from '../lib/seller-auth.js';
import { getStoreBySellerId, getAllStores } from '../lib/stores.js';
import { getLang, getT } from '../i18n/index.js';

const sellerId = getSellerSession(Astro.cookies);
const seller = sellerId ? getSellerById(sellerId) : null;
const sellerStore = sellerId ? getStoreBySellerId(sellerId) : null;
const isLoggedIn = !!sellerId;
const hasStore = !!sellerStore;

const stores = getAllStores();
const lang = getLang(Astro.cookies);
const t    = getT(lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: platform.name,
  url: platform.url,
  description: platform.description,
};
---

<BaseLayout
  title={t.home.discoverStores}
  description={`${t.home.browseDesc}`}
  jsonLd={jsonLd}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
>

  {isLoggedIn && seller && (
    <div class="bg-[var(--color-surface)] border-b border-[var(--color-border)]">
      <div class="container flex items-center gap-2 py-3 text-sm">
        <span class="text-[var(--color-muted)] font-medium">{t.home.welcomeBack}</span>
        <span class="text-[var(--color-border)]" aria-hidden="true">·</span>
        <span class="font-semibold text-[var(--color-primary)]">{seller.name}</span>
      </div>
    </div>
  )}

  <div id="active-carts-bar" hidden class="bg-[var(--color-surface)] border-b border-[var(--color-border)] px-4 py-3">
    <div class="container flex flex-wrap items-center gap-3">
      <span class="text-xs font-semibold text-[var(--color-muted)] uppercase tracking-wide shrink-0">{t.home.yourCarts}</span>
      <div id="active-carts-list" class="flex flex-wrap gap-2"></div>
    </div>
  </div>

  <section class="bg-[var(--color-surface)] border-b border-[var(--color-border)] py-10 px-4">
    <div class="container flex flex-col items-center gap-5 text-center max-w-xl mx-auto">
      <h1 class="text-3xl font-bold leading-tight">{t.home.discoverStores}</h1>
      <p class="text-[var(--color-muted)] text-base max-w-sm">{t.home.browseDesc}</p>
      <div class="w-full max-w-sm relative">
        <label for="store-search" class="sr-only">{t.home.searchPlaceholder}</label>
        <svg class={`absolute ${lang === 'he' ? 'right-3' : 'left-3'} top-1/2 -translate-y-1/2 text-[var(--color-muted)] pointer-events-none`} width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          id="store-search"
          type="search"
          placeholder={t.home.searchPlaceholder}
          autocomplete="off"
          class={`w-full ${lang === 'he' ? 'pr-9 pl-4' : 'pl-9 pr-4'} py-2.5 rounded-lg border border-[var(--color-border)] bg-white text-[var(--color-primary)] text-sm placeholder:text-[var(--color-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition duration-150`}
        />
      </div>
    </div>
  </section>

  <section class="section container" aria-label="Store listing">
    {stores.length === 0 ? (
      <div class="flex flex-col items-center gap-4 py-16 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-muted)]" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <p class="text-[var(--color-muted)]">{t.home.noStores}</p>
        <a href="/seller/register" class="btn">{t.home.openStoreFree}</a>
      </div>
    ) : (
      <>
        <ul id="store-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" role="list">
          {stores.map((s) => (
            <li
              class="card"
              data-name={s.name.toLowerCase()}
              data-tagline={(s.tagline || s.description || '').toLowerCase()}
            >
              <div class="flex flex-col gap-3 p-5 flex-1">
                <div class="flex-1">
                  <h2 class="text-base font-semibold leading-snug">{s.name}</h2>
                  {(s.tagline || s.description) && (
                    <p class="text-sm text-[var(--color-muted)] mt-1 line-clamp-2">{s.tagline || s.description}</p>
                  )}
                </div>
                <a
                  href={`/store/${s.slug}`}
                  class="btn btn--sm self-end inline-flex items-center gap-1"
                >
                  {t.home.visitStore}
                  <svg class="rtl:-scale-x-100" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </li>
          ))}
        </ul>
        <p id="no-results" class="hidden text-center text-[var(--color-muted)] py-12">{t.home.noResults}</p>
      </>
    )}
  </section>

  {!hasStore && (
    <section class="bg-[var(--color-primary)] py-16 px-4">
      <div class="container flex flex-col items-center gap-6 text-center max-w-lg mx-auto">
        <div class="flex flex-col gap-3">
          <h2 class="text-2xl sm:text-3xl font-bold text-white leading-tight">{t.home.startSelling}</h2>
          <p class="text-white/70 text-base">{t.home.startSellingDesc}</p>
        </div>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-white/60" role="list">
          <li class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.freeToStart}
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.ownStorefront}
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.builtInSeo}
          </li>
        </ul>
        <a
          href="/seller/register"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white font-semibold text-sm text-[var(--color-primary)] transition duration-150 hover:bg-white/90 active:scale-[0.97]"
        >
          {t.home.openStoreFree}
          <svg class="rtl:-scale-x-100" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </section>
  )}

</BaseLayout>

<script>
  import { getActiveStoreCarts } from '../lib/cart.js';

  // ── Active carts bar ──────────────────────────────────────────────
  const cartsBar  = document.getElementById('active-carts-bar');
  const cartsList = document.getElementById('active-carts-list');

  function renderActiveCarts() {
    const carts = getActiveStoreCarts();
    if (!cartsList || !cartsBar) return;
    if (!carts.length) { cartsBar.setAttribute('hidden', ''); return; }
    cartsBar.removeAttribute('hidden');
    cartsList.innerHTML = carts.map((c) => `
      <a href="/store/${encodeURIComponent(c.storeSlug)}" class="active-cart-chip">
        ${c.storeName}
        <span class="active-cart-chip__count">${c.count}</span>
      </a>`).join('');
  }

  renderActiveCarts();
  window.addEventListener('cart:change', renderActiveCarts);

  // ── Store search ──────────────────────────────────────────────────
  const search = document.getElementById('store-search') as HTMLInputElement | null;
  const list = document.getElementById('store-list');
  const noResults = document.getElementById('no-results');

  if (search && list) {
    search.addEventListener('input', () => {
      const q = search.value.toLowerCase().trim();
      let visible = 0;
      list.querySelectorAll<HTMLLIElement>('li[data-name]').forEach((li) => {
        const match = q === '' || (li.dataset.name ?? '').includes(q) || (li.dataset.tagline ?? '').includes(q);
        li.hidden = !match;
        if (match) visible++;
      });
      if (noResults) noResults.classList.toggle('hidden', visible > 0 || q === '');
    });
  }
</script>
