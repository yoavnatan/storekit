---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { store } from '../config/store.config.js';
import { getSellerSession } from '../lib/seller-auth.js';
import { getStoreBySellerId } from '../lib/stores.js';

const sellerId = getSellerSession(Astro.cookies);
const sellerStore = sellerId ? getStoreBySellerId(sellerId) : null;
const isLoggedIn = !!sellerId;
const hasStore = !!sellerStore;

const hp = store.homepage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: store.name,
  url: store.url,
  description: store.description,
};
---

<BaseLayout title={null} jsonLd={jsonLd} isLoggedIn={isLoggedIn} hasStore={hasStore}>
  {hasStore ? (
    <section class="welcome-back section">
      <div class="container welcome-back__inner">
        <p class="muted welcome-back__label">Welcome back</p>
        <h1>{sellerStore!.name}</h1>
        <p class="muted welcome-back__sub">
          Your store is live at <a href={`/store/${sellerStore!.slug}`} class="welcome-back__store-link" target="_blank" rel="noopener">/store/{sellerStore!.slug}</a>
        </p>
        <a href="/seller/dashboard" class="btn">Go to dashboard</a>
      </div>
    </section>
  ) : (
    <>
      {hp.sections.map((section) => {
        if (section === 'hero' && hp.hero.enabled) {
          return (
            <section class="hero">
              <div class="container hero__inner">
                <div class="hero__badge">Online marketplace</div>
                <h1>{hp.hero.title}</h1>
                <p class="hero__sub">{hp.hero.subtitle}</p>
                <div class="hero__actions">
                  <a href={hp.hero.ctaHref} class="btn">{hp.hero.ctaText}</a>
                  <a href="/seller/login" class="btn btn--ghost">Log in</a>
                </div>
                <ul class="hero__pills" role="list">
                  <li><svg class="pill-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Free to start</li>
                  <li><svg class="pill-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Your own storefront</li>
                  <li><svg class="pill-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Built-in SEO</li>
                  <li><svg class="pill-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> No code needed</li>
                </ul>
              </div>
            </section>
          );
        }
        return null;
      })}

      <section class="section how container">
        <div class="section__head center">
          <h2>How it works</h2>
          <p class="muted">Three steps and you're selling.</p>
        </div>
        <ol class="steps" role="list">
          <li class="step">
            <span class="step__num">1</span>
            <h3>Create your account</h3>
            <p class="muted">Sign up with your email in under a minute. No credit card, no commitment.</p>
          </li>
          <li class="step">
            <span class="step__num">2</span>
            <h3>Set up your store</h3>
            <p class="muted">Give your store a name, pick your colors, and write a short description. Done.</p>
          </li>
          <li class="step">
            <span class="step__num">3</span>
            <h3>Add products & go live</h3>
            <p class="muted">Upload your products. Your store gets its own page, found by search engines from day one.</p>
          </li>
        </ol>
        <div class="center" style="margin-top:2.5rem">
          <a href="/seller/register" class="btn">Get started — it's free</a>
        </div>
      </section>
    </>
  )}
</BaseLayout>
