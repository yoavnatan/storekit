---
export const prerender = false;
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { store as platform, formatPrice, cdnSrc } from '../config/store.config.js';
import { getSellerSession } from '../lib/seller-auth.js';
import { getStoreBySellerId, getAllStores } from '../lib/stores.js';
import { getProductsByStoreId } from '../lib/store-products.js';
import { getLang, getT } from '../i18n/index.js';

const sellerId    = getSellerSession(Astro.cookies);
const sellerStore = sellerId ? getStoreBySellerId(sellerId) : null;
const isLoggedIn  = !!sellerId;
const hasStore    = !!sellerStore;

const stores = getAllStores();
const lang   = getLang(Astro.cookies);
const t      = getT(lang);

const storesWithProducts = stores
  .map((s) => ({ store: s, products: getProductsByStoreId(s.id) }))
  .filter(({ products }) => products.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: platform.name,
  url: platform.url,
  description: platform.description,
};
---

<BaseLayout
  title={t.home.discoverStores}
  description={t.home.browseDesc}
  jsonLd={jsonLd}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
  showSearch={true}
  isHome={true}
  dataLayer={{ event: 'page_view', page_type: 'platform', currency: 'ILS' }}
>

  <h1 class="visually-hidden">{t.home.discoverStores}</h1>
  <div class="home-body">

  <!-- ── Per-store product carousels ───────────────────────────────── -->
  {storesWithProducts.length > 0 && (
    <div class="section container" style="padding-top:1rem;padding-bottom:0">
      <h2 class="home-section-title">{t.home.discoverStores}</h2>
    </div>
  )}
  {storesWithProducts.length === 0 ? (
    <div class="section container flex flex-col items-center gap-4 py-16 text-center">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           class="opacity-25 text-[var(--color-muted)]" aria-hidden="true">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <p class="text-[var(--color-muted)] text-sm">{t.home.noStores}</p>
      <a href="/seller/register" class="btn">{t.home.openStoreFree}</a>
    </div>
  ) : (
    <div id="stores-container">
      {storesWithProducts.map(({ store: s, products }, storeIdx) => {
        return (
          <section
            class="home-store-section"
            data-store-name={s.name.toLowerCase()}
            data-tagline={(s.tagline || s.description || '').toLowerCase()}
            aria-labelledby={`sh-${s.slug}`}
          >
            <div class="container">
              <div class="home-section-header">
                <div class="home-store-section__title-group">
                  <a href={`/store/${s.slug}`} style="color:inherit;text-decoration:none" class="hover:text-[var(--color-accent)] transition-colors duration-150">
                    <h2 id={`sh-${s.slug}`} class="home-section-title">{s.name}</h2>
                  </a>
                  {(s.tagline || s.description) && (
                    <p class="home-store-section__tagline" dir="auto">{s.tagline || s.description}</p>
                  )}
                </div>
                <a
                  href={`/store/${s.slug}`}
                  class="btn btn--sm btn--ghost inline-flex items-center gap-1.5 shrink-0"
                >
                  {t.home.visitStore}
                  <svg class="rtl:-scale-x-100" width="11" height="11" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>

              <div class="home-carousel-wrap">
                {products.length > 2 && (
                  <>
                    <button type="button" class="home-carousel-btn home-carousel-btn--prev"
                            aria-label={lang === 'he' ? 'הקודם' : 'Previous'}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2.5" aria-hidden="true"
                           style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                        <polyline points="15 18 9 12 15 6"/>
                      </svg>
                    </button>
                    <button type="button" class="home-carousel-btn home-carousel-btn--next"
                            aria-label={lang === 'he' ? 'הבא' : 'Next'}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2.5" aria-hidden="true"
                           style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                        <polyline points="9 18 15 12 9 6"/>
                      </svg>
                    </button>
                  </>
                )}
                <div class="home-carousel" role="list" aria-label={s.name}>
                  {products.map((p, prodIdx) => (
                    <a
                      href={`/store/${s.slug}`}
                      class="home-product-card card"
                      role="listitem"
                      aria-label={`${p.name} — ${formatPrice(p.price)}`}
                    >
                      <div class="home-product-card__img-wrap">
                        {p.images?.[0]
                          ? (storeIdx === 0 && prodIdx < 3
                              ? <Image
                                  src={cdnSrc(p.images[0])}
                                  alt={p.name}
                                  width={300}
                                  height={300}
                                  class="home-product-card__img"
                                  loading="eager"
                                  fetchpriority={prodIdx === 0 ? 'high' : undefined}
                                />
                              : <img
                                  data-lazy-src={cdnSrc(p.images[0])}
                                  alt={p.name}
                                  width="300"
                                  height="300"
                                  class="home-product-card__img"
                                />
                            )
                          : <span class="home-product-card__initial" aria-hidden="true">
                              {p.name[0]?.toUpperCase() ?? '?'}
                            </span>
                        }
                      </div>
                      <div class="home-product-card__body">
                        <span class="home-product-card__name" dir="auto">{p.name}</span>
                        <span class="home-product-card__price">{formatPrice(p.price)}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </section>
        );
      })}

      <p id="no-results" hidden class="text-center text-[var(--color-muted)] text-sm py-10 container">
        {t.home.noResults}
      </p>
    </div>
  )}

  <!-- ── Seller CTA ─────────────────────────────────────────────────── -->
  {isLoggedIn && !hasStore && (
    <section class="home-cta" aria-labelledby="cta-heading">
      <div class="home-cta__glow" aria-hidden="true"></div>
      <div class="container home-cta__inner">
        <div class="flex flex-col gap-3 text-center">
          <h2 id="cta-heading" class="text-2xl sm:text-3xl font-bold text-white leading-tight">
            {t.home.startSelling}
          </h2>
          <p class="text-white/65 text-base max-w-sm mx-auto">{t.home.startSellingDesc}</p>
        </div>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-white/55" role="list">
          <li class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.freeToStart}
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.ownStorefront}
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.builtInSeo}
          </li>
        </ul>
        <a
          href="/seller/register"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm
                 transition-all duration-150 active:scale-[0.97]"
          style="background:#fff;color:var(--color-primary);box-shadow:0 4px 18px rgba(0,0,0,0.22)"
          onmouseover="this.style.background='rgba(255,255,255,0.92)'"
          onmouseout="this.style.background='#fff'"
        >
          {t.home.openStoreFree}
          <svg class="rtl:-scale-x-100" width="13" height="13" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </section>
  )}

  </div>{/* .home-body */}

</BaseLayout>

<script is:inline type="application/json" id="home-search-stores-data" set:html={JSON.stringify(stores.map(s => ({ name: s.name, slug: s.slug, tagline: s.tagline ?? '', description: s.description ?? '' })))} />

<script>
  import { spawnRipple } from '../lib/ripple.js';
  import { clearLastStore } from '../lib/last-store.js';

  // Landing on the platform home is a deliberate exit from any store context —
  // don't let a stale "back to store" pill follow the buyer into checkout/dashboard afterward.
  clearLastStore();

  document.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button, a.btn, a.home-product-card');
    if (btn) spawnRipple(btn, e.clientX, e.clientY);
  });

  // ── Carousel arrows (per store section) ───────────────────────────
  const isRtl = document.documentElement.dir === 'rtl';
  const STEP  = 240;

  document.querySelectorAll<HTMLElement>('.home-store-section').forEach((section) => {
    const carousel = section.querySelector<HTMLElement>('.home-carousel');
    const btnPrev  = section.querySelector<HTMLButtonElement>('.home-carousel-btn--prev');
    const btnNext  = section.querySelector<HTMLButtonElement>('.home-carousel-btn--next');
    if (!carousel) return;

    function updateArrows(): void {
      const { scrollLeft, scrollWidth, clientWidth } = carousel!;
      // RTL: scrollLeft is negative when scrolled — Math.abs handles both directions
      const atStart = Math.abs(scrollLeft) < 4;
      const atEnd   = Math.abs(scrollLeft) + clientWidth >= scrollWidth - 4;

      if (btnPrev) btnPrev.toggleAttribute('hidden', atStart);
      if (btnNext) btnNext.toggleAttribute('hidden', atEnd);
    }

    carousel.addEventListener('scroll', updateArrows, { passive: true });
    // Run once on load (and after fonts/images may have shifted layout)
    updateArrows();
    requestAnimationFrame(updateArrows);

    btnPrev?.addEventListener('click', () => carousel.scrollBy({ left: isRtl ? STEP : -STEP, behavior: 'smooth' }));
    btnNext?.addEventListener('click', () => carousel.scrollBy({ left: isRtl ? -STEP : STEP, behavior: 'smooth' }));
  });

  // ── Carousel lazy loading (IntersectionObserver) ─────────────────
  {
    const lazyObs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const img = entry.target as HTMLImageElement;
        const src = img.dataset.lazySrc ?? '';
        if (src) {
          img.src = src;
          img.removeAttribute('data-lazy-src');
        }
        lazyObs.unobserve(img);
      });
    }, { rootMargin: '200px 400px 200px 400px', threshold: 0 });

    document.querySelectorAll<HTMLImageElement>('img[data-lazy-src]')
      .forEach((img) => lazyObs.observe(img));
  }

</script>
