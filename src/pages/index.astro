---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeShelf from '../components/HomeShelf.astro';
import HomeTabEmpty from '../components/HomeTabEmpty.astro';
import StoreAvatar from '../components/StoreAvatar.astro';
import StoreDemoBadge from '../components/StoreDemoBadge.astro';
import HomeProductCard from '../components/HomeProductCard.astro';
import DashTabsBoot from '../components/dashboard/DashTabsBoot.astro';
import { store as platform } from '../config/store.config.js';
import { getSellerSession, getSellerById } from '../lib/seller-auth.js';
import { getStoreBySellerId, getVisibleStores } from '../lib/stores.js';
import { countRealStores, filterShopperStores, isDemoStore, realStores } from '../lib/demo-stores.js';
import { getVisibleProductsByStoreId } from '../lib/store-products.js';
import { getAllOrders } from '../lib/orders.js';
import { buildHomeFeed, type FeedStore } from '../lib/home-feed.js';
import { getUserCart } from '../lib/user-carts.js';
import { parseRecentStores, mergeStoreSlugs } from '../lib/recent-stores.js';
import { isLaunchMode, showShelfInvite, planLaunchShelf, launchInviteCount, MIN_SHELF_INVITES } from '../lib/launch-mode.js';
import { getLang, getT } from '../i18n/index.js';

const sellerId    = getSellerSession(Astro.cookies);
const sellerStore = sellerId ? await getStoreBySellerId(sellerId) : null;
const isLoggedIn  = !!sellerId;
const hasStore    = !!sellerStore;

const lang   = getLang(Astro.cookies);
const t      = getT(lang);

// ── Launch mode (CURRENT_TASK.md → 2026-07-28), see lib/launch-mode.ts.
// DEV-only previews, since the demo dataset is an order of magnitude past the
// threshold and these states are otherwise impossible to look at. They cap the
// number of REAL stores; the showcase stores (lib/demo-stores.ts) then follow
// their own rule on top, so a preview shows exactly what that day looks like:
//   ?preview=launch → 2 real stores + the showcase stores
//   ?preview=empty  → 0 real stores — day one as it will actually ship
//   ?preview=blank  → nothing at all, showcase stores included (the pure
//                     placeholder page, i.e. day one with no seeded showcase)
const previewParam = import.meta.env.DEV ? Astro.url.searchParams.get('preview') : null;
const previewLimit = previewParam === 'launch' ? 2
  : previewParam === 'empty' || previewParam === 'blank' ? 0
  : null;

// Admin-blocked stores/products (see admin-moderation.ts) never appear on the
// discovery surfaces — a blocked store's card here would be a live link into
// a page that immediately 404s, and defeats the point of blocking it.
// filterShopperStores() then drops the platform's own showcase stores once there
// are enough real ones; their pages stay reachable by link either way.
const visibleStores = await getVisibleStores();
const previewedStores = previewLimit === null || previewParam === 'blank'
  ? (previewParam === 'blank' ? [] : visibleStores)
  : (() => {
      const keptReal = new Set(realStores(visibleStores).slice(0, previewLimit).map((s) => s.id));
      return visibleStores.filter((s) => isDemoStore(s) || keptReal.has(s.id));
    })();
const stores = filterShopperStores(previewedStores);

// Applied before the feed is built, so every downstream surface (shelves,
// spotlight, discovery) sees the same small catalog rather than a mixed picture.
const storesWithProducts = stores
  .map((s) => ({ store: s, products: getVisibleProductsByStoreId(s.id) }))
  .filter(({ products }) => products.length > 0);

// Stores this buyer has actually bought from before, most-recent purchase first — same
// buyerId-or-buyerEmail match the buyer dashboard's own order list uses (accounts are
// unified seller+buyer, and a buyer can check out before ever registering an email match).
const buyerEmail = sellerId ? (await getSellerById(sellerId))?.email : undefined;
const previousStoreSlugs: string[] = [];
if (sellerId || buyerEmail) {
  const seenSlugs = new Set<string>();
  const myOrders = getAllOrders()
    .filter((o) => o.buyerId === sellerId || (!!buyerEmail && o.buyerEmail === buyerEmail))
    .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
  for (const order of myOrders) {
    for (const item of order.items) {
      if (!seenSlugs.has(item.storeSlug)) { seenSlugs.add(item.storeSlug); previousStoreSlugs.push(item.storeSlug); }
    }
  }
}

// Bounded, varied feed instead of "render every store's full carousel" — see
// src/lib/home-feed.ts for the shelf-selection strategy (was the site's actual
// scaling limit once there are hundreds of stores, not just a style choice).
const feed = buildHomeFeed(storesWithProducts, sellerId, previousStoreSlugs);

// ── Tabs (CURRENT_TASK.md → סשן ג׳, round 2): the old vertical shelf-stack
// is now switchable tabs, reusing the seller/admin dashboard's own tab
// pattern (dash-tabs/.dash-panel + initDashTabs() in scripts/dashboard/ui.ts)
// — see AI_INSTRUCTIONS.md → Homepage for the reasoning. Category shelves +
// spotlight fold unchanged into the "discover" tab.
const TAB_IDS = ['discover', 'liked', 'buy-again', 'new'] as const;
type TabId = typeof TAB_IDS[number];

// ── Recently-visited stores (CURRENT_TASK.md → סשן ב׳ 1+3) — rendered SSR as a
// real StoreCard shelf, same as any other, so it reads exactly like the old
// "גלה עוד" shelf (the product-card version was dropped — it demanded a product
// open and left the shelf empty too often; a *store* visit is enough now).
// Source is the per-browser `sn_recent_stores` cookie, unioned server-side with
// the logged-in user's account list (recent-stores.ts) so it follows them
// across devices — cookie first for this-session recency. Resolved against the
// visible-with-products set, dropping any store since blocked/emptied.
const recentSlugs = mergeStoreSlugs(
  parseRecentStores(Astro.cookies.get('sn_recent_stores')?.value),
  sellerId ? (getUserCart(sellerId).recentStores ?? []) : [],
);
const recentStores: FeedStore[] = recentSlugs
  .map((slug) => storesWithProducts.find((sp) => sp.store.slug === slug))
  .filter((sp): sp is FeedStore => sp !== undefined);

// Category shelves render above the spotlight; "גלה עוד" (renamed from
// "עוד לגלות" per סשן ב׳ 3) renders BELOW the big carousel (סשן ב׳ follow-up) —
// the daily discovery shuffle as a "keep exploring" shelf after the hero
// carousel, so a first-time visitor with no history still lands on discovery
// content. Stores already in the recently-visited shelf are filtered out of it
// to avoid a dupe.
const categoryShelves = feed.categories.map((c, i) => ({ id: `cat-${i}`, title: c.category, stores: c.stores }));
const discoveryShelf = { id: 'discovery', title: t.home.shelfDiscovery, stores: feed.discovery.filter((fs) => !recentSlugs.includes(fs.store.slug)) };
const discoverHasContent = recentStores.length > 0 || categoryShelves.some((s) => s.stores.length > 0)
  || feed.spotlight.length > 0 || discoveryShelf.stores.length > 0;

// Discover is both the first tab and the default landing tab (round 3
// feedback) — it's the main browsing surface and always populated whenever
// any store+product exists, unlike Liked/BuyAgain/New which can be empty
// for a guest or new buyer.
const requestedTab = Astro.url.searchParams.get('panel');
const activeTab: TabId = (TAB_IDS as readonly string[]).includes(requestedTab ?? '')
  ? (requestedTab as TabId)
  : 'discover';

const tabs: { id: TabId; label: string }[] = [
  { id: 'discover', label: t.home.discoverStores },
  { id: 'liked', label: t.home.shelfLiked },
  { id: 'buy-again', label: t.home.shelfBuyAgain },
  { id: 'new', label: t.home.shelfNew },
];

// The active tab's own first non-empty shelf gets the eager/high-priority
// image load (today's real LCP element) — every other shelf, including ones
// in inactive (hidden) panels, stays lazy.
const activeTabShelves: { id: string; title: string; stores: typeof feed.liked }[] =
  activeTab === 'liked' ? [{ id: 'liked', title: t.home.shelfLiked, stores: feed.liked }] :
  activeTab === 'buy-again' ? [{ id: 'buy-again', title: t.home.shelfBuyAgain, stores: feed.buyAgain }] :
  activeTab === 'new' ? [{ id: 'new', title: t.home.shelfNew, stores: feed.newStores }] :
  categoryShelves;
const firstEagerShelfId = activeTabShelves.find((s) => s.stores.length > 0)?.id;

// Fresh per visit: each shelf/spotlight title's small accent dot
// (home-shelf-dot--0/1/2, see store-card.css) gets a random starting offset,
// added onto a running index so adjacent titles never repeat the same dot
// color back-to-back.
// eslint-disable-next-line sonarjs/pseudo-random -- picks one of three accent-dot colours
const bgOffset = Math.floor(Math.random() * 3);

// Under 5 live stores the Discover tab's SHELVES collapse to one placeholder-
// padded row (the category rows would each hold a single card, which is what
// actually reads as empty). The spotlight carousel and everything else about
// the page — hero, tab strip, titles — stay exactly as they are: nothing on
// screen announces that the mall is new. Between 5 and 10 stores the normal
// page returns with one placeholder closing the discovery shelf.
// Both thresholds count REAL stores only — the platform's own showcase stores
// (lib/demo-stores.ts) are here to FILL launch mode, so counting them would make
// three of them switch it off and hide themselves along with it.
const liveStoreCount = countRealStores(storesWithProducts.map((s) => s.store));
const launchMode = isLaunchMode(liveStoreCount);
const shelfInvite = !launchMode && showShelfInvite(liveStoreCount);

// What the launch shelf actually holds. Split real vs showcase first, because the
// shelf has to guarantee BOTH are represented alongside an open slot — see
// planLaunchShelf; passing one merged list can't express that.
const launchShelf = planLaunchShelf(
  storesWithProducts.filter((s) => !isDemoStore(s.store)),
  storesWithProducts.filter((s) => isDemoStore(s.store)),
);

// ── "חנויות חדשות" tab (CURRENT_TASK.md → סשן א׳ 4). The open slot belongs on
// this tab more than on any other: a store that doesn't exist yet is the newest
// thing the mall has. So the tab never falls back to a bare empty state while the
// mall is thin — it pads out with placeholder cards in launch mode, and keeps at
// least one of them as long as it would otherwise have nothing to show. Past the
// launch thresholds the shelf is real stores again, plus the same single closing
// invite the discovery shelf already carries.
// MIN_SHELF_INVITES is the floor even when the stores already fill the row — the
// same guarantee planLaunchShelf makes for the discover shelf, and for the same
// reason: the one card that recruits sellers must not vanish the moment enough
// stores exist to fill the slots while launch mode is still on.
const newTabInvites = launchMode
  ? Math.max(MIN_SHELF_INVITES, launchInviteCount(feed.newStores.length))
  : (feed.newStores.length === 0 ? MIN_SHELF_INVITES : (shelfInvite ? 1 : 0));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: platform.name,
  url: platform.url,
  description: platform.description,
};

---

<BaseLayout
  title={t.home.discoverStores}
  description={t.home.browseDesc}
  jsonLd={jsonLd}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
  showSearch={true}
  isHome={true}
  dataLayer={{ event: 'page_view', page_type: 'platform', currency: 'ILS' }}
>

  <!-- ── Hero: brand name (real H1) + one static tagline, same white-surface
       treatment as a store page's own banner (.store-banner), then the rest
       of the page continues on the standard gray background below — same
       banner→content structure, just roomier/centered instead of a thin
       strip, plus a dense repeating dot-pattern layer behind the title.
       The pattern is `bg-fixed`: the dots are pinned to the viewport, so
       scrolling slides the hero over a grid that never itself moves. It
       used to breathe (scale in/out on a 16s loop) — endless motion in
       the corner of the eye, replaced by that stillness. ── -->
  <section class="home-hero relative overflow-hidden bg-[color:var(--color-surface)]">
    <div
      class="home-hero__pattern absolute inset-0 z-0 pointer-events-none opacity-60
             bg-[radial-gradient(circle,var(--color-border)_1.5px,transparent_1.6px)] bg-[length:30px_30px]
             bg-fixed"
      aria-hidden="true"
    ></div>
    <div class="container relative z-[1] pt-12 pb-10 sm:pt-16 sm:pb-12 min-h-[260px] sm:min-h-[340px] flex flex-col items-center justify-center text-center gap-2">
      <h1 class="text-[clamp(1.9rem,5.5vw,3rem)] font-extrabold tracking-[-0.02em] text-[color:var(--color-text)] m-0">{platform.name}</h1>
      <p class="text-[clamp(0.9rem,2vw,1.05rem)] text-[color:var(--color-muted)] m-0">{t.home.heroTagline}</p>
      <div class="flex flex-wrap items-center justify-center gap-x-[1.1rem] gap-y-[0.6rem] mt-[0.6rem]">
        <a href="/stores" class="btn btn--ghost btn--sm">
          {t.home.viewAllStores}
          <svg class="rtl:-scale-x-100" width="11" height="11" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        {!hasStore && (
          <a href="/seller/register" class="btn btn--sm">
            {t.home.heroSellerCta}
            <svg class="rtl:-scale-x-100" width="11" height="11" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <div class="home-body">

  <!-- ── Category browse pill row removed (felt disconnected from the
       tabbed UI below it) — category browsing still lives inside the
       Discover tab's own category shelves. ── -->

  <!-- The tab shell renders at every store count, launch mode included — the
       chrome of a working app is part of looking ready, and an empty
       Liked/Bought tab is the normal state for any first-time visitor anyway. -->
      <!-- ── Tabs: liked / bought-before / new / discover — reuses the seller/
           admin dashboard's own tab shell (dash-tabs/.dash-panel + initDashTabs()
           in scripts/dashboard/ui.ts) so the homepage picks up the "app
           dashboard" underline-tab look for free, no new interaction code.
           .dash-tabs gets its own gutter here (see home.css); .dash-panel
           stays flush (padding-inline:0) since every panel's own content —
           HomeShelf, HomeTabEmpty, the spotlight sections below — already
           self-pads via its own inner .container, same as it always has.

           The strip STICKS under the fixed site header once scrolled to (same
           mechanism as `.seller-dash .dash-tabs`, top = --site-header-h): the
           sticky element is this FULL-BLEED wrapper, not the .container inside
           it — a container-width sticky bar would let the page's content show
           through in the side gutters as it scrolls past. Its containing block
           is .home-body, which spans every panel, so the bar stays pinned for
           the whole tabbed region. z-30 keeps it under the header (z-50) while
           still covering the shelves scrolling beneath it. ── -->
      <!-- `--dash-tab-fade-bg`: initDashTabs() injects two edge-fade overlays into
           every `.dash-tabs`, and each paints the strip's OWN background over the
           tab dissolving under it. The default is `--color-surface`, right for the
           two dashboards; this strip is `--color-bg`, so it was painting white
           over near-white — a fade that measured and toggled correctly while
           being, in practice, no signal at all. That is half of why nothing on a
           375px viewport said a fourth tab existed (CURRENT_TASK.md → סשן ב׳ 1);
           the arrows below are the half that is actually loud enough. -->
      <div id="home-tabs-bar" class="sticky top-[var(--site-header-h,3.4rem)] z-30 bg-[var(--color-bg)] [--dash-tab-fade-bg:var(--color-bg)]">
        <div class="container">
          <!-- The four Hebrew labels need 441px and a 375px viewport gives the
               strip 343, so it scrolls — and a fade alone is a quiet signal on a
               background this light. The arrows are the loud one, and they are
               positioned against THIS wrapper, not the strip: the strip is the
               scroll container, so an absolute child of it would scroll away with
               the tabs. Their show/hide is driven purely off the `at-start`/
               `at-end` classes initDashTabs() already maintains (see home.css), so
               arrows and fades can never disagree — one measurement, two signals,
               the same rule lib/chip-scroller.ts follows for the chip rows.

               `tabindex="-1"`: an arrow at a reached edge is invisible but still
               in the DOM, and a focus stop on something nobody can see is a worse
               outcome than no focus stop at all. Nothing is lost — the tabs are
               already fully operable from the keyboard (arrow keys, and
               activateTab() scrolls the one it lands on into view), so these are
               purely a pointer affordance. They keep their label for AT users
               exploring by touch. -->
          <div class="home-tabs-wrap relative">
            <button
              type="button"
              class="home-tabs-arrow home-tabs-arrow--prev
                w-7 h-7 rounded-full border-[1.5px] border-[color:var(--color-border)]
                bg-[color:var(--color-surface)] text-[color:var(--color-text)]
                flex items-center justify-center cursor-pointer
                [transition:box-shadow_0.15s,opacity_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                hover:shadow-[var(--shadow-hover)]"
              tabindex="-1"
              aria-label={lang === 'he' ? 'הלשוניות הקודמות' : 'Previous tabs'}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" aria-hidden="true"
                   style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </button>
            <!-- `--dash-tab-pad:0` follows the `!px-0` right above it: the fade
                 overlay sizes and insets itself off that variable so it can reach
                 past a padded strip's gutter. At its 1.5rem default on a strip
                 with no padding the gradient began 24px OUTSIDE the strip and was
                 already half-spent by the time it crossed the first tab. -->
            <div class="dash-tabs !px-0 [--dash-tab-pad:0px] relative" role="tablist">
              {tabs.map((tab) => (
                <button
                  class={`dash-tab home-tab${activeTab === tab.id ? ' dash-tab--active' : ''}
                    rounded-[var(--radius-sm)] !border-b-0
                    [transition:color_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                    hover:text-[color:var(--color-text)] active:scale-[0.97]`}
                  role="tab"
                  id={`tab-${tab.id}`}
                  data-panel={tab.id}
                  aria-selected={activeTab === tab.id}
                  tabindex={activeTab === tab.id ? 0 : -1}
                >
                  {tab.label}
                </button>
              ))}
              <span class="home-tabs-indicator" aria-hidden="true"></span>
            </div>
            <button
              type="button"
              class="home-tabs-arrow home-tabs-arrow--next
                w-7 h-7 rounded-full border-[1.5px] border-[color:var(--color-border)]
                bg-[color:var(--color-surface)] text-[color:var(--color-text)]
                flex items-center justify-center cursor-pointer
                [transition:box-shadow_0.15s,opacity_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                hover:shadow-[var(--shadow-hover)]"
              tabindex="-1"
              aria-label={lang === 'he' ? 'הלשוניות הבאות' : 'More tabs'}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" aria-hidden="true"
                   style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <DashTabsBoot />

      <div id="dash-panel-liked" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-liked" hidden={activeTab !== 'liked'}>
        {feed.liked.length > 0
          ? <HomeShelf id="liked" title={t.home.shelfLiked} stores={feed.liked} dotIndex={bgOffset} eagerFirst={activeTab === 'liked'} hideHeading fillMobile />
          : <HomeTabEmpty
              message={isLoggedIn ? t.home.tabEmptyLiked : t.home.tabEmptyLikedGuest}
              ctaLabel={isLoggedIn ? t.home.tabEmptyLikedCta : t.home.tabEmptyLikedGuestCta}
              ctaHref={isLoggedIn ? '/stores' : '/seller/login?next=/'}
            />
        }
      </div>

      <div id="dash-panel-buy-again" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-buy-again" hidden={activeTab !== 'buy-again'}>
        {feed.buyAgain.length > 0
          ? <HomeShelf id="buy-again" title={t.home.shelfBuyAgain} stores={feed.buyAgain} dotIndex={bgOffset} eagerFirst={activeTab === 'buy-again'} hideHeading fillMobile />
          : <HomeTabEmpty message={t.home.tabEmptyBuyAgain} ctaLabel={t.home.tabEmptyLikedCta} ctaHref="/stores" />
        }
      </div>

      <div id="dash-panel-new" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-new" hidden={activeTab !== 'new'}>
        <!-- Deliberately NOT `grid`, even in launch mode (user, 2026-07-29): the
             discover tab's launch shelf is the grid, and when this tab used it too
             the two panels rendered identically and the tabs stopped reading as
             different places. This one stays the horizontal scroll row — the same
             shelf every other tab uses — and only the placeholder cards are new
             here. (Comment sits ABOVE the expression on purpose: a comment between
             the condition and `?` makes the route fail to build, silently in dev.) -->
        {feed.newStores.length > 0 || newTabInvites > 0
          ? <HomeShelf id="new" title={t.home.shelfNew} stores={feed.newStores} invites={newTabInvites}
                       dotIndex={bgOffset} eagerFirst={activeTab === 'new'} hideHeading fillMobile />
          : <HomeTabEmpty message={t.home.tabEmptyNew} ctaLabel={t.home.tabEmptyCtaAll} ctaHref="/stores" />
        }
      </div>

      <div id="dash-panel-discover" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-discover" hidden={activeTab !== 'discover'}>
        {launchMode || discoverHasContent ? (
          <>
            <!-- Launch mode swaps only the SHELVES — the recently-visited and
                 category rows would each be a one-card row at 0-4 stores, which
                 is what actually reads as empty — for a single placeholder-padded
                 shelf. Same treatment the Liked/BuyAgain/New tabs already use:
                 heading hidden (the tab is the heading) and mobile-filling. The
                 spotlight carousel below is NOT skipped: it's the page's one
                 moving element, and one real store is enough to run it. -->
            {launchMode ? (
              <HomeShelf id="launch" title={t.home.discoverStores} stores={launchShelf.stores}
                         invites={launchShelf.invites}
                         eagerFirst={activeTab === 'discover'} hideHeading grid />
            ) : (
              <>
                <!-- ── Recently visited stores (CURRENT_TASK.md → סשן ב׳ 1+3) — a
                     normal SSR StoreCard shelf, resolved server-side from the
                     recent-stores cookie (+ account for a logged-in user). Sits at
                     the very top of the tab, where "עוד לגלות" used to be; only
                     renders when there's history (HomeShelf hides itself on an
                     empty list). ── -->
                <HomeShelf id="recent" title={t.home.recentlyViewed} stores={recentStores} dotIndex={bgOffset}
                           eagerFirst={activeTab === 'discover' && recentStores.length > 0} />

                <!-- ── Category shelves — above the spotlight. "גלה עוד" now renders
                     BELOW the spotlight instead (see after the carousel block). ── -->
                {categoryShelves.map((s, i) => (
                  <HomeShelf id={s.id} title={s.title} stores={s.stores} categoryLabel={s.title} dotIndex={i + 1 + bgOffset} eagerFirst={activeTab === 'discover' && recentStores.length === 0 && s.id === firstEagerShelfId} />
                ))}
              </>
            )}

            <!-- Zero live stores → no spotlight at all. It's built from real
                 stores and real products, and a decorative stand-in band was
                 tried here and rejected (2026-07-28: too wide, foreign to the
                 page's own vocabulary). Don't re-add one — the page is complete
                 without it, and one real store brings the carousel back. -->

            <!-- ── Spotlight: a horizontal carousel of per-store product
                 carousels — one store's full section visible at a time,
                 paged via the compact arrow pair right above the track
                 (store-level paging; each store's own product carousel still
                 scrolls independently inside its slide). Round 4: reverted
                 from a vertical auto-rotating ticker (disliked, no active
                 paging) back to this — visible working controls, and the
                 nav row is kept tight/compact (see home.css) rather than the
                 taller version from round 2 that read as dead space. No
                 visible heading — the "גלה חנויות" tab itself is already the
                 heading; spotlightTitle survives only as the track's
                 accessible name. ── -->
            {feed.spotlight.length > 0 && (
              <div class="container" style="padding-top:1rem">
                {feed.spotlight.length > 1 && (
                  <div class="home-spotlight-nav flex justify-end gap-[0.4rem] mb-2">
                    <button
                      type="button"
                      class="home-spotlight-pause
                        w-8 h-8 rounded-full border-[1.5px] border-[color:var(--color-border)]
                        bg-[color:var(--color-surface)] text-[color:var(--color-text)]
                        flex items-center justify-center cursor-pointer
                        [transition:box-shadow_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                        hover:shadow-[var(--shadow-hover)] active:scale-[0.91]"
                      aria-pressed="false"
                      aria-label={lang === 'he' ? 'השהה החלפה אוטומטית' : 'Pause auto-rotation'}>
                      <svg class="home-spotlight-pause__pause" width="13" height="13" viewBox="0 0 24 24"
                           fill="currentColor" aria-hidden="true">
                        <rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>
                      </svg>
                      <svg class="home-spotlight-pause__play hidden" width="13" height="13" viewBox="0 0 24 24"
                           fill="currentColor" aria-hidden="true">
                        <polygon points="7 4 20 12 7 20"/>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="home-spotlight-arrow home-spotlight-arrow--prev
                        w-8 h-8 rounded-full border-[1.5px] border-[color:var(--color-border)]
                        bg-[color:var(--color-surface)] text-[color:var(--color-text)]
                        flex items-center justify-center cursor-pointer
                        [transition:box-shadow_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                        hover:shadow-[var(--shadow-hover)] active:scale-[0.91]"
                      aria-label={lang === 'he' ? 'החנות הקודמת' : 'Previous store'}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2.5" aria-hidden="true"
                           style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                        <polyline points="15 18 9 12 15 6"/>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="home-spotlight-arrow home-spotlight-arrow--next
                        w-8 h-8 rounded-full border-[1.5px] border-[color:var(--color-border)]
                        bg-[color:var(--color-surface)] text-[color:var(--color-text)]
                        flex items-center justify-center cursor-pointer
                        [transition:box-shadow_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                        hover:shadow-[var(--shadow-hover)] active:scale-[0.91]"
                      aria-label={lang === 'he' ? 'החנות הבאה' : 'Next store'}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2.5" aria-hidden="true"
                           style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                        <polyline points="9 18 15 12 9 6"/>
                      </svg>
                    </button>
                  </div>
                )}
                <div
                  class="home-spotlight-track flex overflow-x-auto [overflow-y:clip] [scroll-snap-type:x_mandatory]
                    [scrollbar-width:none] [-webkit-overflow-scrolling:touch] [&::-webkit-scrollbar]:hidden"
                  role="list" aria-label={t.home.spotlightTitle}
                >
                  {feed.spotlight.map(({ store: s, products }, slideIndex) => (
                    <div class="home-spotlight-slide flex-[0_0_100%] min-w-0 [scroll-snap-align:start]" role="listitem">
                      <section
                        class="home-store-section"
                        data-store-name={s.name.toLowerCase()}
                        data-tagline={(s.tagline || s.description || '').toLowerCase()}
                        aria-labelledby={`sh-${s.slug}`}
                      >
                          <div class="home-section-header">
                            <div class="home-store-section__title-group">
                              <a href={`/${s.slug}`} class="flex items-center gap-2.5" style="color:inherit;text-decoration:none">
                                <StoreAvatar name={s.name} slug={s.slug} profileImage={s.profileImage} size={36} />
                                <h2 id={`sh-${s.slug}`} class="home-section-title hover:text-[var(--color-accent)] transition-colors duration-150">{s.name}</h2>
                              </a>
                              {(s.tagline || s.description) && (
                                <p class="home-store-section__tagline" dir="auto">{s.tagline || s.description}</p>
                              )}
                              <!-- The spotlight is the one surface a shopper can browse a
                                   showcase store's products from without ever seeing its
                                   card or its page, so the label has to be here too — in
                                   the quiet variant, since this header is already busy. -->
                              <StoreDemoBadge demo={s.demo} quiet={true} />
                            </div>
                            <!-- Hover: the same "lift to a white surface" the tab beam
                                 uses, plus the arrow springing a few px the way it
                                 points. `.btn--ghost:hover` fills with --color-bg, which
                                 IS this page's background — invisible here — hence the
                                 `!bg` override to --color-surface. The arrow's translate
                                 needs the rtl branch: `translate` applies in the parent's
                                 coordinate space *after* `rtl:-scale-x-100`'s flip, so it
                                 would otherwise slide against the arrowhead in Hebrew. -->
                            <a
                              href={`/${s.slug}`}
                              class="btn btn--sm btn--ghost group inline-flex items-center gap-1.5 shrink-0
                                [transition:background-color_0.15s,box-shadow_0.18s]
                                hover:!bg-[color:var(--color-surface)] hover:shadow-[var(--shadow-xs)]"
                            >
                              {t.home.visitStore}
                              <svg class="rtl:-scale-x-100 group-hover:translate-x-[3px] rtl:group-hover:-translate-x-[3px]
                                     [transition:translate_0.18s_cubic-bezier(0.34,1.56,0.64,1)]"
                                   width="11" height="11" viewBox="0 0 24 24" fill="none"
                                   stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                              </svg>
                            </a>
                          </div>

                          <div class="home-carousel-wrap">
                            <div class="home-carousel-fade home-carousel-fade--start" aria-hidden="true"></div>
                            <div class="home-carousel-fade home-carousel-fade--end" aria-hidden="true"></div>
                            {products.length > 2 && (
                              <>
                                <button type="button" class="home-carousel-btn home-carousel-btn--prev"
                                        aria-label={lang === 'he' ? 'הקודם' : 'Previous'}>
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                       stroke-width="2.5" aria-hidden="true"
                                       style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                                    <polyline points="15 18 9 12 15 6"/>
                                  </svg>
                                </button>
                                <button type="button" class="home-carousel-btn home-carousel-btn--next"
                                        aria-label={lang === 'he' ? 'הבא' : 'Next'}>
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                       stroke-width="2.5" aria-hidden="true"
                                       style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                                    <polyline points="9 18 15 12 9 6"/>
                                  </svg>
                                </button>
                              </>
                            )}
                            <div class="home-carousel" role="list" aria-label={s.name}>
                              {/* Only the first slide is on screen (each spotlight slide is
                                  100% wide), and only its first few tiles are in view before
                                  the carousel scrolls — those are the LCP candidates, so they
                                  load eagerly. Everything else stays native-lazy. */}
                              {products.map((p, tileIndex) => (
                                <HomeProductCard product={p} storeSlug={s.slug} sale={s.sale} role="listitem"
                                                 priority={slideIndex === 0 && tileIndex < 3} />
                              ))}
                            </div>
                          </div>
                      </section>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- ── "גלה עוד" (renamed from "עוד לגלות") — now BELOW the big
                 carousel (סשן ב׳ follow-up), as a "keep exploring" shelf after
                 the hero spotlight. HomeShelf hides itself when empty. Skipped
                 in launch mode: with under 5 stores it would be the same store
                 cards the launch shelf above already shows, a visible duplicate
                 rather than more to explore. ── -->
            {!launchMode && (
              <HomeShelf id={discoveryShelf.id} title={discoveryShelf.title} stores={discoveryShelf.stores}
                         dotIndex={categoryShelves.length + 1 + bgOffset} invites={shelfInvite ? 1 : 0} />
            )}

            <!-- Nothing closes the discover panel in launch mode, deliberately
                 (2026-07-28). The page still scrolls and still ends on something:
                 the seller CTA card below this panel sits under the fold on its
                 own (measured 1743px page vs a 900px viewport). A cross-store
                 product row was built here and removed the same day — mixing every
                 store's goods into one row reads as a bazaar, which is the opposite
                 of the mall the platform is selling. The only thing missing without
                 it is the card entrance animation, and that is not worth a section.
                 Don't re-add one without a reason that isn't "the page feels short". -->

          </>
        ) : (
          <HomeTabEmpty message={t.home.tabEmptyGeneric} ctaLabel={t.home.tabEmptyCtaAll} ctaHref="/stores" />
        )}
      </div>

  <!-- ── Seller CTA ─────────────────────────────────────────────────── -->
  <!-- Normally only shown to a logged-in visitor without a store (a guest gets
       the hero's own "open a store" link and doesn't need a second pitch) — but
       in launch mode recruiting sellers IS the page's job, so guests see it too.

       Restyled 2026-07-28 (user: "לא שייך לאתר"). Was a full-bleed dark navy
       band with a radial glow and a white shadowed button — a marketing slab
       lifted from a different site, sitting under a page built out of light
       cards. It's now the same surface everything else on this page is: a
       bordered card on the normal background, the standard `.btn`, and no
       colour or shadow that appears nowhere else.

       The copy is deliberately NOT the "open a store in minutes / no code /
       free" script — see the note on `home.startSelling` in translations.ts. -->
  {!hasStore && (isLoggedIn || launchMode) && (
    <section class="home-cta" aria-labelledby="cta-heading">
      <div class="container">
        <div class="home-cta__card">
          <h2 id="cta-heading" class="text-xl sm:text-2xl font-bold leading-tight [color:var(--color-text)] m-0">
            {t.home.startSelling}
          </h2>
          <p class="text-[0.95rem] leading-relaxed [color:var(--color-muted)] max-w-md m-0">
            {t.home.startSellingDesc}
          </p>
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-[0.85rem] font-medium [color:var(--color-text)]" role="list">
            {[t.home.builtInAds, t.home.builtInSeo, t.home.builtInShipping].map((feature) => (
              <li class="flex items-center gap-1.5">
                <svg class="[color:var(--color-accent)]" width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {feature}
              </li>
            ))}
          </ul>
          <a href="/seller/register" class="btn btn--accent mt-1">
            {t.home.openStoreFree}
            <svg class="rtl:-scale-x-100" width="13" height="13" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  </div>{/* .home-body */}

</BaseLayout>

<script>
  import { spawnRipple } from '../lib/ripple.js';
  import { clearLastStore } from '../lib/last-store.js';
  import { initImageSkeletons } from '../lib/img-skeleton.js';
  import { initDashTabs } from '../scripts/dashboard/ui.js';
  // Same JS-driven scroll the dashboard and the store page use — never native
  // smooth-scroll on this RTL site (AI_INSTRUCTIONS → Architecture → Scroll).
  import { animateScrollTo } from '../scripts/dashboard/scroll-utils.js';
  import { playReveal, armBelowFoldReveal } from '../lib/scroll-reveal.js';
  import { initStickyBar } from '../lib/sticky-bar.js';

  // Landing on the platform home is a deliberate exit from any store context —
  // don't let a stale "back to store" pill follow the buyer into checkout/dashboard afterward.
  clearLastStore();

  // Same tab shell the seller/admin dashboards use (click + arrow-key nav,
  // hidden-toggling, ?panel= URL sync via history.replaceState) — reused
  // unchanged, see AI_INSTRUCTIONS.md → Homepage.
  initDashTabs();
  // Marks the tab strip `.is-stuck` while it is pinned under the header, which is
  // what cancels the header's own shadow (header.css) — butted against this bar
  // the header is not covering page content any more.
  initStickyBar(document.getElementById('home-tabs-bar'), 3.4);

  // ── Sliding tab underline (CURRENT_TASK.md → סשן ג׳) — one shared bar that
  // travels the full width of the tab row to the tab that was just ACTIVATED.
  // It deliberately does NOT follow the pointer: what follows the pointer is
  // the hover beam below (home.css → Tab hover beam), so moving across the row
  // can't make the bar dart back and forth. Positioning is by
  // physical rect (left/width), so it's RTL-correct without a dir branch.
  {
    const tablist   = document.querySelector<HTMLElement>('.dash-tabs');
    const indicator = tablist?.querySelector<HTMLElement>('.home-tabs-indicator');
    const homeTabs  = tablist ? Array.from(tablist.querySelectorAll<HTMLElement>('.home-tab')) : [];
    if (tablist && indicator && homeTabs.length) {
      const activeTab = (): HTMLElement =>
        tablist.querySelector<HTMLElement>('.home-tab.dash-tab--active') ?? homeTabs[0];

      function moveIndicatorTo(tab: HTMLElement): void {
        const t = tab.getBoundingClientRect();
        const l = tablist!.getBoundingClientRect();
        indicator!.style.width = `${t.width}px`;
        // `+ scrollLeft` is not a nicety: the indicator is absolutely positioned
        // inside the strip, so it lives in the strip's SCROLLED coordinates,
        // while the two rects are viewport ones. Without it a recompute that
        // happened while the strip was scrolled sideways (resize, late font,
        // tab switch) counted the scroll offset twice and parked the bar a full
        // scroll-width away from its tab — measured 96px off, i.e. under a
        // different tab entirely, on a 375px viewport (2026-07-30). It was
        // unreachable before only because nothing much scrolled this strip;
        // the arrows below make that the normal case. RTL needs no branch —
        // its scrollLeft is negative and the same addition undoes it.
        indicator!.style.transform = `translateX(${t.left - l.left + tablist!.scrollLeft}px)`;
      }

      // Position under the active tab first, *then* reveal — so the bar fades
      // in already in place instead of sliding out of the left:0/width:0 origin.
      moveIndicatorTo(activeTab());
      requestAnimationFrame(() => { moveIndicatorTo(activeTab()); indicator.classList.add('is-ready'); });

      // Keyboard/click activation (and any programmatic tab switch) re-anchors
      // to the new active tab — dashtab:show bubbles up from the shown panel.
      document.addEventListener('dashtab:show', () => moveIndicatorTo(activeTab()));
      // Width of the tabs can shift on resize / late font load.
      new ResizeObserver(() => moveIndicatorTo(activeTab())).observe(tablist);

      // ── Hover beam — hands the pointer's position inside the hovered tab to
      // that tab's own `--beam-x`/`--beam-y`, which is where home.css centres
      // the radial glow (and its transform-origin). One delegated listener on
      // the row, rAF-throttled: pointermove fires far faster than the screen
      // repaints, and each write here dirties a gradient's paint.
      function aimBeam(e: PointerEvent): void {
        const tab = (e.target as HTMLElement).closest<HTMLElement>('.home-tab');
        if (!tab) return;
        const r = tab.getBoundingClientRect();
        tab.style.setProperty('--beam-x', `${e.clientX - r.left}px`);
        tab.style.setProperty('--beam-y', `${e.clientY - r.top}px`);
      }

      let beamFrame = 0;
      let beamEvent: PointerEvent | null = null;
      tablist.addEventListener('pointermove', (e) => {
        beamEvent = e;
        if (beamFrame) return;
        beamFrame = requestAnimationFrame(() => {
          beamFrame = 0;
          if (beamEvent) aimBeam(beamEvent);
        });
      });
      // Aim once, un-throttled, the moment the pointer crosses into a tab — the
      // beam fades in over 0.12s, so waiting for the next rAF would light it at
      // wherever the pointer left this tab last time.
      tablist.addEventListener('pointerover', aimBeam);

      // ── Tab-strip scroll arrows (CURRENT_TASK.md → סשן ב׳ 1) — the four tab
      // labels need 441px and a 375px viewport gives the strip 343, so the last
      // one is off-screen with nothing to say it exists. Show/hide is pure CSS
      // off initDashTabs()'s own at-start/at-end classes (home.css), so all that
      // is left here is the scroll itself.
      // One tab per click, measured live rather than at load: a step in pixels
      // guessed up front lands mid-label the moment the labels differ in width
      // (they range 94–118px here) or the language changes.
      const stripRtl = getComputedStyle(tablist).direction === 'rtl';
      const tabStep = (): number => Math.max(...homeTabs.map((t) => t.offsetWidth));
      const scrollTabs = (towardEnd: boolean): void => {
        // RTL runs scrollLeft negative toward the end, so the sign flips — same
        // mapping lib/chip-scroller.ts makes for the chip rows.
        const dir = towardEnd === stripRtl ? -1 : 1;
        tablist!.scrollBy({ left: dir * tabStep(), behavior: 'smooth' });
      };
      document.querySelector('.home-tabs-arrow--prev')?.addEventListener('click', () => scrollTabs(false));
      document.querySelector('.home-tabs-arrow--next')?.addEventListener('click', () => scrollTabs(true));

      // ── Smooth return to the tab strip on a switch (CURRENT_TASK.md → סשן ב׳ 2)
      // Switching to a shorter panel from far down the page moved the reader in
      // one frame — measured: document 2281px → 812px on an empty tab, so the
      // browser clamped scrollY 1192 → 0 instantly. That is not a scroll the page
      // performs; it is the scroll position falling off the bottom of a document
      // that just got shorter, which is why it reads as a jump rather than as a
      // return to the top.
      //
      // Landing at the top of the tabs is the right outcome (the panel's content
      // starts there), so the fix is to make the page KEEP its height until the
      // reader has actually travelled: freeze .home-body at its current height,
      // let the swap happen underneath, animate up, then release. The listener is
      // on the CAPTURE pass so the freeze is in place before initDashTabs()'s own
      // click handler swaps the panels.
      const homeBody = document.querySelector<HTMLElement>('.home-body');
      const tabsBar = document.getElementById('home-tabs-bar');
      let settling = false;
      if (homeBody && tabsBar) {
        tablist.addEventListener('click', (e) => {
          if (settling || !(e.target as HTMLElement).closest('.home-tab')) return;
          const headerH = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
          // The bar's RESTING position, not its stuck one: while pinned its own
          // rect reports the header's offset, so it is read off .home-body, which
          // starts at the bar and never moves.
          const target = Math.max(0, homeBody.getBoundingClientRect().top + window.scrollY - headerH);
          if (window.scrollY <= target + 2) return; // already there — nothing to smooth
          const outgoing = document.querySelector<HTMLElement>('.dash-panel:not([hidden])')?.offsetHeight ?? 0;
          const frozen = homeBody.offsetHeight;
          const docFrozen = document.documentElement.scrollHeight;
          homeBody.style.minHeight = `${frozen}px`;
          settling = true;
          requestAnimationFrame(() => {
            // How far the released page will actually allow scrolling, worked out
            // by arithmetic rather than by clearing the freeze and re-measuring:
            // that read would relayout the shorter document and let the browser
            // clamp mid-animation — the exact jump being removed.
            const incoming = document.querySelector<HTMLElement>('.dash-panel:not([hidden])')?.offsetHeight ?? 0;
            const maxAfter = Math.max(0, docFrozen - outgoing + incoming - window.innerHeight);
            const dest = Math.min(target, maxAfter);
            // Distance-scaled, not the shared 380ms default: this trip can be
            // 1700px from the bottom of a long Discover tab, and covering that in
            // 380ms is a blur, not a scroll. Capped so a long page never turns the
            // switch into a wait.
            const duration = Math.min(620, 320 + Math.abs(window.scrollY - dest) * 0.14);
            animateScrollTo(dest, duration, () => {
              homeBody.style.minHeight = '';
              settling = false;
            });
          });
        }, true);
      }
    }
  }

  // Scoped to the page's own content (not `document`) so it never reaches
  // into the shared Header/Footer — same boundary store/[slug].astro's own
  // ripple listener draws around `.store-page`. Header buttons (avatar,
  // cart, wishlist, notif bell) are meant to stay ripple-free everywhere.
  document.getElementById('main-content')?.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button, a.btn, a.home-product-card, a.store-card');
    if (btn) spawnRipple(btn, e.clientX, e.clientY);
  });

  // ── Carousel arrows (per store section) + edge fade (shelves/category row) ──
  const isRtl = document.documentElement.dir === 'rtl';
  const STEP  = 240;

  // Logical start/end (not physical left/right — the [dir] split in CSS maps
  // these onto the correct side), computed the same RTL-safe way as the
  // carousel arrows' own show/hide already did (Math.abs handles RTL's
  // negative scrollLeft). No content behind you → no fade at start; no
  // content ahead → no fade at end; nothing to scroll at all → no fade on
  // either side (guards a shelf that already fits without overflowing).
  //
  // EDGE_SLOP must clear the largest resting scroll offset any of these rows
  // parks at, not just sub-pixel rounding: `.home-shelf` carries an 8px
  // `padding-inline` (shadow-bleed room), and scroll-snap rests it at
  // scrollLeft ≈ ±8 even at the true start — a 4px slop read that as "already
  // scrolled" and lit the start fade the moment the page loaded (and, by the
  // mirror check, kept the end fade lit at the true end). 12px clears the 8px
  // park with margin; harmless for the padding-less `.home-carousel`/track.
  const EDGE_SLOP = 12;
  function edgeState(el: HTMLElement): { atStart: boolean; atEnd: boolean } {
    const { scrollLeft, scrollWidth, clientWidth } = el;
    return {
      atStart: Math.abs(scrollLeft) < EDGE_SLOP,
      atEnd: Math.abs(scrollLeft) + clientWidth >= scrollWidth - EDGE_SLOP,
    };
  }

  // `onUpdate` piggybacks on the same scroll/resize triggers (e.g. the
  // carousel's own prev/next arrow visibility) so there's one shared
  // ResizeObserver per element instead of two independent ones. A
  // ResizeObserver (not just a load-time requestAnimationFrame) is what
  // makes this correct across window resize too — shrinking the browser
  // changes clientWidth/scrollWidth, and a stale --fade-* from initial load
  // would otherwise keep showing (or hiding) a fade that no longer matches
  // reality.
  function initEdgeFade(el: HTMLElement, onUpdate?: () => void): void {
    function update(): void {
      const { atStart, atEnd } = edgeState(el);
      // `data-fade` names PHYSICAL sides for the shared `.edge-fade` mask
      // (utilities/utils.css), so map logical start/end here. Empty = no mask,
      // which is what a row that fits should cost.
      const fadeLeft = isRtl ? !atEnd : !atStart;
      const fadeRight = isRtl ? !atStart : !atEnd;
      el.dataset.fade = `${fadeLeft ? 'l' : ''}${fadeRight ? 'r' : ''}`;
      onUpdate?.();
    }
    update();
    el.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(el);
  }

  document.querySelectorAll<HTMLElement>('.home-store-section').forEach((section) => {
    const carousel = section.querySelector<HTMLElement>('.home-carousel');
    const btnPrev  = section.querySelector<HTMLButtonElement>('.home-carousel-btn--prev');
    const btnNext  = section.querySelector<HTMLButtonElement>('.home-carousel-btn--next');
    const fadeStart = section.querySelector<HTMLElement>('.home-carousel-fade--start');
    const fadeEnd   = section.querySelector<HTMLElement>('.home-carousel-fade--end');
    if (!carousel) return;

    function updateArrows(): void {
      const { atStart, atEnd } = edgeState(carousel!);
      if (btnPrev) btnPrev.toggleAttribute('hidden', atStart);
      if (btnNext) btnNext.toggleAttribute('hidden', atEnd);
      fadeStart?.classList.toggle('is-visible', !atStart);
      fadeEnd?.classList.toggle('is-visible', !atEnd);
    }

    carousel.addEventListener('scroll', updateArrows, { passive: true });
    // Run once on load, then again next frame — fonts/images can still shift
    // scrollWidth after the first synchronous measurement, which was showing
    // the prev arrow immediately even before any real scrolling happened.
    updateArrows();
    requestAnimationFrame(updateArrows);

    btnPrev?.addEventListener('click', () => carousel.scrollBy({ left: isRtl ? STEP : -STEP, behavior: 'smooth' }));
    btnNext?.addEventListener('click', () => carousel.scrollBy({ left: isRtl ? -STEP : STEP, behavior: 'smooth' }));
  });

  document.querySelectorAll<HTMLElement>('.home-shelf').forEach((shelf) => initEdgeFade(shelf));

  // ── Spotlight: carousel of per-store carousels — the outer arrows page by
  // one whole store slide (the track's own clientWidth), independent of the
  // per-store product carousels' fixed STEP wired above. Round 4: reverted
  // from a vertical auto-rotating ticker (disliked, no active paging) back
  // to this. Only one such track exists on the page, so no forEach needed.
  {
    const track    = document.querySelector<HTMLElement>('.home-spotlight-track');
    const btnPrev  = document.querySelector<HTMLButtonElement>('.home-spotlight-arrow--prev');
    const btnNext  = document.querySelector<HTMLButtonElement>('.home-spotlight-arrow--next');
    if (track) {
      function updateSpotlightArrows(): void {
        const { atStart, atEnd } = edgeState(track!);
        if (btnPrev) btnPrev.toggleAttribute('hidden', atStart);
        if (btnNext) btnNext.toggleAttribute('hidden', atEnd);
      }
      track.addEventListener('scroll', updateSpotlightArrows, { passive: true });
      updateSpotlightArrows();
      requestAnimationFrame(updateSpotlightArrows);

      btnPrev?.addEventListener('click', () => track.scrollBy({ left: (isRtl ? 1 : -1) * track.clientWidth, behavior: 'smooth' }));
      btnNext?.addEventListener('click', () => track.scrollBy({ left: (isRtl ? -1 : 1) * track.clientWidth, behavior: 'smooth' }));

      // The Discover tab's panel starts `hidden` (display:none, zero width)
      // whenever it isn't the default active tab — the measurement above ran
      // against a zero-width track and both arrows landed on "nothing to
      // scroll" permanently, since initDashTabs() only toggles `hidden` and
      // fires no event. Re-measure once the panel actually becomes visible.
      const discoverPanel = document.getElementById('dash-panel-discover');
      if (discoverPanel) {
        new MutationObserver(() => {
          if (!discoverPanel.hidden) requestAnimationFrame(updateSpotlightArrows);
        }).observe(discoverPanel, { attributes: true, attributeFilter: ['hidden'] });
      }

      // ── Auto-advance (CURRENT_TASK.md → סשן א׳): pages one store at a time,
      // looping back to the start, every few seconds. Paused (not just silently
      // drifting) while the tab is backgrounded or the Discover panel itself
      // isn't the active one, via the same `discoverPanel`/visibilitychange
      // checks the rest of this block already needs.
      //
      // Two extra pause paths (CURRENT_TASK.md → סשן ב׳ 4+5):
      //   • `userPaused` — persistent, toggled by the explicit pause/play
      //     button, and also set when the buyer takes manual control (an arrow,
      //     or a real horizontal scroll of the track / an inner carousel — NOT a
      //     vertical page scroll). Reflected in the button so it can always be
      //     resumed — unlike the old model, which tore the timer down for the
      //     rest of the visit with no way back.
      //   • `hoverPaused` — momentary, held only while the pointer is over a
      //     product card, so a card the buyer is reading/aiming at doesn't
      //     slide out from under them; released on pointer-out.
      const slides = Array.from(track.querySelectorAll<HTMLElement>('.home-spotlight-slide'));
      if (slides.length > 1) {
        const AUTO_ADVANCE_MS = 4500;
        let slideIndex = 0;
        let userPaused = false;
        let hoverPaused = false;
        // Masks the track's OWN auto-advance scroll from the manual-scroll pause
        // below, so the timer never pauses itself. Set true right before each
        // programmatic scroll; cleared once that smooth scroll settles (via the
        // scroll listener), with a fallback in case the target was already the
        // current position and no scroll event ever fires.
        let autoScrolling = false;
        let autoSettleTimer: ReturnType<typeof setTimeout> | undefined;

        setInterval(() => {
          if (document.visibilityState !== 'visible') return;
          if (discoverPanel?.hidden) return;
          if (userPaused || hoverPaused) return;
          slideIndex = (slideIndex + 1) % slides.length;
          autoScrolling = true;
          clearTimeout(autoSettleTimer);
          autoSettleTimer = setTimeout(() => { autoScrolling = false; }, 900);
          // Scroll the track *itself* horizontally to the next slide — never
          // `slide.scrollIntoView()`, which also scrolls the whole page
          // vertically to pull the section into view and yanks the buyer down
          // mid-read on every tick.
          track!.scrollTo({ left: (isRtl ? -1 : 1) * slideIndex * track!.clientWidth, behavior: 'smooth' });
        }, AUTO_ADVANCE_MS);

        // Item 5 — explicit pause/play toggle sitting next to the arrows.
        const btnPause = document.querySelector<HTMLButtonElement>('.home-spotlight-pause');
        const iconPause = btnPause?.querySelector<SVGElement>('.home-spotlight-pause__pause');
        const iconPlay  = btnPause?.querySelector<SVGElement>('.home-spotlight-pause__play');
        const isHe = document.documentElement.lang === 'he';
        function setPaused(paused: boolean): void {
          userPaused = paused;
          if (!btnPause) return;
          btnPause.setAttribute('aria-pressed', String(paused));
          btnPause.setAttribute('aria-label',
            paused ? (isHe ? 'הפעל החלפה אוטומטית' : 'Resume auto-rotation')
                   : (isHe ? 'השהה החלפה אוטומטית' : 'Pause auto-rotation'));
          iconPause?.classList.toggle('hidden', paused);
          iconPlay?.classList.toggle('hidden', !paused);
        }
        btnPause?.addEventListener('click', () => setPaused(!userPaused));

        // Manual paging is a deliberate "I'll drive" signal → persistent pause
        // (resumable via the button). The arrows are explicit; scroll-driven
        // paging is detected off the ACTUAL horizontal scroll of the track
        // (moving between the stores) or of an inner product carousel — never a
        // vertical page scroll, which moves neither container's scrollLeft and
        // so fires no scroll event here. (The bug this replaced was a `wheel`
        // listener that paused on every vertical scroll while merely hovering
        // the carousel.) The track's own auto-advance scroll is masked via
        // `autoScrolling`.
        btnPrev?.addEventListener('click', () => setPaused(true));
        btnNext?.addEventListener('click', () => setPaused(true));
        track.addEventListener('scroll', () => {
          if (autoScrolling) {
            clearTimeout(autoSettleTimer);
            autoSettleTimer = setTimeout(() => { autoScrolling = false; }, 160);
            return;
          }
          setPaused(true);
        }, { passive: true });
        track.querySelectorAll<HTMLElement>('.home-carousel').forEach((c) =>
          c.addEventListener('scroll', () => setPaused(true), { passive: true }));

        // Item 4 — momentary hover pause over a product card. pointerenter/
        // leave don't bubble, so delegate via pointerover/out and confirm the
        // pointer actually crossed a card boundary (relatedTarget check) rather
        // than moving between two children of the same card.
        track.addEventListener('pointerover', (e) => {
          if ((e.target as HTMLElement).closest('.home-product-card')) hoverPaused = true;
        });
        track.addEventListener('pointerout', (e) => {
          const to = e.relatedTarget as HTMLElement | null;
          if (!to || !to.closest('.home-product-card')) hoverPaused = false;
        });
      }
    }
  }

  // Carousel images now carry a real src plus native loading=lazy — the browser defers the
  // off-screen ones itself, and (unlike the IntersectionObserver that used to live
  // here) the visible ones start downloading during HTML parse instead of waiting
  // on this module. See HomeProductCard.astro.

  // ── Skeleton shimmer clear — spotlight product images + store-card
  // preview images — once each actually loads (or errors, so a broken/
  // missing image doesn't shimmer forever). ────────────────────────
  initImageSkeletons('.home-product-card__img-wrap');
  initImageSkeletons('.store-card__preview-img-wrap');

  // ── Card entrance animation (CURRENT_TASK.md → סשן א׳, src/lib/scroll-reveal.ts)
  // — played in two situations: (1) a card still below the fold at load, the
  // first time it scrolls into view; (2) every dash-tab switch, for whatever
  // cards the newly-shown panel contains — replays even for a tab that
  // already played once this visit, since switching tabs is itself a fresh
  // "arrival" per feedback. Cards in a tab panel that isn't active yet
  // measure a zero-height rect at load (`display:none`), so case (1) skips
  // them — case (2) covers them once their tab is actually switched to.
  // `.home-shelf-grid` is launch mode's grid variant of the same row (HomeShelf's
  // `grid` prop) — it isn't a `.home-shelf`, so leaving it out silently dropped
  // the whole launch shelf out of this animation.
  const REVEAL_SELECTOR = '.home-shelf .store-card, .home-shelf-grid .store-card, .home-product-card';
  armBelowFoldReveal(REVEAL_SELECTOR);

  // Tab switch: `dashtab:show` is dispatched by initDashTabs() (scripts/
  // dashboard/ui.ts) on the panel element itself right after it's unhidden.
  document.addEventListener('dashtab:show', (e) => {
    const panel = e.target as HTMLElement;
    const cards = Array.from(panel.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));
    if (cards.length) playReveal(cards);
  });

</script>
