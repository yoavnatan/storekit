---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeShelf from '../components/HomeShelf.astro';
import HomeTabEmpty from '../components/HomeTabEmpty.astro';
import StoreAvatar from '../components/StoreAvatar.astro';
import { store as platform, formatPrice, cdnSrc } from '../config/store.config.js';
import { getSellerSession, getSellerById } from '../lib/seller-auth.js';
import { getStoreBySellerId, getVisibleStores } from '../lib/stores.js';
import { getVisibleProductsByStoreId } from '../lib/store-products.js';
import { getAllOrders } from '../lib/orders.js';
import { buildHomeFeed } from '../lib/home-feed.js';
import { getLang, getT } from '../i18n/index.js';

const sellerId    = getSellerSession(Astro.cookies);
const sellerStore = sellerId ? getStoreBySellerId(sellerId) : null;
const isLoggedIn  = !!sellerId;
const hasStore    = !!sellerStore;

// Admin-blocked stores/products (see admin-moderation.ts) never appear on the
// discovery surfaces — a blocked store's card here would be a live link into
// a page that immediately 404s, and defeats the point of blocking it.
const stores = getVisibleStores();
const lang   = getLang(Astro.cookies);
const t      = getT(lang);

const storesWithProducts = stores
  .map((s) => ({ store: s, products: getVisibleProductsByStoreId(s.id) }))
  .filter(({ products }) => products.length > 0);

// Stores this buyer has actually bought from before, most-recent purchase first — same
// buyerId-or-buyerEmail match the buyer dashboard's own order list uses (accounts are
// unified seller+buyer, and a buyer can check out before ever registering an email match).
const buyerEmail = sellerId ? getSellerById(sellerId)?.email : undefined;
const previousStoreSlugs: string[] = [];
if (sellerId || buyerEmail) {
  const seenSlugs = new Set<string>();
  const myOrders = getAllOrders()
    .filter((o) => o.buyerId === sellerId || (!!buyerEmail && o.buyerEmail === buyerEmail))
    .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
  for (const order of myOrders) {
    for (const item of order.items) {
      if (!seenSlugs.has(item.storeSlug)) { seenSlugs.add(item.storeSlug); previousStoreSlugs.push(item.storeSlug); }
    }
  }
}

// Bounded, varied feed instead of "render every store's full carousel" — see
// src/lib/home-feed.ts for the shelf-selection strategy (was the site's actual
// scaling limit once there are hundreds of stores, not just a style choice).
const feed = buildHomeFeed(storesWithProducts, sellerId, previousStoreSlugs);

// ── Tabs (CURRENT_TASK.md → סשן ג׳, round 2): the old vertical shelf-stack
// is now switchable tabs, reusing the seller/admin dashboard's own tab
// pattern (dash-tabs/.dash-panel + initDashTabs() in scripts/dashboard/ui.ts)
// — see AI_INSTRUCTIONS.md → Homepage for the reasoning. Category shelves +
// spotlight fold unchanged into the "discover" tab.
const TAB_IDS = ['discover', 'liked', 'buy-again', 'new'] as const;
type TabId = typeof TAB_IDS[number];

const discoverShelves = [
  { id: 'discovery', title: t.home.shelfDiscovery, stores: feed.discovery },
  ...feed.categories.map((c, i) => ({ id: `cat-${i}`, title: c.category, stores: c.stores })),
];
const discoverHasContent = discoverShelves.some((s) => s.stores.length > 0) || feed.spotlight.length > 0;

// Discover is both the first tab and the default landing tab (round 3
// feedback) — it's the main browsing surface and always populated whenever
// any store+product exists, unlike Liked/BuyAgain/New which can be empty
// for a guest or new buyer.
const requestedTab = Astro.url.searchParams.get('panel');
const activeTab: TabId = (TAB_IDS as readonly string[]).includes(requestedTab ?? '')
  ? (requestedTab as TabId)
  : 'discover';

const tabs: { id: TabId; label: string }[] = [
  { id: 'discover', label: t.home.discoverStores },
  { id: 'liked', label: t.home.shelfLiked },
  { id: 'buy-again', label: t.home.shelfBuyAgain },
  { id: 'new', label: t.home.shelfNew },
];

// The active tab's own first non-empty shelf gets the eager/high-priority
// image load (today's real LCP element) — every other shelf, including ones
// in inactive (hidden) panels, stays lazy.
const activeTabShelves: { id: string; title: string; stores: typeof feed.liked }[] =
  activeTab === 'liked' ? [{ id: 'liked', title: t.home.shelfLiked, stores: feed.liked }] :
  activeTab === 'buy-again' ? [{ id: 'buy-again', title: t.home.shelfBuyAgain, stores: feed.buyAgain }] :
  activeTab === 'new' ? [{ id: 'new', title: t.home.shelfNew, stores: feed.newStores }] :
  discoverShelves;
const firstEagerShelfId = activeTabShelves.find((s) => s.stores.length > 0)?.id;

// Fresh per visit: each shelf/spotlight title's small accent dot
// (home-shelf-dot--0/1/2, see store-card.css) gets a random starting offset,
// added onto a running index so adjacent titles never repeat the same dot
// color back-to-back.
const bgOffset = Math.floor(Math.random() * 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: platform.name,
  url: platform.url,
  description: platform.description,
};

---

<BaseLayout
  title={t.home.discoverStores}
  description={t.home.browseDesc}
  jsonLd={jsonLd}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
  showSearch={true}
  isHome={true}
  dataLayer={{ event: 'page_view', page_type: 'platform', currency: 'ILS' }}
>

  <!-- ── Hero: brand name (real H1) + one static tagline, same white-surface
       treatment as a store page's own banner (.store-banner), then the rest
       of the page continues on the standard gray background below — same
       banner→content structure, just roomier/centered instead of a thin
       strip, plus a dense repeating dot-pattern layer slowly breathing
       (scale in/out) behind the title (see home.css). ── -->
  <section class="home-hero relative overflow-hidden bg-[color:var(--color-surface)]">
    <div
      class="home-hero__pattern absolute -inset-1/4 w-[150%] h-[150%] z-0 pointer-events-none opacity-60
             bg-[radial-gradient(circle,var(--color-border)_1.5px,transparent_1.6px)] bg-[length:30px_30px]
             animate-[home-hero-pattern-breathe_16s_ease-in-out_infinite] motion-reduce:animate-none"
      aria-hidden="true"
    ></div>
    <div class="container relative z-[1] pt-12 pb-10 sm:pt-16 sm:pb-12 min-h-[260px] sm:min-h-[340px] flex flex-col items-center justify-center text-center gap-2">
      <h1 class="text-[clamp(1.9rem,5.5vw,3rem)] font-extrabold tracking-[-0.02em] text-[color:var(--color-text)] m-0">{platform.name}</h1>
      <p class="text-[clamp(0.9rem,2vw,1.05rem)] text-[color:var(--color-muted)] m-0">{t.home.heroTagline}</p>
      <div class="flex flex-wrap items-center justify-center gap-x-[1.1rem] gap-y-[0.6rem] mt-[0.6rem]">
        <a href="/stores" class="btn btn--ghost btn--sm">
          {t.home.viewAllStores}
          <svg class="rtl:-scale-x-100" width="11" height="11" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        {!hasStore && (
          <a href="/seller/register" class="btn btn--sm">
            {t.home.heroSellerCta}
            <svg class="rtl:-scale-x-100" width="11" height="11" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <div class="home-body">

  <!-- ── Category browse pill row removed (felt disconnected from the
       tabbed UI below it) — category browsing still lives inside the
       Discover tab's own category shelves. ── -->

  {storesWithProducts.length === 0 ? (
    <div class="section container flex flex-col items-center gap-4 py-16 text-center">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           class="opacity-25 text-[var(--color-muted)]" aria-hidden="true">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <p class="text-[var(--color-muted)] text-sm">{t.home.noStores}</p>
      <a href="/seller/register" class="btn">{t.home.openStoreFree}</a>
    </div>
  ) : (
    <>

      <!-- ── Tabs: liked / bought-before / new / discover — reuses the seller/
           admin dashboard's own tab shell (dash-tabs/.dash-panel + initDashTabs()
           in scripts/dashboard/ui.ts) so the homepage picks up the "app
           dashboard" underline-tab look for free, no new interaction code.
           .dash-tabs gets its own gutter here (see home.css); .dash-panel
           stays flush (padding-inline:0) since every panel's own content —
           HomeShelf, HomeTabEmpty, the spotlight sections below — already
           self-pads via its own inner .container, same as it always has. ── -->
      <div class="container">
        <div class="dash-tabs !px-0" role="tablist">
          {tabs.map((tab) => (
            <button
              class={`dash-tab home-tab${activeTab === tab.id ? ' dash-tab--active' : ''}
                rounded-t-[6px] !border-b-0
                [transition:color_0.15s,background-color_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                hover:bg-[color:var(--color-bg)] active:scale-[0.97]`}
              role="tab"
              id={`tab-${tab.id}`}
              data-panel={tab.id}
              aria-selected={activeTab === tab.id}
              tabindex={activeTab === tab.id ? 0 : -1}
            >
              {tab.label}
            </button>
          ))}
        </div>
      </div>

      <div id="dash-panel-liked" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-liked" hidden={activeTab !== 'liked'}>
        {feed.liked.length > 0
          ? <HomeShelf id="liked" title={t.home.shelfLiked} stores={feed.liked} dotIndex={bgOffset} eagerFirst={activeTab === 'liked'} hideHeading fillMobile />
          : <HomeTabEmpty
              message={isLoggedIn ? t.home.tabEmptyLiked : t.home.tabEmptyLikedGuest}
              ctaLabel={isLoggedIn ? t.home.tabEmptyLikedCta : t.home.tabEmptyLikedGuestCta}
              ctaHref={isLoggedIn ? '/stores' : '/seller/login?next=/'}
            />
        }
      </div>

      <div id="dash-panel-buy-again" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-buy-again" hidden={activeTab !== 'buy-again'}>
        {feed.buyAgain.length > 0
          ? <HomeShelf id="buy-again" title={t.home.shelfBuyAgain} stores={feed.buyAgain} dotIndex={bgOffset} eagerFirst={activeTab === 'buy-again'} hideHeading fillMobile />
          : <HomeTabEmpty message={t.home.tabEmptyBuyAgain} ctaLabel={t.home.tabEmptyLikedCta} ctaHref="/stores" />
        }
      </div>

      <div id="dash-panel-new" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-new" hidden={activeTab !== 'new'}>
        {feed.newStores.length > 0
          ? <HomeShelf id="new" title={t.home.shelfNew} stores={feed.newStores} dotIndex={bgOffset} eagerFirst={activeTab === 'new'} hideHeading fillMobile />
          : <HomeTabEmpty message={t.home.tabEmptyNew} ctaLabel={t.home.tabEmptyCtaAll} ctaHref="/stores" />
        }
      </div>

      <div id="dash-panel-discover" class="dash-panel !px-0 !pt-2" role="tabpanel" aria-labelledby="tab-discover" hidden={activeTab !== 'discover'}>
        {discoverHasContent ? (
          <>
            <!-- ── Discovery shuffle + category shelves — unchanged from the old
                 page-level shelf stack, just relocated inside this panel. ── -->
            {discoverShelves.map((s, i) => (
              <HomeShelf id={s.id} title={s.title} stores={s.stores} dotIndex={i + bgOffset} eagerFirst={activeTab === 'discover' && s.id === firstEagerShelfId} />
            ))}

            <!-- ── Spotlight: a horizontal carousel of per-store product
                 carousels — one store's full section visible at a time,
                 paged via the compact arrow pair right above the track
                 (store-level paging; each store's own product carousel still
                 scrolls independently inside its slide). Round 4: reverted
                 from a vertical auto-rotating ticker (disliked, no active
                 paging) back to this — visible working controls, and the
                 nav row is kept tight/compact (see home.css) rather than the
                 taller version from round 2 that read as dead space. No
                 visible heading — the "גלה חנויות" tab itself is already the
                 heading; spotlightTitle survives only as the track's
                 accessible name. ── -->
            {feed.spotlight.length > 0 && (
              <div class="container" style="padding-top:1rem">
                {feed.spotlight.length > 1 && (
                  <div class="home-spotlight-nav flex justify-end gap-[0.4rem] mb-2">
                    <button
                      type="button"
                      class="home-spotlight-arrow home-spotlight-arrow--prev
                        w-8 h-8 rounded-full border-[1.5px] border-[color:var(--color-border)]
                        bg-[color:var(--color-surface)] text-[color:var(--color-text)]
                        flex items-center justify-center cursor-pointer
                        [transition:box-shadow_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                        hover:shadow-[var(--shadow-card-hover)] active:scale-[0.91]"
                      aria-label={lang === 'he' ? 'החנות הקודמת' : 'Previous store'}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2.5" aria-hidden="true"
                           style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                        <polyline points="15 18 9 12 15 6"/>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="home-spotlight-arrow home-spotlight-arrow--next
                        w-8 h-8 rounded-full border-[1.5px] border-[color:var(--color-border)]
                        bg-[color:var(--color-surface)] text-[color:var(--color-text)]
                        flex items-center justify-center cursor-pointer
                        [transition:box-shadow_0.15s,transform_0.13s_cubic-bezier(0.34,1.56,0.64,1)]
                        hover:shadow-[var(--shadow-card-hover)] active:scale-[0.91]"
                      aria-label={lang === 'he' ? 'החנות הבאה' : 'Next store'}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                           stroke-width="2.5" aria-hidden="true"
                           style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                        <polyline points="9 18 15 12 9 6"/>
                      </svg>
                    </button>
                  </div>
                )}
                <div
                  class="home-spotlight-track flex overflow-x-auto [scroll-snap-type:x_mandatory]
                    [scrollbar-width:none] [-webkit-overflow-scrolling:touch] [&::-webkit-scrollbar]:hidden"
                  role="list" aria-label={t.home.spotlightTitle}
                >
                  {feed.spotlight.map(({ store: s, products }) => (
                    <div class="home-spotlight-slide flex-[0_0_100%] min-w-0 [scroll-snap-align:start]" role="listitem">
                      <section
                        class="home-store-section"
                        data-store-name={s.name.toLowerCase()}
                        data-tagline={(s.tagline || s.description || '').toLowerCase()}
                        aria-labelledby={`sh-${s.slug}`}
                      >
                          <div class="home-section-header">
                            <div class="home-store-section__title-group">
                              <a href={`/store/${s.slug}`} class="flex items-center gap-2.5" style="color:inherit;text-decoration:none">
                                <StoreAvatar name={s.name} profileImage={s.profileImage} size={36} />
                                <h2 id={`sh-${s.slug}`} class="home-section-title hover:text-[var(--color-accent)] transition-colors duration-150">{s.name}</h2>
                              </a>
                              {(s.tagline || s.description) && (
                                <p class="home-store-section__tagline" dir="auto">{s.tagline || s.description}</p>
                              )}
                            </div>
                            <a
                              href={`/store/${s.slug}`}
                              class="btn btn--sm btn--ghost inline-flex items-center gap-1.5 shrink-0"
                            >
                              {t.home.visitStore}
                              <svg class="rtl:-scale-x-100" width="11" height="11" viewBox="0 0 24 24" fill="none"
                                   stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                              </svg>
                            </a>
                          </div>

                          <div class="home-carousel-wrap">
                            <div class="home-carousel-fade home-carousel-fade--start" aria-hidden="true"></div>
                            <div class="home-carousel-fade home-carousel-fade--end" aria-hidden="true"></div>
                            {products.length > 2 && (
                              <>
                                <button type="button" class="home-carousel-btn home-carousel-btn--prev"
                                        aria-label={lang === 'he' ? 'הקודם' : 'Previous'}>
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                       stroke-width="2.5" aria-hidden="true"
                                       style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                                    <polyline points="15 18 9 12 15 6"/>
                                  </svg>
                                </button>
                                <button type="button" class="home-carousel-btn home-carousel-btn--next"
                                        aria-label={lang === 'he' ? 'הבא' : 'Next'}>
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                       stroke-width="2.5" aria-hidden="true"
                                       style={lang === 'he' ? 'transform:scaleX(-1)' : ''}>
                                    <polyline points="9 18 15 12 9 6"/>
                                  </svg>
                                </button>
                              </>
                            )}
                            <div class="home-carousel" role="list" aria-label={s.name}>
                              {products.map((p) => (
                                <a
                                  href={`/store/${s.slug}`}
                                  class="home-product-card card"
                                  role="listitem"
                                  aria-label={`${p.name} — ${formatPrice(p.price)}`}
                                >
                                  <div class={`home-product-card__img-wrap${p.images?.[0] ? ' is-loading' : ''}`}>
                                    {p.images?.[0]
                                      ? <img
                                          data-lazy-src={cdnSrc(p.images[0])}
                                          alt={p.name}
                                          width="300"
                                          height="300"
                                          class="home-product-card__img"
                                        />
                                      : <span class="home-product-card__initial" aria-hidden="true">
                                          {p.name[0]?.toUpperCase() ?? '?'}
                                        </span>
                                    }
                                  </div>
                                  <div class="home-product-card__body">
                                    <span class="home-product-card__name" dir="auto">{p.name}</span>
                                    <span class="home-product-card__price">{formatPrice(p.price)}</span>
                                  </div>
                                </a>
                              ))}
                            </div>
                          </div>
                      </section>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        ) : (
          <HomeTabEmpty message={t.home.tabEmptyGeneric} ctaLabel={t.home.tabEmptyCtaAll} ctaHref="/stores" />
        )}
      </div>
    </>
  )}

  <!-- ── Seller CTA ─────────────────────────────────────────────────── -->
  {isLoggedIn && !hasStore && (
    <section class="home-cta" aria-labelledby="cta-heading">
      <div class="home-cta__glow" aria-hidden="true"></div>
      <div class="container home-cta__inner">
        <div class="flex flex-col gap-3 text-center">
          <h2 id="cta-heading" class="text-2xl sm:text-3xl font-bold text-white leading-tight">
            {t.home.startSelling}
          </h2>
          <p class="text-white/65 text-base max-w-sm mx-auto">{t.home.startSellingDesc}</p>
        </div>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-white/55" role="list">
          <li class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.freeToStart}
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.ownStorefront}
          </li>
          <li class="flex items-center gap-1.5">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {t.home.builtInSeo}
          </li>
        </ul>
        <a
          href="/seller/register"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm
                 transition-all duration-150 active:scale-[0.97]"
          style="background:#fff;color:var(--color-primary);box-shadow:0 4px 18px rgba(0,0,0,0.22)"
          onmouseover="this.style.background='rgba(255,255,255,0.92)'"
          onmouseout="this.style.background='#fff'"
        >
          {t.home.openStoreFree}
          <svg class="rtl:-scale-x-100" width="13" height="13" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </section>
  )}

  </div>{/* .home-body */}

</BaseLayout>

<script>
  import { spawnRipple } from '../lib/ripple.js';
  import { clearLastStore } from '../lib/last-store.js';
  import { initImageSkeletons } from '../lib/img-skeleton.js';
  import { initDashTabs } from '../scripts/dashboard/ui.js';
  import { playReveal, armBelowFoldReveal } from '../lib/scroll-reveal.js';

  // Landing on the platform home is a deliberate exit from any store context —
  // don't let a stale "back to store" pill follow the buyer into checkout/dashboard afterward.
  clearLastStore();

  // Same tab shell the seller/admin dashboards use (click + arrow-key nav,
  // hidden-toggling, ?panel= URL sync via history.replaceState) — reused
  // unchanged, see AI_INSTRUCTIONS.md → Homepage.
  initDashTabs();

  // Scoped to the page's own content (not `document`) so it never reaches
  // into the shared Header/Footer — same boundary store/[slug].astro's own
  // ripple listener draws around `.store-page`. Header buttons (avatar,
  // cart, wishlist, notif bell) are meant to stay ripple-free everywhere.
  document.getElementById('main-content')?.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button, a.btn, a.home-product-card, a.store-card');
    if (btn) spawnRipple(btn, e.clientX, e.clientY);
  });

  // ── Carousel arrows (per store section) + edge fade (shelves/category row) ──
  const isRtl = document.documentElement.dir === 'rtl';
  const STEP  = 240;
  const FADE_SIZE = 24; // px — matches the mask stop distance in store-card.css

  // Logical start/end (not physical left/right — the [dir] split in CSS maps
  // these onto the correct side), computed the same RTL-safe way as the
  // carousel arrows' own show/hide already did (Math.abs handles RTL's
  // negative scrollLeft). No content behind you → no fade at start; no
  // content ahead → no fade at end; nothing to scroll at all → no fade on
  // either side (guards a shelf that already fits without overflowing).
  function edgeState(el: HTMLElement): { atStart: boolean; atEnd: boolean } {
    const { scrollLeft, scrollWidth, clientWidth } = el;
    return {
      atStart: Math.abs(scrollLeft) < 4,
      atEnd: Math.abs(scrollLeft) + clientWidth >= scrollWidth - 4,
    };
  }

  // `onUpdate` piggybacks on the same scroll/resize triggers (e.g. the
  // carousel's own prev/next arrow visibility) so there's one shared
  // ResizeObserver per element instead of two independent ones. A
  // ResizeObserver (not just a load-time requestAnimationFrame) is what
  // makes this correct across window resize too — shrinking the browser
  // changes clientWidth/scrollWidth, and a stale --fade-* from initial load
  // would otherwise keep showing (or hiding) a fade that no longer matches
  // reality.
  function initEdgeFade(el: HTMLElement, onUpdate?: () => void): void {
    function update(): void {
      const { atStart, atEnd } = edgeState(el);
      el.style.setProperty('--fade-start', atStart ? '0px' : `${FADE_SIZE}px`);
      el.style.setProperty('--fade-end', atEnd ? '0px' : `${FADE_SIZE}px`);
      onUpdate?.();
    }
    update();
    el.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(el);
  }

  document.querySelectorAll<HTMLElement>('.home-store-section').forEach((section) => {
    const carousel = section.querySelector<HTMLElement>('.home-carousel');
    const btnPrev  = section.querySelector<HTMLButtonElement>('.home-carousel-btn--prev');
    const btnNext  = section.querySelector<HTMLButtonElement>('.home-carousel-btn--next');
    const fadeStart = section.querySelector<HTMLElement>('.home-carousel-fade--start');
    const fadeEnd   = section.querySelector<HTMLElement>('.home-carousel-fade--end');
    if (!carousel) return;

    function updateArrows(): void {
      const { atStart, atEnd } = edgeState(carousel!);
      if (btnPrev) btnPrev.toggleAttribute('hidden', atStart);
      if (btnNext) btnNext.toggleAttribute('hidden', atEnd);
      fadeStart?.classList.toggle('is-visible', !atStart);
      fadeEnd?.classList.toggle('is-visible', !atEnd);
    }

    carousel.addEventListener('scroll', updateArrows, { passive: true });
    // Run once on load, then again next frame — fonts/images can still shift
    // scrollWidth after the first synchronous measurement, which was showing
    // the prev arrow immediately even before any real scrolling happened.
    updateArrows();
    requestAnimationFrame(updateArrows);

    btnPrev?.addEventListener('click', () => carousel.scrollBy({ left: isRtl ? STEP : -STEP, behavior: 'smooth' }));
    btnNext?.addEventListener('click', () => carousel.scrollBy({ left: isRtl ? -STEP : STEP, behavior: 'smooth' }));
  });

  document.querySelectorAll<HTMLElement>('.home-shelf').forEach((shelf) => initEdgeFade(shelf));

  // ── Spotlight: carousel of per-store carousels — the outer arrows page by
  // one whole store slide (the track's own clientWidth), independent of the
  // per-store product carousels' fixed STEP wired above. Round 4: reverted
  // from a vertical auto-rotating ticker (disliked, no active paging) back
  // to this. Only one such track exists on the page, so no forEach needed.
  {
    const track    = document.querySelector<HTMLElement>('.home-spotlight-track');
    const btnPrev  = document.querySelector<HTMLButtonElement>('.home-spotlight-arrow--prev');
    const btnNext  = document.querySelector<HTMLButtonElement>('.home-spotlight-arrow--next');
    if (track) {
      function updateSpotlightArrows(): void {
        const { atStart, atEnd } = edgeState(track!);
        if (btnPrev) btnPrev.toggleAttribute('hidden', atStart);
        if (btnNext) btnNext.toggleAttribute('hidden', atEnd);
      }
      track.addEventListener('scroll', updateSpotlightArrows, { passive: true });
      updateSpotlightArrows();
      requestAnimationFrame(updateSpotlightArrows);

      btnPrev?.addEventListener('click', () => track.scrollBy({ left: (isRtl ? 1 : -1) * track.clientWidth, behavior: 'smooth' }));
      btnNext?.addEventListener('click', () => track.scrollBy({ left: (isRtl ? -1 : 1) * track.clientWidth, behavior: 'smooth' }));

      // The Discover tab's panel starts `hidden` (display:none, zero width)
      // whenever it isn't the default active tab — the measurement above ran
      // against a zero-width track and both arrows landed on "nothing to
      // scroll" permanently, since initDashTabs() only toggles `hidden` and
      // fires no event. Re-measure once the panel actually becomes visible.
      const discoverPanel = document.getElementById('dash-panel-discover');
      if (discoverPanel) {
        new MutationObserver(() => {
          if (!discoverPanel.hidden) requestAnimationFrame(updateSpotlightArrows);
        }).observe(discoverPanel, { attributes: true, attributeFilter: ['hidden'] });
      }

      // ── Auto-advance (CURRENT_TASK.md → סשן א׳): pages one store at a time,
      // looping back to the start, every few seconds — until the buyer pages
      // through it themselves (an arrow click or a direct swipe/drag/wheel on
      // the track), which stops it for the rest of the visit. Paused (not
      // just silently drifting) while the tab is backgrounded or the Discover
      // panel itself isn't the active one, via the same `discoverPanel`/
      // visibilitychange checks the rest of this block already needs.
      const slides = Array.from(track.querySelectorAll<HTMLElement>('.home-spotlight-slide'));
      if (slides.length > 1) {
        const AUTO_ADVANCE_MS = 4500;
        let slideIndex = 0;
        let autoAdvanceTimer: ReturnType<typeof setInterval> | null = setInterval(() => {
          if (document.visibilityState !== 'visible') return;
          if (discoverPanel?.hidden) return;
          slideIndex = (slideIndex + 1) % slides.length;
          slides[slideIndex]!.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        }, AUTO_ADVANCE_MS);

        function stopAutoAdvance(): void {
          if (autoAdvanceTimer === null) return;
          clearInterval(autoAdvanceTimer);
          autoAdvanceTimer = null;
        }
        track.addEventListener('pointerdown', stopAutoAdvance, { once: true });
        track.addEventListener('wheel', stopAutoAdvance, { once: true, passive: true });
        btnPrev?.addEventListener('click', stopAutoAdvance, { once: true });
        btnNext?.addEventListener('click', stopAutoAdvance, { once: true });
      }
    }
  }

  // ── Carousel lazy loading (IntersectionObserver) ─────────────────
  {
    const lazyObs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const img = entry.target as HTMLImageElement;
        const src = img.dataset.lazySrc ?? '';
        if (src) {
          img.src = src;
          img.removeAttribute('data-lazy-src');
        }
        lazyObs.unobserve(img);
      });
    }, { rootMargin: '200px 400px 200px 400px', threshold: 0 });

    document.querySelectorAll<HTMLImageElement>('img[data-lazy-src]')
      .forEach((img) => lazyObs.observe(img));
  }

  // ── Skeleton shimmer clear — spotlight product images + store-card
  // preview images — once each actually loads (or errors, so a broken/
  // missing image doesn't shimmer forever). ────────────────────────
  initImageSkeletons('.home-product-card__img-wrap');
  initImageSkeletons('.store-card__preview-img-wrap');

  // ── Card entrance animation (CURRENT_TASK.md → סשן א׳, src/lib/scroll-reveal.ts)
  // — played in two situations: (1) a card still below the fold at load, the
  // first time it scrolls into view; (2) every dash-tab switch, for whatever
  // cards the newly-shown panel contains — replays even for a tab that
  // already played once this visit, since switching tabs is itself a fresh
  // "arrival" per feedback. Cards in a tab panel that isn't active yet
  // measure a zero-height rect at load (`display:none`), so case (1) skips
  // them — case (2) covers them once their tab is actually switched to.
  const REVEAL_SELECTOR = '.home-shelf .store-card, .home-product-card';
  armBelowFoldReveal(REVEAL_SELECTOR);

  // Tab switch: `dashtab:show` is dispatched by initDashTabs() (scripts/
  // dashboard/ui.ts) on the panel element itself right after it's unhidden.
  document.addEventListener('dashtab:show', (e) => {
    const panel = e.target as HTMLElement;
    const cards = Array.from(panel.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));
    if (cards.length) playReveal(cards);
  });

</script>
