---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreAvatar from '../../components/StoreAvatar.astro';
import { getSellerSession, getSellerById } from '../../lib/seller-auth.js';
import { getStoresBySellerId, getStoresByIds } from '../../lib/stores.js';
import { getOrdersByBuyer } from '../../lib/orders.js';
import { getBuyerInvoiceUrls } from '../../lib/invoicing/buyer-invoice.js';
import { getThreadRootsByBuyer, getRepliesForMessages } from '../../lib/messages.js';
import { getUnreadSellerReplyCount } from '../../lib/notifications.js';
import { getLang, getT } from '../../i18n/index.js';
import { cdnThumb } from '../../lib/cdn.js';
import { filterBuyerPurchases, parseBuyerOrderQuery, BUYER_ORDER_PAGE_SIZE } from '../../lib/buyer-orders-query.js';
import { groupBuyerPurchases, countBuyerPurchases } from '../../lib/buyer-purchases.js';
import { paginate, parsePage } from '../../lib/pagination.js';
import { storeSliceTotalAgorot } from '../../lib/order-totals.js';

const userId = getSellerSession(Astro.cookies);
if (!userId) return Astro.redirect(`/seller/login?next=/buyer/dashboard`);

const seller = await getSellerById(userId);
if (!seller) return Astro.redirect(`/seller/login?next=/buyer/dashboard`);

const lang = getLang(Astro.cookies);
const t = getT(lang);

// **Two levels, not six round trips (2026-08-03).** Everything this page reads depends either on
// the account id — already in hand — or on the thread roots. Awaited one after another they were
// six network hops in series behind a login, which is the same shape the homepage, the store page
// and the product feed all carried (DB_MIGRATION_PLAN.md §8): free as file reads, a round trip each
// as queries. Grouping them by what they actually depend on takes the page to two.
//
// Level 1 — needs nothing but the signed-in account.
//   `getOrdersByBuyer` is one WHERE for this buyer, newest-first out of the query (orders.ts); it
//   used to read every order on the platform to render one person's page. The thread roots are
//   narrowed and ordered in SQL for the same reason.
const [storesOfSeller, orders, messages, unreadMessages] = await Promise.all([
  getStoresBySellerId(userId),
  getOrdersByBuyer(userId, seller.email),
  getThreadRootsByBuyer(userId),
  getUnreadSellerReplyCount(userId),
]);
const hasStore = storesOfSeller.length > 0;

// One card per PURCHASE, not per store — a two-store basket was one click and one payment, so it
// is one order here even though checkout writes a row per store (buyer-purchases.ts).
const purchases = groupBuyerPurchases(orders);
// The same function `/api/buyer/orders` answers with, so the figures this paints cannot disagree
// with the ones a tab refresh writes over them (buyer-purchases.ts#countBuyerPurchases).
const { active: activeOrdersCount, history: historyOrdersCount } = countBuyerPurchases(purchases);

const buyerOrderQuery = parseBuyerOrderQuery(Astro.url.searchParams);
const filteredOrders = filterBuyerPurchases(purchases, buyerOrderQuery);
const ordersPageResult = paginate(filteredOrders, parsePage(Astro.url.searchParams, 'opage'), BUYER_ORDER_PAGE_SIZE);
// The invoices the sellers on this page have uploaded, keyed by the order slice they belong to. One
// query for the page rather than one per slice, and only for the ids actually being rendered — the
// buyer's list is paginated, so the other pages' documents are nobody's business here either.
const invoiceUrlByOrderId = await getBuyerInvoiceUrls(
  ordersPageResult.items.flatMap((p) => p.slices.map((s) => s.order.id)),
);
const ordersEmptyMessage = buyerOrderQuery.q
  ? t.buyerDashboard.ordersSearchEmpty
  : (buyerOrderQuery.history ? t.buyerDashboard.ordersEmptyHistory : t.buyerDashboard.ordersEmptyActive);

// Level 2 — the two reads that genuinely need the thread roots first. Every root's replies come
// back in ONE statement (this used to query once per thread), and the stores are only the ones
// this buyer's own threads point at — that read EVERY store on the platform to resolve a handful
// of avatars (§3).
const [messageReplies, threadStores] = await Promise.all([
  getRepliesForMessages(messages.map((m) => m.id)),
  getStoresByIds(messages.map((m) => m.toStoreId).filter(Boolean)),
]);
// Same formula as each row's own hasUnreadReply below — sorting/filtering by
// read-status is only meaningful when there's actually a mix of both.
const unreadThreadsCount = messages.filter((m) =>
  (messageReplies[m.id] ?? []).some((r) => r.fromUserId !== userId && !r.readByBuyer)
).length;
const showMsgStatusControls = unreadThreadsCount > 0 && unreadThreadsCount < messages.length;

const storeProfileById = new Map(threadStores.map((s) => [s.id, s.profileImage]));
const storeSlugById = new Map(threadStores.map((s) => [s.id, s.slug]));

const dateLocale = lang === 'he' ? 'he-IL' : 'en-US';
function fmtDate(iso: string) {
  return new Date(iso).toLocaleString(dateLocale, { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
}
function fmtPrice(n: number) {
  return `${n.toLocaleString('he-IL')} ₪`;
}
/** Integer agorot → ILS on screen. Order amounts are agorot since the `orders` migration
 *  (lib/orders.ts); handing one to `fmtPrice` prints a figure a hundred times too big. */
function fmtAgorot(agorot: number) {
  return fmtPrice(agorot / 100);
}

// Every status the Order type has, `cancelled` included — it was the one missing entry, so a
// cancelled order printed the raw English word to the buyer (fixed 2026-08-05).
const shipLabel: Record<string, string> = {
  pending: t.buyerDashboard.shippingPending,
  processing: t.buyerDashboard.shippingProcessing,
  ready: t.buyerDashboard.shippingReady,
  shipped: t.buyerDashboard.shippingShipped,
  delivered: t.buyerDashboard.shippingDelivered,
  cancelled: t.buyerDashboard.shippingCancelled,
};

/** How many stores the collapsed card names before it starts counting. Two fits the narrowest
 *  card at 375px with room for the count, and a third name is what pushed the old version into
 *  a mid-word CSS ellipsis. Twinned in the client renderer below. */
const STORES_NAMED = 2;
---

{/* storeMode isn't "this is a store" — it is the flag Header.astro uses to pick its ONE row
    mechanism. See the note in checkout/success.astro: this page and that one were the only two
    still building the header from the old `container between flex` branch, so the bar's bottom
    edge and row spacing changed the moment a buyer arrived here from anywhere else. */}
<BaseLayout
  title={t.buyerDashboard.pageTitle}
  noindex={true}
  isLoggedIn={true}
  hasStore={hasStore}
  storeMode={true}
  hideNav={true}
  showSearch={true}
>
  <style is:global>
    /* is:global — order cards, message rows etc. are rebuilt client-side via
       innerHTML (pagination/search/sub-tab AJAX, live-poll inserts). Astro's
       default scoping rewrites every selector here to also require a
       per-build data-astro-cid-* attribute, which raw innerHTML markup never
       carries — that mismatch silently drops ALL of this file's styling on
       any AJAX-rebuilt element (looks like plain unstyled text). Same fix
       already applied to seller/dashboard.astro's own <style> for the exact
       same reason. Classnames are file-specific-prefixed (my-/o-/m-/prof-)
       so global scope doesn't risk colliding with other pages. */
    /* ── Desktop layout ── */
    .my-page {
      max-width: var(--max-width);
      margin-inline: auto;
      padding: 2rem 1.5rem 4rem;
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 1.25rem;
      align-items: start;
    }

    /* ── Sidebar ── */
    /* display:contents on desktop — the wrapper is invisible to the grid so
       .my-sidebar participates directly as the 220px grid column; it only
       becomes a real (clipping) box inside the mobile media query below. */
    .my-sidebar-clip { display: contents; }
    .my-sidebar { position: sticky; top: 5rem; /* fallback estimate; JS below sets the exact fractional px so it doesn't jump when it engages */ }

    /* Grid items default to min-width:auto (their content's max-content size).
       .o-items below is white-space:nowrap, so a long order's item list can
       force this 1fr column — and the whole page — wider than the viewport
       at any width above the mobile breakpoint, not just on mobile. */
    .my-content-wrap { min-width: 0; }

    .my-user-card {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 0.9rem 1rem;
      margin-bottom: 0.5rem;
    }
    .my-user-info { min-width: 0; }
    .my-avatar {
      width: 2rem; height: 2rem; border-radius: 50%;
      background: var(--color-bg); border: 1px solid var(--color-border);
      display: flex; align-items: center; justify-content: center;
      color: var(--color-muted); flex-shrink: 0;
    }
    .my-name  { font-size: 0.83rem; font-weight: 600; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .my-email { font-size: 0.72rem; color: var(--color-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }

    .my-nav {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 0.4rem;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .my-nav-btn {
      display: flex; align-items: center; gap: 0.5rem;
      width: 100%; padding: 0.5rem 0.65rem;
      border-radius: var(--radius); border: none; background: none;
      font-size: 0.855rem; font-weight: 500; color: var(--color-muted);
      cursor: pointer; font-family: inherit; text-align: start;
      transition: background 0.1s, color 0.1s;
      position: relative;
    }
    .my-nav-btn:hover { background: var(--color-bg); color: var(--color-text); }
    .my-nav-btn.is-active { background: var(--color-bg); color: var(--color-text); font-weight: 600; }
    .my-nav-btn svg { flex-shrink: 0; }
    .my-nav-label { flex: 1; }
    .my-nav-badge {
      font-size: 0.7rem; color: var(--color-muted);
    }

    /* ── Mobile drawer ── */
    .my-drawer-backdrop {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.35);
      z-index: 98;
      backdrop-filter: blur(1px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.26s ease;
    }
    .my-drawer-close { display: none; }
    .my-topbar-dock { display: none; }

    @media (max-width: 768px) {
      .my-page {
        grid-template-columns: 1fr;
        padding: 0 0 3rem;
        gap: 0;
      }

      /* The dock is the sticky element, not the bar itself: the bar floats
         inside it as a card (same recipe as the sidebar's .my-nav — surface,
         1px border, radius-lg, and no shadow either). Sticky is NOT by itself a
         reason for one: the dock around this bar is painted opaque in the page's
         own --color-bg, so nothing is ever visible sliding under the card — the
         dock hides it first. A shadow here would be drawing a gap that does not
         exist (user, 2026-08-01). Elevation rule: base/tokens.css. The wrapper earns its place because its
         rest position IS its stuck position, so the card never shifts — not
         even on the first pixel of scroll, which a card with its own top
         margin would. Its padding also sets the card's inset: inline padding
         matches .my-content-wrap's so the card lines up with the panel below,
         and the total height ≈ the old bar + its margin, so the main panel
         keeps its position.
         It is PAINTED in the page's own background colour, and that is the whole
         point of the wrapper (settled 2026-07-30 after trying it both ways):
         `--color-bg` is not an added grey surface, it is exactly what sits behind
         the panel everywhere else on the page, so the area around the card looks
         like ordinary page while the card is pinned. Left transparent instead, the
         page scrolls through the gap and past the card's sides — which reads as a
         second card sliding under the first, and a slice of half-cut text pinned
         under the site header. Don't remove the background without also removing
         the gap, and removing the gap glues the card to the header. */
      .my-topbar-dock {
        display: block;
        position: sticky;
        top: 3.3rem; /* fallback estimate; JS below sets the exact fractional px so there's no seam */
        z-index: 40;
        /* No padding, and no background either (2026-08-02, full-bleed pass) —
           read the long note above and then this, because this retires most of
           it. Every argument up there is an argument about a FLOATING CARD: it
           needed a gap so it would not glue to the site header, and that gap had
           to be painted --color-bg so the page could not be seen scrolling
           through it and past the card's sides. The bar is not a card any more.
           It spans the full width and is opaque, so there is no gap for anything
           to show through and no sides to slide past — the two grey stripes those
           rules produced were the last trace of a shape that no longer exists
           (user, 2026-08-02: "אפשר להעיף את הפסים האפורים... אם היא כבר תופסת
           את כל הרוחב"). The background went with the padding rather than being
           kept "just in case": at zero inset this box is exactly the bar's box,
           so it could only ever paint underneath an opaque bar.

           The dock itself stays. It is the sticky element, and the JS below
           writes the exact fractional `top` onto it by id. */
        padding: 0;
      }
      .my-topbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem;
        background: var(--color-surface);
        /* Block borders only, no radius: a rounded card touching both screen
           edges reads as clipped, and side borders at the edge are a hairline
           nobody can tell from a rendering seam. The bar keeps its own 0.4rem
           of padding rather than adopting the 0.8rem page gutter — that padding
           is the hamburger's tap target, and the button is 2rem around a 15px
           icon, so the ICON already lands ~15px in, within a couple of pixels
           of the panel text below. Aligning the boxes would have pushed the
           icon visibly further in than the text it sits above.

           Bottom border only. With the dock's padding gone the bar sits flush
           under the site header, which is the same --color-surface and already
           draws its own 1px rule underneath itself (components/header.css: "the
           1px border is the whole separation"). A top border here would stack a
           second hairline against that one. */
        border: 0;
        border-bottom: 1px solid var(--color-border);
        border-radius: 0;
      }
      .my-topbar-title {
        /* Intentionally not flex:1 — only the button and this text itself
           should be clickable, not the rest of the bar's empty space. */
        font-size: 0.9rem; font-weight: 700; color: var(--color-text);
        cursor: pointer; padding-inline-end: 0.35rem;
      }
      /* The sticky topbar's title takes over as the single mobile heading —
         each panel's own <h1> would otherwise duplicate it right below. */
      .panel-head { display: none; }
      .my-menu-btn {
        display: flex; align-items: center; justify-content: center;
        width: 2rem; height: 2rem;
        border-radius: var(--radius); border: none;
        background: none; cursor: pointer;
        color: var(--color-muted); flex-shrink: 0;
        transition: background 0.1s, color 0.1s;
      }
      .my-menu-btn:hover { background: var(--color-bg); color: var(--color-text); }

      /* Clips the off-canvas drawer to the viewport. .my-sidebar itself stays
         position:fixed for correct in-place positioning at any scroll offset,
         but a translateX(100%) fixed box still counts toward the document's
         scrollable width on mobile (confirmed: it pushed scrollWidth past the
         viewport even with overflow-x:hidden on <html>, which only guards
         normal in-flow overflow, not this). The transform below turns this
         wrapper into the containing block for the fixed child (per spec) so
         its own overflow:hidden actually clips it — inset:0 keeps the clip
         box identical to the true viewport, so positioning is unaffected. */
      .my-sidebar-clip {
        display: block;
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        transform: translateZ(0);
        z-index: 99;
      }

      .my-sidebar {
        position: fixed;
        right: 0; top: 0; bottom: 0;
        width: 230px;
        background: var(--color-surface);
        pointer-events: auto;
        padding: 1.25rem 0.75rem 2rem;
        box-shadow: var(--shadow-sheet);
        transform: translateX(100%);
        visibility: hidden;
        transition: transform 0.26s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0s 0.26s;
        overflow-y: auto;
      }
      .my-sidebar.is-open {
        transform: translateX(0);
        visibility: visible;
        transition: transform 0.26s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0s 0s;
      }

      .my-drawer-backdrop.is-open { opacity: 1; pointer-events: auto; }

      .my-drawer-close {
        display: flex; align-items: center; justify-content: center;
        width: 1.8rem; height: 1.8rem;
        border-radius: var(--radius-sm); border: 1px solid var(--color-border);
        background: none; cursor: pointer; color: var(--color-muted);
        margin-bottom: 1rem; margin-inline-start: auto;
      }

      /* .my-content-wrap had `padding: 0 0.85rem` here — deleted, not zeroed.
         Its base rule sets only min-width, so a `padding: 0` would have
         overridden nothing; the gutter now lives on .my-panel below. */
    }

    /* ── Panels ── */
    .my-panel { display: none; }
    .my-panel.is-active {
      display: block;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.5rem;
    }

    /* The panel is where the mobile width actually went: 1.5rem of its own
       padding plus 0.85rem of .my-content-wrap's meant ~38px of chrome per side
       before a word of content, a fifth of a 375px screen. Full-bleed drops that
       to the single 0.8rem gutter — the same value the seller dashboard uses, so
       the two shells read as one system.

       This is a SECOND media block, deliberately, not a line inside the one
       above: `.my-panel.is-active` is (0,2,0), and the rule it has to beat is
       the identical selector directly above it. Same specificity means source
       order decides, and the mobile block sits ~100 lines EARLIER in this file —
       from inside it these declarations would simply lose, silently. */
    @media (max-width: 768px) {
      .my-panel.is-active {
        border-inline: 0;
        /* No top border either: with the dock's block padding gone the sticky
           bar sits directly on the panel, and its own bottom rule already
           separates them. Keeping this one would draw a 2px double hairline —
           the same stacking the bar avoids against the site header above it.
           The bottom border stays; below it is page background, not a bar. */
        border-block-start: 0;
        border-radius: 0;
        padding-inline: 0.8rem;
      }
    }

    .panel-head {
      font-size: 1rem; font-weight: 700; color: var(--color-text);
      margin: 0 0 1.1rem; padding-bottom: 0.7rem;
      border-bottom: 1px solid var(--color-border);
    }

    /* ── Order card ── */
    .o-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg); margin-bottom: 0.75rem;
      overflow: hidden;
      transition: border-color 0.15s ease;
    }
    /* A full shadow-hover lift is too heavy for a wide, stacked list
       row (it's calibrated for compact grid cards) — a border tint is
       enough to signal "clickable" here. */
    .o-card:hover { border-color: color-mix(in srgb, var(--color-text) 20%, var(--color-border)); }
    .o-thumbs { grid-area: thumbs; display: flex; flex-direction: row-reverse; margin-inline-end: 0.5rem; flex-shrink: 0; }
    /* Collapsed-card thumbnails are visible immediately — no expand click gates
       them, unlike .o-item__img-wrap below, which is why these two look alike but
       are wired differently.

       Being visible immediately is exactly what made the old wiring wrong: the
       wrap animated from first paint and .o-thumb sat at opacity 0 until this
       page's bundle ran and img.decode() resolved. That is the pair of defects
       lib/img-skeleton.ts exists to prevent — a shimmer claiming a fetch that
       finished long ago (and showing straight through a background-removed photo),
       and a cached, already-decoded picture held invisible waiting for JS. Fixed
       2026-08-04 by handing these to the shared module: the photo now paints the
       moment it has pixels, and `is-loading` is added only while a fetch is really
       in flight. .o-item__img-wrap keeps its own decode-and-reveal because it is
       inside a hidden panel until the card is expanded — nothing there can paint
       before JS anyway. */
    .o-thumb-wrap {
      position: relative; width: 52px; height: 52px; border-radius: var(--radius); overflow: hidden;
      margin-inline-start: -12px;
      background: var(--color-surface);
    }
    .o-thumbs .o-thumb-wrap:last-child { margin-inline-start: 0; }
    .o-thumb-wrap.is-loading {
      background: linear-gradient(90deg, var(--color-border) 25%, var(--color-bg) 50%, var(--color-border) 75%);
      background-size: 200% 100%;
      animation: o-shimmer 1.3s infinite linear;
    }
    .o-thumb { width: 52px; height: 52px; border-radius: var(--radius); object-fit: cover; border: 1px solid var(--color-border); display: block; position: relative; }
    /* The id/date line is its own full-width row ABOVE the thumbs at every
       width (user, 2026-07-30: it should sit in the same place on every card,
       not move between breakpoints). It has to leave the text column to do
       that, hence grid + areas rather than a flex row: with three preview
       images the text column is only ~145px on a 375px screen while
       "#A1B2C3D4" + a date-with-time need ~165px, so inline they met with no
       gap at all. A wider gap would only move that collision to a longer id.
       Areas (not source order) do the placing, so the thumbs stay in the markup
       where they belong; the thumb strip keeps its own margin-inline-end
       instead of a column-gap, because an order with no images renders no
       .o-thumbs at all and a gap would leave a phantom indent in its place. */
    .o-card__hd {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "meta   meta meta"
        "thumbs main chevron";
      align-items: center;
      row-gap: 0.5rem;
      padding: 0.9rem 1rem; cursor: pointer; user-select: none;
    }
    .o-card__hd:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
    .o-card__hd-main { grid-area: main; min-width: 0; }
    .o-card__hd-top { grid-area: meta; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
    .o-card__chevron {
      grid-area: chevron; margin-inline-start: 0.5rem;
      flex-shrink: 0; color: var(--color-muted);
      transition: transform 220ms cubic-bezier(0.34,1.56,0.64,1);
    }
    .o-card--open .o-card__chevron { transform: rotate(180deg); }
    .o-id   { font-size: 0.8rem; font-weight: 700; font-family: monospace; color: var(--color-text); white-space: nowrap; }
    .o-date { font-size: 0.74rem; color: var(--color-muted); white-space: nowrap; }
    /* One line: this used to name the card's single store and now names the
       order's, which on a phone would otherwise wrap and make the collapsed
       cards different heights. The cut is made in the markup (two names, then
       "ועוד N"), so the ellipsis here is only the backstop for two unusually
       long names — never the thing that hides the third store. */
    .o-card__stores { font-size: 0.74rem; line-height: 1.4; margin-bottom: 0.3rem; color: var(--color-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* Lighter than the names beside it — it is a count, not another store. */
    .o-stores-more { color: color-mix(in srgb, var(--color-muted) 75%, transparent); }
    .o-items { font-size: 0.79rem; color: var(--color-muted); margin-bottom: 0.45rem; line-height: 1.45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .o-foot { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
    .o-badge { font-size: 0.7rem; font-weight: 600; padding: 0.13rem 0.5rem; border-radius: 999px; }
    .o-badge--ship { background: var(--color-bg); color: var(--color-muted); border: 1px solid var(--color-border); }
    /* Cancelled is the one status where "your order" and "nothing is coming"
       differ, so it does not get to look like the rest of the pipeline. The
       word still says it — the tint is a second signal, never the only one. */
    .o-badge--cancelled {
      background: color-mix(in srgb, var(--color-danger) 8%, var(--color-surface));
      color: var(--color-danger);
      border-color: color-mix(in srgb, var(--color-danger) 28%, var(--color-border));
    }
    .o-total { margin-inline-start: auto; font-size: 0.875rem; font-weight: 700; color: var(--color-text); }

    .o-card__body {
      border-top: 1px solid var(--color-border);
      padding: 0.875rem 1rem;
      display: flex; flex-direction: column; gap: 0.875rem;
    }
    /* One store's slice of the order. On a multi-store order there are several
       of these, and the rule between them is what says where one ends — without
       it the second store's name reads as a subheading of the first's list. */
    .o-store-group + .o-store-group {
      padding-top: 0.875rem;
      border-top: 1px solid var(--color-border);
    }
    /* The store's name and its own fulfilment status on one line: the two facts
       that are genuinely per-store. Wraps rather than squeezing, since a long
       store name plus a status has no room on a phone. */
    .o-store-head {
      display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }
    .o-store-name { font-size: 0.75rem; font-weight: 700; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.04em; margin: 0; display: block; transition: color 0.12s; }
    .o-store-name:hover { color: var(--color-accent); }
    .o-item-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .o-item { display: flex; align-items: center; gap: 0.625rem; font-size: 0.875rem; }
    @keyframes o-shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .o-item__img-wrap {
      position: relative; width: 40px; height: 40px; flex-shrink: 0; border-radius: var(--radius-sm); overflow: hidden;
      background: linear-gradient(90deg, var(--color-border) 25%, var(--color-bg) 50%, var(--color-border) 75%);
      background-size: 200% 100%;
      animation: o-shimmer 1.3s infinite linear;
    }
    .o-item__img-wrap.loaded { background: var(--color-surface); animation: none; }
    .o-item__img {
      width: 40px; height: 40px; object-fit: cover; border-radius: var(--radius-sm);
      border: 1px solid var(--color-border); opacity: 0; transition: opacity 0.18s;
      display: block;
    }
    .o-item__img-wrap.loaded .o-item__img { opacity: 1; }
    .o-item__img-placeholder { width: 40px; height: 40px; border-radius: var(--radius-sm); flex-shrink: 0; background: var(--color-bg); border: 1px solid var(--color-border); }
    .o-item__name { flex: 1; color: var(--color-text); }
    .o-item__qty  { color: var(--color-muted); font-size: 0.8rem; }
    .o-item__price { font-weight: 700; color: var(--color-text); margin-inline-start: auto; }
    .o-store-sub {
      display: flex; justify-content: space-between; align-items: center;
      margin-top: 0.5rem; padding-top: 0.5rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.8rem; color: var(--color-muted);
    }
    .o-store-sub strong { color: var(--color-text); font-size: 0.875rem; }
    .o-tracking { font-size: 0.8rem; color: var(--color-muted); margin: 0; padding-top: 0.5rem; }
    /* What the whole purchase came to — rendered only when there IS more than
       one store's total above it to add up. Heavier than .o-store-sub on
       purpose: those are parts, this is the number the card is about. */
    .o-grand-total {
      display: flex; justify-content: space-between; align-items: baseline;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.82rem; color: var(--color-muted);
    }
    .o-grand-total strong { font-size: 1rem; color: var(--color-text); }
    .o-section-title { font-size: 0.72rem; font-weight: 700; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; margin: 0; }

    /* ── Orders toolbar: sub-tabs (active/history) + search ── */
    .o-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem; margin-bottom: 0.6rem; }
    .o-subtabs {
      display: flex; gap: 2px; background: var(--color-bg);
      border: 1px solid var(--color-border); border-radius: 999px; padding: 3px;
    }
    .o-subtab-btn {
      border: none; background: none; cursor: pointer; font-family: inherit;
      font-size: 0.8rem; font-weight: 600; color: var(--color-muted);
      padding: 0.35rem 0.85rem; border-radius: 999px;
      display: flex; align-items: center; gap: 0.35rem;
      transition: background 0.12s, color 0.12s;
    }
    .o-subtab-btn:hover { color: var(--color-text); }
    .o-subtab-btn.is-active { background: var(--color-surface); color: var(--color-text); }
    .o-subtab-count { font-size: 0.68rem; color: var(--color-muted); }
    .o-subtab-btn.is-active .o-subtab-count { color: var(--color-accent); }
    .o-search-wrap { position: relative; flex: 1; min-width: 160px; max-width: 280px; }
    .o-search-icon { position: absolute; top: 50%; transform: translateY(-50%); inset-inline-start: 0.7rem; color: var(--color-muted); pointer-events: none; }
    .o-search-input {
      width: 100%; box-sizing: border-box; font-family: inherit; font-size: 0.82rem; color: var(--color-text);
      background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 999px;
      padding-block: 0.35rem; padding-inline-start: 1.9rem; padding-inline-end: 1.9rem;
      outline: none; transition: border-color 0.12s;
      -webkit-appearance: none; appearance: none;
    }
    /* Native browser search decorations (clear "x", magnifier) don't respect
       our own padding/RTL layout and land misaligned — replaced with our
       own icon + .o-search-clear button instead. */
    .o-search-input::-webkit-search-cancel-button,
    .o-search-input::-webkit-search-decoration { display: none; -webkit-appearance: none; appearance: none; }
    .o-search-input::-ms-clear, .o-search-input::-ms-reveal { display: none; }
    /* The shared field-focus treatment (components/forms.css) — was a grey 8% halo. */
    .o-search-input:focus { border-color: var(--color-primary); }
    /* Chrome ignores autocomplete="off" for a field it heuristically treats
       as "identity" data (this page also has a real autocomplete="email"
       profile field, #edit-email, elsewhere in the same DOM) and force-fills
       it with the buyer's own email + its own tinted background — neither
       respects our design tokens. Kills the tint/text-color regardless of
       why the browser decided to autofill (belt-and-suspenders alongside
       the readonly-until-focus trick on the input itself). */
    .o-search-input:-webkit-autofill,
    .o-search-input:-webkit-autofill:hover,
    .o-search-input:-webkit-autofill:focus {
      -webkit-text-fill-color: var(--color-text);
      box-shadow: 0 0 0 1000px var(--color-surface) inset;
      -webkit-box-shadow: 0 0 0 1000px var(--color-surface) inset;
      transition: background-color 5000s ease-in-out 0s;
    }
    .o-search-clear {
      position: absolute; top: 50%; transform: translateY(-50%); inset-inline-end: 0.45rem;
      width: 1.15rem; height: 1.15rem; border-radius: 50%; padding: 0;
      display: flex; align-items: center; justify-content: center;
      border: none; background: var(--color-bg); color: var(--color-muted); cursor: pointer;
      transition: background 0.1s, color 0.1s;
    }
    .o-search-clear:hover { background: var(--color-border); color: var(--color-text); }
    /* :placeholder-shown is only true while the input is empty — a pure-CSS
       show/hide with no JS state to keep in sync. */
    .o-search-wrap:has(.o-search-input:placeholder-shown) .o-search-clear { display: none; }

    /* ── Orders pagination ── */
    .o-pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 0.5rem 0 0; }
    .o-pagination-info { font-size: 0.82rem; color: var(--color-muted); white-space: nowrap; }

    /* ── Order-card skeleton (shown while a page/search/tab fetch is in flight) ── */
    .o-card-skel { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); margin-bottom: 0.75rem; padding: 0.9rem 1rem; }
    .o-card-skel__row { display: flex; align-items: center; gap: 0.6rem; }
    .o-skel-block {
      border-radius: var(--radius-sm);
      background: linear-gradient(90deg, var(--color-border) 25%, var(--color-bg) 50%, var(--color-border) 75%);
      background-size: 200% 100%;
      animation: o-shimmer 1.3s infinite linear;
    }
    .o-card-skel__thumb { width: 52px; height: 52px; border-radius: var(--radius); flex-shrink: 0; }
    .o-card-skel__lines { flex: 1; display: flex; flex-direction: column; gap: 0.5rem; }
    .o-card-skel__line { height: 0.7rem; }
    /* Mirrors .o-card__hd's own meta row: its own line above the thumb, at the
       same 0.5rem gap. A skeleton that lays out differently from the card it
       stands in for makes the swap read as a jump. */
    .o-card-skel__line--id { width: 35%; margin-bottom: 0.5rem; }
    .o-card-skel__line--stores { width: 55%; }
    .o-card-skel__line--items { width: 80%; }
    .o-card-skel__line--foot { width: 30%; margin-top: 0.15rem; }

    /* ── Message card ── */
    .m-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg); padding: 1rem; margin-bottom: 0.75rem;
    }
    /* The unread stripe is an INSET shadow — a mark drawn on the card, not
       elevation, so it is unaffected by the flat-at-rest rule. */
    .m-card--unread { box-shadow: inset 2px 0 0 var(--color-accent); }
    .m-card__top  { display: flex; justify-content: space-between; margin-bottom: 0.25rem; }
    .m-to   { font-size: 0.74rem; color: var(--color-muted); }
    .m-date { font-size: 0.72rem; color: var(--color-muted); }
    .m-ref  { font-size: 0.72rem; color: var(--color-accent); margin-bottom: 0.2rem; }
    .m-subj { font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.2rem; }
    .m-body { font-size: 0.8rem; color: var(--color-muted); margin: 0; line-height: 1.5; }
    .m-unread {
      display: inline-block; margin-top: 0.35rem;
      font-size: 0.68rem; font-weight: 700;
      color: #dc2626; background: #fee2e2;
      border-radius: 999px; padding: 0.08rem 0.38rem;
    }

    /* ── Profile panel ── */
    .prof-section-title {
      font-size: 0.8rem; font-weight: 700; color: var(--color-muted);
      text-transform: uppercase; letter-spacing: 0.04em;
      margin: 0 0 1rem;
    }
    .prof-field { margin-bottom: 0.9rem; }
    .prof-label {
      display: block; font-size: 0.78rem; font-weight: 600;
      color: var(--color-muted); margin-bottom: 0.28rem;
    }
    .prof-input {
      width: 100%; padding: 0.5rem 0.7rem;
      font-size: 0.875rem; font-family: inherit; color: var(--color-text);
      background: var(--color-bg); border: 1px solid var(--color-border);
      border-radius: var(--radius); outline: none;
      transition: border-color 0.15s;
      box-sizing: border-box;
    }
    /* Shared field-focus treatment (components/forms.css) — was --color-accent. */
    .prof-input:focus { border-color: var(--color-primary); }
    .prof-divider {
      border: none; border-top: 1px solid var(--color-border);
      margin: 1.25rem 0;
    }
    .prof-pw-toggle {
      font-size: 0.8rem; color: var(--color-accent); cursor: pointer;
      background: none; border: none; padding: 0; font-family: inherit;
      margin-bottom: 1rem; display: block;
    }
    .prof-pw-toggle:hover { text-decoration: underline; }
    .prof-actions { display: flex; gap: 0.5rem; margin-top: 1.25rem; }
    .prof-save {
      padding: 0.5rem 1.25rem;
      font-size: 0.875rem; font-weight: 600; font-family: inherit;
      background: var(--color-text); color: var(--color-surface);
      border: none; border-radius: var(--radius); cursor: pointer;
      transition: opacity 0.15s;
    }
    .prof-save:hover { opacity: 0.85; }
    .prof-save:disabled { opacity: 0.5; cursor: default; }
    .prof-error {
      font-size: 0.8rem; color: #dc2626;
      margin-top: 0.5rem; display: none;
    }
    .prof-success {
      font-size: 0.8rem; color: #16a34a;
      margin-top: 0.5rem; display: none;
    }

    .empty { text-align: center; color: var(--color-muted); padding: 3rem 0; font-size: 0.875rem; }

  </style>

  <!-- Mobile backdrop -->
  <div class="my-drawer-backdrop" id="my-drawer-backdrop" aria-hidden="true"></div>

  <!-- Mobile topbar — a card inside a sticky dock; title + hamburger together, replaces the per-panel <h1> on mobile -->
  <div class="my-topbar-dock" id="my-topbar-dock">
    <div class="my-topbar">
      <button class="my-menu-btn" id="my-menu-btn" type="button" aria-label={t.buyerDashboard.menuBtn} aria-expanded="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <span class="my-topbar-title" id="topbar-tab-label">{t.buyerDashboard.ordersTitle}</span>
    </div>
  </div>

  <div class="my-page">

    <!-- Sidebar / Drawer -->
    <div class="my-sidebar-clip">
    <aside class="my-sidebar" id="my-sidebar">
      <button class="my-drawer-close" id="my-drawer-close" type="button" aria-label={t.buyerDashboard.closeDrawer}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <div class="my-user-card">
        <div class="my-avatar">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        </div>
        <div class="my-user-info">
          <div class="my-name" id="display-name">{seller.name}</div>
          <div class="my-email" id="display-email">{seller.email}</div>
        </div>
      </div>

      <nav class="my-nav" aria-label={t.buyerDashboard.navAriaLabel}>
        <button class="my-nav-btn is-active" data-tab="orders" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="my-nav-label">{t.buyerDashboard.tabOrders}</span>
          {/* The count that opens, not the count that exists. `orders` is one row per STORE and
              includes everything ever delivered, so a two-store basket read as 2 and a buyer with
              nothing open still saw a number beside an "אין הזמנות פעילות" list. This is the same
              unit as the cards below (a purchase) and the same semantic as the unread badge beside
              it — what is waiting on you.

              Always rendered, `hidden` when zero, rather than rendered only when non-zero: the
              panel refresh below writes into this element, and a count that has to CREATE its own
              node is how the two counts on screen end up maintained by two different pieces of
              code. */}
          <span id="nav-orders-count" style="font-size:0.7rem;color:var(--color-muted)" hidden={activeOrdersCount === 0}>{activeOrdersCount || ''}</span>
        </button>
        <button class="my-nav-btn" data-tab="messages" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span class="my-nav-label">{t.buyerDashboard.tabMessages}</span>
          {unreadMessages > 0 && <span class="my-nav-badge">{unreadMessages}</span>}
        </button>
        <button class="my-nav-btn" data-tab="carts" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="my-nav-label">{t.buyerDashboard.tabCarts}</span>
        </button>
        <button class="my-nav-btn" data-tab="profile" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          <span class="my-nav-label">{t.buyerDashboard.tabProfile}</span>
        </button>
      </nav>
    </aside>
    </div>

    <!-- Content -->
    <div class="my-content-wrap">

      <!-- Orders -->
      <div id="panel-orders" class="my-panel is-active">
        <h1 class="panel-head">{t.buyerDashboard.ordersTitle}</h1>
        {orders.length === 0 ? (
          <p class="empty">{t.buyerDashboard.noOrders}</p>
        ) : (
          <Fragment>
          <div class="o-toolbar">
            <div class="o-subtabs" role="tablist" aria-label={t.buyerDashboard.ordersTitle}>
              <button type="button" class="o-subtab-btn" id="o-subtab-active" data-hist="0" role="tab" aria-selected={!buyerOrderQuery.history} class:list={{ 'is-active': !buyerOrderQuery.history }}>
                {t.buyerDashboard.ordersTabActive}
                <span class="o-subtab-count" id="o-count-active" hidden={activeOrdersCount === 0}>{activeOrdersCount || ''}</span>
              </button>
              <button type="button" class="o-subtab-btn" id="o-subtab-history" data-hist="1" role="tab" aria-selected={buyerOrderQuery.history} class:list={{ 'is-active': buyerOrderQuery.history }}>
                {t.buyerDashboard.ordersTabHistory}
                <span class="o-subtab-count" id="o-count-history" hidden={historyOrdersCount === 0}>{historyOrdersCount || ''}</span>
              </button>
            </div>
            {/* Plain search field, nothing more. It starts `readonly` (see
                script) and only becomes editable on the user's first real
                focus — a readonly field cannot be autofilled by the browser
                at all, which is the only thing that reliably stops Chrome
                from treating it as a login field (this page also has real
                password inputs elsewhere in the DOM, in the hidden Profile
                panel) and force-suggesting saved username/password into it
                with its own native blue ring — that ring isn't page CSS,
                autocomplete="off" alone does not suppress it, and there is
                no custom dropdown here to fight it with. */}
            <div class="o-search-wrap">
              <svg class="o-search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="orders-search-input" value={buyerOrderQuery.q} placeholder={t.dashboard.ordersSearchPlaceholder} class="o-search-input" autocomplete="off" readonly data-freshness-ignore />
              <button type="button" class="o-search-clear" id="orders-search-clear" aria-label={t.buyerDashboard.ordersClearSearch} tabindex="-1">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </div>

          <p class="empty" id="orders-empty" hidden={ordersPageResult.total > 0}>{ordersEmptyMessage}</p>

          <div id="orders-list">
            {ordersPageResult.items.map((p) => {
            // Flattened across the whole purchase — the collapsed card summarises the ORDER, so
            // its thumbs and its one-line item list must not stop at the first store's slice.
            const allItems = p.slices.flatMap((s) => s.order.items);
            const split = p.slices.length > 1;
            return (
              <div class="o-card">
                <div class="o-card__hd" role="button" tabindex="0" aria-expanded="false">
                  {allItems.some((i) => i.image) && (
                    <div class="o-thumbs">
                      {allItems.filter((i) => i.image).slice(0, 3).map((i) => (
                        <span class="o-thumb-wrap" data-skeleton><img src={cdnThumb(i.image!, 104, 104)} alt={i.productName} width="52" height="52" loading="lazy" decoding="async" class="o-thumb" /></span>
                      ))}
                    </div>
                  )}
                  {/* Sibling of .o-card__hd-main, not a child: it's a grid area
                      of .o-card__hd, so it spans the full card above the thumbs. */}
                  <div class="o-card__hd-top">
                    <span class="o-id">#{p.ref}</span>
                    <span class="o-date">{fmtDate(p.createdAt)}</span>
                  </div>
                  <div class="o-card__hd-main">
                    {/* Two names and a count for the rest — the same "+N" move the store
                        card's own tag row makes. A CSS ellipsis was doing this before and
                        cut through the middle of the third store's name, which reads as a
                        rendering fault rather than as a deliberate summary. */}
                    <div class="o-card__stores">
                      {p.slices.slice(0, STORES_NAMED).map((s, idx) => (
                        <Fragment>
                          <span>{s.storeName}</span>
                          {idx < Math.min(p.slices.length, STORES_NAMED) - 1 && <span aria-hidden="true">, </span>}
                        </Fragment>
                      ))}
                      {p.slices.length > STORES_NAMED && (
                        <span class="o-stores-more">{' '}{t.buyerDashboard.orderStoresMore.replace('{count}', String(p.slices.length - STORES_NAMED))}</span>
                      )}
                    </div>
                    <div class="o-items">{allItems.map((i) => `${i.productName} × ${i.qty}`).join(' · ')}</div>
                    <div class="o-foot">
                      {/* The least-advanced slice's status, because that is what the buyer is
                          still waiting on (buyer-purchases.ts). The chip beside it is what
                          keeps that honest when the stores disagree — without it the header
                          would present one store's progress as the whole order's. */}
                      <span class={`o-badge o-badge--ship${p.status === 'cancelled' ? ' o-badge--cancelled' : ''}`}>{shipLabel[p.status] ?? p.status}</span>
                      <span class="o-total">{fmtAgorot(p.totalAgorot)}</span>
                    </div>
                  </div>
                  <svg class="o-card__chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </div>

                <div class="o-card__body" hidden>
                  <p class="o-section-title">{t.buyerDashboard.orderItems}</p>
                  {p.slices.map((s) => {
                    const sub = s.order.storeSubtotals[s.storeSlug];
                    return (
                      <div class="o-store-group">
                        {/* Status and tracking live HERE, per store, and not once at the bottom
                            of the card: they are the facts that genuinely differ between one
                            order's stores. A single-store order shows only the header badge —
                            repeating it one line below says nothing. */}
                        <div class="o-store-head">
                          <a href={`/${s.storeSlug}`} class="o-store-name" style="text-decoration:none;color:inherit;cursor:pointer">{s.storeName}</a>
                          {split && <span class={`o-badge o-badge--ship${s.order.shippingStatus === 'cancelled' ? ' o-badge--cancelled' : ''}`}>{shipLabel[s.order.shippingStatus] ?? s.order.shippingStatus}</span>}
                        </div>
                        <ul class="o-item-list">
                          {s.order.items.map((item) => (
                            <li class="o-item">
                              {item.image
                                ? <span class="o-item__img-wrap"><img src={cdnThumb(item.image, 80, 80)} alt={item.productName} width="40" height="40" loading="lazy" decoding="async" class="o-item__img" /></span>
                                : <div class="o-item__img-placeholder" aria-hidden="true"></div>
                              }
                              <span class="o-item__name">{item.productName}</span>
                              <span class="o-item__qty">×{item.qty}</span>
                              <span class="o-item__price">{fmtAgorot(item.priceAgorot * item.qty)}</span>
                            </li>
                          ))}
                        </ul>
                        {sub && (
                          <div class="o-store-sub">
                            <span>{t.checkout.shipping}: {sub.shippingAgorot === 0 ? t.buyerDashboard.freeShipping : fmtAgorot(sub.shippingAgorot)}</span>
                            {sub.discount?.appliedAgorot ? <span>{t.buyerDashboard.orderDiscount}: −{fmtAgorot(sub.discount.appliedAgorot)}</span> : null}
                            <strong>{fmtAgorot(storeSliceTotalAgorot(sub))}</strong>
                          </div>
                        )}
                        {s.order.trackingNumber && (
                          <p class="o-tracking">{t.buyerDashboard.trackingNumber}: <strong>{s.order.trackingNumber}</strong></p>
                        )}
                        {invoiceUrlByOrderId.get(s.order.id) && (
                          <p class="o-tracking">{t.buyerDashboard.invoiceLabel}: <a href={invoiceUrlByOrderId.get(s.order.id)} target="_blank" rel="noopener noreferrer"><strong>{t.buyerDashboard.invoiceView}</strong></a></p>
                        )}
                      </div>
                    );
                  })}
                  {/* Only when the order HAS several stores — otherwise it restates the single
                      store's own total immediately above it. */}
                  {split && (
                    <div class="o-grand-total">
                      <span>{t.buyerDashboard.orderTotalAll}</span>
                      <strong>{fmtAgorot(p.totalAgorot)}</strong>
                    </div>
                  )}
                </div>
              </div>
            );
            })}
          </div>

          <nav id="orders-pagination" class="o-pagination" aria-label={t.buyerDashboard.ordersTitle} data-page={ordersPageResult.page} data-total-pages={ordersPageResult.totalPages} hidden></nav>
          </Fragment>
        )}
      </div>

      <!-- Messages -->
      <!-- msg-cq: the table below collapses to cards by THIS element's width, not the viewport's (see utils.css) -->
      <div id="panel-messages" class="my-panel msg-cq" data-user-id={userId} hidden>
        <h1 class="panel-head">{t.buyerDashboard.messagesTitle}</h1>
        {messages.length === 0
          ? <p class="empty">{t.buyerDashboard.noMessages}</p>
          : (
            <Fragment>
            {/* Mobile-only sort/filter toolbar — same pattern as the seller
                dashboard's messages tab: on desktop, sort/filter live in the
                header row itself instead (.sort-btn + funnel buttons); this
                toolbar takes over once the table collapses to cards on
                mobile (thead is display:none below 640px). */}
            <div class="table-toolbar" data-mixed-status={String(showMsgStatusControls)}>
              <button type="button" id="bmsg-sort-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="listbox" aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
                <span id="bmsg-sort-label">{t.dashboard.msgSortOptDateDesc}</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <button type="button" id="bmsg-filter-trigger" class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]" aria-haspopup="true" aria-expanded="false">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                <span>{t.dashboard.filterByLabel}</span>
                <span id="bmsg-filter-count" class="filter-count-badge inline-flex items-center justify-center min-w-4 h-4 px-1 rounded-full bg-[color:var(--color-primary)] text-white text-[.68rem] font-bold leading-none" hidden>0</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>

            <div class="msg-table-wrap">
              <table class="msg-table">
                <thead>
                  <tr>
                    <th class="msg-table__th msg-table__th--status">
                      {showMsgStatusControls && (
                        <div style="display:flex;align-items:center;justify-content:center;gap:0.2rem">
                          <button type="button" class="sort-btn" data-sort-col="unread" aria-label={`${t.dashboard.sortByLabel} ${t.dashboard.filterColStatus ?? 'סטטוס'}`}>
                            <svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                          </button>
                          <button type="button" class="combo-filter-btn" data-filter-funnel-col="status" aria-expanded="false" aria-haspopup="true" aria-label={`${t.dashboard.filterByLabel ?? 'סנן לפי'} ${t.dashboard.filterColStatus ?? 'סטטוס'}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                          </button>
                        </div>
                      )}
                    </th>
                    <th class="msg-table__th msg-table__th--from">
                      <div style="display:flex;align-items:center;gap:0.25rem">
                        {t.buyerDashboard.msgColStore}
                        <button type="button" class="combo-filter-btn" data-filter-funnel-col="store" aria-expanded="false" aria-haspopup="true" aria-label={`${t.dashboard.filterByLabel ?? 'סנן לפי'} ${t.buyerDashboard.msgColStore}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        </button>
                      </div>
                    </th>
                    <th class="msg-table__th msg-table__th--subject">{t.messages.subject}</th>
                    <th class="msg-table__th">{t.messages.content}</th>
                    <th class="msg-table__th msg-table__th--product">
                      <div style="display:flex;align-items:center;gap:0.25rem">
                        <button type="button" class="sort-btn" data-sort-col="product" aria-label={`${t.dashboard.sortByLabel} ${t.buyerDashboard.msgColProduct}`}>{t.buyerDashboard.msgColProduct}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                        <button type="button" class="combo-filter-btn" data-filter-funnel-col="product" aria-expanded="false" aria-haspopup="true" aria-label={`${t.dashboard.filterByLabel ?? 'סנן לפי'} ${t.buyerDashboard.msgColProduct}`} style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;background:none;border:none;cursor:pointer;color:var(--color-muted);padding:0">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        </button>
                      </div>
                    </th>
                    <th class="msg-table__th msg-table__th--date">
                      <button type="button" class="sort-btn" data-sort-col="date" aria-label={`${t.dashboard.sortByLabel} ${t.dashboard.orderDate}`}>{t.dashboard.orderDate}<svg class="sort-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>
                    </th>
                    <th class="msg-table__th msg-table__th--actions"></th>
                  </tr>
                </thead>
                <tbody>
                  {messages.map((m) => {
                    const replies = messageReplies[m.id] ?? [];
                    const hasUnreadReply = replies.some((r) => r.fromUserId !== userId && !r.readByBuyer);
                    const lastMsg = replies.length > 0 ? replies[replies.length - 1]! : m;
                    return (
                      <Fragment>
                        <tr
                          class={`msg-table__row${hasUnreadReply ? ' msg-table__row--unread' : ''}`}
                          data-bmsg-id={m.id}
                          data-sort-date={lastMsg.createdAt}
                          data-sort-product={(m.productRef?.productName ?? '').toLowerCase()}
                          data-filter-product={m.productRef?.productName ?? ''}
                          data-filter-store={m.toStoreName}
                          tabindex="0"
                          role="button"
                          aria-expanded="false"
                        >
                          <td class="msg-table__td msg-table__td--status"></td>
                          <td class="msg-table__td msg-table__td--from">
                            {/* The name is its own truncating box: the cell's ellipsis cannot
                                reach a text node that is a FLEX ITEM, so a long store name was
                                clipped mid-character instead of trailing off. `min-w-0` is what
                                lets it shrink at all — a flex item's floor is its content. */}
                            <span class="flex items-center gap-2">
                              <StoreAvatar name={m.toStoreName} slug={storeSlugById.get(m.toStoreId)} profileImage={storeProfileById.get(m.toStoreId)} size={24} />
                              <span class="min-w-0 truncate">{m.toStoreName}</span>
                            </span>
                          </td>
                          <td class="msg-table__td msg-table__td--subject">{m.subject}</td>
                          <td class="msg-table__td msg-table__td--preview">
                            {lastMsg.content}
                            {lastMsg.fromUserId === userId && <span class="msg-table__preview-you"> ({t.buyerDashboard.msgYou})</span>}
                          </td>
                          <td class="msg-table__td msg-table__td--product">
                            {m.productRef
                              ? <a href={`/${m.productRef.storeSlug}/${m.productRef.productSlug}`} target="_blank" rel="noopener" style="color:inherit;text-decoration:none">{m.productRef.productName}</a>
                              : <span style="color:var(--color-muted)">—</span>
                            }
                          </td>
                          <td class="msg-table__td msg-table__td--date">{fmtDate(lastMsg.createdAt)}</td>
                          <td class="msg-table__td msg-table__td--actions">
                            <button class="seller-msg-delete" data-delete-bmsg-id={m.id} type="button" aria-label={t.buyerDashboard.deleteConv} title={t.buyerDashboard.deleteConv}>
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                            </button>
                          </td>
                        </tr>
                        <tr class="msg-thread-row" id={`bmsg-detail-${m.id}`} hidden>
                          <td colspan="7">
                            {/* Twin of SellerMessageRow.astro's thread header — the subject
                                in full (the column clips it) and the product the thread is
                                about, which the buyer's card layout drops entirely on a
                                phone. Reasoning at `.msg-thread-head` in utilities/utils.css. */}
                            <div class="msg-thread-head">
                              <p class="msg-thread-head__subject"><span class="msg-thread-head__label">{t.buyerDashboard.msgSubjectLabel}</span>{m.subject}</p>
                              {m.productRef && (
                                <a class="msg-thread-head__product" href={`/${m.productRef.storeSlug}/${m.productRef.productSlug}`} target="_blank" rel="noopener">
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="flex-shrink:0"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                  <span>{t.buyerDashboard.msgAboutProduct}: {m.productRef.productName}</span>
                                </a>
                              )}
                            </div>
                            <div class="msg-thread" id={`breplies-${m.id}`}>
                              <div class="msg-thread-entry msg-thread-entry--buyer">
                                <div class="msg-thread-entry__header">
                                  <span class="msg-thread-entry__who">{t.buyerDashboard.msgYou}</span>
                                  <span class="msg-thread-entry__date">{fmtDate(m.createdAt)}</span>
                                </div>
                                <div class="msg-thread-entry__body">{m.content}</div>
                              </div>
                              {replies.map((r) => {
                                const isBuyerReply = r.fromUserId === userId;
                                return (
                                  <div class={`msg-thread-entry ${isBuyerReply ? 'msg-thread-entry--buyer' : 'msg-thread-entry--seller'}`}>
                                    <div class="msg-thread-entry__header">
                                      <span class="msg-thread-entry__who">{isBuyerReply ? t.buyerDashboard.msgYou : m.toStoreName}</span>
                                      <span class="msg-thread-entry__date">{fmtDate(r.createdAt)}</span>
                                    </div>
                                    <div class="msg-thread-entry__body">{r.content}</div>
                                  </div>
                                );
                              })}
                            </div>
                            <div class="seller-msg-reply-form" data-breply-for={m.id} style="padding:0.75rem 1rem;border-top:1px solid var(--color-border)">
                              <textarea class="seller-msg-reply-textarea" placeholder={t.buyerDashboard.msgReplyPlaceholder} rows="3" hidden></textarea>
                              <div class="seller-msg-reply-actions">
                                <button class="seller-msg-reply-close" type="button">{t.buyerDashboard.msgReplyClose}</button>
                                <button class="seller-msg-reply-cancel" type="button" hidden>{t.buyerDashboard.msgReplyCancel}</button>
                                <button class="seller-msg-reply-open" type="button" aria-expanded="false">{t.buyerDashboard.msgReplyOpen}</button>
                                <button class="seller-msg-reply-send" type="button" hidden>{t.buyerDashboard.msgReplySend}</button>
                              </div>
                            </div>
                          </td>
                        </tr>
                      </Fragment>
                    );
                  })}
                </tbody>
              </table>
            </div>
            </Fragment>
          )
        }
      </div>

      <!-- Carts -->
      <div
        id="panel-carts"
        class="my-panel"
        hidden
        data-label-items={t.home.cartItems}
        data-label-open={t.home.cartOpenBtn}
        data-label-visit={t.home.visitStore}
        data-label-empty={t.home.noActiveCarts}
      >
        <h1 class="panel-head">{t.home.yourCarts}</h1>
        <div id="carts-list" class="home-carts-wrap" role="list">
          <div class="home-cart-chip-skel" aria-hidden="true"></div>
          <div class="home-cart-chip-skel" style="width:6rem" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Profile -->
      <div id="panel-profile" class="my-panel" hidden>
        <h1 class="panel-head">{t.buyerDashboard.profileTitle}</h1>
        <div style="max-width:480px">
          <p class="prof-section-title">{t.buyerDashboard.profSection}</p>
          <div class="prof-field">
            <label class="prof-label" for="edit-name">{t.checkout.fullName}</label>
            <input class="prof-input" id="edit-name" type="text" value={seller.name} autocomplete="name" />
          </div>
          <div class="prof-field">
            <label class="prof-label" for="edit-email">{t.checkout.email}</label>
            <input class="prof-input" id="edit-email" type="email" value={seller.email} autocomplete="email" />
          </div>

          <hr class="prof-divider" />

          <p class="prof-section-title">{t.buyerDashboard.profChangePassword}</p>
          <button class="prof-pw-toggle" id="pw-toggle" type="button">{t.buyerDashboard.profShowPw}</button>
          {/* The two type="password" inputs live in a <template> — inert,
              not part of the live DOM — and only get cloned in on the
              toggle's first click. Chrome's own password manager scans the
              whole live document for password fields to decide which text
              field elsewhere on the page "must be" the username and offers
              saved logins into it (this is what was making the orders
              search field suggest saved emails); keeping these out of the
              DOM entirely until actually needed removes that trigger at
              the source, instead of fighting it with per-field attributes. */}
          <div id="pw-fields" hidden></div>
          <template id="pw-fields-template">
            <div class="prof-field">
              <label class="prof-label" for="edit-cur-pw">{t.buyerDashboard.profCurPw}</label>
              <input class="prof-input" id="edit-cur-pw" type="password" autocomplete="current-password" />
            </div>
            <div class="prof-field">
              <label class="prof-label" for="edit-new-pw">{t.buyerDashboard.profNewPw}</label>
              <input class="prof-input" id="edit-new-pw" type="password" autocomplete="new-password" />
            </div>
          </template>

          <p class="prof-error" id="edit-error"></p>
          <p class="prof-success" id="edit-success">{t.buyerDashboard.profSaved}</p>
          <div class="prof-actions">
            <button class="prof-save" id="edit-save" type="button">{t.dashboard.saveChanges}</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<div id="buyer-i18n" hidden
  data-tab-orders={t.buyerDashboard.tabOrders}
  data-tab-messages={t.buyerDashboard.tabMessages}
  data-tab-carts={t.buyerDashboard.tabCarts}
  data-tab-profile={t.buyerDashboard.tabProfile}
  data-msg-you={t.buyerDashboard.msgYou}
  data-msg-new-toast={t.buyerDashboard.msgNewToast}
  data-msg-delete-confirm={t.buyerDashboard.msgDeleteConfirm}
  data-msg-delete-ok={t.buyerDashboard.deleteConv}
  data-msg-col-store={t.buyerDashboard.msgColStore}
  data-msg-col-product={t.buyerDashboard.msgColProduct}
  data-prof-show-pw={t.buyerDashboard.profShowPw}
  data-prof-hide-pw={t.buyerDashboard.profHidePw}
  data-prof-saved={t.buyerDashboard.profSaved}
  data-prof-error-default={t.buyerDashboard.profErrorDefault}
  data-prof-error-network={t.buyerDashboard.profErrorNetwork}
  data-date-locale={dateLocale}
  data-order-items={t.buyerDashboard.orderItems}
  data-free-shipping={t.buyerDashboard.freeShipping}
  data-order-discount={t.buyerDashboard.orderDiscount}
  data-tracking-number={t.buyerDashboard.trackingNumber}
  data-shipping-label={t.checkout.shipping}
  data-ship-pending={t.buyerDashboard.shippingPending}
  data-ship-processing={t.buyerDashboard.shippingProcessing}
  data-ship-ready={t.buyerDashboard.shippingReady}
  data-ship-shipped={t.buyerDashboard.shippingShipped}
  data-ship-delivered={t.buyerDashboard.shippingDelivered}
  data-ship-cancelled={t.buyerDashboard.shippingCancelled}
  data-order-stores-more={t.buyerDashboard.orderStoresMore}
  data-order-total-all={t.buyerDashboard.orderTotalAll}
  data-orders-empty-active={t.buyerDashboard.ordersEmptyActive}
  data-orders-empty-history={t.buyerDashboard.ordersEmptyHistory}
  data-orders-search-empty={t.buyerDashboard.ordersSearchEmpty}
  data-orders-load-error={t.buyerDashboard.ordersLoadError}
  data-pagination-prev={t.dashboard.paginationPrev}
  data-pagination-next={t.dashboard.paginationNext}
  data-pagination-page-info={t.dashboard.paginationPageInfo}
></div>

<script>
  import { getActiveStoreCarts, getSubtotal } from '../../lib/cart.js';
  import { formatPrice, cdnThumb } from '../../config/store.config.js';
  import { escapeHtml as escB } from '../../lib/html-escape.js';
  import { debounce } from '../../lib/admin-nav.js';
  import { initImageSkeletons } from '../../lib/img-skeleton.js';
  import { BUYER_ORDER_PAGE_SIZE } from '../../lib/buyer-orders-query.js';
  import { filterClearButtonHtml } from '../../lib/toolbar-portal.js';
  import { lockTableColumns, unlockTableColumns } from '../../lib/table-column-lock.js';
  import { showErrorToast, showActionFailedToast } from '../../lib/toast.js';
  import { storeSliceTotalAgorot } from '../../lib/order-totals.js';
  import { LOADING_CUE_DELAY_MS } from '../../lib/loading-sweep.js';
  import { markPanelFresh, isPanelStale, panelHoldsTypedText } from '../../lib/panel-freshness.js';

  const _i18nEl = document.getElementById('buyer-i18n') as HTMLElement;
  const I = {
    tabOrders:       _i18nEl.dataset.tabOrders       ?? 'Orders',
    tabMessages:     _i18nEl.dataset.tabMessages      ?? 'Messages',
    tabCarts:        _i18nEl.dataset.tabCarts         ?? 'Carts',
    tabProfile:      _i18nEl.dataset.tabProfile       ?? 'Profile',
    msgYou:          _i18nEl.dataset.msgYou           ?? 'You',
    msgNewToast:     _i18nEl.dataset.msgNewToast       ?? 'You have a new message',
    msgDeleteConfirm:_i18nEl.dataset.msgDeleteConfirm ?? 'Delete this conversation permanently?',
    msgDeleteOk:     _i18nEl.dataset.msgDeleteOk      ?? 'Delete conversation',
    msgColStore:     _i18nEl.dataset.msgColStore       ?? 'Store',
    msgColProduct:   _i18nEl.dataset.msgColProduct     ?? 'Product',
    profShowPw:      _i18nEl.dataset.profShowPw       ?? '+ Show password fields',
    profHidePw:      _i18nEl.dataset.profHidePw       ?? '− Hide password fields',
    profSaved:       _i18nEl.dataset.profSaved        ?? 'Details updated successfully',
    profErrorDefault:_i18nEl.dataset.profErrorDefault ?? 'Error saving',
    profErrorNetwork:_i18nEl.dataset.profErrorNetwork ?? 'Network error, try again',
    dateLocale:      _i18nEl.dataset.dateLocale       ?? 'he-IL',
    orderItems:      _i18nEl.dataset.orderItems       ?? 'Items',
    freeShipping:    _i18nEl.dataset.freeShipping     ?? 'Free',
    orderDiscount:   _i18nEl.dataset.orderDiscount    ?? 'Discount',
    trackingNumber:  _i18nEl.dataset.trackingNumber   ?? 'Tracking number',
    shippingLabel:   _i18nEl.dataset.shippingLabel    ?? 'Shipping',
    shipPending:     _i18nEl.dataset.shipPending      ?? 'New',
    shipProcessing:  _i18nEl.dataset.shipProcessing   ?? 'Processing',
    shipReady:       _i18nEl.dataset.shipReady        ?? 'Awaiting pickup',
    shipShipped:     _i18nEl.dataset.shipShipped      ?? 'Shipped',
    shipDelivered:   _i18nEl.dataset.shipDelivered    ?? 'Delivered',
    shipCancelled:   _i18nEl.dataset.shipCancelled    ?? 'Cancelled',
    orderStoresMore: _i18nEl.dataset.orderStoresMore  ?? '+{count} more',
    orderTotalAll:   _i18nEl.dataset.orderTotalAll    ?? 'Order total',
    ordersEmptyActive: _i18nEl.dataset.ordersEmptyActive ?? 'No active orders right now.',
    ordersEmptyHistory:_i18nEl.dataset.ordersEmptyHistory ?? 'No orders in your history yet.',
    ordersSearchEmpty: _i18nEl.dataset.ordersSearchEmpty ?? 'No orders match your search.',
    ordersLoadError:   _i18nEl.dataset.ordersLoadError  ?? 'Error loading orders. Try again.',
    paginationPrev:    _i18nEl.dataset.paginationPrev    ?? 'Previous',
    paginationNext:    _i18nEl.dataset.paginationNext    ?? 'Next',
    paginationPageInfo:_i18nEl.dataset.paginationPageInfo ?? 'Page {page} of {total}',
  };

  const navBtns = document.querySelectorAll<HTMLButtonElement>('.my-nav-btn[data-tab]');
  const panels: Record<string, HTMLElement | null> = {
    orders:   document.getElementById('panel-orders'),
    messages: document.getElementById('panel-messages'),
    carts:    document.getElementById('panel-carts'),
    profile:  document.getElementById('panel-profile'),
  };
  const sidebar   = document.getElementById('my-sidebar')!;
  const backdrop  = document.getElementById('my-drawer-backdrop')!;
  const menuBtn   = document.getElementById('my-menu-btn');
  const closeBtn  = document.getElementById('my-drawer-close');
  const topbarTab = document.getElementById('topbar-tab-label');
  const _mq = window.matchMedia('(max-width: 768px)');

  // Sticky topbar dock's offset must be the real fixed header height,
  // fractional — offsetHeight (or a hardcoded rem guess) rounds to the nearest
  // integer px, which alone is enough to leave a 1-2px seam showing page
  // content behind it. The dock sits flush under the header at rest, so this
  // offset is also what keeps it from shifting on the first scroll pixel.
  const siteHeaderEl = document.querySelector<HTMLElement>('.site-header');
  const topbarEl = document.getElementById('my-topbar-dock');
  if (siteHeaderEl && topbarEl) {
    const updateTopbarOffset = () => { topbarEl.style.top = `${siteHeaderEl.getBoundingClientRect().height}px`; };
    updateTopbarOffset();
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(updateTopbarOffset).observe(siteHeaderEl);
    else window.addEventListener('resize', updateTopbarOffset);
  }

  // Desktop sticky sidebar's `top` had the same class of bug: a bare
  // `5rem` guess vs. the sidebar's real pre-sticky rest position (site
  // header's real fractional height + .my-page's own top padding) — the
  // ~0.3rem gap between the guess and reality made the sidebar visibly
  // jump up a few px right as it engaged while scrolling. Cleared to ''
  // on mobile so the media-query's own `position:fixed; top:0` rule
  // applies — an inline style always wins over a stylesheet rule
  // regardless of specificity, so this must not stay set at that width.
  const myPageEl = document.querySelector<HTMLElement>('.my-page');
  if (siteHeaderEl && myPageEl) {
    const updateSidebarOffset = () => {
      if (_mq.matches) { sidebar.style.top = ''; return; }
      const pageTopPad = parseFloat(getComputedStyle(myPageEl).paddingTop) || 0;
      sidebar.style.top = `${siteHeaderEl.getBoundingClientRect().height + pageTopPad}px`;
    };
    updateSidebarOffset();
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(updateSidebarOffset).observe(siteHeaderEl);
    else window.addEventListener('resize', updateSidebarOffset);
    _mq.addEventListener('change', updateSidebarOffset);
  }

  function openDrawer() {
    sidebar.classList.add('is-open');
    backdrop.classList.add('is-open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
  }
  function closeDrawer() {
    sidebar.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
  }

  // Suppress sidebar transition when the breakpoint changes (resize/DevTools toggle)
  _mq.addEventListener('change', () => {
    sidebar.style.transition = 'none';
    if (!_mq.matches) closeDrawer();
    requestAnimationFrame(() => requestAnimationFrame(() => { sidebar.style.transition = ''; }));
  });

  menuBtn?.addEventListener('click', openDrawer);
  topbarTab?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar.classList.contains('is-open')) closeDrawer();
  });

  // Everything on screen right now came from the server a moment ago, so the first activation —
  // the `?tab=` deep link below — must not re-fetch what it is already showing. Stamping here
  // rather than letting the panels start unstamped is also what keeps that first call away from
  // `applyBuyerOrdersPagination`, whose own state (`ordersCurrentPage`) is declared further down
  // this module and would still be in its temporal dead zone.
  markPanelFresh('buyer:orders');
  markPanelFresh('buyer:messages');

  /**
   * Bring a tab's content up to date on opening it, unless it is already current.
   *
   * Carts and profile are absent on purpose and are not oversights: the carts panel renders from
   * client-side cart state and already redraws on every `cart:change`, and profile shows the
   * signed-in user's own details, which nothing but their own form on that same panel can alter.
   * Refreshing either would be a request whose answer is guaranteed to equal what is on screen.
   */
  function refreshBuyerPanel(key: string): void {
    const panel = panels[key];
    // Never over typed text — a half-written search or message is worth more than a fresher list.
    if (panelHoldsTypedText(panel) || !isPanelStale(`buyer:${key}`)) return;
    if (key === 'orders')   void applyBuyerOrdersPagination();
    // The whole panel, not `pollBuyerUnread`: the poll walks `[data-bmsg-id]` and can only update
    // rows that already exist, so a conversation a seller opened since page load had nothing for
    // it to update and never appeared at all.
    if (key === 'messages') void refreshBuyerMessages();
  }

  function activateBuyerTab(key: string) {
    navBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.tab === key));
    Object.entries(panels).forEach(([k, el]) => {
      if (!el) return;
      if (k === key) { el.classList.add('is-active'); el.removeAttribute('hidden'); }
      else           { el.classList.remove('is-active'); el.setAttribute('hidden', ''); }
    });
    if (topbarTab) topbarTab.textContent = panels[key]?.querySelector<HTMLElement>('.panel-head')?.textContent ?? key;
    history.replaceState(null, '', `?tab=${key}`);
    refreshBuyerPanel(key);
  }

  navBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activateBuyerTab(btn.dataset.tab!);
      closeDrawer();
    });
  });

  // Deep-link: ?tab=<tab> — must run after listeners are set up
  {
    const tab = new URLSearchParams(window.location.search).get('tab');
    if (tab && panels[tab]) activateBuyerTab(tab);
  }

  // ── Active carts ─────────────────────────────────────────────────
  const cartsPanel = document.getElementById('panel-carts') as HTMLElement | null;
  const cartsList  = document.getElementById('carts-list')  as HTMLElement | null;

  const labelItems = cartsPanel?.dataset.labelItems ?? 'פריטים';
  const labelOpen  = cartsPanel?.dataset.labelOpen  ?? 'פתח עגלה';
  const labelVisit = cartsPanel?.dataset.labelVisit ?? 'בקר בחנות';
  const labelEmpty = cartsPanel?.dataset.labelEmpty ?? 'אין עגלות פעילות';

  function renderCarts(): void {
    if (!cartsList) return;
    const carts = getActiveStoreCarts();
    if (!carts.length) {
      cartsList.innerHTML = `<p class="muted" style="font-size:0.9rem;padding:0.25rem 0">${labelEmpty}</p>`;
      return;
    }
    cartsList.innerHTML = carts.map((c) => {
      const subtotal = getSubtotal(c.storeSlug);
      const initial  = (c.storeName[0] ?? '?').toUpperCase();
      return `
        <div class="home-cart-chip" role="listitem">
          <a
            href="/${encodeURIComponent(c.storeSlug)}"
            class="home-cart-chip__store"
            aria-label="${labelVisit} ${c.storeName}"
          >
            <div class="home-cart-chip__icon" aria-hidden="true">${initial}</div>
            <span class="home-cart-chip__name">${c.storeName}</span>
          </a>
          <span class="home-cart-chip__sep" aria-hidden="true"></span>
          <button
            type="button"
            class="home-cart-chip__cart"
            data-open-cart="${encodeURIComponent(c.storeSlug)}"
            aria-label="${labelOpen} — ${c.storeName}"
          >
            <span class="home-cart-chip__meta">${c.count} ${labelItems} · ${formatPrice(subtotal)}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </button>
        </div>`;
    }).join('');
  }

  cartsList?.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('[data-open-cart]');
    if (btn) window.dispatchEvent(new CustomEvent('cart:open'));
  });

  renderCarts();
  window.addEventListener('cart:change', renderCarts);

  /* ── Live messages badge ── */
  window.addEventListener('msg-badge-update', (e: Event) => {
    const count = (e as CustomEvent<number>).detail;
    const btn = document.querySelector<HTMLElement>('.my-nav-btn[data-tab="messages"]');
    if (!btn) return;
    let badge = btn.querySelector<HTMLElement>('.my-nav-badge');
    if (count > 0) {
      if (!badge) { badge = document.createElement('span'); badge.className = 'my-nav-badge'; btn.appendChild(badge); }
      badge.textContent = String(count);
    } else {
      badge?.remove();
    }
  });

  /* ── Profile edit ── */
  const editSave   = document.getElementById('edit-save') as HTMLButtonElement;
  const editError  = document.getElementById('edit-error')!;
  const editSuccess = document.getElementById('edit-success')!;
  const pwToggle   = document.getElementById('pw-toggle')!;
  const pwFields   = document.getElementById('pw-fields')!;
  const nameInput  = document.getElementById('edit-name') as HTMLInputElement;
  const emailInput = document.getElementById('edit-email') as HTMLInputElement;
  let curPwInput: HTMLInputElement | null = null;
  let newPwInput: HTMLInputElement | null = null;
  const displayName  = document.getElementById('display-name')!;
  const displayEmail = document.getElementById('display-email')!;

  function ensurePwFieldsRendered(): void {
    if (curPwInput) return; // already cloned in
    const tpl = document.getElementById('pw-fields-template') as HTMLTemplateElement | null;
    if (!tpl) return;
    pwFields.appendChild(tpl.content.cloneNode(true));
    curPwInput = document.getElementById('edit-cur-pw') as HTMLInputElement;
    newPwInput = document.getElementById('edit-new-pw') as HTMLInputElement;
  }

  pwToggle.addEventListener('click', () => {
    const isHidden = pwFields.hasAttribute('hidden');
    if (isHidden) {
      ensurePwFieldsRendered();
      pwFields.removeAttribute('hidden');
      pwToggle.textContent = I.profHidePw;
      curPwInput?.focus();
    } else {
      pwFields.setAttribute('hidden', '');
      pwToggle.textContent = I.profShowPw;
      if (curPwInput) curPwInput.value = '';
      if (newPwInput) newPwInput.value = '';
    }
  });

  editSave.addEventListener('click', async () => {
    editError.style.display = 'none';
    editSuccess.style.display = 'none';
    const body: Record<string, string> = {
      name: nameInput.value.trim(),
      email: emailInput.value.trim(),
    };
    if (!pwFields.hasAttribute('hidden') && newPwInput!.value) {
      body.currentPassword = curPwInput!.value;
      body.newPassword = newPwInput!.value;
    }

    editSave.disabled = true;
    try {
      const res = await fetch('/api/user/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json() as { ok?: boolean; error?: string; name?: string; email?: string };
      if (!res.ok || !data.ok) {
        editError.textContent = data.error ?? I.profErrorDefault;
        editError.style.display = 'block';
        return;
      }
      displayName.textContent  = data.name  ?? body.name;
      displayEmail.textContent = data.email ?? body.email;
      editSuccess.style.display = 'block';
      setTimeout(() => { editSuccess.style.display = 'none'; }, 3000);
      if (!pwFields.hasAttribute('hidden')) {
        pwFields.setAttribute('hidden', '');
        pwToggle.textContent = I.profShowPw;
        curPwInput!.value = '';
        newPwInput!.value = '';
      }
    } catch {
      editError.textContent = I.profErrorNetwork;
      editError.style.display = 'block';
    } finally {
      editSave.disabled = false;
    }
  });

  /* ── Buyer messages: expand / reply ── */
  function fmtDateBuyer(iso: string) {
    return new Date(iso).toLocaleString(I.dateLocale, { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
  }

  const currentBuyerId = (document.getElementById('panel-messages') as HTMLElement | null)?.dataset.userId ?? '';
  const buyerThreadLoaders = new Map<string, (markRead: boolean, viaPoll?: boolean) => void>();

  // ── Messages: sort + filter — mirrors the seller dashboard's own messages
  // toolbar (src/pages/seller/dashboard.astro) exactly: desktop uses header
  // controls (.sort-btn + funnel buttons), mobile uses a "sort by"/"filter
  // by" toolbar dropdown (table-toolbar is display:none above 640px).
  // Duplicated rather than shared since these are separate pages with their
  // own row shape (data-bmsg-id vs data-msg-id, store vs sender/status). ──
  // Looked up on each use rather than captured once, and that is not a style preference: this
  // panel's contents are REPLACED when the tab is reopened (refreshBuyerMessages below), so a
  // reference taken at load points at a detached node afterwards — sorting would silently move
  // rows inside a table nobody can see. Same reason the three values under it are functions: a
  // refresh that brings in the buyer's first unread message flips `mixedStatus`, and a `const`
  // captured before it would keep the status column's sort and filter permanently hidden.
  const bmsgTbodyEl = () => document.querySelector<HTMLTableSectionElement>('.msg-table tbody');
  const bmsgFilters = new Map<string, Set<string>>();
  const bmsgMixedStatus = () => document.querySelector<HTMLElement>('#panel-messages .table-toolbar')?.dataset.mixedStatus === 'true';
  const bmsgFilterColumns = (): string[] => [...(bmsgMixedStatus() ? ['status'] : []), 'product', 'store'];
  let bmsgSortCol: 'date' | 'unread' | 'product' = 'date';
  let bmsgSortDir: 'asc' | 'desc' = 'desc';
  let bmsgDashI18n: Record<string, string> = {};
  try { bmsgDashI18n = JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}').dashboard ?? {}; } catch { /* noop */ }
  const bI = {
    filterByLabel: bmsgDashI18n.filterByLabel ?? 'סנן לפי',
    filterClearAll: bmsgDashI18n.filterClearAll ?? 'נקה הכל',
    filterClearColumn: bmsgDashI18n.filterClearColumn ?? 'נקה סינון בעמודה זו',
    filterColStatus: bmsgDashI18n.filterColStatus ?? 'סטטוס',
    filterColStore: I.msgColStore,
    filterColProduct: I.msgColProduct,
    filterNoProduct: bmsgDashI18n.filterNoProduct ?? 'ללא מוצר',
    filterValUnread: bmsgDashI18n.filterValUnread ?? 'לא נקרא',
    filterValRead: bmsgDashI18n.filterValRead ?? 'נקרא',
    msgSortOptDateDesc: bmsgDashI18n.msgSortOptDateDesc ?? 'תאריך: חדש — ישן',
    msgSortOptDateAsc: bmsgDashI18n.msgSortOptDateAsc ?? 'תאריך: ישן — חדש',
    msgSortOptUnreadFirst: bmsgDashI18n.msgSortOptUnreadFirst ?? 'לא נקראו קודם',
    msgSortOptProductAsc: bmsgDashI18n.msgSortOptProductAsc ?? 'מוצר: א — ת',
    msgSortOptProductDesc: bmsgDashI18n.msgSortOptProductDesc ?? 'מוצר: ת — א',
  };

  const bmsgSortOptions = (): { col: 'date' | 'unread' | 'product'; dir: 'asc' | 'desc'; label: () => string }[] => [
    { col: 'date', dir: 'desc', label: () => bI.msgSortOptDateDesc },
    { col: 'date', dir: 'asc', label: () => bI.msgSortOptDateAsc },
    ...(bmsgMixedStatus() ? [{ col: 'unread' as const, dir: 'desc' as const, label: () => bI.msgSortOptUnreadFirst }] : []),
    { col: 'product', dir: 'asc', label: () => bI.msgSortOptProductAsc },
    { col: 'product', dir: 'desc', label: () => bI.msgSortOptProductDesc },
  ];

  function getBmsgFilterValue(row: HTMLElement, col: string): string {
    if (col === 'status') return row.classList.contains('msg-table__row--unread') ? bI.filterValUnread : bI.filterValRead;
    if (col === 'product') return row.dataset.filterProduct || bI.filterNoProduct;
    if (col === 'store') return row.dataset.filterStore || '';
    return '';
  }

  function rowMatchesBmsgFilters(row: HTMLElement): boolean {
    for (const [col, values] of bmsgFilters) {
      if (values.size === 0) continue;
      if (!values.has(getBmsgFilterValue(row, col))) return false;
    }
    return true;
  }

  function applyBmsgFilter(): void {
    // Pin the column widths before any row is hidden, so the columns can't
    // resize and slide the header out from under an open funnel dropdown.
    // Opening/closing a menu on its own does nothing. See
    // lib/table-column-lock.ts.
    if (bmsgFilters.size) lockTableColumns(document.querySelector<HTMLTableElement>('.msg-table'));
    document.querySelectorAll<HTMLElement>('[data-bmsg-id]').forEach((row) => {
      // Never hide a thread the buyer currently has open — becoming "read"
      // mid-view shouldn't make the row vanish out from under them.
      if (row.classList.contains('msg-table__row--open')) { row.hidden = false; return; }
      row.hidden = !rowMatchesBmsgFilters(row);
    });
  }

  function refreshBmsgFilterUI(): void {
    document.querySelectorAll<HTMLButtonElement>('.msg-table thead [data-filter-funnel-col]').forEach((btn) => {
      const col = btn.dataset.filterFunnelCol ?? '';
      if ((bmsgFilters.get(col)?.size ?? 0) > 0) btn.dataset.active = 'true'; else delete btn.dataset.active;
    });
    const badge = document.getElementById('bmsg-filter-count');
    if (badge) {
      const activeCols = [...bmsgFilters.values()].filter((s) => s.size > 0).length;
      badge.hidden = activeCols === 0;
      badge.textContent = String(activeCols);
    }
    if (!bmsgFilters.size) unlockTableColumns(document.querySelector<HTMLTableElement>('.msg-table'));
  }

  function getBmsgSortValue(row: HTMLElement, col: 'date' | 'unread' | 'product'): string | number {
    if (col === 'date') return row.dataset.sortDate ?? '';
    if (col === 'unread') return row.classList.contains('msg-table__row--unread') ? 1 : 0;
    if (col === 'product') return row.dataset.sortProduct ?? '';
    return '';
  }

  function refreshBmsgSortUI(): void {
    document.querySelectorAll<HTMLButtonElement>('.msg-table thead .sort-btn').forEach((btn) => {
      if (btn.dataset.sortCol === bmsgSortCol) { btn.dataset.active = 'true'; btn.dataset.dir = bmsgSortDir; }
      else { delete btn.dataset.active; delete btn.dataset.dir; }
    });
    const label = document.getElementById('bmsg-sort-label');
    if (label) {
      const opts = bmsgSortOptions();
      const opt = opts.find((o) => o.col === bmsgSortCol && o.dir === bmsgSortDir) ?? opts[0]!;
      label.textContent = opt.label();
    }
  }

  function sortBmsg(col: 'date' | 'unread' | 'product', dir: 'asc' | 'desc') {
    bmsgSortCol = col;
    bmsgSortDir = dir;
    const tbody = bmsgTbodyEl();
    if (!tbody) { refreshBmsgSortUI(); return; }
    const rows = Array.from(tbody.querySelectorAll<HTMLElement>('[data-bmsg-id]'));
    rows.sort((a, b) => {
      const va = getBmsgSortValue(a, col);
      const vb = getBmsgSortValue(b, col);
      const cmp = va < vb ? -1 : va > vb ? 1 : 0;
      return dir === 'asc' ? cmp : -cmp;
    });
    rows.forEach((row) => {
      tbody.append(row);
      const detail = document.getElementById(`bmsg-detail-${row.dataset.bmsgId}`);
      if (detail) tbody.append(detail);
    });
    refreshBmsgSortUI();
  }

  function bmsgHeaderSortClick(col: 'date' | 'unread' | 'product'): void {
    const defaultDir: 'asc' | 'desc' = col === 'product' ? 'asc' : 'desc';
    const dir: 'asc' | 'desc' = bmsgSortCol === col ? (bmsgSortDir === 'asc' ? 'desc' : 'asc') : defaultDir;
    sortBmsg(col, dir);
  }

  // ── Shared floating portal (own copy — see the equivalent in products.ts / the seller dashboard's own messages script) ──
  let bmsgPortalTrigger: HTMLElement | null = null;
  function getBmsgPortal(): HTMLElement {
    let portal = document.getElementById('bmsg-toolbar-portal');
    if (!portal) {
      portal = document.createElement('div');
      portal.id = 'bmsg-toolbar-portal';
      portal.className = 'toolbar-portal fixed bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] shadow-[0_4px_20px_rgba(0,0,0,0.13)] p-[.3rem] z-[300] animate-product-menu-open';
      portal.setAttribute('role', 'menu');
      portal.hidden = true;
      document.body.appendChild(portal);
    }
    return portal;
  }
  function positionBmsgPortal(portal: HTMLElement, trigger: HTMLElement): void {
    const isRTL = getComputedStyle(document.documentElement).direction === 'rtl';
    const margin = 8;
    const triggerRect = trigger.getBoundingClientRect();
    const portalRect = portal.getBoundingClientRect();
    let left = isRTL ? triggerRect.right - portalRect.width : triggerRect.left;
    left = Math.max(margin, Math.min(left, window.innerWidth - portalRect.width - margin));
    let top = triggerRect.bottom + 4;
    top = Math.min(top, Math.max(margin, window.innerHeight - portalRect.height - margin));
    portal.style.left = `${left}px`;
    portal.style.top = `${top}px`;
  }
  function closeBmsgPortal(): void {
    const portal = document.getElementById('bmsg-toolbar-portal');
    if (portal) portal.hidden = true;
    bmsgPortalTrigger?.setAttribute('aria-expanded', 'false');
    bmsgPortalTrigger = null;
  }
  function openBmsgPortal(trigger: HTMLElement, minWidth: string, buildHtml: () => string, wire: (portal: HTMLElement) => void): void {
    const portal = getBmsgPortal();
    bmsgPortalTrigger = trigger;
    portal.style.minWidth = minWidth;
    portal.style.maxHeight = '320px';
    portal.style.overflow = 'auto';
    portal.innerHTML = buildHtml();
    portal.hidden = false;
    positionBmsgPortal(portal, trigger);
    trigger.setAttribute('aria-expanded', 'true');
    wire(portal);
  }
  document.addEventListener('click', (e) => {
    const portal = document.getElementById('bmsg-toolbar-portal');
    if (!portal || portal.hidden) return;
    // composedPath(), not target.contains() — a portal click that swaps
    // portal.innerHTML (e.g. drilling into a filter column) detaches the
    // original e.target from the document mid-bubble, so a containment check
    // done here (after that swap already ran) wrongly reads as "outside" and
    // closes the portal the instant it opens its next level.
    const path = e.composedPath();
    if (path.includes(portal)) return;
    if (bmsgPortalTrigger && path.includes(bmsgPortalTrigger)) return;
    closeBmsgPortal();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeBmsgPortal(); });

  /**
   * Everything in this panel that binds to an element the panel itself OWNS — the sort and funnel
   * buttons in the table header, the mobile toolbar's two triggers, every thread row and every
   * delete button.
   *
   * It is a function because `refreshBuyerMessages` replaces the panel's contents, and a listener
   * is attached to an ELEMENT, not to a selector: after the swap those elements are gone and their
   * replacements are inert. Rows would stop opening, and nothing would say so.
   *
   * The dividing line, which is the whole reason this boundary sits exactly here: the portal's two
   * `document`-level listeners above are NOT in here. They are bound to the document, which no swap
   * replaces, so re-running them would add a second copy on every refresh — the classic re-init
   * bug, and on the reply button it would mean one click sending the message twice.
   */
  function bindBuyerMessagesPanel(): void {

  // ── Sort ──
  function openMobileBmsgSort(trigger: HTMLElement): void {
    openBmsgPortal(trigger, '13rem', () => {
      return bmsgSortOptions().map((o) => {
        const selected = o.col === bmsgSortCol && o.dir === bmsgSortDir;
        return `<button type="button" class="product-menu__item flex items-center gap-2 w-full py-[.45rem] px-3 rounded-[var(--radius-sm)] bg-transparent border-0 cursor-pointer font-[inherit] text-[.875rem] [color:var(--color-text)] text-start transition-colors duration-100 hover:bg-[color:var(--color-bg)]" data-sort-col="${o.col}" data-sort-dir="${o.dir}" style="${selected ? 'font-weight:700;color:var(--color-primary)' : ''}">${escB(o.label())}</button>`;
      }).join('');
    }, (portal) => {
      portal.querySelectorAll<HTMLButtonElement>('[data-sort-col]').forEach((btn) => {
        btn.addEventListener('click', () => {
          sortBmsg((btn.dataset.sortCol as 'date' | 'unread' | 'product') ?? 'date', (btn.dataset.sortDir as 'asc' | 'desc') ?? 'desc');
          closeBmsgPortal();
        });
      });
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.msg-table thead .sort-btn').forEach((btn) => {
    btn.addEventListener('click', () => bmsgHeaderSortClick((btn.dataset.sortCol as 'date' | 'unread' | 'product') ?? 'date'));
  });

  const bmsgSortTrigger = document.getElementById('bmsg-sort-trigger') as HTMLButtonElement | null;
  bmsgSortTrigger?.addEventListener('click', () => {
    if (bmsgPortalTrigger === bmsgSortTrigger) { closeBmsgPortal(); return; }
    openMobileBmsgSort(bmsgSortTrigger);
  });

  // ── Filter ──
  function bmsgFilterColumnLabel(col: string): string {
    if (col === 'status') return bI.filterColStatus;
    if (col === 'product') return bI.filterColProduct;
    if (col === 'store') return bI.filterColStore;
    return col;
  }
  function getBmsgDistinctValues(col: string): string[] {
    const values = new Set<string>();
    document.querySelectorAll<HTMLElement>('[data-bmsg-id]').forEach((row) => values.add(getBmsgFilterValue(row, col)));
    return [...values].sort();
  }
  function bmsgFilterValuesHtml(col: string, showBack: boolean): string {
    const label = bmsgFilterColumnLabel(col);
    const values = getBmsgDistinctValues(col);
    const selected = bmsgFilters.get(col) ?? new Set<string>();
    const backRotate = document.documentElement.dir === 'rtl' ? -90 : 90;
    const backHtml = showBack
      ? `<button type="button" class="product-menu__back flex items-center gap-[.35rem] w-full text-start py-[.45rem] px-3 rounded-[var(--radius-sm)] bg-transparent border-0 cursor-pointer font-[inherit] text-[.85rem] font-semibold [color:var(--color-text)] transition-colors duration-100 hover:bg-[color:var(--color-bg)]" data-filter-back><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transform:rotate(${backRotate}deg)"><polyline points="6 9 12 15 18 9"/></svg>${escB(label)}</button><div class="product-menu__divider h-px bg-[color:var(--color-border)] my-[.3rem]"></div>`
      : '';
    return [
      backHtml,
      ...values.map((v) => `<label class="product-menu__checkbox-item flex items-center gap-[.4rem] py-[.45rem] px-3 rounded-[var(--radius-sm)] cursor-pointer text-[.82rem] [color:var(--color-text)] transition-colors duration-100 hover:bg-[color:var(--color-bg)]"><input type="checkbox" class="cursor-pointer shrink-0" data-filter-value="${escB(v)}" ${selected.has(v) ? 'checked' : ''}>${escB(v)}</label>`),
      `<div class="product-menu__divider h-px bg-[color:var(--color-border)] my-[.3rem]"></div>`,
      filterClearButtonHtml('data-filter-clear-col', bI.filterClearColumn, selected.size > 0),
    ].join('');
  }
  function wireBmsgFilterValues(portal: HTMLElement, col: string, reopen: () => void, onBack?: () => void): void {
    portal.querySelectorAll<HTMLInputElement>('[data-filter-value]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const set = bmsgFilters.get(col) ?? new Set<string>();
        if (cb.checked) set.add(cb.dataset.filterValue ?? ''); else set.delete(cb.dataset.filterValue ?? '');
        if (set.size) bmsgFilters.set(col, set); else bmsgFilters.delete(col);
        applyBmsgFilter();
        refreshBmsgFilterUI();
      });
    });
    portal.querySelector('[data-filter-clear-col]')?.addEventListener('click', () => {
      if (!bmsgFilters.has(col)) return;
      bmsgFilters.delete(col);
      applyBmsgFilter();
      refreshBmsgFilterUI();
      reopen();
    });
    if (onBack) portal.querySelector('[data-filter-back]')?.addEventListener('click', onBack);
  }

  function openDesktopBmsgFunnel(btn: HTMLButtonElement, col: string): void {
    openBmsgPortal(btn, '10rem', () => bmsgFilterValuesHtml(col, false), (portal) => {
      wireBmsgFilterValues(portal, col, () => openDesktopBmsgFunnel(btn, col));
    });
  }

  function bmsgFilterColumnsHtml(): string {
    const chevronRotate = document.documentElement.dir === 'rtl' ? 90 : -90;
    return [
      ...bmsgFilterColumns().map((col) => {
        const active = (bmsgFilters.get(col)?.size ?? 0) > 0;
        return `<div class="product-menu__item flex items-center gap-2 w-full py-[.45rem] px-3 rounded-[var(--radius-sm)] cursor-pointer font-[inherit] text-[.875rem] [color:var(--color-text)] transition-colors duration-100 hover:bg-[color:var(--color-bg)]" data-filter-col="${col}">
          <input type="checkbox" class="cursor-pointer shrink-0" data-filter-col-toggle="${col}" ${active ? 'checked' : ''}>
          <span style="flex:1">${escB(bmsgFilterColumnLabel(col))}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transform:rotate(${chevronRotate}deg)"><polyline points="6 9 12 15 18 9"/></svg>
        </div>`;
      }).join(''),
      `<div class="product-menu__divider h-px bg-[color:var(--color-border)] my-[.3rem]"></div>`,
      filterClearButtonHtml('data-filter-clear-all', bI.filterClearAll, bmsgFilters.size > 0),
    ].join('');
  }

  function openMobileBmsgFilterColumns(trigger: HTMLElement): void {
    openBmsgPortal(trigger, '11rem', bmsgFilterColumnsHtml, (portal) => {
      portal.querySelectorAll<HTMLElement>('[data-filter-col]').forEach((row) => {
        const col = row.dataset.filterCol ?? '';
        row.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('[data-filter-col-toggle]')) return;
          openMobileBmsgFilterValues(trigger, col);
        });
        const cb = row.querySelector<HTMLInputElement>('[data-filter-col-toggle]');
        cb?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (cb.checked) {
            cb.checked = false;
            openMobileBmsgFilterValues(trigger, col);
            return;
          }
          bmsgFilters.delete(col);
          applyBmsgFilter();
          refreshBmsgFilterUI();
          openMobileBmsgFilterColumns(trigger);
        });
      });
      portal.querySelector('[data-filter-clear-all]')?.addEventListener('click', () => {
        if (!bmsgFilters.size) return;
        bmsgFilters.clear();
        applyBmsgFilter();
        refreshBmsgFilterUI();
        openMobileBmsgFilterColumns(trigger);
      });
    });
  }
  function openMobileBmsgFilterValues(trigger: HTMLElement, col: string): void {
    openBmsgPortal(trigger, '11rem', () => bmsgFilterValuesHtml(col, true), (portal) => {
      wireBmsgFilterValues(portal, col, () => openMobileBmsgFilterValues(trigger, col), () => openMobileBmsgFilterColumns(trigger));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.msg-table thead [data-filter-funnel-col]').forEach((btn) => {
    const col = btn.dataset.filterFunnelCol ?? '';
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (bmsgPortalTrigger === btn) { closeBmsgPortal(); return; }
      openDesktopBmsgFunnel(btn, col);
    });
  });

  const bmsgFilterTrigger = document.getElementById('bmsg-filter-trigger') as HTMLButtonElement | null;
  bmsgFilterTrigger?.addEventListener('click', () => {
    if (bmsgPortalTrigger === bmsgFilterTrigger) { closeBmsgPortal(); return; }
    openMobileBmsgFilterColumns(bmsgFilterTrigger);
  });

  refreshBmsgSortUI();
  refreshBmsgFilterUI();

  document.querySelectorAll<HTMLElement>('[data-bmsg-id]').forEach((row) => {
    const id        = row.dataset.bmsgId ?? '';
    const threadRow = document.getElementById(`bmsg-detail-${id}`) as HTMLTableRowElement | null;
    const repliesEl = document.getElementById(`breplies-${id}`);
    let isOpen = false;

    // viaPoll = the live poll found new replies while this thread was already
    // open — the one case that needs its own toast, keyed by the *reply's
    // own* id so it matches (and dedupes against) the site-wide notification poller.
    function loadThread(markRead: boolean, viaPoll = false) {
      fetch(`/api/messages?repliesFor=${id}`)
        .then((r) => r.json())
        .then(({ replies }: { replies: { id: string; fromUserId: string; fromName: string; content: string; createdAt: string; readByBuyer?: boolean }[] }) => {
          if (!repliesEl) return;
          [...repliesEl.children].slice(1).forEach((c) => c.remove());
          replies.forEach((r) => {
            const isSelf = r.fromUserId === currentBuyerId;
            const div = document.createElement('div');
            div.className = `msg-thread-entry ${isSelf ? 'msg-thread-entry--buyer' : 'msg-thread-entry--seller'}`;
            div.innerHTML = `<div class="msg-thread-entry__header"><span class="msg-thread-entry__who">${escB(isSelf ? I.msgYou : r.fromName)}</span><span class="msg-thread-entry__date">${escB(fmtDateBuyer(r.createdAt))}</span></div><div class="msg-thread-entry__body">${escB(r.content)}</div>`;
            repliesEl.appendChild(div);
          });
          if (replies.length > 0) {
            const last = replies[replies.length - 1]!;
            const isSelf = last.fromUserId === currentBuyerId;
            const previewTd = row.querySelector('.msg-table__td--preview');
            if (previewTd) previewTd.innerHTML = `${escB(last.content)}${isSelf ? ` <span class="msg-table__preview-you">(${escB(I.msgYou)})</span>` : ''}`;
            const dateTd = row.querySelector('.msg-table__td--date');
            if (dateTd) dateTd.textContent = fmtDateBuyer(last.createdAt);
            row.dataset.sortDate = last.createdAt;
            if (viaPoll && markRead && !isSelf) {
              window.dispatchEvent(new CustomEvent('toast:show', { detail: {
                title: I.msgNewToast, body: last.fromName, key: last.id,
                href: '/buyer/dashboard?tab=messages',
              } }));
            }
          }
          if (markRead) {
            row.classList.remove('msg-table__row--unread');
            document.querySelector('.my-nav-btn[data-tab="messages"] .my-nav-badge')?.remove();
            applyBmsgFilter();
            fetch('/api/messages', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'mark-read-buyer', id }) })
              .then(() => window.dispatchEvent(new CustomEvent('notif-refreshed'))).catch(() => {});
          }
          // Scrolls to the reply CONTROLS, without focusing the box — it is closed
          // until "כתוב תגובה" is pressed (2026-08-10). Same change on the seller
          // side; reasoning at `.seller-msg-reply-form` in utilities/utils.css.
          threadRow?.querySelector<HTMLElement>('[data-breply-for]')?.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }).catch(() => {});
    }

    buyerThreadLoaders.set(id, loadThread);

    function closeThread() {
      if (!threadRow) return;
      threadRow.hidden = true;
      row.setAttribute('aria-expanded', 'false');
      row.classList.remove('msg-table__row--open');
      isOpen = false;
    }
    function openThread() {
      if (!threadRow) return;
      threadRow.hidden = false;
      row.setAttribute('aria-expanded', 'true');
      row.classList.add('msg-table__row--open');
      isOpen = true;
      loadThread(row.classList.contains('msg-table__row--unread'));
    }

    row.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      isOpen ? closeThread() : openThread();
    });
    row.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); row.click(); }
    });

    const replyForm = threadRow?.querySelector<HTMLElement>('[data-breply-for]');
    if (replyForm) {
      const textarea  = replyForm.querySelector<HTMLTextAreaElement>('textarea')!;
      const sendBtn   = replyForm.querySelector<HTMLButtonElement>('.seller-msg-reply-send')!;
      const closeBtn  = replyForm.querySelector<HTMLButtonElement>('.seller-msg-reply-close')!;
      const openBtn   = replyForm.querySelector<HTMLButtonElement>('.seller-msg-reply-open')!;
      const cancelBtn = replyForm.querySelector<HTMLButtonElement>('.seller-msg-reply-cancel')!;

      // Two states over one button row — twin of the seller dashboard's
      // (scripts/dashboard/messages.ts#bindMessageRow).
      const setComposing = (on: boolean): void => {
        textarea.hidden = !on;
        sendBtn.hidden = !on;
        cancelBtn.hidden = !on;
        openBtn.hidden = on;
        closeBtn.hidden = on;
        openBtn.setAttribute('aria-expanded', String(on));
      };
      openBtn.addEventListener('click', () => { setComposing(true); textarea.focus(); });
      // Focus back onto the button that reopens the box — a control that is about to be
      // `hidden` must not keep it, or the next Tab restarts from the top of the page.
      cancelBtn.addEventListener('click', () => { textarea.value = ''; setComposing(false); openBtn.focus(); });

      closeBtn.addEventListener('click', () => {
        closeThread();
        row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      sendBtn.addEventListener('click', async () => {
        const content = textarea.value.trim();
        if (!content) return;
        sendBtn.disabled = true;
        try {
          const res = await fetch('/api/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ replyToId: id, content }),
          });
          const data = await res.json() as { ok?: boolean; error?: string; message?: { content: string; createdAt: string } };
          // The REQUEST decides whether this failed, never `repliesEl` — a reply that reached the
          // server with its thread collapsed must not be reported as unsent, or the buyer sends it
          // twice. Same split as the seller-side twin in scripts/dashboard/messages.ts.
          if (!res.ok || !data.ok || !data.message) {
            // Silent until 2026-08-10 — the send button came back and no bubble appeared, which
            // reads as sent. The typed text stays put so one more press re-sends it.
            // A sentence from the server wins over the generic one: the flood limiter
            // (lib/message-flood.ts) refuses on a rule, and "try again" is wrong advice for it.
            if (data.error) showErrorToast(data.error);
            else showActionFailedToast();
          } else {
            if (repliesEl) {
              const div = document.createElement('div');
              div.className = 'msg-thread-entry msg-thread-entry--buyer';
              div.innerHTML = `<div class="msg-thread-entry__header"><span class="msg-thread-entry__who">${escB(I.msgYou)}</span><span class="msg-thread-entry__date">${escB(fmtDateBuyer(data.message.createdAt))}</span></div><div class="msg-thread-entry__body">${escB(data.message.content)}</div>`;
              repliesEl.appendChild(div);
            }
            const previewTd = row.querySelector('.msg-table__td--preview');
            if (previewTd) previewTd.innerHTML = `${escB(data.message.content)} <span class="msg-table__preview-you">(${escB(I.msgYou)})</span>`;
            const dateTd = row.querySelector('.msg-table__td--date');
            if (dateTd) dateTd.textContent = fmtDateBuyer(data.message.createdAt);
            row.dataset.sortDate = data.message.createdAt;
            textarea.value = '';
            setComposing(false);
            openBtn.focus();
          }
        } catch {
          showActionFailedToast();
        } finally {
          sendBtn.disabled = false;
        }
      });
    }
  });

  /* ── Delete message thread ── */
  document.querySelectorAll<HTMLButtonElement>('[data-delete-bmsg-id]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.dataset.deleteBmsgId ?? '';
      // Site-styled ConfirmModal (rendered by BaseLayout), never the native
      // confirm(). Message/cancel/working labels fall back to the shared
      // `confirm` i18n block in #i18n-data, so nothing here is hardcoded.
      window.dispatchEvent(new CustomEvent('confirm:open', {
        detail: {
          title: I.msgDeleteConfirm,
          okLabel: I.msgDeleteOk,
          onConfirm: async () => {
            try {
              const res = await fetch('/api/messages', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'delete', id }),
              });
              if (!res.ok) throw new Error('request failed');
              const row = btn.closest('tr');
              const nextRow = row?.nextElementSibling;
              row?.remove();
              if (nextRow?.classList.contains('msg-thread-row')) nextRow.remove();
            } catch {
              showErrorToast(I.profErrorNetwork);
            }
          },
        },
      }));
    });
  });

  } // end bindBuyerMessagesPanel

  bindBuyerMessagesPanel();

  /**
   * Re-render the messages panel from the server.
   *
   * The 15s poll can only update rows that already exist — it walks `[data-bmsg-id]` and marks them
   * read or unread. A conversation a seller started since the page loaded has no row to walk, so it
   * simply did not appear until the buyer reloaded (owner, 2026-08-11: this needs fixing).
   *
   * **The panel's HTML comes from the server, not from a builder here.** A row carries a store
   * avatar, a thread panel, a reply form and eight translated strings; rebuilt in JavaScript it
   * would be a second renderer of the same thing, which is a bug class this project has already
   * paid for — the client copy keeps its Hebrew literals while the server copy moves on to the
   * dictionary. Fetching the page and lifting one panel out of it is what the admin dashboard does
   * for exactly this reason (`swapPanel`), so the markup can only ever have one author.
   *
   * What survives the swap is what the buyer chose: their filters, their sort, and any thread they
   * had expanded. What does not survive is anything they typed — which is why this is never reached
   * with unsaved text in the panel (`refreshBuyerPanel` asks `panelHoldsTypedText` first).
   */
  let bmsgRefreshInFlight = false;
  async function refreshBuyerMessages(): Promise<void> {
    const panel = document.getElementById('panel-messages');
    if (!panel || bmsgRefreshInFlight) return;
    bmsgRefreshInFlight = true;
    try {
      const openIds = new Set(
        Array.from(panel.querySelectorAll<HTMLElement>('.msg-table__row--open'))
          .map((r) => r.dataset.bmsgId ?? '')
          .filter(Boolean),
      );

      const res = await fetch('/buyer/dashboard?tab=messages');
      if (!res.ok) return;
      const next = new DOMParser()
        .parseFromString(await res.text(), 'text/html')
        .getElementById('panel-messages');
      // No panel in the response means the session ended or the route changed shape. Leaving the
      // old contents up is the safe answer: they are stale, not wrong, and blanking the tab would
      // look like the buyer's conversations had been deleted.
      if (!next) return;

      panel.innerHTML = next.innerHTML;
      // The loaders map is keyed by thread id and closes over rows that no longer exist. Cleared
      // rather than left to be overwritten, so a thread deleted on another device cannot leave a
      // loader behind that the unread poll would still call.
      buyerThreadLoaders.clear();
      bindBuyerMessagesPanel();

      // The buyer's own view of the list, put back: sort first (it reorders rows), then filters,
      // then whatever they had open. A thread that no longer exists is simply not reopened.
      sortBmsg(bmsgSortCol, bmsgSortDir);
      refreshBmsgFilterUI();
      applyBmsgFilter();
      for (const id of openIds) {
        panel.querySelector<HTMLElement>(`[data-bmsg-id="${CSS.escape(id)}"]`)?.click();
      }

      markPanelFresh('buyer:messages');
    } catch {
      // silent: the buyer did not press anything — this fires from opening a tab, and its failure
      // costs them nothing they can see. The panel keeps the conversations it already had, which
      // are stale rather than wrong, and nothing marked it fresh, so the next open simply tries
      // again. A toast here would report a problem about an action the buyer never took.
    } finally {
      bmsgRefreshInFlight = false;
    }
  }

  /* ── Order card accordion (bindOrderCard is reused after every AJAX rebuild) ── */
  function bindOrderCard(card: HTMLElement): void {
    if (card.dataset.bound === '1') return;
    card.dataset.bound = '1';
    const hd = card.querySelector<HTMLElement>('.o-card__hd');
    const body = card.querySelector<HTMLElement>('.o-card__body');
    // Collapsed-header thumbnails are visible immediately (unlike the expanded
    // body's own item images, gated below on first expand). They used to be
    // decoded-then-revealed here, which held cached photos invisible until this
    // bundle ran and shimmered over them meanwhile; the shared module owns that
    // now and this call only has to reach the newly bound card. It is idempotent
    // — it consumes the data-skeleton marker as it takes each wrap.
    initImageSkeletons('.o-thumb-wrap');
    hd?.addEventListener('click', () => {
      const isOpen = card.classList.contains('o-card--open');
      card.classList.toggle('o-card--open', !isOpen);
      hd.setAttribute('aria-expanded', String(!isOpen));
      if (body) body.hidden = isOpen;
      if (!isOpen) {
        card.querySelectorAll<HTMLElement>('.o-item__img-wrap:not(.loaded)').forEach((wrap) => {
          const img = wrap.querySelector<HTMLImageElement>('img');
          if (img) img.decode().then(() => wrap.classList.add('loaded')).catch(() => wrap.classList.add('loaded'));
        });
      }
    });
    hd?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); hd.click(); }
    });
  }
  document.querySelectorAll<HTMLElement>('.o-card').forEach(bindOrderCard);

  // ── Orders: server-fetched page/search/sub-tab (AJAX) ──────────────
  // Mirrors the seller dashboard's own Orders-tab pagination pattern
  // (buyer-orders-query.ts is the server-side counterpart of
  // seller-orders-query.ts). No sort here — this tab only needs
  // search + an active/history split, not a sort menu.
  interface BuyerOrderJson {
    id: string; createdAt: string; totalAgorot: number;
    shippingStatus: string; trackingNumber?: string;
    items: { storeSlug: string; storeName: string; productName: string; qty: number; priceAgorot: number; image?: string }[];
    storeSubtotals: Record<string, { subtotalAgorot: number; shippingAgorot: number; discount?: { appliedAgorot: number } }>;
  }
  /** The server's BuyerPurchase, as it arrives over the wire (lib/buyer-purchases.ts). */
  interface BuyerPurchaseJson {
    ref: string; createdAt: string; totalAgorot: number; status: string;
    slices: { storeSlug: string; storeName: string; order: BuyerOrderJson }[];
  }

  const shipLabelClient: Record<string, string> = {
    pending: I.shipPending, processing: I.shipProcessing, ready: I.shipReady,
    shipped: I.shipShipped, delivered: I.shipDelivered, cancelled: I.shipCancelled,
  };
  /** Twin of the server's own badge markup — same class, same cancelled variant. */
  function shipBadge(status: string): string {
    return `<span class="o-badge o-badge--ship${status === 'cancelled' ? ' o-badge--cancelled' : ''}">${escB(shipLabelClient[status] ?? status)}</span>`;
  }

  // Server twin: the `{ordersPageResult.items.map(...)}` block in this file's markup. Any change
  // to one is a change to both — an AJAX page/search/sub-tab rebuild goes through here.
  function buildOrderCardHTML(p: BuyerPurchaseJson): string {
    const allItems = p.slices.flatMap((s) => s.order.items);
    const split = p.slices.length > 1;
    const thumbs = allItems.filter((i) => i.image).slice(0, 3);
    const thumbsHtml = thumbs.length ? `<div class="o-thumbs">${thumbs.map((i) =>
      `<span class="o-thumb-wrap" data-skeleton><img src="${escB(cdnThumb(i.image!, 104, 104))}" alt="${escB(i.productName)}" width="52" height="52" loading="lazy" decoding="async" class="o-thumb" /></span>`).join('')}</div>` : '';
    // Server twin: STORES_NAMED in this file's frontmatter.
    const named = p.slices.slice(0, 2);
    const storesHtml = named.map((s, idx) =>
      `<span>${escB(s.storeName)}</span>${idx < named.length - 1 ? '<span aria-hidden="true">, </span>' : ''}`).join('')
      + (p.slices.length > named.length
        ? ` <span class="o-stores-more">${escB(I.orderStoresMore.replace('{count}', String(p.slices.length - named.length)))}</span>`
        : '');
    const itemsLine = allItems.map((i) => `${escB(i.productName)} × ${i.qty}`).join(' · ');
    const bodyGroups = p.slices.map((s) => {
      const sub = s.order.storeSubtotals[s.storeSlug];
      const itemsHtml = s.order.items.map((item) => `
        <li class="o-item">
          ${item.image
            ? `<span class="o-item__img-wrap"><img src="${escB(cdnThumb(item.image, 80, 80))}" alt="${escB(item.productName)}" width="40" height="40" loading="lazy" decoding="async" class="o-item__img" /></span>`
            : `<div class="o-item__img-placeholder" aria-hidden="true"></div>`}
          <span class="o-item__name">${escB(item.productName)}</span>
          <span class="o-item__qty">×${item.qty}</span>
          <span class="o-item__price">${fmtAgorotBuyer(item.priceAgorot * item.qty)}</span>
        </li>`).join('');
      const subHtml = sub ? `
        <div class="o-store-sub">
          <span>${escB(I.shippingLabel)}: ${sub.shippingAgorot === 0 ? escB(I.freeShipping) : fmtAgorotBuyer(sub.shippingAgorot)}</span>
          ${sub.discount?.appliedAgorot ? `<span>${escB(I.orderDiscount)}: −${fmtAgorotBuyer(sub.discount.appliedAgorot)}</span>` : ''}
          <strong>${fmtAgorotBuyer(storeSliceTotalAgorot(sub))}</strong>
        </div>` : '';
      const trackingHtml = s.order.trackingNumber
        ? `<p class="o-tracking">${escB(I.trackingNumber)}: <strong>${escB(s.order.trackingNumber)}</strong></p>` : '';
      return `
        <div class="o-store-group">
          <div class="o-store-head">
            <a href="/${encodeURIComponent(s.storeSlug)}" class="o-store-name" style="text-decoration:none;color:inherit;cursor:pointer">${escB(s.storeName)}</a>
            ${split ? shipBadge(s.order.shippingStatus) : ''}
          </div>
          <ul class="o-item-list">${itemsHtml}</ul>
          ${subHtml}
          ${trackingHtml}
        </div>`;
    }).join('');
    const grandTotalHtml = split ? `
      <div class="o-grand-total">
        <span>${escB(I.orderTotalAll)}</span>
        <strong>${fmtAgorotBuyer(p.totalAgorot)}</strong>
      </div>` : '';

    return `<div class="o-card">
      <div class="o-card__hd" role="button" tabindex="0" aria-expanded="false">
        ${thumbsHtml}
        <div class="o-card__hd-top">
          <span class="o-id">#${escB(p.ref)}</span>
          <span class="o-date">${escB(fmtDateBuyer(p.createdAt))}</span>
        </div>
        <div class="o-card__hd-main">
          <div class="o-card__stores">${storesHtml}</div>
          <div class="o-items">${itemsLine}</div>
          <div class="o-foot">
            ${shipBadge(p.status)}
            <span class="o-total">${fmtAgorotBuyer(p.totalAgorot)}</span>
          </div>
        </div>
        <svg class="o-card__chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <div class="o-card__body" hidden>
        <p class="o-section-title">${escB(I.orderItems)}</p>
        ${bodyGroups}
        ${grandTotalHtml}
      </div>
    </div>`;
  }

  function fmtPriceBuyer(n: number): string { return `${n.toLocaleString('he-IL')} ₪`; }
  /** Server twin: money.ts#formatAgorot. /api/buyer/orders returns agorot. */
  function fmtAgorotBuyer(agorot: number): string { return fmtPriceBuyer(agorot / 100); }

  function renderOrderSkeletons(count: number): string {
    return Array.from({ length: count }, () => `
      <div class="o-card-skel" aria-hidden="true">
        <div class="o-skel-block o-card-skel__line o-card-skel__line--id"></div>
        <div class="o-card-skel__row">
          <div class="o-skel-block o-card-skel__thumb"></div>
          <div class="o-card-skel__lines">
            <div class="o-skel-block o-card-skel__line o-card-skel__line--stores"></div>
            <div class="o-skel-block o-card-skel__line o-card-skel__line--items"></div>
            <div class="o-skel-block o-card-skel__line o-card-skel__line--foot"></div>
          </div>
        </div>
      </div>`).join('');
  }

  let ordersCurrentPage = 1;
  let ordersSearchQuery = (document.getElementById('orders-search-input') as HTMLInputElement | null)?.value.trim() ?? '';
  let ordersHistory = document.getElementById('o-subtab-history')?.classList.contains('is-active') ?? false;
  // Guards against an out-of-order response (e.g. a fast double-click on
  // Next, or a quick sub-tab switch) repainting the list with stale data —
  // only the most recently *fired* request is allowed to render.
  let ordersRequestSeq = 0;

  async function applyBuyerOrdersPagination(): Promise<void> {
    const list = document.getElementById('orders-list');
    if (!list) return;
    const mySeq = ++ordersRequestSeq;

    // Only show the skeleton if the fetch is actually slow. The guard was already here and the
    // threshold was simply too low: at 200ms it fired on nearly every sub-tab switch, because these
    // requests answer in roughly 220-380ms — so the skeleton appeared for a tenth of a second and
    // vanished, which reads as noise rather than as loading (owner, 2026-08-03). It now shares the
    // site's one threshold (lib/loading-sweep.ts), so switching between orders and history normally
    // shows nothing at all and only a genuinely slow connection sees the skeleton.
    const skeletonTimer = setTimeout(() => {
      if (mySeq === ordersRequestSeq) list.innerHTML = renderOrderSkeletons(BUYER_ORDER_PAGE_SIZE);
    }, LOADING_CUE_DELAY_MS);

    const params = new URLSearchParams();
    params.set('page', String(ordersCurrentPage));
    if (ordersSearchQuery) params.set('oq', ordersSearchQuery);
    params.set('ohist', ordersHistory ? '1' : '0');

    let data: { ok: boolean; purchases?: BuyerPurchaseJson[]; page?: number; totalPages?: number; total?: number; counts?: { active: number; history: number } };
    try {
      const res = await fetch(`/api/buyer/orders?${params.toString()}`);
      data = await res.json() as typeof data;
    } catch {
      clearTimeout(skeletonTimer);
      if (mySeq === ordersRequestSeq) list.innerHTML = `<p class="empty">${escB(I.ordersLoadError)}</p>`;
      return;
    }
    clearTimeout(skeletonTimer);
    if (mySeq !== ordersRequestSeq) return; // a newer request already resolved/is in flight
    if (!data.ok) { list.innerHTML = `<p class="empty">${escB(I.ordersLoadError)}</p>`; return; }

    ordersCurrentPage = data.page ?? 1;
    list.innerHTML = (data.purchases ?? []).map(buildOrderCardHTML).join('');
    list.querySelectorAll<HTMLElement>('.o-card').forEach(bindOrderCard);

    const total = data.total ?? 0;
    const emptyEl = document.getElementById('orders-empty');
    if (emptyEl) {
      emptyEl.hidden = total !== 0;
      emptyEl.textContent = ordersSearchQuery
        ? I.ordersSearchEmpty
        : (ordersHistory ? I.ordersEmptyHistory : I.ordersEmptyActive);
    }
    renderOrdersPaginationControls(data.totalPages ?? 1);
    if (data.counts) applyOrderCounts(data.counts.active, data.counts.history);
    markPanelFresh('buyer:orders');
  }

  /** The three places the same two numbers appear — sidebar, and the two sub-tabs — written from
   *  ONE response. They were three server-rendered figures that could only be corrected by
   *  reloading the page, which is precisely the staleness this refresh exists to remove; leaving
   *  any of them out would have swapped "all three are old" for "they disagree", which is worse. */
  function applyOrderCounts(active: number, history: number): void {
    const write = (id: string, n: number) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = n > 0 ? String(n) : '';
      el.hidden = n === 0;
    };
    write('nav-orders-count', active);
    write('o-count-active', active);
    write('o-count-history', history);
  }

  function renderOrdersPaginationControls(totalPages: number): void {
    const nav = document.getElementById('orders-pagination') as HTMLElement | null;
    if (!nav) return;
    if (totalPages <= 1) { nav.hidden = true; nav.innerHTML = ''; return; }
    const pageInfo = I.paginationPageInfo.replace('{page}', String(ordersCurrentPage)).replace('{total}', String(totalPages));
    nav.hidden = false;
    nav.innerHTML = `
      <button type="button" class="btn btn--ghost btn--sm" data-page-prev${ordersCurrentPage <= 1 ? ' disabled' : ''}>${escB(I.paginationPrev)}</button>
      <span class="o-pagination-info">${escB(pageInfo)}</span>
      <button type="button" class="btn btn--ghost btn--sm" data-page-next${ordersCurrentPage >= totalPages ? ' disabled' : ''}>${escB(I.paginationNext)}</button>
    `;
  }

  function initBuyerOrdersPagination(): void {
    const nav = document.getElementById('orders-pagination') as HTMLElement | null;
    if (!nav) return;
    ordersCurrentPage = parseInt(nav.dataset.page ?? '1', 10) || 1;
    renderOrdersPaginationControls(parseInt(nav.dataset.totalPages ?? '1', 10) || 1);
    nav.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-page-prev], [data-page-next]');
      if (!btn || btn.disabled) return;
      ordersCurrentPage += btn.hasAttribute('data-page-prev') ? -1 : 1;
      applyBuyerOrdersPagination();
      document.getElementById('orders-list')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
  initBuyerOrdersPagination();

  const ordersSearchInputEl = document.getElementById('orders-search-input') as HTMLInputElement | null;
  // Starts `readonly` (see markup) and only becomes editable on the user's
  // first real focus — a read-only field can't be autofilled, which is the
  // one thing that reliably stops Chrome from treating it as a login field
  // and force-suggesting saved username/password (this page also has real
  // password inputs elsewhere in the DOM, in the hidden Profile panel).
  ordersSearchInputEl?.addEventListener('focus', () => ordersSearchInputEl.removeAttribute('readonly'), { once: true });

  ordersSearchInputEl?.addEventListener('input', debounce((e: Event) => {
    ordersSearchQuery = (e.target as HTMLInputElement).value.trim();
    ordersCurrentPage = 1;
    applyBuyerOrdersPagination();
  }, 300));

  document.getElementById('orders-search-clear')?.addEventListener('click', () => {
    if (!ordersSearchInputEl) return;
    ordersSearchInputEl.removeAttribute('readonly');
    ordersSearchInputEl.value = '';
    ordersSearchInputEl.focus();
    ordersSearchQuery = '';
    ordersCurrentPage = 1;
    applyBuyerOrdersPagination();
  });

  function activateOrdersSubtab(history: boolean): void {
    ordersHistory = history;
    ordersCurrentPage = 1;
    document.getElementById('o-subtab-active')?.classList.toggle('is-active', !history);
    document.getElementById('o-subtab-active')?.setAttribute('aria-selected', String(!history));
    document.getElementById('o-subtab-history')?.classList.toggle('is-active', history);
    document.getElementById('o-subtab-history')?.setAttribute('aria-selected', String(history));
    applyBuyerOrdersPagination();
  }
  document.getElementById('o-subtab-active')?.addEventListener('click', () => activateOrdersSubtab(false));
  document.getElementById('o-subtab-history')?.addEventListener('click', () => activateOrdersSubtab(true));

  function refreshRowPreview(id: string, row: HTMLElement) {
    fetch(`/api/messages?repliesFor=${id}`)
      .then((r) => r.json())
      .then(({ replies }: { replies: { fromUserId: string; content: string; createdAt: string }[] }) => {
        if (replies.length === 0) return;
        const last = replies[replies.length - 1]!;
        const isSelf = last.fromUserId === currentBuyerId;
        const previewTd = row.querySelector('.msg-table__td--preview');
        if (previewTd) previewTd.innerHTML = `${escB(last.content)}${isSelf ? ` <span class="msg-table__preview-you">(${escB(I.msgYou)})</span>` : ''}`;
        const dateTd = row.querySelector('.msg-table__td--date');
        if (dateTd) dateTd.textContent = fmtDateBuyer(last.createdAt);
        row.dataset.sortDate = last.createdAt;
      }).catch(() => {});
  }

  // Live unread polling
  function pollBuyerUnread() {
    fetch('/api/messages?role=buyer&unread=1')
      .then((r) => r.json())
      .then(({ unreadIds }: { unreadIds: string[] }) => {
        const btn = document.querySelector<HTMLElement>('.my-nav-btn[data-tab="messages"]');
        const badge = btn?.querySelector<HTMLElement>('.my-nav-badge');
        if (unreadIds.length > 0) {
          if (!badge && btn) { const nb = document.createElement('span'); nb.className = 'my-nav-badge'; nb.textContent = String(unreadIds.length); btn.appendChild(nb); }
          else if (badge) badge.textContent = String(unreadIds.length);
        } else {
          badge?.remove();
        }
        document.querySelectorAll<HTMLElement>('[data-bmsg-id]').forEach((row) => {
          const id = row.dataset.bmsgId!;
          if (!unreadIds.includes(id)) return;
          if (row.classList.contains('msg-table__row--open')) {
            buyerThreadLoaders.get(id)?.(true, true);
          } else {
            row.classList.add('msg-table__row--unread');
            refreshRowPreview(id, row);
          }
        });
        applyBmsgFilter();
        // Deliberately does NOT mark the panel fresh, and that is load-bearing rather than an
        // omission. This poll updates rows that already exist; it cannot bring in a conversation
        // that has none. Stamping here would have it claim, every 15 seconds, that the panel is
        // current — and since the staleness window is 30s the panel would never be stale, so the
        // full refresh on tab open could never run and a new conversation would still be invisible.
        // The freshness stamp belongs only to whatever can actually make the panel current.
      }).catch(() => {});
  }
  setInterval(pollBuyerUnread, 15000);
</script>
