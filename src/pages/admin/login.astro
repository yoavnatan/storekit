---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CsrfField from '../../components/CsrfField.astro';
import { adminRole, checkAdminPassword, setAdminCookie } from '../../lib/admin-auth.js';
import { clientIp } from '../../lib/client-ip.js';
import {
  adminLoginRules, checkAuthRate, clearAuthRate, countAuthAttempt, retryAfterMinutes,
} from '../../lib/rate-limit.js';

// An OWNER is already signed in and has nothing to do here. A VIEWER is a different person with a
// different problem: the demonstration's tour door mints a viewer session for anybody who presses
// it, so the owner's own browser holds one the moment he takes the tour — and this page is the only
// way to stop being one. `isAdminRequest` cannot tell them apart, so it bounced the POST to /admin
// without ever reading the password: the login looked like it worked, the session stayed read-only,
// and every save afterwards answered "this is a demonstration". Measured, not reasoned about — a
// live sign-in with the correct password left the viewer cookie in place.
if (adminRole(Astro.cookies) === 'owner') {
  return Astro.redirect('/admin');
}

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  // The tightest limit on the platform: one shared secret, no second factor, and behind it every
  // seller's data and every number the platform holds (lib/rate-limit.ts).
  const rules = adminLoginRules(clientIp(Astro.request, Astro.clientAddress));
  const gate = await checkAuthRate(rules);
  if (!gate.allowed) {
    Astro.response.status = 429;
    error = `יותר מדי ניסיונות. נסה שוב בעוד ${retryAfterMinutes(gate.retryAfterSec)} דקות.`;
  } else if (checkAdminPassword(password)) {
    await clearAuthRate(rules);
    setAdminCookie(Astro.cookies);
    return Astro.redirect('/admin');
  } else {
    await countAuthAttempt(rules);
    error = 'סיסמה שגויה';
  }
}
---

<BaseLayout title="Admin Login" noindex={true} isLoggedIn={false} storeMode={true} sellerMode={true}>
  {/* A <div>, not a second <main> carrying id=main-content — BaseLayout already wraps this slot in
      one, so this nested a second <main> carrying the SAME id, and the skip link then
      resolves to whichever one comes first rather than to this page content. */}
  <div style="max-width:360px;margin:4rem auto;padding:0 1rem">
    <div style="background:var(--color-surface);border:1.5px solid var(--color-border);border-radius:var(--radius);padding:2rem">
      <h1 style="font-size:1.4rem;font-weight:700;margin:0 0 1.5rem;text-align:center;color:var(--color-text)">Admin Login</h1>
      <form method="POST">
        <CsrfField />
        <label style="display:block;margin-bottom:1rem">
          <span style="display:block;font-size:.875rem;font-weight:500;margin-bottom:.375rem;color:var(--color-text)">Password</span>
          {/* `.input` rather than the inline border it carried: an inline style beats every
              stylesheet, so the shared invalid-field line (forms.css) could never reach it. */}
          <input class="input" type="password" name="password" autofocus required
            style="font-size:.9375rem;box-sizing:border-box" />
        </label>
        {error && <p style="color:var(--color-danger);font-size:.875rem;margin:0 0 1rem">{error}</p>}
        <button type="submit" class="btn btn--accent" style="width:100%">Login</button>
      </form>
    </div>
  </div>
</BaseLayout>
