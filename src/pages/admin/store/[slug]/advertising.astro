---
export const prerender = false;
import '../../../../styles/pages/admin.css';
import AdminStoreStateBadge from '../../../../components/admin/AdminStoreStateBadge.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../../../lib/admin-auth.js';
import { getStoreBySlug, isStoreDiscoverable } from '../../../../lib/stores.js';
import { getSellerById } from '../../../../lib/seller-auth.js';
import { getProductsByStoreId, isProductVisible } from '../../../../lib/store-products.js';
import { storeBaselineStatus } from '../../../../lib/ad-baseline.js';
import { getCampaignsForStore } from '../../../../lib/ad-campaign-health.js';
import { campaignLifetimeStats, campaignRunPeriod } from '../../../../lib/ad-metrics.js';
import { campaignScopeName, campaignTargetingLabel, campaignHealthNote, campaignFeeOf } from '../../../../lib/ad-scope-label.js';
import { shortDate } from '../../../../lib/date-range.js';
import { roasTierChipHtml, ctrTierChipHtml } from '../../../../lib/ad-tier.js';
import { getCategoriesByStoreId, buildCategoryTree, categoryPath } from '../../../../lib/store-categories.js';
import { inferAudienceGender, inferAgeGroup } from '../../../../lib/audience-infer.js';
import { formatPrice } from '../../../../config/store.config.js';
import { boostFeePercent } from '../../../../lib/pricing.js';
import { getLang, getT } from '../../../../i18n/index.js';
import { jsonForScript } from '../../../../lib/json-script.js';
import { store as platformConfig } from '../../../../config/store.config.js';
import CampaignHistory from '../../../../components/dashboard/CampaignHistory.astro';
import BoostFormFields from '../../../../components/dashboard/BoostFormFields.astro';

if (!isAdminRequest(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const slug = Astro.params.slug ?? '';
// Context-aware back link: reachable from the Stores tab OR the platform
// Advertising tab's promoted-stores list (?from=advertising) — back returns to
// wherever they came from, not always to Stores.
const backFrom = Astro.url.searchParams.get('from');
const back = backFrom === 'advertising'
  ? { href: '/admin?panel=advertising', label: 'חזרה לפרסום' }
  : backFrom === 'performance'
    ? { href: '/admin?panel=performance', label: 'חזרה לביצועים' }
    : { href: '/admin?panel=stores', label: 'חזרה לחנויות' };
const store = await getStoreBySlug(slug);
// Unknown slug → back to the origin tab rather than a bare 404.
if (!store) {
  return Astro.redirect(back.href);
}
const seller = await getSellerById(store.sellerId);

const lang = getLang(Astro.cookies);
const t = getT(lang);
const d = t.dashboard;

// Admin twin of the seller's Advertising tab — same baseline card + boost form
// + campaign list, but every mutation posts to the admin-guarded twin endpoint
// (/api/admin/ad-campaigns) so the platform owner can launch/pause/retune any
// store's campaigns directly (CURRENT_TASK.md item 2). Product names come from
// Astro expressions (auto-escaped) here and escHtml() in the client re-render,
// so the cross-tenant view is XSS-safe without a set:html blob.
const adCampaigns = (await getCampaignsForStore(store.id)).map((c) => ({ ...c, stats: campaignLifetimeStats(c), runPeriod: campaignRunPeriod(c) }));
const adBaseline = storeBaselineStatus({
  storeId: store.id,
  discoverable: isStoreDiscoverable(store),
  visibleProductCount: (await getProductsByStoreId(store.id)).filter(isProductVisible).length,
});
// Same eligibility rule as the seller's own tab: a boost only makes sense for a product a
// shopper can actually reach and buy, so anything off the storefront (seller-hidden or
// admin-blocked) is out too — not just what's out of stock.
// Same predicate, same order, as the server that validates the pick
// (ad-campaign-input.ts#resolveScope) — the picker must not offer what the POST then refuses.
const adEligibleProducts = (await getProductsByStoreId(store.id)).filter((p) => isProductVisible(p) && p.stock > 0);
// Gender inferred from each product's category path / name / tags — pre-fills the
// campaign audience so it isn't re-entered (mirrors seller/dashboard.astro).
const adStoreCategoryList = await getCategoriesByStoreId(store.id);
const adCategoryTree = buildCategoryTree(adStoreCategoryList);
const adInferTexts = (p: typeof adEligibleProducts[number]) => [p.categoryId ? categoryPath(adStoreCategoryList, p.categoryId) : '', p.name, ...(p.tags ?? [])];
const adProductInferredGender = new Map(adEligibleProducts.map((p) => [p.id, inferAudienceGender(adInferTexts(p)) ?? ''] as const));
const adProductInferredAge = new Map(adEligibleProducts.map((p) => [p.id, inferAgeGroup(adInferTexts(p)) ?? ''] as const));
const adProductOptions = adEligibleProducts.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.price,
  inferGender: adProductInferredGender.get(p.id) ?? '',
  inferAge: adProductInferredAge.get(p.id) ?? '',
}));
// Same fee note the seller sees — the two forms are one component, so they say the same thing.
// One number, from the module that books it (pricing.ts) — a config override still wins.
const adBudgetFeeTipText = d.adBudgetFeeTipRate.replace('{pct}', String(boostFeePercent(platformConfig.ads?.boostCommissionPercent)));
// Run-period label — mirrors runPeriodLabel() in advertising.ts + the seller dashboard.
const adRunPeriodLabel = (c: { status: string; runPeriod?: { start: string; end: string } }): string => {
  if (!c.runPeriod) return '';
  return c.status === 'active' ? `${d.adRunSince} ${shortDate(c.runPeriod.start)}` : `${shortDate(c.runPeriod.start)}–${shortDate(c.runPeriod.end)}`;
};
// Budget label reflecting billing mode — mirrors budgetLabel() in advertising.ts.
const adBudgetLabelFor = (c: { durationDays?: number }): string => (c.durationDays ? d.adBudgetTotal : d.adBudgetMonthly);
---

<BaseLayout title={`פרסום · ${store.name}`} noindex={true} isLoggedIn={false} storeMode={true} sellerMode={true}>
  <main id="main-content" class="section container dash-section">
    <div id="dash-main-card" class="card">
      <div class="dash-head">
        <div class="dash-head__top">
          <div>
            <a href={back.href} class="admin-link text-[0.82rem] inline-flex items-center gap-1 mb-1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              {back.label}
            </a>
            <h1 class="text-[1.3rem] font-bold m-0 leading-[1.2] text-[color:var(--color-text)]">
              פרסום · {store.name}
              <AdminStoreStateBadge store={store} />
            </h1>
            <p class="muted text-[0.82rem] m-0 mt-1">{seller?.name ?? '—'} · {seller?.email ?? ''}</p>
          </div>
          <a href={`/${store.slug}`} target="_blank" rel="noopener" class="btn btn--ghost btn--sm">צפה בחנות</a>
        </div>
      </div>

      <div class="dash-panel">
        <div class="mb-4 pb-[0.6rem] border-b [border-color:var(--color-border)]">
          <h2 class="m-0 text-base font-semibold">{d.adTitle}</h2>
          <p class="muted text-[0.82rem] m-0 mt-1">ניהול הפרסום של חנות זו — הפעלה, השהיה ועדכון תקציב עבור המוכר/ת.</p>
        </div>

        <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4 mb-4 [background:color-mix(in_srgb,var(--color-success)_6%,transparent)]">
          <h3 class="m-0 mb-1 text-[0.9rem] font-semibold">{d.adBaselineTitle}</h3>
          <p class="muted text-[0.82rem] m-0 mb-2">{d.adBaselineLead}</p>
          <ul class="muted text-[0.82rem] m-0 mb-3 ps-[1.1rem] flex flex-col gap-1 list-disc marker:[color:var(--color-success)]">
            {d.adBaselinePoints.map((p) => <li>{p}</li>)}
          </ul>
          <p class="m-0 text-[0.85rem] flex items-center gap-1 flex-wrap">
            <span>{d.adBaselineImpressions}:</span>
            <strong id="ad-baseline-impressions">{adBaseline.impressions.toLocaleString('he-IL')}</strong>
            <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.adBaselineImpTip} aria-label={d.adBaselineImpTip}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
            </button>
          </p>
        </div>

        <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4 mb-4">
          <h3 class="m-0 mb-1 text-[0.9rem] font-semibold">{d.adBoostTitle}</h3>
          <p class="muted text-[0.82rem] m-0 mb-2">{d.adBoostDesc}</p>
          <p class="text-[0.8rem] m-0 mb-3 p-2 rounded-[var(--radius-sm)] [background:color-mix(in_srgb,var(--color-primary)_7%,transparent)] [color:var(--color-text)]">{d.adBoostWhySep}</p>

          <form id="ad-create-form" class="flex flex-col gap-3" data-store-slug={store.slug}>
            <BoostFormFields products={adProductOptions} hasCategories={adCategoryTree.length > 0} budgetTipText={adBudgetFeeTipText} d={d} />
            <p class="muted text-[0.78rem] m-0">{d.adBudgetHint}</p>
            <p class="muted text-[0.72rem] m-0">{d.adBudgetPlatformFeeNote}</p>
            <p class="muted text-[0.72rem] m-0">{d.adBillingTimingNote}</p>
            <div>
              <button type="submit" class="btn btn--sm btn--accent">{d.adCreateCampaign}</button>
            </div>
          </form>
        </div>

        <div>
          <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
            <h3 class="m-0 text-[0.9rem] font-semibold">{d.adYourCampaigns}</h3>
            <div id="ad-range-picker" data-store-slug={store.slug} data-active-preset="lifetime">
              <button
                type="button"
                id="ad-range-trigger"
                class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span id="ad-range-label">{d.adPresetLifetime}</span>
                <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          </div>
          <details class="mb-3 border [border-color:var(--color-border)] rounded-[var(--radius)] [background:var(--color-bg)]">
            <summary class="text-[0.82rem] font-medium px-3 py-2 cursor-pointer select-none [color:var(--color-muted)] hover:[color:var(--color-text)]">{d.adGlossaryTitle}</summary>
            <dl class="m-0 px-3 pb-3 pt-1 flex flex-col gap-2 text-[0.8rem]">
              {d.adGlossary.map((g) => (
                <div>
                  <dt class="font-semibold [color:var(--color-text)]">{g.t}</dt>
                  <dd class="m-0 muted">{g.d}</dd>
                </div>
              ))}
            </dl>
          </details>
          <div id="ad-campaigns-list" class="flex flex-col gap-3" data-store-slug={store.slug} data-endpoint="/api/admin/ad-campaigns" data-show-fee>
            {adCampaigns.length === 0 && <p class="muted text-[0.85rem] m-0" id="ad-empty-msg">{d.adNoCampaigns}</p>}
            {adCampaigns.map((c) => (
              <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3" data-campaign-id={c.id} data-status={c.status}>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between mb-2">
                  <div class="flex items-center gap-2 flex-wrap min-w-0">
                    <span class="text-[0.85rem] font-semibold">{campaignScopeName(c, d)}</span>
                    <span class="text-[0.72rem] font-medium [color:var(--color-muted)]">{c.platform === 'google' ? d.adPlatformGoogle : c.platform === 'meta' ? d.adPlatformMeta : d.adPlatformBoth}</span>
                    <span class={`text-[0.68rem] font-bold py-[.1rem] px-[.5rem] rounded-full ${c.status === 'active' ? '[color:var(--color-success)] [background:color-mix(in_srgb,var(--color-success)_14%,transparent)]' : '[color:var(--color-muted)] [background:color-mix(in_srgb,var(--color-muted)_14%,transparent)]'}`}>
                      {c.status === 'active' ? d.adStatusActive : d.adStatusPaused}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <button type="button" class="btn btn--ghost btn--sm" data-ad-action="edit-budget" data-campaign-id={c.id}>{d.adEditBudget}</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-ad-action="toggle" data-campaign-id={c.id}>{c.status === 'active' ? d.adPauseCampaign : d.adResumeCampaign}</button>
                    <button type="button" class="btn btn--ghost btn--sm !text-[color:var(--color-danger)]" data-ad-action="delete" data-campaign-id={c.id}>{d.adDeleteCampaign}</button>
                  </div>
                </div>
                <p class="text-[0.74rem] [color:var(--color-muted)] m-0 mb-2 flex items-center gap-1.5 flex-wrap">
                  <span>{campaignTargetingLabel(c, d)}</span>
                  {c.runPeriod && (
                    <Fragment>
                      <span aria-hidden="true">·</span>
                      <span class="inline-flex items-center gap-1">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        {adRunPeriodLabel(c)}
                      </span>
                    </Fragment>
                  )}
                </p>
                {campaignHealthNote(c.health, c.pausedReason, d) && (
                  <p class="text-[0.74rem] m-0 mb-2 py-1.5 px-2 rounded-[var(--radius-sm)] [color:var(--color-text)] [background:color-mix(in_srgb,var(--color-danger)_9%,transparent)]">
                    {campaignHealthNote(c.health, c.pausedReason, d)}
                  </p>
                )}
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-[0.82rem]">
                  <div data-budget-cell data-budget={c.monthlyBudget}><span class="[color:var(--color-muted)]">{adBudgetLabelFor(c)}</span><br /><strong>{formatPrice(c.monthlyBudget)}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adImpressions}</span><br /><strong>{c.stats.impressions.toLocaleString('he-IL')}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adClicks}</span><br /><strong>{c.stats.clicks.toLocaleString('he-IL')}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adCtr}</span><br /><strong>{c.stats.ctr}%</strong><Fragment set:html={ctrTierChipHtml(c.stats.ctr, { low: d.adTierLow, mid: d.adTierMid, high: d.adTierHigh })} /></div>
                  <div><span class="[color:var(--color-muted)]">{d.adSpend}</span><br /><strong>{formatPrice(c.stats.spend)}</strong>{campaignFeeOf(c.stats) && <Fragment><br /><span class="[color:var(--color-muted)] text-[0.7rem]">{d.adSpendFeeNote.replace('{fee}', formatPrice(campaignFeeOf(c.stats)!))}</span></Fragment>}</div>
                  <div><span class="[color:var(--color-muted)]">{d.adCpc}</span><br /><strong>{formatPrice(c.stats.cpc)}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adConversions}</span><br /><strong>{c.stats.conversions.toLocaleString('he-IL')}</strong></div>
                  <div><span class="[color:var(--color-muted)]">{d.adRoas}</span><br /><strong>x{c.stats.roas}</strong><Fragment set:html={roasTierChipHtml(c.stats.roas, { low: d.adTierLow, mid: d.adTierMid, high: d.adTierHigh })} /></div>
                </div>
              </div>
            ))}
          </div>
          <CampaignHistory d={d} />
          <p class="muted text-[0.76rem] mt-3">{d.adDemoDataNote}</p>
        </div>
      </div>
    </div>
  </main>
  {/* The boost form's category picker reads its tree from here (scripts/dashboard/category-tree-cache.ts
      looks this id up by hand) — the seller dashboard renders the same payload from its Categories tab. */}
  <script type="application/json" id="category-tree-data" set:html={jsonForScript(adCategoryTree)} />
</BaseLayout>

<script>
  import { initAdvertisingTab } from '../../../../scripts/dashboard/advertising.js';
  import { initCategoryPicker } from '../../../../scripts/dashboard/category-picker.js';
  initAdvertisingTab();
  // One instance here (the boost scope picker); the seller dashboard binds its own the same way.
  document.querySelectorAll<HTMLElement>('.category-picker').forEach(initCategoryPicker);
</script>
