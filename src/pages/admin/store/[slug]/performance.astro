---
export const prerender = false;
import '../../../../styles/pages/admin.css';
import AdminStoreStateBadge from '../../../../components/admin/AdminStoreStateBadge.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PerfProductSection from '../../../../components/dashboard/PerfProductSection.astro';
import TopProductsList from '../../../../components/dashboard/TopProductsList.astro';
import { isAdminRequest } from '../../../../lib/admin-auth.js';
import { getStoreBySlug } from '../../../../lib/stores.js';
import { getSellerById } from '../../../../lib/seller-auth.js';
import { getProductsByStoreId } from '../../../../lib/store-products.js';
import { getOrdersByStoreSlugInRange } from '../../../../lib/orders.js';
import { buildPerformanceSummary, pickGranularity } from '../../../../lib/seller-performance.js';
import { getViewStatsForStore } from '../../../../lib/store-pageviews.js';
import { VISITOR_RETENTION_DAYS } from '../../../../lib/visitor-retention.js';
import { buildBarChartSvg, buildMultiLineChartSvg } from '../../../../lib/chart-svg.js';
import { formatAgorot } from '../../../../lib/money.js';
import { getLang, getDir, getT } from '../../../../i18n/index.js';
import { commissionPercentForTier } from '../../../../lib/pricing.js';
import { jsonForScript } from '../../../../lib/json-script.js';

if (!isAdminRequest(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const slug = Astro.params.slug ?? '';
// Context-aware back link: the admin can reach this page from the Stores tab OR
// the platform Performance tab's per-store breakdown (?from=performance) — back
// must return to wherever they came from, not always to Stores.
const backFrom = Astro.url.searchParams.get('from');
const back = backFrom === 'performance'
  ? { href: '/admin?panel=performance', label: 'חזרה לביצועים' }
  : backFrom === 'advertising'
    ? { href: '/admin?panel=advertising', label: 'חזרה לפרסום' }
    : { href: '/admin?panel=stores', label: 'חזרה לחנויות' };
const store = await getStoreBySlug(slug);
// Unknown slug → back to the origin tab rather than a bare 404.
if (!store) {
  return Astro.redirect(back.href);
}
const seller = await getSellerById(store.sellerId);

const lang = getLang(Astro.cookies);
const dir = getDir(lang);
const t = getT(lang);
const d = t.dashboard;

// SSR the default "this month" range so the charts never flash blank before JS
// runs — identical setup to the seller dashboard's performance tab so the two
// stay visually in lockstep (see src/pages/seller/dashboard.astro). Range
// changes re-fetch from /api/admin/performance (admin-guarded) client-side.
const today = new Date();
const toLocalISO = (dt: Date) => `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}`;
const fromISO = toLocalISO(new Date(today.getFullYear(), today.getMonth(), 1));
const toISO = toLocalISO(today);
const granularity = pickGranularity(fromISO, toISO);
// The range is decided BEFORE the orders are read, which is the whole point: this page renders one
// month and used to load the store's entire history to do it (owner, 2026-08-11). Three
// independent reads, so one round trip rather than three (AI_INSTRUCTIONS → Scalability).
const [storeOrders, storeProductsList, views] = await Promise.all([
  getOrdersByStoreSlugInRange(store.slug, fromISO, toISO),
  getProductsByStoreId(store.id),
  getViewStatsForStore(store.id, fromISO, toISO, granularity),
]);
const summary = buildPerformanceSummary(storeOrders, views, store.slug, fromISO, toISO, granularity, commissionPercentForTier(seller?.tier));

// This blob is injected via set:html into a <script type="application/json">.
// Unlike the seller's own dashboard (where the product names are the viewer's
// own — self-XSS at worst), here the ADMIN views ANOTHER seller's data, so a
// product named `</script>…` would break out and run in the admin's session.
// Escaping `<` to its JSON unicode escape keeps the JSON valid (JSON.parse
// decodes it back) while making a </script> breakout impossible.
const summaryJson = jsonForScript(summary);

const isRtl = dir === 'rtl';
// animate:false — performance.ts repaints these at the measured container width and its
// first paint owns the entrance animation (see dashboard.astro for the full reasoning).
const chartOpts = { emptyMessage: d.perfNoData, rtl: isRtl, animate: false };
const revenueChartSvg = buildBarChartSvg(
  summary.points.map((p) => ({ label: p.label, value: p.revenueAgorot, key: p.key })),
  { ...chartOpts, color: 'var(--color-primary)', valueFormatter: formatAgorot },
);
const visitorsChartSvg = buildMultiLineChartSvg(
  [
    { points: summary.points.map((p) => ({ label: p.label, value: p.uniqueVisitors })), color: 'var(--color-accent)', fill: true, label: d.perfUniqueVisitors },
    { points: summary.points.map((p) => ({ label: p.label, value: p.views })), color: 'var(--color-muted)', dashed: true, label: d.perfVisitors },
  ],
  { ...chartOpts, valueFormatter: (v) => String(v) },
);
---

<BaseLayout title={`ביצועים · ${store.name}`} noindex={true} isLoggedIn={false} storeMode={true} sellerMode={true}>
  {/* A <div>, not a second <main> carrying id=main-content — BaseLayout already wraps this slot in
      one, so this nested a second <main> carrying the SAME id, and the skip link then
      resolves to whichever one comes first rather than to this page content. */}
  <div class="section container dash-section">
    <div id="dash-main-card" class="card">
      <div class="dash-head">
        <div class="dash-head__top">
          <div>
            <a href={back.href} class="admin-link text-[0.82rem] inline-flex items-center gap-1 mb-1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              {back.label}
            </a>
            <h1 class="text-[1.3rem] font-bold m-0 leading-[1.2] text-[color:var(--color-text)]">
              ביצועים · {store.name}
              <AdminStoreStateBadge store={store} />
            </h1>
            <p class="muted text-[0.82rem] m-0 mt-1">{seller?.name ?? '—'} · {seller?.email ?? ''}</p>
          </div>
          <a href={`/${store.slug}`} target="_blank" rel="noopener" class="btn btn--ghost btn--sm">צפה בחנות</a>
        </div>
      </div>

      <div class="dash-panel">
        <div class="dash-panel-head mb-5 py-[0.6rem] border-b [border-color:var(--color-border)] flex items-center justify-between gap-3 flex-wrap">
          <div>
            <h2 class="m-0 text-base font-semibold">{d.perfTitle}</h2>
            <p class="muted text-[0.82rem] m-0 mt-1">{d.perfSubtitle}</p>
          </div>
          <div id="perf-range-picker" data-store-slug={store.slug} data-endpoint="/api/admin/performance" data-active-preset="thisMonth">
          <button
            type="button"
            id="perf-range-trigger"
            class="table-toolbar-btn group inline-flex items-center gap-[.4rem] font-[inherit] text-[.82rem] [color:var(--color-text)] bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-full py-[.35rem] px-[.85rem] cursor-pointer transition-colors duration-[120ms] hover:border-[color:var(--color-primary)] hover:[color:var(--color-primary)] aria-expanded:border-[color:var(--color-primary)] aria-expanded:[color:var(--color-primary)]"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span id="perf-range-label">{d.perfPresetThisMonth}</span>
            <svg class="table-toolbar-btn__chevron shrink-0 transition-transform duration-150 ease-out group-aria-expanded:rotate-180" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <input type="hidden" id="perf-from-input" value={fromISO} />
          <input type="hidden" id="perf-to-input" value={toISO} />
          </div>
        </div>

        <dl id="perf-kpis" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-5" aria-live="polite">
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
            <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfRevenue}</dt>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-revenue">{formatAgorot(summary.totalRevenueAgorot)}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
            <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfOrders}</dt>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-orders">{summary.totalOrders}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
            <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium mb-1">{d.perfAvgOrder}</dt>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-avg">{formatAgorot(summary.avgOrderValueAgorot)}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
            <div class="flex items-center gap-1 mb-1">
              <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfVisitors}</dt>
              <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfVisitsHint} aria-label={d.perfVisitsHint}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
              </button>
            </div>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-visitors">{summary.totalViews}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
            <div class="flex items-center gap-1 mb-1">
              <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfUniqueVisitors}</dt>
              <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfUniqueVisitorsHint} aria-label={d.perfUniqueVisitorsHint}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
              </button>
            </div>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-unique">{summary.totalUniqueVisitors}</dd>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-3">
            <div class="flex items-center gap-1 mb-1">
              <dt class="text-[0.76rem] [color:var(--color-muted)] font-medium">{d.perfConversion}</dt>
              <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfConversionHint} aria-label={d.perfConversionHint}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
              </button>
            </div>
            <dd class="m-0 text-[1.1rem] font-bold" id="perf-kpi-conversion">{summary.conversionRate.toFixed(1)}%</dd>
          </div>
        </dl>

        {/* Same note as the platform tab, and it has to be on both: this page shows the identical
            KPI row for ONE store, so an old range reads "0 unique" here exactly as it does there.
            A note that appears on only one of two admin screens explaining the same zero is the
            half-measure that teaches you to distrust the note. The seller's own dashboard is
            deliberately excluded — see AdminPerformancePanel.astro. */}
        <p class="mt-2 mb-0 text-[0.72rem] [color:var(--color-muted)]">
          {d.perfRetentionNote.replace('{days}', String(VISITOR_RETENTION_DAYS))}
        </p>

        {/* Profitability "receipt": gross revenue less platform commission =
            net to the seller. Reporting only; the real deduction happens at the
            split-payment processor. Same figures the seller sees in their own tab. */}
        <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4 mb-5 [background:color-mix(in_srgb,var(--color-success)_4%,transparent)]">
          <div class="flex items-center gap-1 mb-3">
            <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfProfitTitle}</h3>
            <button type="button" class="inline-flex items-center justify-center w-[14px] h-[14px] rounded-full [color:var(--color-muted)] hover:[color:var(--color-primary)] transition-colors duration-100 cursor-help bg-transparent border-0 p-0" data-tooltip={d.perfProfitHint} aria-label={d.perfProfitHint}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><line x1="12" y1="11" x2="12" y2="16.5"/><circle cx="12" cy="7.7" r="0.6" fill="currentColor" stroke="none"/></svg>
            </button>
          </div>
          <dl class="m-0 flex flex-col gap-2 text-[0.86rem]">
            <div class="flex items-center justify-between gap-3">
              <dt class="[color:var(--color-muted)]">{d.perfGrossRevenue}</dt>
              <dd class="m-0 font-medium" id="perf-gross">{formatAgorot(summary.totalRevenueAgorot)}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="[color:var(--color-muted)]">{d.perfCommission} <span class="text-[0.78rem]">(<span id="perf-commission-rate">{summary.commissionRate}</span>%)</span></dt>
              <dd class="m-0 font-medium [color:var(--color-danger)]" id="perf-commission">−{formatAgorot(summary.platformCommissionAgorot)}</dd>
            </div>
            <div class="flex items-center justify-between gap-3 pt-2 border-t [border-color:var(--color-border)]">
              <dt class="font-semibold">{d.perfNetProfit}</dt>
              <dd class="m-0 font-bold text-[1.02rem] [color:var(--color-success)]" id="perf-net">{formatAgorot(summary.netProfitAgorot)}</dd>
            </div>
          </dl>
        </div>

        <script type="application/json" id="perf-initial-summary" set:html={summaryJson} />
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5" data-perf-rtl={isRtl ? '1' : '0'}>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4">
            <h3 class="m-0 mb-3 text-[0.9rem] font-semibold">{d.perfRevenueChartTitle}</h3>
            <div id="perf-revenue-chart" set:html={revenueChartSvg}></div>
          </div>
          <div class="border [border-color:var(--color-border)] rounded-[var(--radius)] p-4">
            <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
              <h3 class="m-0 text-[0.9rem] font-semibold">{d.perfVisitorsChartTitle}</h3>
              <div class="flex items-center gap-3 text-[0.72rem] [color:var(--color-muted)]">
                <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-[3px] rounded-full [background:var(--color-accent)]"></span>{d.perfUniqueVisitors}</span>
                <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-0 border-t-2 border-dashed [border-color:var(--color-muted)]"></span>{d.perfVisitors}</span>
              </div>
            </div>
            <div id="perf-visitors-chart" set:html={visitorsChartSvg}></div>
          </div>
        </div>

        <div>
          <h3 class="m-0 mb-3 text-[0.9rem] font-semibold">{d.perfTopProducts}</h3>
          <div id="perf-top-products" class="flex flex-col gap-2">
            <TopProductsList products={summary.topProducts} totalAgorot={summary.productRevenueAgorot} d={d as unknown as Record<string, string>} />
          </div>
        </div>

        <PerfProductSection products={storeProductsList} />
      </div>
    </div>
  </div>

  {/* Revenue-breakdown modal — opened by clicking a revenue bar (performance.ts).
      Shows a donut of which products made up that period's revenue. Injected client-side. */}
  <dialog id="perf-breakdown-modal" aria-labelledby="pbm-title" style="border:none;border-radius:var(--radius-lg);padding:0;width:min(440px,96vw);box-shadow:var(--shadow-overlay);background:var(--color-surface);margin:auto">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--color-border)">
      <div>
        <h2 id="pbm-title" style="font-size:0.95rem;font-weight:641;margin:0">{d.perfBreakdownTitle}</h2>
        <p id="pbm-subtitle" class="muted" style="font-size:0.78rem;margin:0.15rem 0 0"></p>
      </div>
      <button id="perf-breakdown-close" type="button" aria-label={d.perfBreakdownClose} style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius-sm);border:none;background:none;color:var(--color-muted);cursor:pointer;flex-shrink:0">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="perf-breakdown-body" tabindex="-1" autofocus style="padding:1.25rem;min-height:19rem;display:flex;flex-direction:column;justify-content:center;outline:none"></div>
  </dialog>
</BaseLayout>

<script>
  import { initPerformanceTab } from '../../../../scripts/dashboard/performance.js';
  initPerformanceTab();
</script>
