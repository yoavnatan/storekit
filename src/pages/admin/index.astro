---
/** Admin dashboard — protected. Shows current store config + product list. */
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAuthenticated } from '../../lib/auth.js';
import { store } from '../../config/store.config.js';
import { getAllProducts } from '../../data/products.js';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const products = getAllProducts();
---

<BaseLayout title="Admin" noindex={true}>
  <section class="section container">
    <div class="flex between">
      <h1>Admin dashboard</h1>
      <form method="POST" action="/admin/logout">
        <button class="btn btn--ghost">Log out</button>
      </form>
    </div>

    <div class="admin-grid">
      <div class="card" style="padding:1.25rem">
        <h2>Store settings</h2>
        <p class="muted">Edit in <code>src/config/store.config.js</code></p>
        <ul>
          <li>Name: {store.name}</li>
          <li>URL: {store.url}</li>
          <li>Currency: {store.business.currency}</li>
          <li>Payment provider: {store.checkout.provider}</li>
        </ul>
      </div>

      <div class="card" style="padding:1.25rem">
        <h2>Products ({products.length})</h2>
        <p class="muted">Edit in <code>src/data/products.js</code></p>
        <table class="admin-table">
          <thead><tr><th>Product</th><th>Price</th><th>Stock</th></tr></thead>
          <tbody>
            {products.map((p) => (
              <tr>
                <td><a href={`/products/${p.slug}`}>{p.name}</a></td>
                <td>{store.business.currencySymbol}{p.price}</td>
                <td>{p.stock}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .admin-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 1.5rem; margin-top: 1.5rem; }
  .admin-table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; }
  .admin-table th, .admin-table td { text-align: start; padding: 0.5rem; border-bottom: 1px solid var(--color-border); }
  code { background: var(--color-surface); padding: 0.1rem 0.35rem; border-radius: 5px; }
  @media (max-width: 760px) { .admin-grid { grid-template-columns: 1fr; } }
</style>
