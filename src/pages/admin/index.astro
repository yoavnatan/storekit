---
export const prerender = false;
import '../../styles/pages/admin.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashTabsBoot from '../../components/dashboard/DashTabsBoot.astro';
import { isAdminRequest } from '../../lib/admin-auth.js';
import { getPlatformOverview, getSellerCards, getStoresNeedingAttention, getProductsByStoreMap, getStoreRows, getStoreRevenueMap, filterAndSortSellerCards, filterAndSortStoreRows, parseSellerQuery, parseStoreQuery, countStoreStates } from '../../lib/admin-stats.js';
import { getAllSellers } from '../../lib/seller-auth.js';
import { getAllStores, isStoreDiscoverable } from '../../lib/stores.js';
import { countOpenOrdersByStore } from '../../lib/store-lifecycle.js';
import { getAllOrders } from '../../lib/orders.js';
import { filterAndSortOrders, getOrderStoreNames, parseOrderQuery } from '../../lib/admin-orders-filter.js';
import { getAllAdminThreads } from '../../lib/admin-messages.js';
import { filterAndSortAdminThreads, parseAdminThreadQuery } from '../../lib/admin-threads-query.js';
import { getRecentErrors, filterAndSortErrors, getErrorStoreNames } from '../../lib/error-log.js';
import { buildPlatformAdOverview } from '../../lib/admin-ads.js';
import { getPlatformAdSettings } from '../../lib/platform-ads.js';
import { getAllCampaigns } from '../../lib/ad-campaigns.js';
import { getAllBrandCampaigns } from '../../lib/brand-campaigns.js';
import { presetRange, coerceRange, previousPeriod, AD_RANGE_PRESETS, type AdRangePreset } from '../../lib/date-range.js';
import { businessTodayISO, businessMonthStartISO } from '../../lib/business-day.js';
import { store as platform } from '../../config/store.config.js';
import { paginate, parsePage } from '../../lib/pagination.js';
import { buildAdminUrl, encodeList, decodeList } from '../../lib/admin-nav.js';
import { getLastViewedAt, countSince, type TrackedAdminTab } from '../../lib/admin-tab-views.js';
import { buildPlatformPerformance, buildPlatformStoreInputs, parseStoreRowsQuery, selectStoreRows } from '../../lib/platform-performance.js';
import { buildPlatformRevenue } from '../../lib/platform-revenue.js';
import { pickGranularity } from '../../lib/seller-performance.js';
import { getLang, getDir } from '../../i18n/index.js';
import AdminOverviewPanel from '../../components/admin/AdminOverviewPanel.astro';
import AdminSellersPanel from '../../components/admin/AdminSellersPanel.astro';
import AdminStoresPanel from '../../components/admin/AdminStoresPanel.astro';
import AdminOrdersPanel from '../../components/admin/AdminOrdersPanel.astro';
import AdminAttentionPanel from '../../components/admin/AdminAttentionPanel.astro';
import AdminMessagesPanel from '../../components/admin/AdminMessagesPanel.astro';
import AdminAlertsPanel from '../../components/admin/AdminAlertsPanel.astro';
import AdminAdvertisingPanel from '../../components/admin/AdminAdvertisingPanel.astro';
import AdminPerformancePanel from '../../components/admin/AdminPerformancePanel.astro';
import AdminDataPanel from '../../components/admin/AdminDataPanel.astro';
import AdminMoneyLogPanel from '../../components/admin/AdminMoneyLogPanel.astro';
import { getMoneyEvents } from '../../lib/money-events.js';
import { parseMoneyLogQuery, filterMoneyEvents, eventPage } from '../../lib/admin-moneylog-filter.js';
import { reconcileOrders } from '../../lib/reconcile.js';
import { getAnalyticsOverview } from '../../lib/analytics.js';
import { getSellerFunnel } from '../../lib/seller-funnel.js';

if (!isAdminRequest(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const tabs = [
  { id: 'overview', label: 'סקירה כללית' },
  { id: 'data', label: 'נתונים' },
  { id: 'sellers', label: 'מוכרים' },
  { id: 'stores', label: 'חנויות' },
  { id: 'orders', label: 'הזמנות' },
  { id: 'attention', label: 'לתשומת לב' },
  { id: 'performance', label: 'ביצועים' },
  { id: 'advertising', label: 'פרסום' },
  { id: 'messages', label: 'הודעות' },
  { id: 'alerts', label: 'התראות ושגיאות' },
  { id: 'moneylog', label: 'יומן כספי' },
] as const;

const requestedPanel = Astro.url.searchParams.get('panel');
const initialPanel = tabs.some((t) => t.id === requestedPanel) ? requestedPanel! : 'overview';

const sp = Astro.url.searchParams;

// Every list tab paginates the same way (15/page, arrows) — see
// AI_INSTRUCTIONS.md → admin dashboard pagination. Each tab's query params
// are namespaced (sq/spage, stq/stpage, o*, apage, mpage, alpage) since
// they all coexist in the same URL. tabUrl() is buildAdminUrl() (shared with
// the client-side tab scripts, see src/lib/admin-nav.ts) bound to this
// request's `/admin` base.
const tabUrl = buildAdminUrl;

// Each source file is read exactly once per request and threaded through —
// admin-stats.ts's functions used to each independently re-read sellers/
// stores/products, multiplying JSON-file reads on every dashboard load.
const sellers = await getAllSellers();
const stores = await getAllStores();
const allOrders = await getAllOrders();
const productsByStore = await getProductsByStoreMap();

const overview = getPlatformOverview(sellers, stores, allOrders);
const revenueByStore = getStoreRevenueMap(allOrders);

// Cross-check every money headline against a second, independent computation over
// the real orders (lib/reconcile.ts). Read-only and cheap, so it runs on each render
// rather than behind a button — a reconciliation nobody clicks is a reconciliation
// that never catches anything.
const reconciliation = reconcileOrders(allOrders, stores.map((s) => s.slug));

// ── "new since you last left this tab" (owner feedback 2026-07-28) ──
// One boundary per tracked tab, read ONCE here and threaded into that tab's
// panel, so three things always tell the same story: the tab's "(N)" badge,
// the "חדש" chip on each row, and the "חדשים בלבד" filter. The boundary is
// deliberately NOT advanced by rendering this page — that used to happen, so
// the badge said "3 new" while every row inside looked identical, and any
// in-panel AJAX refresh (search/sort/pager, see admin-nav.ts#swapPanel)
// silently re-fetched this same route and wiped the marks mid-session.
// It now advances only when the admin actually leaves the tab
// (POST /api/admin/tab-view from tab-nav.ts).
const TRACKED_TABS: TrackedAdminTab[] = ['sellers', 'stores', 'orders', 'alerts'];
const newSince = Object.fromEntries(TRACKED_TABS.map((t) => [t, getLastViewedAt(t)])) as Record<TrackedAdminTab, string>;
const newOnly: Record<TrackedAdminTab, boolean> = {
  sellers: sp.get('snew') === '1',
  stores: sp.get('stnew') === '1',
  orders: sp.get('onew') === '1',
  alerts: sp.get('alnew') === '1',
};
// Applied AFTER each tab's own filter+sort so it composes with them instead of
// replacing them (search "דני" + חדשים בלבד = new sellers named דני).
function keepNewOnly<T>(items: T[], on: boolean, boundary: string, createdAt: (item: T) => string): T[] {
  return on ? items.filter((item) => createdAt(item) > boundary) : items;
}

// ── Sellers tab ──
const sellerQuery = parseSellerQuery(sp);
const sellerCardsAll = getSellerCards(sellers, stores, productsByStore, revenueByStore);
const sellerCardsFiltered = keepNewOnly(filterAndSortSellerCards(sellerCardsAll, sellerQuery), newOnly.sellers, newSince.sellers, (c) => c.seller.createdAt);
const sellerPageResult = paginate(sellerCardsFiltered, parsePage(sp, 'spage'));

// ── Stores tab ──
const storeQuery = parseStoreQuery(sp);
// Open-order counts come off the orders already read above, not one file read per store — the
// only place they are shown is a store waiting to close, but the count has to exist before the
// rows are filtered so the chips can be built from the same list.
const storeRowsAll = getStoreRows(stores, sellers, productsByStore, revenueByStore, countOpenOrdersByStore(allOrders));
const storeStateCounts = countStoreStates(storeRowsAll);
const storeRowsFiltered = keepNewOnly(filterAndSortStoreRows(storeRowsAll, storeQuery), newOnly.stores, newSince.stores, (r) => r.store.createdAt);
const storePageResult = paginate(storeRowsFiltered, parsePage(sp, 'stpage'));

// ── Orders tab ──
const { q: oq, sortCol: oSortCol, sortDir: oSortDir, shippingStatus: oShip, paymentStatus: oPay, store: oStore } = parseOrderQuery(sp);
const ordersFiltered = keepNewOnly(
  filterAndSortOrders(allOrders, { q: oq, sortCol: oSortCol, sortDir: oSortDir, shippingStatus: oShip, paymentStatus: oPay, store: oStore }),
  newOnly.orders, newSince.orders, (o) => o.createdAt,
);
const orderPageResult = paginate(ordersFiltered, parsePage(sp, 'opage'));
const orderStoreNames = getOrderStoreNames(allOrders);

// ── Attention tab (no filters — pagination only, see CURRENT_TASK.md → סשן ב׳: already a filtered subset) ──
const attentionAll = getStoresNeedingAttention(stores, sellers, productsByStore);
const attentionPageResult = paginate(attentionAll, parsePage(sp, 'apage'));

// ── Advertising tab (platform-level, CURRENT_TASK.md → סשן ב׳) ──
// Feed = the exact set the product feed exports: stores a platform surface may carry, holding at
// least one visible product. Gated on isStoreDiscoverable rather than `!blocked` — the feed
// itself runs off getIndexableStores, which also drops a store its seller paused or closed, and
// an inline `!blocked` copy here would have gone on counting those and over-reported what the
// platform is actually advertising. Reuses the already-fetched stores/productsByStore so this
// tab adds no extra JSON reads.
const feedStores = stores.filter((s) => isStoreDiscoverable(s) && (productsByStore.get(s.id) ?? []).some((p) => !p.blocked));
const feedProductCount = feedStores.reduce((sum, s) => sum + (productsByStore.get(s.id) ?? []).filter((p) => !p.blocked).length, 0);
const brandCampaigns = getAllBrandCampaigns();
const adCampaigns = getAllCampaigns();

// Date range for all ad metrics (default: last 7 days — the Google/Meta
// convention). `adpreset` drives it; `custom` reads adfrom/adto. Everything is
// recomputed over the range, plus the equal-length previous period for a
// period-over-period comparison on the headline totals.
const adPresetRaw = sp.get('adpreset') as AdRangePreset | null;
const adPreset: AdRangePreset = AD_RANGE_PRESETS.includes(adPresetRaw as AdRangePreset) ? adPresetRaw! : '7d';
const adRange = adPreset === 'custom' ? coerceRange(sp.get('adfrom'), sp.get('adto')) : presetRange(adPreset)!;
const adPrevRange = previousPeriod(adRange.from, adRange.to);

const adInputBase = { feedStores, feedProductCount, allStores: stores, campaigns: adCampaigns, brandCampaigns, ads: platform.ads, settings: getPlatformAdSettings() };
const adOverview = buildPlatformAdOverview({ ...adInputBase, range: adRange });
const adPrevOverview = buildPlatformAdOverview({ ...adInputBase, range: adPrevRange });
const pctChange = (cur: number, prev: number): number | null => (prev > 0 ? Math.round(((cur - prev) / prev) * 100) : null);
const adCompare = {
  impressions: pctChange(adOverview.exposure.totalImpressions, adPrevOverview.exposure.totalImpressions),
  clicks: pctChange(adOverview.exposure.totalClicks, adPrevOverview.exposure.totalClicks),
  spend: pctChange(adOverview.exposure.totalSpend, adPrevOverview.exposure.totalSpend),
};

// ── Messages tab ──
const messageThreadsAll = await getAllAdminThreads();
const unreadMessagesForAdmin = messageThreadsAll.reduce((sum, t) => sum + t.unreadForAdmin, 0);
const threadQuery = parseAdminThreadQuery(sp);
const messageThreadsFiltered = filterAndSortAdminThreads(messageThreadsAll, threadQuery);
const messagePageResult = paginate(messageThreadsFiltered, parsePage(sp, 'mpage'));

// ── Alerts tab ──
const errorsAll = getRecentErrors(500); // MAX_ENTRIES cap in error-log.ts is already 500, so this is "all"
const alSortDir = sp.get('alsort') === 'asc' ? 'asc' : 'desc';
const alSource = (sp.get('alsource') ?? '').split(',').filter(Boolean);
const alStore = decodeList(sp.get('alstore') ?? '');
const errorsFiltered = keepNewOnly(
  filterAndSortErrors(errorsAll, { sortDir: alSortDir, source: alSource, storeSlug: alStore }),
  newOnly.alerts, newSince.alerts, (e) => e.createdAt,
);
const alertsPageResult = paginate(errorsFiltered, parsePage(sp, 'alpage'));
const errorStoreOptions = getErrorStoreNames(errorsAll);

// ── Performance tab (platform-wide, aggregates every store) ──
// SSR the default "this month" range so the charts never flash blank; range
// changes re-fetch from /api/admin/platform-performance client-side. Reuses the
// already-read `allOrders`/`stores` (no extra JSON reads) and the single-sourced
// per-store math (buildPlatformPerformance → buildPerformanceSummary).
const perfLang = getLang(Astro.cookies);
const perfDir = getDir(perfLang);
// Business calendar (business-day.ts) — the same one the per-store summaries bucket
// orders by. date-range.ts's toISODate reads the RUNTIME's local calendar, which is
// UTC on a production server and so quietly reintroduced the off-by-one-day this
// range is supposed to avoid.
const perfToISO = businessTodayISO();
const perfFromISO = businessMonthStartISO(perfToISO);
const perfGranularity = pickGranularity(perfFromISO, perfToISO);
const platformPerf = buildPlatformPerformance(
  allOrders,
  buildPlatformStoreInputs(stores, sellers),
  perfFromISO,
  perfToISO,
  perfGranularity,
);
// First page of the searchable breakdown table. Search/sort/paging all re-fetch
// the endpoint client-side afterwards (platform-performance.ts) — the URL params
// are still honoured here so a deep-linked ?storeQ= renders server-side too.
const perfStorePage = selectStoreRows(platformPerf.stores, parseStoreRowsQuery(sp));
// Where the platform's income actually comes from — commission is only one of three.
const perfRevenue = buildPlatformRevenue(
  platformPerf.summary.platformCommissionAgorot,
  platformPerf.summary.commissionRate,
  sellers,
  adCampaigns,
  perfFromISO,
  perfToISO,
);

// ── Data tab (first-party analytics — CURRENT_TASK.md item 2) ──
// The buyer-funnel window recomputes per ?datapreset via the panel-swap AJAX
// (data-panel.ts); the seller onboarding funnel is a lifetime snapshot. Reuses
// the already-read productsByStore for the top-product names (no extra reads).
const DATA_PRESETS: AdRangePreset[] = ['today', '7d', '30d', 'thisMonth'];
const dataPresetRaw = sp.get('datapreset') as AdRangePreset | null;
const dataPreset: AdRangePreset = DATA_PRESETS.includes(dataPresetRaw as AdRangePreset) ? dataPresetRaw! : '30d';
const dataRange = presetRange(dataPreset)!;
const analyticsOverview = getAnalyticsOverview(dataRange.from, dataRange.to);
const sellerFunnel = await getSellerFunnel();
const productNames = new Map<string, string>();
for (const list of productsByStore.values()) for (const p of list) productNames.set(p.id, p.name);

// ── Money journal tab ──
// Type narrowing happens inside getMoneyEvents so it covers the WHOLE journal before
// any slicing (money-events.ts's header says why); search/date-window/permalink are a
// filter over its result (admin-moneylog-filter.ts's header says why). Paginates
// 15/page like every other list tab. The one rule that lives HERE because it is about
// this page's URL: a `?mev=` permalink picks the page holding that row, but an explicit
// ?mlpage always wins — otherwise the next arrow click snaps back to the linked row.
const moneyLogQuery = parseMoneyLogQuery(sp);
// Type AND date window are pushed into the query (money-events.ts) — the journal is the one
// table nothing is deleted from, so opening this tab must not mean reading every row ever
// appended. The free-text pass stays in memory: it matches the Hebrew LABEL of an event type,
// and the labels live in the code, not the database.
const moneyLogEvents = filterMoneyEvents(
  await getMoneyEvents(moneyLogQuery.type, moneyLogQuery.from, moneyLogQuery.to),
  moneyLogQuery,
);
const moneyLogTargetPage = eventPage(moneyLogEvents, moneyLogQuery.eventId);
const moneyLogPageResult = paginate(
  moneyLogEvents,
  sp.get('mlpage') ? parsePage(sp, 'mlpage') : (moneyLogTargetPage ?? 1),
);
// Linked row that this filter/journal doesn't contain — said out loud, never silently
// swallowed into "here's page 1".
const moneyLogTargetMissing = moneyLogQuery.eventId !== '' && moneyLogTargetPage === null;

// ── "(N) new since last opened" tab badges (CURRENT_TASK.md → סשן ב׳) ──
// Counted over the UNFILTERED lists on purpose: the badge answers "is there
// anything I haven't seen in that tab", which a search box left open in that
// tab must not change. Same `newSince` boundary the panels mark their rows
// with, so "(3)" always means exactly the 3 rows wearing a "חדש" chip.
// Messages isn't in this list — unreadMessagesForAdmin above is already an
// exact per-message signal, more precise than a per-tab timestamp.
const badgeCounts: Record<string, number> = {
  sellers: countSince(sellers, newSince.sellers, (s) => s.createdAt),
  stores: countSince(stores, newSince.stores, (s) => s.createdAt),
  orders: countSince(allOrders, newSince.orders, (o) => o.createdAt),
  alerts: countSince(errorsAll, newSince.alerts, (e) => e.createdAt),
  messages: unreadMessagesForAdmin,
};
---

{/* sellerMode=true here isn't "seller dashboard" semantics — reusing the flag
    that already tells Header.astro "not a shopping session" (hides cart/
    wishlist icons + the buyer login link). An admin session is logically
    distinct from any buyer/seller session; showing shopping icons here read
    as being logged into two things at once (2026-07-14, see CURRENT_TASK.md
    → סשן ב׳). The avatar itself already doesn't render — isLoggedIn stays
    false since there's no buyer/seller session active. */}
<BaseLayout title="Admin Dashboard" noindex={true} isLoggedIn={false} storeMode={true} sellerMode={true}>
  <main id="main-content" class="section container dash-section">
    <div id="dash-main-card" class="card">
      <div class="dash-head">
        <div class="dash-head__top">
          <h1 class="text-[1.3rem] font-bold m-0 leading-[1.2] text-[color:var(--color-text)]">דשבורד ניהול</h1>
          <a href="/admin/logout" class="btn btn--ghost btn--sm">התנתקות</a>
        </div>
      </div>

      <div class="dash-tabs" role="tablist">
        {tabs.map((tab) => {
          const count = badgeCounts[tab.id] ?? 0;
          return (
            <button
              class={`dash-tab${initialPanel === tab.id ? ' dash-tab--active' : ''}`}
              role="tab"
              id={`tab-${tab.id}`}
              data-panel={tab.id}
              aria-selected={initialPanel === tab.id}
              tabindex={initialPanel === tab.id ? 0 : -1}
            >
              {tab.label}
              <span id={`tab-count-${tab.id}`} class="dash-tab__count" style="margin-inline-start:0.25rem" hidden={count === 0}>{count > 0 ? `(${count})` : ''}</span>
            </button>
          );
        })}
      </div>
      <DashTabsBoot />

      <div id="dash-panel-overview" class="dash-panel" role="tabpanel" aria-labelledby="tab-overview" hidden={initialPanel !== 'overview'}>
        <AdminOverviewPanel overview={overview} attentionCount={attentionAll.length} />
      </div>

      <div id="dash-panel-data" class="dash-panel" role="tabpanel" aria-labelledby="tab-data" hidden={initialPanel !== 'data'}>
        <AdminDataPanel
          overview={analyticsOverview}
          sellerFunnel={sellerFunnel}
          range={dataRange}
          activePreset={dataPreset}
          productNames={productNames}
          buildUrl={(preset) => tabUrl('data', { datapreset: preset !== '30d' ? preset : undefined })}
        />
      </div>

      <div id="dash-panel-sellers" class="dash-panel" role="tabpanel" aria-labelledby="tab-sellers" hidden={initialPanel !== 'sellers'}>
        <AdminSellersPanel
          sellerCards={sellerPageResult.items}
          q={sellerQuery.q}
          sortCol={sellerQuery.sortCol}
          sortDir={sellerQuery.sortDir}
          blockedOnly={sellerQuery.blockedOnly}
          newSince={newSince.sellers}
          newOnly={newOnly.sellers}
          newCount={badgeCounts.sellers}
          totalAll={sellerCardsAll.length}
          totalFiltered={sellerCardsFiltered.length}
          page={sellerPageResult.page}
          totalPages={sellerPageResult.totalPages}
          buildUrl={(p) => tabUrl('sellers', {
            sq: sellerQuery.q || undefined,
            ssort: (sellerQuery.sortCol !== 'joined' || sellerQuery.sortDir !== 'desc') ? `${sellerQuery.sortCol}:${sellerQuery.sortDir}` : undefined,
            sblocked: sellerQuery.blockedOnly ? '1' : undefined,
            snew: newOnly.sellers ? '1' : undefined,
            spage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-stores" class="dash-panel" role="tabpanel" aria-labelledby="tab-stores" hidden={initialPanel !== 'stores'}>
        <AdminStoresPanel
          storeRows={storePageResult.items}
          q={storeQuery.q}
          sortCol={storeQuery.sortCol}
          sortDir={storeQuery.sortDir}
          state={storeQuery.state}
          stateCounts={storeStateCounts}
          newSince={newSince.stores}
          newOnly={newOnly.stores}
          newCount={badgeCounts.stores}
          totalAll={storeRowsAll.length}
          totalFiltered={storeRowsFiltered.length}
          page={storePageResult.page}
          totalPages={storePageResult.totalPages}
          buildUrl={(p) => tabUrl('stores', {
            stq: storeQuery.q || undefined,
            stsort: (storeQuery.sortCol !== 'name' || storeQuery.sortDir !== 'asc') ? `${storeQuery.sortCol}:${storeQuery.sortDir}` : undefined,
            ststate: storeQuery.state !== 'all' ? storeQuery.state : undefined,
            stnew: newOnly.stores ? '1' : undefined,
            stpage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-orders" class="dash-panel" role="tabpanel" aria-labelledby="tab-orders" hidden={initialPanel !== 'orders'}>
        <AdminOrdersPanel
          orders={orderPageResult.items}
          totalAll={allOrders.length}
          totalFiltered={ordersFiltered.length}
          q={oq}
          sortCol={oSortCol}
          sortDir={oSortDir}
          shippingStatus={oShip}
          paymentStatus={oPay}
          store={oStore}
          storeNames={orderStoreNames}
          newSince={newSince.orders}
          newOnly={newOnly.orders}
          newCount={badgeCounts.orders}
          page={orderPageResult.page}
          totalPages={orderPageResult.totalPages}
          buildUrl={(p) => tabUrl('orders', {
            oq: oq || undefined,
            osort: (oSortCol !== 'date' || oSortDir !== 'desc') ? `${oSortCol}:${oSortDir}` : undefined,
            oship: oShip.length ? oShip.join(',') : undefined,
            opay: oPay.length ? oPay.join(',') : undefined,
            ostore: oStore.length ? encodeList(oStore) : undefined,
            onew: newOnly.orders ? '1' : undefined,
            opage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-performance" class="dash-panel" role="tabpanel" aria-labelledby="tab-performance" hidden={initialPanel !== 'performance'}>
        <AdminPerformancePanel
          summary={platformPerf.summary}
          revenue={perfRevenue}
          storePage={perfStorePage}
          fromISO={perfFromISO}
          toISO={perfToISO}
          lang={perfLang}
          dir={perfDir}
        />
      </div>

      <div id="dash-panel-attention" class="dash-panel" role="tabpanel" aria-labelledby="tab-attention" hidden={initialPanel !== 'attention'}>
        <AdminAttentionPanel
          entries={attentionPageResult.items}
          page={attentionPageResult.page}
          totalPages={attentionPageResult.totalPages}
          buildUrl={(p) => tabUrl('attention', { apage: p > 1 ? String(p) : undefined })}
        />
      </div>

      <div id="dash-panel-advertising" class="dash-panel" role="tabpanel" aria-labelledby="tab-advertising" hidden={initialPanel !== 'advertising'}>
        <AdminAdvertisingPanel overview={adOverview} brandCampaigns={brandCampaigns} range={adRange} activePreset={adPreset} compare={adCompare} />
      </div>

      <div id="dash-panel-messages" class="dash-panel" role="tabpanel" aria-labelledby="tab-messages" hidden={initialPanel !== 'messages'}>
        <AdminMessagesPanel
          threads={messagePageResult.items}
          allThreadsForSeed={messageThreadsAll}
          sellers={sellers}
          sortCol={threadQuery.sortCol}
          unreadOnly={threadQuery.unreadOnly}
          totalAll={messageThreadsAll.length}
          totalFiltered={messageThreadsFiltered.length}
          page={messagePageResult.page}
          totalPages={messagePageResult.totalPages}
          buildUrl={(p) => tabUrl('messages', {
            msort: threadQuery.sortCol !== 'recent' ? threadQuery.sortCol : undefined,
            munread: threadQuery.unreadOnly ? '1' : undefined,
            mpage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-alerts" class="dash-panel" role="tabpanel" aria-labelledby="tab-alerts" hidden={initialPanel !== 'alerts'}>
        <AdminAlertsPanel
          errors={alertsPageResult.items}
          totalAll={errorsAll.length}
          totalFiltered={errorsFiltered.length}
          sortDir={alSortDir}
          source={alSource}
          storeSlug={alStore}
          storeOptions={errorStoreOptions}
          newSince={newSince.alerts}
          newOnly={newOnly.alerts}
          newCount={badgeCounts.alerts}
          page={alertsPageResult.page}
          totalPages={alertsPageResult.totalPages}
          buildUrl={(p) => tabUrl('alerts', {
            alsort: alSortDir !== 'desc' ? alSortDir : undefined,
            alsource: alSource.length ? alSource.join(',') : undefined,
            alstore: alStore.length ? encodeList(alStore) : undefined,
            alnew: newOnly.alerts ? '1' : undefined,
            alpage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-moneylog" class="dash-panel" role="tabpanel" aria-labelledby="tab-moneylog" hidden={initialPanel !== 'moneylog'}>
        <AdminMoneyLogPanel
          events={moneyLogPageResult.items}
          query={moneyLogQuery}
          targetMissing={moneyLogTargetMissing}
          total={moneyLogPageResult.total}
          page={moneyLogPageResult.page}
          totalPages={moneyLogPageResult.totalPages}
          buildUrl={(p) => tabUrl('moneylog', {
            mtype: moneyLogQuery.type,
            mq: moneyLogQuery.q || undefined,
            mfrom: moneyLogQuery.from || undefined,
            mto: moneyLogQuery.to || undefined,
            mlpage: p > 1 ? String(p) : undefined,
          })}
          reconciliation={reconciliation}
        />
      </div>
    </div>
  </main>
</BaseLayout>

