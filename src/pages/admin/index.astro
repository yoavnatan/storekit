---
export const prerender = false;
import '../../styles/pages/admin.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashTabsBoot from '../../components/dashboard/DashTabsBoot.astro';
import { isAdminRequest } from '../../lib/admin-auth.js';
import { getStoreOverview, getSellerCards, attachProducts, getStoresNeedingAttention, getStoreRows, filterAndSortSellerCards, filterAndSortStoreRows, parseSellerQuery, parseStoreQuery, countStoreStates } from '../../lib/admin-stats.js';
import { getAllSellers, getSubscriptionAccrual } from '../../lib/seller-auth.js';
import { getAllStores, isStoreDiscoverable } from '../../lib/stores.js';
import { getProductCountsByStore, getProductNames, getProductsByStoreIds } from '../../lib/store-products.js';
import { getAdminOrdersPage } from '../../lib/orders.js';
import {
  getAllOrderStoreNames,
  getOpenOrderCountsByStore,
  getPlatformOrderTotals,
  getPlatformSales,
  getStoreRevenueBySlug,
} from '../../lib/order-reporting.js';
import { sortOrderStoreNames, parseOrderQuery } from '../../lib/admin-orders-filter.js';
import { getAdminThreadsPage } from '../../lib/admin-messages.js';
import { parseAdminThreadQuery } from '../../lib/admin-threads-query.js';
import { getRecentErrors, filterAndSortErrors, getErrorStoreNames, MAX_ENTRIES as MAX_ERROR_ENTRIES } from '../../lib/error-log.js';
import { buildPlatformAdOverview } from '../../lib/admin-ads.js';
import { getPlatformAdSettings } from '../../lib/platform-ads.js';
import { getCampaignsInRange, getCampaignTotals } from '../../lib/ad-campaigns.js';
import { getBrandCampaignsInRange, getBrandCampaignTotals } from '../../lib/brand-campaigns.js';
import { presetRange, coerceRange, previousPeriod, AD_RANGE_PRESETS, type AdRangePreset } from '../../lib/date-range.js';
import { businessTodayISO, businessMonthStartISO, businessMonthKey } from '../../lib/business-day.js';
import { store as platform } from '../../config/store.config.js';
import { paginate, parsePage, ADMIN_PAGE_SIZE } from '../../lib/pagination.js';
import { buildAdminUrl, encodeList, decodeList } from '../../lib/admin-nav.js';
import { getAllLastViewedAt, type TrackedAdminTab } from '../../lib/admin-tab-views.js';
import { getAdminTabBadges } from '../../lib/admin-tab-badges.js';
import { buildPlatformPerformance, buildPlatformStoreInputs, parseStoreRowsQuery, selectStoreRows } from '../../lib/platform-performance.js';
import { getStoreViewStats } from '../../lib/store-pageviews.js';
import { buildPlatformRevenue } from '../../lib/platform-revenue.js';
import { pickGranularity } from '../../lib/seller-performance.js';
import { getLang, getDir } from '../../i18n/index.js';
import AdminOverviewPanel from '../../components/admin/AdminOverviewPanel.astro';
import AdminSellersPanel from '../../components/admin/AdminSellersPanel.astro';
import { buildSellerBalances } from '../../lib/seller-balance.js';
import AdminStoresPanel from '../../components/admin/AdminStoresPanel.astro';
import AdminOrdersPanel from '../../components/admin/AdminOrdersPanel.astro';
import AdminAttentionPanel from '../../components/admin/AdminAttentionPanel.astro';
import AdminMessagesPanel from '../../components/admin/AdminMessagesPanel.astro';
import AdminAlertsPanel from '../../components/admin/AdminAlertsPanel.astro';
import AdminAdvertisingPanel from '../../components/admin/AdminAdvertisingPanel.astro';
import AdminPerformancePanel from '../../components/admin/AdminPerformancePanel.astro';
import AdminDataPanel from '../../components/admin/AdminDataPanel.astro';
import AdminMoneyLogPanel from '../../components/admin/AdminMoneyLogPanel.astro';
import { loadMoneyLogPanel } from '../../lib/admin-moneylog-panel.js';
import { reconcilePlatform } from '../../lib/reconcile.js';
import { getAnalyticsOverview } from '../../lib/analytics.js';
import { getSellerFunnel } from '../../lib/seller-funnel.js';

if (!isAdminRequest(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const tabs = [
  { id: 'overview', label: 'סקירה כללית' },
  { id: 'data', label: 'נתונים' },
  { id: 'sellers', label: 'מוכרים' },
  { id: 'stores', label: 'חנויות' },
  { id: 'orders', label: 'הזמנות' },
  { id: 'attention', label: 'לתשומת לב' },
  { id: 'performance', label: 'ביצועים' },
  { id: 'advertising', label: 'פרסום' },
  { id: 'messages', label: 'הודעות' },
  { id: 'alerts', label: 'התראות ושגיאות' },
  { id: 'moneylog', label: 'יומן כספי' },
] as const;

const requestedPanel = Astro.url.searchParams.get('panel');
const initialPanel = tabs.some((t) => t.id === requestedPanel) ? requestedPanel! : 'overview';

const sp = Astro.url.searchParams;

// Every list tab paginates the same way (15/page, arrows) — see
// AI_INSTRUCTIONS.md → admin dashboard pagination. Each tab's query params
// are namespaced (sq/spage, stq/stpage, o*, apage, mpage, alpage) since
// they all coexist in the same URL. tabUrl() is buildAdminUrl() (shared with
// the client-side tab scripts, see src/lib/admin-nav.ts) bound to this
// request's `/admin` base.
const tabUrl = buildAdminUrl;

// ── What this page reads, and what it deliberately does NOT (DB_MIGRATION_PLAN.md §3) ──
// The ROSTER — every seller and every store — is still read whole, because every tab on this page
// is a list of, or a partition of, that roster: Sellers, Stores, Attention and Advertising all
// render from it, searched across seller names and sorted with a Hebrew `localeCompare`.
// Everything DERIVED from it is a query now: revenue per store, product counts per store, open
// orders per store, the platform headline, the reconciliation, the sales behind the performance
// charts and this page's own Orders tab. None of those grows with the size of the catalogue or
// with how many orders the platform has ever taken.
// ── ONE round trip per dependency LEVEL, not one per question (owner, 2026-08-07: "everything
//    here is slow") ──
//
// The database is Neon — it is over the network, and that is the whole story. Measured from this
// machine: `SELECT 1` costs 64ms and `SELECT count(*) FROM orders` costs 64ms. The queries are
// free; the round trip is not. This page ran 41 of them, and it ran them in about seventeen
// SEQUENTIAL steps — `await` on one line, `await` on the next — so the render could not finish in
// less than seventeen network crossings however fast Postgres answered. Measured: ~2.3s of
// time-to-first-byte, in dev AND in a production build, on every single load.
//
// So the fetches are grouped by what they actually DEPEND on rather than by which tab they belong
// to. Three waves, because that is how deep the dependency chain really goes:
//   1. everything that needs nothing but the URL,
//   2. everything that needs the store/seller roster, the tab boundaries, or a wave-1 answer,
//   3. the one fetch that needs a page slice computed from wave 2.
// Reading it by tab was the natural way to write it and is the reason it was slow: the Messages
// tab's query has never had anything to do with the Alerts tab's, and waiting for one before
// starting the other bought nothing.
//
// **Grouped with `Promise.all`, not started early and awaited later.** A promise left floating
// while an earlier `await` throws is an UNHANDLED rejection, and Node's default is to kill the
// process for one — an admin page that 500s would take the whole server with it. Inside a
// `Promise.all` every rejection has an awaiter by construction.
//
// The pool is 10 (db.ts), so a wave of 20 is two batches, not 20 crossings. Nothing here reads
// anything another wave WRITES — this page is entirely read-only — so the grouping cannot change
// a number, only when it arrives.

// Every query parameter this page reads, parsed up front: all of it is pure, and wave 1 needs
// some of it. Nothing below re-reads `sp` for these.
const orderQuery = parseOrderQuery(sp);
const threadQuery = parseAdminThreadQuery(sp);

// "This month" is decided once, HERE, and handed to the query — the Overview card and the Stores
// tab used to each ask their own clock what month it was (business-day.ts).
const currentMonthKey = businessMonthKey(new Date());

// Date range for all ad metrics (default: last 7 days — the Google/Meta
// convention). `adpreset` drives it; `custom` reads adfrom/adto. Everything is
// recomputed over the range, plus the equal-length previous period for a
// period-over-period comparison on the headline totals.
const adPresetRaw = sp.get('adpreset') as AdRangePreset | null;
const adPreset: AdRangePreset = AD_RANGE_PRESETS.includes(adPresetRaw as AdRangePreset) ? adPresetRaw! : '7d';
const adRange = adPreset === 'custom' ? coerceRange(sp.get('adfrom'), sp.get('adto')) : presetRange(adPreset)!;
const adPrevRange = previousPeriod(adRange.from, adRange.to);
// Campaigns are fetched for the WIDER of the two windows — the current range and the equal-length
// previous period are drawn side by side, so one read has to cover both. `getCampaignsInRange` is
// a superset narrowing; `campaignStatsInRange` still decides the exact overlap per window, so
// widening the fetch cannot change a number, only which rows travelled.
const adSpan = { from: adPrevRange.from < adRange.from ? adPrevRange.from : adRange.from, to: adRange.to > adPrevRange.to ? adRange.to : adPrevRange.to };

// Business calendar (business-day.ts) — the same one the per-store summaries bucket
// orders by. date-range.ts's toISODate reads the RUNTIME's local calendar, which is
// UTC on a production server and so quietly reintroduced the off-by-one-day this
// range is supposed to avoid.
const perfToISO = businessTodayISO();
const perfFromISO = businessMonthStartISO(perfToISO);
const perfGranularity = pickGranularity(perfFromISO, perfToISO);

const DATA_PRESETS: AdRangePreset[] = ['today', '7d', '30d', 'thisMonth'];
const dataPresetRaw = sp.get('datapreset') as AdRangePreset | null;
const dataPreset: AdRangePreset = DATA_PRESETS.includes(dataPresetRaw as AdRangePreset) ? dataPresetRaw! : '30d';
const dataRange = presetRange(dataPreset)!;

// ── WAVE 1: needs nothing but the URL ──
const [
  sellers, stores, newSince, openOrdersByStore, orderTotals, revenueByStore,
  orderStoreNamesRaw, threadsPage, errorsAll,
  brandCampaigns, adCampaigns, campaignTotals, brandTotals, platformAdSettings,
  perfTiers, perfCampaigns, analyticsOverview, sellerFunnel, moneyLog,
] = await Promise.all([
  getAllSellers(),
  getAllStores(),
  // ── "new since you last left this tab" (owner feedback 2026-07-28) ──
  // One boundary per tracked tab, read ONCE here and threaded into that tab's panel, so three
  // things always tell the same story: the tab's "(N)" badge, the "חדש" chip on each row, and the
  // "חדשים בלבד" filter. The boundary is deliberately NOT advanced by rendering this page — that
  // used to happen, so the badge said "3 new" while every row inside looked identical, and any
  // in-panel AJAX refresh (search/sort/pager, see admin-nav.ts#swapPanel) silently re-fetched this
  // same route and wiped the marks mid-session. It now advances only when the admin actually
  // leaves the tab (POST /api/admin/tab-view from tab-nav.ts).
  getAllLastViewedAt(),
  getOpenOrderCountsByStore(),
  getPlatformOrderTotals(),
  getStoreRevenueBySlug(currentMonthKey),
  getAllOrderStoreNames(),
  // One page of threads, narrowed and sorted in the query (§3) — this used to read every system
  // message on the platform, group them all in JS, and keep fifteen.
  getAdminThreadsPage(threadQuery, parsePage(sp, 'mpage'), ADMIN_PAGE_SIZE),
  // The write side enforces this same ceiling, so this really is the whole log — which is what
  // lets the store-filter options and the alerts badge below be exact rather than "over newest N".
  getRecentErrors(MAX_ERROR_ENTRIES),
  getBrandCampaignsInRange(adSpan.from, adSpan.to),
  getCampaignsInRange(adSpan.from, adSpan.to),
  getCampaignTotals(),
  getBrandCampaignTotals(),
  getPlatformAdSettings(),
  getSubscriptionAccrual(perfFromISO, perfToISO),
  // Its own fetch, narrowed to the PERFORMANCE range: this tab and the Advertising tab carry
  // separate date pickers, so one list cannot be scoped to both. The numbers are unchanged — the
  // narrowing is a superset and `campaignStatsInRange` still decides the overlap.
  getCampaignsInRange(perfFromISO, perfToISO),
  getAnalyticsOverview(dataRange.from, dataRange.to),
  getSellerFunnel(),
  // Narrowing, search, count and page slice are ALL in the query now (money-events.ts) — this tab
  // used to read every row of its 30-day window to display fifteen of them, over a network. Its own
  // three-step chain (permalink → window → page) is stated once, in admin-moneylog-panel.ts.
  loadMoneyLogPanel(sp),
]);

const storeIds = stores.map((s) => s.id);
const orderStoreNames = sortOrderStoreNames(orderStoreNamesRaw);
const perfStoreInputs = buildPlatformStoreInputs(stores, sellers);
const newOnly: Record<TrackedAdminTab, boolean> = {
  sellers: sp.get('snew') === '1',
  stores: sp.get('stnew') === '1',
  orders: sp.get('onew') === '1',
  alerts: sp.get('alnew') === '1',
};

// ── WAVE 2: needs the roster, a tab boundary, or a wave-1 answer ──
const [
  productCounts, reconciliation, ordersPage, badgeCounts,
  perfViews, perfSales, productNames,
] = await Promise.all([
  getProductCountsByStore(storeIds),
  // Cross-check every money headline against a second, independent computation over the real
  // orders (lib/reconcile.ts). Read-only, and it returns only rows that DISAGREE, so it runs on
  // each render rather than behind a button — a reconciliation nobody clicks is a reconciliation
  // that never catches anything.
  reconcilePlatform(stores.map((s) => s.slug)),
  // Filter, sort, "new only" and the page slice are ALL in the query (orders.ts#getAdminOrdersPage).
  // This used to read every order the platform has ever taken, to render fifteen rows.
  getAdminOrdersPage(
    { ...orderQuery, ...(newOnly.orders ? { newSince: newSince.orders } : {}) },
    parsePage(sp, 'opage'),
    ADMIN_PAGE_SIZE,
  ),
  // Every tab's "(N) new since you last left it", as one statement of five COUNTs. It is fetched
  // unconditionally and on EVERY request — including a panel swap — because a badge exists to
  // report a tab the admin is not looking at (admin-tab-badges.ts).
  getAdminTabBadges(newSince),
  // One query for every store's traffic and one for every store's sales, not a per-store pass over
  // either (DB_MIGRATION_PLAN.md §5 for the views, §3 for the sales).
  getStoreViewStats(perfStoreInputs.map((s) => s.id), perfFromISO, perfToISO, perfGranularity),
  getPlatformSales(perfStoreInputs.map((s) => s.slug), perfFromISO, perfToISO, perfGranularity),
  // Names for the handful of product ids the two top-lists actually name — a lookup by id, not a
  // pass over the whole catalogue (§3). A product that has since been deleted simply has no entry,
  // and the panel already falls back to rendering the id.
  getProductNames([
    ...analyticsOverview.topAdded.map((p) => p.productId),
    ...analyticsOverview.topAbandoned.map((p) => p.productId),
  ]),
]);

const overview = { ...getStoreOverview(sellers.length, stores), ...orderTotals };

// Applied AFTER each tab's own filter+sort so it composes with them instead of
// replacing them (search "דני" + חדשים בלבד = new sellers named דני).
function keepNewOnly<T>(items: T[], on: boolean, boundary: string, createdAt: (item: T) => string): T[] {
  return on ? items.filter((item) => createdAt(item) > boundary) : items;
}

// ── Sellers tab ──
// The card list is built from product COUNTS; the actual product rows are fetched only for the
// stores on the page being rendered, since the per-product block toggle inside an expanded card is
// the one thing here that needs a row rather than a number (§3 — this used to read the whole
// catalogue on every dashboard load).
const sellerQuery = parseSellerQuery(sp);
const sellerCardsAll = getSellerCards(sellers, stores, productCounts, revenueByStore);
const sellerCardsFiltered = keepNewOnly(filterAndSortSellerCards(sellerCardsAll, sellerQuery), newOnly.sellers, newSince.sellers, (c) => c.seller.createdAt);
const sellerPageResult = paginate(sellerCardsFiltered, parsePage(sp, 'spage'));
const sellerPageCards = attachProducts(
  sellerPageResult.items,
  await getProductsByStoreIds(sellerPageResult.items.flatMap((c) => c.stores.map((s) => s.store.id))),
);
// Accrued balances (lib/seller-balance.ts) — reporting only: the processor pays each seller
// directly, so nothing here is an instruction to do anything. Costs no query: it is derived from
// the same `revenueByStore` map the cards above are already built from, which is also what makes
// the balance and the gross figure printed beside it literally the same number.
const balanceBySeller = new Map(
  buildSellerBalances(sellers, stores, revenueByStore).map((b) => [b.sellerId, b]),
);

// ── Stores tab ──
const storeQuery = parseStoreQuery(sp);
// Open-order counts are a GROUP BY, not a pass over every order — the only place they are shown is
// a store waiting to close, but the count has to exist before the rows are filtered so the chips
// can be built from the same list.
const storeRowsAll = getStoreRows(stores, sellers, productCounts, revenueByStore, openOrdersByStore);
const storeStateCounts = countStoreStates(storeRowsAll);
const storeRowsFiltered = keepNewOnly(filterAndSortStoreRows(storeRowsAll, storeQuery), newOnly.stores, newSince.stores, (r) => r.store.createdAt);
const storePageResult = paginate(storeRowsFiltered, parsePage(sp, 'stpage'));

// ── Orders tab ──
const orderPageResult = { items: ordersPage.orders, page: ordersPage.page, totalPages: ordersPage.totalPages, total: ordersPage.total };
// Destructured for the panel below, which needs the query params back to rebuild its own URLs.
const { q: oq, sortCol: oSortCol, sortDir: oSortDir, shippingStatus: oShip, paymentStatus: oPay, store: oStore } = orderQuery;

// ── Attention tab (no filters — pagination only, see CURRENT_TASK.md → סשן ב׳: already a filtered subset) ──
const attentionAll = getStoresNeedingAttention(stores, sellers, productCounts);
const attentionPageResult = paginate(attentionAll, parsePage(sp, 'apage'));

// ── Advertising tab (platform-level, CURRENT_TASK.md → סשן ב׳) ──
// Feed = the exact set the product feed exports: stores a platform surface may carry, holding at
// least one visible product. Gated on isStoreDiscoverable rather than `!blocked` — the feed
// itself runs off getIndexableStores, which also drops a store its seller paused or closed, and
// an inline `!blocked` copy here would have gone on counting those and over-reported what the
// platform is actually advertising. Reuses the already-fetched stores + the per-store product
// counts, so this tab adds no read of its own.
const feedStores = stores.filter((s) => isStoreDiscoverable(s) && (productCounts.get(s.id)?.unblocked ?? 0) > 0);
const feedProductCount = feedStores.reduce((sum, s) => sum + (productCounts.get(s.id)?.unblocked ?? 0), 0);

const adInputBase = { feedStores, feedProductCount, allStores: stores, campaigns: adCampaigns, brandCampaigns, campaignTotals, brandTotals, ads: platform.ads, settings: platformAdSettings };
const adOverview = buildPlatformAdOverview({ ...adInputBase, range: adRange });
const adPrevOverview = buildPlatformAdOverview({ ...adInputBase, range: adPrevRange });
const pctChange = (cur: number, prev: number): number | null => (prev > 0 ? Math.round(((cur - prev) / prev) * 100) : null);
const adCompare = {
  impressions: pctChange(adOverview.exposure.totalImpressions, adPrevOverview.exposure.totalImpressions),
  clicks: pctChange(adOverview.exposure.totalClicks, adPrevOverview.exposure.totalClicks),
  spend: pctChange(adOverview.exposure.totalSpend, adPrevOverview.exposure.totalSpend),
};

// ── Messages tab ──
// One page of threads, narrowed and sorted in the query (§3) — this used to read every system
// message on the platform, group them all in JS, and keep fifteen.
const messagePageResult = { items: threadsPage.threads, page: threadsPage.page, totalPages: threadsPage.totalPages, total: threadsPage.total };

// ── Alerts tab ──
const alSortDir = sp.get('alsort') === 'asc' ? 'asc' : 'desc';
const alSource = (sp.get('alsource') ?? '').split(',').filter(Boolean);
const alStore = decodeList(sp.get('alstore') ?? '');
const alSeverity = (sp.get('alsev') ?? '').split(',').filter(Boolean);
// The alert mail's deep link — one entry's short code, so the mail lands on its row.
const alRef = sp.get('alref') ?? '';
// Unlike the money journal, the Alerts tab has NO default window and must not grow one: the log is
// already capped at MAX_ENTRIES, and an admin opening it after a quiet week has to see the last
// thing that broke even if it broke eleven days ago. The range is opt-in narrowing, nothing more.
const alFrom = sp.get('alfrom') ?? '';
const alTo = sp.get('alto') ?? '';
const errorsFiltered = keepNewOnly(
  filterAndSortErrors(errorsAll, { sortDir: alSortDir, source: alSource, storeSlug: alStore, severity: alSeverity, ref: alRef, from: alFrom, to: alTo }),
  newOnly.alerts, newSince.alerts, (e) => e.createdAt,
);
const alertsPageResult = paginate(errorsFiltered, parsePage(sp, 'alpage'));
const errorStoreOptions = getErrorStoreNames(errorsAll);

// ── Performance tab (platform-wide, aggregates every store) ──
// SSR the default "this month" range so the charts never flash blank; range
// changes re-fetch from /api/admin/platform-performance client-side. Traffic and sales are one
// query each for every store at once, and the single-sourced per-store math
// (buildPlatformPerformance → assemblePerformanceSummary) is pure arithmetic over them.
const perfLang = getLang(Astro.cookies);
const perfDir = getDir(perfLang);
// Business calendar (business-day.ts) — the same one the per-store summaries bucket
// orders by. date-range.ts's toISODate reads the RUNTIME's local calendar, which is
// UTC on a production server and so quietly reintroduced the off-by-one-day this
// range is supposed to avoid.
const platformPerf = buildPlatformPerformance(
  perfSales,
  perfStoreInputs,
  perfViews,
  perfFromISO,
  perfToISO,
  perfGranularity,
);
// First page of the searchable breakdown table. Search/sort/paging all re-fetch
// the endpoint client-side afterwards (platform-performance.ts) — the URL params
// are still honoured here so a deep-linked ?storeQ= renders server-side too.
const perfStorePage = selectStoreRows(platformPerf.stores, parseStoreRowsQuery(sp));
// Where the platform's income actually comes from — commission is only one of three.
// Its own fetch, narrowed to the PERFORMANCE range: this tab and the Advertising tab carry
// separate date pickers, so one list cannot be scoped to both. The numbers are unchanged — the
// narrowing is a superset and `campaignStatsInRange` still decides the overlap.
const perfRevenue = buildPlatformRevenue(
  platformPerf.summary.platformCommissionAgorot,
  platformPerf.summary.commissionRate,
  perfTiers,
  perfCampaigns,
  perfFromISO,
  perfToISO,
);

// ── Data tab (first-party analytics — CURRENT_TASK.md item 2) ──
// The buyer-funnel window recomputes per ?datapreset via the panel-swap AJAX
// (data-panel.ts); the seller onboarding funnel is a lifetime snapshot — five COUNTs, where it
// used to read every seller, store, product and order on the platform (§3).
// Names for the handful of product ids the two top-lists actually name — a lookup by id, not a
// pass over the whole catalogue (§3). A product that has since been deleted simply has no entry,
// and the panel already falls back to rendering the id.

// ── Money journal tab ──
// Nothing left here: type, business-day window, free-text search, count and page slice are all in
// the query, and the three-step permalink chain that decides WHICH page is in `admin-moneylog-
// panel.ts` (fetched in wave 1 above). What used to be here read every row of a 30-day window over
// the network in order to render fifteen of them, then re-applied in JS the narrowing it had just
// asked the database for.

// ── "(N) new since last opened" tab badges (CURRENT_TASK.md → סשן ב׳) ──
// Fetched in wave 2 above, as five COUNTs in one statement (admin-tab-badges.ts). They used to be
// JS filters over lists this page happened to have already loaded — free while every tab was built
// on every request, and silently zero the moment one is not. Counted over the UNFILTERED table on
// purpose: the badge answers "is there anything I haven't seen in that tab", which a search box
// left open in that tab must not change. Same `newSince` boundary the panels mark their rows with,
// so "(3)" always means exactly the 3 rows wearing a "חדש" chip.
// Indexed by tab id for the strip below, which walks `tabs` and knows only the id — a cast inside
// the template is a compile error in `.astro`, so the widening happens here.
const badgeFor: Record<string, number> = badgeCounts;
---

{/* sellerMode=true here isn't "seller dashboard" semantics — reusing the flag
    that already tells Header.astro "not a shopping session" (hides cart/
    wishlist icons + the buyer login link). An admin session is logically
    distinct from any buyer/seller session; showing shopping icons here read
    as being logged into two things at once (2026-07-14, see CURRENT_TASK.md
    → סשן ב׳). The avatar itself already doesn't render — isLoggedIn stays
    false since there's no buyer/seller session active. */}
<BaseLayout title="Admin Dashboard" noindex={true} isLoggedIn={false} storeMode={true} sellerMode={true}>
  {/* A <div>, not a second <main> carrying id=main-content — BaseLayout already wraps this slot in
      one, so this nested a second <main> carrying the SAME id, and the skip link then
      resolves to whichever one comes first rather than to this page content. */}
  <div class="section container dash-section">
    <div id="dash-main-card" class="card">
      <div class="dash-head">
        <div class="dash-head__top">
          <h1 class="text-[1.3rem] font-bold m-0 leading-[1.2] text-[color:var(--color-text)]">דשבורד ניהול</h1>
          <a href="/admin/logout" class="btn btn--ghost btn--sm">התנתקות</a>
        </div>
      </div>

      <div class="dash-tabs" role="tablist">
        {tabs.map((tab) => {
          const count = badgeFor[tab.id] ?? 0;
          return (
            <button
              class={`dash-tab${initialPanel === tab.id ? ' dash-tab--active' : ''}`}
              role="tab"
              id={`tab-${tab.id}`}
              data-panel={tab.id}
              aria-selected={initialPanel === tab.id}
              tabindex={initialPanel === tab.id ? 0 : -1}
            >
              {tab.label}
              {/* data-tab-alert: read by scripts/dashboard/tab-alert-edges.ts, which puts a dot of
                  this colour on the strip's edge while the tab is scrolled out of view. "danger"
                  for all of them — every count here means "rows you have not seen", which is the
                  same thing the site already paints red everywhere else. */}
              <span id={`tab-count-${tab.id}`} class="dash-tab__count" data-tab-alert="danger" style="margin-inline-start:0.25rem" hidden={count === 0}>{count > 0 ? `(${count})` : ''}</span>
            </button>
          );
        })}
      </div>
      <DashTabsBoot />

      <div id="dash-panel-overview" class="dash-panel" role="tabpanel" aria-labelledby="tab-overview" hidden={initialPanel !== 'overview'}>
        <AdminOverviewPanel overview={overview} attentionCount={attentionAll.length} />
      </div>

      <div id="dash-panel-data" class="dash-panel" role="tabpanel" aria-labelledby="tab-data" hidden={initialPanel !== 'data'}>
        <AdminDataPanel
          overview={analyticsOverview}
          sellerFunnel={sellerFunnel}
          range={dataRange}
          activePreset={dataPreset}
          productNames={productNames}
          buildUrl={(preset) => tabUrl('data', { datapreset: preset !== '30d' ? preset : undefined })}
        />
      </div>

      <div id="dash-panel-sellers" class="dash-panel" role="tabpanel" aria-labelledby="tab-sellers" hidden={initialPanel !== 'sellers'}>
        <AdminSellersPanel
          sellerCards={sellerPageCards}
          balanceBySeller={balanceBySeller}
          q={sellerQuery.q}
          sortCol={sellerQuery.sortCol}
          sortDir={sellerQuery.sortDir}
          blockedOnly={sellerQuery.blockedOnly}
          newSince={newSince.sellers}
          newOnly={newOnly.sellers}
          newCount={badgeCounts.sellers}
          totalAll={sellerCardsAll.length}
          totalFiltered={sellerCardsFiltered.length}
          page={sellerPageResult.page}
          totalPages={sellerPageResult.totalPages}
          buildUrl={(p) => tabUrl('sellers', {
            sq: sellerQuery.q || undefined,
            ssort: (sellerQuery.sortCol !== 'joined' || sellerQuery.sortDir !== 'desc') ? `${sellerQuery.sortCol}:${sellerQuery.sortDir}` : undefined,
            sblocked: sellerQuery.blockedOnly ? '1' : undefined,
            snew: newOnly.sellers ? '1' : undefined,
            spage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-stores" class="dash-panel" role="tabpanel" aria-labelledby="tab-stores" hidden={initialPanel !== 'stores'}>
        <AdminStoresPanel
          storeRows={storePageResult.items}
          q={storeQuery.q}
          sortCol={storeQuery.sortCol}
          sortDir={storeQuery.sortDir}
          state={storeQuery.state}
          stateCounts={storeStateCounts}
          newSince={newSince.stores}
          newOnly={newOnly.stores}
          newCount={badgeCounts.stores}
          totalAll={storeRowsAll.length}
          totalFiltered={storeRowsFiltered.length}
          page={storePageResult.page}
          totalPages={storePageResult.totalPages}
          buildUrl={(p) => tabUrl('stores', {
            stq: storeQuery.q || undefined,
            stsort: (storeQuery.sortCol !== 'name' || storeQuery.sortDir !== 'asc') ? `${storeQuery.sortCol}:${storeQuery.sortDir}` : undefined,
            ststate: storeQuery.state !== 'all' ? storeQuery.state : undefined,
            stnew: newOnly.stores ? '1' : undefined,
            stpage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-orders" class="dash-panel" role="tabpanel" aria-labelledby="tab-orders" hidden={initialPanel !== 'orders'}>
        <AdminOrdersPanel
          orders={orderPageResult.items}
          totalAll={ordersPage.totalUnfiltered}
          totalFiltered={ordersPage.total}
          q={oq}
          sortCol={oSortCol}
          sortDir={oSortDir}
          shippingStatus={oShip}
          paymentStatus={oPay}
          store={oStore}
          storeNames={orderStoreNames}
          newSince={newSince.orders}
          newOnly={newOnly.orders}
          newCount={badgeCounts.orders}
          page={orderPageResult.page}
          totalPages={orderPageResult.totalPages}
          buildUrl={(p) => tabUrl('orders', {
            oq: oq || undefined,
            osort: (oSortCol !== 'date' || oSortDir !== 'desc') ? `${oSortCol}:${oSortDir}` : undefined,
            oship: oShip.length ? oShip.join(',') : undefined,
            opay: oPay.length ? oPay.join(',') : undefined,
            ostore: oStore.length ? encodeList(oStore) : undefined,
            onew: newOnly.orders ? '1' : undefined,
            opage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-performance" class="dash-panel" role="tabpanel" aria-labelledby="tab-performance" hidden={initialPanel !== 'performance'}>
        <AdminPerformancePanel
          summary={platformPerf.summary}
          revenue={perfRevenue}
          storePage={perfStorePage}
          fromISO={perfFromISO}
          toISO={perfToISO}
          lang={perfLang}
          dir={perfDir}
        />
      </div>

      <div id="dash-panel-attention" class="dash-panel" role="tabpanel" aria-labelledby="tab-attention" hidden={initialPanel !== 'attention'}>
        <AdminAttentionPanel
          entries={attentionPageResult.items}
          page={attentionPageResult.page}
          totalPages={attentionPageResult.totalPages}
          buildUrl={(p) => tabUrl('attention', { apage: p > 1 ? String(p) : undefined })}
        />
      </div>

      <div id="dash-panel-advertising" class="dash-panel" role="tabpanel" aria-labelledby="tab-advertising" hidden={initialPanel !== 'advertising'}>
        <AdminAdvertisingPanel overview={adOverview} brandCampaigns={brandCampaigns} range={adRange} activePreset={adPreset} compare={adCompare} />
      </div>

      <div id="dash-panel-messages" class="dash-panel" role="tabpanel" aria-labelledby="tab-messages" hidden={initialPanel !== 'messages'}>
        <AdminMessagesPanel
          threads={messagePageResult.items}
          sellers={sellers}
          sortCol={threadQuery.sortCol}
          unreadOnly={threadQuery.unreadOnly}
          totalAll={threadsPage.totalUnfiltered}
          totalFiltered={threadsPage.total}
          page={messagePageResult.page}
          totalPages={messagePageResult.totalPages}
          buildUrl={(p) => tabUrl('messages', {
            msort: threadQuery.sortCol !== 'recent' ? threadQuery.sortCol : undefined,
            munread: threadQuery.unreadOnly ? '1' : undefined,
            mpage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-alerts" class="dash-panel" role="tabpanel" aria-labelledby="tab-alerts" hidden={initialPanel !== 'alerts'}>
        <AdminAlertsPanel
          errors={alertsPageResult.items}
          totalAll={errorsAll.length}
          totalFiltered={errorsFiltered.length}
          sortDir={alSortDir}
          source={alSource}
          storeSlug={alStore}
          severity={alSeverity}
          entryRef={alRef}
          from={alFrom}
          to={alTo}
          storeOptions={errorStoreOptions}
          newSince={newSince.alerts}
          newOnly={newOnly.alerts}
          newCount={badgeCounts.alerts}
          page={alertsPageResult.page}
          totalPages={alertsPageResult.totalPages}
          buildUrl={(p) => tabUrl('alerts', {
            alsort: alSortDir !== 'desc' ? alSortDir : undefined,
            alsource: alSource.length ? alSource.join(',') : undefined,
            alsev: alSeverity.length ? alSeverity.join(',') : undefined,
            alref: alRef || undefined,
            alstore: alStore.length ? encodeList(alStore) : undefined,
            alfrom: alFrom || undefined,
            alto: alTo || undefined,
            alnew: newOnly.alerts ? '1' : undefined,
            alpage: p > 1 ? String(p) : undefined,
          })}
        />
      </div>

      <div id="dash-panel-moneylog" class="dash-panel" role="tabpanel" aria-labelledby="tab-moneylog" hidden={initialPanel !== 'moneylog'}>
        <AdminMoneyLogPanel
          events={moneyLog.events}
          query={moneyLog.query}
          targetMissing={moneyLog.targetMissing}
          total={moneyLog.total}
          page={moneyLog.page}
          totalPages={moneyLog.totalPages}
          buildUrl={(p) => tabUrl('moneylog', {
            mtype: moneyLog.query.type,
            mq: moneyLog.query.q || undefined,
            mfrom: moneyLog.query.from || undefined,
            mto: moneyLog.query.to || undefined,
            mlpage: p > 1 ? String(p) : undefined,
          })}
          reconciliation={reconciliation}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initDashTabs } from '../../scripts/dashboard/ui.js';
  import { initAdminSellersPanel } from '../../scripts/admin/sellers.js';
  import { initAdminStoresPanel } from '../../scripts/admin/stores.js';
  import { initAdminOrdersFilter } from '../../scripts/admin/orders-filter.js';
  import { initAdminMessagesPanel } from '../../scripts/admin/admin-messages.js';
  import { initAdminAlertsPanel } from '../../scripts/admin/alerts.js';
  import { initAdminAdvertisingPanel } from '../../scripts/admin/advertising-platform.js';
  import { initAdminTabNav } from '../../scripts/admin/tab-nav.js';
  import { initPerformanceTab } from '../../scripts/dashboard/performance.js';
  import { initAdminPlatformPerformance } from '../../scripts/admin/platform-performance.js';
  import { initAdminDataPanel } from '../../scripts/admin/data-panel.js';
  import { initAdminMoneyLogPanel } from '../../scripts/admin/moneylog.js';
  initDashTabs();
  initAdminSellersPanel();
  initAdminStoresPanel();
  initAdminOrdersFilter();
  initAdminMessagesPanel();
  initAdminAlertsPanel();
  initAdminAdvertisingPanel();
  initAdminTabNav();
  initPerformanceTab();
  initAdminPlatformPerformance();
  initAdminDataPanel();
  initAdminMoneyLogPanel();
</script>
