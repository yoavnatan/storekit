---
export const prerender = false;
import '../../styles/pages/admin.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashTabsBoot from '../../components/dashboard/DashTabsBoot.astro';
import { isAdminRequest } from '../../lib/admin-auth.js';
import { getStoreOverview, getSellerCards, attachProducts, getStoreRows, filterAndSortSellerCards, filterAndSortStoreRows, parseSellerQuery, parseStoreQuery, countStoreStates, countEmptyStores } from '../../lib/admin-stats.js';
import { getAllSellers, getSubscriptionAccrual } from '../../lib/seller-auth.js';
import { getAllStores, isStoreDiscoverable } from '../../lib/stores.js';
import { getProductCountsByStore, getProductNames, getProductsByStoreIds } from '../../lib/store-products.js';
import { getAdminOrdersPage } from '../../lib/orders.js';
import {
  getAllOrderStoreNames,
  getOpenOrderCountsByStore,
  getOrderSellerOptions,
  getPlatformOrderTotals,
  getPlatformSales,
  getStoreRevenueBySlug,
} from '../../lib/order-reporting.js';
import { sortOrderStoreNames, sortSellerOptions, parseOrderQuery, resolveOrderQuery } from '../../lib/admin-orders-filter.js';
import { getAdminThreadsPage } from '../../lib/admin-messages.js';
import { parseAdminThreadQuery } from '../../lib/admin-threads-query.js';
import { getRecentErrors, filterAndSortErrors, getErrorStoreNames, MAX_ENTRIES as MAX_ERROR_ENTRIES } from '../../lib/error-log.js';
import { getRecentReports, countOpenReports } from '../../lib/user-reports.js';
import { getImageModerationState } from '../../lib/image-moderation-health.js';
import { buildPlatformAdOverview } from '../../lib/admin-ads.js';
import { getPlatformAdSettings } from '../../lib/platform-ads.js';
import { getCampaignsInRange, getCampaignTotals } from '../../lib/ad-campaigns.js';
import { getBrandCampaignsInRange, getBrandCampaignTotals } from '../../lib/brand-campaigns.js';
import { presetRange, coerceRange, previousPeriod, AD_RANGE_PRESETS, type AdRangePreset } from '../../lib/date-range.js';
import { businessTodayISO, businessMonthStartISO, businessMonthKey, isDayISO } from '../../lib/business-day.js';
import { loadPlatformStatement } from '../../lib/admin-statement-load.js';
import { monthPeriod, recentMonthKeys, statementPeriod } from '../../lib/platform-statement.js';
import AdminStatementPanel from '../../components/admin/AdminStatementPanel.astro';
import { store as platform } from '../../config/store.config.js';
import { paginate, parsePage, ADMIN_PAGE_SIZE } from '../../lib/pagination.js';
import { buildAdminUrl, encodeList, decodeList } from '../../lib/admin-nav.js';
import { getAllLastViewedAt, type TrackedAdminTab } from '../../lib/admin-tab-views.js';
import { getAdminTabBadges } from '../../lib/admin-tab-badges.js';
import { buildPlatformPerformance, buildPlatformStoreInputs, parseStoreRowsQuery, selectStoreRows } from '../../lib/platform-performance.js';
import { EMPTY_VIEW_STATS, getPlatformViewStats, getStoreViewStats } from '../../lib/store-pageviews.js';
import { buildPlatformRevenue } from '../../lib/platform-revenue.js';
import { pickGranularity } from '../../lib/seller-performance.js';
import { getLang, getDir } from '../../i18n/index.js';
import AdminOverviewPanel from '../../components/admin/AdminOverviewPanel.astro';
import AdminSellersPanel from '../../components/admin/AdminSellersPanel.astro';
import { buildSellerBalances } from '../../lib/seller-balance.js';
import AdminStoresPanel from '../../components/admin/AdminStoresPanel.astro';
import AdminOrdersPanel from '../../components/admin/AdminOrdersPanel.astro';
import AdminMessagesPanel from '../../components/admin/AdminMessagesPanel.astro';
import AdminAlertsPanel from '../../components/admin/AdminAlertsPanel.astro';
import AdminReportsPanel from '../../components/admin/AdminReportsPanel.astro';
import AdminModerationStatus from '../../components/admin/AdminModerationStatus.astro';
import AdminAdvertisingPanel from '../../components/admin/AdminAdvertisingPanel.astro';
import AdminPerformancePanel from '../../components/admin/AdminPerformancePanel.astro';
import AdminDataPanel from '../../components/admin/AdminDataPanel.astro';
import AdminMoneyLogPanel from '../../components/admin/AdminMoneyLogPanel.astro';
import AdminPanelShell from '../../components/admin/AdminPanelShell.astro';
import AdminReturnsPanel from '../../components/admin/AdminReturnsPanel.astro';
import { getOpenReturns } from '../../lib/return-requests.js';
import { loadMoneyLogPanel } from '../../lib/admin-moneylog-panel.js';
import { reconcilePlatform } from '../../lib/reconcile.js';
import { planPayouts } from '../../lib/payout-run.js';
import { getPlatformAccrual, getHeldBreakdown, getHeldBySeller } from '../../lib/payouts.js';
import { buildPlatformLedger } from '../../lib/platform-ledger.js';
import { getLicenceCeiling } from '../../lib/licence-ceiling.js';
import AdminPayoutPlanCard from '../../components/admin/AdminPayoutPlanCard.astro';
import AdminLedgerCard from '../../components/admin/AdminLedgerCard.astro';
import AdminCeilingCard from '../../components/admin/AdminCeilingCard.astro';
import { getAnalyticsOverview } from '../../lib/analytics.js';
import { getSellerFunnel } from '../../lib/seller-funnel.js';

if (!isAdminRequest(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const tabs = [
  { id: 'overview', label: 'סקירה כללית' },
  { id: 'data', label: 'נתונים' },
  { id: 'sellers', label: 'מוכרים' },
  { id: 'stores', label: 'חנויות' },
  { id: 'orders', label: 'הזמנות' },
  // No 'attention' tab since סשן ב׳ §1. Everything it listed was "this store has 0 products",
  // about stores the Stores tab already lists with that very count on every row — so it is a chip
  // there (`?stempty=1`), which also lets it compose with the state filters and the search it
  // never had. The overview's warning card links straight to it.
  { id: 'performance', label: 'ביצועים' },
  { id: 'advertising', label: 'פרסום' },
  { id: 'messages', label: 'הודעות' },
  { id: 'alerts', label: 'התראות ושגיאות' },
  // Beside the journal and before it: this one is what is ABOUT to happen and the journal is what
  // already did, and a number you can still act on comes before a number you can only check.
  // Before the payouts, because an open return is what HOLDS one back.
  { id: 'returns', label: 'החזרות' },
  { id: 'payouts', label: 'תשלומים למוכרים' },
  // Last of the three money tabs, and the order is the timeline: what is about to happen
  // (payouts), what already did (the journal), and — here — what a closed period ADDS UP TO. The
  // first two are operational screens; this one is a document.
  { id: 'moneylog', label: 'יומן כספי' },
  { id: 'statement', label: 'דוח חשבונאי' },
] as const;

const requestedPanel = Astro.url.searchParams.get('panel');
const initialPanel = tabs.some((t) => t.id === requestedPanel) ? requestedPanel! : 'overview';

const sp = Astro.url.searchParams;

// Every list tab paginates the same way (15/page, arrows) — see
// AI_INSTRUCTIONS.md → admin dashboard pagination. Each tab's query params
// are namespaced (sq/spage, stq/stpage, o*, apage, mpage, alpage) since
// they all coexist in the same URL. tabUrl() is buildAdminUrl() (shared with
// the client-side tab scripts, see src/lib/admin-nav.ts) bound to this
// request's `/admin` base.
const tabUrl = buildAdminUrl;

// ── What this page reads, and what it deliberately does NOT (DB_MIGRATION_PLAN.md §3) ──
// The ROSTER — every seller and every store — is still read whole, because every tab on this page
// is a list of, or a partition of, that roster: Sellers, Stores, Attention and Advertising all
// render from it, searched across seller names and sorted with a Hebrew `localeCompare`.
// Everything DERIVED from it is a query now: revenue per store, product counts per store, open
// orders per store, the platform headline, the reconciliation, the sales behind the performance
// charts and this page's own Orders tab. None of those grows with the size of the catalogue or
// with how many orders the platform has ever taken.
// ── ONE round trip per dependency LEVEL, not one per question (owner, 2026-08-07: "everything
//    here is slow") ──
//
// The database is Neon — it is over the network, and that is the whole story. Measured from this
// machine: `SELECT 1` costs 64ms and `SELECT count(*) FROM orders` costs 64ms. The queries are
// free; the round trip is not. This page ran 41 of them, and it ran them in about seventeen
// SEQUENTIAL steps — `await` on one line, `await` on the next — so the render could not finish in
// less than seventeen network crossings however fast Postgres answered. Measured: ~2.3s of
// time-to-first-byte, in dev AND in a production build, on every single load.
//
// So the fetches are grouped by what they actually DEPEND on rather than by which tab they belong
// to. Three waves, because that is how deep the dependency chain really goes:
//   1. everything that needs nothing but the URL,
//   2. everything that needs the store/seller roster, the tab boundaries, or a wave-1 answer,
//   3. the one fetch that needs a page slice computed from wave 2.
// Reading it by tab was the natural way to write it and is the reason it was slow: the Messages
// tab's query has never had anything to do with the Alerts tab's, and waiting for one before
// starting the other bought nothing.
//
// **Grouped with `Promise.all`, not started early and awaited later.** A promise left floating
// while an earlier `await` throws is an UNHANDLED rejection, and Node's default is to kill the
// process for one — an admin page that 500s would take the whole server with it. Inside a
// `Promise.all` every rejection has an awaiter by construction.
//
// The pool is 10 (db.ts), so a wave of 20 is two batches, not 20 crossings. Nothing here reads
// anything another wave WRITES — this page is entirely read-only — so the grouping cannot change
// a number, only when it arrives.
//
// ── ONE PANEL PER REQUEST (owner, 2026-08-07) ──
//
// Parallelising the waves fixed the shape of the wait; it did not change the fact that this page
// built ALL ELEVEN tabs on every request and `swapPanel` then threw ten of them away. Every read
// below is now gated on whether the tab that displays it is the one being asked for, and a tab the
// admin actually opens loads on the click.
//
// Two things are deliberately NOT gated, and both are the same rule: a signal about a tab you are
// not looking at has to be computed whether or not you are looking at it.
//   · the "(N)" badges — five COUNTs in one statement (admin-tab-badges.ts), and the reason that
//     module exists at all;
//   · `newSince`, the boundary those badges and every "חדש" chip are measured against.
// Rendering this page still does not ADVANCE that boundary; only POST /api/admin/tab-view does.
//
// `only()` returns the fallback without touching the database when the panel is not the one asked
// for. The fallback is always the empty value the pure code below already handles — an empty
// roster, an empty map — so nothing downstream needs to know a panel was skipped; it simply
// computes over nothing, and the template renders no panel at all (see `data-lazy`).
const only = <T,>(panels: readonly string[], load: () => Promise<T>, fallback: T): Promise<T> =>
  (panels.includes(initialPanel) ? load() : Promise.resolve(fallback));

/** Is this the panel being rendered? Gates the derivations whose inputs would be missing otherwise,
 *  and every panel component in the template below. */
const shows = (panel: string): boolean => panel === initialPanel;

// The roster — every seller and every store. Several tabs are a list of it or a partition of it, so
// it is still read whole for those and not read at all for the rest. The two halves have different
// readers and are gated separately: the Messages tab names sellers and never touches stores, while
// the Advertising tab and the money journal's reconciliation are the other way round.
const SELLER_ROSTER_PANELS = ['overview', 'sellers', 'stores', 'performance', 'messages'] as const;
const STORE_ROSTER_PANELS = ['overview', 'sellers', 'stores', 'advertising', 'performance', 'moneylog'] as const;
/** Products per store: the counts behind the seller cards, the store rows, the overview's
 *  empty-catalogue figure and the feed figures on the advertising tab. */
const COUNT_PANELS = ['overview', 'sellers', 'stores', 'advertising'] as const;

// Every query parameter this page reads, parsed up front: all of it is pure, and wave 1 needs
// some of it. Nothing below re-reads `sp` for these.
const orderQuery = parseOrderQuery(sp);
const threadQuery = parseAdminThreadQuery(sp);

// "This month" is decided once, HERE, and handed to the query — the Overview card and the Stores
// tab used to each ask their own clock what month it was (business-day.ts).
const currentMonthKey = businessMonthKey(new Date());

// Date range for all ad metrics (default: last 7 days — the Google/Meta
// convention). `adpreset` drives it; `custom` reads adfrom/adto. Everything is
// recomputed over the range, plus the equal-length previous period for a
// period-over-period comparison on the headline totals.
const adPresetRaw = sp.get('adpreset') as AdRangePreset | null;
const adPreset: AdRangePreset = AD_RANGE_PRESETS.includes(adPresetRaw as AdRangePreset) ? adPresetRaw! : '7d';
const adRange = adPreset === 'custom' ? coerceRange(sp.get('adfrom'), sp.get('adto')) : presetRange(adPreset)!;
const adPrevRange = previousPeriod(adRange.from, adRange.to);
// Campaigns are fetched for the WIDER of the two windows — the current range and the equal-length
// previous period are drawn side by side, so one read has to cover both. `getCampaignsInRange` is
// a superset narrowing; `campaignStatsInRange` still decides the exact overlap per window, so
// widening the fetch cannot change a number, only which rows travelled.
const adSpan = { from: adPrevRange.from < adRange.from ? adPrevRange.from : adRange.from, to: adRange.to > adPrevRange.to ? adRange.to : adPrevRange.to };

// Business calendar (business-day.ts) — the same one the per-store summaries bucket
// orders by. date-range.ts's toISODate reads the RUNTIME's local calendar, which is
// UTC on a production server and so quietly reintroduced the off-by-one-day this
// range is supposed to avoid.
const perfToISO = businessTodayISO();
const perfFromISO = businessMonthStartISO(perfToISO);
const perfGranularity = pickGranularity(perfFromISO, perfToISO);

// ── Accounting statement (סשן ב׳ follow-up, 2026-08-11) ──
// A month key, or a free range — resolved BEFORE wave 1, since the read below is gated on it.
// Both are validated here rather than trusted: an unparseable value falls back to the current
// month, which is the one period that is always a real one. The whole-month collapse lives in
// `statementPeriod`, so `?acfrom=2026-08-01&acto=2026-08-31` and `?acmonth=2026-08` are one
// document rather than two that describe the period differently.
const STATEMENT_MONTHS = 18;
const askedMonth = sp.get('acmonth') ?? '';
const askedFrom = sp.get('acfrom') ?? '';
const askedTo = sp.get('acto') ?? '';
const statementMonths = recentMonthKeys(businessTodayISO(), STATEMENT_MONTHS);
const statementPeriodAsked =
  isDayISO(askedFrom) && isDayISO(askedTo) && askedFrom <= askedTo && !askedMonth
    ? statementPeriod(askedFrom, askedTo)
    : monthPeriod(statementMonths.includes(askedMonth) ? askedMonth : statementMonths[0]!);

const DATA_PRESETS: AdRangePreset[] = ['today', '7d', '30d', 'thisMonth'];
const dataPresetRaw = sp.get('datapreset') as AdRangePreset | null;
const dataPreset: AdRangePreset = DATA_PRESETS.includes(dataPresetRaw as AdRangePreset) ? dataPresetRaw! : '30d';
const dataRange = presetRange(dataPreset)!;

// ── WAVE 1: needs nothing but the URL ──
const [
  sellers, stores, newSince, openOrdersByStore, orderTotals, revenueByStore,
  orderStoreNamesRaw, orderSellersRaw, threadsPage, errorsAll,
  brandCampaigns, adCampaigns, campaignTotals, brandTotals, platformAdSettings,
  perfTiers, perfCampaigns, analyticsOverview, sellerFunnel, moneyLog, openReturns, statement,
] = await Promise.all([
  only(SELLER_ROSTER_PANELS, getAllSellers, []),
  only(STORE_ROSTER_PANELS, getAllStores, []),
  // ── "new since you last left this tab" (owner feedback 2026-07-28) ──
  // One boundary per tracked tab, read ONCE here and threaded into that tab's panel, so three
  // things always tell the same story: the tab's "(N)" badge, the "חדש" chip on each row, and the
  // "חדשים בלבד" filter. The boundary is deliberately NOT advanced by rendering this page — that
  // used to happen, so the badge said "3 new" while every row inside looked identical, and any
  // in-panel AJAX refresh (search/sort/pager, see admin-nav.ts#swapPanel) silently re-fetched this
  // same route and wiped the marks mid-session. It now advances only when the admin actually
  // leaves the tab (POST /api/admin/tab-view from tab-nav.ts).
  getAllLastViewedAt(),
  only(['stores'], getOpenOrderCountsByStore, new Map()),
  only(['overview'], getPlatformOrderTotals, { totalOrders: 0, paidOrders: 0, gmvAgorot: 0 }),
  only(['sellers', 'stores'], () => getStoreRevenueBySlug(currentMonthKey), new Map()),
  only(['orders'], getAllOrderStoreNames, []),
  // The Orders tab's "מוכר/ת" filter. Its own query rather than the seller roster above, for the
  // same reason the store names are: it is bounded by who has actually SOLD, and it carries the
  // slugs the filter is applied by (order-reporting.ts#getOrderSellerOptions).
  only(['orders'], getOrderSellerOptions, []),
  // One page of threads, narrowed and sorted in the query (§3) — this used to read every system
  // message on the platform, group them all in JS, and keep fifteen.
  only(['messages'], () => getAdminThreadsPage(threadQuery, parsePage(sp, 'mpage'), ADMIN_PAGE_SIZE), null),
  // The write side enforces this same ceiling, so this really is the whole log — which is what
  // lets the store-filter options here be exact rather than "over newest N". The alerts BADGE is
  // no longer counted off it (admin-tab-badges.ts), which is what made this read skippable.
  only(['alerts'], () => getRecentErrors(MAX_ERROR_ENTRIES), []),
  only(['advertising'], () => getBrandCampaignsInRange(adSpan.from, adSpan.to), []),
  only(['advertising'], () => getCampaignsInRange(adSpan.from, adSpan.to), []),
  only(['advertising'], getCampaignTotals, { total: 0, active: 0, activeBudgetAgorot: 0 }),
  only(['advertising'], getBrandCampaignTotals, { total: 0, active: 0, activeBudgetAgorot: 0 }),
  only(['advertising'], getPlatformAdSettings, null),
  only(['performance'], () => getSubscriptionAccrual(perfFromISO, perfToISO), []),
  // Its own fetch, narrowed to the PERFORMANCE range: this tab and the Advertising tab carry
  // separate date pickers, so one list cannot be scoped to both. The numbers are unchanged — the
  // narrowing is a superset and `campaignStatsInRange` still decides the overlap.
  only(['performance'], () => getCampaignsInRange(perfFromISO, perfToISO), []),
  only(['data'], () => getAnalyticsOverview(dataRange.from, dataRange.to), null),
  only(['data'], getSellerFunnel, null),
  // Narrowing, search, count and page slice are ALL in the query now (money-events.ts) — this tab
  // used to read every row of its 30-day window to display fifteen of them, over a network. Its own
  // three-step chain (permalink → window → page) is stated once, in admin-moneylog-panel.ts.
  only(['moneylog'], () => loadMoneyLogPanel(sp), null),
  only(['returns'], () => getOpenReturns(), []),
  // The accounting statement — five aggregates in one wave (admin-statement-load.ts), and the SAME
  // function `/api/admin/statement` serves the CSV from, so the screen and the downloaded file
  // cannot be two statements of one month.
  only(['statement'], () => loadPlatformStatement(statementPeriodAsked, businessTodayISO()), null),
]);

const storeIds = stores.map((s) => s.id);
const storeSlugs = stores.map((s) => s.slug);
const orderStoreNames = sortOrderStoreNames(orderStoreNamesRaw);
const orderSellers = sortSellerOptions(orderSellersRaw);
// `oseller` names accounts; both engines filter by store slug. This is the ONE place the two are
// joined up (admin-orders-filter.ts#resolveOrderQuery), and what wave 2's page query is given.
const resolvedOrderQuery = resolveOrderQuery(orderQuery, orderSellers);
const perfStoreInputs = buildPlatformStoreInputs(stores, sellers);
const newOnly: Record<TrackedAdminTab, boolean> = {
  sellers: sp.get('snew') === '1',
  stores: sp.get('stnew') === '1',
  orders: sp.get('onew') === '1',
  alerts: sp.get('alnew') === '1',
};

// ── WAVE 2: needs the roster, a tab boundary, or a wave-1 answer ──
const [
  productCounts, reconciliation, payoutPlan, heldBreakdown, heldBySeller, platformAccrual, ordersPage, badgeCounts,
  perfViews, perfPlatformViews, perfSales, productNames, userReports, openReportCount, imageModerationState,
  licenceCeiling,
] = await Promise.all([
  only(COUNT_PANELS, () => getProductCountsByStore(storeIds), new Map()),
  // Cross-check every money headline against a second, independent computation over the real
  // orders (lib/reconcile.ts). Read-only, and it returns only rows that DISAGREE, so it runs on
  // each render of the tab that shows it rather than behind a button — a reconciliation nobody
  // clicks is a reconciliation that never catches anything. It is shown on the money journal, so
  // that is the tab whose render pays for it.
  only(['moneylog'], () => reconcilePlatform(storeSlugs), null),
  // What the next payout run WOULD do — the one forward-looking number on this dashboard, and the
  // only place the owner can see how much leaves the company's account on the 10th and which
  // sellers are stuck with money we cannot send. Four queries whatever the platform's size
  // (payout-run.ts#planPayouts), and it is the SAME function the run then acts on, so this figure
  // and the transfers cannot be two answers. Money tab only, like the reconciliation beside it.
  // Sellers too, since סשן א׳ §3: the per-seller half of this plan is rendered on the seller cards
  // now, and the filter chips above them are counted from it. Four queries whatever the platform's
  // size, so the Sellers tab pays a fixed cost rather than one per card.
  // Overview too, since סשן ב׳ §3: the platform ledger card is half this plan (what leaves, and
  // what has already left) and half the accrual below it.
  only(['payouts', 'sellers', 'overview'], () => planPayouts(), null),
  // Why the held money is held — the payouts tab's other half (owner, 2026-08-11). One aggregate
  // whatever the platform's size, like the plan beside it.
  only(['payouts'], () => getHeldBreakdown(), null),
  // The same question per seller, for the third money tile on each card.
  only(['sellers'], () => getHeldBySeller(), new Map<string, number>()),
  // The other half — every seller's accrual at once, with the released/held split as a FILTER in
  // the same pass, so the card's three tiles are three parts of one read (payouts.ts).
  only(['overview'], () => getPlatformAccrual(), null),
  // Filter, sort, "new only" and the page slice are ALL in the query (orders.ts#getAdminOrdersPage).
  // This used to read every order the platform has ever taken, to render fifteen rows.
  only(['orders'], () => getAdminOrdersPage(
    { ...resolvedOrderQuery, ...(newOnly.orders ? { newSince: newSince.orders } : {}) },
    parsePage(sp, 'opage'),
    ADMIN_PAGE_SIZE,
  ), null),
  // Every tab's "(N) new since you last left it", as one statement of five COUNTs. It is fetched
  // unconditionally and on EVERY request — including a panel swap — because a badge exists to
  // report a tab the admin is not looking at (admin-tab-badges.ts).
  getAdminTabBadges(newSince),
  // One query for every store's traffic and one for every store's sales, not a per-store pass over
  // either (DB_MIGRATION_PLAN.md §5 for the views, §3 for the sales).
  only(['performance'], () => getStoreViewStats(perfStoreInputs.map((s) => s.id), perfFromISO, perfToISO, perfGranularity), new Map()),
  // And the same question WITHOUT the per-store grouping, which is the only way to count a shopper
  // who opened four stores as one person rather than four (store-pageviews.ts#getPlatformViewStats).
  only(['performance'], () => getPlatformViewStats(perfStoreInputs.map((s) => s.id), perfFromISO, perfToISO, perfGranularity), EMPTY_VIEW_STATS),
  only(['performance'], () => getPlatformSales(perfStoreInputs.map((s) => s.slug), perfFromISO, perfToISO, perfGranularity), { byStore: new Map(), topProducts: [], productRevenueAgorot: 0, productsMatched: 0 }),
  // Names for the handful of product ids the two top-lists actually name — a lookup by id, not a
  // pass over the whole catalogue (§3). A product that has since been deleted simply has no entry,
  // and the panel already falls back to rendering the id.
  only(['data'], () => getProductNames([
    ...(analyticsOverview?.topAdded ?? []).map((p) => p.productId),
    ...(analyticsOverview?.topAbandoned ?? []).map((p) => p.productId),
  ]), new Map()),
  // Visitor reports, at the top of the Alerts tab (AdminReportsPanel.astro). Two reads and not one:
  // the list is bounded, and "N פתוחים" has to stay true past the end of it.
  only(['alerts'], () => getRecentReports(), []),
  only(['alerts'], () => countOpenReports(), 0),
  // Is anybody checking uploaded pictures right now (image-moderation-health.ts). Overview only —
  // it is a card on the landing tab, and with no add-on declared it answers without a query at all.
  // Is anybody checking uploaded pictures right now (image-moderation-health.ts). BOTH tabs, and
  // the split is the point (owner, 2026-08-13): the Overview always says whether the filter is on,
  // and the Alerts tab shows it only when something is wrong — a healthy filter is not an alert.
  // AdminModerationStatus.astro carries the argument. With no add-on declared it needs no query.
  only(['overview', 'alerts'], () => getImageModerationState(), 'ok' as const),
  // How much room is left under the licensing exemption (licence-ceiling.ts). Two aggregates, and
  // Overview only — it belongs beside the money, and it is the one number here that nobody would
  // think to go looking for, which is the whole reason it is on the landing tab rather than behind
  // one. Cheap enough to run on every render of that tab; it is two SUMs with no per-seller work.
  only(['overview'], () => getLicenceCeiling(), null),
]);

const overview = { ...getStoreOverview(sellers.length, stores), ...orderTotals };

// The platform's balance sheet — pure arithmetic over the two reads above (lib/platform-ledger.ts).
const ledger = payoutPlan && platformAccrual ? buildPlatformLedger(platformAccrual, payoutPlan) : null;

// Applied AFTER each tab's own filter+sort so it composes with them instead of
// replacing them (search "דני" + חדשים בלבד = new sellers named דני).
function keepNewOnly<T>(items: T[], on: boolean, boundary: string, createdAt: (item: T) => string): T[] {
  return on ? items.filter((item) => createdAt(item) > boundary) : items;
}

// ── Sellers tab ──
// The card list is built from product COUNTS; the actual product rows are fetched only for the
// stores on the page being rendered, since the per-product block toggle inside an expanded card is
// the one thing here that needs a row rather than a number (§3 — this used to read the whole
// catalogue on every dashboard load).
//
// WAVE 3, and the only one left: the page slice has to exist before the products on it can be
// asked for. It is inside the `shows` gate because it is a query — the pure derivations above and
// below are left to run over their empty fallbacks, which costs nothing and keeps the diff honest.
const sellerQuery = parseSellerQuery(sp);
const sellersTab = shows('sellers') ? await (async () => {
  const all = getSellerCards(sellers, stores, productCounts, revenueByStore);
  // What the next run would do, keyed by seller — the payouts tab's deleted table, as a lookup.
  // EVERY row, including `settled` and `already_paid`: the card's badge is unconditional now,
  // because "there is a balance and no payout" was the question it existed to answer and dropping
  // those two states left exactly that case blank (owner, 2026-08-11). A seller absent from the
  // plan altogether has had nothing come out of hold yet, which the card names as its own state.
  const payoutRows = payoutPlan?.rows ?? [];
  const payoutBySeller = new Map(payoutRows.map((r) => [r.sellerId, r]));
  // Counted BEFORE the filter, so the chips keep reporting what exists while one of them is
  // selected — the same rule the Stores tab's state chips follow. Only over rows with money
  // behind them, because the three chips are the three states worth acting on.
  const payoutStateCounts: Record<string, number> = {};
  for (const r of payoutRows) {
    if (r.balanceAgorot > 0) payoutStateCounts[r.state] = (payoutStateCounts[r.state] ?? 0) + 1;
  }
  const stateBySeller = new Map(payoutRows.map((r) => [r.sellerId, r.state as string]));
  const filtered = keepNewOnly(filterAndSortSellerCards(all, sellerQuery, stateBySeller), newOnly.sellers, newSince.sellers, (c) => c.seller.createdAt);
  const page = paginate(filtered, parsePage(sp, 'spage'));
  return {
    payoutBySeller,
    payoutStateCounts,
    cards: attachProducts(page.items, await getProductsByStoreIds(page.items.flatMap((c) => c.stores.map((s) => s.store.id)))),
    // Accrued balances (lib/seller-balance.ts) — reporting only: the processor pays each seller
    // directly, so nothing here is an instruction to do anything. Costs no query: derived from the
    // same `revenueByStore` map the cards are already built from, which is also what makes the
    // balance and the gross figure printed beside it literally the same number.
    balanceBySeller: new Map(buildSellerBalances(sellers, stores, revenueByStore).map((b) => [b.sellerId, b])),
    totalAll: all.length,
    totalFiltered: filtered.length,
    page: page.page,
    totalPages: page.totalPages,
  };
})() : null;

// ── Stores tab ──
const storeQuery = parseStoreQuery(sp);
// Open-order counts are a GROUP BY, not a pass over every order — the only place they are shown is
// a store waiting to close, but the count has to exist before the rows are filtered so the chips
// can be built from the same list.
const storeRowsAll = getStoreRows(stores, sellers, productCounts, revenueByStore, openOrdersByStore);
const storeStateCounts = countStoreStates(storeRowsAll);
const storeEmptyCount = countEmptyStores(storeRowsAll);
const storeRowsFiltered = keepNewOnly(filterAndSortStoreRows(storeRowsAll, storeQuery), newOnly.stores, newSince.stores, (r) => r.store.createdAt);
const storePageResult = paginate(storeRowsFiltered, parsePage(sp, 'stpage'));

// ── Orders tab ──
// Destructured for the panel below, which needs the query params back to rebuild its own URLs.
const { q: oq, sortCol: oSortCol, sortDir: oSortDir, shippingStatus: oShip, paymentStatus: oPay, store: oStore, payout: oPayout, seller: oSeller } = orderQuery;

// ── Advertising tab (platform-level, CURRENT_TASK.md → סשן ב׳) ──
// Feed = the exact set the product feed exports: stores a platform surface may carry, holding at
// least one visible product. Gated on isStoreDiscoverable rather than `!blocked` — the feed
// itself runs off getIndexableStores, which also drops a store its seller paused or closed, and
// an inline `!blocked` copy here would have gone on counting those and over-reported what the
// platform is actually advertising. Reuses the already-fetched stores + the per-store product
// counts, so this tab adds no read of its own.
const pctChange = (cur: number, prev: number): number | null => (prev > 0 ? Math.round(((cur - prev) / prev) * 100) : null);
const advertisingTab = platformAdSettings && (() => {
  const feedStores = stores.filter((s) => isStoreDiscoverable(s) && (productCounts.get(s.id)?.unblocked ?? 0) > 0);
  const base = {
    feedStores,
    feedProductCount: feedStores.reduce((sum, s) => sum + (productCounts.get(s.id)?.unblocked ?? 0), 0),
    allStores: stores, campaigns: adCampaigns, brandCampaigns, campaignTotals, brandTotals,
    ads: platform.ads, settings: platformAdSettings,
  };
  const overview = buildPlatformAdOverview({ ...base, range: adRange });
  const previous = buildPlatformAdOverview({ ...base, range: adPrevRange });
  return {
    overview,
    compare: {
      impressions: pctChange(overview.exposure.totalImpressions, previous.exposure.totalImpressions),
      clicks: pctChange(overview.exposure.totalClicks, previous.exposure.totalClicks),
      spend: pctChange(overview.exposure.totalSpend, previous.exposure.totalSpend),
    },
  };
})();

// ── Alerts tab ──
const alSortDir = sp.get('alsort') === 'asc' ? 'asc' : 'desc';
const alSource = (sp.get('alsource') ?? '').split(',').filter(Boolean);
const alStore = decodeList(sp.get('alstore') ?? '');
const alSeverity = (sp.get('alsev') ?? '').split(',').filter(Boolean);
// The alert mail's deep link — one entry's short code, so the mail lands on its row.
const alRef = sp.get('alref') ?? '';
// Free-text search, an id above all (owner, 2026-08-07). Capped for the same reason the money
// journal's is: terms × rows on a single-threaded SSR server, both halves request-controlled.
const alQ = (sp.get('alq') ?? '').trim().slice(0, 200);
// Unlike the money journal, the Alerts tab has NO default window and must not grow one: the log is
// already capped at MAX_ENTRIES, and an admin opening it after a quiet week has to see the last
// thing that broke even if it broke eleven days ago. The range is opt-in narrowing, nothing more.
const alFrom = sp.get('alfrom') ?? '';
const alTo = sp.get('alto') ?? '';
const errorsFiltered = keepNewOnly(
  filterAndSortErrors(errorsAll, { sortDir: alSortDir, source: alSource, storeSlug: alStore, severity: alSeverity, ref: alRef, q: alQ, from: alFrom, to: alTo }),
  newOnly.alerts, newSince.alerts, (e) => e.createdAt,
);
const alertsPageResult = paginate(errorsFiltered, parsePage(sp, 'alpage'));
const errorStoreOptions = getErrorStoreNames(errorsAll);

// ── Performance tab (platform-wide, aggregates every store) ──
// SSR the default "this month" range so the charts never flash blank; range
// changes re-fetch from /api/admin/platform-performance client-side. Traffic and sales are one
// query each for every store at once, and the single-sourced per-store math
// (buildPlatformPerformance → assemblePerformanceSummary) is pure arithmetic over them.
const perfLang = getLang(Astro.cookies);
const perfDir = getDir(perfLang);
// Business calendar (business-day.ts) — the same one the per-store summaries bucket
// orders by. date-range.ts's toISODate reads the RUNTIME's local calendar, which is
// UTC on a production server and so quietly reintroduced the off-by-one-day this
// range is supposed to avoid.
const performanceTab = shows('performance') ? (() => {
  const perf = buildPlatformPerformance(perfSales, perfStoreInputs, perfViews, perfFromISO, perfToISO, perfGranularity, perfPlatformViews);
  return {
    summary: perf.summary,
    // First page of the searchable breakdown table. Search/sort/paging all re-fetch the endpoint
    // client-side afterwards (platform-performance.ts) — the URL params are still honoured here so
    // a deep-linked ?storeQ= renders server-side too.
    storePage: selectStoreRows(perf.stores, parseStoreRowsQuery(sp)),
    // How many products sold at all in the range — the "top 5 of N" line over the leaderboard.
    // With no product search running, `productsMatched` IS that count.
    productsTotal: perfSales.productsMatched,
    // Where the platform's income actually comes from — commission is only one of three.
    revenue: buildPlatformRevenue(
      perf.summary.platformCommissionAgorot,
      perf.summary.commissionRate,
      perfTiers,
      perfCampaigns,
      perfFromISO,
      perfToISO,
    ),
  };
})() : null;

// ── Data tab (first-party analytics — CURRENT_TASK.md item 2) ──
// The buyer-funnel window recomputes per ?datapreset via the panel-swap AJAX
// (data-panel.ts); the seller onboarding funnel is a lifetime snapshot — five COUNTs, where it
// used to read every seller, store, product and order on the platform (§3).
// Names for the handful of product ids the two top-lists actually name — a lookup by id, not a
// pass over the whole catalogue (§3). A product that has since been deleted simply has no entry,
// and the panel already falls back to rendering the id.

// ── Money journal tab ──
// Nothing left here: type, business-day window, free-text search, count and page slice are all in
// the query, and the three-step permalink chain that decides WHICH page is in `admin-moneylog-
// panel.ts` (fetched in wave 1 above). What used to be here read every row of a 30-day window over
// the network in order to render fifteen of them, then re-applied in JS the narrowing it had just
// asked the database for.

// ── "(N) new since last opened" tab badges (CURRENT_TASK.md → סשן ב׳) ──
// Fetched in wave 2 above, as five COUNTs in one statement (admin-tab-badges.ts). They used to be
// JS filters over lists this page happened to have already loaded — free while every tab was built
// on every request, and silently zero the moment one is not. Counted over the UNFILTERED table on
// purpose: the badge answers "is there anything I haven't seen in that tab", which a search box
// left open in that tab must not change. Same `newSince` boundary the panels mark their rows with,
// so "(3)" always means exactly the 3 rows wearing a "חדש" chip.
// Indexed by tab id for the strip below, which walks `tabs` and knows only the id — a cast inside
// the template is a compile error in `.astro`, so the widening happens here.
const badgeFor: Record<string, number> = badgeCounts;
---

{/* sellerMode=true here isn't "seller dashboard" semantics — reusing the flag
    that already tells Header.astro "not a shopping session" (hides cart/
    wishlist icons + the buyer login link). An admin session is logically
    distinct from any buyer/seller session; showing shopping icons here read
    as being logged into two things at once (2026-07-14, see CURRENT_TASK.md
    → סשן ב׳). The avatar itself already doesn't render — isLoggedIn stays
    false since there's no buyer/seller session active. */}
<BaseLayout title="Admin Dashboard" noindex={true} isLoggedIn={false} storeMode={true} sellerMode={true}>
  {/* A <div>, not a second <main> carrying id=main-content — BaseLayout already wraps this slot in
      one, so this nested a second <main> carrying the SAME id, and the skip link then
      resolves to whichever one comes first rather than to this page content. */}
  <div class="section container dash-section">
    <div id="dash-main-card" class="card">
      <div class="dash-head">
        <div class="dash-head__top">
          <h1 class="text-[1.3rem] font-bold m-0 leading-[1.2] text-[color:var(--color-text)]">דשבורד ניהול</h1>
          <a href="/admin/logout" class="btn btn--ghost btn--sm">התנתקות</a>
        </div>
      </div>

      <div class="dash-tabs" role="tablist">
        {tabs.map((tab) => {
          const count = badgeFor[tab.id] ?? 0;
          return (
            <button
              class={`dash-tab${initialPanel === tab.id ? ' dash-tab--active' : ''}`}
              role="tab"
              id={`tab-${tab.id}`}
              data-panel={tab.id}
              aria-selected={initialPanel === tab.id}
              tabindex={initialPanel === tab.id ? 0 : -1}
            >
              {tab.label}
              {/* data-tab-alert: read by scripts/dashboard/tab-alert-edges.ts, which puts a dot of
                  this colour on the strip's edge while the tab is scrolled out of view. "danger"
                  for all of them — every count here means "rows you have not seen", which is the
                  same thing the site already paints red everywhere else. */}
              <span id={`tab-count-${tab.id}`} class="dash-tab__count" data-tab-alert="danger" style="margin-inline-start:0.25rem" hidden={count === 0}>{count > 0 ? `(${count})` : ''}</span>
            </button>
          );
        })}
      </div>
      <DashTabsBoot />

      <AdminPanelShell panel="overview" active={shows('overview')}>
        {/* Where the money is, above the counting stats: the accounting question comes first for
            someone opening this dashboard to run a business (סשן ב׳ §3). */}
        {ledger && <AdminLedgerCard
          ledger={ledger!}
          noBankHref={tabUrl('sellers', { spayout: 'no_bank' })}
          payoutsHref={tabUrl('payouts', {})}
        />}
        {/* Under the money and not above it: this answers a question about the money's SIZE, so it
            reads as a footnote to the card above until the day it stops being one. */}
        {licenceCeiling && <AdminCeilingCard ceiling={licenceCeiling} />}
        <AdminOverviewPanel
          overview={overview}
          emptyStoreCount={storeEmptyCount}
          emptyStoresHref={tabUrl('stores', { stempty: '1' })}
        />
        <AdminModerationStatus state={imageModerationState} placement="overview" />
      </AdminPanelShell>

      <AdminPanelShell panel="data" active={shows('data') && !!analyticsOverview && !!sellerFunnel}>
        {analyticsOverview && sellerFunnel && <AdminDataPanel
          overview={analyticsOverview!}
          sellerFunnel={sellerFunnel!}
          range={dataRange}
          activePreset={dataPreset}
          productNames={productNames}
          buildUrl={(preset) => tabUrl('data', { datapreset: preset !== '30d' ? preset : undefined })}
        />}
      </AdminPanelShell>

      <AdminPanelShell panel="sellers" active={!!sellersTab}>
        {sellersTab && <AdminSellersPanel
          sellerCards={sellersTab!.cards}
          balanceBySeller={sellersTab!.balanceBySeller}
          payoutBySeller={sellersTab!.payoutBySeller}
          heldBySeller={heldBySeller}
          payoutStateCounts={sellersTab!.payoutStateCounts}
          q={sellerQuery.q}
          sortCol={sellerQuery.sortCol}
          sortDir={sellerQuery.sortDir}
          blockedOnly={sellerQuery.blockedOnly}
          payoutState={sellerQuery.payoutState}
          newSince={newSince.sellers}
          newOnly={newOnly.sellers}
          newCount={badgeCounts.sellers}
          totalAll={sellersTab!.totalAll}
          totalFiltered={sellersTab!.totalFiltered}
          page={sellersTab!.page}
          totalPages={sellersTab!.totalPages}
          buildUrl={(p) => tabUrl('sellers', {
            sq: sellerQuery.q || undefined,
            ssort: (sellerQuery.sortCol !== 'joined' || sellerQuery.sortDir !== 'desc') ? `${sellerQuery.sortCol}:${sellerQuery.sortDir}` : undefined,
            sblocked: sellerQuery.blockedOnly ? '1' : undefined,
            spayout: sellerQuery.payoutState !== 'all' ? sellerQuery.payoutState : undefined,
            snew: newOnly.sellers ? '1' : undefined,
            spage: p > 1 ? String(p) : undefined,
          })}
        />}
      </AdminPanelShell>

      <AdminPanelShell panel="stores" active={shows('stores')}>
        <AdminStoresPanel
          storeRows={storePageResult.items}
          q={storeQuery.q}
          sortCol={storeQuery.sortCol}
          sortDir={storeQuery.sortDir}
          state={storeQuery.state}
          stateCounts={storeStateCounts}
          emptyOnly={storeQuery.emptyOnly}
          emptyCount={storeEmptyCount}
          newSince={newSince.stores}
          newOnly={newOnly.stores}
          newCount={badgeCounts.stores}
          totalAll={storeRowsAll.length}
          totalFiltered={storeRowsFiltered.length}
          page={storePageResult.page}
          totalPages={storePageResult.totalPages}
          buildUrl={(p) => tabUrl('stores', {
            stq: storeQuery.q || undefined,
            stsort: (storeQuery.sortCol !== 'name' || storeQuery.sortDir !== 'asc') ? `${storeQuery.sortCol}:${storeQuery.sortDir}` : undefined,
            ststate: storeQuery.state !== 'all' ? storeQuery.state : undefined,
            stempty: storeQuery.emptyOnly ? '1' : undefined,
            stnew: newOnly.stores ? '1' : undefined,
            stpage: p > 1 ? String(p) : undefined,
          })}
        />
      </AdminPanelShell>

      <AdminPanelShell panel="orders" active={!!ordersPage}>
        {ordersPage && <AdminOrdersPanel
          orders={ordersPage!.orders}
          totalAll={ordersPage!.totalUnfiltered}
          totalFiltered={ordersPage!.total}
          q={oq}
          sortCol={oSortCol}
          sortDir={oSortDir}
          shippingStatus={oShip}
          paymentStatus={oPay}
          store={oStore}
          payout={oPayout}
          seller={oSeller}
          storeNames={orderStoreNames}
          sellers={orderSellers}
          newSince={newSince.orders}
          newOnly={newOnly.orders}
          newCount={badgeCounts.orders}
          page={ordersPage!.page}
          totalPages={ordersPage!.totalPages}
          buildUrl={(p) => tabUrl('orders', {
            oq: oq || undefined,
            osort: (oSortCol !== 'date' || oSortDir !== 'desc') ? `${oSortCol}:${oSortDir}` : undefined,
            oship: oShip.length ? oShip.join(',') : undefined,
            opay: oPay.length ? oPay.join(',') : undefined,
            ostore: oStore.length ? encodeList(oStore) : undefined,
            opayout: oPayout.length ? oPayout.join(',') : undefined,
            oseller: oSeller.length ? oSeller.join(',') : undefined,
            onew: newOnly.orders ? '1' : undefined,
            opage: p > 1 ? String(p) : undefined,
          })}
        />}
      </AdminPanelShell>

      <AdminPanelShell panel="performance" active={!!performanceTab}>
        {performanceTab && <AdminPerformancePanel
          summary={performanceTab!.summary}
          revenue={performanceTab!.revenue}
          storePage={performanceTab!.storePage}
          productsTotal={performanceTab!.productsTotal}
          fromISO={perfFromISO}
          toISO={perfToISO}
          lang={perfLang}
          dir={perfDir}
        />}
      </AdminPanelShell>

      <AdminPanelShell panel="advertising" active={!!advertisingTab}>
        {advertisingTab && <AdminAdvertisingPanel overview={advertisingTab!.overview} brandCampaigns={brandCampaigns} range={adRange} activePreset={adPreset} compare={advertisingTab!.compare} />}
      </AdminPanelShell>

      <AdminPanelShell panel="messages" active={!!threadsPage}>
        {threadsPage && <AdminMessagesPanel
          threads={threadsPage!.threads}
          sellers={sellers}
          sortCol={threadQuery.sortCol}
          unreadOnly={threadQuery.unreadOnly}
          totalAll={threadsPage!.totalUnfiltered}
          totalFiltered={threadsPage!.total}
          page={threadsPage!.page}
          totalPages={threadsPage!.totalPages}
          buildUrl={(p) => tabUrl('messages', {
            msort: threadQuery.sortCol !== 'recent' ? threadQuery.sortCol : undefined,
            munread: threadQuery.unreadOnly ? '1' : undefined,
            mpage: p > 1 ? String(p) : undefined,
          })}
        />}
      </AdminPanelShell>

      <AdminPanelShell panel="alerts" active={shows('alerts')}>
        <AdminModerationStatus state={imageModerationState} placement="alerts" />
        <AdminReportsPanel reports={userReports} openCount={openReportCount} newSince={newSince.alerts} />
        <AdminAlertsPanel
          errors={alertsPageResult.items}
          totalAll={errorsAll.length}
          totalFiltered={errorsFiltered.length}
          sortDir={alSortDir}
          source={alSource}
          storeSlug={alStore}
          severity={alSeverity}
          entryRef={alRef}
          q={alQ}
          from={alFrom}
          to={alTo}
          storeOptions={errorStoreOptions}
          newSince={newSince.alerts}
          newOnly={newOnly.alerts}
          newCount={badgeCounts.alerts}
          page={alertsPageResult.page}
          totalPages={alertsPageResult.totalPages}
          buildUrl={(p) => tabUrl('alerts', {
            alsort: alSortDir !== 'desc' ? alSortDir : undefined,
            alsource: alSource.length ? alSource.join(',') : undefined,
            alsev: alSeverity.length ? alSeverity.join(',') : undefined,
            alref: alRef || undefined,
            alq: alQ || undefined,
            alstore: alStore.length ? encodeList(alStore) : undefined,
            alfrom: alFrom || undefined,
            alto: alTo || undefined,
            alnew: newOnly.alerts ? '1' : undefined,
            alpage: p > 1 ? String(p) : undefined,
          })}
        />
      </AdminPanelShell>

      {/* `shows('payouts')` and not `!!payoutPlan`, and the difference became load-bearing on
          2026-08-11: the plan is now fetched for the SELLERS tab too (its cards render the
          per-seller half of it), so a truthiness test on the data would mark this panel `active`
          while the admin is looking at Sellers — `AdminPanelShell` renders `hidden={!active}`, so
          two panels would be open at once and this one would lose its `data-lazy` marker. Every
          other shell here asks the same question; this is the one where the answer stopped being
          the same. */}
      <AdminPanelShell panel="payouts" active={shows('payouts') && !!payoutPlan}>
        {payoutPlan && <AdminPayoutPlanCard
          plan={payoutPlan}
          sellersHref={(state: string) => tabUrl('sellers', { spayout: state })}
          held={heldBreakdown ?? { unshippedAgorot: 0, unshippedOrders: 0, clockRunningAgorot: 0, clockRunningOrders: 0 }}
          ordersHref={(payoutStates: readonly string[]) => tabUrl('orders', { opayout: payoutStates.join(',') })}
        />}
      </AdminPanelShell>

      <AdminPanelShell panel="statement" active={shows('statement') && !!statement}>
        {statement && <AdminStatementPanel
          statement={statement!}
          monthKeys={statementMonths}
          activeMonth={statementPeriodAsked.monthKey}
          fromISO={statementPeriodAsked.fromISO}
          toISO={statementPeriodAsked.toISO}
          csvHref={statementPeriodAsked.monthKey
            ? `/api/admin/statement?month=${statementPeriodAsked.monthKey}&format=csv`
            : `/api/admin/statement?from=${statementPeriodAsked.fromISO}&to=${statementPeriodAsked.toISO}&format=csv`}
        />}
      </AdminPanelShell>

      {/* Returns. Its normal state is empty — the sweep closes seven of the eight states on
          its own, and the one that needs a person arrives by mail before anyone opens this. */}
      <AdminPanelShell panel="returns" active={shows('returns')}>
        <AdminReturnsPanel requests={openReturns} />
      </AdminPanelShell>

      <AdminPanelShell panel="moneylog" active={!!moneyLog && !!reconciliation}>
        {moneyLog && reconciliation && <AdminMoneyLogPanel
          events={moneyLog!.events}
          query={moneyLog!.query}
          targetMissing={moneyLog!.targetMissing}
          total={moneyLog!.total}
          page={moneyLog!.page}
          totalPages={moneyLog!.totalPages}
          buildUrl={(p) => tabUrl('moneylog', {
            mtype: moneyLog!.query.type,
            mq: moneyLog!.query.q || undefined,
            mfrom: moneyLog!.query.from || undefined,
            mto: moneyLog!.query.to || undefined,
            mlpage: p > 1 ? String(p) : undefined,
          })}
          reconciliation={reconciliation!}
        />}
      </AdminPanelShell>
    </div>
  </div>
</BaseLayout>

<script>
  import { initDashTabs } from '../../scripts/dashboard/ui.js';
  import { initAdminSellersPanel } from '../../scripts/admin/sellers.js';
  import { initAdminStoresPanel } from '../../scripts/admin/stores.js';
  import { initAdminOrdersFilter } from '../../scripts/admin/orders-filter.js';
  import { initAdminMessagesPanel } from '../../scripts/admin/admin-messages.js';
  import { initAdminAlertsPanel } from '../../scripts/admin/alerts.js';
  import { initAdminAdvertisingPanel } from '../../scripts/admin/advertising-platform.js';
  import { initAdminTabNav } from '../../scripts/admin/tab-nav.js';
  import { initPerformanceTab } from '../../scripts/dashboard/performance.js';
  import { initAdminPlatformPerformance } from '../../scripts/admin/platform-performance.js';
  import { initAdminDataPanel } from '../../scripts/admin/data-panel.js';
  import { initAdminMoneyLogPanel } from '../../scripts/admin/moneylog.js';
  import { initAdminStatementPanel } from '../../scripts/admin/statement.js';
  import { initLazyAdminPanels } from '../../scripts/admin/lazy-panels.js';
  initDashTabs();
  // Ten of the eleven panels arrive on the click that opens them. Every init below still runs on
  // load: each one early-returns on the elements it cannot find, and the ones that matter — the
  // delegated pager/link listeners bound to the panel CONTAINER, which survives every swap — have
  // to be wired before there is anything inside it.
  initLazyAdminPanels();
  initAdminSellersPanel();
  initAdminStoresPanel();
  initAdminOrdersFilter();
  initAdminMessagesPanel();
  initAdminAlertsPanel();
  initAdminAdvertisingPanel();
  initAdminTabNav();
  initPerformanceTab();
  initAdminPlatformPerformance();
  initAdminDataPanel();
  initAdminMoneyLogPanel();
  initAdminStatementPanel();
</script>
