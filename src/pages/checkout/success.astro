---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeShelf from '../../components/HomeShelf.astro';
import { getLang, getT } from '../../i18n/index.js';
import { getCategoryTranslations } from '../../lib/category-translations.js';
import { pickDiscoverStores } from '../../lib/discover-stores.js';
import { getOrderById } from '../../lib/orders.js';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getStoresBySellerId } from '../../lib/stores.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const c = t.checkout;
const userId = getSellerSession(Astro.cookies);
const isLoggedIn = !!userId;

// ── "גלה עוד" after the purchase (owner, 2026-08-20) ─────────────────────────────────
// The confirmation page used to end at "המשך קנייה", a single link back to the homepage.
// This is the homepage's own discovery row, small, in the one place a shopper is finished
// with what they came for and has nothing else to do (lib/discover-stores.ts).
// The order is read for ONE reason — which stores were just bought from, so those cards
// don't come back as something to discover — and nothing from it is rendered, so an id out
// of a stale or shared link reveals nothing it didn't already carry. `getOrderById` returns
// null on a malformed uuid rather than throwing, so a hand-edited `?order=` just means no
// exclusions rather than a 500 on the page that confirms someone's payment.
const orderId = (Astro.url.searchParams.get('order') ?? '').trim();
// Independent reads, so one round trip rather than three (Hard rules → Scalability).
const [ownStores, justOrdered, categoryTranslations] = await Promise.all([
  userId ? getStoresBySellerId(userId) : Promise.resolve([]),
  orderId ? getOrderById(orderId) : Promise.resolve(null),
  getCategoryTranslations(),
]);
const hasStore = ownStores.length > 0;
const boughtSlugs = [...new Set((justOrdered?.items ?? []).map((i) => i.storeSlug))];
// Three, not the homepage's ten: this is a coda under a 480px column, not a shelf someone came
// to browse — "סקשן קטן". Three is also the desktop `--shelf-fit` (store-card.css), so the row
// ends flush on the line at every width from 776px up instead of cutting a fourth card in half.
// Below that it scrolls at two-up, exactly as every other shelf on the site does.
const DISCOVER_COUNT = 3;
// Seeded on the order id, so a refresh — or the back button, which lands here often —
// deals the same four stores. `pickDiscoverStores` says why that matters. Seeded on the
// RESOLVED id rather than on `orderId`, so no request-supplied string reaches the hash: a
// `?order=` that matched nothing is a page with no order behind it, and it gets the same
// row every visitor with no order gets.
const discoverStores = await pickDiscoverStores(DISCOVER_COUNT, boughtSlugs, justOrdered?.id ?? 'checkout-success');
---

{/* storeMode isn't "this is a store" — it is the flag Header.astro uses to pick its ONE row
    mechanism (the same reuse admin/index.astro documents for sellerMode). Every other page on
    the site passes it, and the two that did not — this page and the buyer dashboard — were the
    only two whose header built itself from the old `container between flex` branch and skipped
    `.site-header--store`, i.e. the only two where the bottom edge and the row's spacing changed
    on arrival. The header now renders identically to the homepage's here. */}
<BaseLayout title={c.successTitle} description={c.successDesc} noindex={true} isLoggedIn={isLoggedIn} hasStore={hasStore} storeMode={true} hideNav={true} showSearch={true}>
  {/* A <div>, not a second <main> carrying id=main-content — BaseLayout already wraps this slot in one,
      so the old markup nested two mains and put the same id on both, which sends the skip link
      to whichever the browser finds first. */}
  {/* The bottom gutter belongs to whatever is LAST on the page — with a discovery shelf below,
      this block's own 4rem plus the shelf's padding stacked into a gap that read as the page
      having ended twice. */}
  <div class={`container pt-12 text-center ${discoverStores.length > 0 ? 'pb-6' : 'pb-16'}`}>

    <div class="max-w-[480px] mx-auto">
      <!-- Success icon -->
      <div class="w-[72px] h-[72px] rounded-full bg-[color-mix(in_srgb,var(--color-success)_15%,white)] flex items-center justify-center mx-auto mb-6">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>

      <h1 class="text-[clamp(1.5rem,3vw,2rem)] font-bold [color:var(--color-text)] mb-3" id="success-title">{c.successTitle}</h1>
      <p class="[color:var(--color-muted)] mb-6">{c.successDesc}</p>

      <div class="bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius)] p-5 mb-6">
        <p class="text-sm [color:var(--color-muted)] mb-1.5">{c.successOrderNum}</p>
        <p id="order-number" class="text-base font-semibold [color:var(--color-text)] font-mono tracking-[.04em]">—</p>
      </div>

      <p class="text-sm [color:var(--color-muted)] mb-8">{c.successEmailNote}</p>

      <a href="/" class="btn btn--accent inline-flex">{c.continueShopping}</a>

      <!-- Remaining carts — revealed by JS only when the buyer still has items waiting
           in other stores (unselected items / other-store carts survive checkout). Mirrors
           the personal-area "carts" chips: visit-store link + open-cart button. -->
      <div id="success-more-carts" class="hidden mt-11 text-start"
        data-label-items={t.home.cartItems}
        data-label-open={t.home.cartOpenBtn}
        data-label-visit={t.home.visitStore}>
        <h2 class="text-[.7rem] font-bold [color:var(--color-muted)] tracking-[.08em] uppercase mb-3 text-center">{c.successMoreInCart}</h2>
        <div id="success-carts-list" class="flex flex-col gap-2.5" role="list"></div>
      </div>
    </div>

  </div>

  {/* Below the leftover carts, and OUTSIDE the 480px column + its `.container` — HomeShelf
      renders its own container, and nesting two doubles the page gutter.
      `text-start` because the block above is `text-center` and a shelf heading inherits it.

      `grid`, NOT the default scroll row (owner, 2026-08-20: *"במובייל הכרטיסיות למטה הופכות
      להיות צרות מדי והכל מכווץ מדי"* + *"לא ברור שניתן לגלול לצד שם"*). Both complaints are the
      same fact about the scroller and both are answered by wrapping instead:

      · A scroll row fits TWO cards under 776px, so at 375px each is ~166px and the four preview
        thumbs come out ~30px. That is the exact measurement behind the homepage's own one-column
        rule (HomeShelf's `grid` note, 2026-08-16) — the same cards are 343px wide here with
        ~73px thumbs, which is the size they were designed at.
      · Sideways scrolling has to be DISCOVERED, and it only announces itself with a card cut by
        the viewport edge. On the homepage a long shelf always has one; three cards on a phone
        end flush, so the row looks complete and the other two are simply unreachable. A grid
        has nothing to find: it wraps, and everything is on the page.

      Three stays the right count either way — `grid` is 3 columns from 900px, so the row still
      ends on the line where a desktop shopper sees it. */}
  {discoverStores.length > 0 && (
    <div class="text-start pb-16">
      <HomeShelf categoryLabels={categoryTranslations} id="success-discovery" grid={true}
                 title={t.home.shelfDiscovery} stores={discoverStores} />
    </div>
  )}

  <script>
    import { getActiveStoreCarts, getSubtotal } from '../../lib/cart.js';
    import { formatPrice } from '../../config/store.config.js';
    import { escapeHtml as esc } from '../../lib/html-escape.js';

    // Read order ID from URL and clear cart
    const params = new URLSearchParams(window.location.search);
    const orderId = params.get('order');

    if (orderId) {
      const el = document.getElementById('order-number');
      if (el) el.textContent = orderId.slice(0, 8).toUpperCase();
    }

    // Purchased items were already removed from the cart by the checkout page itself
    // (only the items the buyer selected — unselected items stay in the cart). If
    // anything remains (other stores / unselected items), surface it here as a gentle
    // nudge back into those carts — post-purchase is the natural, friction-free moment.
    const wrap = document.getElementById('success-more-carts');
    const list = document.getElementById('success-carts-list');
    if (wrap && list) {
      const labelItems = wrap.dataset.labelItems ?? 'פריטים';
      const labelOpen  = wrap.dataset.labelOpen  ?? 'פתח עגלה';
      const labelVisit = wrap.dataset.labelVisit ?? 'כנס לחנות';
      const carts = getActiveStoreCarts();
      if (carts.length) {
        list.innerHTML = carts.map((c) => {
          const subtotal = getSubtotal(c.storeSlug);
          const initial  = (c.storeName[0] ?? '?').toUpperCase();
          return `
            <div class="home-cart-chip w-full" role="listitem">
              <a href="/${encodeURIComponent(c.storeSlug)}" class="home-cart-chip__store grow min-w-0" aria-label="${esc(labelVisit)} ${esc(c.storeName)}">
                <div class="home-cart-chip__icon" aria-hidden="true">${esc(initial)}</div>
                <span class="home-cart-chip__name min-w-0 truncate">${esc(c.storeName)}</span>
              </a>
              <span class="home-cart-chip__sep" aria-hidden="true"></span>
              <button type="button" class="home-cart-chip__cart" data-open-cart="${encodeURIComponent(c.storeSlug)}" aria-label="${esc(labelOpen)} — ${esc(c.storeName)}">
                <span class="home-cart-chip__meta">${c.count} ${esc(labelItems)} · ${formatPrice(subtotal)}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              </button>
            </div>`;
        }).join('');
        list.addEventListener('click', (e) => {
          if ((e.target as Element).closest('[data-open-cart]')) window.dispatchEvent(new CustomEvent('cart:open'));
        });
        wrap.classList.remove('hidden');
      }
    }
  </script>
</BaseLayout>
