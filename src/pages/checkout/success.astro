---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLang, getT } from '../../i18n/index.js';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getStoresBySellerId } from '../../lib/stores.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const c = t.checkout;
const userId = getSellerSession(Astro.cookies);
const isLoggedIn = !!userId;
const hasStore = userId ? getStoresBySellerId(userId).length > 0 : false;
---

<BaseLayout title={c.successTitle} description={c.successDesc} noindex={true} isLoggedIn={isLoggedIn} hasStore={hasStore} hideNav={true} showSearch={true}>
  <main id="main-content" class="container" style="padding-block: 3rem 4rem; text-align:center">

    <div style="max-width:480px; margin-inline:auto">
      <!-- Success icon -->
      <div style="width:72px; height:72px; border-radius:50%; background:#dcfce7; display:flex; align-items:center; justify-content:center; margin-inline:auto; margin-bottom:1.5rem">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>

      <h1 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:var(--color-text); margin-bottom:.75rem" id="success-title">{c.successTitle}</h1>
      <p style="color:var(--color-muted); margin-bottom:1.5rem">{c.successDesc}</p>

      <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.25rem; margin-bottom:1.5rem">
        <p style="font-size:.875rem; color:var(--color-muted); margin-bottom:.375rem">{c.successOrderNum}</p>
        <p id="order-number" style="font-size:1rem; font-weight:600; color:var(--color-text); font-family:monospace; letter-spacing:.04em">—</p>
      </div>

      <p style="font-size:.875rem; color:var(--color-muted); margin-bottom:2rem">{c.successEmailNote}</p>

      <a href="/" class="btn btn--accent" style="display:inline-flex">{c.continueShopping}</a>
    </div>

  </main>

  <script>
    // Read order ID from URL and clear cart
    const params = new URLSearchParams(window.location.search);
    const orderId = params.get('order');

    if (orderId) {
      const el = document.getElementById('order-number');
      if (el) el.textContent = orderId.slice(0, 8).toUpperCase();
    }

    // Purchased items were already removed from the cart by the checkout page itself
    // (only the items the buyer selected — unselected items stay in the cart).
  </script>
</BaseLayout>
