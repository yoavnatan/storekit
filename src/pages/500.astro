---
/** What a visitor sees when a request failed — the page Astro renders for any uncaught 500.
 *
 *  **It is standalone on purpose, and that is the whole design of this file.** Every other page on
 *  the site is built on `BaseLayout`, and `BaseLayout` reads the database (`getUnreadCountForUser`)
 *  and issues a CSRF token. A 500 page that did the same would throw for the exact reason it was
 *  being rendered — a database outage is what produces most 500s — and Astro would fall back to
 *  its own bare, English, link-less default. So this page imports **nothing that can fail**:
 *  `main.css` (a static asset, with the @font-face rules in it), the config object, and the
 *  translations module, all three of which are plain values resolved at build time.
 *
 *  For the same reason it says nothing about the cause. It has no way to know one — the error was
 *  logged in `middleware.ts` before it got here (`error-log.ts` → the admin Alerts tab), and
 *  showing a stack trace or a Postgres message to a shopper leaks internals to no one's benefit.
 *
 *  The language comes from the `lang` cookie like everywhere else; reading a cookie cannot fail.
 *  There is no header, so `?next=` and the cart drawer are gone too — the two links below ARE the
 *  navigation, which is why "לנסות שוב" is here and not only "לדף הבית": a 500 is very often
 *  transient (a Neon cold start, GO_LIVE §6), and the useful action is to repeat the request that
 *  just failed, not to abandon it.
 */
export const prerender = false;

import { getLang, getDir, getT } from '../i18n/index.js';
import { store as platform } from '../config/store.config.js';
import '../styles/main.css';

const lang = getLang(Astro.cookies);
const dir = getDir(lang);
const t = getT(lang);

// Astro sets this itself when it renders the page as an error handler; set explicitly so a direct
// hit on /500 is also a 500 and never a 200 OK that a crawler could index as a real page.
Astro.response.status = 500;
---
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t.errorPage.serverErrorTitle} · {platform.name}</title>
  </head>
  <body>
    <main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6 gap-4">
      <h1 class="!text-[1.35rem] !font-semibold">{t.errorPage.serverErrorTitle}</h1>
      <p class="muted max-w-[34ch]">{t.errorPage.serverErrorBody}</p>
      <div class="flex flex-wrap items-center justify-center gap-3 mt-2">
        {/* A plain reload of the current URL — no script, because a page that renders when the
            server is unhealthy should not depend on its JS bundle having loaded either. */}
        <a href={Astro.url.pathname + Astro.url.search} class="btn">{t.errorPage.retry}</a>
        <a href="/" class="btn btn--ghost">{t.errorPage.backHome}</a>
      </div>
    </main>
  </body>
</html>
