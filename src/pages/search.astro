---
export const prerender = false;
import { getCategoryTranslations } from '../lib/category-translations.js';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreCard from '../components/StoreCard.astro';
import ProductDemoBadge from '../components/ProductDemoBadge.astro';
import { store as platform, formatPrice } from '../config/store.config.js';
import { getSellerSession } from '../lib/seller-auth.js';
import { getStoresBySellerId, getStoresBySlugs } from '../lib/stores.js';
import { getStorePreviews, STORE_PREVIEW_SLOTS } from '../lib/store-products.js';
import { searchSite } from '../lib/site-search.js';
import { getLang, getT } from '../i18n/index.js';

const sellerId   = getSellerSession(Astro.cookies);
const isLoggedIn = !!sellerId;
const hasStore   = sellerId ? (await getStoresBySellerId(sellerId)).length > 0 : false;

const lang = getLang(Astro.cookies);
const categoryTranslations = await getCategoryTranslations();
const t    = getT(lang);

const q = (Astro.url.searchParams.get('q') ?? '').trim();

// Larger caps than the header dropdown's short preview (see site-search.ts) —
// this page is the real destination, not a teaser.
const { stores: storeHits, products } = q
  ? await searchSite(q, { storeLimit: 24, productLimit: 60, imageWidth: 300 })
  : { stores: [], products: [] };

// Store hits come back as the trimmed-down search shape (name/slug/tagline), so the full Store and
// its thumbnails are re-read here — which lets this page reuse the same StoreCard the homepage and
// directory draw, instead of a second, thinner store card living only here.
//
// **Two queries, not two per hit.** This was a `getStoreBySlug` AND a whole-catalogue read inside a
// `map` — 2N round trips for N matches, all issued at once, on a page a shopper reaches by typing.
// Ten hits meant twenty concurrent statements against a pool of ten, which is the stampede §7.16
// describes: the eleventh waits for a free connection while holding a request open. Both halves are
// batched now, and the preview read is the same narrowed one the homepage uses.
const hitStores = await getStoresBySlugs(storeHits.map((h) => h.slug));
const previewsByStore = await getStorePreviews(hitStores.map((s) => s.id), STORE_PREVIEW_SLOTS);
const storeCards = hitStores.map((store) => ({
  store,
  previewImages: previewsByStore.get(store.id)?.images ?? [],
}));

const hasResults = storeCards.length > 0 || products.length > 0;

// A query-driven results page is a near-duplicate of whatever it happens to
// match that day — never worth indexing, same reasoning as /stores' own
// filtered views.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SearchResultsPage',
  url: new URL(`/search${q ? `?q=${encodeURIComponent(q)}` : ''}`, platform.url).href,
};
---

<BaseLayout
  title={q ? `${t.search.pageTitle} — ${q}` : t.search.pageTitle}
  description={t.search.pageTitle}
  jsonLd={jsonLd}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
  showSearch={true}
  noindex={true}
  dataLayer={{ event: 'page_view', page_type: 'search_results', currency: 'ILS' }}
>
  <div class="container section search-page">
    <div class="search-page__head">
      <button type="button" id="search-back-btn" class="search-back-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style={lang === 'he' ? 'transform:scaleX(-1)' : ''}><polyline points="15 18 9 12 15 6"/></svg>
        <span>{t.search.back}</span>
      </button>
      <h1 class="search-page__title">
        {q
          ? (hasResults ? t.search.resultsFor.replace('{query}', q) : t.search.noResultsFor.replace('{query}', q))
          : t.search.pageTitle}
      </h1>
    </div>

    {!q ? (
      <p class="search-page__empty">{t.search.emptyPrompt}</p>
    ) : !hasResults ? (
      <div class="search-page__empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <p>{t.search.noResultsHint}</p>
      </div>
    ) : (
      <Fragment>
        {storeCards.length > 0 && (
          <section class="search-section">
            <h2 class="search-section__title">{t.search.sectionStores}</h2>
            <div class="stores-directory__grid" role="list">
              {storeCards.map(({ store, previewImages }, i) => (
                <StoreCard store={store} previewImages={previewImages} eager={i === 0} role="listitem" categoryLabels={categoryTranslations} />
              ))}
            </div>
          </section>
        )}

        {products.length > 0 && (
          <section class="search-section">
            <h2 class="search-section__title">{t.search.sectionProducts}</h2>
            <ul class="search-products-grid" role="list">
              {products.map((p, i) => (
                <li>
                  {/* The one product link on the site that really navigates, which is why it is
                      the only product card that opts in: the store page's product name is
                      hijacked into the quick-view modal, and the modal's own "full page" link is
                      built via innerHTML, which prefetch cannot bind to (astro.config.mjs). Here
                      a hover genuinely predicts the next page load. */}
                  <a href={`/${p.storeSlug}/${p.slug}`} class="search-product-card card" data-astro-prefetch>
                    <div class="search-product-card__img-wrap" data-skeleton={p.image ? '' : undefined}>
                      {p.image
                        ? <Image src={p.image} alt={p.name} width={300} height={300} class="search-product-card__img" loading={i < 6 ? 'eager' : 'lazy'} />
                        : (
                          <div class="search-product-card__img-placeholder" aria-hidden="true">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                              <line x1="12" y1="22.08" x2="12" y2="12"/>
                            </svg>
                          </div>
                        )}
                      <ProductDemoBadge demo={p.demo} />
                    </div>
                    <div class="search-product-card__body">
                      <span class="search-product-card__name"><bdi>{p.name}</bdi></span>
                      <span class="search-product-card__store"><bdi>{p.storeName}</bdi></span>
                      <span class="search-product-card__price-row block mt-[0.15rem]">
                        <span class={`search-product-card__price price-now${p.basePrice ? ' price-now--sale' : ''}`}>{formatPrice(p.price)}</span>
                        {p.basePrice && <s class="price-was">{formatPrice(p.basePrice)}</s>}
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </Fragment>
    )}
  </div>
</BaseLayout>

<script>
  import { initImageSkeletons } from '../lib/img-skeleton.js';
  initImageSkeletons('.store-card__preview-img-wrap');
  initImageSkeletons('.search-product-card__img-wrap');

  // "Back" means wherever the user actually came from, not a fixed route —
  // real browser history when there's a same-origin entry to return to
  // (typing+Enter from any page on the site), a plain homepage fallback for
  // a direct/new-tab visit where there's nothing meaningful to go back to.
  document.getElementById('search-back-btn')?.addEventListener('click', () => {
    const ref = document.referrer;
    const sameOrigin = ref && new URL(ref, window.location.href).origin === window.location.origin;
    if (sameOrigin && window.history.length > 1) window.history.back();
    else window.location.href = '/';
  });
</script>
