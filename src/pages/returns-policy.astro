---
/** מדיניות ביטולים והחזרות — the public page a buyer reads before they buy.
 *
 *  ── What this page is allowed to say, and it is a shorter list than the mechanism ──
 *  Every clause here is either **the law itself** or **more generous than the law**. Nothing on it
 *  narrows a buyer's rights, and that is what makes it publishable ahead of the legal review the rest
 *  of the mechanism is waiting on (`docs/returns-lawyer-brief.md`): you cannot be caught out by
 *  having promised more than you owed.
 *
 *  **Two things the mechanism does are therefore NOT on this page, on purpose:**
 *
 *    1. **The 7-day window for handing the parcel to the courier.** It is the one rule that could be
 *       read as conditioning a right the statute says may not be conditioned. Internally it only ever
 *       RELEASES money to the seller — an operational act, not a promise to the buyer — so leaving it
 *       unstated costs the buyer nothing and claims nothing. Question 2 of the lawyer brief.
 *    2. **"A lapsed request forfeits the refund."** Same reason, stated the other way round.
 *
 *  When the עו״ד answers, those two get their clauses and this note gets shorter. Until then the page
 *  is complete for what it does say — and a buyer reading it is never told less than the law gives.
 *
 *  ── Why it exists NOW rather than after the review ──
 *  Merchant Center defines a returns policy at ACCOUNT level and leans on one published on the site.
 *  Without it a product is not shown as a full merchant listing, which is one platform-wide account
 *  serving every seller's ads (GO_LIVE §2). The page is also what `hasMerchantReturnPolicy` in the
 *  product JSON-LD will point at; that structured-data claim is deliberately still unwritten, because
 *  it must carry the same numbers as this page and the numbers here are the statute's, not ours.
 *
 *  ── The numbers are interpolated, never typed ──
 *  `STATUTORY_RETURN_DAYS` is the law's own figure and lives in `payout-schedule.ts` beside the hold
 *  it constrains. A digit written into a legal clause AND separately into the code is a number that
 *  will disagree with itself, and the version a buyer can hold us to is this one.
 *
 *  ⚠️ Accurate, not lawyered. `docs/returns-policy-decisions.md` is the source for every rule; the
 *  eight open questions are in `docs/returns-lawyer-brief.md`.
 *
 *  Hebrew, in both UI languages, with the Hebrew binding — the same standard `terms.astro` sets and
 *  for the same reason.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getSellerSession } from '../lib/seller-auth.js';
import { getStoresBySellerId } from '../lib/stores.js';
import { getLang } from '../i18n/index.js';
import { store as platform } from '../config/store.config.js';
import { STATUTORY_RETURN_DAYS, SHIP_AUTO_CANCEL_DAYS } from '../lib/payout-schedule.js';
import {
  RESPONSE_BUSINESS_DAYS, HANDOVER_DAYS, OFFER_ANSWER_DAYS, ESCALATION_DAYS,
} from '../lib/returns.js';

const lang = getLang(Astro.cookies);
const sellerId = getSellerSession(Astro.cookies);
const isLoggedIn = !!sellerId;
const hasStore = sellerId ? (await getStoresBySellerId(sellerId)).length > 0 : false;

const title = lang === 'he' ? 'ביטולים והחזרות' : 'Cancellations and returns';

/** Every clause, as data — one loop below, and a new rule is one entry. Same shape as
 *  `terms.astro`, deliberately: these two pages are read together and edited together. */
const clauses: { h: string; p: string[] }[] = [
  {
    h: 'ביטול לפני שההזמנה נשלחה',
    p: [
      'כל עוד ההזמנה לא נמסרה לחברת השילוח, אפשר לבטל אותה מיד ובלי לתת סיבה. הביטול מתבצע מהאזור האישי, בכפתור על ההזמנה עצמה.',
      'הביטול מיידי ואינו מותנה באישור המוכר. התמורה מוחזרת במלואה, כולל דמי המשלוח.',
    ],
  },
  {
    h: 'החזרת מוצר שכבר הגיע',
    p: [
      `אפשר לבטל רכישה ולהחזיר מוצר בתוך ${STATUTORY_RETURN_DAYS} ימים ממועד קבלתו. זו זכות הקבועה בחוק הגנת הצרכן ובתקנותיו, והיא חלה על כל רכישה באתר.`,
      'הבקשה נפתחת מהאזור האישי, בכפתור על ההזמנה. אפשר להחזיר את ההזמנה כולה או חלק מהפריטים שבה.',
      'המוצר יוחזר כשלא נעשה בו שימוש ובאריזתו המקורית, ככל שהייתה.',
    ],
  },
  {
    h: 'בלי דמי ביטול',
    p: [
      // More generous than the regulations, which permit 5% or ₪100 — so it can be published today.
      // The number is deliberately not quoted: naming what we could have charged reads as a favour
      // being counted, and the owner's decision was that this is simply how the platform works.
      `${platform.name} אינה גובה דמי ביטול, בשום מקרה. הסכום ששולם עבור המוצרים חוזר במלואו.`,
    ],
  },
  {
    h: 'דמי המשלוח',
    p: [
      'בביטול לפני שההזמנה נשלחה — דמי המשלוח חוזרים גם הם.',
      'הגיע מוצר פגום, שאינו תקין או שאינו מה שהוזמן — דמי המשלוח חוזרים, והמשלוח בחזרה על חשבון המוכר.',
      'ביטול מרצון אחרי שההזמנה הגיעה — דמי המשלוח ששולמו אינם מוחזרים, והמשלוח בחזרה על חשבון הקונה. כך קובעות התקנות.',
    ],
  },
  {
    h: 'איך המוצר חוזר לחנות',
    p: [
      `אחרי שהבקשה מאושרת יש ${HANDOVER_DAYS} ימים לשלוח את המוצר בחזרה לחנות. מי שלא שולח בזמן — הבקשה נסגרת, ואפשר לפתוח חדשה כל עוד תקופת הביטול לא חלפה.`,
      'אחרי השליחה צריך לסמן באזור האישי שהמוצר נשלח. הסימון הזה חשוב: הוא מה שמונע מהבקשה להיסגר, וכדאי להוסיף מספר מעקב אם יש.',
      'חנות שמאפשרת איסוף עצמי מקבלת החזרות גם בחנות עצמה, בלי משלוח. זו הדרך הפשוטה והבטוחה, כי המוכר מאשר את הקבלה במקום.',
      `אם המוצר נשלח והמוכר לא מאשר שקיבל אותו, אנחנו בודקים את המקרה בעצמנו. הכסף לא עובר לאף צד עד שההכרעה מתקבלת.`,
    ],
  },
  {
    h: 'החזר חלקי במקום החזרה',
    p: [
      'המוכר יכול להציע החזר כספי חלקי במקום שהמוצר יחזור. זו הצעה בלבד: אפשר לקבל אותה, ואפשר לדחות ולהחזיר את המוצר כרגיל.',
      `להצעה יש ${OFFER_ANSWER_DAYS} ימים. אם לא עונים בזמן ההצעה מתבטלת, וזכות הביטול נשמרת במלואה — אפשר לפתוח בקשה חדשה.`,
    ],
  },
  {
    h: 'אם הבקשה נדחתה',
    p: [
      `סירב המוכר לבקשה, ולדעת הקונה הסירוב אינו מוצדק — אפשר לבקש מ${platform.name} לבדוק אותו, מאותו מקום שבו נפתחה הבקשה. יש ${ESCALATION_DAYS} ימים לעשות זאת.`,
      'בזמן הבדיקה הכסף אינו מועבר לאף אחד מהצדדים. ההכרעה שלנו, ולא של המוכר.',
    ],
  },
  {
    h: 'מתי הכסף חוזר',
    p: [
      'הזיכוי מבוצע לאחר שהמוצר חוזר למוכר, ולאותו אמצעי תשלום שבו בוצעה הרכישה.',
      'הזיכוי מתבצע במועד הביטול או בסמוך לו, ולא יאוחר מהמועד הקבוע בתקנות.',
    ],
  },
  {
    h: 'מוצרים שלא ניתן להחזיר',
    p: [
      'התקנות מוציאות מזכות הביטול סוגי מוצרים אחדים — בהם מזון, תוספי תזונה, תרופות, מוצרי הלבשה תחתונה ובגדי ים, ומוצר שיוצר במיוחד עבור הקונה לפי מידותיו או דרישותיו.',
      'מוצר שאינו ניתן להחזרה מסומן ככזה בעמוד המוצר, לפני הרכישה.',
    ],
  },
  {
    h: 'ההזמנה לא הגיעה',
    p: [
      `לא נמסרה ההזמנה בתוך ${SHIP_AUTO_CANCEL_DAYS} ימים ממועד התשלום, היא מתבטלת אוטומטית והתמורה מוחזרת במלואה, בלי דמי ביטול ובלי שתצטרך לבקש.`,
      'חבילה שיצאה ולא הגיעה — אפשר לדווח על כך מהאזור האישי, ואנחנו מבררים מול חברת השילוח. הבירור הוא שלנו ולא שלך.',
    ],
  },
  {
    h: 'מוצר פגום או לא תקין',
    p: [
      'מעבר לזכות הביטול, לקונה עומדות זכויותיו לפי חוק המכר ולפי כל דין בשל מוצר פגום, שאינו מתאים לתיאורו או שאינו מתאים למה שהוזמן. מדיניות זו אינה גורעת מהן.',
    ],
  },
  {
    h: 'איך פונים',
    p: [
      `כל בקשת ביטול או החזרה נפתחת מהאזור האישי, ואפשר לעקוב אחריה שם. אם משהו נתקע, אפשר לפנות אלינו ב-${platform.business.email}.`,
    ],
  },
];

/** The same facts, in the words people use. Last on the page and deliberately short — every answer
 *  is one or two sentences, and none of them adds a rule the clauses above do not already state. */
const faq: { q: string; a: string }[] = [
  {
    q: 'ביטלתי הזמנה — מתי הכסף חוזר?',
    a: 'הביטול מתבצע מיד, והכסף חוזר לאותו אמצעי תשלום שבו שילמת. אין דמי ביטול.',
  },
  {
    q: 'פשוט לא התאים לי. אפשר להחזיר?',
    a: `כן, תוך ${STATUTORY_RETURN_DAYS} ימים מקבלת המוצר, בלי לתת סיבה. מחיר המוצר חוזר במלואו. המשלוח בחזרה על חשבונך, ודמי המשלוח המקורי אינם מוחזרים.`,
  },
  {
    q: 'המוצר הגיע שבור. מי משלם על המשלוח בחזרה?',
    a: 'החנות. גם דמי המשלוח שכבר שילמת חוזרים אליך.',
  },
  {
    q: 'הזמנתי שלושה דברים ורוצה להחזיר רק אחד.',
    a: 'אפשר. בבקשה מסמנים אילו פריטים חוזרים, והכסף חוזר עבורם בלבד.',
  },
  {
    q: 'הזמנתי משתי חנויות. צריך להחזיר הכול?',
    a: 'לא. כל חנות היא הזמנה נפרדת, ואפשר להחזיר מאחת בלי לגעת בשנייה.',
  },
  {
    q: 'המוכר הציע לי החזר חלקי כדי שאשאיר את המוצר. חייבים להסכים?',
    a: 'לא. אפשר לדחות ולהחזיר את המוצר כרגיל, וזה לא פוגע בזכות שלך.',
  },
  {
    q: 'ההזמנה לא הגיעה בכלל.',
    a: `פותחים בקשה מהאזור האישי ובוחרים "לא קיבלתי". אנחנו מבררים מול חברת השילוח, לא המוכר. ואם ההזמנה לא נמסרה לשילוח תוך ${SHIP_AUTO_CANCEL_DAYS} ימים, היא מתבטלת מעצמה והכסף חוזר.`,
  },
  {
    q: 'שלחתי את המוצר בחזרה. צריך לעשות עוד משהו?',
    a: 'כן — לסמן באזור האישי שהמוצר נשלח. בלי הסימון הזה הבקשה עלולה להיסגר, ואם יש מספר מעקב כדאי להוסיף אותו.',
  },
  {
    q: 'אפשר להחזיר את המוצר לחנות עצמה, בלי משלוח?',
    a: 'בחנות שמאפשרת איסוף עצמי — כן, וזו הדרך הפשוטה ביותר. המוכר מאשר את הקבלה במקום, והזיכוי מתחיל משם.',
  },
  {
    q: 'שלחתי את המוצר והמוכר טוען שלא קיבל אותו.',
    a: `אנחנו בודקים את המקרה ומכריעים. עד ההכרעה הכסף לא מועבר לאף צד, ולכן כדאי לשמור את אישור המשלוח ומספר המעקב.`,
  },
  {
    q: 'המוכר סירב לבקשה שלי ואני חושב שזה לא מוצדק.',
    a: `אפשר לבקש מ${platform.name} לבדוק את הסירוב, מאותו מקום שבו נפתחה הבקשה, תוך ${ESCALATION_DAYS} ימים. ההכרעה שלנו.`,
  },
  {
    q: 'אני מוכר. הקונה סימן שהוא שלח, אבל שום דבר לא הגיע.',
    a: 'לא לסמן שקיבלת. אחרי שבועיים המקרה עובר אלינו לבדיקה אוטומטית, והכסף מוקפא עד שנכריע.',
  },
  {
    q: 'אני מוכר. אפשר לסרב להחזרה?',
    a: `לא בתוך ${STATUTORY_RETURN_DAYS} הימים הראשונים — זו זכות של הקונה בחוק. אחרי התקופה הזאת ההחלטה שלך, ויש לך ${RESPONSE_BUSINESS_DAYS} ימי עסקים לענות.`,
  },
  {
    q: 'אני מוכר. המוצר חזר אליי משומש או בקופסה ריקה.',
    a: `מסמנים "הגיע ריק או משומש" בלשונית ההחזרות. הכסף נעצר, ונציג ${platform.name} מכריע.`,
  },
  {
    q: 'אני מוכר. מתי מקזזים ממני את הכסף?',
    a: 'אם ההזמנה עוד לא שולמה לך, הכסף פשוט לא מועבר. אם הוא כבר הועבר, הסכום מקוזז מהתשלום הבא שלך.',
  },
];
---

<BaseLayout
  title={`${title} — ${platform.name}`}
  description={lang === 'he'
    ? `מדיניות הביטולים וההחזרות של ${platform.name} — ${STATUTORY_RETURN_DAYS} ימים להחזרה, בלי דמי ביטול.`
    : `${platform.name} cancellation and returns policy.`}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
  showSearch={true}
>
  <section class="section container" dir="rtl" style="max-width:70ch">
    <h1 class="!text-[1.6rem] !font-semibold">ביטולים והחזרות</h1>
    {lang !== 'he' && (
      <p class="muted" style="margin-top:0.75rem">This policy is published in Hebrew, which is the binding version.</p>
    )}

    {clauses.map((c) => (
      <>
        <h2 class="!text-[1.05rem] !font-semibold" style="margin-top:1.75rem">{c.h}</h2>
        {c.p.map((line) => <p style="margin-top:0.5rem">{line}</p>)}
      </>
    ))}

    <h2 class="!text-[1.05rem] !font-semibold" style="margin-top:2.5rem">שאלות נפוצות</h2>
    <dl style="margin-top:0.25rem">
      {faq.map((item) => (
        <>
          <dt class="!font-semibold" style="margin-top:1.1rem">{item.q}</dt>
          <dd style="margin:0.3rem 0 0">{item.a}</dd>
        </>
      ))}
    </dl>

    <p style="margin-top:2rem">
      <a href="/terms" class="muted">תנאי שימוש</a> · <a href="/contact" class="muted">יצירת קשר</a>
    </p>
  </section>
</BaseLayout>
