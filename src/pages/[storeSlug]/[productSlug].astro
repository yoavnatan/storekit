---
export const prerender = false;
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoreBySlug, getStoreByPreviousSlug, isStoreVisible, storeHttpStatus, showsPausedNotice, storeHeaderLogo } from '../../lib/stores.js';
import { OG_IMAGE_FORMAT, storeImageUrl } from '../../lib/store-image.js';
import { isDemoStore } from '../../lib/demo-stores.js';
import { storeCanonicalUrl, productCanonicalUrl, customDomainRedirectUrl, isPlatformAdLanding, adLandingUrl, hasActiveCustomDomain } from '../../lib/custom-domain.js';
import { platformBoundaryData } from '../../lib/cross-origin-handoff.js';
import { parseVariantLanding } from '../../lib/variant-landing.js';
import { getProductBySlug, getVisibleProductsByStoreId, isProductVisible } from '../../lib/store-products.js';
import { store as platform, cdnSrc, cdnSrcSet, cdnThumb } from '../../config/store.config.js';
import { resolvePrice, priceValidUntil } from '../../lib/discounts.js';
import { offerShippingDetails } from '../../lib/shipping.js';
import { priceHtml, saleBadgeHtml } from '../../lib/price-html.js';
import StoreSaleBanner from '../../components/StoreSaleBanner.astro';
import ProductDemoBadge from '../../components/ProductDemoBadge.astro';
import { demoProductBadgeHtml } from '../../lib/demo-badge.js';
import OwnerStoreBar from '../../components/OwnerStoreBar.astro';
import ShareMenu from '../../components/ShareMenu.astro';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getLang, getT } from '../../i18n/index.js';
import { resolveVariantColor, isColorVariant } from '../../lib/color-variants.js';
import { comboKey, isProductInStock } from '../../lib/variant-combo.js';
import { getCategoriesByStoreId, categoryPath } from '../../lib/store-categories.js';
import { buildRelatedGroups } from '../../lib/related-products.js';
import { nonReturnableNotice } from '../../lib/return-eligibility.js';
import { saleScopeCategoryLabel } from '../../lib/store-sale-scope.js';
import { jsonForScript } from '../../lib/json-script.js';
import { machineUrl } from '../../lib/url-base.js';
import { toAbsoluteImageUrl } from '../../lib/image-url.js';
import StarRating from '../../components/StarRating.astro';
import { cardStarRowHtml, STAR_PATH } from '../../lib/star-html.js';
import ReviewForm from '../../components/ReviewForm.astro';
import { getReviewsForProduct, getRatingCountsForProduct, getReviewableOrderForProduct } from '../../lib/product-reviews.js';
import { averageRating, ratingDisplay, ratingHistogram, reviewerInitial, RATING_MAX } from '../../lib/reviews.js';
import { REVIEWS_SECTION_ANCHOR } from '../../lib/reviews-anchor.js';
import { soloHueGradient, hueIndexFor } from '../../lib/placeholder-art.js';

const { storeSlug, productSlug } = Astro.params;
if (!storeSlug || !productSlug) return Astro.redirect('/404');

const shopStore = await getStoreBySlug(storeSlug);
if (!shopStore) {
  // Store URL renamed → 301 the old slug (keeping the product path) to the current one, preserving
  // SEO + shared links instead of 404-ing (see renameStoreSlug).
  const moved = await getStoreByPreviousSlug(storeSlug);
  // `machineUrl`, because both halves are DECODED route params: a Hebrew slug in a Location header
  // throws rather than redirects (url-base.ts#machineUrl).
  if (moved) return Astro.redirect(machineUrl(`/${moved.slug}/${productSlug}`), 301);
  return Astro.redirect('/404');
}
// Not serving a storefront at all: an admin block (admin-moderation.ts) answers 404, so the store
// stops accumulating crawl/index signal while it is under review; a store its seller closed for
// good answers 410 Gone, which drops it from the index faster and more definitively.
//
// REWRITTEN, not redirected (2026-07-31). A redirect made the store's own URL answer 302 and put
// the real status on /404 — so a crawler recorded "this store moved to an error page" instead of
// "this store is gone", which is a weaker and slower signal, and the address bar left the URL the
// shopper actually followed. A rewrite renders the same page AT this URL and carries its status
// (404.astro sets it), which is what both Google and the shopper should be given.
if (!isStoreVisible(shopStore)) {
  return Astro.rewrite(storeHttpStatus(shopStore) === 410 ? '/store-gone' : '/404');
}
// Operational halt by the seller (store-status.ts). The URL keeps working — no redirect, no 404,
// so every existing link still resolves — but it serves the notice INSTEAD of the catalog: a
// shopper cannot do anything with a product they are not allowed to buy, and a grid of disabled
// buttons reads as a broken page rather than a closed one (decided with the owner 2026-07-31).
// Rewritten here, before any product/category/sale/page-view work, so a halted store costs
// nothing to serve. /api/checkout refuses it regardless of what any page renders.
if (showsPausedNotice(shopStore)) {
  return Astro.rewrite('/store-unavailable');
}
// A showcase store's products stay browsable by direct link (that's the point of
// the demo) but must never be indexed — the store page, sitemap and product feed
// apply the same rule; see lib/demo-stores.ts.
const isDemo = isDemoStore(shopStore);

const product = await getProductBySlug(shopStore.id, productSlug);
if (!product) return Astro.redirect(machineUrl(`/${storeSlug}`));
if (!isProductVisible(product)) return Astro.redirect('/404');

// A landing published by the platform's own ads stays on the platform domain — the one domain the
// Merchant Center / Meta account can claim, and a redirect off it is a disapproval
// (custom-domain.ts#AD_LANDING_PARAM).
const adLanding = isPlatformAdLanding(shopStore, Astro.url, Astro.request.headers.get('host'));
// SEO: verified custom domain is the store's home — 301 the platform product URL to it (see the
// store page for the rationale). No-op when already served on the custom domain.
const cdRedirect = adLanding
  ? null
  : customDomainRedirectUrl(shopStore, Astro.request.headers.get('host'), `/${productSlug}${Astro.url.search}`);
if (cdRedirect) return Astro.redirect(cdRedirect, 301);

// The origin boundary, computed HERE and not in the markup: `platformBoundaryData` sets a
// `Cache-Control` header, and Astro streams the body — a header written from a template expression
// is written after the status line has already left. Frontmatter is the last place it still counts.
// Only a store on its own domain has a boundary to cross; on the platform this is null and the
// attribute is never emitted.
const platformBoundary = hasActiveCustomDomain(shopStore)
  ? platformBoundaryData(Astro.cookies, Astro.response.headers)
  : null;

const userId = getSellerSession(Astro.cookies);
const isLoggedIn = !!userId;
const lang = getLang(Astro.cookies);
const t = getT(lang);

// The seller browsing his own store gets the same bar here as on the store page — the
// store is one surface, and a preview that announces itself only on the front page
// leaves him guessing on every page he clicks into (see OwnerStoreBar.astro). On a
// custom domain the dashboard is on another origin, so the link has to be absolute.
const isOwner = !!userId && userId === shopStore.sellerId;
const dashboardHref = shopStore.customDomain?.status === 'active'
  ? `${platform.url}/seller/dashboard`
  : '/seller/dashboard';

const isNew = new Date(product.createdAt).toDateString() === new Date().toDateString();
const images = product.images ?? [];

/** How many reviews the page renders. Everything past this is a scroll nobody does and bytes every
 *  shopper pays for; the score and the histogram are computed over ALL of them regardless. */
const REVIEWS_PAGE_SIZE = 8;

// Used only as a heuristic for each option button's own availability preview
// (combined with the first option of every *other* dimension) — no dimension
// is actually pre-selected for the buyer; see "no default pre-selection" below.
const defaultVariantSelection: Record<string, string> =
  Object.fromEntries((product.variants ?? []).map((v) => [v.name, v.options[0] ?? '']));
// The ONE exception to "no default pre-selection": a combo named by the URL. Every variant feed
// row lands here carrying its own combination (variant-landing.ts), so an ad click arrives on the
// red/42 the ad showed instead of on an unselected page. Rendered server-side rather than applied
// by the client, so the swatch, the stock line and the add-to-cart ceiling are right in the first
// paint — a shopper who arrived from a paid click is the last one who should watch the page
// change under them. An unparseable/unknown value yields {}, i.e. exactly the old behaviour.
// A dimension with a single option is pre-selected regardless (it has no choice to make), which is
// what `renderedSelection` folds in — the client's own init below builds the same map.
const landedVariants = parseVariantLanding(Astro.url, product.variants);
const renderedSelection: Record<string, string> = {
  ...Object.fromEntries((product.variants ?? []).filter((v) => v.options.length === 1).map((v) => [v.name, v.options[0]!])),
  ...landedVariants,
};
// The stock line reflects whatever is selected in this first paint — the combo's own bucket when
// the URL named a complete one, the product's shared pool otherwise (which is what the client's
// unselected-state fallback also shows, so nothing jumps once JS hydrates).
const renderedComboComplete = (product.variants ?? []).every((v) => renderedSelection[v.name]);
const initialComboStock = renderedComboComplete && (product.variants?.length ?? 0) > 0
  ? (product.variantStock?.[comboKey(renderedSelection)] ?? product.stock)
  : product.stock;
const LOW_STOCK_DISPLAY_THRESHOLD = 5;
const initialStockState: 'out' | 'low' | 'in' =
  initialComboStock <= 0 ? 'out' : initialComboStock <= LOW_STOCK_DISPLAY_THRESHOLD ? 'low' : 'in';
const initialStatusColor =
  initialStockState === 'out' ? 'var(--color-danger)'
  : initialStockState === 'low' ? 'var(--color-warning)'
  : 'var(--color-muted)';
const initialStatusText =
  initialStockState === 'out' ? t.store.outOfStock
  : initialStockState === 'low' ? (lang === 'he' ? `נותרו ${initialComboStock} בלבד` : `Only ${initialComboStock} left`)
  : t.store.inStockLabel;
// Canonical product/store URLs — the seller's own domain when active, else the platform path
// (custom-domain.ts). Drives <link rel=canonical>, og:url and the JSON-LD so all SEO signals agree.
// On an ad landing the canonical is the landing itself: Merchant Center reads the page's canonical
// and treats a cross-domain one as the real destination, which would put the item back on an
// unclaimed domain — the exact thing the marker exists to prevent. That URL is `noindex` below, so
// it never competes with the seller's domain for the organic result.
const productUrl = adLanding ? adLandingUrl(shopStore, productSlug) : productCanonicalUrl(shopStore, productSlug);
// What a shopper forwards is always the seller's own canonical — never the ad landing above. That
// URL exists so Merchant Center resolves the item on a domain the ad account can claim; passed
// around by hand it would spread the ad marker through WhatsApp and attribute organic traffic to
// a campaign that never ran.
const shareUrl = productCanonicalUrl(shopStore, productSlug);
/**
 * The picture that arrives with the link in WhatsApp/Facebook/Telegram — i.e. the whole of what
 * "a shared product looks good" means, since every one of them builds its card from `og:image`
 * and none of them resizes anything.
 *
 * It used to be `images[0]`, the raw upload: a seller's 4000px phone photo, several megabytes,
 * handed to scrapers that give up on a slow or oversized fetch and fall back to a link with no
 * picture at all. `cdnSrc(…, 1200)` is a ceiling, never an upscale (lib/cdn.ts), and 1200 is
 * deliberately one of `LIGHTBOX_WIDTHS` — `image-derive.ts` pre-renders exactly that rung when the
 * seller saves, so the scraper hits a warm transform instead of paying Cloudinary's ~0.8s cold
 * render inside its own timeout.
 */
const ogImage = images[0] ? cdnSrc(images[0], 1200) : storeImageUrl(shopStore, OG_IMAGE_FORMAT);
const storeCanonical = storeCanonicalUrl(shopStore);
// Resolved against the store's OWN origin — on a verified custom domain that is the seller's
// domain, and a picture served from a domain the page does not claim is a mismatch a validator
// reports and a shopping answer engine acts on.
const jsonLdImages = images
  .map((img) => toAbsoluteImageUrl(img, new URL(storeCanonical).origin))
  .filter((url): url is string => url !== null);

// Every "לתשלום" on this page names the store it was pressed in. Checkout reads `?store=` as
// intent, not as a filter (checkout.astro): this store opens on top and pre-ticked, the rest of the
// cart is listed under it untouched. Without it, pressing checkout from inside a store landed on a
// page where every other store was ticked too — the inconsistency this parameter exists to remove.
const checkoutHref = `/checkout?store=${encodeURIComponent(shopStore.slug)}`;

// Pre-filtered to non-blocked (see store-products.ts#getVisibleProductsByStoreId) — this list
// also feeds the header search-suggestions JSON below, which used to leak a blocked product
// as a suggestion that led straight into a 404 (found in review, 2026-07-14).
// Together, not one after the other: neither needs the other's answer, only the store, and in
// series they were two round trips on the platform's most-indexed page type. The store page and
// the homepage had the same shape (DB_MIGRATION_PLAN.md §8).
// The reviews join this group rather than sitting after it: the list, the histogram and "may this
// visitor write one" depend on nothing but the product and the session, both already in hand, and
// awaited one by one they would be three more round trips on the platform's most-indexed page type.
// `reviewableOrderId` is skipped entirely for a signed-out visitor — the common case, and the query
// has no answer without an account.
const [allStoreProducts, storeCategoriesForProduct, productReviews, productRatingCounts, reviewableOrderId] = await Promise.all([
  getVisibleProductsByStoreId(shopStore.id),
  getCategoriesByStoreId(shopStore.id),
  (product.reviewCount ?? 0) > 0 ? getReviewsForProduct(product.id, REVIEWS_PAGE_SIZE) : Promise.resolve([]),
  (product.reviewCount ?? 0) > 0 ? getRatingCountsForProduct(product.id) : Promise.resolve([]),
  userId ? getReviewableOrderForProduct(userId, product.id) : Promise.resolve(null),
]);
// Was `.slice(0, 4)` off this list — the four NEWEST products in the shop, which is a fact about
// the shop and not about the product on screen (owner, 2026-08-20). `related-products.ts` owns the
// ranking and says what it ranks on; here it is given only what it is allowed to see: the store's
// other VISIBLE products (`allStoreProducts` is already filtered) and the seller's own category
// tree, both already in hand from the Promise.all above, so this costs no extra query.
const relatedGroups = buildRelatedGroups(
  product,
  allStoreProducts.filter((p) => p.slug !== product.slug),
  storeCategoriesForProduct,
);

const productCategoryName = product.categoryId ? storeCategoriesForProduct.find((c) => c.id === product.categoryId)?.name ?? '' : '';
const productCategoryPathStr = product.categoryId ? categoryPath(storeCategoriesForProduct, product.categoryId) : '';
// Every sale names its scope on the banner, the store-wide one included — same rule as the
// store page, and here it also tells the shopper the sale reaches beyond the product they are
// looking at (StoreSaleBanner still hides itself entirely on a product a scoped sale misses).
/** The regulations' own exclusion, when it applies to THIS PRODUCT — its own shelf inside the shop
 *  and every shelf above it, never the shop as a whole (owner, 2026-08-17: a fashion store is not a
 *  store you cannot return from; it has one shelf you cannot). Shown before the purchase, which is
 *  the only moment it can change a decision, and `/api/returns` enforces the same answer. */
const noReturnNotice = nonReturnableNotice(productCategoryPathStr);

const saleScopeLabel = saleScopeCategoryLabel(storeCategoriesForProduct, shopStore.sale, t.store.saleAndMore)
  || (shopStore.sale?.productIds?.length ? t.store.saleOnSelected : t.store.saleOnWholeStore);

// The price to display, charge and publish — resolved once from the product + its store's
// sale, exactly as /api/checkout resolves it (discounts.ts).
const pv = resolvePrice(product, shopStore.sale);
// The day this price stops holding, when a dated sale is what produced it (discounts.ts).
const saleEndsAfter = priceValidUntil(product, shopStore.sale);

// The product's score, from the cached aggregate on the row (migration 0033). `null` when nothing
// has been rated — and null is rendered as NOTHING, never as five empty stars or a `ratingValue`
// of 0, which Google would read as a real and terrible score (reviews.ts#averageRating).
const ratingAggregate = { count: product.reviewCount ?? 0, sum: product.reviewRatingSum ?? 0 };
const ratingAvg = averageRating(ratingAggregate);
const ratingBars = ratingHistogram(productRatingCounts);
// The form is offered only to someone who has an unreviewed, reviewable purchase of THIS product.
// The same question the API re-asks before it writes — this half only decides what is on screen.
const canReview = !!reviewableOrderId;

/**
 * `aggregateRating` + the reviews themselves, when there are any.
 *
 * This is the whole SEO payoff of the feature and the only route ratings have to META (their
 * catalog feed has no rating field at all — `review-feed.ts` carries the check): a star rating in a
 * Google product rich result, and a landing page an AI shopping answer can read a score off.
 *
 * **`ratingValue` is the true average, not the rounded half the stars draw.** Structured data that
 * disagrees with the visible page is the mismatch Google penalises, and what is visible here is the
 * one-decimal number beside the stars — so both come from `ratingDisplay` and cannot drift.
 *
 * Only reviews with TEXT are emitted as `review` entries: a `Review` with an empty `reviewBody` is
 * an invalid entity, while a rating-only review still counts in the aggregate. Same split the
 * Google reviews feed makes, for the same reason.
 */
const reviewsWithText = productReviews.filter((r) => r.body.trim());
// Constructed ONCE, not per row. Building an `Intl` formatter inside a loop is what took the admin
// dashboard from 700ms to 80ms when it was removed (memory `project_admin_dashboard_render_cost`);
// eight rows is not that page, but the shape is how it got there.
// Where this product's reviewer colours begin. Stable per product, arbitrary between
// products — which is what makes two product pages look different rather than identical.
const reviewHueStart = hueIndexFor(product.id);
const reviewDateFormat = new Intl.DateTimeFormat(lang === 'he' ? 'he-IL' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const ratingJsonLd = ratingAvg === null ? {} : {
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: ratingDisplay(ratingAvg),
    reviewCount: ratingAggregate.count,
    bestRating: RATING_MAX,
    worstRating: 1,
  },
  ...(reviewsWithText.length ? {
    review: reviewsWithText.map((r) => ({
      '@type': 'Review',
      reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: RATING_MAX, worstRating: 1 },
      author: { '@type': 'Person', name: r.reviewerName || t.reviews.anonymous },
      datePublished: r.createdAt.slice(0, 10),
      reviewBody: r.body,
    })),
  } : {}),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  ...ratingJsonLd,
  name: product.name,
  ...(product.description ? { description: product.description } : {}),
  // Absolute, like the feed's `image_link` — `sanitizeImageUrl` accepts a site-relative path by
  // design, and a relative URL inside JSON-LD is a URL the parser has to guess a base for. The feed
  // already resolves them (product-feed.ts#buildFeedItems); this is the same picture, so it is the
  // same string. Unusable entries drop out rather than emitting a broken `image`.
  ...(jsonLdImages.length ? { image: jsonLdImages } : {}),
  // brand/sku/mpn enrich both Google rich results and AI-answer comprehension (AIO). The
  // seller's own brand field when they set one (a reseller listing someone else's product),
  // else the store name — a small business is its own brand. Same fallback as the ad feed
  // (product-feed.ts), on purpose: the two must never name a different brand for one product.
  brand: { '@type': 'Brand', name: product.brand?.trim() || shopStore.name },
  ...(product.sku ? { sku: product.sku, mpn: product.sku } : {}),
  ...(productCategoryPathStr ? { category: productCategoryPathStr } : {}),
  ...(product.tags?.length ? { keywords: product.tags.join(', ') } : {}),
  ...(product.specs?.length ? {
    additionalProperty: product.specs.map((s) => ({
      '@type': 'PropertyValue',
      name: s.label,
      value: s.value,
    })),
  } : {}),
  url: productUrl,
  offers: {
    '@type': 'Offer',
    price: String(pv.price),
    priceCurrency: 'ILS',
    // Google's merchant-listing requirements: without it the discounted price is treated as
    // open-ended and can be shown after the sale has ended. Omitted when there is no sale or
    // no end date — see discounts.ts#priceValidUntil for the inclusive/exclusive off-by-one.
    ...(saleEndsAfter ? { priceValidUntil: saleEndsAfter } : {}),
    itemCondition: 'https://schema.org/NewCondition',
    // When the URL named a complete combo this offer describes THAT combo, not the product.
    // Otherwise "is anything on this page buyable" — the shopper has chosen nothing, so the
    // product-wide answer is the honest one (isProductInStock: the shared pool is not the answer
    // for a product whose combos carry their own buckets).
    // The distinction is a Merchant Center one, not a nicety: a feed row that says `out_of_stock`
    // landing on a page whose structured data says `InStock` is the availability mismatch Google
    // checks a landing page for, and every variant row lands here carrying its combo.
    availability: renderedComboComplete && (product.variants?.length ?? 0) > 0
      ? (initialComboStock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock')
      : (isProductInStock(product.stock, product.variants, product.variantStock)
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock'),
    url: productUrl,
    seller: { '@type': 'Organization', name: shopStore.name },
    // Platform-set, identical for every store (shipping.ts) — a merchant listing has to say
    // what delivery costs, and it is also what an AI shopping answer checks before recommending.
    shippingDetails: offerShippingDetails(),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: shopStore.name,
      item: storeCanonical,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: product.name,
      item: productUrl,
    },
  ],
};

const pmI18n = {
  addToCart: t.store.addToCart,
  addedToCart: t.store.addedToCart,
  outOfStock: t.store.outOfStock,
  inStockLabel: t.store.inStockLabel,
  addToWishlist: t.wishlist.addLabel,
  removeFromWishlist: t.wishlist.removeLabel,
  fullPage: lang === 'he' ? 'לדף המוצר המלא' : 'View full product page',
};
---

<BaseLayout
  title={`${product.name} — ${shopStore.name}`}
  description={product.description || shopStore.tagline || `${product.name} at ${shopStore.name}`}
  image={ogImage}
  type="product"
  jsonLd={jsonLd}
  canonical={productUrl}
  noindex={isDemo || adLanding}
  isLoggedIn={isLoggedIn}
  storeMode={true}
  storeName={shopStore.name}
  storeSlug={shopStore.slug}
  storeLogo={shopStore.profileImage} storeDemo={isDemo}
  storeHeaderLogo={storeHeaderLogo(shopStore)}
  dataLayer={{ event: 'page_view', page_type: 'product', store_id: shopStore.id, store_name: shopStore.name, store_slug: storeSlug, currency: 'ILS', ecommerce: { currency: 'ILS', items: [{ item_id: product.id, item_name: product.name, price: pv.price, item_category: productCategoryPathStr }] } }}
  productPrice={pv.price}
  productCurrency="ILS"
>
  <script is:inline type="application/ld+json" set:html={jsonForScript(breadcrumbLd)} />
  <script is:inline type="application/json" id="pm-i18n" set:html={jsonForScript(pmI18n)} />

  {isOwner && (
    <OwnerStoreBar label={t.store.ownerPreview} backLabel={t.store.ownerPreviewBack} dashboardHref={dashboardHref} />
  )}

  <div class="product-detail-page"
       data-owner-store={isOwner ? shopStore.slug : undefined}
       data-owner-cannot-buy={isOwner ? t.store.ownerCannotBuy : undefined}
       data-store-slug={shopStore.slug}
       data-custom-host={shopStore.customDomain?.status === 'active' ? shopStore.customDomain.hostname : ''}
       data-platform-boundary={platformBoundary ? JSON.stringify(platformBoundary) : undefined}
       data-store-name={shopStore.name}
       data-images={JSON.stringify(images)}
       data-lang={lang}
       data-variants={product.variants?.length ? JSON.stringify(product.variants) : undefined}
       data-variant-stock={product.variantStock ? JSON.stringify(product.variantStock) : undefined}
       data-variant-images={product.variantImages ? JSON.stringify(product.variantImages) : undefined}
       data-selected-variants={Object.keys(renderedSelection).length ? JSON.stringify(renderedSelection) : undefined}
       data-ad-landing={adLanding ? '1' : undefined}>

    <!-- Back link + checkout link -->
    <nav class="container pt-4 pb-2 flex items-center justify-between" aria-label="breadcrumb">
      <a href={`/${shopStore.slug}`}
         data-astro-prefetch
         class="inline-flex items-center gap-1.5 text-sm transition-colors duration-150 hover:[color:var(--color-text)]"
         style="color:var(--color-muted);text-decoration:none">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
             class={lang === 'he' ? 'rotate-180' : ''}>
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        {lang === 'he' ? 'לחנות' : 'To store'}
      </a>
      <!-- Stays a real <a href> — with JS off, or when this product cannot be added at all (out of
           stock, no add-to-cart row rendered), "go to checkout" is exactly what it should still do.
           The script upgrades it to buy-now; see the "Nav 'לתשלום' = buy now" block. -->
      <a href={checkoutHref} id="nav-to-checkout-btn"
         class="inline-flex items-center gap-1.5 text-sm transition-colors duration-150 hover:[color:var(--color-text)]"
         style="color:var(--color-muted);text-decoration:none">
        {lang === 'he' ? 'לתשלום' : 'Checkout'}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
             class={lang === 'he' ? 'rotate-180' : ''}>
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </nav>

    {/* A <div>, not a second <main> carrying id=main-content — BaseLayout already wraps this slot in
      one, so this nested a second <main> carrying the SAME id, and the skip link then
      resolves to whichever one comes first rather than to this page content. */}
    <div class="container pt-2 pb-16">

      <!-- Product grid -->
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,440px)_1fr] gap-1.5 md:gap-14">

        <!-- Images column -->
        <div>
          <div id="main-img-wrap"
               class="relative overflow-hidden"
               data-skeleton={images[0] ? '' : undefined}
               style="aspect-ratio:1/1;border-radius:var(--radius)"
               role={images.length > 0 ? 'button' : undefined}
               tabindex={images.length > 0 ? '0' : undefined}
               aria-label={images.length > 0 ? t.product.clickToZoom : undefined}
               data-no-tooltip>
            {images.length > 0
              ? <div id="main-slides"
                     class="flex w-full h-full overflow-x-scroll overflow-y-hidden cursor-zoom-in [scroll-snap-type:x_mandatory] [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [touch-action:pan-x] [overscroll-behavior-inline:contain] [&::-webkit-scrollbar]:hidden">
                  {images.map((img, i) => (
                    <div class="relative shrink-0 w-full h-full [scroll-snap-align:start] [scroll-snap-stop:always]">
                      {/* Plain <img> (not <Image />) to carry a hi-DPI srcset — the main image
                          renders ~560px CSS wide on desktop, so a lone w_800 delivery is upscaled
                          → soft on retina. srcset+sizes keeps the seller's photo sharp at every DPR.
                          fetchpriority: the first slide is the LCP candidate, every other one is
                          something the shopper may never scroll to — so it is explicitly LOW,
                          whether it ends up fetched by the idle warm-up below or by a real swipe.
                          Left at default they queue alongside whatever the page is still loading. */}
                      <img id={i === 0 ? 'main-img' : undefined} src={cdnSrc(img, 800)}
                           srcset={cdnSrcSet(img, [600, 800, 1200, 1600]) || undefined}
                           sizes="(max-width: 767px) 94vw, 560px"
                           alt={i === 0 ? product.name : ''}
                           width={800} height={800}
                           class="w-full h-full object-cover block"
                           loading={i === 0 ? 'eager' : 'lazy'}
                           fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
                    </div>
                  ))}
                </div>
              : <div class="absolute inset-0 flex items-center justify-center" style="color:var(--color-border)" aria-hidden="true">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                  </svg>
                </div>
            }
            <!-- Hover preview, cross-fading OVER the carousel rather than scrolling it. The
                 carousel underneath never moves, so the chosen image is still exactly where it
                 was and "revert" is just this fading back out — see the script for why that
                 beats the scroll-and-scroll-back version it replaced.
                 No `src`: it is filled at hover time from the slide's own `currentSrc`, which is
                 already in cache (the script refuses to preview a slide that is not). That is
                 NOT the hand-rolled lazy-loading the image guard bans — nothing here defers a
                 real image, the slides carry their own eager/lazy src and preload normally.
                 `opacity-0` in the markup, never revealed by JS arriving: an overlay that starts
                 visible flashes over the product photo on every page load. -->
            {images.length > 1 && (
              <img id="preview-img" alt="" aria-hidden="true" loading="lazy" decoding="async"
                   class="absolute inset-0 w-full h-full object-cover opacity-0 pointer-events-none [transition:opacity_0.16s_ease-out]" />
            )}
            {isNew && <span class="img-badge img-badge--hero badge--new">{t.store.badgeNew}</span>}
            <Fragment set:html={saleBadgeHtml(pv, t.store.saleBadge, 'img-badge--hero')} />
          </div>

          {images.length > 1 && (
            <div id="thumb-strip" class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width:none;margin-top:0.625rem" role="list" aria-label={t.product.imageGallery}>
              {images.map((img, i) => (
                <button
                  type="button"
                  role="listitem"
                  data-img-index={String(i)}
                  class="thumb-btn flex-shrink-0 overflow-hidden p-0 border-2 cursor-pointer transition-all duration-150"
                  data-skeleton
                  style={`width:4rem;height:4rem;border-radius:var(--radius);border-color:${i === 0 ? 'var(--color-text)' : 'transparent'};opacity:${i === 0 ? 1 : 0.55}`}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-label={`${product.name} ${i + 1}`}
                  data-no-tooltip
                >
                  <Image src={cdnSrc(img, 128)} alt="" width={64} height={64}
                         style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Info column -->
        <div class="flex flex-col gap-4 md:gap-5">

          <!-- Name + price — dir=auto on the wrapper so the price aligns to the same
               side as the (per-language) product name instead of staying pinned right. -->
          <div class="flex flex-col gap-2" dir="auto">
            <ProductDemoBadge demo={isDemo} variant="inline" />
            <h1 id="product-name-heading" style="font-size:1.5rem;font-weight:700;line-height:1.25;color:var(--color-text);margin:0">{product.name}</h1>
            {/* Between the name and the price, which is where a shopper looks for it — and a link
                rather than a decoration, because the one thing anyone wants from a star row is to
                read what is behind it. Renders nothing at all when there are no reviews. */}
            <StarRating value={ratingAvg} count={ratingAggregate.count} size="lg" showValue showCount linkToReviews />
            <p style="font-size:1.25rem;font-weight:800;line-height:1;margin:0" class={pv.isDiscounted ? undefined : '[color:var(--color-accent)]'}>
              <Fragment set:html={priceHtml(pv, { saleLabel: t.store.saleWas })} />
            </p>
            <StoreSaleBanner sale={shopStore.sale} dir="auto" compact product={product} scopeLabel={saleScopeLabel} />
          </div>

          <hr style="border:none;border-top:1px solid var(--color-border);margin:0" />

          <!-- Variants -->
          {(product.variants?.length ?? 0) > 0 && (
            <div class="flex flex-col gap-3 md:gap-5" id="variant-selectors">
              {product.variants!.map((v) => {
                const isColor = isColorVariant(v.name);
                // A dimension with a single option needs no real choice — treat
                // it as already selected instead of making the buyer tap it.
                const isSingleOption = v.options.length === 1;
                // …and so is whatever the landing URL named (renderedSelection folds both in).
                const rendered = renderedSelection[v.name];
                return (
                  <div class="flex flex-col gap-2 variant-group" data-variant-group={v.name}>
                    <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--color-muted);margin:0">
                      {v.name}
                    </p>
                    <div class="flex flex-wrap gap-2" role="group" aria-label={v.name}>
                      {v.options.map((opt) => {
                        const { display, hex } = resolveVariantColor(opt);
                        const isActive = isSingleOption || rendered === opt;
                        const activeBorder = hex ?? 'var(--color-primary)';
                        const activeBg = hex ? hex + '18' : 'transparent';
                        // Availability for this option combined with the default selection of
                        // every other dimension — client JS recomputes this per-click as the
                        // buyer changes other dimensions (e.g. picking a Size changes which
                        // Colors are in stock). What the URL selected outranks the default here,
                        // for the same reason: an option's availability depends on the OTHER
                        // dimensions, so a landing that fixed them must be what this is measured
                        // against or the first paint strikes through options that are in stock.
                        const optionCombo = { ...defaultVariantSelection, ...renderedSelection, [v.name]: opt };
                        const optionStock = (product.variants?.length && product.variantStock)
                          ? (product.variantStock[comboKey(optionCombo)] ?? product.stock)
                          : product.stock;
                        const isAvailable = optionStock > 0;
                        return (
                          <button type="button"
                                  class="variant-opt"
                                  data-variant-name={v.name}
                                  data-variant-value={opt}
                                  data-color-hex={hex ?? undefined}
                                  aria-pressed={isActive ? 'true' : 'false'}
                                  disabled={!isAvailable}
                                  aria-disabled={!isAvailable ? 'true' : undefined}
                                  style={[
                                    'display:inline-flex;align-items:center;gap:0.4rem',
                                    `border:1.5px solid ${isActive ? activeBorder : 'var(--color-border)'}`,
                                    'border-radius:var(--radius)',
                                    'padding:0.45rem 0.9rem',
                                    `font-size:0.875rem;font-weight:${isActive ? 600 : 500}`,
                                    `cursor:${isAvailable ? 'pointer' : 'default'}`,
                                    `background:${isActive ? activeBg : 'transparent'}`,
                                    'color:var(--color-text)',
                                    `opacity:${isAvailable ? '1' : '0.4'}`,
                                    `text-decoration:${isAvailable ? 'none' : 'line-through'}`,
                                    'transition:all 0.15s',
                                    'white-space:nowrap',
                                  ].join(';')}>
                            {isColor && hex && (
                              <span aria-hidden="true"
                                    style={`width:14px;height:14px;border-radius:3px;background:${hex};border:1px solid rgba(0,0,0,0.12);flex-shrink:0;display:inline-block`}></span>
                            )}
                            {display}
                          </button>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          <!-- Stock status for the selected combination — updated live by variant-selector clicks -->
          <p id="stock-status-note" class="flex items-center gap-1.5 text-sm"
             style={`margin:0;color:${initialStatusColor};font-weight:${initialStockState === 'in' ? 500 : 600}`}>
            <span id="stock-status-dot" aria-hidden="true"
                  style={`width:7px;height:7px;border-radius:50%;background:var(--color-success);flex-shrink:0;display:${initialStockState === 'in' ? 'inline-block' : 'none'}`}></span>
            <svg id="stock-status-warn" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
                 style={`display:${initialStockState === 'in' ? 'none' : 'block'}`}>
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span id="stock-status-text">{initialStatusText}</span>
          </p>

          <!-- Cart actions — the wishlist button stays available even when the product is
               out of stock; only the qty+add-to-cart row is gated behind stock.
               Top-aligned (no mt-auto): pinning the CTA to the column's bottom made
               it track the image column's height — extra thumbnails or a variant-less
               product opened a dead gap between the title and the buttons. -->
          {/* No "out of stock" chip here: the live stock line right above (#stock-status-text)
              already says exactly that, in the danger colour and with its own warning icon, and
              two identical phrases stacked on top of each other is not emphasis (user,
              2026-08-01). Out of stock therefore renders no cart row at all — the wishlist
              button below stays, so the column is never empty. */}
          <div class="flex flex-col gap-3">
            {product.stock <= 0
              ? null
              : (
                <div id="product-cta-row" class="flex items-center gap-3">
                  <div dir="ltr" class="qty-stepper flex items-center flex-shrink-0 overflow-hidden"
                       style="border:1px solid var(--color-border);border-radius:var(--radius);height:48px">
                    <button type="button" class="qty-dec flex items-center justify-center transition-colors duration-100 hover:bg-[var(--color-surface)] active:scale-90 disabled:opacity-30 w-10 max-[420px]:w-8 h-full flex-shrink-0"
                            style="color:var(--color-muted);background:none;border:none;cursor:pointer"
                            aria-label={t.cart.qtyDecrease} disabled>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </button>
                    <span class="qty-val text-sm font-semibold text-center select-none min-w-8 max-[420px]:min-w-6 flex-shrink-0"
                          style="color:var(--color-text)"
                          aria-live="polite" aria-atomic="true">1</span>
                    <button type="button" class="qty-inc flex items-center justify-center transition-colors duration-100 hover:bg-[var(--color-surface)] active:scale-90 w-10 max-[420px]:w-8 h-full flex-shrink-0"
                            style="color:var(--color-muted);background:none;border:none;cursor:pointer"
                            aria-label={t.cart.qtyIncrease}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </button>
                  </div>

                  <!-- Add to cart — fills the row (shrinks back once the
                       "to checkout" button appears next to it). -->
                  <button type="button" id="add-to-cart-btn"
                          class="btn flex-auto"
                          style="white-space:nowrap;height:48px;font-size:0.9375rem;font-weight:600"
                          data-slug={product.slug}
                          data-product-id={product.id}
                          data-name={product.name}
                          data-price={String(pv.price)}
                          data-base-price={pv.isDiscounted ? String(pv.basePrice) : undefined}
                          data-image={images[0] ?? ''}
                          data-stock={String(product.stock)}
                          data-category={productCategoryPathStr}
                          data-label-added={t.store.addedToCart}>
                    <span class="btn-label">{t.store.addToCart}</span>
                  </button>

                  <a href={checkoutHref} id="to-checkout-btn" class="btn btn--accent flex-shrink-0"
                     style="display:none;height:48px;white-space:nowrap;align-items:center;justify-content:center;font-size:0.9375rem;font-weight:600">
                    {t.store.toCheckout}
                  </a>
                </div>
              )
            }

                <!-- Wishlist + share — the two things you can do with a product without buying it,
                     so they share a row and the same quiet text treatment. Both stay available
                     when the product is out of stock. -->
                <div class="flex items-center gap-5 self-start">
                <button type="button" id="wishlist-btn"
                        class="flex items-center gap-2 text-sm font-medium"
                        style="color:var(--color-muted);background:none;border:none;cursor:pointer;padding:0.25rem 0;visibility:hidden"
                        data-wishlist-slug={product.slug}
                        data-wishlist-name={product.name}
                        data-wishlist-price={String(pv.price)}
                        data-wishlist-image={images[0] ? cdnSrc(images[0]) : ''}
                        data-wishlist-store-slug={shopStore.slug}
                        data-wishlist-store-name={shopStore.name}
                        data-wishlist-stock={String(product.stock)}
                        data-wishlisted="false"
                        aria-pressed="false"
                        aria-label={t.wishlist.addLabel}>
                  <svg id="wishlist-heart" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                  <span id="wishlist-label">{t.wishlist.addLabel}</span>
                </button>
                <script is:inline>
                  (function () {
                    var btn = document.getElementById('wishlist-btn');
                    if (!btn) return;
                    try {
                      var slug = btn.dataset.wishlistSlug;
                      if (slug) {
                        var list = JSON.parse(localStorage.getItem('wishlist_v1') || '[]');
                        if (Array.isArray(list) && list.some(function (i) { return i && i.slug === slug; })) {
                          btn.dataset.wishlisted = 'true';
                          btn.setAttribute('aria-pressed', 'true');
                          var heart = document.getElementById('wishlist-heart');
                          if (heart) { heart.style.fill = '#e53e3e'; heart.style.stroke = '#e53e3e'; }
                          btn.style.color = '#e53e3e';
                        }
                      }
                    } catch (_) {}
                    btn.style.transition = 'color 0.15s, opacity 0.15s';
                    btn.style.visibility = 'visible';
                  })();
                </script>
                <ShareMenu
                  url={shareUrl}
                  title={`${product.name} · ${shopStore.name}`}
                  lang={lang}
                  contentType="product"
                  storeId={shopStore.id}
                  itemId={product.id}
                  buttonClass="flex items-center gap-2 text-sm font-medium transition-colors duration-150 hover:text-[color:var(--color-text)]"
                  buttonStyle="color:var(--color-muted);background:none;border:none;cursor:pointer;padding:0.25rem 0"
                />
                </div>
          </div>
        </div>
      </div>

      <!-- Details zone: full-width description / specs / category.
           Tags are search/discovery metadata only (still emitted in the Product
           JSON-LD `keywords`) — deliberately not shown to shoppers. -->
      {(product.description || (product.specs?.length ?? 0) > 0 || productCategoryName) && (
        <div class="details-card"
             style="margin-top:2.5rem;border:1.5px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface);padding:1.75rem;display:flex;flex-direction:column;gap:1.5rem">

          {product.description && (
            <div style="min-width:0">
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-muted);margin:0 0 0.5rem;letter-spacing:0.06em">
                {lang === 'he' ? 'תיאור המוצר' : 'Description'}
              </p>
              {/* `whitespace-pre-line`: the description is a plain textarea, so a seller who
                  types paragraphs gets `\n\n` in the field. ProductQuickView has always
                  honoured that and this page did not — the same value rendered as paragraphs
                  in the modal and as one run-on block on the product page itself, which is the
                  more important of the two. Same renderer-drift class as
                  memory `project_client_renderer_i18n_drift`. */}
              <p dir="auto" id="product-desc" class="text-base leading-relaxed whitespace-pre-line" style="color:var(--color-muted);text-align:justify;overflow-wrap:break-word">{product.description}</p>
              {noReturnNotice && (
                <p class="text-[0.85rem] mt-3" style="color:var(--color-muted)">{noReturnNotice}</p>
              )}
            </div>
          )}

          {(product.specs?.length ?? 0) > 0 && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-muted);margin:0 0 0.5rem;letter-spacing:0.06em">
                {t.product.specsTitle}
              </p>
              <table style="width:100%;max-width:420px;border-collapse:collapse;font-size:0.85rem" aria-label={t.product.specsTitle}>
                <tbody>
                  {product.specs!.map((s) => (
                    <tr style="border-bottom:1px solid var(--color-border)">
                      <td style="padding:0.4rem 0;padding-inline-start:0.75rem;padding-inline-end:3rem;color:var(--color-muted);white-space:nowrap;font-weight:500">{s.label}</td>
                      <td dir="auto" style="padding:0.4rem 0;color:var(--color-text);font-weight:400;text-align:end">{s.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {productCategoryName && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-muted);margin:0 0 0.5rem;letter-spacing:0.06em">
                {t.product.categoryLabel ?? (lang === 'he' ? 'קטגוריה' : 'Category')}
              </p>
              <a href={`/${storeSlug}?category=${encodeURIComponent(product.categoryId!)}`}
                 class="hover:bg-[var(--color-bg)] transition-colors duration-150"
                 style="display:inline-flex;align-items:center;gap:0.35rem;border:1px solid var(--color-border);border-radius:9999px;padding:0.25rem 0.75rem;font-size:0.8rem;color:var(--color-text);text-decoration:none">
                {productCategoryName}
              </a>
            </div>
          )}

        </div>
      )}

      <!-- Ask seller about product — subtle link, not shown to store owner -->
      {userId !== shopStore.sellerId && (
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--color-border);display:flex;align-items:center;gap:0.5rem">
          <div style="position:relative;display:inline-block">
            <button
              type="button"
              id="ask-product-btn"
              data-store-id={shopStore.id}
              data-seller-id={shopStore.sellerId}
              data-store-name={shopStore.name}
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-store-slug={storeSlug}
              data-is-logged-in={String(isLoggedIn)}
              data-login-url={`/seller/login?next=/${storeSlug}/${productSlug}`}
              data-str-login-hint={t.messages.loginToMessage}
              data-str-login-hint-link={t.messages.loginToMessageLink}
              style="background:none;border:none;cursor:pointer;font-size:0.82rem;color:var(--color-muted);display:inline-flex;align-items:center;gap:0.35rem;padding:0.2rem 0;text-decoration:underline;text-underline-offset:3px;transition:color 0.15s"
              onmouseover="this.style.color='var(--color-text)'"
              onmouseout="this.style.color='var(--color-muted)'"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
              {t.messages.askAboutProduct}
            </button>
          </div>
        </div>
      )}

      <!--
        Reviews.

        Above the related strip on purpose: what other buyers said about THIS product outranks four
        other products from the same shop, and a shopper who has scrolled this far is deciding, not
        browsing.

        The whole section renders only when there is something in it OR the visitor may write one.
        An empty "0 reviews · be the first" block on every product of a new catalogue is a page
        announcing what it does not have, on every product page, forever — and it is the exact
        pattern the standing rule against prose above a screen exists to stop (memory
        `feedback_no_standing_screen_prose`).
      -->
      {(ratingAggregate.count > 0 || canReview) && (
        <section id={REVIEWS_SECTION_ANCHOR} style="margin-top:2rem;padding-top:2rem;border-top:1px solid var(--color-border);scroll-margin-top:5rem" aria-labelledby="reviews-heading">
          <div class="flex flex-wrap items-baseline gap-x-2" style="margin:0 0 0.875rem">
            <p id="reviews-heading" style="font-size:0.875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-muted);margin:0">
              {t.reviews.title}
            </p>
            {/* A showcase store's ratings are written by the seeder, not by buyers, and the page
                has to say so where they are READ — the "מוצר לדוגמה" chip sits on the photograph
                and a person scrolling to the reviews has left it behind. Same mark and same
                wording as every other demo disclosure on the site (`lib/demo-badge.ts`), because a
                shopper should learn one symbol rather than four.

                Bounded, not decorative: these pages are `noindex` and `/api/checkout` refuses a
                demo store outright, so nobody can act on an invented review — but "you could not
                have bought it anyway" is not a reason to let it read as somebody's real opinion. */}
            {isDemo && ratingAggregate.count > 0 && (
              <Fragment set:html={demoProductBadgeHtml(t.demo.reviewsBadge, 'inline')} />
            )}
          </div>

          {ratingAggregate.count > 0 && (
            <div class="flex flex-wrap items-center gap-x-8 gap-y-4" style="margin-bottom:1.25rem">
              <div class="flex flex-col gap-1" dir="auto">
                <span style="font-size:2rem;font-weight:800;line-height:1;color:var(--color-text)">{ratingDisplay(ratingAvg!)}</span>
                <StarRating value={ratingAvg} count={ratingAggregate.count} size="md" showCount />
                {/* Said ONCE, about the whole set, and it used to sit on every single row (owner,
                    2026-08-17: "יש תגובה שזה לא יופיע שם? אז למה צריך את זה?"). He is right and it
                    is the standing rule against furniture: a label that is true of every row is not
                    information, it is decoration repeated N times. As a claim about ALL of them it
                    is the opposite — the strongest thing this page can say, and one line long. */}
                <span style="font-size:0.75rem;color:var(--color-success);font-weight:600">{t.reviews.allVerified}</span>
              </div>
              {/* The distribution, five rows always — a histogram that hides its empty rows
                  re-scales itself on every new review and stops being comparable. */}
              <ul class="flex flex-col" style="gap:0.2rem;margin:0;padding:0;list-style:none;min-width:11rem;flex:1 1 11rem;max-width:20rem"
                  aria-label={t.reviews.distribution}>
                {ratingBars.map((bar) => (
                  <li class="flex items-center" style="gap:0.5rem;font-size:0.75rem;color:var(--color-muted)">
                    {/* The number and ONE small star — never the `★` glyph, which is a font's
                        drawing of a star and will not match the SVG two lines above it. */}
                    <span class="inline-flex items-center" style="width:2.1rem;gap:0.2rem;justify-content:flex-end;flex:0 0 auto">
                      {bar.rating}
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                           style="display:block;width:10px;height:10px;max-width:none;color:var(--color-rating-to)"><path d={STAR_PATH}/></svg>
                    </span>
                    <span style="flex:1 1 auto;height:6px;border-radius:9999px;background:var(--color-bg);overflow:hidden">
                      <span style={`display:block;height:100%;border-radius:9999px;background:linear-gradient(90deg,var(--color-rating-from),var(--color-rating-to));width:${ratingAggregate.count ? Math.round((bar.count / ratingAggregate.count) * 100) : 0}%`}></span>
                    </span>
                    <span style="width:1.8rem;flex:0 0 auto">{bar.count}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {canReview && (
            <div style="border:1px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface);padding:1rem;margin-bottom:1.25rem">
              <ReviewForm productId={product.id} orderId={reviewableOrderId!} />
            </div>
          )}

          <ul class="flex flex-col" style="gap:1rem;margin:0;padding:0;list-style:none">
            {productReviews.map((r, rowIndex) => (
              <li class="flex" style="gap:0.7rem;border-top:1px solid var(--color-border);padding-top:1rem">
                {/* The reviewer's mark, in the ELEVEN hues of the homepage's invite cards (owner,
                    2026-08-17 — he pointed at those specifically). Not `MARK_HUES`, which is the
                    five-colour palette every store's generated identity mark is built from:
                    `placeholder-art.ts` already argues that those two lists are not
                    interchangeable, and a person is not a store.

                    **The PRODUCT picks where the sequence starts, and the ROW walks it from there**
                    — so every product page gets its own order (owner asked for exactly that) while
                    no two adjacent rows can ever land on the same colour. Hashing each review
                    independently gave the first property and not the second: two neighbours
                    collided about one time in eleven, which on a page of fourteen reviews is most
                    pages. The step of 1 through eleven hues also inherits the palette's own
                    ordering, which is built so no two ADJACENT entries share a colour family. */}
                <span aria-hidden="true" class="flex items-center justify-center"
                      style={`flex:0 0 auto;width:34px;height:34px;border-radius:50%;color:#fff;font-size:0.85rem;font-weight:700;line-height:1;background:${soloHueGradient(reviewHueStart + rowIndex)}`}>
                  {reviewerInitial(r.reviewerName || t.reviews.anonymous)}
                </span>
                <div class="min-w-0" style="flex:1 1 auto">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1" style="margin-bottom:0.2rem">
                    <span dir="auto" style="font-size:0.82rem;font-weight:600;color:var(--color-text)">{r.reviewerName || t.reviews.anonymous}</span>
                    <time datetime={r.createdAt.slice(0, 10)} style="font-size:0.72rem;color:var(--color-muted);margin-inline-start:auto">
                      {reviewDateFormat.format(new Date(r.createdAt))}
                    </time>
                  </div>
                  <StarRating value={r.rating} count={1} size="sm" standalone />
                  {r.body && (
                    <p dir="auto" class="whitespace-pre-line" style="margin:0.3rem 0 0;font-size:0.9rem;line-height:1.6;color:var(--color-muted);overflow-wrap:break-word">{r.body}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>

          {/* A SENTENCE, not "8 / 14". The bare fraction was what this said until it was looked at
              in a browser (2026-08-17) — it reads as nothing in either direction, and in RTL the
              two numbers swap sides so it reads as the wrong way round. */}
          {ratingAggregate.count > productReviews.length && (
            <p style="margin:0.875rem 0 0;font-size:0.78rem;color:var(--color-muted)">
              {t.reviews.showing.replace('{n}', String(productReviews.length)).replace('{total}', String(ratingAggregate.count))}
            </p>
          )}
        </section>
      )}

      <!-- Related products — one row per group (lib/related-products.ts decides which groups
           exist and what goes in them). Up to two: the product's own shelf, then the rest of
           the shop. The heading NAMES the connection rather than leaving the shopper to look
           for one, which is half of what was wrong with the old single unlabelled row. -->
      {relatedGroups.map((group, gi) => (
        <section
          style={gi === 0
            ? 'margin-top:2rem;padding-top:2rem;border-top:1px solid var(--color-border)'
            /* No second rule between the two rows — they are one block about this product, and a
               divider between them would read as two unrelated sections of the page. */
            : 'margin-top:1.5rem'}
          aria-labelledby={`related-heading-${gi}`}>
          <p id={`related-heading-${gi}`} style="font-size:0.875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-muted);margin:0 0 0.875rem">
            {group.kind === 'category'
              ? `${t.product.moreIn}${group.categoryName}`
              : `${t.product.moreFrom}${shopStore.name}`}
          </p>
          <!-- overflow-x:auto forces overflow-y to compute to `auto`, so the box clips
               the cards' hover shadow + 2px lift on every side (top/bottom and the
               first/last card's inline edges). A minimal clearance on all four sides
               gives the (snug) shadow just enough room; the equal negative margin
               cancels it out exactly, so the strip's height/position is unchanged
               from before the shadow existed. -->
          <div style="display:flex;gap:0.625rem;overflow-x:auto;scrollbar-width:none;padding:0.375rem 0.6rem 0.5rem;margin:-0.375rem -0.6rem -0.5rem">
            {group.products.map((p) => {
              const pImgs = p.images ?? [];
              return (
                <div class="related-card"
                     data-slug={p.slug}
                     style="flex:0 0 auto;width:170px;border-radius:var(--radius);overflow:hidden;background:var(--color-surface);cursor:pointer">
                  <a href={`/${shopStore.slug}/${p.slug}`}
                     class="related-card-trigger"
                     style="display:block;text-decoration:none;color:inherit">
                    <div style="width:170px;height:150px;position:relative;overflow:hidden;background:var(--color-surface);border-bottom:1px solid var(--color-border)">
                      {pImgs[0]
                        ? <Image src={cdnSrc(pImgs[0], 340)} alt={p.name} width={170} height={150}
                                 style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 0.3s ease"
                                 loading="lazy" />
                        : <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--color-border)" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                              <line x1="12" y1="22.08" x2="12" y2="12"/>
                            </svg>
                          </div>
                      }
                      {/* Same rule as the store page's own grid: the card carries it, not only the
                          page. These cards also open the modal in place, so the badge on the card
                          is what a shopper sees before deciding to. */}
                      <ProductDemoBadge demo={isDemo} />
                    </div>
                    <div dir="auto" style="padding:0.5rem 0.6rem 0.6rem">
                      <p style="font-size:0.75rem;font-weight:600;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--color-text)">{p.name}</p>
                      <Fragment set:html={cardStarRowHtml({ count: p.reviewCount ?? 0, sum: p.reviewRatingSum ?? 0 }, t.reviews.starsAria)} />
                      <p style="font-size:0.75rem;font-weight:700;margin:0.2rem 0 0;color:var(--color-accent)"><Fragment set:html={priceHtml(resolvePrice(p, shopStore.sale), { saleLabel: t.store.saleWas })} /></p>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        </section>
      ))}

      <!-- Mobile-only sticky duplicate of the cart actions — fades in once the
           inline row above scrolls out of view, so "add to cart" stays reachable
           without duplicating IDs or the add-to-cart logic itself. -->
      {product.stock > 0 && (
        <div id="sticky-cart-bar" class="sticky-bottom-bar">
          <div id="sticky-mini-summary">
            {/* A REAL `src`, not a `data-src` the script fills in later. The deferred version
                (removed 2026-08-18) waited for the product NAME to scroll out of view before it
                started fetching — i.e. the same instant the bar reveals the thumbnail — so the
                shopper watched a 44px square shimmer for a photo the page had had for minutes.
                It could not even ride the main image's cache: `cdnSrc(…, 96)` is a different
                derivative from anything else on this page, so it was always a cold request.
                It was also the hand-rolled lazy-loading lib/cdn.ts bans outright.
                `cdnThumb` (square crop, 2x the 44px box) because this IS a fixed-size cell, and
                `fetchpriority="low"` so a 3KB thumbnail never queues ahead of the LCP hero — the
                fetch starts with the page and is long finished by the time the bar appears. */}
            {images[0] && (
              <span id="sticky-mini-img-wrap">
                <img id="sticky-mini-img" src={cdnThumb(images[0], 88, 88)} alt="" width="44" height="44"
                     loading="lazy" fetchpriority="low" decoding="async" />
              </span>
            )}
            <span id="sticky-mini-name" dir="auto">{product.name}</span>
            <span id="sticky-mini-price"><Fragment set:html={priceHtml(pv, { saleLabel: t.store.saleWas })} /></span>
          </div>
          <button type="button" id="sticky-add-to-cart-btn" class="btn flex-shrink-0"
                  style="white-space:nowrap;height:44px;font-size:0.9375rem;font-weight:600">
            <span class="btn-label">{t.store.addToCart}</span>
          </button>

          <a href={checkoutHref} id="sticky-to-checkout-btn" class="btn btn--accent flex-shrink-0"
             style="display:none;height:44px;white-space:nowrap;align-items:center;justify-content:center;font-size:0.9375rem;font-weight:600">
            {t.store.toCheckout}
          </a>
        </div>
      )}
    </div>

    <!-- Site-wide footer (with the "open a store" link) is rendered once by
         BaseLayout — no separate store footer here. -->

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox" hidden aria-modal="true" role="dialog" aria-label={t.product.imageGallery}>
      <div class="lightbox__backdrop" id="lightbox-backdrop"></div>
      <div class="lightbox__panel" data-lb-frame data-lb-label={t.product.loadingImage}>
        <button class="lightbox__close" id="lightbox-close" aria-label={t.product.imageClose}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        <button class="lightbox__arrow lightbox__arrow--prev" id="lightbox-prev" aria-label={t.product.imagePrev}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <img class="lightbox__img transition-[filter,scale] duration-300 ease-out motion-reduce:transition-none" id="lightbox-img" src="" alt={product.name} loading="eager" decoding="async" />
        <button class="lightbox__arrow lightbox__arrow--next" id="lightbox-next" aria-label={t.product.imageNext}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
        <div class="lightbox__counter" id="lightbox-counter"></div>
      </div>
    </div>

  </div>
</BaseLayout>

{/* The header search's product index used to be serialised here too — see the note
    on the store page. It now comes from /api/store-search-index. */}

<script>
  import { addItem, getCartQty } from '../../lib/cart.js';
  import { initImageSkeletons } from '../../lib/img-skeleton.js';
  import { isWishlisted, toggleWishlist } from '../../lib/wishlist.js';
  import { spawnRipple } from '../../lib/ripple.js';
  import { trackViewContent, trackAddToCart } from '../../lib/tracking.js';
  import { comboKey } from '../../lib/variant-combo.js';
  import { adItemId } from '../../lib/ad-item-id.js';
  import { arrowStep } from '../../lib/arrow-step.js';
  import { escapeHtml as escHtml } from '../../lib/html-escape.js';
  import { isColorVariant } from '../../lib/color-variants.js';
  import { initReadMore } from '../../lib/read-more.js';
  import { saveLastStore } from '../../lib/last-store.js';
  import { cdnSrc } from '../../lib/cdn.js';
  import { setLightboxImage, resetLightboxImage, lightboxWidth, warmLightboxImage, neighbourIndexes } from '../../lib/lightbox-image.js';
  import { spawnHeartBurst } from '../../lib/burst.js';
  import { recordStoreVisit } from '../../lib/recent-stores.js';
  import { initCustomDomainLinks, initAdLandingLinks, readPlatformBoundary, refreshCheckoutCartFragment } from '../../lib/custom-domain-links.js';
  import { initReviewForms } from '../../scripts/review-form.js';

  // No-op on every product page that does not render a form — which is most of them, since the
  // form only appears for a buyer with an unreviewed purchase of this exact product.
  initReviewForms();

  const page = document.querySelector<HTMLElement>('.product-detail-page');
  const storeSlug = page?.dataset.storeSlug ?? '';
  const storeName = page?.dataset.storeName ?? '';

  // Clean in-store URLs when served on the store's own verified domain, and — the load-bearing
  // half — every PLATFORM-owned link (cart, checkout, login, buyer area) sent to the platform
  // origin, carrying the basket and the visitor's identity with it (custom-domain-links.ts).
  const platformBoundary = readPlatformBoundary(page);
  initCustomDomainLinks(storeSlug, page?.dataset.customHost ?? '', platformBoundary);
  // The crossing that goes the other way: an ad landing is on the platform, and the 301 off it
  // carries no handoff, so the click after the landing would drop the ad attribution.
  initAdLandingLinks(storeSlug, page?.dataset.adLanding === '1');

  if (storeSlug) {
    saveLastStore({ slug: storeSlug, name: storeName, url: location.pathname + location.search });
  }
  const images: string[] = JSON.parse(page?.dataset.images ?? '[]');
  const pageLang = page?.dataset.lang ?? 'he';
  const pageVariants: Array<{ name: string; options: string[] }> = JSON.parse(page?.dataset.variants ?? '[]');
  const pageVariantStock: Record<string, number> = JSON.parse(page?.dataset.variantStock ?? '{}');
  const pageVariantImages: Record<string, string> = JSON.parse(page?.dataset.variantImages ?? '{}');

  // What is selected in this first paint — see the "Variant selector" section below, which owns
  // the rule; parsed here because ViewContent fires before it and has to name the same item.
  const selectedVariants: Record<string, string> = JSON.parse(page?.dataset.selectedVariants ?? '{}');
  // A selection covering EVERY dimension is one feed row; anything less is a row that does not
  // exist, so it is reported as no combo at all rather than as an id nothing can join on.
  const landedSelection = pageVariants.length && pageVariants.every((v) => selectedVariants[v.name])
    ? selectedVariants
    : undefined;

  // Raw stock for a given variant selection — falls back to the product's overall
  // stock when there are no variants, or the seller hasn't set per-combination
  // numbers yet. This is the true total; it's what gets passed to addItem() as
  // product.stock (addItem does its own prev-qty-in-cart math against it, so
  // passing an already-net value here would double-subtract).
  function effectiveStockFor(selection: Record<string, string>): number {
    const btn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
    const total = Math.max(0, parseInt(btn?.dataset.stock ?? '0', 10) || 0);
    if (!pageVariants.length || !Object.keys(pageVariantStock).length) return total;
    const key = comboKey(selection);
    return key in pageVariantStock ? pageVariantStock[key] : total;
  }

  // What's actually still addable for this combo — nets out whatever quantity
  // already sits in the cart (added here, from the product grid, or a quick-view
  // elsewhere). Used for the qty-stepper ceiling and button disabled state only;
  // never passed to addItem() as product.stock (see effectiveStockFor above).
  function remainingFor(selection: Record<string, string>): number {
    const btn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
    const slug = btn?.dataset.slug ?? '';
    const variantsArg = Object.keys(selection).length ? selection : undefined;
    return Math.max(0, effectiveStockFor(selection) - getCartQty(storeSlug, slug, variantsArg));
  }

  // ── ViewContent — fire once on product page load ───────────────
  {
    const addBtnEl = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
    if (addBtnEl?.dataset.slug) {
      trackViewContent({
        // The catalog id, never the slug: a slug is unique per store, not platform-wide, and the
        // Merchant feed keys on this uuid (lib/ad-item-id.ts). Usually no combo is chosen on load,
        // and then this is the bare product id — but a variant feed row lands here naming its own
        // combo (variant-landing.ts), and that row is what the shopper actually saw advertised.
        // Reporting the parent id for it would put the view on an item that has NO feed row, which
        // is the same join failure ad-item-id.ts exists to prevent, arrived at from this side.
        id: adItemId(addBtnEl.dataset.productId ?? '', landedSelection),
        name: addBtnEl.dataset.name ?? '',
        price: Number(addBtnEl.dataset.price ?? 0),
        category: addBtnEl.dataset.category,
      });
    }
  }

  // ── Recently visited stores (CURRENT_TASK.md → סשן ב׳ 1+3): landing on any
  // product counts as visiting its store — records the store into the
  // per-browser cookie the homepage's "בוקרו לאחרונה" shelf reads (SSR). Only
  // fires the account-sync event when the cookie actually changed (a repeat
  // visit to the store already at the front is a no-op).
  if (storeSlug && recordStoreVisit(storeSlug)) {
    window.dispatchEvent(new CustomEvent('recent-stores:change'));
  }

  // ── Variant selector ───────────────────────────────────────────
  // No dimension is pre-selected — the buyer must actively tap a size/color/etc.
  // before add-to-cart will proceed (see flagMissingVariants below) — except a
  // dimension with only one option, which has no real choice to make, and whatever
  // an ad landing named in its URL. Both are already the server-rendered active
  // swatch: `selectedVariants` (parsed at the top of this module, because ViewContent
  // fires before this point and has to name the same item) reads the selection the
  // SERVER computed rather than recomputing it, so the two can't drift into a page
  // whose highlight and whose add-to-cart disagree about what is selected.

  // Plain scrollIntoView doesn't know the mobile sticky add-to-cart bar (or the
  // fixed site header) visually covers part of the viewport — an element can
  // count as "in view" per the browser while actually sitting behind one of
  // them. Scroll against their real edges instead of the raw viewport bounds.
  function scrollGroupIntoView(el: HTMLElement): void {
    const rect = el.getBoundingClientRect();
    const stickyBar = document.querySelector<HTMLElement>('.sticky-bottom-bar.is-visible');
    const bottomLimit = stickyBar ? stickyBar.getBoundingClientRect().top : window.innerHeight;
    const headerEl = document.querySelector<HTMLElement>('header');
    const topLimit = headerEl ? headerEl.getBoundingClientRect().bottom : 0;
    if (rect.bottom > bottomLimit) {
      window.scrollBy({ top: rect.bottom - bottomLimit + 16, behavior: 'smooth' });
    } else if (rect.top < topLimit) {
      window.scrollBy({ top: rect.top - topLimit - 16, behavior: 'smooth' });
    }
  }

  // Missing-selection feedback: a subtle shake + temporary ring on whichever
  // dimension(s) haven't been chosen yet, instead of a blocking modal/alert —
  // called right before add-to-cart actually adds the item.
  function flagMissingVariants(): boolean {
    let firstMissing: HTMLElement | null = null;
    pageVariants.forEach((v) => {
      if (selectedVariants[v.name]) return;
      const group = document.querySelector<HTMLElement>(`.variant-group[data-variant-group="${CSS.escape(v.name)}"]`);
      if (!group) return;
      group.classList.remove('variant-group--invalid');
      void group.offsetWidth;
      group.classList.add('variant-group--invalid');
      setTimeout(() => group.classList.remove('variant-group--invalid'), 650);
      if (!firstMissing) firstMissing = group;
    });
    if (firstMissing) scrollGroupIntoView(firstMissing);
    return !!firstMissing;
  }

  // Disables (rather than hides) any option whose combo — combined with the buyer's
  // current picks for every other dimension — is out of stock, so the set of choices
  // stays visible and only recomputes as other dimensions change.
  function updateVariantAvailability(): void {
    document.querySelectorAll<HTMLButtonElement>('.variant-opt').forEach((b) => {
      const bName = b.dataset.variantName ?? '';
      const bValue = b.dataset.variantValue ?? '';
      const available = remainingFor({ ...selectedVariants, [bName]: bValue }) > 0;
      b.disabled = !available;
      b.setAttribute('aria-disabled', String(!available));
      b.style.opacity = available ? '1' : '0.4';
      b.style.cursor = available ? 'pointer' : 'default';
      b.style.textDecoration = available ? 'none' : 'line-through';
    });
  }
  updateVariantAvailability();

  document.querySelectorAll<HTMLButtonElement>('.variant-opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const vName = btn.dataset.variantName ?? '';
      const vValue = btn.dataset.variantValue ?? '';
      selectedVariants[vName] = vValue;
      document.querySelector<HTMLElement>(`.variant-group[data-variant-group="${CSS.escape(vName)}"]`)?.classList.remove('variant-group--invalid');
      document.querySelectorAll<HTMLButtonElement>(`.variant-opt[data-variant-name="${CSS.escape(vName)}"]`).forEach((b) => {
        const active = b === btn;
        const hex = b.dataset.colorHex ?? null;
        b.setAttribute('aria-pressed', String(active));
        b.style.borderColor = active ? (hex ?? 'var(--color-primary)') : 'var(--color-border)';
        b.style.background = active ? (hex ? hex + '18' : 'transparent') : 'none';
        b.style.color = 'var(--color-text)';
        b.style.fontWeight = active ? '600' : '500';
      });
      updateVariantAvailability();
      applyStockState();
      // Color chip may carry its own linked photo (seller-assigned in the
      // dashboard) — swap the main image to it, same visual result as
      // clicking that image's own thumbnail. Literally the same call the
      // thumbnails make (pickMainImage), so a colour two photos away lands
      // the same way a thumbnail two photos away does, rather than scrolling
      // past everything between. Hoisted function declared further down with
      // the rest of the thumbnail-switcher logic — safe to call here since
      // this callback only ever runs on a real click, well after the whole
      // module has run.
      if (isColorVariant(vName)) {
        const url = pageVariantImages[vValue];
        const idx = url ? images.indexOf(url) : -1;
        if (idx !== -1) pickMainImage(idx);
      }
    });
  });

  // ── Main image carousel + thumbnails ───────────────────────────────
  const mainSlides = document.getElementById('main-slides');
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');
  /** The image the shopper CHOSE — by clicking a thumbnail, swiping the carousel, or landing on
   *  a colour variant. Nothing a hover does may change it; that is the whole point of reverting. */
  let activeIndex = 0;
  /** The image the hover overlay is currently showing on TOP of the chosen one, or null. */
  let previewIndex: number | null = null;
  // Declared here rather than beside the hover handlers below: switchMainImage() is hoisted and
  // the colour-variant landing calls it during setup, so anything endPreview() touches has to be
  // initialised before that runs — a `const` further down would be in its temporal dead zone.
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
  const slideImgs = mainSlides ? [...mainSlides.querySelectorAll('img')] : [];

  // ── Skeleton ────────────────────────────────────────────────────────
  // Through the shared helper, not the hand-rolled load/error pair this used to carry twice.
  // That copy predated `img-skeleton.ts` and never learned what the shared one learned on
  // 2026-08-03: a shimmer must not run for an image the browser has not started fetching. Left
  // alone, the thumbnail strip's lazy images sat animating a grey band indefinitely — and because
  // the shimmer sits UNDER the picture, on a background-removed product photo that band shows
  // straight through the subject and reads as a skeleton painted ON the product (owner, twice).
  initImageSkeletons('#main-img-wrap');
  initImageSkeletons('.thumb-btn');

  function setThumbActive(idx: number) {
    thumbBtns.forEach((b) => {
      const isActive = Number(b.dataset.imgIndex) === idx;
      b.setAttribute('aria-pressed', String(isActive));
      b.style.opacity = isActive ? '1' : '0.55';
      b.style.borderColor = isActive ? 'var(--color-text)' : 'transparent';
    });
  }

  // The main image is a native horizontal scroll-snap carousel — swipe or
  // trackpad-scroll horizontally to move one image at a time, exactly like the
  // product-card / quick-view carousels but with no dot overlay (the thumbnail
  // strip is the indicator). Vertical scroll is never captured, so the page
  // scrolls normally over the image, and `overscroll-behavior-inline:contain`
  // (on #main-slides) stops an edge swipe from triggering browser back.
  const slidesRtl = mainSlides ? getComputedStyle(mainSlides).direction === 'rtl' : false;
  const getMainSlideW = () => mainSlides?.offsetWidth || 1;

  // Hoisted `function` so the color-variant handler above can call it before
  // its definition here — scrolls the carousel to a linked image.
  function switchMainImage(idx: number, instant = false): void {
    if (!mainSlides) return;
    endPreview();
    activeIndex = idx;
    mainSlides.scrollTo({ left: (slidesRtl ? -1 : 1) * idx * getMainSlideW(), behavior: instant ? 'auto' : 'smooth' });
    setThumbActive(idx);
  }

  /**
   * A thumbnail click LANDS on its image; it does not travel there.
   *
   * A smooth scroll across a snap carousel plays every slide between here and there. From
   * photo 1 to photo 5 the shopper watches 2, 3 and 4 flick past and only then arrives — which
   * reads as the gallery doing something of its own rather than answering the tap (owner,
   * 2026-08-18). One slide over it is a swipe and looks right; two or more it is a flicker.
   *
   * So anything past a neighbour cross-fades instead, through the SAME overlay the hover
   * preview uses: paint the destination on top, jump the carousel underneath it, fade the
   * overlay off. Nothing between the two is ever on screen. `switchMainImage(idx, true)`
   * already ends with `endPreview()`, i.e. the fade-out, so the overlay only has to be put up.
   *
   * Falls back to the instant jump — never the smooth one — when there is no overlay to fade
   * (a single-image gallery cannot get here) or the destination is not decoded yet, since a
   * fade that starts on an empty box is worse than no fade. And with a hover preview already
   * up, the overlay IS the destination: that path stays exactly as it was.
   */
  function pickMainImage(idx: number): void {
    if (idx === activeIndex) return;
    const adjacent = Math.abs(idx - activeIndex) === 1;
    if (adjacent || previewIndex !== null) { switchMainImage(idx, previewIndex !== null); return; }

    const slide = slideImgs[idx];
    const img = previewImg;
    if (!img || !slide?.complete) { switchMainImage(idx, true); return; }
    img.src = slide.currentSrc || slide.src;
    img.decode().then(
      () => {
        // Cover the carousel with the destination BEFORE it moves. No transition on the way up:
        // this frame is the cut, and the 0.16s the overlay carries is for the fade back off
        // (switchMainImage → endPreview). getBoundingClientRect() is the reflow that makes the
        // browser commit opacity:1 under `transition:none` instead of collapsing both writes.
        previewIndex = idx;
        img.style.transition = 'none';
        img.style.opacity = '1';
        img.getBoundingClientRect();
        img.style.transition = '';
        switchMainImage(idx, true);
      },
      () => switchMainImage(idx, true),
    );
  }

  // A landing that named a colour opens on that colour's photo. `instant`, not the click path's
  // smooth scroll: this is the page's initial state, and animating into it would read as the
  // carousel moving on its own the moment the page loaded.
  {
    const landedColor = pageVariants.map((v) => v.name).find((n) => isColorVariant(n) && selectedVariants[n]);
    const landedUrl = landedColor ? pageVariantImages[selectedVariants[landedColor]!] : undefined;
    const idx = landedUrl ? images.indexOf(landedUrl) : -1;
    if (idx > 0) switchMainImage(idx, true);
  }

  if (mainSlides) {
    // Update the active thumbnail live (rAF-throttled) so its highlight flips
    // the instant the scroll crosses the halfway point into the next image,
    // rather than only after scrolling has settled.
    let scrollRaf: number | undefined;
    mainSlides.addEventListener('scroll', () => {
      if (scrollRaf !== undefined) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = undefined;
        const idx = Math.min(Math.round(Math.abs(mainSlides.scrollLeft) / getMainSlideW()), images.length - 1);
        if (idx !== activeIndex) { activeIndex = idx; setThumbActive(idx); }
      });
    }, { passive: true });
  }

  // ── Hover preview ───────────────────────────────────────────────────
  // Hovering a thumbnail shows that image for as long as the pointer is on it, then puts the
  // chosen one back.
  //
  // It CROSS-FADES AN OVERLAY; it does not drive the carousel. The first version scrolled the
  // carousel to the hovered slide and scrolled it back on leave, and that was wrong twice over:
  // a scroll cannot fade, so the change could only ever be an abrupt jump (owner) — and the
  // carousel's own scroll listener is what decides which image is selected, so every preview
  // had to be fenced off from committing itself. Fading a copy on top deletes both problems at
  // once: the chosen image never moves, so "revert" is just this overlay fading back out, and
  // there is no scroll for anything to misread.
  //
  // The selection ring deliberately does not follow the preview — setThumbActive() stays driven
  // by activeIndex alone, so the shopper can always see which image is actually theirs while
  // another is on show.
  //
  // Pointer-only, deliberately: on a touch screen the hover events fire once on the tap that is
  // already selecting that image, so the preview would be a duplicate of the click with no way
  // to leave it. Nothing is lost — every image stays reachable by tap, click and swipe.
  async function previewImage(idx: number): Promise<void> {
    if (!canHover.matches || !previewImg || idx === previewIndex) return;
    // Hovering the image already on screen has nothing to preview — and if one is showing, this
    // is the shopper arriving back at their own choice, which should clear it.
    if (idx === activeIndex) { endPreview(); return; }
    const slide = slideImgs[idx];
    // An image still on the wire would fade in as an empty box, which is worse than no preview.
    // Momentary in practice: the idle warm-up below flips every slide to eager right after load.
    if (!slide?.complete) return;
    previewIndex = idx;
    // `currentSrc` is the exact derivative the browser already chose and cached for that slide,
    // and the overlay is the same box — so this repaints from cache rather than fetching a
    // second width of the same photo.
    previewImg.src = slide.currentSrc || slide.src;
    // Decode before revealing: a fade that starts on an undecoded image shows the fade, then
    // the image. Cached, so this settles within a frame.
    try { await previewImg.decode(); } catch { return; }
    if (previewIndex !== idx) return; // the pointer moved on while that resolved
    previewImg.style.opacity = '1';
  }

  function endPreview(): void {
    if (previewIndex === null) return;
    previewIndex = null;
    // Only the opacity is reset — clearing `src` too would throw away the decoded frame and make
    // the next hover of the same thumbnail fetch and decode again.
    if (previewImg) previewImg.style.opacity = '0';
  }

  const thumbStrip = document.getElementById('thumb-strip');
  // Delegated, and on `mouseover` rather than each button's `mouseenter`, because the gaps
  // between the thumbnails and the empty run of strip past the last one are part of the strip
  // too. Bound per button, the preview stayed up when the pointer merely slipped off a
  // thumbnail without leaving the row — most visible with two images, where the strip is mostly
  // empty space (owner). Here anything hovered that is not a thumbnail ends the preview, and
  // travelling from one thumbnail straight to the next still never flashes the chosen image.
  thumbStrip?.addEventListener('mouseover', (e) => {
    const btn = (e.target as Element | null)?.closest?.('.thumb-btn') as HTMLElement | null;
    if (btn) void previewImage(Number(btn.dataset.imgIndex ?? 0));
    else endPreview();
  });
  thumbStrip?.addEventListener('mouseleave', endPreview);

  thumbBtns.forEach((btn) => {
    const idx = Number(btn.dataset.imgIndex ?? 0);
    // pickMainImage decides between the neighbour's swipe, the hover preview's instant landing
    // and the cross-fade — see it for which and why.
    btn.addEventListener('click', () => pickMainImage(idx));
  });

  // Note: the main image intentionally does NOT hijack wheel/scroll to cycle
  // gallery images — that trapped normal page scrolling and, past the last
  // image, a horizontal trackpad swipe fell through to the browser's own
  // back-navigation. Images are switched via the thumbnail strip and the
  // lightbox arrows; the page scrolls normally over the image.

  // Warm the rest of the gallery once the page is idle, so scrolling the strip
  // shows a photo that is already decoded instead of starting a download.
  //
  // Done by flipping the slides' own `loading` to eager — NOT by fetching a URL
  // computed here. That was the previous version and it did not work: it warmed
  // `data-img-src` (a plain w_800 delivery), while each slide is a srcset+sizes
  // image, so the browser resolved a DIFFERENT candidate (w_1200 on a desktop
  // 2x screen) and the warmed bytes were for a URL nothing ever requested. The
  // fetch still happened at scroll time, which is exactly the delay this was
  // supposed to remove (reported 2026-08-01). Letting the element itself do the
  // asking means the candidate can never disagree — there is no second copy of
  // the width logic to drift.
  //
  // Native lazy-loading is what makes the warm-up necessary in the first place:
  // its heuristic is the VIEWPORT, and a slide sitting off to the side inside a
  // horizontal scroller is outside it, so nothing downloads until the user has
  // already scrolled to it.
  //
  // AFTER `load`, and only then idle — not idle alone. requestIdleCallback fires
  // whenever the main thread has a gap, which during page load happens BETWEEN
  // long tasks, while subresources are still on the wire; speculative gallery
  // bytes would then be competing with the page the shopper is waiting for. The
  // `load` gate makes that impossible, and the idle step after it keeps the warm-up
  // off the thread while anything else is still running. Combined with
  // fetchpriority="low" on those slides, this can only ever use bandwidth nothing
  // else wants.
  const runWhenIdle = (cb: () => void) => {
    const idle = () => {
      if ('requestIdleCallback' in window) window.requestIdleCallback(cb);
      else setTimeout(cb, 800);
    };
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  };
  runWhenIdle(() => {
    // Speculative bytes: Data Saver or a 2G connection means the shopper would
    // rather wait for what they asked for. Same rule as lib/lightbox-image.ts.
    const conn = (navigator as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    if (conn?.saveData || /^(slow-)?2g$/.test(conn?.effectiveType ?? '')) return;
    mainSlides?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => {
      img.loading = 'eager';
    });
  });

  // ── Lightbox ───────────────────────────────────────────────────────
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbPrev = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
  const lbNext = document.getElementById('lightbox-next') as HTMLButtonElement | null;
  const lbClose = document.getElementById('lightbox-close') as HTMLButtonElement | null;
  const lbCounter = document.getElementById('lightbox-counter');
  let lbIndex = 0;

  function updateLbCounter() {
    if (!lbCounter) return;
    if (images.length <= 1) { lbCounter.hidden = true; return; }
    lbCounter.textContent = `${lbIndex + 1} / ${images.length}`;
    lbCounter.hidden = false;
  }

  function openLightbox(idx: number) {
    if (!lightbox || images.length === 0) return;
    lbIndex = Math.max(0, Math.min(idx, images.length - 1));
    if (lbImg) showLbImage();
    if (lbPrev) lbPrev.hidden = images.length <= 1;
    if (lbNext) lbNext.hidden = images.length <= 1;
    updateLbCounter();
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    resetLightboxImage(lbImg);
  }

  // The enlarged view opens on the slide the gallery ALREADY downloaded
  // (softened) and settles onto the full-screen render — the frame is never
  // black while the big one arrives. `currentSrc`, not a re-derived w_800 URL:
  // this gallery carries a srcset, so which width is actually in cache depends
  // on viewport and DPR, and guessing wrong would fetch a third size for nothing.
  function showLbImage() {
    if (!lbImg) return;
    const src = images[lbIndex] ?? '';
    const w = lightboxWidth(lbImg);
    const slide = mainSlides?.querySelectorAll<HTMLImageElement>('img')[lbIndex];
    setLightboxImage(lbImg, {
      full: cdnSrc(src, w),
      preview: slide?.currentSrc || cdnSrc(src, 800),
      neighbours: neighbourIndexes(images.length, lbIndex).map(i => cdnSrc(images[i] ?? '', w)),
    });
  }

  // The lightbox navigates independently — moving between enlarged images must
  // NOT drive the gallery behind it (that "controls the images in the back"
  // effect the user flagged). The main image only changes via its own thumbnails.
  function goLightbox(dir: 1 | -1) {
    lbIndex = (lbIndex + dir + images.length) % images.length;
    updateLbCounter();
    // The current image stays put until the next one has decoded, so there's no
    // blank/opacity flash (the "screen jumps, image vanishes then returns" the
    // user reported) — that hand-off now lives in `setLightboxImage`.
    showLbImage();
  }

  const mainWrap = document.getElementById('main-img-wrap');
  // Ignore the click that ends a horizontal drag-scroll through the carousel —
  // only a genuine tap (no scroll movement) should open the lightbox.
  let mainPressScroll = 0;
  mainSlides?.addEventListener('pointerdown', () => { mainPressScroll = mainSlides.scrollLeft; });
  mainWrap?.addEventListener('click', () => {
    if (mainSlides && Math.abs(mainSlides.scrollLeft - mainPressScroll) > 3) return;
    openLightbox(activeIndex);
  });
  mainWrap?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(activeIndex); }
  });
  // Hovering the image is the buyer telling us they're about to enlarge it —
  // start the bigger render now, while they're still looking at the small one,
  // instead of making them watch it download after the click.
  mainWrap?.addEventListener('pointerenter', () => {
    warmLightboxImage(cdnSrc(images[activeIndex] ?? '', lightboxWidth(lbImg)));
  });
  lbClose?.addEventListener('click', closeLightbox);
  lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); goLightbox(-1); });
  lbNext?.addEventListener('click', (e) => { e.stopPropagation(); goLightbox(1); });
  lightbox?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('.lightbox__arrow') && !t.closest('.lightbox__close')) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    // Was the same mirroring written inline off `pageLang`; it now shares the
    // one copy in lib/arrow-step.ts, which keys off the computed `direction`
    // rather than the language — the same answer, from the thing that actually
    // decided which way the pixels went.
    const step = arrowStep(e.key, lightbox);
    if (step !== 0) goLightbox(step > 0 ? 1 : -1);
  });

  // ── Qty stepper ────────────────────────────────────────────────────
  const qtyDec = document.querySelector<HTMLButtonElement>('.qty-dec');
  const qtyInc = document.querySelector<HTMLButtonElement>('.qty-inc');
  const qtyVal = document.querySelector<HTMLElement>('.qty-val');
  const addBtn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
  // maxStock is the combo's raw total stock — passed to addItem() as-is (addItem
  // does its own prev-qty-in-cart math against it). remaining is what's left to
  // add right now (nets out cart contents) — drives the stepper/button/note only.
  let maxStock = Math.max(0, effectiveStockFor(selectedVariants));
  let remaining = Math.max(0, remainingFor(selectedVariants));
  let qty = 1;

  function updateQty(n: number) {
    qty = Math.max(1, Math.min(n, Math.max(1, remaining)));
    if (qtyVal) qtyVal.textContent = String(qty);
    if (qtyDec) qtyDec.disabled = qty <= 1;
    if (qtyInc) qtyInc.disabled = qty >= remaining;
  }

  // Re-derives the stock ceiling for whichever combo is currently selected —
  // called on every variant-swatch click. Distinct from the page's initial
  // out-of-stock state (product.stock <= 0, server-rendered) which governs
  // whether the qty/add-to-cart row exists at all; this only reacts to a
  // *specific combination* being sold out while the product overall isn't.
  function applyStockState(): void {
    maxStock = Math.max(0, effectiveStockFor(selectedVariants));
    remaining = Math.max(0, remainingFor(selectedVariants));
    const outOfStock = remaining <= 0;

    qty = outOfStock ? 0 : Math.min(qty, remaining);
    if (qtyVal) qtyVal.textContent = String(Math.max(qty, outOfStock ? 0 : 1));
    if (qtyDec) qtyDec.disabled = outOfStock || qty <= 1;
    if (qtyInc) qtyInc.disabled = outOfStock || qty >= remaining;
    if (!outOfStock && qty < 1) updateQty(1);

    [addBtn, stickyAddBtn].forEach((btn) => { if (btn) btn.disabled = outOfStock; });

    const note = document.getElementById('stock-status-note') as HTMLElement | null;
    const noteText = document.getElementById('stock-status-text');
    const noteDot = document.getElementById('stock-status-dot');
    const noteWarn = document.getElementById('stock-status-warn');
    if (!note || !noteText || !noteDot || !noteWarn) return;
    const isLow = !outOfStock && remaining <= 5;
    note.style.fontWeight = outOfStock || isLow ? '600' : '500';
    noteDot.style.display = outOfStock || isLow ? 'none' : 'inline-block';
    noteWarn.style.display = outOfStock || isLow ? 'block' : 'none';
    if (outOfStock) {
      note.style.color = 'var(--color-danger)';
      noteText.textContent = getPMI18n().outOfStock || (pageLang === 'he' ? 'אזל מהמלאי' : 'Out of stock');
    } else if (isLow) {
      note.style.color = 'var(--color-warning)';
      noteText.textContent = pageLang === 'he' ? `נותרו ${remaining} בלבד` : `Only ${remaining} left`;
    } else {
      note.style.color = 'var(--color-muted)';
      noteText.textContent = getPMI18n().inStockLabel || (pageLang === 'he' ? 'במלאי' : 'In stock');
    }
  }

  qtyDec?.addEventListener('click', (e) => { spawnRipple(qtyDec, e.clientX, e.clientY); updateQty(qty - 1); });
  qtyInc?.addEventListener('click', (e) => { spawnRipple(qtyInc, e.clientX, e.clientY); updateQty(qty + 1); });

  // ── Mobile sticky bar: appears once the real "add to cart" button scrolls
  //    out of view — including right on load, if it starts below the fold
  //    (e.g. a tall variant list pushes it down while the image is still visible) ──
  const stickyCartBar = document.getElementById('sticky-cart-bar');
  const stickyMiniImg = document.getElementById('sticky-mini-img') as HTMLImageElement | null;
  const stickyMiniSummary = document.getElementById('sticky-mini-summary');
  const productNameHeading = document.getElementById('product-name-heading');
  if (stickyCartBar && addBtn) {
    new IntersectionObserver(([entry]) => {
      stickyCartBar.classList.toggle('is-visible', !entry.isIntersecting);
    }, { rootMargin: '-56px 0px 0px 0px' }).observe(addBtn);
  }

  // The bar's own image+name only join in once the real ones scroll out of
  // view too — while they're still visible up top, the bar shows buttons only.
  // In that buttons-only state "add to cart" fills the bar (same flex-auto
  // pattern as the inline #add-to-cart-btn) instead of hugging its own
  // content — if checkout later joins it, it shrinks to make room for it,
  // same as everywhere else, rather than snapping back to a small fixed size.
  function updateStickyBarSoloWidth(): void {
    const isCollapsed = stickyMiniSummary?.classList.contains('is-collapsed') ?? false;
    stickyAddBtn?.classList.toggle('sticky-btn--solo', isCollapsed);
  }
  if (stickyMiniSummary && productNameHeading) {
    // Collapse/expand only. The thumbnail used to be fetched from here too, at the exact
    // moment it was about to be revealed — see its markup for why that is now a plain `src`.
    new IntersectionObserver(([entry]) => {
      stickyMiniSummary.classList.toggle('is-collapsed', entry.isIntersecting);
      updateStickyBarSoloWidth();
    }, { rootMargin: '-56px 0px 0px 0px' }).observe(productNameHeading);
  }

  // Sticky bar: clicking the thumbnail or name scrolls back to the top of the
  // page — no cursor:pointer, this is a quiet affordance, not a link.
  const stickyMiniName = document.getElementById('sticky-mini-name');
  [stickyMiniImg, stickyMiniName].forEach((el) => {
    el?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  });

  // ── Add to cart ────────────────────────────────────────────────────
  const toCheckoutBtn = document.getElementById('to-checkout-btn') as HTMLAnchorElement | null;
  toCheckoutBtn?.addEventListener('pointerdown', (e) => spawnRipple(toCheckoutBtn, e.clientX, e.clientY));
  if (addBtn) {
    const checkSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>';
    const labelSpan = addBtn.querySelector<HTMLElement>('.btn-label');
    if (labelSpan) labelSpan.style.cssText = 'display:inline-flex;align-items:center;gap:4px';
    const originalLabel = labelSpan?.innerHTML ?? '';

    addBtn.addEventListener('pointerdown', (e) => spawnRipple(addBtn, e.clientX, e.clientY));
    addBtn.addEventListener('click', () => {
      if (addBtn.disabled) return;
      if (pageVariants.length && flagMissingVariants()) return;
      const { slug = '', productId = '', name = '', price = '0', image = '', category = '' } = addBtn.dataset;
      const variantsCopy = Object.keys(selectedVariants).length ? { ...selectedVariants } : undefined;
      addItem(storeSlug, storeName, { slug, productId, name, price: Number(price), image, stock: maxStock }, qty, variantsCopy, false);
      trackAddToCart({ id: adItemId(productId, variantsCopy), productId, name, price: Number(price), category }, qty);
      updateQty(1);

      if (toCheckoutBtn) toCheckoutBtn.style.display = 'inline-flex';
      if (stickyToCheckoutBtn) stickyToCheckoutBtn.style.display = 'inline-flex';
      updateStickyBarSoloWidth();
      addBtn.style.minWidth = `${addBtn.offsetWidth}px`;
      if (labelSpan) labelSpan.innerHTML = `${checkSvg}${addBtn.dataset.labelAdded ?? ''}`;
      addBtn.disabled = true;
      addBtn.classList.add('btn--confirmed');

      addBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );

      setTimeout(() => {
        if (labelSpan) labelSpan.innerHTML = originalLabel;
        addBtn.style.minWidth = '';
        addBtn.classList.remove('btn--confirmed');
        applyStockState(); // re-enables only if stock remains, not blindly
      }, 1400);
    });
  }

  // ── Nav "לתשלום" = buy now ─────────────────────────────────────────
  // The other two checkout buttons on this page (#to-checkout-btn, #sticky-to-checkout-btn) START
  // HIDDEN and are revealed by add-to-cart, so pressing either always means "pay for what I just
  // added". This one sits in the top nav and is visible on arrival, which made it the only
  // checkout on the page that could be pressed with the product NOT in the cart — from a fresh
  // visit it opened a checkout with nothing on it. The link was never wrong about the store
  // (`?store=` has always been on it); it was wrong that there was anything to pay for.
  //
  // So it now does the whole gesture: choose → add → checkout. Deliberately NOT a fourth code path
  // — it reuses this module's own selection state, the same `flagMissingVariants` gate and the same
  // `addItem`, because a second implementation of "what did the buyer pick" is how the swatch and
  // the cart end up disagreeing.
  const navToCheckoutBtn = document.getElementById('nav-to-checkout-btn') as HTMLAnchorElement | null;
  if (navToCheckoutBtn && addBtn) {
    navToCheckoutBtn.addEventListener('click', (e) => {
      // Sold out: nothing to add, and the href is then the honest action. Also leaves middle-click
      // / ⌘-click / "open in new tab" alone — those never fire a plain left click.
      if (addBtn.disabled || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      // Variants unchosen → stay on the page and shake the missing dimension(s). Same gate as
      // add-to-cart, so a product needing a size can no more be bought from here than from there.
      if (pageVariants.length && flagMissingVariants()) return;

      const { slug = '', productId = '', name = '', price = '0', image = '', category = '' } = addBtn.dataset;
      const variantsCopy = Object.keys(selectedVariants).length ? { ...selectedVariants } : undefined;
      // Already in the cart — from an earlier press of add-to-cart, or a previous visit. Adding
      // again would silently double the quantity of someone who only asked to go and pay.
      if (getCartQty(storeSlug, slug, variantsCopy) === 0) {
        addItem(storeSlug, storeName, { slug, productId, name, price: Number(price), image, stock: maxStock }, qty, variantsCopy, false);
        // `addItem` can REFUSE — a seller may not buy from their own store, and it says so in a
        // toast (own-store-guard.ts). Navigating on top of that answers the explanation by moving
        // them to a checkout with nothing on it. Re-reading the cart, rather than re-testing that
        // one rule here, is what keeps a future refusal from silently doing the same.
        if (getCartQty(storeSlug, slug, variantsCopy) === 0) return;
        trackAddToCart({ id: adItemId(productId, variantsCopy), productId, name, price: Number(price), category }, qty);
      }
      // The delegated refresh in `initCustomDomainLinks` already ran (capture phase) — but it ran
      // BEFORE the add above, so on a custom domain it stamped the basket without this item.
      // Re-stamp now that there is something to carry, then read the attribute back: `href`, not
      // the constant, because the rewrite is what points this at the platform origin at all.
      refreshCheckoutCartFragment(navToCheckoutBtn, storeSlug, platformBoundary);
      window.location.href = navToCheckoutBtn.href;
    });
  }

  // ── Mobile sticky bar: its own add-to-cart button, mirrors the same action
  //    and shows its own success state (the inline button may be off-screen) ──
  const stickyAddBtn = document.getElementById('sticky-add-to-cart-btn') as HTMLButtonElement | null;
  const stickyToCheckoutBtn = document.getElementById('sticky-to-checkout-btn') as HTMLAnchorElement | null;
  stickyToCheckoutBtn?.addEventListener('pointerdown', (e) => spawnRipple(stickyToCheckoutBtn, e.clientX, e.clientY));
  if (addBtn && stickyAddBtn) {
    const stickyCheckSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>';
    const stickyLabelSpan = stickyAddBtn.querySelector<HTMLElement>('.btn-label');
    if (stickyLabelSpan) stickyLabelSpan.style.cssText = 'display:inline-flex;align-items:center;gap:4px';
    const stickyOriginalLabel = stickyLabelSpan?.innerHTML ?? '';

    stickyAddBtn.addEventListener('pointerdown', (e) => spawnRipple(stickyAddBtn, e.clientX, e.clientY));
    stickyAddBtn.addEventListener('click', () => {
      if (addBtn.disabled || stickyAddBtn.disabled) return;
      if (pageVariants.length && flagMissingVariants()) return;
      const { slug = '', productId = '', name = '', price = '0', image = '', category = '' } = addBtn.dataset;
      const variantsCopy = Object.keys(selectedVariants).length ? { ...selectedVariants } : undefined;
      addItem(storeSlug, storeName, { slug, productId, name, price: Number(price), image, stock: maxStock }, qty, variantsCopy, false);
      trackAddToCart({ id: adItemId(productId, variantsCopy), productId, name, price: Number(price), category }, qty);
      updateQty(1);

      if (stickyToCheckoutBtn) stickyToCheckoutBtn.style.display = 'inline-flex';
      if (toCheckoutBtn) toCheckoutBtn.style.display = 'inline-flex';
      updateStickyBarSoloWidth();
      stickyAddBtn.style.minWidth = `${stickyAddBtn.offsetWidth}px`;
      if (stickyLabelSpan) stickyLabelSpan.innerHTML = `${stickyCheckSvg}${addBtn.dataset.labelAdded ?? ''}`;
      stickyAddBtn.disabled = true;
      stickyAddBtn.classList.add('btn--confirmed');

      stickyAddBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );

      setTimeout(() => {
        if (stickyLabelSpan) stickyLabelSpan.innerHTML = stickyOriginalLabel;
        stickyAddBtn.style.minWidth = '';
        stickyAddBtn.classList.remove('btn--confirmed');
        applyStockState(); // re-enables only if stock remains, not blindly
      }, 1400);
    });
  }

  // Sync button/qty-stepper disabled state with the default combo's stock —
  // the status note itself is already server-rendered correctly, this covers
  // the edge case of the *default* variant selection being sold out while the
  // product's overall stock (which gates whether this row renders at all) isn't.
  applyStockState();
  window.addEventListener('cart:change', applyStockState);

  {
    const descEl = document.getElementById('product-desc');
    if (descEl) {
      initReadMore(descEl, 2, {
        more: pageLang === 'he' ? 'עוד' : 'More',
        less: pageLang === 'he' ? 'פחות' : 'Less',
      });
    }
  }

  // ── Wishlist ───────────────────────────────────────────────────────
  const wishlistBtn = document.getElementById('wishlist-btn') as HTMLButtonElement | null;
  const wishlistHeart = document.getElementById('wishlist-heart') as SVGElement | null;
  const wishlistLabel = document.getElementById('wishlist-label');

  function setWishlistStyle(active: boolean) {
    if (!wishlistBtn || !wishlistHeart) return;
    if (active) {
      (wishlistHeart as unknown as HTMLElement).style.fill = '#e53e3e';
      (wishlistHeart as unknown as HTMLElement).style.stroke = '#e53e3e';
      wishlistBtn.style.color = '#e53e3e';
    } else {
      (wishlistHeart as unknown as HTMLElement).style.fill = 'none';
      (wishlistHeart as unknown as HTMLElement).style.stroke = 'currentColor';
      wishlistBtn.style.color = '';
    }
  }

  function getI18nWishlist(): Record<string, string> {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}')?.wishlist ?? {}; } catch { return {}; }
  }

  if (wishlistBtn) {
    const slug = wishlistBtn.dataset.wishlistSlug ?? '';
    const active = isWishlisted(slug);
    wishlistBtn.dataset.wishlisted = String(active);
    wishlistBtn.setAttribute('aria-pressed', String(active));
    setWishlistStyle(active);

    const wi = getI18nWishlist();
    if (active && wishlistLabel) wishlistLabel.textContent = wi['removeLabel'] ?? wishlistLabel.textContent;

    wishlistBtn.addEventListener('click', () => {
      const item = {
        slug,
        name: wishlistBtn.dataset.wishlistName ?? '',
        price: Number(wishlistBtn.dataset.wishlistPrice ?? 0),
        image: wishlistBtn.dataset.wishlistImage ?? '',
        storeSlug: wishlistBtn.dataset.wishlistStoreSlug ?? '',
        storeName: wishlistBtn.dataset.wishlistStoreName ?? '',
        stock: wishlistBtn.dataset.wishlistStock !== undefined ? Number(wishlistBtn.dataset.wishlistStock) : undefined,
        // This page already knows the product's dimensions, so the flag is free here. The drawer
        // uses it to offer "choose options" instead of an add that the checkout would refuse.
        hasVariants: pageVariants.length > 0,
      };
      const nowActive = toggleWishlist(item);
      wishlistBtn.dataset.wishlisted = String(nowActive);
      wishlistBtn.setAttribute('aria-pressed', String(nowActive));
      wishlistBtn.setAttribute('aria-label', nowActive ? (wi['removeLabel'] ?? '') : (wi['addLabel'] ?? ''));
      if (wishlistLabel) wishlistLabel.textContent = nowActive ? (wi['removeLabel'] ?? '') : (wi['addLabel'] ?? '');
      setWishlistStyle(nowActive);
      if (nowActive) spawnHeartBurst(wishlistBtn);
    });
  }

  // ── Stock-status i18n (read from the server-embedded #pm-i18n blob) ──
  function getPMI18n(): Record<string, string> {
    try { return JSON.parse(document.getElementById('pm-i18n')?.textContent ?? '{}') as Record<string, string>; }
    catch { return {}; }
  }

  // ── Related cards → shared store product modal ────────────────────
  // Opens the exact same modal a store-page product card opens (the shared
  // StoreProductModal, rendered in BaseLayout) — one source of truth, so it
  // can't drift into an outdated look again. The modal fetches its own data
  // from /api/store-product by slug, so the card only needs a slug; the
  // <a href> stays a real link, so middle/ctrl-click still opens the full page.
  document.querySelectorAll<HTMLElement>('.related-card').forEach((card) => {
    const link = card.querySelector<HTMLAnchorElement>('.related-card-trigger');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      const slug = card.dataset.slug ?? '';
      if (slug) window.dispatchEvent(new CustomEvent('store-product-modal:open', { detail: { storeSlug, productSlug: slug, storeName } }));
    });
  });

  // ── Login hint (shared helper) ────────────────────────────────
  function showLoginHint(btn: HTMLElement) {
    const existing = btn.parentElement?.querySelector('.login-hint-popup');
    if (existing) { existing.remove(); return; }
    const loginUrl = btn.dataset.loginUrl ?? '/seller/login';
    const hint = document.createElement('div');
    hint.className = 'login-hint-popup';
    hint.setAttribute('role', 'status');
    // t.messages.loginToMessage / loginToMessageLink, off the button that opened
    // this hint — both buttons that call it are server-rendered and carry them.
    const lead = btn.dataset.strLoginHint ?? 'כדי לשלוח הודעה יש';
    const link = btn.dataset.strLoginHintLink ?? 'להתחבר';
    hint.innerHTML = `<span>${escHtml(lead)} <a href="${escHtml(loginUrl)}" style="color:var(--color-accent);font-weight:600;text-decoration:underline">${escHtml(link)}</a></span>`;
    hint.style.cssText = 'position:absolute;top:calc(100% + 0.4rem);inset-inline-start:0;z-index:50;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:0.45rem 0.8rem;white-space:nowrap;box-shadow:var(--shadow-card);font-size:0.8rem;color:var(--color-text)';
    hint.animate([{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease', fill: 'forwards' });
    const container = btn.parentElement ?? btn;
    // The hint is `position:absolute`, so it lands under the button only if this
    // container is the positioning context. Markup is meant to provide that; if a
    // future edit drops the wrapper the hint would silently fly to the nearest
    // positioned ancestor instead of just looking wrong here, so pin it.
    if (getComputedStyle(container).position === 'static') container.style.position = 'relative';
    container.appendChild(hint);
    const dismiss = () => { hint.remove(); document.removeEventListener('click', outsideClick); };
    const outsideClick = (e: MouseEvent) => { if (!hint.contains(e.target as Node) && e.target !== btn) dismiss(); };
    setTimeout(() => document.addEventListener('click', outsideClick), 10);
    setTimeout(dismiss, 5000);
  }

  // ── Ask about product button ──────────────────────────────────
  const askBtn = document.getElementById('ask-product-btn') as HTMLButtonElement | null;
  askBtn?.addEventListener('click', () => {
    if (askBtn.dataset.isLoggedIn !== 'true') {
      showLoginHint(askBtn);
      return;
    }
    window.dispatchEvent(new CustomEvent('message:compose', {
      detail: {
        storeId: askBtn.dataset.storeId ?? '',
        sellerId: askBtn.dataset.sellerId ?? '',
        storeName: askBtn.dataset.storeName ?? '',
        productRef: {
          productId: askBtn.dataset.productId ?? '',
          productName: askBtn.dataset.productName ?? '',
          productSlug: askBtn.dataset.productSlug ?? '',
          storeSlug: askBtn.dataset.storeSlug ?? '',
        },
      },
    }));
  });
</script>
