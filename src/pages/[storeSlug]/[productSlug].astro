---
export const prerender = false;
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoreBySlug, getStoreByPreviousSlug, isStoreVisible, storeHttpStatus, showsPausedNotice } from '../../lib/stores.js';
import { OG_IMAGE_FORMAT, storeImageUrl } from '../../lib/store-image.js';
import { isDemoStore } from '../../lib/demo-stores.js';
import { storeCanonicalUrl, productCanonicalUrl, customDomainRedirectUrl } from '../../lib/custom-domain.js';
import { getProductBySlug, getVisibleProductsByStoreId, isProductVisible } from '../../lib/store-products.js';
import { store as platform, cdnSrc, cdnSrcSet } from '../../config/store.config.js';
import { resolvePrice } from '../../lib/discounts.js';
import { priceHtml, saleBadgeHtml } from '../../lib/price-html.js';
import StoreSaleBanner from '../../components/StoreSaleBanner.astro';
import OwnerStoreBar from '../../components/OwnerStoreBar.astro';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getLang, getT } from '../../i18n/index.js';
import { resolveVariantColor, isColorVariant } from '../../lib/color-variants.js';
import { comboKey, isProductInStock } from '../../lib/variant-combo.js';
import { getCategoriesByStoreId, categoryPath } from '../../lib/store-categories.js';
import { saleScopeCategoryLabel } from '../../lib/store-sale-scope.js';
import { jsonForScript } from '../../lib/json-script.js';

const { storeSlug, productSlug } = Astro.params;
if (!storeSlug || !productSlug) return Astro.redirect('/404');

const shopStore = getStoreBySlug(storeSlug);
if (!shopStore) {
  // Store URL renamed → 301 the old slug (keeping the product path) to the current one, preserving
  // SEO + shared links instead of 404-ing (see renameStoreSlug).
  const moved = getStoreByPreviousSlug(storeSlug);
  if (moved) return Astro.redirect(`/${moved.slug}/${productSlug}`, 301);
  return Astro.redirect('/404');
}
// Not serving a storefront at all: an admin block (admin-moderation.ts) answers 404, so the store
// stops accumulating crawl/index signal while it is under review; a store its seller closed for
// good answers 410 Gone, which drops it from the index faster and more definitively.
//
// REWRITTEN, not redirected (2026-07-31). A redirect made the store's own URL answer 302 and put
// the real status on /404 — so a crawler recorded "this store moved to an error page" instead of
// "this store is gone", which is a weaker and slower signal, and the address bar left the URL the
// shopper actually followed. A rewrite renders the same page AT this URL and carries its status
// (404.astro sets it), which is what both Google and the shopper should be given.
if (!isStoreVisible(shopStore)) {
  return Astro.rewrite(storeHttpStatus(shopStore) === 410 ? '/store-gone' : '/404');
}
// Operational halt by the seller (store-status.ts). The URL keeps working — no redirect, no 404,
// so every existing link still resolves — but it serves the notice INSTEAD of the catalog: a
// shopper cannot do anything with a product they are not allowed to buy, and a grid of disabled
// buttons reads as a broken page rather than a closed one (decided with the owner 2026-07-31).
// Rewritten here, before any product/category/sale/page-view work, so a halted store costs
// nothing to serve. /api/checkout refuses it regardless of what any page renders.
if (showsPausedNotice(shopStore)) {
  return Astro.rewrite('/store-unavailable');
}
// A showcase store's products stay browsable by direct link (that's the point of
// the demo) but must never be indexed — the store page, sitemap and product feed
// apply the same rule; see lib/demo-stores.ts.
const isDemo = isDemoStore(shopStore);

const product = getProductBySlug(shopStore.id, productSlug);
if (!product) return Astro.redirect(`/${storeSlug}`);
if (!isProductVisible(product)) return Astro.redirect('/404');

// SEO: verified custom domain is the store's home — 301 the platform product URL to it (see the
// store page for the rationale). No-op when already served on the custom domain.
const cdRedirect = customDomainRedirectUrl(shopStore, Astro.request.headers.get('host'), `/${productSlug}${Astro.url.search}`);
if (cdRedirect) return Astro.redirect(cdRedirect, 301);

const userId = getSellerSession(Astro.cookies);
const isLoggedIn = !!userId;
const lang = getLang(Astro.cookies);
const t = getT(lang);

// The seller browsing his own store gets the same bar here as on the store page — the
// store is one surface, and a preview that announces itself only on the front page
// leaves him guessing on every page he clicks into (see OwnerStoreBar.astro). On a
// custom domain the dashboard is on another origin, so the link has to be absolute.
const isOwner = !!userId && userId === shopStore.sellerId;
const dashboardHref = shopStore.customDomain?.status === 'active'
  ? `${platform.url}/seller/dashboard`
  : '/seller/dashboard';

const isNew = new Date(product.createdAt).toDateString() === new Date().toDateString();
const images = product.images ?? [];

// Used only as a heuristic for each option button's own availability preview
// (combined with the first option of every *other* dimension) — no dimension
// is actually pre-selected for the buyer; see "no default pre-selection" below.
const defaultVariantSelection: Record<string, string> =
  Object.fromEntries((product.variants ?? []).map((v) => [v.name, v.options[0] ?? '']));
// Nothing is selected yet on load, so the note reflects the product's overall
// stock (matches the client's own unselected-state fallback — no flash of a
// different number once JS hydrates).
const initialComboStock = product.stock;
const LOW_STOCK_DISPLAY_THRESHOLD = 5;
const initialStockState: 'out' | 'low' | 'in' =
  initialComboStock <= 0 ? 'out' : initialComboStock <= LOW_STOCK_DISPLAY_THRESHOLD ? 'low' : 'in';
const initialStatusColor =
  initialStockState === 'out' ? 'var(--color-danger)'
  : initialStockState === 'low' ? 'var(--color-warning)'
  : 'var(--color-muted)';
const initialStatusText =
  initialStockState === 'out' ? t.store.outOfStock
  : initialStockState === 'low' ? (lang === 'he' ? `נותרו ${initialComboStock} בלבד` : `Only ${initialComboStock} left`)
  : t.store.inStockLabel;
// Canonical product/store URLs — the seller's own domain when active, else the platform path
// (custom-domain.ts). Drives <link rel=canonical>, og:url and the JSON-LD so all SEO signals agree.
const productUrl = productCanonicalUrl(shopStore, productSlug);
const storeCanonical = storeCanonicalUrl(shopStore);

// Pre-filtered to non-blocked (see store-products.ts#getVisibleProductsByStoreId) — this list
// also feeds the header search-suggestions JSON below, which used to leak a blocked product
// as a suggestion that led straight into a 404 (found in review, 2026-07-14).
const allStoreProducts = getVisibleProductsByStoreId(shopStore.id);
const relatedProducts = allStoreProducts
  .filter((p) => p.slug !== product.slug)
  .slice(0, 4);

const storeCategoriesForProduct = getCategoriesByStoreId(shopStore.id);
const productCategoryName = product.categoryId ? storeCategoriesForProduct.find((c) => c.id === product.categoryId)?.name ?? '' : '';
const productCategoryPathStr = product.categoryId ? categoryPath(storeCategoriesForProduct, product.categoryId) : '';
// Every sale names its scope on the banner, the store-wide one included — same rule as the
// store page, and here it also tells the shopper the sale reaches beyond the product they are
// looking at (StoreSaleBanner still hides itself entirely on a product a scoped sale misses).
const saleScopeLabel = saleScopeCategoryLabel(storeCategoriesForProduct, shopStore.sale, t.store.saleAndMore)
  || (shopStore.sale?.productIds?.length ? t.store.saleOnSelected : t.store.saleOnWholeStore);

// The price to display, charge and publish — resolved once from the product + its store's
// sale, exactly as /api/checkout resolves it (discounts.ts).
const pv = resolvePrice(product, shopStore.sale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  ...(product.description ? { description: product.description } : {}),
  ...(images.length ? { image: images } : {}),
  // brand/sku/mpn enrich both Google rich results and AI-answer comprehension
  // (AIO) — a small business is its own brand; the SKU doubles as the mpn.
  brand: { '@type': 'Brand', name: shopStore.name },
  ...(product.sku ? { sku: product.sku, mpn: product.sku } : {}),
  ...(productCategoryPathStr ? { category: productCategoryPathStr } : {}),
  ...(product.tags?.length ? { keywords: product.tags.join(', ') } : {}),
  ...(product.specs?.length ? {
    additionalProperty: product.specs.map((s) => ({
      '@type': 'PropertyValue',
      name: s.label,
      value: s.value,
    })),
  } : {}),
  url: productUrl,
  offers: {
    '@type': 'Offer',
    price: String(pv.price),
    priceCurrency: 'ILS',
    itemCondition: 'https://schema.org/NewCondition',
    availability: isProductInStock(product.stock, product.variants, product.variantStock)
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    url: productUrl,
    seller: { '@type': 'Organization', name: shopStore.name },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: shopStore.name,
      item: storeCanonical,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: product.name,
      item: productUrl,
    },
  ],
};

const pmI18n = {
  addToCart: t.store.addToCart,
  addedToCart: t.store.addedToCart,
  outOfStock: t.store.outOfStock,
  inStockLabel: t.store.inStockLabel,
  addToWishlist: t.wishlist.addLabel,
  removeFromWishlist: t.wishlist.removeLabel,
  fullPage: lang === 'he' ? 'לדף המוצר המלא' : 'View full product page',
};
---

<BaseLayout
  title={`${product.name} — ${shopStore.name}`}
  description={product.description || shopStore.tagline || `${product.name} at ${shopStore.name}`}
  image={images[0] ?? storeImageUrl(shopStore, OG_IMAGE_FORMAT)}
  type="product"
  jsonLd={jsonLd}
  canonical={productUrl}
  noindex={isDemo}
  isLoggedIn={isLoggedIn}
  storeMode={true}
  storeName={shopStore.name}
  storeSlug={shopStore.slug}
  dataLayer={{ event: 'page_view', page_type: 'product', store_id: shopStore.id, store_name: shopStore.name, store_slug: storeSlug, currency: 'ILS', ecommerce: { currency: 'ILS', items: [{ item_id: product.id, item_name: product.name, price: pv.price, item_category: productCategoryPathStr }] } }}
  productPrice={pv.price}
  productCurrency="ILS"
>
  <script is:inline type="application/ld+json" set:html={jsonForScript(breadcrumbLd)} />
  <script is:inline type="application/json" id="pm-i18n" set:html={jsonForScript(pmI18n)} />

  {isOwner && (
    <OwnerStoreBar label={t.store.ownerPreview} backLabel={t.store.ownerPreviewBack} dashboardHref={dashboardHref} />
  )}

  <div class="product-detail-page"
       data-owner-store={isOwner ? shopStore.slug : undefined}
       data-owner-cannot-buy={isOwner ? t.store.ownerCannotBuy : undefined}
       data-store-slug={shopStore.slug}
       data-custom-host={shopStore.customDomain?.status === 'active' ? shopStore.customDomain.hostname : ''}
       data-store-name={shopStore.name}
       data-images={JSON.stringify(images)}
       data-lang={lang}
       data-variants={product.variants?.length ? JSON.stringify(product.variants) : undefined}
       data-variant-stock={product.variantStock ? JSON.stringify(product.variantStock) : undefined}
       data-variant-images={product.variantImages ? JSON.stringify(product.variantImages) : undefined}>

    <!-- Back link + checkout link -->
    <nav class="container pt-4 pb-2 flex items-center justify-between" aria-label="breadcrumb">
      <a href={`/${shopStore.slug}`}
         data-astro-prefetch
         class="inline-flex items-center gap-1.5 text-sm transition-colors duration-150 hover:[color:var(--color-text)]"
         style="color:var(--color-muted);text-decoration:none">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
             class={lang === 'he' ? 'rotate-180' : ''}>
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        {lang === 'he' ? 'לחנות' : 'To store'}
      </a>
      <a href="/checkout"
         class="inline-flex items-center gap-1.5 text-sm transition-colors duration-150 hover:[color:var(--color-text)]"
         style="color:var(--color-muted);text-decoration:none">
        {lang === 'he' ? 'לתשלום' : 'Checkout'}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
             class={lang === 'he' ? 'rotate-180' : ''}>
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </nav>

    <main id="main-content" class="container pt-2 pb-16">

      <!-- Product grid -->
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,440px)_1fr] gap-1.5 md:gap-14">

        <!-- Images column -->
        <div>
          <div id="main-img-wrap"
               class={`relative overflow-hidden${images[0] ? ' is-loading' : ''}`}
               style="aspect-ratio:1/1;border-radius:var(--radius)"
               role={images.length > 0 ? 'button' : undefined}
               tabindex={images.length > 0 ? '0' : undefined}
               aria-label={images.length > 0 ? t.product.clickToZoom : undefined}>
            {images.length > 0
              ? <div id="main-slides"
                     class="flex w-full h-full overflow-x-scroll overflow-y-hidden cursor-zoom-in [scroll-snap-type:x_mandatory] [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [touch-action:pan-x] [overscroll-behavior-inline:contain] [&::-webkit-scrollbar]:hidden">
                  {images.map((img, i) => (
                    <div class="relative shrink-0 w-full h-full [scroll-snap-align:start] [scroll-snap-stop:always]">
                      {/* Plain <img> (not <Image />) to carry a hi-DPI srcset — the main image
                          renders ~560px CSS wide on desktop, so a lone w_800 delivery is upscaled
                          → soft on retina. srcset+sizes keeps the seller's photo sharp at every DPR. */}
                      <img id={i === 0 ? 'main-img' : undefined} src={cdnSrc(img, 800)}
                           srcset={cdnSrcSet(img, [600, 800, 1200, 1600]) || undefined}
                           sizes="(max-width: 767px) 94vw, 560px"
                           alt={i === 0 ? product.name : ''}
                           width={800} height={800}
                           class="w-full h-full object-cover block"
                           loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
                    </div>
                  ))}
                </div>
              : <div class="absolute inset-0 flex items-center justify-center" style="color:var(--color-border)" aria-hidden="true">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                  </svg>
                </div>
            }
            {isNew && <span class="badge badge--new" style="position:absolute;top:0.75rem;inset-inline-start:0.75rem">{t.store.badgeNew}</span>}
            <Fragment set:html={saleBadgeHtml(pv, t.store.saleBadge, 'sale-badge--hero')} />
          </div>

          {images.length > 1 && (
            <div class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width:none;margin-top:0.625rem" role="list" aria-label={t.product.imageGallery}>
              {images.map((img, i) => (
                <button
                  type="button"
                  role="listitem"
                  data-img-src={cdnSrc(img, 800)}
                  data-img-index={String(i)}
                  class="thumb-btn is-loading flex-shrink-0 overflow-hidden p-0 border-2 cursor-pointer transition-all duration-150"
                  style={`width:4rem;height:4rem;border-radius:var(--radius);border-color:${i === 0 ? 'var(--color-text)' : 'transparent'};opacity:${i === 0 ? 1 : 0.55}`}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-label={`${product.name} ${i + 1}`}
                >
                  <Image src={cdnSrc(img, 128)} alt="" width={64} height={64}
                         style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Info column -->
        <div class="flex flex-col gap-4 md:gap-5">

          <!-- Name + price — dir=auto on the wrapper so the price aligns to the same
               side as the (per-language) product name instead of staying pinned right. -->
          <div class="flex flex-col gap-2" dir="auto">
            {isDemo && (
              <span class="inline-flex items-center gap-1 mb-1.5 text-[0.72rem] font-medium leading-[1.5] whitespace-nowrap [color:var(--color-muted)]">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
                  <circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.6v.6"/>
                </svg>
                {t.demo.productBadge}
              </span>
            )}
            <h1 id="product-name-heading" style="font-size:1.5rem;font-weight:700;line-height:1.25;color:var(--color-text);margin:0">{product.name}</h1>
            <p style="font-size:1.25rem;font-weight:800;line-height:1;margin:0" class={pv.isDiscounted ? undefined : '[color:var(--color-accent)]'}>
              <Fragment set:html={priceHtml(pv, { saleLabel: t.store.saleWas })} />
            </p>
            <StoreSaleBanner sale={shopStore.sale} dir="auto" compact product={product} scopeLabel={saleScopeLabel} />
          </div>

          <hr style="border:none;border-top:1px solid var(--color-border);margin:0" />

          <!-- Variants -->
          {(product.variants?.length ?? 0) > 0 && (
            <div class="flex flex-col gap-3 md:gap-5" id="variant-selectors">
              {product.variants!.map((v) => {
                const isColor = isColorVariant(v.name);
                // A dimension with a single option needs no real choice — treat
                // it as already selected instead of making the buyer tap it.
                const isSingleOption = v.options.length === 1;
                return (
                  <div class="flex flex-col gap-2 variant-group" data-variant-group={v.name}>
                    <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--color-muted);margin:0">
                      {v.name}
                    </p>
                    <div class="flex flex-wrap gap-2" role="group" aria-label={v.name}>
                      {v.options.map((opt) => {
                        const { display, hex } = resolveVariantColor(opt);
                        const isActive = isSingleOption;
                        const activeBorder = hex ?? 'var(--color-primary)';
                        const activeBg = hex ? hex + '18' : 'transparent';
                        // Availability for this option combined with the default selection of
                        // every other dimension — client JS recomputes this per-click as the
                        // buyer changes other dimensions (e.g. picking a Size changes which
                        // Colors are in stock).
                        const optionCombo = { ...defaultVariantSelection, [v.name]: opt };
                        const optionStock = (product.variants?.length && product.variantStock)
                          ? (product.variantStock[comboKey(optionCombo)] ?? product.stock)
                          : product.stock;
                        const isAvailable = optionStock > 0;
                        return (
                          <button type="button"
                                  class="variant-opt"
                                  data-variant-name={v.name}
                                  data-variant-value={opt}
                                  data-color-hex={hex ?? undefined}
                                  aria-pressed={isActive ? 'true' : 'false'}
                                  disabled={!isAvailable}
                                  aria-disabled={!isAvailable ? 'true' : undefined}
                                  style={[
                                    'display:inline-flex;align-items:center;gap:0.4rem',
                                    `border:1.5px solid ${isActive ? activeBorder : 'var(--color-border)'}`,
                                    'border-radius:var(--radius)',
                                    'padding:0.45rem 0.9rem',
                                    `font-size:0.875rem;font-weight:${isActive ? 600 : 500}`,
                                    `cursor:${isAvailable ? 'pointer' : 'default'}`,
                                    `background:${isActive ? activeBg : 'transparent'}`,
                                    'color:var(--color-text)',
                                    `opacity:${isAvailable ? '1' : '0.4'}`,
                                    `text-decoration:${isAvailable ? 'none' : 'line-through'}`,
                                    'transition:all 0.15s',
                                    'white-space:nowrap',
                                  ].join(';')}>
                            {isColor && hex && (
                              <span aria-hidden="true"
                                    style={`width:14px;height:14px;border-radius:3px;background:${hex};border:1px solid rgba(0,0,0,0.12);flex-shrink:0;display:inline-block`}></span>
                            )}
                            {display}
                          </button>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          <!-- Stock status for the selected combination — updated live by variant-selector clicks -->
          <p id="stock-status-note" class="flex items-center gap-1.5 text-sm"
             style={`margin:0;color:${initialStatusColor};font-weight:${initialStockState === 'in' ? 500 : 600}`}>
            <span id="stock-status-dot" aria-hidden="true"
                  style={`width:7px;height:7px;border-radius:50%;background:var(--color-success);flex-shrink:0;display:${initialStockState === 'in' ? 'inline-block' : 'none'}`}></span>
            <svg id="stock-status-warn" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
                 style={`display:${initialStockState === 'in' ? 'none' : 'block'}`}>
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span id="stock-status-text">{initialStatusText}</span>
          </p>

          <!-- Cart actions — the wishlist button stays available even when the product is
               out of stock; only the qty+add-to-cart row is gated behind stock.
               Top-aligned (no mt-auto): pinning the CTA to the column's bottom made
               it track the image column's height — extra thumbnails or a variant-less
               product opened a dead gap between the title and the buttons. -->
          <div class="flex flex-col gap-3">
            {product.stock <= 0
              ? <span class="badge badge--muted self-start">{t.store.outOfStock}</span>
              : (
                <div id="product-cta-row" class="flex items-center gap-3">
                  <div dir="ltr" class="qty-stepper flex items-center flex-shrink-0 overflow-hidden"
                       style="border:1px solid var(--color-border);border-radius:var(--radius);height:48px">
                    <button type="button" class="qty-dec flex items-center justify-center transition-colors duration-100 hover:bg-[var(--color-surface)] active:scale-90 disabled:opacity-30 w-10 max-[420px]:w-8 h-full flex-shrink-0"
                            style="color:var(--color-muted);background:none;border:none;cursor:pointer"
                            aria-label={t.cart.qtyDecrease} disabled>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </button>
                    <span class="qty-val text-sm font-semibold text-center select-none min-w-8 max-[420px]:min-w-6 flex-shrink-0"
                          style="color:var(--color-text)"
                          aria-live="polite" aria-atomic="true">1</span>
                    <button type="button" class="qty-inc flex items-center justify-center transition-colors duration-100 hover:bg-[var(--color-surface)] active:scale-90 w-10 max-[420px]:w-8 h-full flex-shrink-0"
                            style="color:var(--color-muted);background:none;border:none;cursor:pointer"
                            aria-label={t.cart.qtyIncrease}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                      </svg>
                    </button>
                  </div>

                  <!-- Add to cart — fills the row (shrinks back once the
                       "to checkout" button appears next to it). -->
                  <button type="button" id="add-to-cart-btn"
                          class="btn flex-auto"
                          style="white-space:nowrap;height:48px;font-size:0.9375rem;font-weight:600"
                          data-slug={product.slug}
                          data-name={product.name}
                          data-price={String(pv.price)}
                          data-base-price={pv.isDiscounted ? String(pv.basePrice) : undefined}
                          data-image={images[0] ?? ''}
                          data-stock={String(product.stock)}
                          data-category={productCategoryPathStr}
                          data-label-added={t.store.addedToCart}>
                    <span class="btn-label">{t.store.addToCart}</span>
                  </button>

                  <a href="/checkout" id="to-checkout-btn" class="btn btn--accent flex-shrink-0"
                     style="display:none;height:48px;white-space:nowrap;align-items:center;justify-content:center;font-size:0.9375rem;font-weight:600">
                    {t.store.toCheckout}
                  </a>
                </div>
              )
            }

                <!-- Wishlist (available even when out of stock) -->
                <button type="button" id="wishlist-btn"
                        class="flex items-center gap-2 text-sm font-medium self-start"
                        style="color:var(--color-muted);background:none;border:none;cursor:pointer;padding:0.25rem 0;visibility:hidden"
                        data-wishlist-slug={product.slug}
                        data-wishlist-name={product.name}
                        data-wishlist-price={String(pv.price)}
                        data-wishlist-image={images[0] ? cdnSrc(images[0]) : ''}
                        data-wishlist-store-slug={shopStore.slug}
                        data-wishlist-store-name={shopStore.name}
                        data-wishlist-stock={String(product.stock)}
                        data-wishlisted="false"
                        aria-pressed="false"
                        aria-label={t.wishlist.addLabel}>
                  <svg id="wishlist-heart" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                  <span id="wishlist-label">{t.wishlist.addLabel}</span>
                </button>
                <script is:inline>
                  (function () {
                    var btn = document.getElementById('wishlist-btn');
                    if (!btn) return;
                    try {
                      var slug = btn.dataset.wishlistSlug;
                      if (slug) {
                        var list = JSON.parse(localStorage.getItem('wishlist_v1') || '[]');
                        if (Array.isArray(list) && list.some(function (i) { return i && i.slug === slug; })) {
                          btn.dataset.wishlisted = 'true';
                          btn.setAttribute('aria-pressed', 'true');
                          var heart = document.getElementById('wishlist-heart');
                          if (heart) { heart.style.fill = '#e53e3e'; heart.style.stroke = '#e53e3e'; }
                          btn.style.color = '#e53e3e';
                        }
                      }
                    } catch (_) {}
                    btn.style.transition = 'color 0.15s, opacity 0.15s';
                    btn.style.visibility = 'visible';
                  })();
                </script>
          </div>
        </div>
      </div>

      <!-- Details zone: full-width description / specs / category.
           Tags are search/discovery metadata only (still emitted in the Product
           JSON-LD `keywords`) — deliberately not shown to shoppers. -->
      {(product.description || (product.specs?.length ?? 0) > 0 || productCategoryName) && (
        <div class="details-card"
             style="margin-top:2.5rem;border:1.5px solid var(--color-border);border-radius:var(--radius);background:var(--color-surface);padding:1.75rem;display:flex;flex-direction:column;gap:1.5rem">

          {product.description && (
            <div style="min-width:0">
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-muted);margin:0 0 0.5rem;letter-spacing:0.06em">
                {lang === 'he' ? 'תיאור המוצר' : 'Description'}
              </p>
              <p dir="auto" id="product-desc" class="text-base leading-relaxed" style="color:var(--color-muted);text-align:justify;overflow-wrap:break-word">{product.description}</p>
            </div>
          )}

          {(product.specs?.length ?? 0) > 0 && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-muted);margin:0 0 0.5rem;letter-spacing:0.06em">
                {t.product.specsTitle}
              </p>
              <table style="width:100%;max-width:420px;border-collapse:collapse;font-size:0.85rem" aria-label={t.product.specsTitle}>
                <tbody>
                  {product.specs!.map((s) => (
                    <tr style="border-bottom:1px solid var(--color-border)">
                      <td style="padding:0.4rem 0;padding-inline-start:0.75rem;padding-inline-end:3rem;color:var(--color-muted);white-space:nowrap;font-weight:500">{s.label}</td>
                      <td dir="auto" style="padding:0.4rem 0;color:var(--color-text);font-weight:400;text-align:end">{s.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {productCategoryName && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-muted);margin:0 0 0.5rem;letter-spacing:0.06em">
                {t.product.categoryLabel ?? (lang === 'he' ? 'קטגוריה' : 'Category')}
              </p>
              <a href={`/${storeSlug}?category=${encodeURIComponent(product.categoryId!)}`}
                 class="hover:bg-[var(--color-bg)] transition-colors duration-150"
                 style="display:inline-flex;align-items:center;gap:0.35rem;border:1px solid var(--color-border);border-radius:9999px;padding:0.25rem 0.75rem;font-size:0.8rem;color:var(--color-text);text-decoration:none">
                {productCategoryName}
              </a>
            </div>
          )}

        </div>
      )}

      <!-- Ask seller about product — subtle link, not shown to store owner -->
      {userId !== shopStore.sellerId && (
        <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--color-border);display:flex;align-items:center;gap:0.5rem">
          <div style="position:relative;display:inline-block">
            <button
              type="button"
              id="ask-product-btn"
              data-store-id={shopStore.id}
              data-seller-id={shopStore.sellerId}
              data-store-name={shopStore.name}
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-store-slug={storeSlug}
              data-is-logged-in={String(isLoggedIn)}
              data-login-url={`/seller/login?next=/${storeSlug}/${productSlug}`}
              style="background:none;border:none;cursor:pointer;font-size:0.82rem;color:var(--color-muted);display:inline-flex;align-items:center;gap:0.35rem;padding:0.2rem 0;text-decoration:underline;text-underline-offset:3px;transition:color 0.15s"
              onmouseover="this.style.color='var(--color-text)'"
              onmouseout="this.style.color='var(--color-muted)'"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
              שאלה על המוצר
            </button>
          </div>
        </div>
      )}

      <!-- Related products -->
      {relatedProducts.length > 0 && (
        <section style="margin-top:2rem;padding-top:2rem;border-top:1px solid var(--color-border)" aria-labelledby="related-heading">
          <p id="related-heading" style="font-size:0.875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-muted);margin:0 0 0.875rem">
            {t.product.moreFrom}{shopStore.name}
          </p>
          <!-- overflow-x:auto forces overflow-y to compute to `auto`, so the box clips
               the cards' hover shadow + 2px lift on every side (top/bottom and the
               first/last card's inline edges). A minimal clearance on all four sides
               gives the (snug) shadow just enough room; the equal negative margin
               cancels it out exactly, so the strip's height/position is unchanged
               from before the shadow existed. -->
          <div style="display:flex;gap:0.625rem;overflow-x:auto;scrollbar-width:none;padding:0.375rem 0.6rem 0.5rem;margin:-0.375rem -0.6rem -0.5rem">
            {relatedProducts.map((p) => {
              const pImgs = p.images ?? [];
              return (
                <div class="related-card"
                     data-slug={p.slug}
                     style="flex:0 0 auto;width:170px;border-radius:var(--radius);overflow:hidden;background:var(--color-surface);cursor:pointer">
                  <a href={`/${shopStore.slug}/${p.slug}`}
                     class="related-card-trigger"
                     style="display:block;text-decoration:none;color:inherit">
                    <div style="width:170px;height:150px;position:relative;overflow:hidden;background:var(--color-surface);border-bottom:1px solid var(--color-border)">
                      {pImgs[0]
                        ? <Image src={cdnSrc(pImgs[0], 340)} alt={p.name} width={170} height={150}
                                 style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 0.3s ease"
                                 loading="lazy" />
                        : <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--color-border)" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                              <line x1="12" y1="22.08" x2="12" y2="12"/>
                            </svg>
                          </div>
                      }
                    </div>
                    <div dir="auto" style="padding:0.5rem 0.6rem 0.6rem">
                      <p style="font-size:0.75rem;font-weight:600;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--color-text)">{p.name}</p>
                      <p style="font-size:0.75rem;font-weight:700;margin:0.2rem 0 0;color:var(--color-accent)"><Fragment set:html={priceHtml(resolvePrice(p, shopStore.sale), { saleLabel: t.store.saleWas })} /></p>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- Mobile-only sticky duplicate of the cart actions — fades in once the
           inline row above scrolls out of view, so "add to cart" stays reachable
           without duplicating IDs or the add-to-cart logic itself. -->
      {product.stock > 0 && (
        <div id="sticky-cart-bar" class="sticky-bottom-bar">
          <div id="sticky-mini-summary">
            {images[0] && (
              <span id="sticky-mini-img-wrap" class="is-loading">
                <img id="sticky-mini-img" data-src={cdnSrc(images[0], 96)} alt="" width="44" height="44" loading="lazy" decoding="async" />
              </span>
            )}
            <span id="sticky-mini-name" dir="auto">{product.name}</span>
            <span id="sticky-mini-price"><Fragment set:html={priceHtml(pv, { saleLabel: t.store.saleWas })} /></span>
          </div>
          <button type="button" id="sticky-add-to-cart-btn" class="btn flex-shrink-0"
                  style="white-space:nowrap;height:44px;font-size:0.9375rem;font-weight:600">
            <span class="btn-label">{t.store.addToCart}</span>
          </button>

          <a href="/checkout" id="sticky-to-checkout-btn" class="btn btn--accent flex-shrink-0"
             style="display:none;height:44px;white-space:nowrap;align-items:center;justify-content:center;font-size:0.9375rem;font-weight:600">
            {t.store.toCheckout}
          </a>
        </div>
      )}
    </main>

    <!-- Site-wide footer (with the "open a store" link) is rendered once by
         BaseLayout — no separate store footer here. -->

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox" hidden aria-modal="true" role="dialog" aria-label={t.product.imageGallery}>
      <div class="lightbox__backdrop" id="lightbox-backdrop"></div>
      <div class="lightbox__panel" data-lb-frame data-lb-label={t.product.loadingImage}>
        <button class="lightbox__close" id="lightbox-close" aria-label={t.product.imageClose}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        <button class="lightbox__arrow lightbox__arrow--prev" id="lightbox-prev" aria-label={t.product.imagePrev}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <img class="lightbox__img transition-[filter,scale] duration-300 ease-out motion-reduce:transition-none" id="lightbox-img" src="" alt={product.name} loading="eager" decoding="async" />
        <button class="lightbox__arrow lightbox__arrow--next" id="lightbox-next" aria-label={t.product.imageNext}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
        <div class="lightbox__counter" id="lightbox-counter"></div>
      </div>
    </div>

  </div>
</BaseLayout>

<script is:inline type="application/json" id="header-search-products" set:html={jsonForScript(
  allStoreProducts.map((p) => ({
    slug: p.slug,
    name: p.name,
    price: resolvePrice(p, shopStore.sale).price,
    // Present only when discounted — the dropdown renders it struck through.
    basePrice: resolvePrice(p, shopStore.sale).isDiscounted ? p.price : undefined,
    image: p.images?.[0] ? cdnSrc(p.images[0], 72) : '',
  }))
)} />

<script>
  import { addItem, getCartQty } from '../../lib/cart.js';
  import { isWishlisted, toggleWishlist } from '../../lib/wishlist.js';
  import { spawnRipple } from '../../lib/ripple.js';
  import { trackViewContent, trackAddToCart } from '../../lib/tracking.js';
  import { comboKey } from '../../lib/variant-combo.js';
  import { isColorVariant } from '../../lib/color-variants.js';
  import { initReadMore } from '../../lib/read-more.js';
  import { saveLastStore } from '../../lib/last-store.js';
  import { cdnSrc } from '../../lib/cdn.js';
  import { setLightboxImage, resetLightboxImage, lightboxWidth, warmLightboxImage, neighbourIndexes } from '../../lib/lightbox-image.js';
  import { spawnHeartBurst } from '../../lib/burst.js';
  import { recordStoreVisit } from '../../lib/recent-stores.js';
  import { initCustomDomainLinks } from '../../lib/custom-domain-links.js';

  const page = document.querySelector<HTMLElement>('.product-detail-page');
  const storeSlug = page?.dataset.storeSlug ?? '';
  const storeName = page?.dataset.storeName ?? '';

  // Clean in-store URLs when served on the store's own verified domain (see custom-domain-links.ts).
  initCustomDomainLinks(storeSlug, page?.dataset.customHost ?? '');

  if (storeSlug) {
    saveLastStore({ slug: storeSlug, name: storeName, url: location.pathname + location.search });
  }
  const images: string[] = JSON.parse(page?.dataset.images ?? '[]');
  const pageLang = page?.dataset.lang ?? 'he';
  const pageVariants: Array<{ name: string; options: string[] }> = JSON.parse(page?.dataset.variants ?? '[]');
  const pageVariantStock: Record<string, number> = JSON.parse(page?.dataset.variantStock ?? '{}');
  const pageVariantImages: Record<string, string> = JSON.parse(page?.dataset.variantImages ?? '{}');

  // Raw stock for a given variant selection — falls back to the product's overall
  // stock when there are no variants, or the seller hasn't set per-combination
  // numbers yet. This is the true total; it's what gets passed to addItem() as
  // product.stock (addItem does its own prev-qty-in-cart math against it, so
  // passing an already-net value here would double-subtract).
  function effectiveStockFor(selection: Record<string, string>): number {
    const btn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
    const total = Math.max(0, parseInt(btn?.dataset.stock ?? '0', 10) || 0);
    if (!pageVariants.length || !Object.keys(pageVariantStock).length) return total;
    const key = comboKey(selection);
    return key in pageVariantStock ? pageVariantStock[key] : total;
  }

  // What's actually still addable for this combo — nets out whatever quantity
  // already sits in the cart (added here, from the product grid, or a quick-view
  // elsewhere). Used for the qty-stepper ceiling and button disabled state only;
  // never passed to addItem() as product.stock (see effectiveStockFor above).
  function remainingFor(selection: Record<string, string>): number {
    const btn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
    const slug = btn?.dataset.slug ?? '';
    const variantsArg = Object.keys(selection).length ? selection : undefined;
    return Math.max(0, effectiveStockFor(selection) - getCartQty(storeSlug, slug, variantsArg));
  }

  // ── ViewContent — fire once on product page load ───────────────
  {
    const addBtnEl = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
    if (addBtnEl?.dataset.slug) {
      trackViewContent({
        id: addBtnEl.dataset.slug,
        name: addBtnEl.dataset.name ?? '',
        price: Number(addBtnEl.dataset.price ?? 0),
        category: addBtnEl.dataset.category,
      });
    }
  }

  // ── Recently visited stores (CURRENT_TASK.md → סשן ב׳ 1+3): landing on any
  // product counts as visiting its store — records the store into the
  // per-browser cookie the homepage's "ביקרת לאחרונה" shelf reads (SSR). Only
  // fires the account-sync event when the cookie actually changed (a repeat
  // visit to the store already at the front is a no-op).
  if (storeSlug && recordStoreVisit(storeSlug)) {
    window.dispatchEvent(new CustomEvent('recent-stores:change'));
  }

  // ── Variant selector ───────────────────────────────────────────
  // No dimension is pre-selected — the buyer must actively tap a size/color/etc.
  // before add-to-cart will proceed (see flagMissingVariants below) — except a
  // dimension with only one option, which has no real choice to make and is
  // pre-selected (matches the server-rendered active swatch above).
  const selectedVariants: Record<string, string> = {};
  pageVariants.forEach((v) => { if (v.options.length === 1) selectedVariants[v.name] = v.options[0]; });

  // Plain scrollIntoView doesn't know the mobile sticky add-to-cart bar (or the
  // fixed site header) visually covers part of the viewport — an element can
  // count as "in view" per the browser while actually sitting behind one of
  // them. Scroll against their real edges instead of the raw viewport bounds.
  function scrollGroupIntoView(el: HTMLElement): void {
    const rect = el.getBoundingClientRect();
    const stickyBar = document.querySelector<HTMLElement>('.sticky-bottom-bar.is-visible');
    const bottomLimit = stickyBar ? stickyBar.getBoundingClientRect().top : window.innerHeight;
    const headerEl = document.querySelector<HTMLElement>('header');
    const topLimit = headerEl ? headerEl.getBoundingClientRect().bottom : 0;
    if (rect.bottom > bottomLimit) {
      window.scrollBy({ top: rect.bottom - bottomLimit + 16, behavior: 'smooth' });
    } else if (rect.top < topLimit) {
      window.scrollBy({ top: rect.top - topLimit - 16, behavior: 'smooth' });
    }
  }

  // Missing-selection feedback: a subtle shake + temporary ring on whichever
  // dimension(s) haven't been chosen yet, instead of a blocking modal/alert —
  // called right before add-to-cart actually adds the item.
  function flagMissingVariants(): boolean {
    let firstMissing: HTMLElement | null = null;
    pageVariants.forEach((v) => {
      if (selectedVariants[v.name]) return;
      const group = document.querySelector<HTMLElement>(`.variant-group[data-variant-group="${CSS.escape(v.name)}"]`);
      if (!group) return;
      group.classList.remove('variant-group--invalid');
      void group.offsetWidth;
      group.classList.add('variant-group--invalid');
      setTimeout(() => group.classList.remove('variant-group--invalid'), 650);
      if (!firstMissing) firstMissing = group;
    });
    if (firstMissing) scrollGroupIntoView(firstMissing);
    return !!firstMissing;
  }

  // Disables (rather than hides) any option whose combo — combined with the buyer's
  // current picks for every other dimension — is out of stock, so the set of choices
  // stays visible and only recomputes as other dimensions change.
  function updateVariantAvailability(): void {
    document.querySelectorAll<HTMLButtonElement>('.variant-opt').forEach((b) => {
      const bName = b.dataset.variantName ?? '';
      const bValue = b.dataset.variantValue ?? '';
      const available = remainingFor({ ...selectedVariants, [bName]: bValue }) > 0;
      b.disabled = !available;
      b.setAttribute('aria-disabled', String(!available));
      b.style.opacity = available ? '1' : '0.4';
      b.style.cursor = available ? 'pointer' : 'default';
      b.style.textDecoration = available ? 'none' : 'line-through';
    });
  }
  updateVariantAvailability();

  document.querySelectorAll<HTMLButtonElement>('.variant-opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const vName = btn.dataset.variantName ?? '';
      const vValue = btn.dataset.variantValue ?? '';
      selectedVariants[vName] = vValue;
      document.querySelector<HTMLElement>(`.variant-group[data-variant-group="${CSS.escape(vName)}"]`)?.classList.remove('variant-group--invalid');
      document.querySelectorAll<HTMLButtonElement>(`.variant-opt[data-variant-name="${CSS.escape(vName)}"]`).forEach((b) => {
        const active = b === btn;
        const hex = b.dataset.colorHex ?? null;
        b.setAttribute('aria-pressed', String(active));
        b.style.borderColor = active ? (hex ?? 'var(--color-primary)') : 'var(--color-border)';
        b.style.background = active ? (hex ? hex + '18' : 'transparent') : 'none';
        b.style.color = 'var(--color-text)';
        b.style.fontWeight = active ? '600' : '500';
      });
      updateVariantAvailability();
      applyStockState();
      // Color chip may carry its own linked photo (seller-assigned in the
      // dashboard) — swap the main image to it, same visual result as
      // clicking that image's own thumbnail. Uses switchMainImage(), a
      // hoisted function declared further down with the rest of the
      // thumbnail-switcher logic — safe to call here since this callback
      // only ever runs on a real click, well after the whole module has run.
      if (isColorVariant(vName)) {
        const url = pageVariantImages[vValue];
        const idx = url ? images.indexOf(url) : -1;
        if (idx !== -1) switchMainImage(idx);
      }
    });
  });

  // ── Main image carousel + thumbnails ───────────────────────────────
  const mainSlides = document.getElementById('main-slides');
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');
  let activeIndex = 0;

  // ── Skeleton: remove shimmer once the initial images load ───────────
  const mainImgWrapEl = document.getElementById('main-img-wrap');
  const firstMainImg = document.getElementById('main-img') as HTMLImageElement | null;
  if (firstMainImg && mainImgWrapEl) {
    const doneMain = () => mainImgWrapEl.classList.remove('is-loading');
    if (firstMainImg.complete && firstMainImg.naturalWidth > 0) doneMain();
    else {
      firstMainImg.addEventListener('load', doneMain, { once: true });
      firstMainImg.addEventListener('error', doneMain, { once: true });
    }
  }
  document.querySelectorAll<HTMLImageElement>('.thumb-btn img').forEach((img) => {
    const wrap = img.closest<HTMLElement>('.thumb-btn');
    if (!wrap) return;
    const done = () => wrap.classList.remove('is-loading');
    if (img.complete && img.naturalWidth > 0) done();
    else {
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    }
  });

  function setThumbActive(idx: number) {
    thumbBtns.forEach((b) => {
      const isActive = Number(b.dataset.imgIndex) === idx;
      b.setAttribute('aria-pressed', String(isActive));
      b.style.opacity = isActive ? '1' : '0.55';
      b.style.borderColor = isActive ? 'var(--color-text)' : 'transparent';
    });
  }

  // The main image is a native horizontal scroll-snap carousel — swipe or
  // trackpad-scroll horizontally to move one image at a time, exactly like the
  // product-card / quick-view carousels but with no dot overlay (the thumbnail
  // strip is the indicator). Vertical scroll is never captured, so the page
  // scrolls normally over the image, and `overscroll-behavior-inline:contain`
  // (on #main-slides) stops an edge swipe from triggering browser back.
  const slidesRtl = mainSlides ? getComputedStyle(mainSlides).direction === 'rtl' : false;
  const getMainSlideW = () => mainSlides?.offsetWidth || 1;

  // Hoisted `function` so the color-variant handler above can call it before
  // its definition here — scrolls the carousel to a linked image.
  function switchMainImage(idx: number): void {
    if (!mainSlides) return;
    activeIndex = idx;
    mainSlides.scrollTo({ left: (slidesRtl ? -1 : 1) * idx * getMainSlideW(), behavior: 'smooth' });
    setThumbActive(idx);
  }

  if (mainSlides) {
    // Update the active thumbnail live (rAF-throttled) so its highlight flips
    // the instant the scroll crosses the halfway point into the next image,
    // rather than only after scrolling has settled.
    let scrollRaf: number | undefined;
    mainSlides.addEventListener('scroll', () => {
      if (scrollRaf !== undefined) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = undefined;
        const idx = Math.min(Math.round(Math.abs(mainSlides.scrollLeft) / getMainSlideW()), images.length - 1);
        if (idx !== activeIndex) { activeIndex = idx; setThumbActive(idx); }
      });
    }, { passive: true });
  }

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      switchMainImage(Number(btn.dataset.imgIndex ?? 0));
    });
  });

  // Note: the main image intentionally does NOT hijack wheel/scroll to cycle
  // gallery images — that trapped normal page scrolling and, past the last
  // image, a horizontal trackpad swipe fell through to the browser's own
  // back-navigation. Images are switched via the thumbnail strip and the
  // lightbox arrows; the page scrolls normally over the image.

  // Warm the browser cache for the other gallery images at the same width
  // the main image uses, once the page is idle — so by the time a thumbnail
  // is actually clicked, the swap is instant instead of a fresh fetch.
  const runWhenIdle = (cb: () => void) => {
    if ('requestIdleCallback' in window) window.requestIdleCallback(cb);
    else setTimeout(cb, 800);
  };
  runWhenIdle(() => {
    thumbBtns.forEach((btn, i) => {
      if (i === 0) return;
      const src = btn.dataset.imgSrc;
      if (src) new Image().src = src;
    });
  });

  // ── Lightbox ───────────────────────────────────────────────────────
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbPrev = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
  const lbNext = document.getElementById('lightbox-next') as HTMLButtonElement | null;
  const lbClose = document.getElementById('lightbox-close') as HTMLButtonElement | null;
  const lbCounter = document.getElementById('lightbox-counter');
  let lbIndex = 0;

  function updateLbCounter() {
    if (!lbCounter) return;
    if (images.length <= 1) { lbCounter.hidden = true; return; }
    lbCounter.textContent = `${lbIndex + 1} / ${images.length}`;
    lbCounter.hidden = false;
  }

  function openLightbox(idx: number) {
    if (!lightbox || images.length === 0) return;
    lbIndex = Math.max(0, Math.min(idx, images.length - 1));
    if (lbImg) showLbImage();
    if (lbPrev) lbPrev.hidden = images.length <= 1;
    if (lbNext) lbNext.hidden = images.length <= 1;
    updateLbCounter();
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    resetLightboxImage(lbImg);
  }

  // The enlarged view opens on the slide the gallery ALREADY downloaded
  // (softened) and settles onto the full-screen render — the frame is never
  // black while the big one arrives. `currentSrc`, not a re-derived w_800 URL:
  // this gallery carries a srcset, so which width is actually in cache depends
  // on viewport and DPR, and guessing wrong would fetch a third size for nothing.
  function showLbImage() {
    if (!lbImg) return;
    const src = images[lbIndex] ?? '';
    const w = lightboxWidth(lbImg);
    const slide = mainSlides?.querySelectorAll<HTMLImageElement>('img')[lbIndex];
    setLightboxImage(lbImg, {
      full: cdnSrc(src, w),
      preview: slide?.currentSrc || cdnSrc(src, 800),
      neighbours: neighbourIndexes(images.length, lbIndex).map(i => cdnSrc(images[i] ?? '', w)),
    });
  }

  // The lightbox navigates independently — moving between enlarged images must
  // NOT drive the gallery behind it (that "controls the images in the back"
  // effect the user flagged). The main image only changes via its own thumbnails.
  function goLightbox(dir: 1 | -1) {
    lbIndex = (lbIndex + dir + images.length) % images.length;
    updateLbCounter();
    // The current image stays put until the next one has decoded, so there's no
    // blank/opacity flash (the "screen jumps, image vanishes then returns" the
    // user reported) — that hand-off now lives in `setLightboxImage`.
    showLbImage();
  }

  const mainWrap = document.getElementById('main-img-wrap');
  // Ignore the click that ends a horizontal drag-scroll through the carousel —
  // only a genuine tap (no scroll movement) should open the lightbox.
  let mainPressScroll = 0;
  mainSlides?.addEventListener('pointerdown', () => { mainPressScroll = mainSlides.scrollLeft; });
  mainWrap?.addEventListener('click', () => {
    if (mainSlides && Math.abs(mainSlides.scrollLeft - mainPressScroll) > 3) return;
    openLightbox(activeIndex);
  });
  mainWrap?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(activeIndex); }
  });
  // Hovering the image is the buyer telling us they're about to enlarge it —
  // start the bigger render now, while they're still looking at the small one,
  // instead of making them watch it download after the click.
  mainWrap?.addEventListener('pointerenter', () => {
    warmLightboxImage(cdnSrc(images[activeIndex] ?? '', lightboxWidth(lbImg)));
  });
  lbClose?.addEventListener('click', closeLightbox);
  lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); goLightbox(-1); });
  lbNext?.addEventListener('click', (e) => { e.stopPropagation(); goLightbox(1); });
  lightbox?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('.lightbox__arrow') && !t.closest('.lightbox__close')) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') goLightbox(pageLang === 'he' ? 1 : -1);
    if (e.key === 'ArrowRight') goLightbox(pageLang === 'he' ? -1 : 1);
  });

  // ── Qty stepper ────────────────────────────────────────────────────
  const qtyDec = document.querySelector<HTMLButtonElement>('.qty-dec');
  const qtyInc = document.querySelector<HTMLButtonElement>('.qty-inc');
  const qtyVal = document.querySelector<HTMLElement>('.qty-val');
  const addBtn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
  // maxStock is the combo's raw total stock — passed to addItem() as-is (addItem
  // does its own prev-qty-in-cart math against it). remaining is what's left to
  // add right now (nets out cart contents) — drives the stepper/button/note only.
  let maxStock = Math.max(0, effectiveStockFor(selectedVariants));
  let remaining = Math.max(0, remainingFor(selectedVariants));
  let qty = 1;

  function updateQty(n: number) {
    qty = Math.max(1, Math.min(n, Math.max(1, remaining)));
    if (qtyVal) qtyVal.textContent = String(qty);
    if (qtyDec) qtyDec.disabled = qty <= 1;
    if (qtyInc) qtyInc.disabled = qty >= remaining;
  }

  // Re-derives the stock ceiling for whichever combo is currently selected —
  // called on every variant-swatch click. Distinct from the page's initial
  // out-of-stock state (product.stock <= 0, server-rendered) which governs
  // whether the qty/add-to-cart row exists at all; this only reacts to a
  // *specific combination* being sold out while the product overall isn't.
  function applyStockState(): void {
    maxStock = Math.max(0, effectiveStockFor(selectedVariants));
    remaining = Math.max(0, remainingFor(selectedVariants));
    const outOfStock = remaining <= 0;

    qty = outOfStock ? 0 : Math.min(qty, remaining);
    if (qtyVal) qtyVal.textContent = String(Math.max(qty, outOfStock ? 0 : 1));
    if (qtyDec) qtyDec.disabled = outOfStock || qty <= 1;
    if (qtyInc) qtyInc.disabled = outOfStock || qty >= remaining;
    if (!outOfStock && qty < 1) updateQty(1);

    [addBtn, stickyAddBtn].forEach((btn) => { if (btn) btn.disabled = outOfStock; });

    const note = document.getElementById('stock-status-note') as HTMLElement | null;
    const noteText = document.getElementById('stock-status-text');
    const noteDot = document.getElementById('stock-status-dot');
    const noteWarn = document.getElementById('stock-status-warn');
    if (!note || !noteText || !noteDot || !noteWarn) return;
    const isLow = !outOfStock && remaining <= 5;
    note.style.fontWeight = outOfStock || isLow ? '600' : '500';
    noteDot.style.display = outOfStock || isLow ? 'none' : 'inline-block';
    noteWarn.style.display = outOfStock || isLow ? 'block' : 'none';
    if (outOfStock) {
      note.style.color = 'var(--color-danger)';
      noteText.textContent = getPMI18n().outOfStock || (pageLang === 'he' ? 'אזל מהמלאי' : 'Out of stock');
    } else if (isLow) {
      note.style.color = 'var(--color-warning)';
      noteText.textContent = pageLang === 'he' ? `נותרו ${remaining} בלבד` : `Only ${remaining} left`;
    } else {
      note.style.color = 'var(--color-muted)';
      noteText.textContent = getPMI18n().inStockLabel || (pageLang === 'he' ? 'במלאי' : 'In stock');
    }
  }

  qtyDec?.addEventListener('click', (e) => { spawnRipple(qtyDec, e.clientX, e.clientY); updateQty(qty - 1); });
  qtyInc?.addEventListener('click', (e) => { spawnRipple(qtyInc, e.clientX, e.clientY); updateQty(qty + 1); });

  // ── Mobile sticky bar: appears once the real "add to cart" button scrolls
  //    out of view — including right on load, if it starts below the fold
  //    (e.g. a tall variant list pushes it down while the image is still visible) ──
  const stickyCartBar = document.getElementById('sticky-cart-bar');
  const stickyMiniImg = document.getElementById('sticky-mini-img') as HTMLImageElement | null;
  const stickyMiniSummary = document.getElementById('sticky-mini-summary');
  const productNameHeading = document.getElementById('product-name-heading');
  if (stickyCartBar && addBtn) {
    new IntersectionObserver(([entry]) => {
      stickyCartBar.classList.toggle('is-visible', !entry.isIntersecting);
    }, { rootMargin: '-56px 0px 0px 0px' }).observe(addBtn);
  }

  // The bar's own image+name only join in once the real ones scroll out of
  // view too — while they're still visible up top, the bar shows buttons only.
  // In that buttons-only state "add to cart" fills the bar (same flex-auto
  // pattern as the inline #add-to-cart-btn) instead of hugging its own
  // content — if checkout later joins it, it shrinks to make room for it,
  // same as everywhere else, rather than snapping back to a small fixed size.
  function updateStickyBarSoloWidth(): void {
    const isCollapsed = stickyMiniSummary?.classList.contains('is-collapsed') ?? false;
    stickyAddBtn?.classList.toggle('sticky-btn--solo', isCollapsed);
  }
  if (stickyMiniSummary && productNameHeading) {
    new IntersectionObserver(([entry]) => {
      stickyMiniSummary.classList.toggle('is-collapsed', entry.isIntersecting);
      // Defer the thumbnail fetch until it's about to be shown — it's fixed-position
      // and always laid out, so native loading="lazy" can't tell it's off-screen.
      if (!entry.isIntersecting && stickyMiniImg && stickyMiniImg.dataset.src) {
        const stickyImgWrap = stickyMiniImg.closest<HTMLElement>('#sticky-mini-img-wrap');
        const doneSticky = () => stickyImgWrap?.classList.remove('is-loading');
        stickyMiniImg.addEventListener('load', doneSticky, { once: true });
        stickyMiniImg.addEventListener('error', doneSticky, { once: true });
        stickyMiniImg.src = stickyMiniImg.dataset.src;
        stickyMiniImg.removeAttribute('data-src');
      }
      updateStickyBarSoloWidth();
    }, { rootMargin: '-56px 0px 0px 0px' }).observe(productNameHeading);
  }

  // Sticky bar: clicking the thumbnail or name scrolls back to the top of the
  // page — no cursor:pointer, this is a quiet affordance, not a link.
  const stickyMiniName = document.getElementById('sticky-mini-name');
  [stickyMiniImg, stickyMiniName].forEach((el) => {
    el?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  });

  // ── Add to cart ────────────────────────────────────────────────────
  const toCheckoutBtn = document.getElementById('to-checkout-btn') as HTMLAnchorElement | null;
  toCheckoutBtn?.addEventListener('pointerdown', (e) => spawnRipple(toCheckoutBtn, e.clientX, e.clientY));
  if (addBtn) {
    const checkSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>';
    const labelSpan = addBtn.querySelector<HTMLElement>('.btn-label');
    if (labelSpan) labelSpan.style.cssText = 'display:inline-flex;align-items:center;gap:4px';
    const originalLabel = labelSpan?.innerHTML ?? '';

    addBtn.addEventListener('pointerdown', (e) => spawnRipple(addBtn, e.clientX, e.clientY));
    addBtn.addEventListener('click', () => {
      if (addBtn.disabled) return;
      if (pageVariants.length && flagMissingVariants()) return;
      const { slug = '', name = '', price = '0', image = '', category = '' } = addBtn.dataset;
      const variantsCopy = Object.keys(selectedVariants).length ? { ...selectedVariants } : undefined;
      addItem(storeSlug, storeName, { slug, name, price: Number(price), image, stock: maxStock }, qty, variantsCopy, false);
      trackAddToCart({ id: slug, name, price: Number(price), category }, qty);
      updateQty(1);

      if (toCheckoutBtn) toCheckoutBtn.style.display = 'inline-flex';
      if (stickyToCheckoutBtn) stickyToCheckoutBtn.style.display = 'inline-flex';
      updateStickyBarSoloWidth();
      addBtn.style.minWidth = `${addBtn.offsetWidth}px`;
      if (labelSpan) labelSpan.innerHTML = `${checkSvg}${addBtn.dataset.labelAdded ?? ''}`;
      addBtn.disabled = true;
      addBtn.classList.add('btn--confirmed');

      addBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );

      setTimeout(() => {
        if (labelSpan) labelSpan.innerHTML = originalLabel;
        addBtn.style.minWidth = '';
        addBtn.classList.remove('btn--confirmed');
        applyStockState(); // re-enables only if stock remains, not blindly
      }, 1400);
    });
  }

  // ── Mobile sticky bar: its own add-to-cart button, mirrors the same action
  //    and shows its own success state (the inline button may be off-screen) ──
  const stickyAddBtn = document.getElementById('sticky-add-to-cart-btn') as HTMLButtonElement | null;
  const stickyToCheckoutBtn = document.getElementById('sticky-to-checkout-btn') as HTMLAnchorElement | null;
  stickyToCheckoutBtn?.addEventListener('pointerdown', (e) => spawnRipple(stickyToCheckoutBtn, e.clientX, e.clientY));
  if (addBtn && stickyAddBtn) {
    const stickyCheckSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>';
    const stickyLabelSpan = stickyAddBtn.querySelector<HTMLElement>('.btn-label');
    if (stickyLabelSpan) stickyLabelSpan.style.cssText = 'display:inline-flex;align-items:center;gap:4px';
    const stickyOriginalLabel = stickyLabelSpan?.innerHTML ?? '';

    stickyAddBtn.addEventListener('pointerdown', (e) => spawnRipple(stickyAddBtn, e.clientX, e.clientY));
    stickyAddBtn.addEventListener('click', () => {
      if (addBtn.disabled || stickyAddBtn.disabled) return;
      if (pageVariants.length && flagMissingVariants()) return;
      const { slug = '', name = '', price = '0', image = '', category = '' } = addBtn.dataset;
      const variantsCopy = Object.keys(selectedVariants).length ? { ...selectedVariants } : undefined;
      addItem(storeSlug, storeName, { slug, name, price: Number(price), image, stock: maxStock }, qty, variantsCopy, false);
      trackAddToCart({ id: slug, name, price: Number(price), category }, qty);
      updateQty(1);

      if (stickyToCheckoutBtn) stickyToCheckoutBtn.style.display = 'inline-flex';
      if (toCheckoutBtn) toCheckoutBtn.style.display = 'inline-flex';
      updateStickyBarSoloWidth();
      stickyAddBtn.style.minWidth = `${stickyAddBtn.offsetWidth}px`;
      if (stickyLabelSpan) stickyLabelSpan.innerHTML = `${stickyCheckSvg}${addBtn.dataset.labelAdded ?? ''}`;
      stickyAddBtn.disabled = true;
      stickyAddBtn.classList.add('btn--confirmed');

      stickyAddBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );

      setTimeout(() => {
        if (stickyLabelSpan) stickyLabelSpan.innerHTML = stickyOriginalLabel;
        stickyAddBtn.style.minWidth = '';
        stickyAddBtn.classList.remove('btn--confirmed');
        applyStockState(); // re-enables only if stock remains, not blindly
      }, 1400);
    });
  }

  // Sync button/qty-stepper disabled state with the default combo's stock —
  // the status note itself is already server-rendered correctly, this covers
  // the edge case of the *default* variant selection being sold out while the
  // product's overall stock (which gates whether this row renders at all) isn't.
  applyStockState();
  window.addEventListener('cart:change', applyStockState);

  {
    const descEl = document.getElementById('product-desc');
    if (descEl) {
      initReadMore(descEl, 2, {
        more: pageLang === 'he' ? 'עוד' : 'More',
        less: pageLang === 'he' ? 'פחות' : 'Less',
      });
    }
  }

  // ── Wishlist ───────────────────────────────────────────────────────
  const wishlistBtn = document.getElementById('wishlist-btn') as HTMLButtonElement | null;
  const wishlistHeart = document.getElementById('wishlist-heart') as SVGElement | null;
  const wishlistLabel = document.getElementById('wishlist-label');

  function setWishlistStyle(active: boolean) {
    if (!wishlistBtn || !wishlistHeart) return;
    if (active) {
      (wishlistHeart as unknown as HTMLElement).style.fill = '#e53e3e';
      (wishlistHeart as unknown as HTMLElement).style.stroke = '#e53e3e';
      wishlistBtn.style.color = '#e53e3e';
    } else {
      (wishlistHeart as unknown as HTMLElement).style.fill = 'none';
      (wishlistHeart as unknown as HTMLElement).style.stroke = 'currentColor';
      wishlistBtn.style.color = '';
    }
  }

  function getI18nWishlist(): Record<string, string> {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}')?.wishlist ?? {}; } catch { return {}; }
  }

  if (wishlistBtn) {
    const slug = wishlistBtn.dataset.wishlistSlug ?? '';
    const active = isWishlisted(slug);
    wishlistBtn.dataset.wishlisted = String(active);
    wishlistBtn.setAttribute('aria-pressed', String(active));
    setWishlistStyle(active);

    const wi = getI18nWishlist();
    if (active && wishlistLabel) wishlistLabel.textContent = wi['removeLabel'] ?? wishlistLabel.textContent;

    wishlistBtn.addEventListener('click', () => {
      const item = {
        slug,
        name: wishlistBtn.dataset.wishlistName ?? '',
        price: Number(wishlistBtn.dataset.wishlistPrice ?? 0),
        image: wishlistBtn.dataset.wishlistImage ?? '',
        storeSlug: wishlistBtn.dataset.wishlistStoreSlug ?? '',
        storeName: wishlistBtn.dataset.wishlistStoreName ?? '',
        stock: wishlistBtn.dataset.wishlistStock !== undefined ? Number(wishlistBtn.dataset.wishlistStock) : undefined,
      };
      const nowActive = toggleWishlist(item);
      wishlistBtn.dataset.wishlisted = String(nowActive);
      wishlistBtn.setAttribute('aria-pressed', String(nowActive));
      wishlistBtn.setAttribute('aria-label', nowActive ? (wi['removeLabel'] ?? '') : (wi['addLabel'] ?? ''));
      if (wishlistLabel) wishlistLabel.textContent = nowActive ? (wi['removeLabel'] ?? '') : (wi['addLabel'] ?? '');
      setWishlistStyle(nowActive);
      if (nowActive) spawnHeartBurst(wishlistBtn);
      fetch('/api/wishlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: nowActive ? 'add' : 'remove', productSlug: slug }),
      });
    });
  }

  // ── Stock-status i18n (read from the server-embedded #pm-i18n blob) ──
  function getPMI18n(): Record<string, string> {
    try { return JSON.parse(document.getElementById('pm-i18n')?.textContent ?? '{}') as Record<string, string>; }
    catch { return {}; }
  }

  // ── Related cards → shared store product modal ────────────────────
  // Opens the exact same modal a store-page product card opens (the shared
  // StoreProductModal, rendered in BaseLayout) — one source of truth, so it
  // can't drift into an outdated look again. The modal fetches its own data
  // from /api/store-product by slug, so the card only needs a slug; the
  // <a href> stays a real link, so middle/ctrl-click still opens the full page.
  document.querySelectorAll<HTMLElement>('.related-card').forEach((card) => {
    const link = card.querySelector<HTMLAnchorElement>('.related-card-trigger');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      const slug = card.dataset.slug ?? '';
      if (slug) window.dispatchEvent(new CustomEvent('store-product-modal:open', { detail: { storeSlug, productSlug: slug, storeName } }));
    });
  });

  // ── Login hint (shared helper) ────────────────────────────────
  function showLoginHint(btn: HTMLElement) {
    const existing = btn.parentElement?.querySelector('.login-hint-popup');
    if (existing) { existing.remove(); return; }
    const loginUrl = btn.dataset.loginUrl ?? '/seller/login';
    const hint = document.createElement('div');
    hint.className = 'login-hint-popup';
    hint.setAttribute('role', 'status');
    hint.innerHTML = `<span>כדי לשלוח הודעה יש <a href="${loginUrl}" style="color:var(--color-accent);font-weight:600;text-decoration:underline">להתחבר</a></span>`;
    hint.style.cssText = 'position:absolute;top:calc(100% + 0.4rem);inset-inline-start:0;z-index:50;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:0.45rem 0.8rem;white-space:nowrap;box-shadow:0 4px 18px rgba(0,0,0,0.11);font-size:0.8rem;color:var(--color-text)';
    hint.animate([{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease', fill: 'forwards' });
    const container = btn.parentElement ?? btn;
    container.appendChild(hint);
    const dismiss = () => { hint.remove(); document.removeEventListener('click', outsideClick); };
    const outsideClick = (e: MouseEvent) => { if (!hint.contains(e.target as Node) && e.target !== btn) dismiss(); };
    setTimeout(() => document.addEventListener('click', outsideClick), 10);
    setTimeout(dismiss, 5000);
  }

  // ── Ask about product button ──────────────────────────────────
  const askBtn = document.getElementById('ask-product-btn') as HTMLButtonElement | null;
  askBtn?.addEventListener('click', () => {
    if (askBtn.dataset.isLoggedIn !== 'true') {
      showLoginHint(askBtn);
      return;
    }
    window.dispatchEvent(new CustomEvent('message:compose', {
      detail: {
        storeId: askBtn.dataset.storeId ?? '',
        sellerId: askBtn.dataset.sellerId ?? '',
        storeName: askBtn.dataset.storeName ?? '',
        productRef: {
          productId: askBtn.dataset.productId ?? '',
          productName: askBtn.dataset.productName ?? '',
          productSlug: askBtn.dataset.productSlug ?? '',
          storeSlug: askBtn.dataset.storeSlug ?? '',
        },
      },
    }));
  });
</script>
