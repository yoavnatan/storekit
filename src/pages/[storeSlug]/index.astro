---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreAvatar from '../../components/StoreAvatar.astro';
import LoadingSweep from '../../components/LoadingSweep.astro';
import StoreDemoBar from '../../components/StoreDemoBar.astro';
import StoreDemoMark from '../../components/StoreDemoMark.astro';
import StoreDemoBanner from '../../components/StoreDemoBanner.astro';
import StoreSaleBanner from '../../components/StoreSaleBanner.astro';
import OwnerStoreBar from '../../components/OwnerStoreBar.astro';
import { getStoreBySlug, getStoreByPreviousSlug, isStoreVisible, storeHttpStatus, showsPausedNotice, storeHeaderLogo } from '../../lib/stores.js';
import { isDemoStore } from '../../lib/demo-stores.js';
import { isStoreReady } from '../../lib/store-readiness.js';
import { formatStoreHours, formatStoreHoursSchema, googleMapsSearchUrl } from '../../lib/store-hours.js';
import { getVisibleProductsByStoreId } from '../../lib/store-products.js';
import { getPurchasedCountsByStoreSlug } from '../../lib/orders.js';
import { filterAndSortProducts, PRODUCTS_PAGE_SIZE } from '../../lib/product-listing.js';
import { getCategoriesByStoreId, buildCategoryTree, getAncestorChain, resolveCategoryFilterIds, categoryPath, countProductsPerCategory, categoryUrlParam, findCategoryByParam } from '../../lib/store-categories.js';
import { saleScopeCategoryLabel } from '../../lib/store-sale-scope.js';
import { BLANK_PIXEL } from '../../lib/blank-pixel.js';
import { machineUrl, urlSegment } from '../../lib/url-base.js';
import { storeCanonicalUrl, customDomainRedirectUrl, isPlatformAdLanding, adLandingUrl , hasActiveCustomDomain } from '../../lib/custom-domain.js';
import { platformBoundaryData } from '../../lib/cross-origin-handoff.js';
import { OG_IMAGE_FORMAT, resolveStoreImage, storeImageUrl } from '../../lib/store-image.js';
import { store as platform, cdnSrc, cdnSrcSet, cdnCropSrcSet, cdnBand } from '../../config/store.config.js';
import { BANNER_RATIO, BANNER_WIDTHS } from '../../lib/cdn.js';
import { getSellerSession } from '../../lib/seller-auth.js';
import { getLang, getT, getDir } from '../../i18n/index.js';
import { isStoreFavorited } from '../../lib/user-carts.js';
import { jsonForScript } from '../../lib/json-script.js';
import { resolvePrice } from '../../lib/discounts.js';
import { priceHtml, saleBadgeHtml } from '../../lib/price-html.js';

const { storeSlug: slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const shopStore = await getStoreBySlug(slug);
if (!shopStore) {
  // The seller may have renamed the store URL — 301 an old slug to the current one so links +
  // Google's index carry over instead of 404-ing (see renameStoreSlug).
  const moved = await getStoreByPreviousSlug(slug);
  // `machineUrl`: a store slug carries Hebrew, and a Hebrew Location header throws instead of
  // redirecting (url-base.ts#machineUrl) — this is the 301 that keeps a renamed store's links alive.
  if (moved) return Astro.redirect(machineUrl(`/${moved.slug}${Astro.url.search}`), 301);
  return Astro.redirect('/404');
}
// Not serving a storefront at all: an admin block (admin-moderation.ts) answers 404, so the store
// stops accumulating crawl/index signal while it is under review; a store its seller closed for
// good answers 410 Gone, which drops it from the index faster and more definitively.
//
// REWRITTEN, not redirected (2026-07-31). A redirect made the store's own URL answer 302 and put
// the real status on /404 — so a crawler recorded "this store moved to an error page" instead of
// "this store is gone", which is a weaker and slower signal, and the address bar left the URL the
// shopper actually followed. A rewrite renders the same page AT this URL and carries its status
// (404.astro sets it), which is what both Google and the shopper should be given.
if (!isStoreVisible(shopStore)) {
  return Astro.rewrite(storeHttpStatus(shopStore) === 410 ? '/store-gone' : '/404');
}
// Operational halt by the seller (store-status.ts). The URL keeps working — no redirect, no 404,
// so every existing link still resolves — but it serves the notice INSTEAD of the catalog: a
// shopper cannot do anything with a product they are not allowed to buy, and a grid of disabled
// buttons reads as a broken page rather than a closed one (decided with the owner 2026-07-31).
// Rewritten here, before any product/category/sale/page-view work, so a halted store costs
// nothing to serve. /api/checkout refuses it regardless of what any page renders.
if (showsPausedNotice(shopStore)) {
  return Astro.rewrite('/store-unavailable');
}

// A landing published by the platform's own ads stays on the platform domain — the one domain the
// Merchant Center / Meta account can claim (custom-domain.ts#AD_LANDING_PARAM). A brand campaign
// points at a store home, so this page needs the same exemption the product page has.
const adLanding = isPlatformAdLanding(shopStore, Astro.url, Astro.request.headers.get('host'));
// SEO: once the seller's own domain is verified it becomes the store's home — every hit on the
// platform path (including the old default URL the store used for months) 301s there so all the
// accumulated ranking consolidates onto the seller's domain. No-op when already served on it.
const cdRedirect = adLanding
  ? null
  : customDomainRedirectUrl(shopStore, Astro.request.headers.get('host'), Astro.url.search);
if (cdRedirect) return Astro.redirect(cdRedirect, 301);

// The origin boundary, computed HERE and not in the markup: `platformBoundaryData` sets a
// `Cache-Control` header, and Astro streams the body — a header written from a template expression
// is written after the status line has already left. Frontmatter is the last place it still counts.
// Only a store on its own domain has a boundary to cross; on the platform this is null and the
// attribute is never emitted.
const platformBoundary = hasActiveCustomDomain(shopStore)
  ? platformBoundaryData(Astro.cookies, Astro.response.headers)
  : null;

const userId = getSellerSession(Astro.cookies);
const isLoggedIn = !!userId;
// One row, asked by store id — not the buyer's whole saved-store list filtered in memory.
// **Three independent reads, issued together (2026-08-03).** None of them needs another's answer —
// only `shopStore`, which is already in hand. Awaited in sequence they were three round trips in
// series on the platform's most-indexed page type, and time-to-first-byte is a Core Web Vitals
// input, so this is an SEO number and not only a feel one. Free as file reads, three network hops
// as queries: the same shape found on the homepage and in the product feed the same day.
// One row for the favourite, asked by store id — not the buyer's whole saved-store list filtered in
// memory. Blocked individual products (store itself still fine) never show in the store's own
// grid/search/category filters — getVisibleProductsByStoreId is the shared helper every listing
// surface should call (see store-products.ts).
const [isFavorited, allProducts, storeCategories, purchasedUnits] = await Promise.all([
  userId ? isStoreFavorited(userId, shopStore.id) : Promise.resolve(false),
  getVisibleProductsByStoreId(shopStore.id),
  getCategoriesByStoreId(shopStore.id),
  // Popularity signal for the 'default' ranking — lifetime units sold per product in this store.
  // Keyed by slug, so like the other three it needs only the store already in hand.
  getPurchasedCountsByStoreSlug(shopStore.slug),
]);
// A store with nothing to buy stays reachable by direct link (the seller previews and shares it)
// but must not enter Google's index as an empty page — same gate the sitemap and site search use.
// See lib/store-readiness.ts.
const storeReady = isStoreReady({ visibleProductCount: allProducts.length });
// A showcase store (lib/demo-stores.ts) stays reachable by direct link forever —
// that link is the seller-facing "צפו בחנות לדוגמה" entry point — but is never
// indexable: a fabricated catalog ranking on the shared platform domain costs
// real SEO. It's also out of the sitemap and the product feed (see
// getIndexableStores), so this is the last surface that could leak it.
const isDemo = isDemoStore(shopStore);
// `demoIndex` used to live here: it read EVERY demo store out of the database on every showcase
// page load, purely to pick which of five palette hues the old generated banner should use. The
// banner now shows the store's own photograph and its own colours, so the query bought nothing and
// is gone — along with the getDemoStores import that existed only to serve it (2026-08-12).
// Quiet per-product label for a showcase store. Every product in such a store is
// one, so this is a muted line, not the pill the STORE gets — the same markup has
// to exist in the JS card renderer further down (SSR/AJAX parity).
/* Sits ON the picture, not in the card body (owner, 2026-08-12: "צריך להופיע על גבי התמונה בצורה
   מאוד עדינה כי כרגע זה מגדיל את הכרטיסייה עצמה"). In flow it added a line to EVERY card in a
   showcase store, so the same product card was one height in a real store and taller in a demo one
   — the disclosure was quietly redesigning the grid.
   Bottom inline-start is the one free corner: the wishlist heart owns top inline-end and the image
   dots own bottom centre. Opaque white rather than a blurred glass chip, matching the heart's own
   treatment (memory `feedback_wishlist_heart_no_glass`) — and `pointer-events:none` so it can never
   swallow a click meant for the card behind it. */
/* `start-*`, NOT `inset-inline-start-*` — the latter is not a Tailwind utility at all, so it
   compiled to nothing and the chip sat flush against the edge with no inset, which is exactly what
   the owner reported. `start-` is the logical-property utility and it mirrors under `dir=rtl` for
   free. And more transparent, at his request: this is a disclosure, not a price tag. */
const DEMO_PRODUCT_BADGE_CLASS = 'absolute bottom-2 start-2 z-[2] pointer-events-none '
  + 'inline-flex items-center gap-1 py-[0.15rem] px-[0.4rem] rounded-[var(--radius-sm)] '
  + 'bg-white/70 [backdrop-filter:blur(4px)] text-[0.6rem] font-medium leading-[1.4] '
  + 'whitespace-nowrap [color:var(--color-muted)]';
const DEMO_PRODUCT_BADGE_ICON = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.6v.6"/></svg>';
const categoryTree = buildCategoryTree(storeCategories);
// A store's own categories are free text, so they get no icons (see
// lib/category-icons.ts) — this count is what makes a chip row read as a live
// catalogue instead of a strip of words. Computed off the visible products only,
// so it can never promise more than the filter will show.
const categoryCounts = countProductsPerCategory(storeCategories, allProducts.map((p) => p.categoryId));

// Initial page render honors the same category/sort/q as the URL (deep links,
// back-navigation) — server-side, so first paint is already correct and fully
// crawlable. Beyond page 1, "load more" takes over via /api/store-products
// using this exact same filterAndSortProducts(), so results never drift.
const initCategory = Astro.url.searchParams.get('category') ?? '';
const initSort = Astro.url.searchParams.get('sort') ?? '';
const initQ = Astro.url.searchParams.get('q') ?? '';

// Drill-down: selecting a category shows it + its own children as the next
// chip row (breadcrumb above), not a flat list of every category at once.
// By slug (`?category=נעליים`) or, for links made before that, by id — see
// store-categories.ts#findCategoryByParam.
const selectedCategory = findCategoryByParam(storeCategories, initCategory);
const breadcrumbChain = selectedCategory ? getAncestorChain(storeCategories, selectedCategory.id) : [];
const chipLevelCategories = storeCategories
  .filter((c) => c.parentId === (selectedCategory ? selectedCategory.id : null))
  .sort((a, b) => a.order - b.order);

const categoryIds = selectedCategory ? resolveCategoryFilterIds(storeCategories, selectedCategory.id) : undefined;
const filteredProducts = filterAndSortProducts(allProducts, { categoryIds, sort: initSort, q: initQ, purchasedUnits, sale: shopStore.sale });

/**
 * **Pagination is here so the catalog can be CRAWLED, and that is the whole reason.**
 *
 * Every product already had its own indexable page and its own sitemap entry, but the store page
 * linked to 24 of them and the rest arrived through "load more", which is a fetch, not a link.
 * Measured 2026-08-03 on the showcase set: 76 of one store's 100 products had no in-site link
 * pointing at them anywhere. A sitemap gets a URL discovered; a link is what gives it standing and
 * tells Google the shelf it belongs to. So the same slices "load more" fetches are also reachable
 * as `?page=N`, server-rendered, joined by real `<a href>` links at the foot of the grid.
 *
 * A page past the end is not rendered as an empty shelf — that is a thin page on a domain that has
 * to earn its ranking. It redirects to the first page of the same view.
 */
const totalPages = Math.max(1, Math.ceil(filteredProducts.length / PRODUCTS_PAGE_SIZE));
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const currentPage = Number.isFinite(requestedPage) ? Math.max(1, requestedPage) : 1;
const pageStart = (currentPage - 1) * PRODUCTS_PAGE_SIZE;
const products = filteredProducts.slice(pageStart, pageStart + PRODUCTS_PAGE_SIZE);
const hasMoreProducts = pageStart + products.length < filteredProducts.length;

// The store's canonical home: the seller's own domain when active, else the platform path
// (custom-domain.ts → storeCanonicalUrl). Used for both the JSON-LD `url` and <link rel=canonical>
// so the SEO signal is identical wherever the page is served from. (An ad landing overrides the
// canonical below, not here: this value is the base every category/page URL is built on, and it
// must stay parameter-free or `storeViewUrl` would append a second `?`.)
const storeUrl = storeCanonicalUrl(shopStore);

/**
 * A URL for one view of this store — the ONE builder, used by the chips, the breadcrumb, the
 * pagination links, the canonical and the sitemap's idea of what exists. Two ways of spelling the
 * same view is how a canonical ends up pointing at a URL nobody links to.
 *
 * `q` and `sort` are deliberately absent: they are the same products re-ordered or narrowed by
 * something the visitor typed, not a different shelf, and they are `noindex` below for that reason.
 */
function storeViewUrl(category?: { id: string; name: string } | null, page = 1): string {
  const params = new URLSearchParams();
  // categoryUrlParam, never categorySlug: a name of only symbols or emoji slugs to "", and
  // `?category=` with nothing after it is a link to the whole catalog wearing a category's label.
  if (category) params.set('category', categoryUrlParam(category));
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs ? `${storeUrl}?${qs}` : storeUrl;
}
/** The same, as an in-page href — relative, so a custom domain doesn't hard-code the platform one. */
function storeViewHref(category?: { id: string; name: string } | null, page = 1): string {
  const url = new URL(storeViewUrl(category, page));
  return `${url.pathname}${url.search}`;
}

// A view the visitor composed (a search, a re-sort) is the same shelf in another order — one page
// of real content behind an unbounded number of URLs, which is what a crawl budget gets spent on.
// The shelf itself, including every category and every page of it, stays indexable.
// Past the last page there is nothing to show, and an empty shelf is a thin page Google would hold
// against the whole domain. Send it to the first page of the same view instead of rendering one.
if (currentPage > totalPages) {
  return Astro.redirect(storeViewHref(selectedCategory, 1), 302);
}

const isComposedView = Boolean(initQ || initSort);
// On an ad landing the canonical is the landing itself, and it is `noindex` below — Merchant Center
// reads the canonical as the real destination, and pointing it at the seller's domain would put the
// item back on a domain the advertising account cannot claim (custom-domain.ts#AD_LANDING_PARAM).
const pageCanonical = adLanding ? adLandingUrl(shopStore) : storeViewUrl(selectedCategory, currentPage);
const categoryTrail = breadcrumbChain.map((c) => c.name).join(' › ');
const today = new Date().toDateString();

const lang = getLang(Astro.cookies);
const dir  = getDir(lang);
const t    = getT(lang);

const pageSuffix = currentPage > 1 ? ` — ${lang === 'he' ? 'עמוד' : 'page'} ${currentPage}` : '';
const pageTitle = selectedCategory
  ? `${categoryTrail} · ${shopStore.name}${pageSuffix}`
  : `${shopStore.name}${pageSuffix}`;
const pageDescription = selectedCategory
  ? (lang === 'he'
      ? `${filteredProducts.length} מוצרים בקטגוריית ${categoryTrail} בחנות ${shopStore.name}. משלוח לכל הארץ.`
      : `${filteredProducts.length} products in ${categoryTrail} at ${shopStore.name}.`)
  : (shopStore.tagline || shopStore.description || `Shop at ${shopStore.name} on ${platform.name}`);

// EVERY sale names its scope on the banner — the category path when it is a category, "on
// selected items" for a hand-picked list, "on the whole store" otherwise. The widest scope is
// labelled too, on purpose: while only the narrow ones spoke, an unlabelled banner was
// ambiguous between "it covers everything" and "the seller didn't say", and the shopper had no
// way to tell which. Naming all three makes the line trustworthy — and the store-wide one is
// the best news of the three anyway.
const saleScopeLabel = saleScopeCategoryLabel(storeCategories, shopStore.sale, t.store.saleAndMore)
  || (shopStore.sale?.productIds?.length ? t.store.saleOnSelected : t.store.saleOnWholeStore);

// The seller viewing their own store gets a way back to the dashboard (the "צפה בחנות"
// button opens the store in a separate preview tab, and on iOS a link-opened tab has no
// history to go Back through). On a custom domain the dashboard lives on another origin,
// so the link has to be absolute there.
const isOwner = !!userId && userId === shopStore.sellerId;
const onCustomDomain = shopStore.customDomain?.status === 'active';
const dashboardHref = onCustomDomain ? `${platform.url}/seller/dashboard` : '/seller/dashboard';

const showAddress = !!shopStore.addressVisible && !!shopStore.address;
const showHours = !!shopStore.hoursVisible && !!shopStore.hours;
const showDetails = showAddress || showHours;
const hoursRows = showHours && shopStore.hours ? formatStoreHours(shopStore.hours, t.store.hoursDay, t.store.hoursClosed) : null;
const mapsUrl = showAddress && shopStore.address ? googleMapsSearchUrl(shopStore.address) : null;

// Store imagery, guaranteed present and guaranteed at the right ratio (see
// store-image.ts): the seller's own picture when there is one, the store's
// generated mark when there isn't. `logo` is emitted ONLY for a real upload —
// a generated tile is honestly the store's mark, but telling Google it is the
// business's logo would be a claim about the business, not about our UI.
const ogImage = storeImageUrl(shopStore, OG_IMAGE_FORMAT, platform.url);
const storeLogo = resolveStoreImage(shopStore, 'logo');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: shopStore.name,
  description: shopStore.description || shopStore.tagline || `Shop at ${shopStore.name}`,
  url: storeUrl,
  image: ogImage,
  ...(storeLogo.hasUpload ? { logo: storeLogo.src } : {}),
  ...(showAddress && shopStore.address ? { address: shopStore.address } : {}),
  ...(showHours && shopStore.hours ? { openingHours: formatStoreHoursSchema(shopStore.hours) } : {}),
};

/**
 * A category view describes itself as a CollectionPage, not as the Store.
 *
 * The Store node says "this is the business" and belongs on the shelf's front page; repeating it on
 * every category would claim a dozen businesses at one address. `CollectionPage` + `BreadcrumbList`
 * says what a category page actually is — a named part of this store's catalog, with its place in
 * the tree — which is what earns a breadcrumb line in the results rather than a bare URL.
 *
 * `mainEntity.numberOfItems` is the count for the WHOLE category (subcategories included, the same
 * number the chip prints), not this page's 24: the collection is what it describes, and the page is
 * a window onto it.
 */
const categoryJsonLd = selectedCategory ? [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: categoryTrail,
    url: pageCanonical,
    isPartOf: { '@type': 'Store', name: shopStore.name, url: storeUrl },
    mainEntity: {
      '@type': 'ItemList',
      name: selectedCategory.name,
      numberOfItems: filteredProducts.length,
      itemListElement: products.map((p, i) => ({
        '@type': 'ListItem',
        position: pageStart + i + 1,
        url: `${storeUrl}/${urlSegment(p.slug)}`,
        name: p.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: shopStore.name, item: storeUrl },
      ...breadcrumbChain.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 2,
        name: c.name,
        item: storeViewUrl(c),
      })),
    ],
  },
] : null;

const pmI18n = {
  addToCart: t.store.addToCart,
  addedToCart: t.store.addedToCart,
  toCheckout: t.store.toCheckout,
  outOfStock: t.store.outOfStock,
  inStockLabel: t.store.inStockLabel,
  addToWishlist: t.wishlist.addLabel,
  removeFromWishlist: t.wishlist.removeLabel,
  badgeNew: t.store.badgeNew,
  saleBadge: t.store.saleBadge,
  saleWas: t.store.saleWas,
  loadingMore: t.store.loadingMore,
  filterAll: t.store.filterAll,
  filterByCategory: t.store.filterByCategory,
  searchResultsFor: t.store.searchResultsFor,
  noResultsFor: t.store.noResultsFor,
  loadFailedTitle: t.store.loadFailedTitle,
  loadFailedBody: t.store.loadFailedBody,
  fullPage: lang === 'he' ? 'לדף המוצר המלא' : 'View full product page',
  close: lang === 'he' ? 'סגור' : 'Close',
  showMore: lang === 'he' ? 'עוד' : 'More',
  showLess: lang === 'he' ? 'פחות' : 'Less',
};

/**
 * The banner photo — this page's LCP element, measured at 2.77s by the owner
 * (2026-08-03) before the two changes below. Built here rather than inline in the
 * markup because the <head> preload and the <img> have to request the BYTE-IDENTICAL
 * thing: any drift between the two strings and the browser fetches the banner twice,
 * which is worse than not preloading it at all.
 *
 * 1. CROPPED at the CDN to the 3/1 frame it is painted into. `.store-banner__bg` is
 *    `object-fit: cover`, so every pixel outside 3/1 was downloaded, decoded and then
 *    discarded — and a seller's banner is very often a square photo. Measured on a
 *    1000x1000 source, visually identical: 84.5KB → 32.2KB at w_1600, 112KB → 40.6KB
 *    at w_2048. `g_auto` picks the crop window from the picture's own content, so the
 *    subject is not centre-cropped out of frame (see lib/cdn.ts#cdnCropSrcSet).
 * 2. PRELOADED in <head>, ahead of the ten font files. The preload scanner does find
 *    this <img> in the markup, but only after the whole store header and owner bar,
 *    and by then the fonts already hold the connections. It is the largest element on
 *    the page; it goes first.
 *
 * Deliberately NOT made lazy even though the owner scrolls past it: it is above the
 * fold and the LCP element, so deferring it would make the number worse, not better.
 * The fix for "it loads after I have already scrolled" is for it to be small and
 * early — which is exactly what these two do.
 */
// BANNER_RATIO/BANNER_WIDTHS come from lib/cdn.ts, NOT from here: the same two values also drive
// the save-time warm-up (lib/image-derive.ts#warmBannerDerivations), and a width this page requests
// that nobody pre-rendered is the ~0.8s cold Cloudinary render landing on a visitor.
const BANNER_SIZES = '(min-width: 1160px) 1128px, calc(100vw - 2rem)';
/** The `src` rung. `width`/`height` below are computed from it and describe the FRAME, not the
 *  delivered pixels: `cdnBand` refuses to upscale, so a seller whose upload is narrower than this
 *  gets a smaller image at the identical 3/1 ratio — same reserved space, no layout shift. */
const BANNER_W = 1600;
const BANNER_H = Math.round(BANNER_W / BANNER_RATIO);
// `cdnBand`/`cdnCropSrcSet` are called at BOTH the <img> and the preload rather
// than hoisted into a variable — tests/image-optimization.test.ts requires the CDN
// helper to be visible at the markup, and it is right to: a variable is exactly how
// a raw URL sneaks into an <img>. They cannot drift because both calls take the same
// pure function and the same constants above; change a width in one place only and
// the browser downloads the banner twice.
const bannerPreload = !isDemo && shopStore.bannerImage
  ? {
      href: cdnBand(shopStore.bannerImage, BANNER_W, BANNER_RATIO),
      srcset: cdnCropSrcSet(shopStore.bannerImage, [...BANNER_WIDTHS], BANNER_RATIO) || undefined,
      sizes: BANNER_SIZES,
    }
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  jsonLd={categoryJsonLd ?? jsonLd}
  canonical={pageCanonical}
  noindex={!storeReady || isDemo || isComposedView || adLanding}
  preloadImage={bannerPreload}
  isLoggedIn={isLoggedIn}
  storeMode={true}
  storeName={shopStore.name}
  storeSlug={shopStore.slug}
  storeLogo={shopStore.profileImage} storeDemo={isDemo}
  storeHeaderLogo={storeHeaderLogo(shopStore)}
  dataLayer={{ event: 'page_view', page_type: 'store', store_id: shopStore.id, store_name: shopStore.name, store_slug: shopStore.slug, currency: 'ILS' }}
>
  <script is:inline>
    // Anti-flash: if a scroll position is waiting to be restored for this store,
    // hide the SCROLLING CONTENT until the deferred script below has re-applied
    // filters and scrolled into place — otherwise it paints at the top first and
    // then visibly snaps down once the module script catches up.
    //
    // `#main-content`, never `documentElement` (fixed 2026-08-05). Hiding the root
    // took the fixed header with it, so every return to a store you had scrolled —
    // home → that store is the everyday case — blanked the whole chrome for up to
    // half a second and the header appeared to vanish and come back. Nothing in the
    // header scrolls, so it has nothing to restore and no reason to be hidden.
    // `visibility` (not `display`) keeps the content's box, so the footer below it
    // does not jump while the curtain is up.
    (function () {
      try {
        // Slug comes from <body data-store-slug> (server-resolved) — reliable for
        // root-level store URLs AND custom domains; the old /store/[slug] URL parse
        // broke on the root-URL migration. Matches the key scroll-restore.ts writes.
        var slug = document.body.dataset.storeSlug || '';
        if (slug && sessionStorage.getItem('store_scroll_' + slug)) {
          // Only on the quick-view-refresh return (the scripted reload that sets
          // this flag) does the browser's own restore have to be switched off:
          // that entry's remembered offset is stale (measured: 0) and lands
          // *after* ours, visibly animating the page away from the restored
          // position (`html` is `scroll-behavior:smooth`). Every other return —
          // notably Back from a real product-page navigation — keeps native
          // restoration, which is better timed than any script.
          if (sessionStorage.getItem('store_scroll_return') === slug && 'scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
          }
          // This script is inline in the body, so <main> is already parsed above it.
          var content = document.getElementById('main-content');
          if (content) {
            content.style.visibility = 'hidden';
            setTimeout(function () { content.style.visibility = ''; }, 500);
          }
        }
      } catch (e) {}
    })();
  </script>
  <script is:inline type="application/json" id="pm-i18n" set:html={jsonForScript(pmI18n)} />

  <div class="store-page" data-demo={isDemo ? '1' : undefined} data-demo-label={isDemo ? t.demo.productBadge : undefined} data-demo-badge-class={isDemo ? DEMO_PRODUCT_BADGE_CLASS : undefined} data-owner-store={isOwner ? shopStore.slug : undefined} data-owner-cannot-buy={isOwner ? t.store.ownerCannotBuy : undefined} data-store-slug={shopStore.slug} data-store-name={shopStore.name} data-lang={lang} data-custom-host={shopStore.customDomain?.status === 'active' ? shopStore.customDomain.hostname : ''} data-platform-boundary={platformBoundary ? JSON.stringify(platformBoundary) : undefined} data-ad-landing={adLanding ? '1' : undefined}>

    {/* Owner bar. Sits above .store-banner-pin in normal flow, so it simply
        scrolls away and the curtain-scroll geometry below is untouched. */}
    {isOwner && (
      <OwnerStoreBar label={t.store.ownerPreview} backLabel={t.store.ownerPreviewBack} dashboardHref={dashboardHref} />
    )}

    {/* Same slot and the same reasoning: a note about the CONTEXT you are viewing this store in,
        which scrolls away on the first gesture. See StoreDemoBar for why the disclosure moved out
        of the store's identity block, and for why doing so does not weaken it. */}
    {isDemo && (
      <StoreDemoBar title={t.demo.noticeTitle} text={t.demo.noticeText} cta={t.demo.noticeCta} />
    )}

    {/* Curtain scroll (CURRENT_TASK 2): ONLY the banner image is pinned; the
        store details and the products both scroll up and over it as one
        contiguous opaque flow (white details → grey products, no gap), so the
        image is the single thing the curtain covers — the details are never
        covered, they just scroll past. */}
    <!-- A showcase store DOES use a photo banner now (2026-08-12) — its own generated background,
         with the store name drawn over it as vector text. It goes through StoreDemoBanner rather
         than the branch below only because of that overlay; the picture, the 3/1 wrap and the cdn
         helpers are identical, so the curtain-scroll geometry above is unchanged either way. The
         comment sits OUTSIDE the expression on purpose: Astro's compiler rejects an HTML comment as
         the first child right after `{expr ? (` (see AI_INSTRUCTIONS → Architecture). -->
    {isDemo ? (
      <div class="store-banner-pin">
        <div class="container">
          <div class="store-banner__image-wrap">
            <StoreDemoBanner name={shopStore.name} tagline={shopStore.tagline} bannerImage={shopStore.bannerImage} colors={shopStore.colors} dir={dir} />
          </div>
        </div>
      </div>
    ) : shopStore.bannerImage && (
      <div class="store-banner-pin">
        <div class="container">
          <div class="store-banner__image-wrap" data-skeleton>
            <img
              src={cdnBand(shopStore.bannerImage, BANNER_W, BANNER_RATIO)}
              srcset={cdnCropSrcSet(shopStore.bannerImage, [...BANNER_WIDTHS], BANNER_RATIO) || undefined}
              sizes={BANNER_SIZES}
              alt=""
              width={BANNER_W}
              height={BANNER_H}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="store-banner__bg"
            />
          </div>
        </div>
      </div>
    )}

    <section class="store-banner" aria-labelledby="store-heading">
      <div class="container">
        <div class="store-banner__info">
          <div class="store-banner__identity">
            {/* A showcase store has a DRAWN mark rather than an uploaded picture or an initial —
                see StoreDemoMark for the two versions that were rejected before it. A real seller
                still gets StoreAvatar and their own logo. */}
            {isDemo && !shopStore.profileImage
              ? <StoreDemoMark slug={shopStore.slug} colors={shopStore.colors} size={56} />
              : <StoreAvatar name={shopStore.name} slug={shopStore.slug} profileImage={shopStore.profileImage} size={56} />}
            <h1 id="store-heading" class="store-name" dir={dir}>{shopStore.name}</h1>
          </div>
          {shopStore.tagline && <p class="store-tagline" dir={dir}>{shopStore.tagline}</p>}
            {shopStore.description && shopStore.description !== shopStore.tagline && (
              <p class="store-desc" dir={dir}>{shopStore.description}</p>
            )}

            {/* AFTER the store's own words, never between them. It sat between the name and the
                tagline, which split the one thing this block exists to say — a store's name and its
                tagline are a single sentence, and a notice box dropped into the middle left the
                tagline reading as orphaned text under a banner.
                It stays inside the identity block rather than moving to the head of the catalog: the
                sale is an announcement BY the store, the same kind of thing as the demo notice a few
                lines above, and notices belong with whoever is making them. Its scope line ("on
                selected items") is a qualifier on the announcement, not a heading for the grid.
                One consequence to know, and it is ordinary rather than exotic: this block sits high
                on the page and scrolls normally, so the banner is off-screen by the time the shopper
                reaches the products (measured: its top goes 529 → 229 → -171 at 0/300/700px of
                scroll — exactly the scroll delta). Only the cover IMAGE is pinned here, not this
                block — see store.css's note at the top. So the sale is seen on arrival and not again
                while browsing; nothing downstream may assume it is still visible. Making it present
                during browsing would need a real addition (a sticky bar, or a second mark at the head
                of the catalog), not a tweak. */}
            {/* `mt-4` (1rem) because the measured gap was 0px — `.store-desc`'s margin-bottom is 0 and
                the strip carries no margin of its own, so they were touching. 1rem matches
                `.store-banner__actions` below rather than the 0.5rem the two paragraphs use: those
                are lines of one text block, this is a separate object and has to read as one. */}
            <StoreSaleBanner sale={shopStore.sale} dir={dir} scopeLabel={saleScopeLabel} class="mt-4" />

            {showDetails && (
              <details class="store-details" dir={dir}>
                <summary class="store-details__summary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {t.store.moreDetails}
                  <svg class="store-details__chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="store-details__content">
                  {showAddress && (
                    <a
                      class:list={['store-details__item', { 'store-details__item--link': !!mapsUrl }]}
                      href={mapsUrl || undefined}
                      target={mapsUrl ? '_blank' : undefined}
                      rel={mapsUrl ? 'noopener noreferrer' : undefined}
                      aria-label={mapsUrl ? t.store.viewOnMap : undefined}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {shopStore.address}
                    </a>
                  )}
                  {hoursRows && (
                    <div class="store-details__item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:0.15rem"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      <ul class="store-details__hours-list min-w-[11rem]">
                        {hoursRows.map((row) => (
                          <li class="flex items-baseline justify-between gap-5">
                            <span class="whitespace-nowrap">{row.label}</span>
                            <span class="whitespace-nowrap tabular-nums text-[var(--color-text)]" dir="ltr">{row.value}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            )}

            <!-- Actions row -->
            <div class="store-banner__actions">
            <div style="position:relative;display:flex;align-items:center">
              <button
                id="fav-store-btn"
                type="button"
                class="store-banner-action-btn"
                data-slug={shopStore.slug}
                data-favorited={String(isFavorited)}
                data-login-url={`/seller/login?next=/${shopStore.slug}`}
                data-is-logged-in={String(isLoggedIn)}
                aria-label={isFavorited ? t.store.savedStore : t.store.saveStore}
                data-str-saved={t.store.savedStore}
                data-str-save={t.store.saveStore}
                aria-pressed={isFavorited}
              >
                <svg id="fav-store-icon" width="13" height="13" viewBox="0 0 24 24" fill={isFavorited ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;transition:fill 0.18s">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                <span id="fav-store-label">{isFavorited ? t.store.savedStore : t.store.saveStore}</span>
              </button>
              <div
                id="fav-store-tooltip"
                role="status"
                aria-live="polite"
                style="position:absolute;top:calc(100% + 0.45rem);inset-inline-start:0;z-index:30;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:0.45rem 0.8rem;white-space:nowrap;box-shadow:var(--shadow-card);font-size:0.8rem;color:var(--color-text);opacity:0;pointer-events:none;transform:translateY(-6px) scale(0.97);transition:opacity 0.17s,transform 0.22s cubic-bezier(0.34,1.56,0.64,1)"
              >
                {t.store.loginToSave} <a id="fav-store-tooltip-link" href={`/seller/login?next=/${shopStore.slug}`} style="color:var(--color-accent);font-weight:600">{t.store.loginToSaveLink}</a>
              </div>
            </div>

            {userId !== shopStore.sellerId && (
              <button
                type="button"
                class="store-banner-action-btn"
                id="contact-store-btn"
                data-store-id={shopStore.id}
                data-seller-id={shopStore.sellerId}
                data-store-name={shopStore.name}
                data-is-logged-in={String(isLoggedIn)}
                data-login-url={`/seller/login?next=/${shopStore.slug}`}
                data-str-login-hint={t.messages.loginToMessage}
                data-str-login-hint-link={t.messages.loginToMessageLink}
                aria-label={`${t.messages.contactStore}: ${shopStore.name}`}
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {t.store.contactShort}
              </button>
            )}
          </div>
        </div>
      </div>
    </section>

    {/* Full-width opaque layer — the curtain that scrolls up over the pinned
        banner unit. Full-width (not the container-width section) so it covers
        the full-width white banner edge-to-edge, no side stripes. */}
    <div class="store-below">
    <section class="section container">
{allProducts.length === 0 ? (
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <p>{t.store.emptyStore}</p>
        </div>
      ) : (
        <Fragment>
          <div class="store-controls">
            {/* Local search — only meaningful once a category filter is active (searching
                the whole store already has the header's own search bar for that). A plain
                always-open single-line field, underline only, no box/border. */}
            <div class="category-nav-row" id="category-nav-row" hidden={breadcrumbChain.length === 0}>
              {breadcrumbChain.length > 0 && (
                <nav id="category-breadcrumb" class="category-breadcrumb" aria-label={t.store.filterByCategory}>
                  {/* Links for the same reason the chips are: this is the trail Google reads to
                      place a category in the store's tree, and it matches the BreadcrumbList in
                      the page's JSON-LD exactly. */}
                  <a href={storeViewHref()} class="category-breadcrumb__crumb" data-category-id="">{t.store.filterAll}</a>
                  {breadcrumbChain.map((c, i) => (
                    <Fragment>
                      <span class="category-breadcrumb__sep" aria-hidden="true">›</span>
                      {i === breadcrumbChain.length - 1
                        ? <span class="category-breadcrumb__current">{c.name}</span>
                        : <a href={storeViewHref(c)} class="category-breadcrumb__crumb" data-category-id={c.id}>{c.name}</a>}
                    </Fragment>
                  ))}
                </nav>
              )}
              <div class="local-search-row" id="local-search-row">
                <svg class="local-search-row__icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <label for="product-search" class="visually-hidden">{t.store.filterSearchLabel}</label>
                <input type="search" id="product-search" class="local-search-row__input" placeholder={t.store.filterSearchPlaceholder} aria-label={t.store.filterSearchLabel} autocomplete="off" />
                <button type="button" class="local-search-row__close" id="local-search-close" aria-label={t.store.clearSearchLabel} hidden>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>
            </div>

            <div class="store-controls__row">
              {storeCategories.length > 0 && (
                <button type="button" class="category-drawer-toggle" id="category-drawer-toggle" aria-expanded="false" aria-controls="category-drawer">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                  <span id="category-drawer-toggle-label">{selectedCategory ? selectedCategory.name : t.store.filterByCategory}</span>
                </button>
              )}
              {/* The chip row is hidden the moment there is nothing to DRILL INTO. Since the
                  selected category stopped leading its own row (see the chips below), a leaf
                  leaves this row with no chips at all, and an empty bordered strip under the
                  breadcrumb is chrome with no content. */}
              {storeCategories.length > 0 && (
                <div class="category-filters-wrap" id="category-filters-wrap"
                     hidden={chipLevelCategories.length === 0}>
                  <button type="button" class="category-filters-arrow category-filters-arrow--prev" id="category-filters-prev" aria-label={lang === 'he' ? 'הקודם' : 'Previous'} hidden>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style={lang === 'he' ? 'transform:scaleX(-1)' : ''}><polyline points="15 18 9 12 15 6"/></svg>
                  </button>
                  <div id="category-filters" class="category-filters-row edge-fade" role="group" aria-label={t.store.filterByCategory}>
                    {/* `<a href>`, not `<button>` — and that is an SEO change, not a markup
                        preference. A button is invisible to a crawler, so until 2026-08-03 the
                        only way into a category was JS, and the categories were unreachable and
                        unrankable no matter how good the page behind them was. They are real
                        links to real server-rendered URLs now; the delegated handler below still
                        intercepts a plain left click and filters in place, so nothing about the
                        interaction changed for a person. `data-category-id` stays because that
                        handler and the drill-down panel both key off it. */}
                    {/* The row shows where you can GO, never where you already are. "הכל" is here
                        only at the top level, where there is no breadcrumb yet and something has
                        to mark the current view; from the first category down, the breadcrumb
                        above states the position and the selected category repeated as a filled
                        chip beside its own children was saying it a second time (owner, סשן ג׳).
                        History worth keeping, because this line moved twice: for a while the row
                        marked nothing at all as current, and the answer then was to put the
                        selected category at its head (owner, 2026-08-03: "the category button
                        doesn't get coloured"). What was actually missing was a current-view mark
                        — the breadcrumb is that mark once you are inside one. */}
                    {!selectedCategory && (
                      <a href={storeViewHref()} class="category-chip" data-category-id="" aria-current="page">
                        {t.store.filterAll}
                      </a>
                    )}
                    {chipLevelCategories.map((cat) => {
                      const hasChildren = storeCategories.some((c) => c.parentId === cat.id);
                      return (
                        <a href={storeViewHref(cat)} class="category-chip" data-category-id={cat.id} data-has-children={hasChildren ? 'true' : undefined}>
                          {cat.name}
                          {/* Count first, then the drill-down chevron — the chevron
                              belongs against the chip's edge, the way a menu's does. */}
                          {(categoryCounts[cat.id] ?? 0) > 0 && (
                            <span class="category-chip__count">{categoryCounts[cat.id]}</span>
                          )}
                          {hasChildren && (
                            <svg class="category-chip__chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                          )}
                        </a>
                      );
                    })}
                  </div>
                  <button type="button" class="category-filters-arrow category-filters-arrow--next" id="category-filters-next" aria-label={lang === 'he' ? 'הבא' : 'Next'} hidden>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style={lang === 'he' ? 'transform:scaleX(-1)' : ''}><polyline points="9 18 15 12 9 6"/></svg>
                  </button>
                  {/* position:fixed so it's never clipped by the scrollable row's own
                      overflow-x — one shared panel, repositioned+refilled per hover. */}
                  <div class="category-chip-dropdown" id="category-chip-dropdown" role="menu" hidden></div>
                </div>
              )}
              <script type="application/json" id="store-category-tree-data" set:html={jsonForScript(categoryTree)} />
              {/* Same numbers as the server-rendered chips above, so a drill-down
                  (which re-renders the row client-side) doesn't lose them. Shipped
                  as its own payload rather than folded into the tree: the tree is
                  the persisted category shape, the counts are a derived view of the
                  products, and only one of the two changes when a product does. */}
              <script type="application/json" id="store-category-counts" set:html={jsonForScript(categoryCounts)} />

              <div class="sort-dropdown-wrap" id="sort-dropdown">
                <button
                  type="button"
                  id="sort-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  class="sort-trigger"
                  aria-label={t.store.sortDefault}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" style="flex-shrink:0"><line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="9" y1="18" x2="15" y2="18"/></svg>
                  <svg id="sort-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="flex-shrink:0;transition:transform 0.15s ease"><polyline points="6 9 12 15 18 9"/></svg>
                  <span id="sort-label" class="visually-hidden">{t.store.sortDefault}</span>
                </button>
                <ul
                  id="sort-menu"
                  role="listbox"
                  aria-labelledby="sort-trigger"
                  hidden
                  class="absolute top-full z-20 mt-1"
                  style="inset-inline-end:0;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);box-shadow:var(--shadow-card);padding:0.3rem;animation:sort-menu-open 0.13s cubic-bezier(0.34,1.56,0.64,1);min-width:11rem;max-width:calc(100vw - 1.5rem);white-space:nowrap">
                  <li role="option" data-value="default" aria-selected="true" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[var(--radius-sm)] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortDefault}</li>
                  <li role="option" data-value="name-asc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[var(--radius-sm)] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortNameAsc}</li>
                  <li role="option" data-value="name-desc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[var(--radius-sm)] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortNameDesc}</li>
                  <li role="option" data-value="price-asc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[var(--radius-sm)] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortPriceAsc}</li>
                  <li role="option" data-value="price-desc" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[var(--radius-sm)] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortPriceDesc}</li>
                  <li role="option" data-value="newest" aria-selected="false" class="px-3 py-[0.45rem] text-sm cursor-pointer select-none rounded-[var(--radius-sm)] transition-colors duration-100 hover:bg-[var(--color-bg)] aria-selected:font-bold aria-selected:text-[var(--color-text)]">{t.store.sortNewest}</li>
                </ul>
              </div>
            </div>

          </div>
          {/* Mobile category drawer + overlay live OUTSIDE .store-controls on purpose:
              that block is now position:sticky (its own z-index stacking context), and
              these position:fixed full-screen elements must escape it to sit above the
              site header instead of being trapped below it. */}
          {storeCategories.length > 0 && (
            <Fragment>
              <div class="category-drawer-overlay" id="category-drawer-overlay"></div>
              <aside class="category-drawer" id="category-drawer" role="dialog" aria-modal="true" aria-labelledby="category-drawer-title" aria-hidden="true">
                <header class="category-drawer__head">
                  <h2 id="category-drawer-title">{t.store.filterByCategory}</h2>
                  <button type="button" id="category-drawer-close" aria-label={lang === 'he' ? 'סגור' : 'Close'}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </button>
                </header>
                <div class="category-drawer__body" id="category-drawer-body"></div>
              </aside>
            </Fragment>
          )}
          <div id="search-results-heading" class="search-results-heading" hidden={!initQ}>
            <span id="search-results-heading-text">
              {initQ && (products.length > 0
                ? t.store.searchResultsFor.replace('{query}', initQ)
                : t.store.noResultsFor.replace('{query}', initQ))}
            </span>
            <button type="button" id="search-results-clear" class="search-results-clear" aria-label={t.store.clearSearchLabel}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <LoadingSweep id="store-products-loading" label={t.store.loadingMore} class="mb-1" />
          <ul class="product-grid" role="list" hidden={products.length === 0}>
            {products.map((p, idx) => {
              const isNew = new Date(p.createdAt).toDateString() === today;
              const hasImages = !!(p.images?.length);
              // One resolution per card; every price/badge/data-attribute below reads from it,
              // so the shown price, the cart's price and checkout's price cannot disagree.
              const pv = resolvePrice(p, shopStore.sale);
              return (
                <li class="product-card card product-card--entering"
                    style={`animation-delay:${Math.min(idx, 12) * 40}ms`}
                    data-images={hasImages ? JSON.stringify(p.images) : undefined}
                    data-product-name={p.name}
                    data-price={String(pv.price)}
                    data-created-at={p.createdAt}
                    data-slug={p.slug}
                    data-description={p.description || ''}
                    data-stock={String(p.stock)}
                    data-category-id={p.categoryId ?? ''}
                    data-category-path={p.categoryId ? categoryPath(storeCategories, p.categoryId) : ''}
                    data-tags={p.tags?.length ? p.tags.join(',') : ''}
                    data-variants={p.variants?.length ? JSON.stringify(p.variants) : undefined}
                    data-variant-stock={p.variantStock ? JSON.stringify(p.variantStock) : undefined}
                    data-variant-images={p.variantImages ? JSON.stringify(p.variantImages) : undefined}>
                  <div class={`product-card__img-wrap${hasImages ? ' product-card__img-wrap--clickable' : ''}`}
                       data-skeleton={hasImages ? '' : undefined}
                       role={hasImages ? 'button' : undefined}
                       aria-label={hasImages ? p.name : undefined}
                       tabindex={hasImages ? 0 : undefined}>
                    <div class="product-card__slides">
                      {hasImages
                        ? p.images!.map((img, imgIdx) => (
                            <div class="product-card__slide">
                              {imgIdx === 0
                                /* Plain <img> (not <Image />) so it can carry a hi-DPI srcset:
                                   the card renders up to ~340px CSS wide, so a lone w_400 delivery
                                   gets browser-upscaled → blurry on retina. srcset+sizes keeps the
                                   seller's photo sharp at every DPR. CARD_SRCSET_SIZES below mirrors
                                   this literal — keep the two in sync. */
                                ? <img src={cdnSrc(img)} srcset={cdnSrcSet(img, [300, 400, 600, 800]) || undefined} sizes="(max-width: 640px) 48vw, 340px" alt={p.name} class="product-card__img" width="400" height="400" loading={idx < 4 ? 'eager' : 'lazy'} fetchpriority={idx < 2 ? 'high' : undefined} decoding="async" />
                                : (
                                  /* Slides past the first carry the URL in data-src/data-srcset and
                                     are fetched only once the shopper engages that card's carousel
                                     (hydrateCardSlides below). `loading="lazy"` still downloaded
                                     them for every card the browser considered near the
                                     viewport — measured 20 of 36 images on a first paint that
                                     showed 4 cards. */
                                  <img src={BLANK_PIXEL} data-src={cdnSrc(img)} data-srcset={cdnSrcSet(img, [300, 400, 600, 800]) || undefined} sizes="(max-width: 640px) 48vw, 340px" alt={p.name} class="product-card__img" width="400" height="400" loading="lazy" decoding="async" />
                                )}
                            </div>
                          ))
                        : <div class="product-card__slide">
                            <div class="product-card__img-placeholder" aria-hidden="true">
                              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                <line x1="12" y1="22.08" x2="12" y2="12"/>
                              </svg>
                            </div>
                          </div>
                      }
                    </div>
                    {isNew && <span class="img-badge badge--new">{t.store.badgeNew}</span>}
                    <Fragment set:html={saleBadgeHtml(pv, t.store.saleBadge)} />
                  <button
                    type="button"
                    class="wishlist-btn"
                    data-wishlist-slug={p.slug}
                    data-wishlist-name={p.name}
                    data-wishlist-price={String(pv.price)}
                    data-wishlist-image={p.images?.[0] ? cdnSrc(p.images[0]) : ''}
                    data-wishlist-store-slug={shopStore.slug}
                    data-wishlist-store-name={shopStore.name}
                    data-wishlist-stock={String(p.stock)}
                    data-wishlisted="false"
                    aria-pressed="false"
                    aria-label={t.wishlist.addLabel}
                    style="position:absolute;top:0.45rem;inset-inline-end:0.45rem;z-index:2;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,0.9);color:var(--color-muted);transition:color 0.15s,background 0.15s,transform 0.15s"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </button>
                    {hasImages && (p.images?.length ?? 0) > 1 && (
                      <div class="product-card__dots" aria-hidden="true">
                        {p.images!.map((_, dotI) => <span class={`product-card__dot${dotI === 0 ? ' is-active' : ''}`}></span>)}
                      </div>
                    )}
                    {isDemo && (
                      <span class={DEMO_PRODUCT_BADGE_CLASS}>
                        <Fragment set:html={DEMO_PRODUCT_BADGE_ICON} />
                        {t.demo.productBadge}
                      </span>
                    )}
                  </div>
                  <div class="product-card__body" dir="auto">
                    <a href={`/${shopStore.slug}/${p.slug}`}
                       class="product-modal-trigger hover:text-[var(--color-accent)] transition-colors duration-150"
                       style="color:inherit;text-decoration:none;display:block">
                      <h3 class="product-card__name">{p.name}</h3>
                    </a>
                    <div class="product-card__footer" style="flex-direction:column;align-items:stretch;gap:0.4rem">
                      <span class="product-card__price-wrap"><Fragment set:html={priceHtml(pv, { className: 'product-card__price', saleLabel: t.store.saleWas })} /></span>
                      {p.stock <= 0
                          ? <span class="badge badge--muted">{t.store.outOfStock}</span>
                          : <div dir="ltr" class="product-card__qtycart flex items-center" style="width:100%;height:2.25rem;border:1px solid var(--color-border);border-radius:var(--radius);overflow:hidden">
                              <button type="button" class="qty-dec flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label={t.cart.qtyDecrease} disabled>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                              </button>
                              <button
                                type="button"
                                class="product-card__add-btn add-to-cart-btn"
                                data-slug={p.slug}
                                data-name={p.name}
                                data-price={String(pv.price)}
                                data-base-price={pv.isDiscounted ? String(pv.basePrice) : undefined}
                                data-image={p.images?.[0] ? cdnSrc(p.images[0]) : ''}
                                data-stock={String(p.stock)}
                                data-label-added={t.store.addedToCart}
                                aria-label={t.store.addToCart}
                              >
                                <span class="btn-label" aria-hidden="true">
                                  <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                                    <circle cx="17" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                                    <path d="M1 3h2.4l2.72 13.4a2 2 0 0 0 2 1.6h7.76a2 2 0 0 0 2-1.6L20.4 7H5.1"/>
                                    <path d="M5.2 11.9h13.9M10.3 7.8L9.6 17.2M15 7.8L14.3 17.2" stroke-width="1.1"/>
                                  </svg>
                                </span>
                                <span class="qty-val text-sm font-semibold select-none" style="display:none" aria-live="polite" aria-atomic="true">1</span>
                              </button>
                              <button type="button" class="qty-inc flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label={t.cart.qtyIncrease}>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                              </button>
                            </div>
                      }
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
          <div id="no-results" class="empty-state" hidden={products.length > 0 || !!initQ}>
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <p>{t.store.noProductsFound}</p>
          </div>
          {/* ONE control, and it is a real link. There is no numbered pager under this shelf and
              there must not be one again (owner, 2026-08-05: "מה המשמעות ליוזר שיש גם טען עוד וגם
              עמודים? לא ראיתי דבר כזה").

              The problem this solves has two halves that used to be solved separately.
              (a) A <button> fetches; it does not link. Until 2026-08-03 a crawler saw the first 24
                  products of a shelf and had no path to the rest — 76 of one showcase store's 100
                  products had no in-site link pointing at them anywhere. Google renders JS but
                  never presses anything, so "load more" alone orphans three quarters of a catalog.
              (b) The fix was a numbered `?page=N` row beside the button, which put two controls for
                  one job at the foot of one shelf — and they contradict each other: press "load
                  more" four times and the row underneath still says you are on page 1. Restyling
                  it quieter (tried, same day) does not make a second control not a second control.

              So the button IS the link: `<a href="?page=N+1">` drawn as a button, with the click
              handler cancelling the navigation and appending in place. A shopper sees one button
              and never leaves the page. A crawler follows a real href to page 2, whose own button
              links to page 3, and walks the whole catalog that way. `nofollow` is deliberately NOT
              set — following it is the entire point.

              Two consequences worth knowing before changing this. The crawl path is now a CHAIN
              rather than a fan, so page N sits N clicks deep instead of one; that is fine for
              shelves of this size (24 a page) and every product is in the sitemap besides, but a
              store with hundreds of pages would want a different shape. And the href must be kept
              current as the grid grows — updateResultsState() owns that, so a filtered view's
              button points at the next page OF THAT VIEW. */}
          <div id="load-more-wrap" class="load-more-wrap" hidden={!hasMoreProducts}>
            {/* NO href on the last page — and `hidden` on the wrapper is not a substitute for
                that. A crawler reads the markup, not the pixels, so a link that survives past
                the end walks into `?page=<totalPages+1>`, which redirects to page 1, whose own
                button points at page 2 again: an endless loop, measured 2026-08-05 on the very
                first run of this change. An <a> with no href is not a link and is not followed.
                The element itself stays in the DOM because a client-side filter can reveal more
                results later; updateResultsState() puts the href back when it does. */}
            <a
              id="load-more-btn"
              class="load-more-btn"
              href={hasMoreProducts ? storeViewHref(selectedCategory, currentPage + 1) : undefined}
              data-offset={String(pageStart + products.length)}
            >
              <span id="load-more-label">{t.store.loadMore}</span>
            </a>
          </div>
        </Fragment>
      )}
    </section>

    <!-- Product modal + lightbox now live in the shared <StoreProductModal>
         (BaseLayout), opened via the `store-product-modal:open` event.
         Site-wide footer (with the "open a store" link) is rendered once by
         BaseLayout — no separate store footer here. -->
    </div>

  </div>
</BaseLayout>

{/* The running sale, for the client-side "load more" cards — they resolve prices with the
    same discounts.ts the server used, instead of the API shipping a second price shape. */}
<script is:inline type="application/json" id="store-sale-data" set:html={jsonForScript(shopStore.sale ?? null)} />

{/* The header search's product index used to be serialised here — the whole visible
    catalog, in the HTML, on every load, for an interaction most visitors never
    start (24.1KB on the biggest showcase store, and it grows with the catalog).
    It now comes from /api/store-search-index, warmed on idle by Header.astro, so
    the matching stays local and instant while the bytes leave the critical path. */}

<script>
  import { addItem, syncCartImages, getCartQty } from '../../lib/cart.js';
  import { startLoadingSweep, stopLoadingSweep } from '../../lib/loading-sweep.js';
  import { isWishlisted, toggleWishlist } from '../../lib/wishlist.js';
  import { cdnSrc, cdnSrcSet } from '../../config/store.config.js';
  import { spawnRipple } from '../../lib/ripple.js';
  import { spawnBurst, spawnHeartBurst } from '../../lib/burst.js';
  import { initLiquidDots } from '../../lib/carousel-dots.js';
  import { trackAddToCart } from '../../lib/tracking.js';
  import { adItemId } from '../../lib/ad-item-id.js';
  import { saveLastStore } from '../../lib/last-store.js';
  import { escapeHtml as escHtml } from '../../lib/html-escape.js';
  import { toSlug } from '../../lib/url-base.js';
  import { recordStoreVisit } from '../../lib/recent-stores.js';
  // The shared RTL-safe scroll, not the copy that used to live in this file: the
  // copy said it "mirrors" the original, and by 2026-07-30 it no longer did —
  // the shared one had learned to switch the root's `scroll-behavior` off for
  // the duration, without which reset.css's global `smooth` turns every frame of
  // the loop into its own native animation and the scroll crawls a couple of
  // pixels per frame. Two copies of one mechanism, and only one of them fixed,
  // is this repo's most repeated bug class.
  import { animateScrollTo } from '../../scripts/dashboard/scroll-utils.js';
  import { saveStoreScroll, applyStoreScrollQuery, restoreStoreScroll, peekStoreScrollState } from '../../lib/scroll-restore.js';
  import type { StoreProduct as StoreProductDTO } from '../../lib/store-products.js';
  import { PRODUCTS_PAGE_SIZE } from '../../lib/product-listing.js';
  import { BLANK_PIXEL } from '../../lib/blank-pixel.js';
  import { initCustomDomainLinks, initAdLandingLinks, readPlatformBoundary } from '../../lib/custom-domain-links.js';
  import { initImageSkeletons } from '../../lib/img-skeleton.js';
  import { initChipScroller } from '../../lib/chip-scroller.js';
  import { initStickyBar } from '../../lib/sticky-bar.js';
  import { resolvePrice, type StoreSale } from '../../lib/discounts.js';
  import { priceHtml, saleBadgeHtml } from '../../lib/price-html.js';
  import { showErrorToast } from '../../lib/toast.js';

  // Parsed once — the store's sale never changes within a page view.
  const storeSale: StoreSale | null = (() => {
    try { return JSON.parse(document.getElementById('store-sale-data')?.textContent ?? 'null'); }
    catch { return null; }
  })();

  document.querySelector<HTMLElement>('.store-page')?.addEventListener('pointerdown', (e) => {
    // Heart/wishlist buttons are excluded — their own heart-burst is the click
    // cue, and a ripple on top would stack two competing signals on one tap.
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button:not([disabled]):not(#sort-trigger):not(.add-to-cart-btn):not(.pm-add-to-cart):not(.wishlist-btn):not(.pm-wishlist-btn)');
    if (btn) spawnRipple(btn, e.clientX, e.clientY);
  });

  const storePage = document.querySelector<HTMLElement>('.store-page[data-store-slug]');
  const storeSlug = storePage?.dataset.storeSlug ?? '';
  const storeName = storePage?.dataset.storeName ?? '';

  // On the store's own verified domain, strip the redundant "/<slug>" prefix from in-store links so
  // the URL bar reads clean (also stamps window.__customStoreHost for the shared product modal) —
  // and send every PLATFORM-owned link (cart, checkout, login, buyer area) to the platform origin,
  // carrying the basket and the visitor's identity across the boundary (custom-domain-links.ts).
  initCustomDomainLinks(storeSlug, storePage?.dataset.customHost ?? '', readPlatformBoundary(storePage));
  // A brand campaign lands on THIS page, and the 301 off the platform carries no handoff — so the
  // first click into any product would drop the ad attribution that paid for the visit.
  initAdLandingLinks(storeSlug, storePage?.dataset.adLanding === '1');

  // Tracks the store's own filter/sort/search query string (kept in sync by
  // syncUrl() below) — read at pagehide time instead of location.search,
  // since opening the product quick-view modal rewrites the address bar via
  // pushState to a /slug/product path with no query of its own.
  let lastQueryString = location.search;

  if (storeSlug) {
    saveLastStore({ slug: storeSlug, name: storeName, url: location.pathname + location.search });
    // Visiting the store itself counts toward the homepage's "בוקרו לאחרונה"
    // shelf (SSR-read cookie). Sync to the account only when the list changed.
    if (recordStoreVisit(storeSlug)) window.dispatchEvent(new CustomEvent('recent-stores:change'));
    applyStoreScrollQuery(storeSlug);
    window.addEventListener('pagehide', () => {
      saveStoreScroll(storeSlug, lastQueryString, loadedCount);
      // Leave the entry on native restoration (see the head script above) — a
      // Back that comes from bfcache re-runs no JS, so nothing would be left to
      // restore scroll if this entry stayed 'manual'. Skipped while a quick-view
      // entry is the current one: that entry is deliberately 'manual' so a
      // refresh opens the full product page at the top, not at the store's offset.
      const onModalEntry = !!(history.state && (history.state as { productModal?: boolean }).productModal);
      if (!onModalEntry && 'scrollRestoration' in history) history.scrollRestoration = 'auto';
    });
  }

  // ── Sync cart images ──────────────────────────────────────────
  const currentProducts = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.add-to-cart-btn')
  ).map((btn) => ({
    slug: btn.dataset.slug ?? '',
    name: btn.dataset.name ?? '',
    price: Number(btn.dataset.price ?? 0),
    basePrice: btn.dataset.basePrice ? Number(btn.dataset.basePrice) : undefined,
    image: btn.dataset.image ?? '',
  })).filter((p) => p.slug);
  if (storeSlug) syncCartImages(storeSlug, currentProducts);

  // ── Wishlist hearts ───────────────────────────────────────────
  function setHeartStyle(btn: HTMLElement, active: boolean) {
    const svg = btn.querySelector<SVGElement>('svg');
    if (!svg) return;
    if (active) {
      svg.style.fill = '#e53e3e';
      svg.style.stroke = '#e53e3e';
      btn.style.color = '#e53e3e';
      btn.style.background = 'rgba(255,255,255,0.95)';
    } else {
      svg.style.fill = 'none';
      svg.style.stroke = 'currentColor';
      btn.style.color = '';
      btn.style.background = 'rgba(255,255,255,0.85)';
    }
  }

  function getI18nWishlist() {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}')?.wishlist ?? {}; } catch { return {}; }
  }

  // Extracted so newly-appended "load more" cards can be wired up the same
  // way as the initial batch — see initNewProductCards() near the bottom.
  function initWishlistBtn(btn: HTMLButtonElement): void {
    const slug = btn.dataset.wishlistSlug ?? '';
    const active = isWishlisted(slug);
    btn.dataset.wishlisted = String(active);
    btn.setAttribute('aria-pressed', String(active));
    setHeartStyle(btn, active);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wi = getI18nWishlist();
      const item = {
        slug,
        name: btn.dataset.wishlistName ?? '',
        price: Number(btn.dataset.wishlistPrice ?? 0),
        image: btn.dataset.wishlistImage ?? '',
        storeSlug: btn.dataset.wishlistStoreSlug ?? '',
        storeName: btn.dataset.wishlistStoreName ?? '',
        stock: btn.dataset.wishlistStock !== undefined ? Number(btn.dataset.wishlistStock) : undefined,
        // Read off the CARD rather than duplicated onto the heart: the card already carries
        // `data-variants` for the quick-view, and a second copy of the same JSON on a sibling
        // element is the kind of duplication that goes stale on one side only. Works for both the
        // server-rendered cards and the ones "טען עוד" injects, since both emit the attribute.
        hasVariants: !!btn.closest<HTMLElement>('[data-variants]'),
      };
      const nowActive = toggleWishlist(item);
      btn.dataset.wishlisted = String(nowActive);
      btn.setAttribute('aria-pressed', String(nowActive));
      const newLabel = nowActive ? (wi.removeLabel ?? 'Remove from wishlist') : (wi.addLabel ?? 'Add to wishlist');
      btn.setAttribute('aria-label', newLabel);
      setHeartStyle(btn, nowActive);

      if (nowActive) spawnHeartBurst(btn);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.wishlist-btn').forEach(initWishlistBtn);

  // ── Favorite store button ─────────────────────────────────────
  const favBtn = document.getElementById('fav-store-btn') as HTMLButtonElement | null;
  if (favBtn) {
    const isLoggedIn = favBtn.dataset.isLoggedIn === 'true';
    const favSlug = favBtn.dataset.slug ?? '';
    const favIcon = document.getElementById('fav-store-icon') as SVGElement | null;
    const favLabel = document.getElementById('fav-store-label');
    const favTooltip = document.getElementById('fav-store-tooltip') as HTMLElement | null;

    function setFavStyle(active: boolean) {
      if (!favIcon) return;
      // Pressed = a filled star in the button's own text colour (grey), matching
      // exactly how a store that's already saved renders on load — not the blue
      // accent (deliberate: the SSR saved-state grey is the look the user wants).
      favIcon.style.fill = active ? 'currentColor' : 'none';
      favIcon.style.stroke = 'currentColor';
    }

    let tooltipTimer = 0;
    function showLoginTooltip() {
      if (!favTooltip) return;
      favTooltip.style.opacity = '1';
      favTooltip.style.pointerEvents = 'auto';
      favTooltip.style.transform = 'translateY(0) scale(1)';
      clearTimeout(tooltipTimer);
      tooltipTimer = window.setTimeout(hideLoginTooltip, 4000);
    }
    function hideLoginTooltip() {
      if (!favTooltip) return;
      favTooltip.style.opacity = '0';
      favTooltip.style.pointerEvents = 'none';
      favTooltip.style.transform = 'translateY(-6px) scale(0.97)';
    }
    document.addEventListener('click', (e) => {
      if (favTooltip && !favBtn.contains(e.target as Node) && !favTooltip.contains(e.target as Node)) {
        hideLoginTooltip();
      }
    });

    favBtn.addEventListener('click', () => {
      if (!isLoggedIn) { showLoginTooltip(); return; }
      const nowFav = favBtn.dataset.favorited !== 'true';
      favBtn.dataset.favorited = String(nowFav);
      favBtn.setAttribute('aria-pressed', String(nowFav));
      // t.store.savedStore / saveStore — the SSR label above already reads them;
      // only this toggle had them inline, so a click re-labelled it in Hebrew.
      const favText = nowFav
        ? (favBtn.dataset.strSaved ?? 'חנות שמורה')
        : (favBtn.dataset.strSave ?? 'שמור חנות');
      if (favLabel) favLabel.textContent = favText;
      favBtn.setAttribute('aria-label', favText);
      setFavStyle(nowFav);
      favBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.28)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34,1.56,0.64,1)' }
      );
      fetch('/api/favorite-store', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ storeSlug: favSlug }),
      })
        .then((r) => r.json() as Promise<{ favorited: boolean; count: number }>)
        .then(({ favorited }) => {
          favBtn.dataset.favorited = String(favorited);
          favBtn.setAttribute('aria-pressed', String(favorited));
          setFavStyle(favorited);
          // The header's avatar menu lists these stores and caches them for the page's lifetime;
          // announced only after the SERVER answered, so the menu can never show a store whose
          // save did not actually land. Same shape as `cart:change`/`wishlist:change`.
          window.dispatchEvent(new CustomEvent('favorite:change'));
        })
        .catch(() => {
          favBtn.dataset.favorited = String(!nowFav);
          setFavStyle(!nowFav);
        });
    });
  }

  // ── Qty stepper + Add to cart (product grid) ──────────────────
  const cardCheckSvg ='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

  function initProductCardCommerce(card: HTMLElement): void {
    const addBtn = card.querySelector<HTMLButtonElement>('.add-to-cart-btn');
    if (!addBtn) return;

    const qtyDec = card.querySelector<HTMLButtonElement>('.qty-dec');
    const qtyInc = card.querySelector<HTMLButtonElement>('.qty-inc');
    const qtyVal = card.querySelector<HTMLElement>('.qty-val');
    const slug = addBtn.dataset.slug ?? '';
    const maxStock = Math.max(1, parseInt(addBtn.dataset.stock ?? '99', 10) || 99);
    const cardCategory = card.dataset.categoryPath ?? '';
    let qty = 1;

    // Ceiling isn't just the product's total stock — it's what's left after
    // whatever quantity of this same product already sits in the cart (added
    // from here, the quick-view, or elsewhere), so repeated add-to-cart clicks
    // can't push the cart past real stock once every unit is already in it.
    function ceiling(): number {
      return Math.max(0, maxStock - getCartQty(storeSlug, slug));
    }

    function updateQty(n: number) {
      if (!addBtn) return;
      const cap = ceiling();
      qty = cap <= 0 ? 0 : Math.max(1, Math.min(n, cap));
      // Hide the "1" default — showing it on every idle card in the grid
      // reads as repetitive clutter; the number earns its place once the
      // buyer actually picks more than one.
      if (qtyVal) { qtyVal.textContent = String(qty); qtyVal.style.display = qty > 1 ? '' : 'none'; }
      if (qtyDec) qtyDec.disabled = qty <= 1;
      if (qtyInc) qtyInc.disabled = cap <= 0 || qty >= cap;
      addBtn.disabled = cap <= 0;
    }

    updateQty(1);
    window.addEventListener('cart:change', () => updateQty(Math.max(qty, 1)));

    qtyDec?.addEventListener('click', () => updateQty(qty - 1));
    qtyInc?.addEventListener('click', () => updateQty(qty + 1));

    const labelSpan = addBtn.querySelector<HTMLElement>('.btn-label');
    const originalIcon = labelSpan?.innerHTML ?? '';
    const originalAriaLabel = addBtn.getAttribute('aria-label') ?? '';

    addBtn.addEventListener('click', () => {
      if (addBtn.disabled) return;
      // Variant products (color/size/etc.) can't be added blind from the
      // card — there's no room for a picker here. Open the quick view
      // instead, where the picker + its own add-to-cart already live, so
      // choosing a variant is the very next thing the buyer does rather
      // than a dead-end error.
      if (card.dataset.variants) {
        openCardModal(card, true);
        return;
      }
      const { productId = '', name = '', price = '0', basePrice = '', image = '' } = addBtn.dataset;
      addItem(storeSlug, storeName, { slug, productId, name, price: Number(price), basePrice: basePrice ? Number(basePrice) : undefined, image, stock: maxStock }, qty);
      // The catalog id, not the slug — a card can only reach this line for a product with NO
      // variants (a variant card opens the modal instead), so there is no combo to narrow to.
      trackAddToCart({ id: adItemId(productId), productId, name, price: Number(price), category: cardCategory }, qty);
      updateQty(1);

      if (labelSpan) labelSpan.innerHTML = cardCheckSvg;
      addBtn.setAttribute('aria-label', addBtn.dataset.labelAdded ?? originalAriaLabel);
      addBtn.disabled = true;
      addBtn.classList.add('btn--confirmed');
      spawnBurst(addBtn);

      addBtn.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
        { duration: 280, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
      );

      setTimeout(() => {
        if (labelSpan) labelSpan.innerHTML = originalIcon;
        addBtn.setAttribute('aria-label', originalAriaLabel);
        addBtn.classList.remove('btn--confirmed');
        updateQty(1); // re-enables only if stock remains, not blindly
      }, 1400);
    });
  }

  document.querySelectorAll<HTMLElement>('.product-card').forEach(initProductCardCommerce);

  // The SSR-rendered cards carry the same entrance animation the filter/load-more
  // path adds to freshly-injected cards (via `product-card--entering` + an inline
  // animation-delay), so the initial grid fades+rises in identically instead of
  // hard-appearing. Strip the marker once it's played so it never lingers.
  document.querySelectorAll<HTMLElement>('.product-card--entering').forEach((card) => {
    card.addEventListener('animationend', () => card.classList.remove('product-card--entering'), { once: true });
  });

  // Sticky filter bar → `.is-stuck` fades the frosted backdrop in once it pins
  // to the header (see lib/sticky-bar.ts; shared with the /stores directory).
  const controlsBar = document.querySelector<HTMLElement>('.store-controls');
  initStickyBar(controlsBar);
  // Not a sticky bar — the curtain's own top edge. Marks the moment .store-banner
  // rises past the header line, i.e. the moment real moving content is finally
  // under the header rather than the pinned banner, which is what lets the
  // header's shadow appear (header.css → "Store page: the curtain").
  initStickyBar(document.querySelector<HTMLElement>('.store-banner'), 3.4);

  // ── Search + Sort ─────────────────────────────────────────────
  const searchInput = document.getElementById('product-search') as HTMLInputElement | null;
  const sortTrigger = document.getElementById('sort-trigger')   as HTMLButtonElement | null;
  const sortMenu    = document.getElementById('sort-menu')      as HTMLUListElement | null;
  const sortLabel   = document.getElementById('sort-label')     as HTMLSpanElement | null;
  const sortChevron = document.getElementById('sort-chevron')   as SVGElement | null;
  const productGrid = document.querySelector<HTMLElement>('.product-grid');
  const noResults   = document.getElementById('no-results');
  const loadMoreWrap = document.getElementById('load-more-wrap') as HTMLElement | null;
  // An anchor, not a button — it carries the `?page=N+1` href that is this catalog's
  // only crawl path past product 24. See its markup for why.
  const loadMoreBtn  = document.getElementById('load-more-btn')  as HTMLAnchorElement | null;
  const loadMoreLabel = document.getElementById('load-more-label') as HTMLElement | null;
  const searchHeading = document.getElementById('search-results-heading') as HTMLElement | null;
  const searchHeadingText = document.getElementById('search-results-heading-text') as HTMLElement | null;
  const searchResultsClear = document.getElementById('search-results-clear') as HTMLButtonElement | null;
  const localSearchClose  = document.getElementById('local-search-close') as HTMLButtonElement | null;

  // Plain always-open field — the only dynamic bit is the trailing "x", which
  // only shows once there's something to clear.
  function updateLocalSearchClearBtn(): void {
    if (localSearchClose) localSearchClose.hidden = !searchInput?.value.trim();
  }
  function clearLocalSearch(): void {
    if (searchInput) searchInput.value = '';
    updateLocalSearchClearBtn();
    refreshFromServer();
  }
  localSearchClose?.addEventListener('click', () => { clearLocalSearch(); searchInput?.focus(); });
  searchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') clearLocalSearch();
  });

  let currentSort = 'default';
  let activeTag = '';
  // Set true wherever activeTag actually changes; refreshFromServer() consumes
  // it to decide whether renderCategoryNav() needs to run this time (sort/
  // search-only refreshes never touch the category, so should skip it).
  let pendingCategoryNav = false;
  // Set only by the header/general search bar (never by the local, in-filter
  // search box) — the effective query while activeTag === '' due to that
  // search overriding the category filter. preGlobalSearchTag remembers what
  // activeTag was right before the override, so clearing the header search
  // (its native "x") restores the filter the user was actually browsing.
  let globalQuery = '';
  let preGlobalSearchTag: string | null = null;

  // Called whenever the category filter changes via a direct user action (chip,
  // breadcrumb, drawer) — not via the header search's own override/restore path
  // below — so a manual filter pick always wins over a stale global search.
  function clearGlobalSearch(): void {
    globalQuery = '';
    preGlobalSearchTag = null;
    const hInput = document.getElementById('header-search-input') as HTMLInputElement | null;
    if (hInput) hInput.value = '';
  }

  // The local (in-filter) search box only applies while a category is selected;
  // outside of that, whatever the header search bar last set is what's in effect.
  function effectiveQuery(): string {
    return activeTag ? (searchInput?.value.trim() ?? '') : globalQuery;
  }

  // How far into the RESULT SET the grid currently reaches — which on `?page=3` is not the number
  // of cards in the DOM. The server writes the true offset onto the load-more button, so read it
  // there and fall back to the card count for page 1; counting children alone would make "load
  // more" on page 3 re-fetch page 2.
  let loadedCount = Number(
    (document.getElementById('load-more-btn') as HTMLElement | null)?.dataset.offset
      ?? productGrid?.children.length ?? 0,
  ) || 0;

  // ── Category filter — drill-down breadcrumb + chip row ─────────
  // Selecting a category re-renders the nav to show *its* children as the
  // next chip row (not a flat list of every category at once); the product
  // grid itself is what refreshFromServer() already refetches.
  interface StoreCategoryTreeNode { id: string; name: string; parentId: string | null; children: StoreCategoryTreeNode[] }
  let categoryTree: StoreCategoryTreeNode[] = [];
  try { categoryTree = JSON.parse(document.getElementById('store-category-tree-data')?.textContent ?? '[]') as StoreCategoryTreeNode[]; }
  catch { categoryTree = []; }

  function flattenTree(nodes: StoreCategoryTreeNode[]): StoreCategoryTreeNode[] {
    return nodes.flatMap((n) => [n, ...flattenTree(n.children)]);
  }
  const flatCategories = flattenTree(categoryTree);

  // Subtree product counts, keyed by category id (see countProductsPerCategory).
  let categoryCounts: Record<string, number> = {};
  try { categoryCounts = JSON.parse(document.getElementById('store-category-counts')?.textContent ?? '{}') as Record<string, number>; }
  catch { categoryCounts = {}; }

  /** The count badge for a chip/menu row — empty string when there's nothing to
   *  show, so an empty category renders exactly as it did before rather than
   *  carrying a "0" that reads as broken. */
  function countBadgeHtml(id: string, cls = 'category-chip__count'): string {
    const n = categoryCounts[id] ?? 0;
    return n > 0 ? `<span class="${cls}">${n}</span>` : '';
  }

  const CHIP_CHEVRON_SVG = '<svg class="category-chip__chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>';

  /**
   * The href a chip or breadcrumb crumb points at — the client's copy of the page's own
   * `storeViewHref`, and it has to stay identical to it.
   *
   * A drill-down re-renders this row from the tree, and a chip rebuilt without an href would be
   * the `<button>` again: invisible to a crawler, no middle-click, no shareable link. The site's
   * standing SSR/AJAX-parity rule, applied to the one attribute that carries the SEO.
   *
   * `toSlug` is the shared one from url-base.ts, so a category's URL is spelled the same in the
   * server render, in this rebuild and in the sitemap.
   */
  function categoryHref(category?: { id: string; name: string } | null): string {
    if (!category) return `/${storeSlug}`;
    // toSlug(name) || id — a name with no sluggable characters ("★★★") would otherwise build
    // `?category=` and quietly link to the whole catalog. Mirrors store-categories.ts#categoryUrlParam.
    const param = toSlug(category.name) || category.id;
    return `/${storeSlug}?category=${encodeURIComponent(param)}`;
  }

  function categoryAncestorChain(categoryId: string): StoreCategoryTreeNode[] {
    const chain: StoreCategoryTreeNode[] = [];
    let current = flatCategories.find((c) => c.id === categoryId);
    while (current) {
      chain.unshift(current);
      current = current.parentId ? flatCategories.find((c) => c.id === current!.parentId) : undefined;
    }
    return chain;
  }

  function categoryPathFor(categoryId: string): string {
    return categoryAncestorChain(categoryId).map((c) => c.name).join(' › ');
  }

  // Mirrors the SSR badge above — see the SSR/AJAX-parity rule in AI_INSTRUCTIONS. The CLASS is now
  // read off the root rather than written out a second time here: the two copies had already drifted
  // once (the injected one kept `mb-1` after the badge moved onto the picture), and a class list
  // duplicated between a server render and a client render is the same drift class as
  // memory `project_client_renderer_i18n_drift`. One definition, in the frontmatter, handed over.
  const demoRoot = document.querySelector<HTMLElement>('.store-page');
  const demoProductBadgeHtml = demoRoot?.dataset.demo
    ? `<span class="${escHtml(demoRoot.dataset.demoBadgeClass ?? '')}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.6v.6"/></svg>${escHtml(demoRoot.dataset.demoLabel ?? '')}</span>`
    : '';

  const storeControls = document.querySelector<HTMLElement>('.store-controls');
  const categoryFilters = document.getElementById('category-filters') as HTMLElement | null;
  const categoryFiltersWrap = document.getElementById('category-filters-wrap') as HTMLElement | null;
  const categoryFiltersPrev = document.getElementById('category-filters-prev') as HTMLButtonElement | null;
  const categoryFiltersNext = document.getElementById('category-filters-next') as HTMLButtonElement | null;
  const isRtl = document.documentElement.dir === 'rtl';

  // One row, no wrap — overflow becomes horizontal scroll with edge arrows.
  // Shared with the /stores directory, which reuses both this and the CSS.
  const { update: updateCategoryArrows } = initChipScroller({
    row: categoryFilters, prev: categoryFiltersPrev, next: categoryFiltersNext,
  });

  function renderCategoryNav(): void {
    if (!storeControls) return;
    const selected = activeTag ? flatCategories.find((c) => c.id === activeTag) ?? null : null;
    const chain = selected ? categoryAncestorChain(selected.id) : [];
    const children = selected ? selected.children : categoryTree;
    const i18n = getPMI18n();

    const categoryNavRow = document.getElementById('category-nav-row');
    if (categoryNavRow) categoryNavRow.hidden = chain.length === 0;

    let breadcrumbEl = document.getElementById('category-breadcrumb');
    if (chain.length) {
      const breadcrumbHtml = `
          <a href="${escHtml(categoryHref(null))}" class="category-breadcrumb__crumb" data-category-id="">${escHtml(i18n?.filterAll ?? '')}</a>
          ${chain.map((c, i) => `
            <span class="category-breadcrumb__sep" aria-hidden="true">›</span>
            ${i === chain.length - 1
              ? `<span class="category-breadcrumb__current">${escHtml(c.name)}</span>`
              : `<a href="${escHtml(categoryHref(c))}" class="category-breadcrumb__crumb" data-category-id="${escHtml(c.id)}">${escHtml(c.name)}</a>`}
          `).join('')}
        `;
      if (!breadcrumbEl) {
        breadcrumbEl = document.createElement('nav');
        breadcrumbEl.id = 'category-breadcrumb';
        breadcrumbEl.className = 'category-breadcrumb';
        categoryNavRow?.prepend(breadcrumbEl);
      }
      breadcrumbEl.setAttribute('aria-label', i18n?.filterByCategory ?? '');
      breadcrumbEl.innerHTML = breadcrumbHtml;
    } else {
      breadcrumbEl?.remove();
      // The local search box is only meaningful while a category filter is active —
      // once the user navigates back to "all", reset it rather than leaving a stale
      // query silently still narrowing an unfiltered view.
      if (searchInput) searchInput.value = '';
      updateLocalSearchClearBtn();
    }

    if (categoryFilters && categoryFiltersWrap) {
      categoryFiltersWrap.hidden = children.length === 0;
      categoryFilters.scrollLeft = 0;
      categoryFilters.innerHTML = `
        ${selected
          // Inside a category the breadcrumb states where you are; the row only offers where to
          // go next — see the server render for the full history of that line.
          ? ''
          : `<a href="${escHtml(categoryHref(null))}" class="category-chip" data-category-id="" aria-current="page">${escHtml(i18n?.filterAll ?? '')}</a>`}
        ${children.map((c) => `<a href="${escHtml(categoryHref(c))}" class="category-chip" data-category-id="${escHtml(c.id)}"${c.children.length > 0 ? ' data-has-children="true"' : ''}>${escHtml(c.name)}${countBadgeHtml(c.id)}${c.children.length > 0 ? CHIP_CHEVRON_SVG : ''}</a>`).join('')}
      `;
      updateCategoryArrows();
      requestAnimationFrame(updateCategoryArrows);
    }
  }

  storeControls?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-category-id]');
    if (!btn) return;
    // The chips and the breadcrumb are real <a href> now, so that a crawler can follow them and
    // so that middle-click / "open in new tab" / a shared link all work. For a plain left click we
    // still filter in place — a full navigation to re-draw one grid is the round trip this page
    // spent the session removing. Modified clicks fall through to the browser on purpose.
    const isLink = btn instanceof HTMLAnchorElement;
    if (isLink) {
      const me = e as MouseEvent;
      if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
      e.preventDefault();
    }
    clearGlobalSearch();
    activeTag = btn.dataset.categoryId ?? '';
    pendingCategoryNav = true;
    updateDrawerToggleLabel();
    refreshFromServer();
  });

  // Desktop only (real mouse hover — matchMedia guard, same reasoning as
  // every other hover-only affordance on the site: a touch tap has no
  // pointer-leave event to clear a "stuck" hover). Hovering a chip with
  // children shows its subcategories in one shared, position:fixed panel —
  // fixed (not absolute) so it's never clipped by the chip row's own
  // overflow-x:auto, and viewport-positioned via the hovered chip's own
  // getBoundingClientRect(), no DOM relocation needed. Mobile has no hover
  // at all, so it doesn't get this — see the mobile category drawer below.
  const chipDropdown = document.getElementById('category-chip-dropdown') as HTMLElement | null;
  if (chipDropdown && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    // The dropdown reveals on hover; a further level (a 3rd category depth)
    // drills in on click instead, same shape as the dashboard's own
    // toolbar filter dropdown (products.ts) — one shared panel, content
    // swapped in place, a back row to return, not a second cascading
    // panel. anchorNode is whatever chip was originally hovered, so "back"
    // always has something to return to regardless of how deep a click
    // drilled.
    let anchorNode: StoreCategoryTreeNode | null = null;

    function renderChipDropdownLevel(nodes: StoreCategoryTreeNode[], showBack: boolean): void {
      if (!chipDropdown) return;
      const i18n = getPMI18n();
      chipDropdown.innerHTML = `
        ${showBack ? `<button type="button" class="category-chip-dropdown__back" data-back="1">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            ${escHtml(anchorNode?.name ?? i18n?.filterAll ?? '')}
          </button>` : ''}
        ${nodes.map((c) => `
          <button type="button" class="category-chip-option" role="menuitem" data-category-id="${escHtml(c.id)}"${c.children.length ? ` data-drill="${escHtml(c.id)}"` : ''}>
            <span>${escHtml(c.name)}${countBadgeHtml(c.id, 'category-chip__count category-chip-option__count')}</span>
            ${c.children.length ? `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>` : ''}
          </button>`).join('')}
      `;
    }

    // Tracks whichever chip the open panel is currently anchored to, so a
    // page scroll can re-read its new position (see repositionOrHideChipDropdown
    // below) instead of just closing the panel outright.
    let currentChip: HTMLElement | null = null;

    function positionChipDropdown(chip: HTMLElement): void {
      if (!chipDropdown) return;
      const rect = chip.getBoundingClientRect();
      chipDropdown.style.top = `${rect.bottom + 5}px`;
      if (isRtl) chipDropdown.style.right = `${window.innerWidth - rect.right}px`;
      else chipDropdown.style.left = `${rect.left}px`;
    }

    function showChipDropdown(chip: HTMLElement): void {
      clearTimeout(hideTimer);
      const id = chip.dataset.categoryId ?? '';
      const node = flatCategories.find((c) => c.id === id);
      if (!node?.children.length || !chipDropdown) return;
      // In case a re-hover interrupts an in-progress close (see hideChipDropdown).
      chipDropdown.classList.remove('dropdown--closing');
      anchorNode = node;
      currentChip = chip;
      renderChipDropdownLevel(node.children, false);
      positionChipDropdown(chip);
      chipDropdown.hidden = false;
    }

    // Same fade-out used by the header's own dropdowns (.dropdown--closing,
    // header.css) — an instant hidden=true read as an abrupt disappearance;
    // this gives it a brief, consistent exit instead.
    function hideChipDropdown(): void {
      if (!chipDropdown || chipDropdown.hidden) return;
      currentChip = null;
      if (chipDropdown.classList.contains('dropdown--closing')) return;
      chipDropdown.classList.add('dropdown--closing');
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        chipDropdown!.classList.remove('dropdown--closing');
        chipDropdown!.hidden = true;
      };
      chipDropdown.addEventListener('animationend', finish, { once: true });
      setTimeout(finish, 200);
    }

    function hideChipDropdownSoon(): void {
      clearTimeout(hideTimer);
      hideTimer = setTimeout(hideChipDropdown, 150);
    }

    categoryFilters?.addEventListener('mouseover', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-has-children="true"]');
      if (chip) showChipDropdown(chip);
    });
    categoryFilters?.addEventListener('mouseout', (e) => {
      const toChip = (e.relatedTarget as HTMLElement | null)?.closest?.('[data-has-children="true"]');
      const toDropdown = (e.relatedTarget as HTMLElement | null)?.closest?.('.category-chip-dropdown');
      if (!toChip && !toDropdown) hideChipDropdownSoon();
    });
    chipDropdown.addEventListener('mouseenter', () => clearTimeout(hideTimer));
    chipDropdown.addEventListener('mouseleave', hideChipDropdownSoon);
    categoryFilters?.addEventListener('scroll', hideChipDropdown, { passive: true });
    // The panel is position:fixed and JS-positioned once, on open — it never
    // re-reads the chip's position afterward, so scrolling the *page*
    // vertically leaves it visually detached from the chip it belongs to.
    // Track the chip's live position instead of just closing the panel —
    // the mouse hasn't left it, so an outright close on the very first pixel
    // of scroll would be wrong. Only close if the chip itself has scrolled
    // out of the viewport (nothing sensible left to stay anchored to).
    window.addEventListener('scroll', () => {
      if (!currentChip || chipDropdown!.hidden) return;
      const rect = currentChip.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) hideChipDropdown();
      else positionChipDropdown(currentChip);
    }, { passive: true });

    // Click a node that itself has children → drill into it (replace the
    // panel's content, don't select yet); click "back" → return to the
    // anchor's own children. A leaf click falls through to the existing
    // delegated [data-category-id] selection handler on .store-controls.
    chipDropdown.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-back]')) {
        e.stopPropagation();
        if (anchorNode) renderChipDropdownLevel(anchorNode.children, false);
        return;
      }
      const drillId = target.closest<HTMLElement>('[data-drill]')?.dataset.drill;
      if (drillId) {
        // A drill row also carries data-category-id (so it stays reachable
        // as a real category id elsewhere), which would otherwise also
        // match the delegated [data-category-id] select handler on
        // .store-controls as this same click bubbles up — stop it here so
        // drilling in never *also* applies it as the filter.
        e.stopPropagation();
        const node = flatCategories.find((c) => c.id === drillId);
        if (node?.children.length) renderChipDropdownLevel(node.children, true);
        return;
      }
      // A real leaf selection (no data-back, no data-drill) — let it bubble
      // up to apply the filter as usual, but also close the flyout right
      // away instead of leaving it open until the mouse happens to leave.
      if (target.closest('[data-category-id]')) hideChipDropdown();
    });

    // Closing only relied on mouseout/mouseleave until now — a click anywhere
    // that isn't inside the panel itself should also close it, including a
    // click on the very chip that opened it (currently: applies the filter
    // but leaves the flyout hanging open with nothing telling it to close).
    // composedPath(), not target.contains() — renderChipDropdownLevel rewrites
    // the panel's innerHTML on drill/back, which can detach e.target mid-bubble.
    document.addEventListener('click', (e) => {
      if (chipDropdown!.hidden) return;
      if (!e.composedPath().includes(chipDropdown!)) hideChipDropdown();
    });
  }

  // ── Mobile category drawer (touch — no hover) ───────────────────
  // Same single-branch accordion shape as the site's own dashboard
  // category-picker.ts: only one branch open at a time, a plain "הכל" row
  // inside an open group selects that branch itself.
  const drawerToggle = document.getElementById('category-drawer-toggle') as HTMLButtonElement | null;
  const drawerToggleLabel = document.getElementById('category-drawer-toggle-label') as HTMLElement | null;
  const drawer = document.getElementById('category-drawer') as HTMLElement | null;
  const drawerOverlay = document.getElementById('category-drawer-overlay') as HTMLElement | null;
  const drawerBody = document.getElementById('category-drawer-body') as HTMLElement | null;
  const drawerClose = document.getElementById('category-drawer-close') as HTMLButtonElement | null;
  let drawerExpandedPath: string[] = [];
  let drawerPrevFocus: HTMLElement | null = null;

  function renderDrawerRow(node: StoreCategoryTreeNode): string {
    const i18n = getPMI18n();
    const isOpen = drawerExpandedPath.includes(node.id);
    const hasKids = node.children.length > 0;
    const groupHtml = isOpen && hasKids
      ? `<div class="category-drawer-group">
          <button type="button" class="category-drawer-option${node.id === activeTag ? ' is-selected' : ''}" data-select="${escHtml(node.id)}">${escHtml(i18n?.filterAll ?? '')}</button>
          ${node.children.map((c) => renderDrawerRow(c)).join('')}
        </div>`
      : '';
    return `
      <button type="button" class="category-drawer-option${!hasKids && node.id === activeTag ? ' is-selected' : ''}"
              ${hasKids ? `data-toggle="${escHtml(node.id)}"` : `data-select="${escHtml(node.id)}"`}>
        <span>${escHtml(node.name)}${countBadgeHtml(node.id, 'category-chip__count category-chip-option__count')}</span>
        ${hasKids ? `<svg class="category-drawer-chev${isOpen ? ' is-open' : ''}" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>` : ''}
      </button>
      ${groupHtml}`;
  }

  function renderDrawerBody(): void {
    if (!drawerBody) return;
    const i18n = getPMI18n();
    drawerBody.innerHTML = `
      <button type="button" class="category-drawer-option${!activeTag ? ' is-selected' : ''}" data-select="">${escHtml(i18n?.filterAll ?? '')}</button>
      ${categoryTree.map((n) => renderDrawerRow(n)).join('')}
    `;
  }

  function updateDrawerToggleLabel(): void {
    if (!drawerToggleLabel) return;
    const selected = activeTag ? flatCategories.find((c) => c.id === activeTag) : undefined;
    drawerToggleLabel.textContent = selected ? selected.name : (getPMI18n()?.filterByCategory ?? '');
  }

  function openDrawer(): void {
    if (!drawer || !drawerOverlay) return;
    drawerPrevFocus = document.activeElement as HTMLElement;
    const chain = activeTag ? categoryAncestorChain(activeTag) : [];
    drawerExpandedPath = chain.filter((n) => n.children.length > 0).map((n) => n.id);
    renderDrawerBody();
    drawer.classList.add('is-open');
    drawerOverlay.classList.add('is-open');
    drawer.removeAttribute('aria-hidden');
    drawerToggle?.setAttribute('aria-expanded', 'true');
    drawerClose?.focus();
  }

  function closeDrawer(): void {
    if (!drawer || !drawerOverlay) return;
    drawer.classList.remove('is-open');
    drawerOverlay.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    drawerToggle?.setAttribute('aria-expanded', 'false');
    drawerPrevFocus?.focus();
    drawerPrevFocus = null;
  }

  drawerToggle?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', closeDrawer);
  drawerOverlay?.addEventListener('click', closeDrawer);

  drawerBody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const toggleBtn = target.closest<HTMLButtonElement>('[data-toggle]');
    if (toggleBtn) {
      const id = toggleBtn.dataset.toggle ?? '';
      const idx = drawerExpandedPath.indexOf(id);
      if (idx !== -1) {
        drawerExpandedPath = drawerExpandedPath.slice(0, idx);
      } else {
        const node = flatCategories.find((c) => c.id === id);
        const lastOpen = drawerExpandedPath[drawerExpandedPath.length - 1] ?? null;
        drawerExpandedPath = node?.parentId === lastOpen ? [...drawerExpandedPath, id] : [id];
      }
      renderDrawerBody();
      return;
    }

    const selectBtn = target.closest<HTMLButtonElement>('[data-select]');
    if (selectBtn) {
      clearGlobalSearch();
      activeTag = selectBtn.dataset.select ?? '';
      pendingCategoryNav = true;
      updateDrawerToggleLabel();
      refreshFromServer();
      closeDrawer();
    }
  });

  // Focus trap — Tab/Shift+Tab wrap within the drawer while it's open, same
  // shape as CartDrawer.astro's own trapFocus.
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (drawer?.getAttribute('aria-hidden') === 'true') return;
    if (e.key === 'Escape') { closeDrawer(); return; }
    if (e.key !== 'Tab' || !drawer) return;
    const focusable = Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  updateDrawerToggleLabel();

  // ── Server-driven product cards (initial page + load more + refilter) ──
  // Card markup is duplicated here from the Astro template above by hand —
  // Astro has no client-side component reactivity, so this mirrors the same
  // pattern already used elsewhere on this site for dynamically-injected
  // rows (CartDrawer, WishlistDrawer, the quick-view modal body).
  function getI18nCart(): Record<string, string> {
    try { return JSON.parse(document.getElementById('i18n-data')?.textContent ?? '{}')?.cart ?? {}; }
    catch { return {}; }
  }

  function renderProductCardHTML(p: StoreProductDTO, isNew: boolean): string {
    const pi = getPMI18n();
    const ci = getI18nCart();
    const hasImages = !!(p.images && p.images.length);
    const firstImg = p.images?.[0] ? cdnSrc(p.images[0]) : '';
    const pv = resolvePrice(p, storeSale);

    // Same deferral as the server-rendered cards above: only the first slide gets
    // a real src; the rest hold the blank pixel until hydrateCardSlides() runs.
    const slidesHtml = hasImages
      ? p.images!.map((img, i) => {
          const ss = cdnSrcSet(img, [300, 400, 600, 800]);
          const srcsetAttr = ss ? (i === 0 ? ` srcset="${escHtml(ss)}"` : ` data-srcset="${escHtml(ss)}"`) : '';
          return `<div class="product-card__slide"><img src="${i === 0 ? escHtml(cdnSrc(img)) : BLANK_PIXEL}"${i === 0 ? '' : ` data-src="${escHtml(cdnSrc(img))}"`}${srcsetAttr} sizes="(max-width: 640px) 48vw, 340px" alt="${escHtml(p.name)}" class="product-card__img" width="400" height="400" loading="lazy" decoding="async" /></div>`;
        }).join('')
      : `<div class="product-card__slide"><div class="product-card__img-placeholder" aria-hidden="true"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div></div>`;

    const dotsHtml = hasImages && (p.images?.length ?? 0) > 1
      ? `<div class="product-card__dots" aria-hidden="true">${p.images!.map((_, i) => `<span class="product-card__dot${i === 0 ? ' is-active' : ''}"></span>`).join('')}</div>`
      : '';

    const stockHtml = p.stock <= 0
      ? `<span class="badge badge--muted">${escHtml(pi.outOfStock ?? '')}</span>`
      : `<div dir="ltr" class="product-card__qtycart flex items-center" style="width:100%;height:2.25rem;border:1px solid var(--color-border);border-radius:var(--radius);overflow:hidden">
          <button type="button" class="qty-dec flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label="${escHtml(ci.qtyDecrease ?? '')}" disabled>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <button type="button" class="product-card__add-btn add-to-cart-btn" data-slug="${escHtml(p.slug)}" data-product-id="${escHtml(p.id)}" data-name="${escHtml(p.name)}" data-price="${pv.price}"${pv.isDiscounted ? ` data-base-price="${pv.basePrice}"` : ''} data-image="${escHtml(firstImg)}" data-stock="${p.stock}" data-label-added="${escHtml(pi.addedToCart ?? '')}" aria-label="${escHtml(pi.addToCart ?? '')}">
            <span class="btn-label" aria-hidden="true">
              <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                <circle cx="17" cy="21" r="1.3" fill="currentColor" stroke="none"/>
                <path d="M1 3h2.4l2.72 13.4a2 2 0 0 0 2 1.6h7.76a2 2 0 0 0 2-1.6L20.4 7H5.1"/>
                <path d="M5.2 11.9h13.9M10.3 7.8L9.6 17.2M15 7.8L14.3 17.2" stroke-width="1.1"/>
              </svg>
            </span>
            <span class="qty-val text-sm font-semibold select-none" style="display:none" aria-live="polite" aria-atomic="true">1</span>
          </button>
          <button type="button" class="qty-inc flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-bg)] active:scale-95 transition-colors duration-100 disabled:opacity-30" style="width:2.25rem;height:100%" aria-label="${escHtml(ci.qtyIncrease ?? '')}">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>`;

    return `<li class="product-card card"
        ${hasImages ? `data-images="${escHtml(JSON.stringify(p.images))}"` : ''}
        data-product-name="${escHtml(p.name)}"
        data-price="${pv.price}"
        data-created-at="${escHtml(p.createdAt)}"
        data-slug="${escHtml(p.slug)}"
        data-description="${escHtml(p.description || '')}"
        data-stock="${p.stock}"
        data-category-id="${escHtml(p.categoryId ?? '')}"
        data-category-path="${escHtml(p.categoryId ? categoryPathFor(p.categoryId) : '')}"
        data-tags="${escHtml(p.tags?.length ? p.tags.join(',') : '')}"
        ${p.variants?.length ? `data-variants="${escHtml(JSON.stringify(p.variants))}"` : ''}
        ${p.variantStock ? `data-variant-stock="${escHtml(JSON.stringify(p.variantStock))}"` : ''}
        ${p.variantImages ? `data-variant-images="${escHtml(JSON.stringify(p.variantImages))}"` : ''}>
      <div class="product-card__img-wrap${hasImages ? ' product-card__img-wrap--clickable' : ''}"${hasImages ? ' data-skeleton' : ''} ${hasImages ? `role="button" aria-label="${escHtml(p.name)}" tabindex="0"` : ''}>
        <div class="product-card__slides">${slidesHtml}</div>
        ${isNew ? `<span class="img-badge badge--new">${escHtml(pi.badgeNew ?? '')}</span>` : ''}
        ${saleBadgeHtml(pv, pi.saleBadge)}
        <button type="button" class="wishlist-btn" data-wishlist-slug="${escHtml(p.slug)}" data-wishlist-name="${escHtml(p.name)}" data-wishlist-price="${pv.price}" data-wishlist-image="${escHtml(firstImg)}" data-wishlist-store-slug="${escHtml(storeSlug)}" data-wishlist-store-name="${escHtml(storeName)}" data-wishlist-stock="${p.stock}" data-wishlisted="false" aria-pressed="false" aria-label="${escHtml(pi.addToWishlist ?? '')}" style="position:absolute;top:0.45rem;inset-inline-end:0.45rem;z-index:2;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,0.9);color:var(--color-muted);transition:color 0.15s,background 0.15s,transform 0.15s">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        ${dotsHtml}
        ${demoProductBadgeHtml}
      </div>
      <div class="product-card__body" dir="auto">
        <a href="/${escHtml(storeSlug)}/${escHtml(p.slug)}" class="product-modal-trigger hover:text-[var(--color-accent)] transition-colors duration-150" style="color:inherit;text-decoration:none;display:block">
          <h3 class="product-card__name">${escHtml(p.name)}</h3>
        </a>
        <div class="product-card__footer" style="flex-direction:column;align-items:stretch;gap:0.4rem">
          <span class="product-card__price-wrap">${priceHtml(pv, { className: 'product-card__price', saleLabel: pi.saleWas })}</span>
          ${stockHtml}
        </div>
      </div>
    </li>`;
  }

  function htmlToElement(html: string): HTMLElement {
    const template = document.createElement('template');
    template.innerHTML = html.trim();
    return template.content.firstElementChild as HTMLElement;
  }

  function initNewProductCards(cards: HTMLElement[]): void {
    cards.forEach((card) => {
      card.querySelectorAll<HTMLButtonElement>('.wishlist-btn').forEach(initWishlistBtn);
      initProductCardCommerce(card);
      initCarouselDots(card);
      initCardClickToModal(card);
      card.querySelectorAll<HTMLElement>('.product-card__img-wrap--clickable').forEach(initImageClickToModal);
      card.querySelectorAll<HTMLAnchorElement>('.product-modal-trigger').forEach(initNameLinkToModal);
    });
    // Once for the batch, not once per card: the helper sweeps the document for wraps still marked
    // loading, so calling it per card would re-observe the ones already handled.
    initImageSkeleton();
  }

  function appendProductCards(newProducts: StoreProductDTO[], animate: boolean): HTMLElement[] {
    if (!productGrid) return [];
    const todayStr = new Date().toDateString();
    const cards = newProducts.map((p, i) => {
      const isNew = new Date(p.createdAt).toDateString() === todayStr;
      const card = htmlToElement(renderProductCardHTML(p, isNew));
      if (animate) {
        card.classList.add('product-card--entering');
        card.style.animationDelay = `${Math.min(i, 12) * 40}ms`;
        card.addEventListener('animationend', () => card.classList.remove('product-card--entering'), { once: true });
      }
      productGrid.appendChild(card);
      return card;
    });
    initNewProductCards(cards);
    loadedCount = productGrid.children.length;
    return cards;
  }

  function updateResultsState(hasMore: boolean): void {
    const hasAny = loadedCount > 0;
    const hasQuery = !!effectiveQuery();
    if (productGrid) productGrid.hidden = !hasAny;
    // The generic empty-state icon+text is redundant once #search-results-heading is
    // already showing a "no results for X" message naming the actual query.
    if (noResults) noResults.hidden = hasAny || hasQuery;
    if (loadMoreWrap) loadMoreWrap.hidden = !hasMore;
    if (loadMoreBtn) {
      loadMoreBtn.dataset.offset = String(loadedCount);
      // The button is a real `<a href>` — that is the whole crawl path (see its markup).
      // It has to keep naming the next page OF THE VIEW ON SCREEN, so a shopper who filtered
      // to one category and pressed it four times still has a link that means something, and
      // so a crawler landing on this URL walks THIS shelf rather than the unfiltered one.
      // Built from the address bar, which syncUrl() has already brought in line with the view.
      // And REMOVED when there is no next page: an href that outlives the last slice points at a
      // URL that redirects to page 1, whose button points forward again — a loop for anything
      // that follows links rather than looking at the screen.
      if (hasMore) {
        const next = new URL(window.location.href);
        next.searchParams.set('page', String(Math.floor(loadedCount / PRODUCTS_PAGE_SIZE) + 1));
        loadMoreBtn.setAttribute('href', next.pathname + next.search);
      } else {
        loadMoreBtn.removeAttribute('href');
      }
    }
    updateSearchHeading();
  }

  function updateSearchHeading(): void {
    if (!searchHeading) return;
    const q = effectiveQuery();
    if (!q) { searchHeading.hidden = true; return; }
    const i18n = getPMI18n();
    const template = loadedCount > 0 ? i18n.searchResultsFor : i18n.noResultsFor;
    if (searchHeadingText) searchHeadingText.textContent = (template ?? '').replace('{query}', q);
    searchHeading.hidden = false;
  }

  // Clears whichever search is currently in effect (the local, in-filter box or
  // the header's own global override) from the results heading's own "x" —
  // one clear action regardless of which of the two search bars produced it.
  function clearActiveSearch(): void {
    if (activeTag) {
      clearLocalSearch();
    } else {
      const hInput = document.getElementById('header-search-input') as HTMLInputElement | null;
      if (hInput) hInput.value = '';
      window.dispatchEvent(new CustomEvent('store-search:global', { detail: { q: '' } }));
    }
  }
  searchResultsClear?.addEventListener('click', clearActiveSearch);

  /**
   * `ok` is the whole point of this shape, and it was missing until 2026-08-10.
   *
   * A failed request used to return `{ products: [], hasMore: false }` — the exact value a
   * SUCCESSFUL request returns for a store whose last page you have already seen. Both callers
   * then acted on it as fact, and both of them lied to the shopper rather than showing an error:
   * "טען עוד" hid its own button (`updateResultsState(false)`), i.e. announced "that is the whole
   * catalogue" when the server had simply not answered; and a category or sort click blanked the
   * grid and rendered "no results", i.e. announced that a store with products has none. Neither
   * left anything on screen saying a thing had gone wrong, and both are unrecoverable without a
   * manual reload since the request is never retried.
   *
   * An empty answer and no answer are different facts, so they get different values. What each
   * caller does with a failure is its own business — the shared part is only that neither may
   * treat one as the other.
   */
  async function fetchProductsPage(offset: number): Promise<{ ok: boolean; products: StoreProductDTO[]; hasMore: boolean }> {
    const params = new URLSearchParams({ store: storeSlug, offset: String(offset) });
    if (activeTag) params.set('category', activeTag);
    if (currentSort !== 'default') params.set('sort', currentSort);
    const q = effectiveQuery();
    if (q) params.set('q', q);
    try {
      const res = await fetch(`/api/store-products?${params.toString()}`);
      const data = await res.json() as { ok: boolean; products?: StoreProductDTO[]; hasMore?: boolean };
      if (!data.ok) return { ok: false, products: [], hasMore: false };
      return { ok: true, products: data.products ?? [], hasMore: !!data.hasMore };
    } catch {
      // silent: reported by the callers — both of them turn `ok: false` into a toast and keep
      // whatever is on screen, rather than drawing an empty catalogue.
      return { ok: false, products: [], hasMore: false };
    }
  }

  /** The shopper-facing half of the above. The site's one toast surface (lib/toast.ts) — this is a
   *  transient failure of a thing they asked for, not a state of the page, so it does not belong
   *  as an inline panel that would then have to be cleared again. */
  function reportProductsLoadFailure(): void {
    const s = getPMI18n();
    showErrorToast(s.loadFailedTitle ?? '', s.loadFailedBody ?? '');
  }

  // Guards against an older, slower request (e.g. rapid category clicks)
  // resolving after a newer one and clobbering the grid with stale results.
  let refreshToken = 0;

  // How long a filter may take before it is allowed to say it is loading.
  //
  // The loading cue is a 2px sweeping bar above the grid, not a grey-out of it (owner,
  // 2026-08-03). Fading the products a shopper is reading says "loading" by taking something away —
  // the page reads as broken rather than busy. The bar adds a signal instead, is what this project
  // already uses elsewhere, and carries its own delay in CSS so a fast filter shows nothing at all.
  const loadingBar = document.getElementById('store-products-loading');

  async function refreshFromServer(): Promise<void> {
    syncUrl();
    const token = ++refreshToken;
    if (!productGrid) return;
    // The old grid is wholesale-replaced by the new result set the instant the
    // fetch resolves — a different product count, almost always a different
    // total height (switching to "All", the largest possible set, is the most
    // dramatic case). That swap is correct, but with nothing marking it as a
    // deliberate transition, an instant hard-cut between two very different
    // renderings reads as the layout "resetting". The bar above the grid is
    // that marker now — see LoadingSweep.astro for why it replaced dimming.
    startLoadingSweep(loadingBar);
    const { ok, products: page, hasMore } = await fetchProductsPage(0);
    // A newer filter is already in flight: it owns the bar and the grid now.
    if (token !== refreshToken) return;
    stopLoadingSweep(loadingBar);
    // The request failed. The grid on screen is now stale — it is the PREVIOUS filter's result —
    // but stale-and-labelled beats "this category is empty", which is what emptying it here would
    // have claimed. The URL has already been synced, so a reload lands on what they asked for.
    if (!ok) {
      reportProductsLoadFailure();
      return;
    }
    // renderCategoryNav() used to be called synchronously by the click handler,
    // immediately — well before this fetch resolves. That meant the breadcrumb/
    // chip row reflowed at one moment and the grid reflowed at another, separated
    // by a real network round-trip: two disjointed layout shifts instead of one,
    // which read as the page "resetting" mid-transition. Calling it here instead
    // means both changes commit in the same synchronous block, one single reflow.
    // Gated behind pendingCategoryNav (only true when activeTag actually
    // changed) — sort/search-only refreshes never touched the category, so
    // rebuilding the chip/breadcrumb DOM for them would just be needless churn
    // (and would drop the hover-flyout's currentChip reference for nothing).
    if (pendingCategoryNav) {
      renderCategoryNav();
      pendingCategoryNav = false;
    }
    productGrid.innerHTML = '';
    loadedCount = 0;
    appendProductCards(page, true);
    updateResultsState(hasMore);
    // Every refresh replaces the grid with a different result set, so whatever
    // the buyer was scrolled to no longer exists — leaving them mid-page means
    // landing in the middle of results they've never seen, with the first ones
    // off-screen above. Applies to category, sort and search alike (this is the
    // single funnel for all three); scrollToResults only ever scrolls UP, so a
    // filter used from the top of the page doesn't yank anyone downward.
    scrollToResults();

  }

  loadMoreBtn?.addEventListener('click', async (event) => {
    // It is an `<a href="?page=N">` so a crawler has a path past product 24; for a person with
    // JS it must append in place instead of navigating. Cancelling in the BUBBLE phase is what
    // keeps nav-progress.ts quiet too — it reads `defaultPrevented` on document, precisely so a
    // link that never becomes a navigation does not raise the "next page is coming" bar.
    // A modified click (new tab, download, middle button) is left alone deliberately: opening
    // page 2 in a new tab is a reasonable thing to want from something that IS a link.
    if (event.defaultPrevented || (event as MouseEvent).button !== 0) return;
    const e = event as MouseEvent;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    event.preventDefault();
    // `aria-disabled`, not `disabled`: an anchor has no disabled state, and the guard has to be
    // real rather than cosmetic — a second click while the fetch is in flight would append the
    // same slice twice.
    if (loadMoreBtn.getAttribute('aria-disabled') === 'true') return;
    const offset = Number(loadMoreBtn.dataset.offset ?? loadedCount);
    loadMoreBtn.setAttribute('aria-disabled', 'true');
    const originalLabel = loadMoreLabel?.textContent ?? '';
    if (loadMoreLabel) {
      loadMoreLabel.innerHTML = `<span style="display:inline-flex;align-items:center;gap:0.5em">${escHtml(getPMI18n().loadingMore ?? '')}<span class="dot-pulse" role="status"><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span><span class="dot-pulse__dot"></span></span></span>`;
    }
    const { ok, products: page, hasMore } = await fetchProductsPage(offset);
    // On failure, leave `hasMore` exactly as it was: passing the failed `false` through to
    // updateResultsState() removes this very button, so the shopper is told they have reached the
    // end of the catalogue by a request that never arrived — and there is then nothing left to
    // press. The button comes back live below, so the fix is to press it again.
    if (ok) {
      appendProductCards(page, true);
      updateResultsState(hasMore);
    } else {
      reportProductsLoadFailure();
    }
    loadMoreBtn.removeAttribute('aria-disabled');
    if (loadMoreLabel) loadMoreLabel.textContent = originalLabel;
  });

  function syncUrl() {
    const params = new URLSearchParams();
    const q = effectiveQuery();
    if (q) params.set('q', q);
    // The SLUG, not the `data-category-id` this code holds internally. Both resolve
    // (store-categories.ts#findCategoryByParam), but this is the URL a shopper ends up bookmarking
    // or pasting, and it has to be the same one the chip links to, the sitemap lists and the
    // canonical declares — one view with two spellings is how a canonical ends up pointing at a URL
    // nobody links to. Falls back to the id if the tree doesn't know the tag, which is the old
    // behaviour and still resolves.
    if (activeTag) {
      const name = flatCategories.find((c) => c.id === activeTag)?.name;
      // `|| activeTag` twice over: the tree may not know the tag, and a name of only symbols
      // slugs to "" — either way the id is the value that still resolves.
      params.set('category', (name && toSlug(name)) || activeTag);
    }
    if (currentSort !== 'default') params.set('sort', currentSort);
    const qs = params.toString();
    lastQueryString = qs ? `?${qs}` : '';
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  function openSort() {
    sortMenu?.removeAttribute('hidden');
    sortTrigger?.setAttribute('aria-expanded', 'true');
    if (sortChevron) (sortChevron as unknown as HTMLElement).style.transform = 'rotate(180deg)';
  }

  function closeSort() {
    sortMenu?.setAttribute('hidden', '');
    sortTrigger?.setAttribute('aria-expanded', 'false');
    if (sortChevron) (sortChevron as unknown as HTMLElement).style.transform = '';
  }

  const sortOptions = sortMenu
    ? Array.from(sortMenu.querySelectorAll<HTMLElement>('[role="option"]'))
    : [];

  function selectSortOption(opt: HTMLElement) {
    sortOptions.forEach(o => o.setAttribute('aria-selected', 'false'));
    opt.setAttribute('aria-selected', 'true');
    currentSort = opt.dataset.value ?? 'default';
    const label = opt.textContent?.trim() ?? '';
    if (sortLabel) sortLabel.textContent = label;
    if (sortTrigger) sortTrigger.setAttribute('aria-label', label);
    closeSort();
    sortTrigger?.focus();
    refreshFromServer();
  }

  sortTrigger?.addEventListener('click', () => {
    sortMenu?.hidden ? openSort() : closeSort();
  });

  sortTrigger?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (sortMenu?.hidden) openSort();
      const idx = e.key === 'ArrowDown' ? 0 : sortOptions.length - 1;
      sortOptions[idx]?.focus();
    }
  });

  sortOptions.forEach((opt, i) => {
    opt.setAttribute('tabindex', '-1');
    opt.addEventListener('click', () => selectSortOption(opt));
    opt.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSortOption(opt); }
      if (e.key === 'ArrowDown') { e.preventDefault(); sortOptions[(i + 1) % sortOptions.length]?.focus(); }
      if (e.key === 'ArrowUp')   { e.preventDefault(); sortOptions[(i - 1 + sortOptions.length) % sortOptions.length]?.focus(); }
      if (e.key === 'Home')      { e.preventDefault(); sortOptions[0]?.focus(); }
      if (e.key === 'End')       { e.preventDefault(); sortOptions[sortOptions.length - 1]?.focus(); }
      if (e.key === 'Tab')       { closeSort(); }
    });
  });

  document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('sort-dropdown');
    if (dropdown && !dropdown.contains(e.target as Node)) closeSort();
  });

  let searchDebounceTimer: ReturnType<typeof setTimeout> | undefined;
  searchInput?.addEventListener('input', () => {
    updateLocalSearchClearBtn();
    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(refreshFromServer, 350);
  });

  // The general header search bar (top of page) always searches the whole store,
  // ignoring whatever category filter is currently selected — it fires this event
  // instead of writing straight into #product-search (which stays untouched, so
  // whatever local search was active before/after this episode survives intact).
  // An empty q means the header search was cleared (native "x" or backspaced to
  // empty) — restore whatever filter was active right before the override began.
  // After a whole-store header search the grid is wholesale-replaced, but the
  // scroll stayed wherever the buyer was — mid-page or at the bottom — so the
  // fresh results sat off-screen above them. Bring the top of the results
  // region (the .store-controls bar + first row) up to just under the fixed
  // header. Guarded to only ever scroll UP (scrollY past the anchor) so a
  // search made while already at the top doesn't yank the buyer downward.
  function scrollToResults(): void {
    // The GREY block's own top edge (.store-below), flush under the header — not the .section
    // inside it, and with no slack.
    //
    // It used to aim at the section and subtract another 8px "for breathing room", which put the
    // last sliver of the WHITE details layer on screen above the grey. A curtain that stops eight
    // pixels short does not read as breathing room; it reads as not having landed (owner,
    // 2026-08-03). The grey band carrying the categories and the grid is the thing being scrolled
    // to, so its edge is the thing that should meet the header.
    const grey = controlsBar?.closest<HTMLElement>('.store-below')
      ?? controlsBar?.closest<HTMLElement>('.section');
    if (!grey) return;
    const headerH = document.querySelector<HTMLElement>('.site-header')?.getBoundingClientRect().height ?? 0;
    const target = Math.max(0, grey.getBoundingClientRect().top + window.scrollY - headerH);
    if (window.scrollY > target + 1) animateScrollTo(target);
  }

  window.addEventListener('store-search:global', ((e: CustomEvent<{ q: string }>) => {
    clearTimeout(searchDebounceTimer);
    const q = e.detail?.q ?? '';
    if (q) {
      if (preGlobalSearchTag === null) preGlobalSearchTag = activeTag;
      activeTag = '';
      globalQuery = q;
    } else {
      activeTag = preGlobalSearchTag ?? '';
      preGlobalSearchTag = null;
      globalQuery = '';
    }
    pendingCategoryNav = true;
    updateDrawerToggleLabel();
    refreshFromServer(); // scrolls the results into view itself — see there
  }) as EventListener);

  // ── Init from URL params (q / sort / category) ────────────────
  {
    const urlParams   = new URLSearchParams(window.location.search);
    const initQ       = urlParams.get('q') ?? '';
    const initSortVal = urlParams.get('sort') ?? '';
    const initCat     = urlParams.get('category') ?? '';

    if (initSortVal) {
      const matchingOpt = sortOptions.find(o => o.dataset.value === initSortVal);
      if (matchingOpt) {
        sortOptions.forEach(o => o.setAttribute('aria-selected', 'false'));
        matchingOpt.setAttribute('aria-selected', 'true');
        currentSort = initSortVal;
        if (sortLabel) sortLabel.textContent = matchingOpt.textContent?.trim() ?? '';
      }
    }

    // The nav (breadcrumb + chip row) was already server-rendered matching
    // initCat exactly (see the Astro frontmatter above) — just sync the JS
    // state variable to match, no DOM rebuild needed for the initial paint.
    if (initCat && flatCategories.some((c) => c.id === initCat)) activeTag = initCat;

    if (initQ) {
      if (activeTag) {
        // A local (in-filter) search deep link — belongs only to the local search box.
        if (searchInput) searchInput.value = initQ;
        updateLocalSearchClearBtn();
      } else {
        // A global search deep link (no category in the URL) — belongs only to the
        // header search bar, mirroring the live store-search:global behavior above.
        globalQuery = initQ;
        const hInput = document.getElementById('header-search-input') as HTMLInputElement | null;
        if (hInput) hInput.value = initQ;
      }
    }

    // The grid's initial page was already server-rendered matching these exact
    // params (see the Astro frontmatter above) — no refetch needed here, just
    // catching load-more back up if the user had loaded further pages before
    // navigating away, then restoring scroll position once real content is there.
    // Fetched in parallel (not one-await-at-a-time) and capped — a session that
    // loaded hundreds of products before leaving shouldn't turn "back" into a
    // slow chain of round-trips; past the cap we just land wherever it ends.
    (async () => {
      const savedState = storeSlug ? peekStoreScrollState(storeSlug) : null;
      if (savedState && loadedCount < savedState.loadedCount) {
        const MAX_CATCHUP_PRODUCTS = 240;
        const target = Math.min(savedState.loadedCount, loadedCount + MAX_CATCHUP_PRODUCTS);
        const offsets: number[] = [];
        for (let o = loadedCount; o < target; o += PRODUCTS_PAGE_SIZE) offsets.push(o);
        const pages = await Promise.all(offsets.map((o) => fetchProductsPage(o)));
        for (const { products: page, hasMore } of pages) {
          if (!page.length) break;
          appendProductCards(page, false);
          updateResultsState(hasMore);
          if (!hasMore) break;
        }
      }
      if (storeSlug) restoreStoreScroll(storeSlug);
      // Lifts the curtain raised by the inline anti-flash script at the top of this
      // page. Same element it hid — the content, never the root: the header is fixed
      // chrome that must stay painted right through the restore.
      const mainEl = document.getElementById('main-content');
      if (mainEl) mainEl.style.visibility = '';
    })();
  }

  // ── Skeleton ──────────────────────────────────────────────────
  // The shared helper, not the copy that used to live here. That copy did the load/error pair
  // correctly but started every card's shimmer at SSR time, so a card below the fold — whose
  // `loading="lazy"` image the browser has not asked for and will not until you scroll near it —
  // animated a grey band the whole time. Under a background-removed product photo that band shows
  // through the subject, which is what the owner kept seeing as a skeleton sitting ON the product.
  // The helper only lets the shimmer start once the tile is close enough that the fetch is really
  // beginning (lib/img-skeleton.ts).
  //
  // Its `querySelector('img')` picks the first slide, which is the one carrying a real `src`;
  // slides past it hold a blank pixel behind `data-src` and would otherwise report themselves
  // loaded the moment they parse, clearing the shimmer while the real image was still on the wire.
  // Safe to re-run after "load more" appends cards — it only touches wraps still marked loading.
  const initImageSkeleton = (): void => initImageSkeletons('.product-card__img-wrap');
  initImageSkeleton();

  // The banner shimmer clears the same way — via the shared helper, since the
  // banner is a single image with no deferred-slide complication.
  initImageSkeletons('.store-banner__image-wrap');

  function getPMI18n(): Record<string, string> {
    try { return JSON.parse(document.getElementById('pm-i18n')?.textContent ?? '{}') as Record<string, string>; }
    catch { return {}; }
  }


  // Give this card's deferred slides (everything past the first image) their src.
  // Wired to every way a second slide can be reached — hovering the image, any
  // pointer/touch on it, a wheel/trackpad sideways scroll of the strip, the dots,
  // keyboard focus — because a slide that arrives un-hydrated shows a blank
  // pixel. The strip's own `scroll` is the catch-all backstop; the rest just get
  // the fetch started earlier, before the slide has finished travelling in.
  function hydrateCardSlides(card: HTMLElement, limit = Infinity): void {
    const deferred = [...card.querySelectorAll<HTMLImageElement>('.product-card__img[data-src]')];
    deferred.slice(0, limit).forEach((img) => {
      img.src = img.dataset.src ?? '';
      if (img.dataset.srcset) { img.srcset = img.dataset.srcset; delete img.dataset.srcset; }
      delete img.dataset.src;
    });
  }

  /**
   * Start slide 2 while the card is merely ON SCREEN, before anyone touches it.
   *
   * Measured 2026-08-03 on this page, which is what the owner was seeing: from the
   * hover to the second photo being painted is ~790ms, and the `src` swap accounts
   * for 0ms of it — the wiring below fires instantly, the wait is the image coming
   * down from Cloudinary. So no amount of extra event wiring helps; the fetch has to
   * begin before the gesture, or the gesture waits for it.
   *
   * ONE slide, not all of them. On this store page 15 cards carry 31 deferred images:
   * hydrating everything on sight would nearly double the page's image traffic for
   * photos most shoppers never scroll to, which is what the deferral exists to
   * prevent (`feedback_image_optimization`). One neighbour is the slide a swipe or a
   * hover actually lands on, and the rest still wait for the interaction.
   *
   * `rootMargin` starts it a screen early so a card is warm by the time it is
   * readable. Unobserved after firing — this is a one-shot per card.
   */
  const slidePrefetch = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          obs.unobserve(entry.target);
          hydrateCardSlides(entry.target as HTMLElement, 1);
        }
      }, { rootMargin: '600px 0px' })
    : null;

  // ── Carousel dots ─────────────────────────────────────────────
  function initCarouselDots(card: HTMLElement): void {
    const slides = card.querySelector<HTMLElement>('.product-card__slides');
    const dotsEl = card.querySelector<HTMLElement>('.product-card__dots');
    if (!slides || !dotsEl) return;

    const dots = Array.from(dotsEl.querySelectorAll<HTMLElement>('.product-card__dot'));
    if (dots.length < 2) return;

    // Slide 2 is already on its way from the observer above by the time any of these
    // fire; these bring in the REST of the strip.
    slidePrefetch?.observe(card);

    const hydrate = () => hydrateCardSlides(card);
    const wrap = card.querySelector<HTMLElement>('.product-card__img-wrap') ?? slides;
    wrap.addEventListener('pointerenter', hydrate, { once: true });
    wrap.addEventListener('focusin', hydrate, { once: true });
    slides.addEventListener('pointerdown', hydrate, { once: true, passive: true });
    slides.addEventListener('touchstart', hydrate, { once: true, passive: true });
    slides.addEventListener('scroll', hydrate, { once: true, passive: true });
    dotsEl.addEventListener('pointerenter', hydrate, { once: true });

    dotsEl.addEventListener('click', (e) => e.stopPropagation());

    // Cache slide width — read once, never in scroll handler
    let slideW = slides.offsetWidth || 1;
    new ResizeObserver(() => { slideW = slides.offsetWidth || 1; }).observe(slides);

    // Cache direction — doesn't change at runtime
    const isRtl = getComputedStyle(slides).direction === 'rtl';

    initLiquidDots(slides, dots);

    dots.forEach((dot, i) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        slides.scrollTo({ left: (isRtl ? -1 : 1) * i * slideW, behavior: 'smooth' });
      });
    });

    // Touch — one slide at a time, no momentum skip
    let tStartX = 0, tStartScroll = 0;

    slides.addEventListener('touchstart', (e) => {
      tStartX = e.touches[0].clientX;
      tStartScroll = slides.scrollLeft;
      slides.style.scrollSnapType = 'none';
    }, { passive: true });

    slides.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - tStartX;
      const cur = Math.round(Math.abs(tStartScroll) / slideW);
      let tgt = cur;
      if (dx < -(slideW * 0.08)) tgt = Math.min(cur + 1, dots.length - 1);
      if (dx >  (slideW * 0.08)) tgt = Math.max(cur - 1, 0);
      const left = (isRtl ? -1 : 1) * tgt * slideW;
      slides.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        slides.style.overflow = '';
        slides.scrollLeft = left;
        slides.style.scrollSnapType = '';
      });
    }, { passive: true });
  }

  document.querySelectorAll<HTMLElement>('.product-card').forEach(initCarouselDots);

  // Open the shared product modal (StoreProductModal, in BaseLayout) for a
  // card — it fetches its own data by slug, so we only pass the slug + store.
  // `flagMissing` opens it with the "pick a variant" nudge already firing
  // (used when add-to-cart was clicked on a variant card that has no picker).
  function openCardModal(card: HTMLElement, flagMissing = false): void {
    const slug = card.dataset.slug ?? '';
    if (slug) window.dispatchEvent(new CustomEvent('store-product-modal:open', { detail: { storeSlug, productSlug: slug, storeName, flagMissing } }));
  }

  // Anywhere else on the card → product modal too. Buttons/links each have
  // their own handler (qty stepper, wishlist heart, add-to-cart, the name
  // link, the image) so this only needs to skip those — everything else
  // (padding, gaps between elements, the price line) should still open it,
  // including out-of-stock cards that have no add-to-cart button at all.
  function initCardClickToModal(card: HTMLElement): void {
    card.addEventListener('click', (e) => {
      // Not e.target.closest(...) — a button's own click handler can mutate
      // its innerHTML (e.g. the add-to-cart icon swapping to a checkmark)
      // before this bubbles up here, detaching e.target from the tree and
      // breaking closest()'s walk to its ancestor button. composedPath() is
      // captured at dispatch time, so it's immune to that.
      const path = e.composedPath() as HTMLElement[];
      if (path.some((el) => el.tagName === 'BUTTON' || el.tagName === 'A' || el.getAttribute?.('role') === 'button')) return;
      openCardModal(card);
    });
  }

  document.querySelectorAll<HTMLElement>('.product-card').forEach(initCardClickToModal);

  // Image click → product modal (replaces lightbox)
  function initImageClickToModal(wrap: HTMLElement): void {
    const slides = wrap.querySelector<HTMLElement>('.product-card__slides');
    let scrollAtPress = 0;

    if (slides) {
      slides.addEventListener('pointerdown', () => {
        scrollAtPress = Math.abs(slides.scrollLeft);
      }, { passive: true });
    }

    wrap.addEventListener('click', () => {
      if (slides && Math.abs(Math.abs(slides.scrollLeft) - scrollAtPress) > 3) return;
      const card = wrap.closest<HTMLElement>('.product-card');
      if (card) openCardModal(card);
    });
    wrap.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        (e.currentTarget as HTMLElement).click();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.product-card__img-wrap--clickable').forEach(initImageClickToModal);

  // Name link click → product modal (prevents navigation)
  function initNameLinkToModal(link: HTMLAnchorElement): void {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const card = link.closest<HTMLElement>('.product-card');
      if (card) openCardModal(card);
    });
  }

  document.querySelectorAll<HTMLAnchorElement>('.product-modal-trigger').forEach(initNameLinkToModal);

  // ── Global keyboard handlers ──────────────────────────────────
  // The product modal + its lightbox own their own keyboard handling now
  // (inside StoreProductModal); here we only close the sort menu on Escape.
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && sortMenu && !sortMenu.hidden) {
      closeSort();
      sortTrigger?.focus();
    }
  });

  // ── Login hint tooltip (for non-logged-in contact/ask buttons) ──
  function showLoginHint(btn: HTMLElement) {
    const existing = btn.parentElement?.querySelector('.login-hint-popup');
    if (existing) { existing.remove(); return; }
    const loginUrl = btn.dataset.loginUrl ?? '/seller/login';
    const hint = document.createElement('div');
    hint.className = 'login-hint-popup';
    hint.setAttribute('role', 'status');
    // t.messages.loginToMessage / loginToMessageLink, off the button that opened
    // this hint — both buttons that call it are server-rendered and carry them.
    const lead = btn.dataset.strLoginHint ?? 'כדי לשלוח הודעה יש';
    const link = btn.dataset.strLoginHintLink ?? 'להתחבר';
    hint.innerHTML = `<span>${escHtml(lead)} <a href="${escHtml(loginUrl)}" style="color:var(--color-accent);font-weight:600;text-decoration:underline">${escHtml(link)}</a></span>`;
    hint.style.cssText = 'position:absolute;top:calc(100% + 0.4rem);inset-inline-start:0;z-index:50;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius);padding:0.45rem 0.8rem;white-space:nowrap;box-shadow:var(--shadow-card);font-size:0.8rem;color:var(--color-text)';
    hint.animate([{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease', fill: 'forwards' });
    const container = btn.parentElement ?? btn;
    container.appendChild(hint);
    const dismiss = () => { hint.remove(); document.removeEventListener('click', outsideClick); };
    const outsideClick = (e: MouseEvent) => { if (!hint.contains(e.target as Node) && e.target !== btn) dismiss(); };
    setTimeout(() => document.addEventListener('click', outsideClick), 10);
    setTimeout(dismiss, 5000);
  }

  // ── Contact store button ──────────────────────────────────────
  const contactBtn = document.getElementById('contact-store-btn') as HTMLButtonElement | null;
  contactBtn?.addEventListener('click', () => {
    if (contactBtn.dataset.isLoggedIn !== 'true') {
      showLoginHint(contactBtn);
      return;
    }
    window.dispatchEvent(new CustomEvent('message:compose', {
      detail: {
        storeId: contactBtn.dataset.storeId ?? '',
        sellerId: contactBtn.dataset.sellerId ?? '',
        storeName: contactBtn.dataset.storeName ?? '',
      },
    }));
  });

</script>
