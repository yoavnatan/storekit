---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, getT } from '../i18n/index.js';
import { getVisibleStores } from '../lib/stores.js';
import { getSellerSession, getSellerById } from '../lib/seller-auth.js';
import { SHIPPING_RATES, availableDeliveryMethods, type DeliveryMethod } from '../lib/shipping.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const c = t.checkout;

const sessionUserId = getSellerSession(Astro.cookies);
const isLoggedIn = !!sessionUserId;
const sessionSeller = sessionUserId ? getSellerById(sessionUserId) : null;
const prefillEmail = sessionSeller?.email ?? '';

// Admin-blocked stores (see admin-moderation.ts) are left out — a buyer with
// a stale cart item from a store blocked mid-session would otherwise see a
// real computed shipping total for it here and only find out it's rejected
// after submitting. The client's own calcShipping() already falls back to
// {flatRate:0, freeAbove:null} for a missing slug, so this doesn't break
// the total display, it just stops charging shipping for an item checkout
// will reject anyway (found in review, 2026-07-14).
// Per-store delivery config for the client: which methods the buyer may pick (courier +
// pickup point on every store; self-pickup only when the seller enabled it AND the store
// has an address) and, for self-pickup, the address to collect from. Prices are the
// central SHIPPING_RATES sent once below — the seller never sets them.
const storeShipping: Record<string, { methods: DeliveryMethod[]; address: string | null }> = {};
for (const s of getVisibleStores()) {
  const offersSelfPickup = !!s.shipping?.selfPickup && !!s.address;
  storeShipping[s.slug] = {
    methods: availableDeliveryMethods(offersSelfPickup),
    address: offersSelfPickup ? (s.address ?? null) : null,
  };
}
---

<BaseLayout title={c.title} description={c.description} noindex={true} isLoggedIn={isLoggedIn} storeMode={true}>
  <script type="application/json" id="checkout-shipping-cfg" is:inline set:html={JSON.stringify({ stores: storeShipping, rates: SHIPPING_RATES }).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')}></script>
  <script type="application/json" id="checkout-i18n" is:inline set:html={JSON.stringify({
    freeShipping: c.freeShipping,
    shipping: c.shipping,
    storeTotal: c.storeTotal,
    total: c.total,
    item: c.item,
    items: c.items,
    changeShipping: c.changeShipping,
    changeShippingMethod: c.changeShippingMethod,
    deliveryMethod: c.deliveryMethod,
    methodPickup: c.methodPickup,
    methodCourier: c.methodCourier,
    methodPickupPoint: c.methodPickupPoint,
    pickupFrom: c.pickupFrom,
    removeItem: c.removeItem,
    removeTitle: c.removeTitle,
    removeMsg: c.removeMsg,
    removeOk: c.removeOk,
    viewProduct: c.viewProduct,
    requiredField: c.requiredField,
    invalidEmail: c.invalidEmail,
    orderError: c.orderError,
    selectItemAria: c.selectItemAria,
    selectStoreAria: c.selectStoreAria,
    selectAll: c.selectAll,
    selectAllAria: c.selectAllAria,
    selectAtLeastOne: c.selectAtLeastOne,
    noItemsSelected: c.noItemsSelected,
  })}></script>

  <main id="main-content" class="max-w-[640px] mx-auto px-4 pt-7 pb-16">

    <!-- Empty state -->
    <div id="checkout-empty" class="hidden text-center py-16">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="[color:var(--color-muted)] mx-auto block mb-4"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      <p class="text-[1.1rem] font-semibold [color:var(--color-text)] mb-2">{c.emptyCart}</p>
      <p class="[color:var(--color-muted)] mb-6">{c.emptyCartDesc}</p>
      <a href="/" class="btn btn--accent">{c.backToShopping}</a>
    </div>

    <div id="checkout-main">

      <!-- ── Cart section ── -->
      <section aria-labelledby="cart-heading">
        <h1 id="cart-heading" class="text-[clamp(1.3rem,3vw,1.6rem)] font-bold [color:var(--color-text)] mb-5">{c.yourCart}</h1>

        <!-- Skeleton -->
        <div id="cart-content" aria-live="polite">
          <div class="flex gap-4 items-start bg-[color:var(--color-surface)] rounded-[14px] p-4 mb-3 border [border-color:var(--color-border)] shadow-[var(--shadow-xs)]">
            <div class="skel-bar w-20 h-20 rounded-[10px] shrink-0"></div>
            <div class="flex-1 flex flex-col gap-2 pt-1">
              <div class="skel-bar h-[15px] w-[55%]"></div>
              <div class="skel-bar h-[13px] w-[35%]"></div>
              <div class="skel-bar h-[30px] w-24 rounded-[6px] mt-1"></div>
            </div>
            <div class="skel-bar w-14 h-[22px] rounded shrink-0 self-center"></div>
          </div>
          <div class="flex gap-4 items-start bg-[color:var(--color-surface)] rounded-[14px] p-4 mb-3 border [border-color:var(--color-border)] shadow-[var(--shadow-xs)] opacity-[.55]">
            <div class="skel-bar w-20 h-20 rounded-[10px] shrink-0"></div>
            <div class="flex-1 flex flex-col gap-2 pt-1">
              <div class="skel-bar h-[15px] w-[70%]"></div>
              <div class="skel-bar h-[13px] w-[40%]"></div>
            </div>
            <div class="skel-bar w-14 h-[22px] rounded shrink-0 self-center"></div>
          </div>
        </div>

        <!-- Grand total + CTA (revealed after render) -->
        <div id="co-footer" class="hidden">
          <div class="flex justify-between items-center pt-4 pb-[1.125rem] border-t-2 [border-color:var(--color-border)] mt-1">
            <span class="text-base font-medium [color:var(--color-text)]">{c.total} <span id="grand-total-count" class="text-[.82em] font-normal [color:var(--color-muted)]"></span></span>
            <strong class="text-[1.35rem] font-extrabold [color:var(--color-text)]" id="grand-total-amount"></strong>
          </div>
          <button id="to-payment-btn" class="btn btn--accent group w-full py-[.9rem] px-6 text-[1.0625rem] flex items-center justify-center gap-2 mb-2" type="button"
            aria-expanded="false" aria-controls="payment-section">
            <span>{c.toPayment}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              aria-hidden="true" class="transition-transform duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] rtl:-scale-x-100 group-aria-expanded:rotate-90"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p id="co-select-hint" class="hidden text-center text-[.8rem] [color:var(--color-muted)]" role="status">{c.selectAtLeastOne}</p>
        </div>
      </section>

      <!-- ── Payment accordion ── -->
      <section id="payment-section" class="overflow-hidden max-h-0 opacity-0 transition-[max-height_420ms_cubic-bezier(.4,0,.2,1),opacity_280ms_ease] data-[open]:max-h-[1300px] data-[open]:opacity-100" aria-hidden="true">
        <h2 class="font-bold [color:var(--color-text)] mb-5 text-xl mt-1">{c.paymentDetails}</h2>

        <form id="checkout-form" novalidate aria-label={c.buyerDetails}>
          <div class="bg-[color:var(--color-surface)] rounded-[14px] p-5 border-[1.5px] [border-color:var(--color-border)] shadow-[var(--shadow-card)] mb-3.5">
            <h3 class="text-[.9375rem] font-semibold [color:var(--color-text)] mb-4">{c.buyerDetails}</h3>
            <div class="grid gap-3.5">
              <div>
                <label for="buyerName" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.fullName} *</label>
                <input type="text" id="buyerName" name="buyerName" required autocomplete="name" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-lg bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="buyerName" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="buyerEmail" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.email} *</label>
                <input type="email" id="buyerEmail" name="buyerEmail" required autocomplete="email" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-lg bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" value={prefillEmail} />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="buyerEmail" role="alert">{c.invalidEmail}</p>
              </div>
              <div>
                <label for="buyerPhone" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.phone} *</label>
                <input type="tel" id="buyerPhone" name="buyerPhone" required autocomplete="tel" inputmode="tel" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-lg bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="buyerPhone" role="alert">{c.requiredField}</p>
              </div>
            </div>
          </div>

          <div class="bg-[color:var(--color-surface)] rounded-[14px] p-5 border-[1.5px] [border-color:var(--color-border)] shadow-[var(--shadow-card)] mb-5">
            <h3 class="text-[.9375rem] font-semibold [color:var(--color-text)] mb-4">{c.shippingAddress}</h3>
            <div class="grid gap-3.5">
              <div>
                <label for="city" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.city} *</label>
                <input type="text" id="city" name="city" required autocomplete="address-level2" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-lg bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="city" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="street" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.street} *</label>
                <input type="text" id="street" name="street" required autocomplete="street-address" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-lg bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="street" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="zip" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.zip}</label>
                <input type="text" id="zip" name="zip" autocomplete="postal-code" inputmode="numeric" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-lg bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
              </div>
            </div>
          </div>

          <p id="form-global-error" class="hidden text-sm [color:var(--color-danger)] mb-4" role="alert"></p>

          <button type="submit" id="submit-btn" class="btn btn--accent w-full py-[.9rem] px-6 text-[1.0625rem] flex items-center justify-center gap-2 mb-2">
            <span id="submit-label">{c.placeOrder}</span>
            <span id="submit-loading" class="hidden" aria-live="polite">{c.processing}</span>
          </button>
          <p id="co-submit-hint" class="hidden text-center text-[.8rem] [color:var(--color-muted)]" role="status">{c.noItemsSelected}</p>
        </form>
      </section>

    </div>
  </main>

  <!-- PQV and lightbox dialogs are rendered globally via ProductQuickView in BaseLayout -->

  <script>
    import { getActiveStoreCarts, setQty, removeItem } from '../lib/cart.js';
    import { formatPrice } from '../config/store.config.js';
    import { spawnRipple } from '../lib/ripple.js';
    import { initSelectDropdown, COMPACT_TRIGGER_CLASS } from '../scripts/dashboard/select-dropdown.js';

    // Price shown inside each dropdown option (self-pickup is free). NOT shown on the closed
    // trigger — the trigger mirrors just the method name, and the price already sits outside.
    const optionMeta = (value: string): string => {
      const p = value === 'pickup' ? 0 : (platformRates[value] ?? 0);
      return p === 0 ? (i18n['freeShipping'] ?? 'חינם') : formatPrice(p);
    };

    const storeFilter = new URLSearchParams(window.location.search).get('store') ?? '';
    function getFilteredCarts() {
      const all = getActiveStoreCarts();
      return storeFilter ? all.filter(c => c.storeSlug === storeFilter) : all;
    }

    type StoreDeliveryCfg = { methods: string[]; address: string | null };
    const shippingCfg: { stores?: Record<string, StoreDeliveryCfg>; rates?: Record<string, number> } =
      JSON.parse((document.getElementById('checkout-shipping-cfg') as HTMLElement | null)?.textContent ?? '{}');
    const shippingStores: Record<string, StoreDeliveryCfg> = shippingCfg.stores ?? {};
    const platformRates: Record<string, number> = shippingCfg.rates ?? {};
    const i18n: Record<string, string> =
      JSON.parse((document.getElementById('checkout-i18n') as HTMLElement | null)?.textContent ?? '{}');

    const esc = (s: unknown) =>
      String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

    // Buyer's chosen delivery method per store. Defaults to courier — a PAID method — so a
    // store never silently defaults to free; persists across cart re-renders. The server
    // re-validates and re-prices whatever we send, so this is display/intent only.
    const chosenMethod: Record<string, string> = {};
    function methodFor(slug: string): string {
      if (chosenMethod[slug]) return chosenMethod[slug]!;
      const methods = shippingStores[slug]?.methods ?? ['courier'];
      chosenMethod[slug] = methods.includes('courier') ? 'courier' : (methods[0] ?? 'courier');
      return chosenMethod[slug]!;
    }
    function methodLabel(method: string): string {
      if (method === 'pickup') return i18n['methodPickup'] ?? 'איסוף עצמי';
      if (method === 'pickup_point') return i18n['methodPickupPoint'] ?? 'נקודת איסוף';
      return i18n['methodCourier'] ?? 'שליח עד הבית';
    }
    // Self-pickup is always free; courier/pickup-point use the central platform rate.
    function calcShipping(slug: string): number {
      const method = methodFor(slug);
      return method === 'pickup' ? 0 : (platformRates[method] ?? 0);
    }

    // ── Selection (which items the buyer is actually paying for) ──
    // Default: everything selected. Selection is per-page-load (not persisted) —
    // resets to "all checked" every time checkout is opened.
    const selKey = (storeSlug: string, cartKey: string) => `${storeSlug}::${cartKey}`;
    let selected = new Set<string>();
    let selectionInitialized = false;

    function syncSelection(carts: ReturnType<typeof getFilteredCarts>): void {
      const currentKeys = new Set<string>();
      carts.forEach(cart => cart.items.forEach(item => currentKeys.add(selKey(cart.storeSlug, item.cartKey))));
      if (!selectionInitialized) {
        selected = new Set(currentKeys);
        selectionInitialized = true;
      } else {
        for (const k of Array.from(selected)) if (!currentKeys.has(k)) selected.delete(k);
      }
    }

    // Flattened custom checkbox: box + icons are direct siblings of the (peer)
    // input rather than nested inside the box, so peer-checked/peer-indeterminate
    // can target them directly (Tailwind's peer-* only matches true siblings).
    function checkboxHtml(cls: string, attrs: string, ariaLabel: string, withDash: boolean): string {
      const dash = withDash
        ? `<svg class="pointer-events-none absolute inset-0 m-auto w-3 h-3 [color:var(--color-surface)] opacity-0 scale-[.4] peer-indeterminate:opacity-100 peer-indeterminate:scale-100 transition-[opacity,transform] duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="8" x2="12" y2="8"/></svg>`
        : '';
      return `<label class="relative inline-flex shrink-0 cursor-pointer ${cls}">
        <input type="checkbox" class="peer absolute inset-0 w-5 h-5 m-0 opacity-0 cursor-pointer" ${attrs} aria-label="${esc(ariaLabel)}">
        <span class="pointer-events-none relative w-5 h-5 rounded-[5px] border-[1.5px] [border-color:var(--color-border)] bg-[color:var(--color-surface)] shrink-0 transition-[background_140ms,border-color_140ms,transform_120ms_cubic-bezier(0.34,1.56,0.64,1)] peer-checked:bg-[color:var(--color-accent)] peer-checked:border-[color:var(--color-accent)] peer-indeterminate:bg-[color:var(--color-accent)] peer-indeterminate:border-[color:var(--color-accent)] peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:[outline-color:var(--color-accent)] peer-active:scale-90" aria-hidden="true"></span>
        <svg class="pointer-events-none absolute inset-0 m-auto w-3 h-3 [color:var(--color-surface)] opacity-0 scale-[.4] peer-checked:opacity-100 peer-checked:scale-100 transition-[opacity,transform] duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3.5 8.5 6.5 11.5 12.5 4.5"/></svg>
        ${dash}
      </label>`;
    }

    function renderCart(): void {
      const carts = getFilteredCarts();
      const contentEl = document.getElementById('cart-content');
      const footerEl  = document.getElementById('co-footer');
      if (!contentEl) return;

      if (!carts.length) {
        document.getElementById('checkout-main')?.classList.add('hidden');
        document.getElementById('checkout-empty')?.classList.remove('hidden');
        return;
      }

      syncSelection(carts);

      let html = '';

      // Global "select all" — only worth showing with more than one store, since a
      // single store's own row checkbox already selects/deselects everything.
      if (carts.length > 1) {
        html += `<div class="flex items-center gap-2.5 mb-4 pb-3 border-b [border-color:var(--color-border)]">
          ${checkboxHtml('co-select-all-check', '', i18n['selectAllAria'] ?? '', true)}
          <span class="text-[.9rem] font-semibold [color:var(--color-text)]">${esc(i18n['selectAll'] ?? 'בחר הכל')}</span>
          <span class="co-select-all-count text-xs font-normal [color:var(--color-muted)]" dir="ltr"></span>
        </div>`;
      }

      carts.forEach((cart, idx) => {
        // Initial paint only — recalculated precisely (per current selection) by
        // updateSelectionUI() right after this HTML is inserted into the DOM.
        const shipping = calcShipping(cart.storeSlug);

        html += `<div class="co-store-block contents" data-store-slug="${esc(cart.storeSlug)}">`;

        // Store row: select-all checkbox + store label
        html += `<div class="flex items-center gap-2.5 ${idx === 0 ? 'mt-0' : 'mt-5'} mb-2.5">
          ${checkboxHtml('co-store-check', `data-store-slug="${esc(cart.storeSlug)}"`, `${i18n['selectStoreAria'] ?? ''} ${cart.storeName}`, true)}
          <a href="/${esc(cart.storeSlug)}" class="inline-block text-xs font-bold [color:var(--color-muted)] tracking-[.06em] uppercase no-underline transition-colors duration-[140ms] hover:underline">${esc(cart.storeName)}</a>
          <span class="co-store-count text-xs font-normal [color:var(--color-muted)]"></span>
        </div>`;

        // One card per item
        cart.items.forEach(item => {
          const isSelected = selected.has(selKey(cart.storeSlug, item.cartKey));
          const imgHtml = item.image
            ? `<img src="${esc(item.image)}" alt="${esc(item.name)}" class="w-20 h-20 object-cover block" width="80" height="80" loading="lazy" decoding="async" />`
            : `<div class="w-20 h-20 flex items-center justify-center [color:var(--color-muted)]" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                </svg>
               </div>`;
          const variantsHtml = item.selectedVariants && Object.keys(item.selectedVariants).length
            ? `<p class="text-[.775rem] [color:var(--color-muted)] mt-[.2rem]">${esc(Object.entries(item.selectedVariants).map(([k,v]) => `${k}: ${v}`).join(' · '))}</p>`
            : '';

          html += `<div class="co-card flex items-center gap-4 bg-[color:var(--color-surface)] rounded-[14px] p-4 mb-3 border [border-color:var(--color-border)] shadow-[var(--shadow-xs)] transition-[box-shadow,opacity] duration-150 hover:shadow-[var(--shadow-card-hover)] data-[unselected]:opacity-50" data-store-slug="${esc(cart.storeSlug)}" data-cart-key="${esc(item.cartKey)}" data-item-name="${esc(item.name)}" ${isSelected ? '' : 'data-unselected'}>
            ${checkboxHtml('co-item-check', `data-store-slug="${esc(cart.storeSlug)}" data-cart-key="${esc(item.cartKey)}" ${isSelected ? 'checked' : ''}`, `${i18n['selectItemAria'] ?? ''} ${item.name}`, false)}
            <button type="button" class="pqv-trigger shrink-0 block w-20 h-20 rounded-[10px] overflow-hidden bg-[color:var(--color-border)] transition-opacity duration-[140ms] border-0 p-0 cursor-pointer hover:opacity-[.85]"
              data-store-slug="${esc(cart.storeSlug)}" data-product-slug="${esc(item.slug)}" data-store-name="${esc(cart.storeName)}"
              aria-label="${esc(i18n['viewProduct'] ?? '')} ${esc(item.name)}">
              ${imgHtml}
            </button>
            <div class="flex-1 min-w-0">
              <button type="button" class="co-card__name pqv-trigger text-[.9375rem] font-semibold [color:var(--color-text)] no-underline block whitespace-nowrap overflow-hidden text-ellipsis transition-colors duration-[140ms] bg-transparent border-0 p-0 cursor-pointer [font-family:inherit] [text-align:inherit] w-full hover:[color:var(--color-muted)]"
                data-store-slug="${esc(cart.storeSlug)}" data-product-slug="${esc(item.slug)}" data-store-name="${esc(cart.storeName)}">${esc(item.name)}</button>
              ${variantsHtml}
              <div class="flex items-center gap-1.5 mt-2.5">
                <div class="cart-line__qty shrink-0" dir="ltr" role="group" aria-label="כמות">
                  <button class="co-qty__btn" data-action="dec" aria-label="הפחת כמות" type="button" ${item.qty <= 1 ? 'disabled' : ''}>−</button>
                  <span class="co-qty__num w-7" aria-live="polite">${item.qty}</span>
                  <button class="co-qty__btn" data-action="inc" aria-label="הגדל כמות" type="button" data-stock="${item.stock ?? ''}" ${item.stock != null && item.qty >= item.stock ? 'disabled' : ''}>+</button>
                </div>
                <button class="w-[26px] h-[26px] shrink-0 bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[5px] cursor-pointer [color:var(--color-muted)] flex items-center justify-center transition-[color,background,border-color] duration-[130ms] hover:[color:var(--color-danger)] hover:bg-[color-mix(in_srgb,var(--color-danger)_8%,transparent)] hover:[border-color:color-mix(in_srgb,var(--color-danger)_30%,var(--color-border))]" data-action="remove" aria-label="${esc(i18n['removeItem'] ?? 'הסר')}" type="button">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                </button>
              </div>
            </div>
            <div class="co-card__price-col shrink-0 text-end flex flex-col items-end gap-[.15rem]">
              <span class="co-card__total text-[1.0625rem] font-extrabold [color:var(--color-text)]">${formatPrice(item.price * item.qty)}</span>
              ${item.qty > 1 ? `<span class="co-card__unit text-[.72rem] [color:var(--color-muted)]">${formatPrice(item.price)} ליח׳</span>` : ''}
            </div>
          </div>`;
        });

        // Shipping card for this store — "שיטת משלוח:" + an app-styled dropdown (each option
        // shows its price; the closed trigger shows just the chosen method name) + the price
        // outside. Prices are platform-set; self-pickup is free and reveals the address below.
        const isFree = shipping === 0;
        const methods = shippingStores[cart.storeSlug]?.methods ?? ['courier'];
        const chosen  = methodFor(cart.storeSlug);
        const optionsHtml = methods
          .map(m => `<option value="${esc(m)}" ${m === chosen ? 'selected' : ''}>${esc(methodLabel(m))}</option>`)
          .join('');
        html += `<div class="co-shipping-card bg-[color:var(--color-surface)] rounded-[14px] py-3.5 px-4 mb-3 border [border-color:var(--color-border)] shadow-[var(--shadow-xs)]" data-store-slug="${esc(cart.storeSlug)}">
          <div class="flex items-center justify-between gap-2.5">
            <div class="flex items-center gap-2 min-w-0">
              <svg class="shrink-0 [color:var(--color-accent)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span class="text-[.9rem] font-medium [color:var(--color-text)] shrink-0">${esc(i18n['deliveryMethod'] ?? 'שיטת משלוח')}:</span>
              <select class="co-method-select" data-store-slug="${esc(cart.storeSlug)}" aria-label="${esc(i18n['deliveryMethod'] ?? 'שיטת משלוח')}">${optionsHtml}</select>
            </div>
            <span class="co-shipping-card__amount text-[.9375rem] font-bold shrink-0 ${isFree ? 'data-[free]:[color:var(--color-success)]' : ''} [color:var(--color-text)]" ${isFree ? 'data-free' : ''}>${isFree ? (i18n['freeShipping'] ?? 'חינם') : formatPrice(shipping)}</span>
          </div>
          <p class="co-pickup-address hidden text-xs [color:var(--color-muted)] mt-2 ps-[26px]" data-store-slug="${esc(cart.storeSlug)}"></p>
        </div>`;

        html += `</div>`; // close .co-store-block
      });

      contentEl.innerHTML = html;

      footerEl?.classList.remove('hidden');

      attachEvents();
      // Upgrade each delivery-method <select> into the shared app-styled dropdown.
      document.querySelectorAll<HTMLSelectElement>('.co-method-select').forEach(sel =>
        initSelectDropdown(sel, { triggerClassName: COMPACT_TRIGGER_CLASS, menuAutoWidth: true, optionMeta }));
      updateSelectionUI();
    }

    function patchQty(card: HTMLElement, storeSlug: string, cartKey: string): void {
      const carts   = getActiveStoreCarts();
      const item    = carts.find(c => c.storeSlug === storeSlug)?.items.find(i => i.cartKey === cartKey);
      if (!item) { renderCart(); return; }

      const qtyEl    = card.querySelector<HTMLElement>('.co-qty__num');
      const decBtn   = card.querySelector<HTMLButtonElement>('[data-action="dec"]');
      const incBtn   = card.querySelector<HTMLButtonElement>('[data-action="inc"]');
      const totalEl  = card.querySelector<HTMLElement>('.co-card__total');
      const priceCol = card.querySelector<HTMLElement>('.co-card__price-col');

      if (qtyEl)   qtyEl.textContent   = String(item.qty);
      if (decBtn)  decBtn.disabled      = item.qty <= 1;
      if (incBtn)  incBtn.disabled      = item.stock != null && item.qty >= item.stock;
      if (totalEl) totalEl.textContent  = formatPrice(item.price * item.qty);

      const unitEl = priceCol?.querySelector<HTMLElement>('.co-card__unit');
      if (item.qty > 1) {
        const txt = `${formatPrice(item.price)} ליח׳`;
        if (unitEl) { unitEl.textContent = txt; }
        else {
          const span = document.createElement('span');
          span.className = 'co-card__unit text-[.72rem] [color:var(--color-muted)]';
          span.textContent = txt;
          priceCol?.appendChild(span);
        }
      } else {
        unitEl?.remove();
      }

      updateSelectionUI();
    }

    // Recomputes everything that depends on which items are checked: per-store
    // shipping card (hidden entirely once a store has nothing selected), grand
    // total, each store's select-all checkbox state, and the pay button.
    function updateSelectionUI(): void {
      const carts = getFilteredCarts();
      const itemWord = (n: number) => n !== 1 ? (i18n['items'] ?? 'items') : (i18n['item'] ?? 'item');
      let grandTotal = 0;
      let anySelected = false;
      let totalItems = 0;
      let totalSelected = 0;

      carts.forEach(cart => {
        const block = document.querySelector<HTMLElement>(`.co-store-block[data-store-slug="${CSS.escape(cart.storeSlug)}"]`);
        let subtotal = 0;
        let selCount = 0;
        cart.items.forEach(item => {
          if (selected.has(selKey(cart.storeSlug, item.cartKey))) {
            subtotal += item.price * item.qty;
            selCount++;
          }
        });
        if (selCount > 0) anySelected = true;
        totalItems += cart.items.length;
        totalSelected += selCount;

        const shipping = selCount > 0 ? calcShipping(cart.storeSlug) : 0;
        grandTotal += subtotal + shipping;

        const shipCard = block?.querySelector<HTMLElement>('.co-shipping-card');
        if (shipCard) {
          shipCard.classList.toggle('hidden', selCount === 0);
          if (selCount > 0) {
            const isFree = shipping === 0;
            const amountEl = shipCard.querySelector<HTMLElement>('.co-shipping-card__amount');
            if (amountEl) {
              amountEl.textContent = isFree ? (i18n['freeShipping'] ?? 'חינם') : formatPrice(shipping);
              amountEl.toggleAttribute('data-free', isFree);
            }
            // Self-pickup → show where to collect from; any other method hides it.
            const addrEl = shipCard.querySelector<HTMLElement>('.co-pickup-address');
            if (addrEl) {
              const addr = shippingStores[cart.storeSlug]?.address;
              const showAddr = methodFor(cart.storeSlug) === 'pickup' && !!addr;
              addrEl.textContent = showAddr ? `${i18n['pickupFrom'] ?? 'איסוף מ'}: ${addr}` : '';
              addrEl.classList.toggle('hidden', !showAddr);
            }
          }
        }

        const storeCheckbox = block?.querySelector<HTMLInputElement>('.co-store-check input');
        if (storeCheckbox) {
          storeCheckbox.checked = selCount > 0 && selCount === cart.items.length;
          storeCheckbox.indeterminate = selCount > 0 && selCount < cart.items.length;
        }

        const storeCountEl = block?.querySelector<HTMLElement>('.co-store-count');
        if (storeCountEl) storeCountEl.textContent = `(${selCount} ${itemWord(selCount)})`;
      });

      const selectAllBox = document.querySelector<HTMLInputElement>('.co-select-all-check input');
      if (selectAllBox) {
        selectAllBox.checked = totalSelected > 0 && totalSelected === totalItems;
        selectAllBox.indeterminate = totalSelected > 0 && totalSelected < totalItems;
      }
      const selectAllCountEl = document.querySelector<HTMLElement>('.co-select-all-count');
      if (selectAllCountEl) selectAllCountEl.textContent = `(${totalSelected}/${totalItems})`;

      const totalEl = document.getElementById('grand-total-amount');
      if (totalEl) totalEl.textContent = formatPrice(grandTotal);
      const totalCountEl = document.getElementById('grand-total-count');
      if (totalCountEl) totalCountEl.textContent = `(${totalSelected} ${itemWord(totalSelected)})`;

      const toPaymentBtn = document.getElementById('to-payment-btn') as HTMLButtonElement | null;
      if (toPaymentBtn) toPaymentBtn.disabled = !anySelected;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = !anySelected;
      document.getElementById('co-select-hint')?.classList.toggle('hidden', anySelected);
      document.getElementById('co-submit-hint')?.classList.toggle('hidden', anySelected);
    }

    function attachEvents(): void {
      document.querySelectorAll<HTMLElement>('.co-card').forEach(card => {
        const storeSlug = card.dataset['storeSlug'] ?? '';
        const cartKey   = card.dataset['cartKey'] ?? '';
        const itemName  = card.dataset['itemName'] ?? '';
        const qtyEl     = card.querySelector<HTMLElement>('.co-qty__num');

        card.querySelector<HTMLButtonElement>('[data-action="inc"]')?.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const current = parseInt(qtyEl?.textContent ?? '1', 10);
          const stockLimit = btn.dataset['stock'] ? parseInt(btn.dataset['stock'], 10) : Infinity;
          if (current < stockLimit) {
            setQty(storeSlug, cartKey, current + 1);
            patchQty(card, storeSlug, cartKey);
          }
        });

        card.querySelector<HTMLButtonElement>('[data-action="dec"]')?.addEventListener('click', () => {
          const current = parseInt(qtyEl?.textContent ?? '1', 10);
          if (current <= 1) {
            confirmRemove(storeSlug, cartKey, itemName);
          } else {
            setQty(storeSlug, cartKey, current - 1);
            patchQty(card, storeSlug, cartKey);
          }
        });

        card.querySelector<HTMLButtonElement>('[data-action="remove"]')?.addEventListener('click', () => {
          confirmRemove(storeSlug, cartKey, itemName);
        });
      });
    }

    function confirmRemove(storeSlug: string, cartKey: string, name: string): void {
      window.dispatchEvent(new CustomEvent('confirm:open', {
        detail: {
          title: i18n['removeTitle'] ?? 'הסר מהעגלה?',
          message: `${i18n['removeMsg'] ?? 'הפריט יוסר מהעגלה שלך'}: "${name}"`,
          okLabel: i18n['removeOk'] ?? 'הסר',
          onConfirm: () => { removeItem(storeSlug, cartKey); renderCart(); },
        },
      }));
    }

    // Delegated (not re-attached per render) — item + per-store "select all" checkboxes
    document.getElementById('cart-content')?.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== 'checkbox') return;

      const storeSlug = input.dataset['storeSlug'] ?? '';

      if (input.closest('.co-select-all-check')) {
        const checked = input.checked;
        document.querySelectorAll<HTMLInputElement>('.co-item-check input').forEach(itemInput => {
          const ss = itemInput.dataset['storeSlug'] ?? '';
          const ck = itemInput.dataset['cartKey'] ?? '';
          if (checked) selected.add(selKey(ss, ck));
          else selected.delete(selKey(ss, ck));
          itemInput.checked = checked;
          itemInput.closest('.co-card')?.toggleAttribute('data-unselected', !checked);
        });
      } else if (input.closest('.co-store-check')) {
        const checked = input.checked;
        const block = input.closest<HTMLElement>('.co-store-block');
        block?.querySelectorAll<HTMLInputElement>('.co-item-check input').forEach(itemInput => {
          const cartKey = itemInput.dataset['cartKey'] ?? '';
          if (checked) selected.add(selKey(storeSlug, cartKey));
          else selected.delete(selKey(storeSlug, cartKey));
          itemInput.checked = checked;
          itemInput.closest('.co-card')?.toggleAttribute('data-unselected', !checked);
        });
      } else if (input.closest('.co-item-check')) {
        const cartKey = input.dataset['cartKey'] ?? '';
        const key = selKey(storeSlug, cartKey);
        if (input.checked) selected.add(key);
        else selected.delete(key);
        input.closest('.co-card')?.toggleAttribute('data-unselected', !input.checked);
      } else {
        return;
      }

      updateSelectionUI();
    });

    // Delivery-method dropdown change (the upgraded <select> re-fires a bubbling
    // `change` on the hidden native element) → re-price + refresh totals/address.
    document.getElementById('cart-content')?.addEventListener('change', (e) => {
      const sel = e.target as HTMLElement;
      if (!(sel instanceof HTMLSelectElement) || !sel.classList.contains('co-method-select')) return;
      chosenMethod[sel.dataset['storeSlug'] ?? ''] = sel.value;
      updateSelectionUI();
    });

    // ── Payment accordion ──────────────────────────────────
    const toPaymentBtn   = document.getElementById('to-payment-btn');
    const paymentSection = document.getElementById('payment-section');

    toPaymentBtn?.addEventListener('click', () => {
      const isOpen = paymentSection?.hasAttribute('data-open');
      if (isOpen) {
        paymentSection?.removeAttribute('data-open');
        paymentSection?.setAttribute('aria-hidden', 'true');
        toPaymentBtn.setAttribute('aria-expanded', 'false');
      } else {
        paymentSection?.setAttribute('data-open', '');
        paymentSection?.setAttribute('aria-hidden', 'false');
        toPaymentBtn.setAttribute('aria-expanded', 'true');
        setTimeout(() => paymentSection?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
      }
    });

    // ── Validation ─────────────────────────────────────────
    function setFieldErr(field: string, show: boolean): void {
      document.querySelector<HTMLElement>(`[data-err="${field}"]`)?.classList.toggle('hidden', !show);
      (document.getElementById(field) as HTMLInputElement | null)?.setAttribute('aria-invalid', show ? 'true' : 'false');
    }

    function validate(): boolean {
      const name   = (document.getElementById('buyerName')  as HTMLInputElement | null)?.value.trim() ?? '';
      const email  = (document.getElementById('buyerEmail') as HTMLInputElement | null)?.value.trim() ?? '';
      const phone  = (document.getElementById('buyerPhone') as HTMLInputElement | null)?.value.trim() ?? '';
      const city   = (document.getElementById('city')       as HTMLInputElement | null)?.value.trim() ?? '';
      const street = (document.getElementById('street')     as HTMLInputElement | null)?.value.trim() ?? '';
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      setFieldErr('buyerName',  !name);
      setFieldErr('buyerEmail', !email || !emailOk);
      setFieldErr('buyerPhone', !phone);
      setFieldErr('city',       !city);
      setFieldErr('street',     !street);
      return !!(name && email && emailOk && phone && city && street);
    }

    // ── Submit ─────────────────────────────────────────────
    document.getElementById('checkout-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;

      const carts = getFilteredCarts();
      const purchased: { storeSlug: string; item: ReturnType<typeof getFilteredCarts>[number]['items'][number] }[] = [];
      carts.forEach(cart => cart.items.forEach(item => {
        if (selected.has(selKey(cart.storeSlug, item.cartKey))) purchased.push({ storeSlug: cart.storeSlug, item });
      }));
      if (!purchased.length) return; // nothing selected — button should already be disabled

      const labelEl   = document.getElementById('submit-label');
      const loadingEl = document.getElementById('submit-loading');
      const errEl     = document.getElementById('form-global-error');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

      labelEl?.classList.add('hidden');
      loadingEl?.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = true;
      errEl?.classList.add('hidden');

      const items = purchased.map(({ storeSlug, item }) => ({
        storeSlug,
        productSlug: item.slug,
        qty: item.qty,
        ...(item.selectedVariants && Object.keys(item.selectedVariants).length ? { selectedVariants: item.selectedVariants } : {}),
      }));

      // Chosen delivery method per purchased store (server re-validates + re-prices).
      const deliveryMethods: Record<string, string> = {};
      for (const { storeSlug } of purchased) deliveryMethods[storeSlug] = methodFor(storeSlug);

      const body = {
        buyerName:    (document.getElementById('buyerName')  as HTMLInputElement).value.trim(),
        buyerEmail:   (document.getElementById('buyerEmail') as HTMLInputElement).value.trim(),
        buyerPhone:   (document.getElementById('buyerPhone') as HTMLInputElement).value.trim(),
        buyerAddress: {
          city:   (document.getElementById('city')   as HTMLInputElement).value.trim(),
          street: (document.getElementById('street') as HTMLInputElement).value.trim(),
          zip:    (document.getElementById('zip')    as HTMLInputElement).value.trim() || undefined,
        },
        items,
        deliveryMethods,
      };

      try {
        const res  = await fetch('/api/checkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const data = await res.json() as { orderIds?: string[]; checkoutRef?: string; error?: string };
        if (!res.ok || !data.orderIds?.length) throw new Error(data.error ?? 'Unknown error');
        const ref = data.checkoutRef ?? data.orderIds[0]!.slice(0, 8).toUpperCase();
        // Only the purchased items leave the cart — anything the buyer left unchecked stays.
        purchased.forEach(({ storeSlug, item }) => removeItem(storeSlug, item.cartKey));
        window.location.href = `/checkout/success?order=${encodeURIComponent(ref)}`;
      } catch {
        if (errEl) { errEl.textContent = i18n['orderError'] ?? 'שגיאה. נסה שוב.'; errEl.classList.remove('hidden'); }
        labelEl?.classList.remove('hidden');
        loadingEl?.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // Global ripple — covers all buttons in checkout (qty steppers excluded)
    document.addEventListener('pointerdown', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button, [role="button"]');
      if (btn && !btn.classList.contains('co-qty__btn') && !btn.classList.contains('pqv-trigger') && !btn.classList.contains('co-card__name')) {
        spawnRipple(btn, e.clientX, e.clientY);
      }
    });

    renderCart();

    // Auto-open payment accordion when arriving via ?pay=1 (from PQV modal)
    if (new URLSearchParams(window.location.search).get('pay') === '1') {
      const paymentSection = document.getElementById('payment-section');
      const toPaymentBtn   = document.getElementById('to-payment-btn') as HTMLButtonElement | null;
      if (paymentSection && !paymentSection.hasAttribute('data-open')) {
        paymentSection.setAttribute('data-open', '');
        paymentSection.setAttribute('aria-hidden', 'false');
        toPaymentBtn?.setAttribute('aria-expanded', 'true');
      }
      setTimeout(() => toPaymentBtn?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 350);
    }
  </script>
</BaseLayout>
