---
/**
 * Checkout — collects details and starts payment.
 * SSR only (prerender = false) because it will create a payment session.
 * noindex — checkout pages should not appear in search results.
 */
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { store } from '../config/store.config.js';
---

<BaseLayout title="Checkout" noindex={true}>
  <section class="section container checkout">
    <h1>Checkout</h1>

    <div class="checkout__grid">
      <form id="checkout-form" class="checkout__form">
        <label class="field"
          ><span>Full name</span>
          <input class="input" name="name" required /></label
        >
        <label class="field"
          ><span>Email</span>
          <input class="input" type="email" name="email" required /></label
        >
        <label class="field"
          ><span>Shipping address</span>
          <input class="input" name="address" required /></label
        >

        <button type="submit" class="btn" id="pay-btn"> Secure checkout </button>
        <p class="muted" style="font-size:.85rem;margin-top:.5rem">
          Payment provider: {store.checkout.provider}
        </p>
      </form>

      <aside class="checkout__summary card">
        <h2>Order summary</h2>
        <div id="summary-lines"></div>
        <hr />
        <div class="flex between"><span>Shipping</span><span id="ship">—</span></div>
        <div class="flex between total"><strong>Total</strong><strong id="total">—</strong></div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { getItems, getSubtotal } from '../lib/cart.js';
  import { store, formatPrice } from '../config/store.config.js';

  function render() {
    const items = getItems();
    const subtotal = getSubtotal();
    const ship = subtotal >= store.checkout.freeShippingOver ? 0 : store.checkout.shippingFlat;
    const linesEl = document.getElementById('summary-lines');
    const shipEl  = document.getElementById('ship');
    const totalEl = document.getElementById('total');
    if (linesEl) linesEl.innerHTML = items.length
      ? items.map((i) =>
          `<div class="flex between"><span>${i.name} × ${i.qty}</span><span>${formatPrice(i.price * i.qty)}</span></div>`
        ).join('')
      : '<p class="muted">Your cart is empty</p>';
    if (shipEl)  shipEl.textContent  = ship === 0 ? 'Free' : formatPrice(ship);
    if (totalEl) totalEl.textContent = formatPrice(subtotal + ship);
  }

  document.getElementById('checkout-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      customer: Object.fromEntries(new FormData(e.target as HTMLFormElement)),
      items: getItems(),
    };
    const res = await fetch('/api/checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (data.url) window.location.href = data.url;
    else alert(data.message || 'Payment not configured yet. See AI_INSTRUCTIONS.md → Payments.');
  });

  window.addEventListener('cart:change', render);
  render();
</script>

