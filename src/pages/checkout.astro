---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, getT } from '../i18n/index.js';
import { jsonForScript } from '../lib/json-script.js';
import { getVisibleStores } from '../lib/stores.js';
import { isDemoStore } from '../lib/demo-stores.js';
import { getSellerSession, getSellerById } from '../lib/seller-auth.js';
import { SHIPPING_RATES, availableDeliveryMethods, type DeliveryMethod } from '../lib/shipping.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const c = t.checkout;
const cart = t.cart;

const sessionUserId = getSellerSession(Astro.cookies);
const isLoggedIn = !!sessionUserId;
const sessionSeller = sessionUserId ? await getSellerById(sessionUserId) : null;
const prefillEmail = sessionSeller?.email ?? '';

// Admin-blocked stores (see admin-moderation.ts) are left out — a buyer with
// a stale cart item from a store blocked mid-session would otherwise see a
// real computed shipping total for it here and only find out it's rejected
// after submitting. The client's own calcShipping() already falls back to
// {flatRate:0, freeAbove:null} for a missing slug, so this doesn't break
// the total display, it just stops charging shipping for an item checkout
// will reject anyway (found in review, 2026-07-14).
// Per-store delivery config for the client: which methods the buyer may pick (courier +
// pickup point on every store; self-pickup only when the seller enabled it AND the store
// has an address) and, for self-pickup, the address to collect from. Prices are the
// central SHIPPING_RATES sent once below — the seller never sets them.
const storeShipping: Record<string, { methods: DeliveryMethod[]; address: string | null; demo?: boolean }> = {};
for (const s of await getVisibleStores()) {
  const offersSelfPickup = !!s.shipping?.selfPickup && !!s.address;
  storeShipping[s.slug] = {
    methods: availableDeliveryMethods(offersSelfPickup),
    address: offersSelfPickup ? (s.address ?? null) : null,
    // Showcase store (lib/demo-stores.ts). The real guard is /api/checkout's 403 —
    // this only lets the page say so BEFORE the buyer fills the whole form, instead
    // of walking them to the end and failing there.
    ...(isDemoStore(s) ? { demo: true } : {}),
  };
}
---

<BaseLayout title={c.title} description={c.description} noindex={true} isLoggedIn={isLoggedIn} storeMode={true}>
  <script type="application/json" id="checkout-shipping-cfg" is:inline set:html={jsonForScript({ stores: storeShipping, rates: SHIPPING_RATES })}></script>
  <script type="application/json" id="checkout-i18n" is:inline set:html={jsonForScript({
    freeShipping: c.freeShipping,
    shipping: c.shipping,
    storeTotal: c.storeTotal,
    total: c.total,
    item: c.item,
    items: c.items,
    youSaved: c.youSaved,
    changeShipping: c.changeShipping,
    changeShippingMethod: c.changeShippingMethod,
    deliveryMethod: c.deliveryMethod,
    methodPickup: c.methodPickup,
    methodCourier: c.methodCourier,
    methodPickupPoint: c.methodPickupPoint,
    pickupFrom: c.pickupFrom,
    removeItem: c.removeItem,
    // The unit-price suffix under a line whose qty is >1 ("₪49.90 ליח׳") — the
    // last string this file's cart renderer wrote in Hebrew by hand. The
    // stepper's own three labels are further down, added the same day.
    perUnit: cart.perUnit,
    removeTitle: c.removeTitle,
    removeMsg: c.removeMsg,
    removeOk: c.removeOk,
    viewProduct: c.viewProduct,
    requiredField: c.requiredField,
    invalidEmail: c.invalidEmail,
    orderError: c.orderError,
    ownStoreBlocked: c.ownStoreBlocked,
    pricesChanged: c.pricesChanged,
    // checkoutInProgress was mapped in the submit handler but never sent over, so the one
    // message that must not say "try again" fell back to the generic one that does.
    checkoutInProgress: c.checkoutInProgress,
    soldOutDuringCheckout: c.soldOutDuringCheckout,
    stockReducedDuringCheckout: c.stockReducedDuringCheckout,
    stockReducedDuringCheckoutOne: c.stockReducedDuringCheckoutOne,
    outOfStockNote: c.outOfStockNote,
    stockLeftNote: c.stockLeftNote,
    stockLeftNoteOne: c.stockLeftNoteOne,
    demoBlocked: t.demo.checkoutBlocked,
    demoBadge: t.demo.badge,
    demoBadgeTitle: t.demo.badgeTitle,
    demoExcluded: t.demo.cartExcluded,
    demoNotice: t.demo.cartNotice,
    demoOnly: t.demo.cartOnlyDemo,
    selectItemAria: c.selectItemAria,
    selectStoreAria: c.selectStoreAria,
    selectAll: c.selectAll,
    selectAllAria: c.selectAllAria,
    selectAtLeastOne: c.selectAtLeastOne,
    noItemsSelected: c.noItemsSelected,
    // Borrowed from the cart drawer's namespace on purpose: it is the SAME heading over the same
    // grouping, and a second string for it is how the two would end up worded differently.
    otherStores: t.cart.otherStores,
    // Same reason, and the same three labels the cart drawer puts on the identical −/+ control.
    // They were spelled out in Hebrew inside the renderer below, so an English visitor's screen
    // reader announced the quantity buttons in Hebrew on this page alone.
    quantity: t.cart.quantity,
    qtyDecrease: t.cart.qtyDecrease,
    qtyIncrease: t.cart.qtyIncrease,
    couponHave: c.couponHave,
    couponPlaceholder: c.couponPlaceholder,
    couponApply: c.couponApply,
    couponRemove: c.couponRemove,
    couponInvalid: c.couponInvalid,
    couponThrottled: c.couponThrottled,
    couponBelowMin: c.couponBelowMin,
    couponExpired: c.couponExpired,
  })}></script>

  {/* A <div>, not a second <main> carrying id=main-content — BaseLayout already wraps this slot in
      one, so this nested a second <main> carrying the SAME id, and the skip link then
      resolves to whichever one comes first rather than to this page content. */}
  <div class="max-w-[640px] mx-auto px-4 pt-7 pb-16">

    <!-- Empty state -->
    <div id="checkout-empty" class="hidden text-center py-16">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="[color:var(--color-muted)] mx-auto block mb-4"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      <p class="text-[1.1rem] font-semibold [color:var(--color-text)] mb-2">{c.emptyCart}</p>
      <p class="[color:var(--color-muted)] mb-6">{c.emptyCartDesc}</p>
      <a href="/" class="btn btn--accent">{c.backToShopping}</a>
    </div>

    <div id="checkout-main">

      <!-- ── Cart section ── -->
      <section aria-labelledby="cart-heading">
        <h1 id="cart-heading" class="text-[clamp(1.3rem,3vw,1.6rem)] font-bold [color:var(--color-text)] mb-5">{c.yourCart}</h1>

        <!-- Skeleton -->
        <div id="cart-content" aria-live="polite">
          <div class="flex gap-4 items-start bg-[color:var(--color-surface)] rounded-[var(--radius)] p-4 mb-3 border [border-color:var(--color-border)]">
            <div class="skel-bar w-20 h-20 rounded-[var(--radius)] shrink-0"></div>
            <div class="flex-1 flex flex-col gap-2 pt-1">
              <div class="skel-bar h-[15px] w-[55%]"></div>
              <div class="skel-bar h-[13px] w-[35%]"></div>
              <div class="skel-bar h-[30px] w-24 rounded-[var(--radius-sm)] mt-1"></div>
            </div>
            <div class="skel-bar w-14 h-[22px] rounded-[var(--radius-sm)] shrink-0 self-center"></div>
          </div>
          <div class="flex gap-4 items-start bg-[color:var(--color-surface)] rounded-[var(--radius)] p-4 mb-3 border [border-color:var(--color-border)] opacity-[.55]">
            <div class="skel-bar w-20 h-20 rounded-[var(--radius)] shrink-0"></div>
            <div class="flex-1 flex flex-col gap-2 pt-1">
              <div class="skel-bar h-[15px] w-[70%]"></div>
              <div class="skel-bar h-[13px] w-[40%]"></div>
            </div>
            <div class="skel-bar w-14 h-[22px] rounded-[var(--radius-sm)] shrink-0 self-center"></div>
          </div>
        </div>

        <!-- Grand total + CTA (revealed after render) -->
        <div id="co-footer" class="hidden">
          <!-- Hidden when nothing in the cart is payable (showcase items only) —
               a "₪0.00 (0 פריטים)" line under a cart that visibly holds products
               reads as a bug, and the notice below already explains it. -->
          {/* The saving sits ABOVE the total, not beside it: the buyer reads down to the number
              they are about to pay, and this is the last thing they pass on the way. It is the
              real gap between the sellers' own listed prices and what the platform is charging —
              never a "compare at" figure invented to make a discount look bigger. */}
          <div id="co-savings-row" class="hidden flex justify-between items-center pt-3 pb-1">
            <span class="flex items-center gap-1.5 text-[.9rem] font-semibold [color:var(--color-sale)]">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
              {c.youSavedTotal}
            </span>
            <strong class="text-[1.05rem] font-extrabold [color:var(--color-sale)]" id="co-savings-amount"></strong>
          </div>
          <div id="co-grand-total-row" class="flex justify-between items-center pt-4 pb-[1.125rem] border-t-2 [border-color:var(--color-border)] mt-1">
            <span class="text-base font-medium [color:var(--color-text)]">{c.total} <span id="grand-total-count" class="text-[.82em] font-normal [color:var(--color-muted)]"></span></span>
            <strong class="text-[1.35rem] font-extrabold [color:var(--color-text)]" id="grand-total-amount"></strong>
          </div>
          <!-- Shown whenever a showcase-store item sits in the cart — the items are
               already marked individually, this is the one sentence that says what
               happens to them at payment. Not a blocker: the pay button stays live
               as long as anything real is selected (lib/demo-stores.ts →
               splitDemoCarts). Swaps to `cartOnlyDemo` when there is nothing else. -->
          <p id="co-demo-notice"
             class="hidden mb-3 rounded-[var(--radius)] border px-3 py-2 text-[0.85rem] leading-relaxed
                    [border-color:color-mix(in_srgb,var(--color-accent)_28%,transparent)]
                    [background:color-mix(in_srgb,var(--color-accent)_7%,var(--color-surface))]
                    [color:var(--color-text)]"
             role="status"></p>
          <button id="to-payment-btn" class="btn btn--accent group w-full py-[.9rem] px-6 text-[1.0625rem] flex items-center justify-center gap-2 mb-2" type="button"
            aria-expanded="false" aria-controls="payment-section">
            <span>{c.toPayment}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              aria-hidden="true" class="transition-transform duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] rtl:-scale-x-100 group-aria-expanded:rotate-90"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p id="co-select-hint" class="hidden text-center text-[.8rem] [color:var(--color-muted)]" role="status">{c.selectAtLeastOne}</p>
        </div>
      </section>

      <!-- ── Payment accordion ── -->
      <section id="payment-section" class="overflow-hidden max-h-0 opacity-0 transition-[max-height_420ms_cubic-bezier(.4,0,.2,1),opacity_280ms_ease] data-[open]:max-h-[1300px] data-[open]:opacity-100" aria-hidden="true">
        <h2 class="font-bold [color:var(--color-text)] mb-5 text-xl mt-1">{c.paymentDetails}</h2>

        <form id="checkout-form" novalidate aria-label={c.buyerDetails}>
          <div class="bg-[color:var(--color-surface)] rounded-[var(--radius)] p-5 border-[1.5px] [border-color:var(--color-border)] mb-3.5">
            <h3 class="text-[.9375rem] font-semibold [color:var(--color-text)] mb-4">{c.buyerDetails}</h3>
            <div class="grid gap-3.5">
              <div>
                <label for="buyerName" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.fullName} *</label>
                <input type="text" id="buyerName" name="buyerName" required autocomplete="name" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="buyerName" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="buyerEmail" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.email} *</label>
                <input type="email" id="buyerEmail" name="buyerEmail" required autocomplete="email" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" value={prefillEmail} />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="buyerEmail" role="alert">{c.invalidEmail}</p>
              </div>
              <div>
                <label for="buyerPhone" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.phone} *</label>
                <input type="tel" id="buyerPhone" name="buyerPhone" required autocomplete="tel" inputmode="tel" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="buyerPhone" role="alert">{c.requiredField}</p>
              </div>
            </div>
          </div>

          <div class="bg-[color:var(--color-surface)] rounded-[var(--radius)] p-5 border-[1.5px] [border-color:var(--color-border)] mb-5">
            <h3 class="text-[.9375rem] font-semibold [color:var(--color-text)] mb-4">{c.shippingAddress}</h3>
            <div class="grid gap-3.5">
              <div>
                <label for="city" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.city} *</label>
                <input type="text" id="city" name="city" required autocomplete="address-level2" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="city" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="street" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.street} *</label>
                <input type="text" id="street" name="street" required autocomplete="street-address" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
                <p class="hidden text-xs [color:var(--color-danger)] mt-1" data-err="street" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="zip" class="block text-sm font-medium mb-1.5 [color:var(--color-text)]">{c.zip}</label>
                <input type="text" id="zip" name="zip" autocomplete="postal-code" inputmode="numeric" class="w-full py-2.5 px-3 border-[1.5px] [border-color:var(--color-border)] rounded-[var(--radius)] bg-[color:var(--color-bg)] [color:var(--color-text)] text-[.9375rem] [font-family:inherit] transition-[border-color,background] duration-150 box-border focus:outline-none focus:[border-color:var(--color-accent)] focus:bg-[color:var(--color-surface)] aria-[invalid=true]:[border-color:var(--color-danger)]" />
              </div>
            </div>
          </div>

          <p id="form-global-error" class="hidden text-sm [color:var(--color-danger)] mb-4" role="alert"></p>

          <!-- A sale that ended while this page sat open. Deliberately NOT the error line above:
               nothing failed and the buyer did nothing wrong, so it reads as a heads-up in the
               warning tone, `role="status"` (announced without interrupting), and the pay button
               right below it stays live — one more press completes the order. -->
          <p id="co-price-notice" class="hidden text-sm mb-4 py-2.5 px-3 rounded-[var(--radius)] [color:var(--color-warning)] [background:color-mix(in_srgb,var(--color-warning)_9%,transparent)] border [border-color:color-mix(in_srgb,var(--color-warning)_28%,transparent)]" role="status"></p>

          <!-- The showcase-store notice lives once, up in #co-footer next to the
               grand total — that's where the buyer reads what they're paying for. -->

          <button type="submit" id="submit-btn" class="btn btn--accent w-full py-[.9rem] px-6 text-[1.0625rem] flex items-center justify-center gap-2 mb-2">
            <span id="submit-label">{c.placeOrder}</span>
            <span id="submit-loading" class="hidden" aria-live="polite">{c.processing}</span>
          </button>
          <p id="co-submit-hint" class="hidden text-center text-[.8rem] [color:var(--color-muted)]" role="status">{c.noItemsSelected}</p>
        </form>
      </section>

    </div>
  </div>

  <!-- PQV and lightbox dialogs are rendered globally via ProductQuickView in BaseLayout -->

  <script>
    import { getActiveStoreCarts, setQty, removeItem, itemSaving, makeCartKey, applyStockLimit, mergeStoreCart } from '../lib/cart.js';
    import { CART_FRAGMENT_KEY, decodeHandoffCart } from '../lib/cart-handoff.js';
    import { HANDOFF_PARAM } from '../lib/platform-routes.js';
    import { sortCurrentStoreFirst } from '../lib/cart-sovereignty.js';
    import { refreshCartPrices, watchCartPrices, hasIncrease, stockCorrections, storeOffersCoupon } from '../lib/cart-prices.js';
    import {
      couponRowHtml, openCouponPanel, applyCouponCode, appliedCoupon, clearCoupon, clearAllCoupons,
      couponCodesFor, couponSavingIls, type CouponStrings,
    } from '../scripts/checkout-coupon.js';
    import { splitDemoCarts } from '../lib/demo-stores.js';
    import { formatPrice, cdnThumb } from '../config/store.config.js';
    import { escapeHtml as esc } from '../lib/html-escape.js';
    import { spawnRipple } from '../lib/ripple.js';
    import { checkoutAttemptKey, clearCheckoutAttemptKey } from '../lib/checkout-attempt-key.js';
    import { trackInitiateCheckout } from '../lib/tracking.js';
    import { adItemId } from '../lib/ad-item-id.js';
    import { isValidEmail } from '../lib/email-address.js';
    import { initSelectDropdown, COMPACT_TRIGGER_CLASS } from '../scripts/dashboard/select-dropdown.js';
    // Not scrollIntoView: the site header is `position:fixed`, and `block:'start'` parks the
    // target's top edge at viewport top — underneath it. That is what hid the "פרטי תשלום" heading
    // when the payment accordion opened. scroll-utils.ts owns the offset (and the RTL-safe scroll).
    import { scrollBelowPinnedChrome } from '../scripts/dashboard/scroll-utils.js';

    // Price shown inside each dropdown option (self-pickup is free). NOT shown on the closed
    // trigger — the trigger mirrors just the method name, and the price already sits outside.
    const optionMeta = (value: string): string => {
      const p = value === 'pickup' ? 0 : (platformRates[value] ?? 0);
      return p === 0 ? (i18n['freeShipping'] ?? 'חינם') : formatPrice(p);
    };

    // `?store=` is the store the shopper CAME FROM — the toast they clicked, the product they had
    // open. It used to FILTER the page down to that store, and that is what made "לתשלום" mean two
    // different things depending on where it was pressed: from the add-to-cart toast you paid for
    // one store, from a product page or modal (which linked to a bare /checkout) you paid for the
    // whole cart.
    //
    // It now carries INTENT instead: that store floats to the top and starts selected, every other
    // store is still listed underneath and starts UNSELECTED. One behaviour for every entry point,
    // and the difference between them is only what arrives pre-ticked.
    //
    // Showing the other stores costs the buyer nothing — shipping is per store, and a store with
    // nothing selected contributes no items, no shipping, and hides its shipping card entirely
    // (see the totals loop). Filtering them away never protected the total; it only hid a cart the
    // header was still counting.
    // **A cart arriving from a seller's own domain** (`cart-handoff.ts`). A custom domain is a
    // different browser origin, so the basket the shopper filled there cannot be read from here —
    // it travelled in the URL fragment and this is where it lands. FIRST, before anything reads
    // `getActiveStoreCarts()`, or the page renders the cart the shopper did not bring and then
    // changes under them.
    //
    // The URL is cleaned in the same breath, and both halves have to go: the fragment, so a refresh
    // cannot merge the same basket twice, and `?h=` (the signed identity carry-over, already
    // consumed by the middleware before this script existed) so it is not left sitting in an address
    // bar to be copied into a chat. `replaceState`, not a redirect — the server has everything it
    // needs and a round trip here is charged to the slowest moment in the funnel.
    const handedOver = decodeHandoffCart(
      new URLSearchParams(location.hash.replace(/^#/, '')).get(CART_FRAGMENT_KEY),
    );
    if (handedOver) mergeStoreCart(handedOver);
    if (handedOver || new URLSearchParams(location.search).has(HANDOFF_PARAM)) {
      const clean = new URL(location.href);
      clean.hash = '';
      clean.searchParams.delete(HANDOFF_PARAM);
      history.replaceState(history.state, '', clean.pathname + clean.search);
    }

    const intentSlug = new URLSearchParams(window.location.search).get('store')
      // No `?store=` but a cart just crossed the boundary: that store IS the intent — the shopper
      // pressed "לתשלום" inside it one navigation ago. Same meaning the parameter carries, arrived
      // by a different road.
      ?? handedOver?.storeSlug ?? '';
    function getOrderedCarts() {
      return sortCurrentStoreFirst(getActiveStoreCarts(), intentSlug);
    }

    type StoreDeliveryCfg = { methods: string[]; address: string | null; demo?: boolean };
    const shippingCfg: { stores?: Record<string, StoreDeliveryCfg>; rates?: Record<string, number> } =
      JSON.parse((document.getElementById('checkout-shipping-cfg') as HTMLElement | null)?.textContent ?? '{}');
    const shippingStores: Record<string, StoreDeliveryCfg> = shippingCfg.stores ?? {};
    const platformRates: Record<string, number> = shippingCfg.rates ?? {};
    const i18n: Record<string, string> =
      JSON.parse((document.getElementById('checkout-i18n') as HTMLElement | null)?.textContent ?? '{}');

    // Buyer's chosen delivery method per store. Defaults to courier — a PAID method — so a
    // store never silently defaults to free; persists across cart re-renders. The server
    // re-validates and re-prices whatever we send, so this is display/intent only.
    const chosenMethod: Record<string, string> = {};
    function methodFor(slug: string): string {
      if (chosenMethod[slug]) return chosenMethod[slug]!;
      const methods = shippingStores[slug]?.methods ?? ['courier'];
      chosenMethod[slug] = methods.includes('courier') ? 'courier' : (methods[0] ?? 'courier');
      return chosenMethod[slug]!;
    }
    function methodLabel(method: string): string {
      if (method === 'pickup') return i18n['methodPickup'] ?? 'איסוף עצמי';
      if (method === 'pickup_point') return i18n['methodPickupPoint'] ?? 'נקודת איסוף';
      return i18n['methodCourier'] ?? 'שליח עד הבית';
    }
    // Self-pickup is always free; courier/pickup-point use the central platform rate.
    function calcShipping(slug: string): number {
      const method = methodFor(slug);
      return method === 'pickup' ? 0 : (platformRates[method] ?? 0);
    }

    // A showcase store's items are view-only: they stay in the cart, marked, and
    // are simply never selectable, so they can't reach the order. See
    // lib/demo-stores.ts → splitDemoCarts for why this is per-item and not a
    // whole-cart block.
    const isDemoSlug = (slug: string): boolean => !!shippingStores[slug]?.demo;
    const payableCarts = <T extends { storeSlug: string }>(carts: readonly T[]): T[] =>
      splitDemoCarts(carts, isDemoSlug).payable;

    // ── Selection (which items the buyer is actually paying for) ──
    // Default: the store the shopper arrived FROM (`?store=`), or everything selectable when they
    // arrived without one. Selection is per-page-load (not persisted) — it resets on every open.
    const selKey = (storeSlug: string, cartKey: string) => `${storeSlug}::${cartKey}`;
    let selected = new Set<string>();
    let selectionInitialized = false;

    function syncSelection(carts: ReturnType<typeof getOrderedCarts>): void {
      // Only payable carts contribute keys — that alone is what keeps a showcase
      // item out of the total, out of the submitted order, and out of the
      // "everything is checked by default" state.
      const currentKeys = new Set<string>();
      const intentKeys = new Set<string>();
      payableCarts(carts).forEach(cart =>
        cart.items.forEach(item => {
          const k = selKey(cart.storeSlug, item.cartKey);
          currentKeys.add(k);
          if (cart.storeSlug === intentSlug) intentKeys.add(k);
        }));
      if (!selectionInitialized) {
        // Falling back to everything when the intent store has nothing payable here is not a
        // nicety — it is the difference between a working page and a dead one. A bookmarked or
        // shared `?store=` whose cart was since emptied, and a showcase store (whose items are
        // never selectable at all), would otherwise open checkout with zero ticked, a zero total
        // and a disabled submit, next to a cart plainly holding things the buyer can pay for.
        selected = intentKeys.size ? intentKeys : new Set(currentKeys);
        selectionInitialized = true;
      } else {
        for (const k of Array.from(selected)) if (!currentKeys.has(k)) selected.delete(k);
      }
    }

    // Flattened custom checkbox: box + icons are direct siblings of the (peer)
    // input rather than nested inside the box, so peer-checked/peer-indeterminate
    // can target them directly (Tailwind's peer-* only matches true siblings).
    function checkboxHtml(cls: string, attrs: string, ariaLabel: string, withDash: boolean): string {
      const dash = withDash
        ? `<svg class="pointer-events-none absolute inset-0 m-auto w-3 h-3 [color:var(--color-surface)] opacity-0 scale-[.4] peer-indeterminate:opacity-100 peer-indeterminate:scale-100 transition-[opacity,transform] duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="8" x2="12" y2="8"/></svg>`
        : '';
      return `<label class="relative inline-flex shrink-0 cursor-pointer ${cls}">
        <input type="checkbox" class="peer absolute inset-0 w-5 h-5 m-0 opacity-0 cursor-pointer" ${attrs} aria-label="${esc(ariaLabel)}">
        <span class="pointer-events-none relative w-5 h-5 rounded-[var(--radius-sm)] border-[1.5px] [border-color:var(--color-border)] bg-[color:var(--color-surface)] shrink-0 transition-[background_140ms,border-color_140ms,transform_120ms_cubic-bezier(0.34,1.56,0.64,1)] peer-checked:bg-[color:var(--color-accent)] peer-checked:border-[color:var(--color-accent)] peer-indeterminate:bg-[color:var(--color-accent)] peer-indeterminate:border-[color:var(--color-accent)] peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:[outline-color:var(--color-accent)] peer-active:scale-90" aria-hidden="true"></span>
        <svg class="pointer-events-none absolute inset-0 m-auto w-3 h-3 [color:var(--color-surface)] opacity-0 scale-[.4] peer-checked:opacity-100 peer-checked:scale-100 transition-[opacity,transform] duration-[220ms] ease-[cubic-bezier(0.34,1.56,0.64,1)]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3.5 8.5 6.5 11.5 12.5 4.5"/></svg>
        ${dash}
      </label>`;
    }

    // One place the coupon UI's wording is assembled, so the row, the messages and the applied
    // chip all read from the same i18n table this page already ships.
    const couponStrings = (): CouponStrings => ({
      have:        i18n['couponHave'] ?? 'יש לי קוד קופון',
      placeholder: i18n['couponPlaceholder'] ?? 'קוד קופון',
      apply:       i18n['couponApply'] ?? 'הפעלה',
      remove:      i18n['couponRemove'] ?? 'הסרה',
      invalid:     i18n['couponInvalid'] ?? 'הקוד אינו תקף',
      throttled:   i18n['couponThrottled'] ?? 'נסו שוב בעוד רגע',
      belowMin:    i18n['couponBelowMin'] ?? 'הקוד תקף מ-{min}',
    });

    function renderCart(): void {
      const carts = getOrderedCarts();
      const contentEl = document.getElementById('cart-content');
      const footerEl  = document.getElementById('co-footer');
      if (!contentEl) return;

      if (!carts.length) {
        document.getElementById('checkout-main')?.classList.add('hidden');
        document.getElementById('checkout-empty')?.classList.remove('hidden');
        return;
      }

      syncSelection(carts);

      let html = '';

      // Global "select all" — only worth showing with more than one SELECTABLE
      // store, since a single store's own row checkbox already selects/deselects
      // everything (a showcase store has no checkbox at all).
      if (payableCarts(carts).length > 1) {
        html += `<div class="flex items-center gap-2.5 mb-4 pb-3 border-b [border-color:var(--color-border)]">
          ${checkboxHtml('co-select-all-check', '', i18n['selectAllAria'] ?? '', true)}
          <span class="text-[.9rem] font-semibold [color:var(--color-text)]">${esc(i18n['selectAll'] ?? 'בחר הכל')}</span>
          <span class="co-select-all-count text-xs font-normal [color:var(--color-muted)]" dir="ltr"></span>
        </div>`;
      }

      // The same store-sovereignty heading the cart drawer uses: the store the shopper came from
      // sits on top with no heading of its own, and the rest fall under one muted "מחנויות אחרות"
      // line. It is what tells the buyer the unticked blocks below are not a mistake — they are
      // simply the other stores in their cart, still there, still payable if they tick them.
      // Only when there IS an intent store; a bare /checkout has no "current" to be other than.
      const showOtherStoresLabel = !!intentSlug && carts.some(c => c.storeSlug === intentSlug);
      let otherLabelShown = false;

      carts.forEach((cart, idx) => {
        // Initial paint only — recalculated precisely (per current selection) by
        // updateSelectionUI() right after this HTML is inserted into the DOM.
        const shipping = calcShipping(cart.storeSlug);
        const isDemo = isDemoSlug(cart.storeSlug);

        const labelledHere = showOtherStoresLabel && cart.storeSlug !== intentSlug && !otherLabelShown;
        if (labelledHere) {
          otherLabelShown = true;
          // Underline sized to the TEXT, not to the column — inline-block, exactly as
          // .cart-other-stores-label does it in the drawer.
          html += `<div class="inline-block text-[.72rem] font-semibold [color:var(--color-muted)] pb-[.15rem] mt-6 mb-1 border-b [border-color:var(--color-border)]">${esc(i18n['otherStores'] ?? 'מחנויות אחרות')}</div>`;
        }

        html += `<div class="co-store-block contents" data-store-slug="${esc(cart.storeSlug)}"${isDemo ? ' data-demo' : ''}>`;

        // Store row: select-all checkbox + store label. A showcase store gets the
        // "view only" eye in the checkbox's place instead — same 20px box, so the
        // store names stay on one vertical line down the whole cart — plus the
        // "חנות לדוגמה" chip the store card and store page already show.
        const rowLead = isDemo
          ? `<span class="inline-flex shrink-0 w-5 h-5 items-center justify-center rounded-[var(--radius-sm)] border-[1.5px] border-dashed [border-color:color-mix(in_srgb,var(--color-accent)_45%,var(--color-border))] [color:var(--color-accent)]" title="${esc(i18n['demoBadgeTitle'] ?? '')}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
             </span>`
          : checkboxHtml('co-store-check', `data-store-slug="${esc(cart.storeSlug)}"`, `${i18n['selectStoreAria'] ?? ''} ${cart.storeName}`, true);
        // The heading carries its own gap above it, so the store row it introduces must not add a
        // second one — same reason the drawer drops its <hr> where the heading appears.
        html += `<div class="flex items-center gap-2.5 ${idx === 0 || labelledHere ? 'mt-0' : 'mt-5'} mb-2.5">
          ${rowLead}
          <a href="/${esc(cart.storeSlug)}" class="inline-block text-xs font-bold [color:var(--color-muted)] tracking-[.06em] uppercase no-underline transition-colors duration-[140ms] hover:underline">${esc(cart.storeName)}</a>
          ${isDemo
            ? `<span class="text-[.68rem] font-bold tracking-[.04em] rounded-[var(--radius-sm)] px-1.5 py-[.1rem] [color:var(--color-accent)] [background:color-mix(in_srgb,var(--color-accent)_10%,transparent)]">${esc(i18n['demoBadge'] ?? '')}</span>`
            : `<span class="co-store-count text-xs font-normal [color:var(--color-muted)]"></span>`}
        </div>`;

        // One card per item
        cart.items.forEach(item => {
          const isSelected = !isDemo && selected.has(selKey(cart.storeSlug, item.cartKey));
          const imgHtml = item.image
            ? `<img src="${esc(cdnThumb(item.image, 160, 160))}" alt="${esc(item.name)}" class="w-20 h-20 object-cover block" width="80" height="80" loading="lazy" decoding="async" />`
            : `<div class="w-20 h-20 flex items-center justify-center [color:var(--color-muted)]" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                </svg>
               </div>`;
          const variantsHtml = item.selectedVariants && Object.keys(item.selectedVariants).length
            ? `<p class="text-[.775rem] [color:var(--color-muted)] mt-[.2rem]">${esc(Object.entries(item.selectedVariants).map(([k,v]) => `${k}: ${v}`).join(' · '))}</p>`
            : '';

          // A view-only card is NOT drawn as an unselected one: same-shape card,
          // dashed accent border over a faint accent wash, and no checkbox (an
          // empty 20px spacer holds the column so the row of cards stays aligned).
          // `data-unselected`'s 50% opacity is deliberately withheld — dimming it
          // would read as "you forgot to tick this", which is the opposite of what
          // the card says.
          const cardClass = isDemo
            ? 'co-card flex items-center gap-4 rounded-[var(--radius)] p-4 mb-3 border border-dashed [border-color:color-mix(in_srgb,var(--color-accent)_38%,var(--color-border))] [background:color-mix(in_srgb,var(--color-accent)_4%,var(--color-surface))]'
            : 'co-card flex items-center gap-4 bg-[color:var(--color-surface)] rounded-[var(--radius)] p-4 mb-3 border [border-color:var(--color-border)] transition-[box-shadow,opacity] duration-150 hover:shadow-[var(--shadow-hover)] data-[unselected]:opacity-50';
          html += `<div class="${cardClass}" data-store-slug="${esc(cart.storeSlug)}" data-cart-key="${esc(item.cartKey)}" data-item-name="${esc(item.name)}"${isDemo ? ' data-demo' : (isSelected ? '' : ' data-unselected')}>
            ${isDemo
              ? '<span class="shrink-0 w-5" aria-hidden="true"></span>'
              : checkboxHtml('co-item-check', `data-store-slug="${esc(cart.storeSlug)}" data-cart-key="${esc(item.cartKey)}" ${isSelected ? 'checked' : ''}`, `${i18n['selectItemAria'] ?? ''} ${item.name}`, false)}
            <!-- --color-surface, never --color-border: this box is FILLED, not outlined, and a
                 background-removed product photo shows its fill straight through the subject —
                 which is why every such photo here read as sitting on grey (owner, 2026-08-07).
                 The 1px border is what keeps a white photo on a white card from having no edge.
                 tokens.css carries the rule; tests/image-container-bg.test.ts now covers markup
                 as well as CSS, which is how this one survived three earlier fixes of the same bug. -->
            <button type="button" class="pqv-trigger shrink-0 block w-20 h-20 rounded-[var(--radius)] overflow-hidden bg-[color:var(--color-surface)] border [border-color:var(--color-border)] transition-opacity duration-[140ms] p-0 cursor-pointer hover:opacity-[.85]"
              data-store-slug="${esc(cart.storeSlug)}" data-product-slug="${esc(item.slug)}" data-store-name="${esc(cart.storeName)}"
              aria-label="${esc(i18n['viewProduct'] ?? '')} ${esc(item.name)}">
              ${imgHtml}
            </button>
            <div class="flex-1 min-w-0">
              <button type="button" class="co-card__name pqv-trigger text-[.9375rem] font-semibold [color:var(--color-text)] no-underline block whitespace-nowrap overflow-hidden text-ellipsis transition-colors duration-[140ms] bg-transparent border-0 p-0 cursor-pointer [font-family:inherit] [text-align:inherit] w-full hover:[color:var(--color-muted)]"
                data-store-slug="${esc(cart.storeSlug)}" data-product-slug="${esc(item.slug)}" data-store-name="${esc(cart.storeName)}">${esc(item.name)}</button>
              ${variantsHtml}
              <div class="flex items-center gap-1.5 mt-2.5">
                ${isDemo
                  // No quantity stepper on something that can't be bought — changing
                  // "how many" of a view-only item is a control that does nothing.
                  // The sentence takes its place, so the row keeps its height.
                  ? `<span class="text-[.775rem] font-medium [color:var(--color-accent)] me-0.5">${esc(i18n['demoExcluded'] ?? '')}</span>`
                  : `<div class="cart-line__qty shrink-0" dir="ltr" role="group" aria-label="${esc(i18n['quantity'] ?? 'כמות')}">
                  <button class="co-qty__btn" data-action="dec" aria-label="${esc(i18n['qtyDecrease'] ?? 'הפחת כמות')}" type="button" ${item.qty <= 1 ? 'disabled' : ''}>−</button>
                  <span class="co-qty__num w-7" aria-live="polite">${item.qty}</span>
                  <button class="co-qty__btn" data-action="inc" aria-label="${esc(i18n['qtyIncrease'] ?? 'הוסף כמות')}" type="button" data-stock="${item.stock ?? ''}" ${item.stock != null && item.qty >= item.stock ? 'disabled' : ''}>+</button>
                </div>`}
                <button class="w-[26px] h-[26px] shrink-0 bg-[color:var(--color-surface)] border [border-color:var(--color-border)] rounded-[var(--radius-sm)] cursor-pointer [color:var(--color-muted)] flex items-center justify-center transition-[color,background,border-color] duration-[130ms] hover:[color:var(--color-danger)] hover:bg-[color-mix(in_srgb,var(--color-danger)_8%,transparent)] hover:[border-color:color-mix(in_srgb,var(--color-danger)_30%,var(--color-border))]" data-action="remove" aria-label="${esc(i18n['removeItem'] ?? 'הסר')}" type="button">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                </button>
              </div>
            </div>
            <div class="co-card__price-col shrink-0 text-end flex flex-col items-end gap-[.15rem]">
              <!-- Muted, not struck through: the price is real, it just isn't part
                   of this total. A strikethrough would read as a discount. -->
              <span class="co-card__total text-[1.0625rem] font-extrabold ${isDemo ? '[color:var(--color-muted)] font-semibold' : itemSaving(item) > 0 ? 'price-now price-now--sale' : '[color:var(--color-text)]'}">${formatPrice(item.price * item.qty)}</span>
              ${itemSaving(item) > 0 ? `<s class="price-was !ms-0 text-[.72rem]">${formatPrice(item.basePrice! * item.qty)}</s>` : ''}
              ${item.qty > 1 ? `<span class="co-card__unit text-[.72rem] [color:var(--color-muted)]">${formatPrice(item.price)} ${esc(i18n['perUnit'] ?? 'ליח׳')}</span>` : ''}
            </div>
          </div>`;
        });

        // Shipping card for this store — "שיטת משלוח:" + an app-styled dropdown (each option
        // shows its price; the closed trigger shows just the chosen method name) + the price
        // outside. Prices are platform-set; self-pickup is free and reveals the address below.
        // Skipped entirely for a view-only store — nothing ships, and a delivery
        // picker under items that can't be bought is a control with no outcome.
        if (isDemo) { html += `</div>`; return; }

        // Per-store saving, in the mall's own grammar: the bag is grouped by store, so the
        // buyer is told what each store's slice saved them before the one figure at the bottom.
        // Rendered only when there is something to report — a "חסכת 0 ₪" row would be noise,
        // and a saving invented where none exists is the one thing this feature must never do.
        html += `<div class="co-store-saving flex items-center justify-between gap-2 py-2 px-4 mb-3 rounded-[var(--radius)] !hidden" data-store-slug="${esc(cart.storeSlug)}" style="background:color-mix(in srgb, var(--color-sale) 9%, var(--color-surface));border:1px solid color-mix(in srgb, var(--color-sale) 22%, transparent)">
          <span class="flex items-center gap-1.5 text-[.85rem] font-semibold [color:var(--color-sale)]">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
            ${esc(i18n['youSaved'] ?? 'חסכת בחנות הזו')}
          </span>
          <strong class="co-store-saving__amount text-[.9375rem] font-extrabold [color:var(--color-sale)]"></strong>
        </div>`;

        // The coupon field, and only where there is a code to type: the server reports which of
        // this cart's stores is actually running one (/api/cart/prices → storeOffersCoupon), so a
        // shop with no promotion adds nothing to this page at all. An already-applied code keeps
        // its row regardless — a re-render must never drop a discount the buyer has earned.
        if (storeOffersCoupon(cart.storeSlug) || appliedCoupon(cart.storeSlug)) {
          html += couponRowHtml(cart.storeSlug, couponStrings(), idx);
        }

        const isFree = shipping === 0;
        const methods = shippingStores[cart.storeSlug]?.methods ?? ['courier'];
        const chosen  = methodFor(cart.storeSlug);
        const optionsHtml = methods
          .map(m => `<option value="${esc(m)}" ${m === chosen ? 'selected' : ''}>${esc(methodLabel(m))}</option>`)
          .join('');
        html += `<div class="co-shipping-card bg-[color:var(--color-surface)] rounded-[var(--radius)] py-3.5 px-4 mb-3 border [border-color:var(--color-border)]" data-store-slug="${esc(cart.storeSlug)}">
          <div class="flex items-center justify-between gap-2.5">
            <div class="flex items-center gap-2 min-w-0">
              <svg class="shrink-0 [color:var(--color-accent)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span class="text-[.9rem] font-medium [color:var(--color-text)] shrink-0">${esc(i18n['deliveryMethod'] ?? 'שיטת משלוח')}:</span>
              <select class="co-method-select" data-store-slug="${esc(cart.storeSlug)}" aria-label="${esc(i18n['deliveryMethod'] ?? 'שיטת משלוח')}">${optionsHtml}</select>
            </div>
            <span class="co-shipping-card__amount text-[.9375rem] font-bold shrink-0 ${isFree ? 'data-[free]:[color:var(--color-success)]' : ''} [color:var(--color-text)]" ${isFree ? 'data-free' : ''}>${isFree ? (i18n['freeShipping'] ?? 'חינם') : formatPrice(shipping)}</span>
          </div>
          <p class="co-pickup-address hidden text-xs [color:var(--color-muted)] mt-2 ps-[26px]" data-store-slug="${esc(cart.storeSlug)}"></p>
        </div>`;

        html += `</div>`; // close .co-store-block
      });

      contentEl.innerHTML = html;

      footerEl?.classList.remove('hidden');

      attachEvents();
      // Upgrade each delivery-method <select> into the shared app-styled dropdown.
      document.querySelectorAll<HTMLSelectElement>('.co-method-select').forEach(sel =>
        initSelectDropdown(sel, { triggerClassName: COMPACT_TRIGGER_CLASS, menuAutoWidth: true, optionMeta }));
      updateSelectionUI();
    }

    function patchQty(card: HTMLElement, storeSlug: string, cartKey: string): void {
      const carts   = getActiveStoreCarts();
      const item    = carts.find(c => c.storeSlug === storeSlug)?.items.find(i => i.cartKey === cartKey);
      if (!item) { renderCart(); return; }

      const qtyEl    = card.querySelector<HTMLElement>('.co-qty__num');
      const decBtn   = card.querySelector<HTMLButtonElement>('[data-action="dec"]');
      const incBtn   = card.querySelector<HTMLButtonElement>('[data-action="inc"]');
      const totalEl  = card.querySelector<HTMLElement>('.co-card__total');
      const priceCol = card.querySelector<HTMLElement>('.co-card__price-col');

      if (qtyEl)   qtyEl.textContent   = String(item.qty);
      if (decBtn)  decBtn.disabled      = item.qty <= 1;
      if (incBtn)  incBtn.disabled      = item.stock != null && item.qty >= item.stock;
      if (totalEl) totalEl.textContent  = formatPrice(item.price * item.qty);

      const unitEl = priceCol?.querySelector<HTMLElement>('.co-card__unit');
      if (item.qty > 1) {
        const txt = `${formatPrice(item.price)} ${i18n['perUnit'] ?? 'ליח׳'}`;
        if (unitEl) { unitEl.textContent = txt; }
        else {
          const span = document.createElement('span');
          span.className = 'co-card__unit text-[.72rem] [color:var(--color-muted)]';
          span.textContent = txt;
          priceCol?.appendChild(span);
        }
      } else {
        unitEl?.remove();
      }

      updateSelectionUI();
    }

    // Recomputes everything that depends on which items are checked: per-store
    // shipping card (hidden entirely once a store has nothing selected), grand
    // total, each store's select-all checkbox state, and the pay button.
    function updateSelectionUI(): void {
      const allCarts = getOrderedCarts();
      // Everything below counts and prices PAYABLE carts only — a view-only card
      // has no checkbox, no shipping card and no share of the total, so letting it
      // into these loops would only produce "(0 פריטים)" rows and a wrong x/y count.
      const { payable: carts, viewOnly } = splitDemoCarts(allCarts, isDemoSlug);
      const itemWord = (n: number) => n !== 1 ? (i18n['items'] ?? 'items') : (i18n['item'] ?? 'item');
      let grandTotal = 0;
      let totalSaving = 0;
      let anySelected = false;
      let totalItems = 0;
      let totalSelected = 0;

      // A code applied and then left stranded — every line of its store unticked — is dropped
      // rather than kept as an invisible discount that reappears on the next tick, and it must not
      // travel to /api/checkout either, which refuses a coupon for a store not in the order. The
      // re-render happens after the loop, never inside it: redrawing the markup this loop is
      // reading from is how a half-updated page happens.
      let couponDropped = false;

      carts.forEach(cart => {
        const block = document.querySelector<HTMLElement>(`.co-store-block[data-store-slug="${CSS.escape(cart.storeSlug)}"]`);
        let subtotal = 0;
        let selCount = 0;
        let storeSaving = 0;
        cart.items.forEach(item => {
          if (selected.has(selKey(cart.storeSlug, item.cartKey))) {
            subtotal += item.price * item.qty;
            storeSaving += itemSaving(item);
            selCount++;
          }
        });
        // The coupon comes off the SUBTOTAL, after the two price levers have decided each line and
        // before shipping — exactly the order `/api/checkout` applies it in, and the reason it is
        // computed from `subtotal` here rather than from the grand total. A store with nothing
        // ticked gets nothing off: there is no slice for a code to discount.
        if (selCount === 0 && appliedCoupon(cart.storeSlug)) { clearCoupon(cart.storeSlug); couponDropped = true; }
        const couponSaving = selCount > 0 ? couponSavingIls(cart.storeSlug, subtotal) : 0;
        // Counted as a saving because it is one, by the same definition the rest of this footer
        // uses: the gap between the listed price and what is actually charged.
        storeSaving += couponSaving;
        totalSaving += storeSaving;

        const savingRow = block?.querySelector<HTMLElement>('.co-store-saving');
        if (savingRow) {
          // `!hidden`, not `hidden` — this row is a `flex` element, and in this build `.flex` is
          // emitted after `.hidden`, so the plain utility loses on source order and the row stays
          // on screen showing "0 ₪" for a store that saved nothing (memory: hidden-vs-flex).
          // With a single store the per-store row and the order row are the same number twice —
          // the footer already says it. The per-store breakdown only earns its place once the
          // bag holds more than one store, which is the case it exists for.
          const showSaving = storeSaving > 0 && carts.length > 1;
          savingRow.classList.toggle('!hidden', !showSaving);
          const amt = savingRow.querySelector<HTMLElement>('.co-store-saving__amount');
          if (amt) amt.textContent = showSaving ? formatPrice(storeSaving) : '';
        }
        if (selCount > 0) anySelected = true;
        totalItems += cart.items.length;
        totalSelected += selCount;

        const shipping = selCount > 0 ? calcShipping(cart.storeSlug) : 0;
        grandTotal += subtotal - couponSaving + shipping;

        const shipCard = block?.querySelector<HTMLElement>('.co-shipping-card');
        if (shipCard) {
          shipCard.classList.toggle('hidden', selCount === 0);
          if (selCount > 0) {
            const isFree = shipping === 0;
            const amountEl = shipCard.querySelector<HTMLElement>('.co-shipping-card__amount');
            if (amountEl) {
              amountEl.textContent = isFree ? (i18n['freeShipping'] ?? 'חינם') : formatPrice(shipping);
              amountEl.toggleAttribute('data-free', isFree);
            }
            // Self-pickup → show where to collect from; any other method hides it.
            const addrEl = shipCard.querySelector<HTMLElement>('.co-pickup-address');
            if (addrEl) {
              const addr = shippingStores[cart.storeSlug]?.address;
              const showAddr = methodFor(cart.storeSlug) === 'pickup' && !!addr;
              addrEl.textContent = showAddr ? `${i18n['pickupFrom'] ?? 'איסוף מ'}: ${addr}` : '';
              addrEl.classList.toggle('hidden', !showAddr);
            }
          }
        }

        const storeCheckbox = block?.querySelector<HTMLInputElement>('.co-store-check input');
        if (storeCheckbox) {
          storeCheckbox.checked = selCount > 0 && selCount === cart.items.length;
          storeCheckbox.indeterminate = selCount > 0 && selCount < cart.items.length;
        }

        const storeCountEl = block?.querySelector<HTMLElement>('.co-store-count');
        if (storeCountEl) storeCountEl.textContent = `(${selCount} ${itemWord(selCount)})`;
      });

      // The markup is now out of date in one specific way — a coupon row that must go back to its
      // closed state — so the whole cart is redrawn and this pass restarts against it.
      if (couponDropped) { renderCart(); return; }

      const selectAllBox = document.querySelector<HTMLInputElement>('.co-select-all-check input');
      if (selectAllBox) {
        selectAllBox.checked = totalSelected > 0 && totalSelected === totalItems;
        selectAllBox.indeterminate = totalSelected > 0 && totalSelected < totalItems;
      }
      const selectAllCountEl = document.querySelector<HTMLElement>('.co-select-all-count');
      if (selectAllCountEl) selectAllCountEl.textContent = `(${totalSelected}/${totalItems})`;

      // `!hidden` for the same reason the demo notice below uses it: this row is a `flex`
      // element and `.flex` is emitted after `.hidden` in this build, so a plain `hidden`
      // utility loses on source order.
      const savingsRow = document.getElementById('co-savings-row');
      if (savingsRow) {
        savingsRow.classList.toggle('!hidden', totalSaving <= 0);
        const amountEl = document.getElementById('co-savings-amount');
        if (amountEl) amountEl.textContent = formatPrice(totalSaving);
      }

      const totalEl = document.getElementById('grand-total-amount');
      if (totalEl) totalEl.textContent = formatPrice(grandTotal);
      const totalCountEl = document.getElementById('grand-total-count');
      if (totalCountEl) totalCountEl.textContent = `(${totalSelected} ${itemWord(totalSelected)})`;

      // A showcase-store item never blocks the order — it just isn't in it. The
      // notice explains that; only a cart with nothing BUT showcase items (no
      // payable cart at all) turns into the refusal, and it says why.
      const onlyDemo = viewOnly.length > 0 && carts.length === 0;
      // `!hidden`, not `hidden`: this row is a `flex` element and in this build
      // `.flex` is emitted AFTER `.hidden`, so the plain utility loses on source
      // order and the row stays visible (measured 2026-07-29 — computed display
      // was still `flex` with `hidden` applied).
      document.getElementById('co-grand-total-row')?.classList.toggle('!hidden', onlyDemo);
      const noticeEl = document.getElementById('co-demo-notice');
      if (noticeEl) {
        noticeEl.textContent = onlyDemo ? (i18n['demoOnly'] ?? '') : (i18n['demoNotice'] ?? '');
        noticeEl.classList.toggle('hidden', viewOnly.length === 0);
      }

      const toPaymentBtn = document.getElementById('to-payment-btn') as HTMLButtonElement | null;
      if (toPaymentBtn) toPaymentBtn.disabled = !anySelected;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = !anySelected;
      // "בחרו לפחות פריט אחד" is only true advice when there IS something to
      // choose — with an all-showcase cart the notice above already carries it.
      document.getElementById('co-select-hint')?.classList.toggle('hidden', anySelected || onlyDemo);
      document.getElementById('co-submit-hint')?.classList.toggle('hidden', anySelected || onlyDemo);
    }

    function attachEvents(): void {
      document.querySelectorAll<HTMLElement>('.co-card').forEach(card => {
        const storeSlug = card.dataset['storeSlug'] ?? '';
        const cartKey   = card.dataset['cartKey'] ?? '';
        const itemName  = card.dataset['itemName'] ?? '';
        const qtyEl     = card.querySelector<HTMLElement>('.co-qty__num');

        card.querySelector<HTMLButtonElement>('[data-action="inc"]')?.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const current = parseInt(qtyEl?.textContent ?? '1', 10);
          const stockLimit = btn.dataset['stock'] ? parseInt(btn.dataset['stock'], 10) : Infinity;
          if (current < stockLimit) {
            setQty(storeSlug, cartKey, current + 1);
            patchQty(card, storeSlug, cartKey);
          }
        });

        card.querySelector<HTMLButtonElement>('[data-action="dec"]')?.addEventListener('click', () => {
          const current = parseInt(qtyEl?.textContent ?? '1', 10);
          if (current <= 1) {
            confirmRemove(storeSlug, cartKey, itemName);
          } else {
            setQty(storeSlug, cartKey, current - 1);
            patchQty(card, storeSlug, cartKey);
          }
        });

        card.querySelector<HTMLButtonElement>('[data-action="remove"]')?.addEventListener('click', () => {
          confirmRemove(storeSlug, cartKey, itemName);
        });
      });
    }

    function confirmRemove(storeSlug: string, cartKey: string, name: string): void {
      window.dispatchEvent(new CustomEvent('confirm:open', {
        detail: {
          title: i18n['removeTitle'] ?? 'הסר מהעגלה?',
          message: `${i18n['removeMsg'] ?? 'הפריט יוסר מהעגלה שלך'}: "${name}"`,
          okLabel: i18n['removeOk'] ?? 'הסר',
          onConfirm: () => { removeItem(storeSlug, cartKey); renderCart(); },
        },
      }));
    }

    /** The subtotal of one store's TICKED lines — what a coupon is measured against, and the same
     *  figure `updateSelectionUI` builds the total from. Read fresh at the moment a code is
     *  applied rather than cached, because a quantity can move between opening the field and
     *  pressing "הפעלה". */
    function selectedSubtotal(storeSlug: string): number {
      const cart = getOrderedCarts().find(c => c.storeSlug === storeSlug);
      if (!cart) return 0;
      return cart.items.reduce((sum, item) =>
        selected.has(selKey(storeSlug, item.cartKey)) ? sum + item.price * item.qty : sum, 0);
    }

    // Delegated over the whole cart, like the checkboxes below and for the same reason: the store
    // blocks are rebuilt on every render, so a per-element listener would have to be re-attached
    // each time and would silently stop working the first time somebody forgot.
    document.getElementById('cart-content')?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const toggle = target.closest<HTMLElement>('.co-coupon__toggle');
      if (toggle) {
        const row = toggle.closest<HTMLElement>('.co-coupon');
        if (row) openCouponPanel(row);
        return;
      }

      const removeBtn = target.closest<HTMLElement>('.co-coupon__remove');
      if (removeBtn) {
        clearCoupon(removeBtn.dataset['storeSlug'] ?? '');
        renderCart();
        return;
      }

      const applyBtn = target.closest<HTMLButtonElement>('.co-coupon__apply');
      if (applyBtn) { void applyFromRow(applyBtn.dataset['storeSlug'] ?? ''); }
    });

    // Enter inside the code field applies it. The field is NOT inside the checkout <form> (it sits
    // in the cart list above it), so nothing would otherwise happen — and a buyer pressing Enter on
    // a code and getting silence reads it as the code being rejected.
    document.getElementById('cart-content')?.addEventListener('keydown', (e) => {
      const input = (e.target as HTMLElement).closest<HTMLInputElement>('.co-coupon__input');
      if (!input || (e as KeyboardEvent).key !== 'Enter') return;
      e.preventDefault();
      void applyFromRow(input.dataset['storeSlug'] ?? '');
    });

    async function applyFromRow(storeSlug: string): Promise<void> {
      const row = document.querySelector<HTMLElement>(`.co-coupon[data-store-slug="${CSS.escape(storeSlug)}"]`);
      const input = row?.querySelector<HTMLInputElement>('.co-coupon__input');
      const msg = row?.querySelector<HTMLElement>('.co-coupon__msg');
      const code = input?.value.trim() ?? '';
      if (!code || !row) return;
      const btn = row.querySelector<HTMLButtonElement>('.co-coupon__apply');
      if (btn) btn.disabled = true;
      const result = await applyCouponCode(storeSlug, code, selectedSubtotal(storeSlug), couponStrings(), formatPrice);
      if (btn) btn.disabled = false;
      if (result.ok) {
        // Redrawn rather than patched: the row becomes the applied chip, and the total, the
        // per-store saving and the footer all move together in one paint.
        renderCart();
        return;
      }
      if (msg) { msg.textContent = result.message; msg.classList.remove('hidden'); }
      input?.focus();
    }

    // Delegated (not re-attached per render) — item + per-store "select all" checkboxes
    document.getElementById('cart-content')?.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== 'checkbox') return;

      const storeSlug = input.dataset['storeSlug'] ?? '';

      if (input.closest('.co-select-all-check')) {
        const checked = input.checked;
        document.querySelectorAll<HTMLInputElement>('.co-item-check input').forEach(itemInput => {
          const ss = itemInput.dataset['storeSlug'] ?? '';
          const ck = itemInput.dataset['cartKey'] ?? '';
          if (checked) selected.add(selKey(ss, ck));
          else selected.delete(selKey(ss, ck));
          itemInput.checked = checked;
          itemInput.closest('.co-card')?.toggleAttribute('data-unselected', !checked);
        });
      } else if (input.closest('.co-store-check')) {
        const checked = input.checked;
        const block = input.closest<HTMLElement>('.co-store-block');
        block?.querySelectorAll<HTMLInputElement>('.co-item-check input').forEach(itemInput => {
          const cartKey = itemInput.dataset['cartKey'] ?? '';
          if (checked) selected.add(selKey(storeSlug, cartKey));
          else selected.delete(selKey(storeSlug, cartKey));
          itemInput.checked = checked;
          itemInput.closest('.co-card')?.toggleAttribute('data-unselected', !checked);
        });
      } else if (input.closest('.co-item-check')) {
        const cartKey = input.dataset['cartKey'] ?? '';
        const key = selKey(storeSlug, cartKey);
        if (input.checked) selected.add(key);
        else selected.delete(key);
        input.closest('.co-card')?.toggleAttribute('data-unselected', !input.checked);
      } else {
        return;
      }

      updateSelectionUI();
    });

    // Delivery-method dropdown change (the upgraded <select> re-fires a bubbling
    // `change` on the hidden native element) → re-price + refresh totals/address.
    document.getElementById('cart-content')?.addEventListener('change', (e) => {
      const sel = e.target as HTMLElement;
      if (!(sel instanceof HTMLSelectElement) || !sel.classList.contains('co-method-select')) return;
      chosenMethod[sel.dataset['storeSlug'] ?? ''] = sel.value;
      updateSelectionUI();
    });

    // ── Payment accordion ──────────────────────────────────
    const toPaymentBtn   = document.getElementById('to-payment-btn');
    const paymentSection = document.getElementById('payment-section');

    toPaymentBtn?.addEventListener('click', () => {
      const isOpen = paymentSection?.hasAttribute('data-open');
      if (isOpen) {
        paymentSection?.removeAttribute('data-open');
        paymentSection?.setAttribute('aria-hidden', 'true');
        toPaymentBtn.setAttribute('aria-expanded', 'false');
      } else {
        paymentSection?.setAttribute('data-open', '');
        paymentSection?.setAttribute('aria-hidden', 'false');
        toPaymentBtn.setAttribute('aria-expanded', 'true');
        // Anchored to the BUTTON's bottom, not the section's top: landing the section top at the
        // header line left the button's last few pixels peeking out above it (user-reported). Its
        // own mb-2 plus the heading's mt-1 are the breathing room, so no extra margin. The button's
        // position is stable while the section expands below it — no need to wait out the 420ms
        // max-height transition.
        scrollBelowPinnedChrome(toPaymentBtn, 0, 'bottom');
      }
    });

    // ── Validation ─────────────────────────────────────────
    function setFieldErr(field: string, show: boolean): void {
      document.querySelector<HTMLElement>(`[data-err="${field}"]`)?.classList.toggle('hidden', !show);
      (document.getElementById(field) as HTMLInputElement | null)?.setAttribute('aria-invalid', show ? 'true' : 'false');
    }

    function validate(): boolean {
      const name   = (document.getElementById('buyerName')  as HTMLInputElement | null)?.value.trim() ?? '';
      const email  = (document.getElementById('buyerEmail') as HTMLInputElement | null)?.value.trim() ?? '';
      const phone  = (document.getElementById('buyerPhone') as HTMLInputElement | null)?.value.trim() ?? '';
      const city   = (document.getElementById('city')       as HTMLInputElement | null)?.value.trim() ?? '';
      const street = (document.getElementById('street')     as HTMLInputElement | null)?.value.trim() ?? '';
      const emailOk = isValidEmail(email);
      setFieldErr('buyerName',  !name);
      setFieldErr('buyerEmail', !email || !emailOk);
      setFieldErr('buyerPhone', !phone);
      setFieldErr('city',       !city);
      setFieldErr('street',     !street);
      return !!(name && email && emailOk && phone && city && street);
    }

    // ── Stock ran out under the buyer ──────────────────────
    // The item was in stock when this page loaded and someone else bought the last units while
    // the buyer filled in the form. /api/checkout refuses it (409) and sends back which line and
    // how many are really left, so this is the one rejection that can be CORRECTED in place
    // instead of reported: without the correction, "try again" walks the buyer into the identical
    // refusal forever, with nothing on screen saying which of their items caused it.
    interface OutOfStockDetail {
      storeSlug: string;
      productSlug: string;
      productName: string;
      available: number;
      selectedVariants?: Record<string, string>;
    }

    // Marks the line on the card itself — the notice above the pay button says what happened,
    // this says which item. Applied imperatively rather than from renderCart(): the mark belongs
    // to one failed attempt, so the next re-render is meant to clear it.
    function markStockLine(storeSlug: string, cartKey: string, available: number): void {
      const card = document.querySelector<HTMLElement>(
        `.co-card[data-store-slug="${CSS.escape(storeSlug)}"][data-cart-key="${CSS.escape(cartKey)}"]`);
      if (!card) return;
      card.classList.add('![border-color:var(--color-danger)]');
      // A sold-out line is left unticked, and `data-unselected`'s 50% opacity would fade the very
      // note it now needs to be read for. The danger border and the note carry that state better
      // than dimming does, so the dimming is overridden for this one card.
      if (available <= 0) card.classList.add('!opacity-100');
      const note = document.createElement('p');
      note.className = 'co-card__stock-note text-[.775rem] font-semibold [color:var(--color-danger)] mt-[.2rem]';
      note.setAttribute('role', 'status');
      // Hebrew has its own singular, and this note lands on a card the buyer is reading while
      // deciding whether to pay — "נותרו 1 במלאי" is exactly where machine-written copy shows.
      note.textContent = available <= 0
        ? (i18n['outOfStockNote'] ?? 'אזל מהמלאי')
        : available === 1
          ? (i18n['stockLeftNoteOne'] ?? 'נותרה יחידה אחת')
          : (i18n['stockLeftNote'] ?? 'נותרו {n} במלאי').replace('{n}', String(available));
      card.querySelector('.co-card__name')?.insertAdjacentElement('afterend', note);
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // One sentence for both routes into this state — the pay-time refusal and the re-check that
    // catches it earlier — so the buyer reads the same explanation whichever one found it.
    function stockMessage(productName: string, available: number): string {
      if (available <= 0) {
        return (i18n['soldOutDuringCheckout'] ?? 'המוצר אזל מהמלאי. הוצאנו אותו מהתשלום.')
          .replace('{name}', productName);
      }
      const reduced = available === 1
        ? (i18n['stockReducedDuringCheckoutOne'] ?? 'נותרה יחידה אחת בלבד. הכמות בעגלה עודכנה.')
        : (i18n['stockReducedDuringCheckout'] ?? 'הכמות בעגלה עודכנה לפי המלאי. בדקו ולחצו שוב.');
      return reduced.replace('{n}', String(available)).replace('{name}', productName);
    }

    // Shown in the warning line above the pay button, never in the error line: nothing failed and
    // the buyer did nothing wrong — the cart was corrected and the rest of the order still stands.
    function showStockNotice(text: string): void {
      const el = document.getElementById('co-price-notice');
      if (!el) return;
      el.textContent = text;
      el.classList.remove('hidden');
    }

    // Brings the cart down to what the server says is really there, and returns the sentence to
    // show. A sold-out line stays in the cart but leaves the payment — the buyer has to see which
    // item stopped them, and everything else they picked should still go through on the next press.
    function applyOutOfStock(oos: OutOfStockDetail): string {
      const cartKey = makeCartKey(oos.productSlug, oos.selectedVariants);
      const available = applyStockLimit(oos.storeSlug, cartKey, oos.available);
      if (available <= 0) selected.delete(selKey(oos.storeSlug, cartKey));
      renderCart(); // redraws the clamped quantity + the new total, and re-enables the button per what is still selected
      markStockLine(oos.storeSlug, cartKey, available);
      return stockMessage(oos.productName, available);
    }

    // The same correction, reached BEFORE the pay button: /api/cart/prices now answers with each
    // line's stock, and cart.ts has already written it and clamped the quantity by the time these
    // changes arrive. So this only has to finish the buyer-facing half — take a sold-out line out
    // of the payment, mark the lines, say what happened. It runs at every moment of attention (page
    // load, returning to the tab, pressing pay), which is what keeps most of these from ever
    // reaching the server's refusal. Returns true when something was corrected.
    function applyStockChanges(changes: ReturnType<typeof stockCorrections>): boolean {
      if (!changes.length) return false;
      for (const c of changes) if (c.soldOut) selected.delete(selKey(c.storeSlug, c.cartKey));
      renderCart();
      for (const c of changes) markStockLine(c.storeSlug, c.cartKey, c.soldOut ? 0 : (c.clampedTo ?? 0));
      // With several corrections at once, the sold-out one is the one that changes what the buyer
      // can do; a reduced quantity is the milder story and is already visible on its own card.
      const lead = changes.find((c) => c.soldOut) ?? changes[0]!;
      showStockNotice(stockMessage(lead.name, lead.soldOut ? 0 : (lead.clampedTo ?? 0)));
      return true;
    }

    // ── Submit ─────────────────────────────────────────────
    document.getElementById('checkout-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;

      const carts = getOrderedCarts();
      const purchased: { storeSlug: string; item: ReturnType<typeof getOrderedCarts>[number]['items'][number] }[] = [];
      carts.forEach(cart => cart.items.forEach(item => {
        if (selected.has(selKey(cart.storeSlug, item.cartKey))) purchased.push({ storeSlug: cart.storeSlug, item });
      }));
      if (!purchased.length) return; // nothing selected — button should already be disabled

      const labelEl   = document.getElementById('submit-label');
      const loadingEl = document.getElementById('submit-loading');
      const errEl     = document.getElementById('form-global-error');
      const priceNoticeEl = document.getElementById('co-price-notice');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

      labelEl?.classList.add('hidden');
      loadingEl?.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = true;
      errEl?.classList.add('hidden');
      priceNoticeEl?.classList.add('hidden');

      // Last look before the money moves. /api/checkout derives the price itself and charges it
      // without complaint, so a summary that went stale while this page sat open would mean a
      // buyer reading one number and being billed another. Forced (`maxAge: 0`) — this is the
      // one moment where a minute-old answer isn't good enough — and it rides inside the button's
      // own "מעבד..." state, with a hard timeout in cart-prices.ts so it can never stall a
      // purchase.
      const moved = await refreshCartPrices({ maxAge: 0 });

      // Stock is checked before price and stops the submit outright: the quantity the buyer chose
      // has just been reduced (or the line is gone), so going ahead would charge them for a
      // different order than the one they pressed pay on — the one outcome that must never be
      // silent. The server would refuse this anyway; catching it here means the buyer gets the
      // explanation without a rejected charge attempt in between.
      const shortages = stockCorrections(moved, (c) => selected.has(selKey(c.storeSlug, c.cartKey)));
      if (shortages.length) {
        labelEl?.classList.remove('hidden');
        loadingEl?.classList.add('hidden');
        applyStockChanges(shortages);
        return;
      }

      // Only a line being paid for RIGHT NOW that got MORE expensive is worth stopping for. A
      // price that dropped goes through untouched — the buyer is charged less than the summary
      // promised, which needs no permission — and so does a change on an item they left
      // unticked. Stopping on any movement at all would spend a real interruption on the common,
      // welcome case; this way the interruption only ever buys the buyer something.
      if (hasIncrease(moved, (c) => selected.has(selKey(c.storeSlug, c.cartKey)))) {
        labelEl?.classList.remove('hidden');
        loadingEl?.classList.add('hidden');
        renderCart(); // shows the new figures and re-enables the button per what is still selected
        priceNoticeEl?.classList.remove('hidden');
        if (priceNoticeEl) priceNoticeEl.textContent = i18n['pricesChanged'] ?? 'המחירים בעגלה התעדכנו. בדקו ולחצו שוב.';
        // The changed total is what they need to re-read, and it sits right above this button.
        document.getElementById('co-footer')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      const items = purchased.map(({ storeSlug, item }) => ({
        storeSlug,
        productSlug: item.slug,
        qty: item.qty,
        ...(item.selectedVariants && Object.keys(item.selectedVariants).length ? { selectedVariants: item.selectedVariants } : {}),
      }));

      // Chosen delivery method per purchased store (server re-validates + re-prices).
      const deliveryMethods: Record<string, string> = {};
      for (const { storeSlug } of purchased) deliveryMethods[storeSlug] = methodFor(storeSlug);

      const body = {
        buyerName:    (document.getElementById('buyerName')  as HTMLInputElement).value.trim(),
        buyerEmail:   (document.getElementById('buyerEmail') as HTMLInputElement).value.trim(),
        buyerPhone:   (document.getElementById('buyerPhone') as HTMLInputElement).value.trim(),
        buyerAddress: {
          city:   (document.getElementById('city')   as HTMLInputElement).value.trim(),
          street: (document.getElementById('street') as HTMLInputElement).value.trim(),
          zip:    (document.getElementById('zip')    as HTMLInputElement).value.trim() || undefined,
        },
        items,
        deliveryMethods,
        // Codes only, and only for the stores actually being paid for. The server re-looks-up each
        // one and recomputes what it takes off — the figure on screen never travels.
        coupons: couponCodesFor(new Set(purchased.map(p => p.storeSlug))),
        idempotencyKey: checkoutAttemptKey(),
      };

      try {
        const res  = await fetch('/api/checkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const data = await res.json() as { orderIds?: string[]; checkoutRef?: string; error?: string; outOfStock?: OutOfStockDetail; coupon?: { storeSlug?: string } };
        // A code that stopped being valid between typing it and pressing pay — it expired, the
        // seller switched it off, or somebody else took the last use of a capped one. Handled
        // exactly like a changed price and for the same reason: the buyer is not at fault, the
        // cart is corrected in front of them, and the button stays live so one more press buys the
        // order at the price now on screen. Charging them the discounted total we could no longer
        // honour, or charging the full one without saying so, are the two outcomes this prevents.
        if (res.status === 409 && data.error === 'coupon-invalid') {
          labelEl?.classList.remove('hidden');
          loadingEl?.classList.add('hidden');
          if (data.coupon?.storeSlug) clearCoupon(data.coupon.storeSlug); else clearAllCoupons();
          renderCart();
          if (priceNoticeEl) {
            priceNoticeEl.textContent = i18n['couponExpired'] ?? 'הקוד כבר לא תקף. הסכום עודכן.';
            priceNoticeEl.classList.remove('hidden');
          }
          if (submitBtn) submitBtn.disabled = false;
          return;
        }
        // Handled here rather than in the catch below because it is the only rejection that
        // carries data to apply, and because it is not an error message: it shows up in the same
        // warning line a changed price uses, with the pay button live, since the cart has just
        // been corrected and one more press buys everything that is still there.
        if (res.status === 409 && data.error === 'out-of-stock' && data.outOfStock) {
          labelEl?.classList.remove('hidden');
          loadingEl?.classList.add('hidden');
          const notice = applyOutOfStock(data.outOfStock);
          if (priceNoticeEl) { priceNoticeEl.textContent = notice; priceNoticeEl.classList.remove('hidden'); }
          return;
        }
        if (!res.ok || !data.orderIds?.length) throw new Error(data.error ?? 'Unknown error');
        // Success — the next purchase is a genuinely new one and must not reuse
        // this key, or it would be replayed as this one.
        clearCheckoutAttemptKey();
        const ref = data.checkoutRef ?? data.orderIds[0]!.slice(0, 8).toUpperCase();
        // Only the purchased items leave the cart — anything the buyer left unchecked stays.
        purchased.forEach(({ storeSlug, item }) => removeItem(storeSlug, item.cartKey));
        window.location.href = `/checkout/success?order=${encodeURIComponent(ref)}`;
      } catch (err) {
        // Two rejections are NOT worth retrying — a showcase store (lib/demo-stores.ts)
        // and a store the buyer himself owns (lib/own-store-guard.ts). The generic "try
        // again" would send them in circles, so each gets its own explanation.
        const msg = (err as Error).message;
        const key = msg === 'demo-store' ? 'demoBlocked'
          : msg === 'own-store' ? 'ownStoreBlocked'
          // The previous submit is still at the gateway. "Try again" is the wrong
          // advice here — pressing again is what we are trying to prevent — so this
          // one asks them to wait instead.
          : msg === 'checkout-in-progress' ? 'checkoutInProgress'
          : 'orderError';
        if (errEl) { errEl.textContent = i18n[key] ?? 'שגיאה. נסה שוב.'; errEl.classList.remove('hidden'); }
        labelEl?.classList.remove('hidden');
        loadingEl?.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // Global ripple — covers all buttons in checkout (qty steppers excluded)
    document.addEventListener('pointerdown', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button, [role="button"]');
      if (btn && !btn.classList.contains('co-qty__btn') && !btn.classList.contains('pqv-trigger') && !btn.classList.contains('co-card__name')) {
        spawnRipple(btn, e.clientX, e.clientY);
      }
    });

    renderCart();

    // A cart can sit for days while the seller starts or ends a sale behind it. Re-price against
    // the catalog and re-render if anything moved, so the summary the buyer reads is the one
    // /api/checkout will charge — a page that displays one price and bills another is the one
    // outcome this whole feature must never produce. Renders first and corrects after: the
    // stored prices are right in the overwhelming majority of visits, and waiting on a network
    // round-trip before showing the cart at all would be a worse trade.
    // A stock shortage the same answer reveals is applied through the shared correction path, so a
    // quantity that came back reduced is explained rather than just quietly redrawn — a number the
    // buyer chose changing under them with no word is worse than the stale one it replaced.
    const reconcile = (changes: Awaited<ReturnType<typeof refreshCartPrices>>): void => {
      if (!changes.length) return;
      if (!applyStockChanges(stockCorrections(changes, (c) => selected.has(selKey(c.storeSlug, c.cartKey))))) renderCart();
    };
    // GA4 `begin_checkout` / Meta `InitiateCheckout` — the third-party half of the stage the
    // middleware already counted server-side for our own funnel (lib/tracking.ts says why both
    // exist). Fired ONCE per page load: the cart re-renders on every tick, quantity change and
    // price correction, and one arrival at checkout is one event — a per-render fire would teach
    // both networks that a shopper who fiddled with quantities is worth five of one who didn't.
    let checkoutStartReported = false;
    function reportCheckoutStart(): void {
      if (checkoutStartReported) return;
      const lines: { id: string; name: string; price: number; qty: number }[] = [];
      // Exactly what the pay button would submit — `selected` never holds a showcase store's items
      // (syncSelection only ever adds payable ones), so the one class of line that can never become
      // an order is already out. Read through the same key so the two can't drift.
      getOrderedCarts().forEach(cart => cart.items.forEach(item => {
        if (!selected.has(selKey(cart.storeSlug, item.cartKey))) return;
        // The id both networks look this item up by is the catalog id, narrowed to the combo the
        // buyer chose (lib/ad-item-id.ts). A line stored before that field existed carries none
        // and is skipped rather than reported under its slug: a slug matches no catalog row and
        // is not even unique across stores, so it would be a wrong id, not a rough one. The
        // re-price this runs after backfills it, so the gap closes by itself.
        if (!item.productId) return;
        lines.push({
          id: adItemId(item.productId, item.selectedVariants),
          name: item.name, price: item.price, qty: item.qty,
        });
      }));
      if (!lines.length) return; // an empty or showcase-only cart started no checkout
      checkoutStartReported = true;
      trackInitiateCheckout(lines);
    }

    // Reported AFTER the re-price settles, not beside the first paint: `value` is the number Meta
    // optimises a campaign against, and the stored prices are what a sale that started or ended
    // while the cart sat would have made stale.
    //
    // The `.catch` sits BETWEEN the two, so the report runs on every outcome — a failed refresh, or
    // a `reconcile` that throws, still leaves a shopper standing at checkout. Chaining the report as
    // the success handler of `.then(reconcile)` instead would have dropped the event on exactly
    // those paths and left the rejection unhandled besides.
    void refreshCartPrices()
      .then(reconcile)
      .catch(() => { /* stale prices still started a real checkout */ })
      .then(reportCheckoutStart);

    // The summary must keep telling the truth for as long as the page is open, not only for the
    // first paint: a shopper who leaves this tab and comes back an hour later would otherwise
    // read the price the sale had when they left. Checks on return, never on a timer. A price move
    // stays silent on purpose — the cart drawer (BaseLayout, so it is on this page too) raises the
    // one toast that explains it, and two announcements of one event is noise — but a stock
    // correction speaks up here, because the drawer says nothing about it.
    watchCartPrices(reconcile);

    // Auto-open payment accordion when arriving via ?pay=1 (from PQV modal)
    if (new URLSearchParams(window.location.search).get('pay') === '1') {
      const paymentSection = document.getElementById('payment-section');
      const toPaymentBtn   = document.getElementById('to-payment-btn') as HTMLButtonElement | null;
      if (paymentSection && !paymentSection.hasAttribute('data-open')) {
        paymentSection.setAttribute('data-open', '');
        paymentSection.setAttribute('aria-hidden', 'false');
        toPaymentBtn?.setAttribute('aria-expanded', 'true');
      }
      // Still delayed here: the cart renders async on this path, so the button's position is not
      // settled at import time. Measured inside the timeout, below the fixed header.
      setTimeout(() => { if (toPaymentBtn) scrollBelowPinnedChrome(toPaymentBtn, 0, 'bottom'); }, 350);
    }
  </script>
</BaseLayout>
