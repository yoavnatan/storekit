---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, getT } from '../i18n/index.js';
import { getAllStores } from '../lib/stores.js';
import { getSellerSession, getSellerById } from '../lib/seller-auth.js';

const lang = getLang(Astro.cookies);
const t = getT(lang);
const c = t.checkout;

const sessionUserId = getSellerSession(Astro.cookies);
const isLoggedIn = !!sessionUserId;
const sessionSeller = sessionUserId ? getSellerById(sessionUserId) : null;
const prefillEmail = sessionSeller?.email ?? '';

const storeShipping: Record<string, { flatRate: number; freeAbove: number | null }> = {};
for (const s of getAllStores()) {
  storeShipping[s.slug] = {
    flatRate: s.shipping?.flatRate ?? 0,
    freeAbove: s.shipping?.freeAbove ?? null,
  };
}
---

<BaseLayout title={c.title} description={c.description} noindex={true} isLoggedIn={isLoggedIn} storeMode={true}>
  <script type="application/json" id="checkout-shipping-cfg" is:inline set:html={JSON.stringify(storeShipping)}></script>
  <script type="application/json" id="checkout-i18n" is:inline set:html={JSON.stringify({
    freeShipping: c.freeShipping,
    shipping: c.shipping,
    storeTotal: c.storeTotal,
    total: c.total,
    item: c.item,
    items: c.items,
    changeShipping: c.changeShipping,
    removeItem: c.removeItem,
    removeTitle: c.removeTitle,
    removeMsg: c.removeMsg,
    removeOk: c.removeOk,
    viewProduct: c.viewProduct,
    requiredField: c.requiredField,
    invalidEmail: c.invalidEmail,
    orderError: c.orderError,
  })}></script>

  <main id="main-content" class="co-page">

    <!-- Empty state -->
    <div id="checkout-empty" class="hidden co-empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="co-empty__icon"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      <p class="co-empty__title">{c.emptyCart}</p>
      <p class="co-empty__desc">{c.emptyCartDesc}</p>
      <a href="/" class="btn btn--accent">{c.backToShopping}</a>
    </div>

    <div id="checkout-main">

      <!-- ── Cart section ── -->
      <section aria-labelledby="cart-heading">
        <h1 id="cart-heading" class="co-heading">{c.yourCart}</h1>

        <!-- Skeleton -->
        <div id="cart-content" aria-live="polite">
          <div class="co-skel-card">
            <div class="skel-bar" style="width:80px;height:80px;border-radius:10px;flex-shrink:0"></div>
            <div style="flex:1;display:flex;flex-direction:column;gap:.5rem;padding-top:.25rem">
              <div class="skel-bar" style="height:15px;width:55%"></div>
              <div class="skel-bar" style="height:13px;width:35%"></div>
              <div class="skel-bar" style="height:30px;width:96px;border-radius:6px;margin-top:.25rem"></div>
            </div>
            <div class="skel-bar" style="width:56px;height:22px;border-radius:4px;flex-shrink:0;align-self:center"></div>
          </div>
          <div class="co-skel-card" style="opacity:.55">
            <div class="skel-bar" style="width:80px;height:80px;border-radius:10px;flex-shrink:0"></div>
            <div style="flex:1;display:flex;flex-direction:column;gap:.5rem;padding-top:.25rem">
              <div class="skel-bar" style="height:15px;width:70%"></div>
              <div class="skel-bar" style="height:13px;width:40%"></div>
            </div>
            <div class="skel-bar" style="width:56px;height:22px;border-radius:4px;flex-shrink:0;align-self:center"></div>
          </div>
        </div>

        <!-- Grand total + CTA (revealed after render) -->
        <div id="co-footer" class="hidden">
          <div class="co-total-row">
            <span class="co-total-label">{c.total}</span>
            <strong class="co-total-amount" id="grand-total-amount"></strong>
          </div>
          <button id="to-payment-btn" class="btn btn--accent co-cta-btn" type="button"
            aria-expanded="false" aria-controls="payment-section">
            <span>{c.toPayment}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              aria-hidden="true" class="co-cta-arrow"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </section>

      <!-- ── Payment accordion ── -->
      <section id="payment-section" class="co-payment" aria-hidden="true">
        <h2 class="co-heading" style="font-size:1.25rem;margin-top:.25rem">{c.paymentDetails}</h2>

        <form id="checkout-form" novalidate aria-label={c.buyerDetails}>
          <div class="co-form-card" style="margin-bottom:.875rem">
            <h3 class="co-form-card__title">{c.buyerDetails}</h3>
            <div class="co-fields">
              <div>
                <label for="buyerName" class="co-label">{c.fullName} *</label>
                <input type="text" id="buyerName" name="buyerName" required autocomplete="name" class="co-input" />
                <p class="co-err hidden" data-err="buyerName" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="buyerEmail" class="co-label">{c.email} *</label>
                <input type="email" id="buyerEmail" name="buyerEmail" required autocomplete="email" class="co-input" value={prefillEmail} />
                <p class="co-err hidden" data-err="buyerEmail" role="alert">{c.invalidEmail}</p>
              </div>
              <div>
                <label for="buyerPhone" class="co-label">{c.phone} *</label>
                <input type="tel" id="buyerPhone" name="buyerPhone" required autocomplete="tel" inputmode="tel" class="co-input" />
                <p class="co-err hidden" data-err="buyerPhone" role="alert">{c.requiredField}</p>
              </div>
            </div>
          </div>

          <div class="co-form-card" style="margin-bottom:1.25rem">
            <h3 class="co-form-card__title">{c.shippingAddress}</h3>
            <div class="co-fields">
              <div>
                <label for="city" class="co-label">{c.city} *</label>
                <input type="text" id="city" name="city" required autocomplete="address-level2" class="co-input" />
                <p class="co-err hidden" data-err="city" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="street" class="co-label">{c.street} *</label>
                <input type="text" id="street" name="street" required autocomplete="street-address" class="co-input" />
                <p class="co-err hidden" data-err="street" role="alert">{c.requiredField}</p>
              </div>
              <div>
                <label for="zip" class="co-label">{c.zip}</label>
                <input type="text" id="zip" name="zip" autocomplete="postal-code" inputmode="numeric" class="co-input" />
              </div>
            </div>
          </div>

          <p id="form-global-error" class="hidden co-global-err" role="alert"></p>

          <button type="submit" id="submit-btn" class="btn btn--accent co-cta-btn">
            <span id="submit-label">{c.placeOrder}</span>
            <span id="submit-loading" class="hidden" aria-live="polite">{c.processing}</span>
          </button>
        </form>
      </section>

    </div>
  </main>

  <!-- PQV and lightbox dialogs are rendered globally via ProductQuickView in BaseLayout -->

  <style is:global>
    .co-page {
      max-width: 640px;
      margin-inline: auto;
      padding: 1.75rem 1rem 4rem;
    }

    /* heading */
    .co-heading {
      font-size: clamp(1.3rem,3vw,1.6rem);
      font-weight: 700;
      color: var(--color-text);
      margin-bottom: 1.25rem;
    }

    /* empty */
    .co-empty { text-align:center; padding-block:4rem; }
    .co-empty__icon { color:var(--color-muted); margin-inline:auto; display:block; margin-bottom:1rem; }
    .co-empty__title { font-size:1.1rem; font-weight:600; color:var(--color-text); margin-bottom:.5rem; }
    .co-empty__desc { color:var(--color-muted); margin-bottom:1.5rem; }

    /* ── skeleton ── */
    .co-skel-card {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      background: #fff;
      border-radius: 14px;
      padding: 1rem;
      margin-bottom: .75rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.07), 0 0 0 1px var(--color-border);
    }

    /* ── store label ── */
    .co-store-label {
      display: inline-block;
      font-size: .75rem;
      font-weight: 700;
      color: var(--color-muted);
      letter-spacing: .06em;
      text-transform: uppercase;
      margin: 1.25rem 0 .625rem;
      text-decoration: none;
      transition: color 140ms;
    }
    .co-store-label:first-child { margin-top: 0; }
    .co-store-label:hover { text-decoration: underline; }

    /* ── item card ── */
    .co-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: #fff;
      border-radius: 14px;
      padding: 1rem;
      margin-bottom: .75rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.07), 0 0 0 1px var(--color-border);
      transition: box-shadow 150ms;
    }
    .co-card:hover {
      box-shadow: 0 3px 10px rgba(0,0,0,.1), 0 0 0 1px var(--color-border);
    }

    /* image */
    .co-card__img-link {
      flex-shrink: 0;
      display: block;
      width: 80px;
      height: 80px;
      border-radius: 10px;
      overflow: hidden;
      background: var(--color-border);
      transition: opacity 140ms;
      border: none;
      padding: 0;
      cursor: pointer;
    }
    .co-card__img-link:hover { opacity: .85; }
    .co-card__img {
      width: 80px; height: 80px;
      object-fit: cover; display: block;
    }
    .co-card__img-placeholder {
      width: 80px; height: 80px;
      display: flex; align-items: center; justify-content: center;
      color: var(--color-muted);
    }

    /* body */
    .co-card__body {
      flex: 1;
      min-width: 0;
    }
    .co-card__name {
      font-size: .9375rem;
      font-weight: 600;
      color: var(--color-text);
      text-decoration: none;
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 140ms;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-family: inherit;
      text-align: inherit;
      width: 100%;
    }
    .co-card__name:hover { color: var(--color-muted); }
    .co-card__variants {
      font-size: .775rem;
      color: var(--color-muted);
      margin-top: .2rem;
    }

    /* bottom row inside body: qty + delete */
    .co-card__row {
      display: flex;
      align-items: center;
      gap: .75rem;
      margin-top: .625rem;
    }

    /* qty stepper */
    .co-qty {
      display: inline-flex;
      align-items: center;
      border: 1.5px solid var(--color-border);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: var(--shadow-inset);
    }
    .co-qty__btn {
      width: 32px; height: 32px;
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--color-text);
      font-size: 1.0625rem;
      display: flex; align-items: center; justify-content: center;
      transition: background 100ms;
      flex-shrink: 0;
    }
    .co-qty__btn:hover { background: #f0f1f3; }
    .co-qty__btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .co-qty__num {
      min-width: 30px;
      text-align: center;
      font-size: .875rem;
      font-weight: 700;
      color: var(--color-text);
      border-inline: 1.5px solid var(--color-border);
      line-height: 32px;
      user-select: none;
    }

    /* delete button */
    .co-delete-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: .8rem;
      color: var(--color-muted);
      padding: .3rem .4rem;
      border-radius: 5px;
      display: flex;
      align-items: center;
      gap: .25rem;
      font-family: inherit;
      transition: color 130ms, background 130ms;
    }
    .co-delete-btn:hover {
      color: var(--color-danger);
      background: color-mix(in srgb, var(--color-danger) 8%, transparent);
    }

    /* price column */
    .co-card__price-col {
      flex-shrink: 0;
      text-align: end;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: .15rem;
    }
    .co-card__total {
      font-size: 1.0625rem;
      font-weight: 800;
      color: var(--color-text);
    }
    .co-card__unit {
      font-size: .72rem;
      color: var(--color-muted);
    }

    /* ── shipping card ── */
    .co-shipping-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fff;
      border-radius: 14px;
      padding: .875rem 1rem;
      margin-bottom: .75rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.07), 0 0 0 1px var(--color-border);
    }
    .co-shipping-card__left {
      display: flex;
      align-items: center;
      gap: .625rem;
      font-size: .9rem;
      font-weight: 500;
      color: var(--color-text);
    }
    .co-shipping-card__icon { color: var(--color-accent); }
    .co-shipping-card__store {
      font-size: .75rem;
      color: var(--color-muted);
      font-weight: 400;
    }
    .co-shipping-change {
      font-size: .75rem;
      color: var(--color-muted);
      background: transparent;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      padding: .2rem .55rem;
      cursor: pointer;
      font-family: inherit;
      transition: color 140ms, border-color 140ms;
    }
    .co-shipping-change:hover { color: var(--color-text); border-color: var(--color-muted); }
    .co-shipping-card__amount {
      font-size: .9375rem;
      font-weight: 700;
      color: var(--color-text);
    }
    .co-shipping-free { color: #16a34a !important; }

    /* ── total row ── */
    .co-total-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 0 1.125rem;
      border-top: 2px solid var(--color-border);
      margin-top: .25rem;
    }
    .co-total-label { font-size: 1rem; font-weight: 500; color: var(--color-text); }
    .co-total-amount { font-size: 1.35rem; font-weight: 800; color: var(--color-text); }

    /* ── CTA button ── */
    .co-cta-btn {
      width: 100%;
      padding: .9rem 1.5rem;
      font-size: 1.0625rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      margin-bottom: .5rem;
    }
    .co-cta-arrow {
      transition: transform 220ms cubic-bezier(0.34,1.56,0.64,1);
    }
    .co-cta-btn[aria-expanded="true"] .co-cta-arrow { transform: rotate(90deg); }
    [dir="rtl"] .co-cta-arrow { transform: scaleX(-1); }
    [dir="rtl"] .co-cta-btn[aria-expanded="true"] .co-cta-arrow { transform: scaleX(-1) rotate(90deg); }

    /* ── payment accordion ── */
    .co-payment {
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transition: max-height 420ms cubic-bezier(.4,0,.2,1), opacity 280ms ease;
    }
    .co-payment.is-open { max-height: 1300px; opacity: 1; }

    /* ── form cards ── */
    .co-form-card {
      background: #fff;
      border-radius: 14px;
      padding: 1.25rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.07), 0 0 0 1px var(--color-border);
    }
    .co-form-card__title {
      font-size: .9375rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 1rem;
    }
    .co-fields { display: grid; gap: .875rem; }
    .co-label {
      display: block;
      font-size: .875rem;
      font-weight: 500;
      margin-bottom: .375rem;
      color: var(--color-text);
    }
    .co-input {
      width: 100%;
      padding: .625rem .75rem;
      border: 1.5px solid var(--color-border);
      border-radius: 8px;
      background: #fafbfc;
      color: var(--color-text);
      font-size: .9375rem;
      font-family: inherit;
      transition: border-color 150ms, background 150ms;
      box-sizing: border-box;
    }
    .co-input:focus { outline: none; border-color: var(--color-accent); background: #fff; }
    .co-input[aria-invalid="true"] { border-color: var(--color-danger); }
    .co-err { font-size: .75rem; color: var(--color-danger); margin-top: .25rem; }
    .co-global-err { font-size: .875rem; color: var(--color-danger); margin-bottom: 1rem; }

  </style>

  <script>
    import { getActiveStoreCarts, setQty, removeItem } from '../lib/cart.js';
    import { formatPrice } from '../config/store.config.js';
    import { spawnRipple } from '../lib/ripple.js';

    const storeFilter = new URLSearchParams(window.location.search).get('store') ?? '';
    function getFilteredCarts() {
      const all = getActiveStoreCarts();
      return storeFilter ? all.filter(c => c.storeSlug === storeFilter) : all;
    }

    const shippingCfg: Record<string, { flatRate: number; freeAbove: number | null }> =
      JSON.parse((document.getElementById('checkout-shipping-cfg') as HTMLElement | null)?.textContent ?? '{}');
    const i18n: Record<string, string> =
      JSON.parse((document.getElementById('checkout-i18n') as HTMLElement | null)?.textContent ?? '{}');

    const esc = (s: unknown) =>
      String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

    function calcShipping(slug: string, subtotal: number): number {
      const cfg = shippingCfg[slug] ?? { flatRate: 0, freeAbove: null };
      return (cfg.freeAbove !== null && subtotal >= cfg.freeAbove) ? 0 : cfg.flatRate;
    }

    function renderCart(): void {
      const carts = getFilteredCarts();
      const contentEl = document.getElementById('cart-content');
      const footerEl  = document.getElementById('co-footer');
      const totalEl   = document.getElementById('grand-total-amount');
      if (!contentEl) return;

      if (!carts.length) {
        document.getElementById('checkout-main')?.classList.add('hidden');
        document.getElementById('checkout-empty')?.classList.remove('hidden');
        return;
      }

      let grandTotal = 0;
      let html = '';

      carts.forEach(cart => {
        const subtotal = cart.items.reduce((s, i) => s + i.price * i.qty, 0);
        const shipping = calcShipping(cart.storeSlug, subtotal);
        grandTotal += subtotal + shipping;

        // Store label
        html += `<a href="/store/${esc(cart.storeSlug)}" class="co-store-label">${esc(cart.storeName)}</a>`;

        // One card per item
        cart.items.forEach(item => {
          const imgHtml = item.image
            ? `<img src="${esc(item.image)}" alt="${esc(item.name)}" class="co-card__img" width="80" height="80" loading="lazy" decoding="async" />`
            : `<div class="co-card__img-placeholder" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                </svg>
               </div>`;
          const variantsHtml = item.selectedVariants && Object.keys(item.selectedVariants).length
            ? `<p class="co-card__variants">${esc(Object.entries(item.selectedVariants).map(([k,v]) => `${k}: ${v}`).join(' · '))}</p>`
            : '';

          html += `<div class="co-card" data-store-slug="${esc(cart.storeSlug)}" data-cart-key="${esc(item.cartKey)}" data-item-name="${esc(item.name)}">
            <button type="button" class="co-card__img-link pqv-trigger"
              data-store-slug="${esc(cart.storeSlug)}" data-product-slug="${esc(item.slug)}" data-store-name="${esc(cart.storeName)}"
              aria-label="${esc(i18n['viewProduct'] ?? '')} ${esc(item.name)}">
              ${imgHtml}
            </button>
            <div class="co-card__body">
              <button type="button" class="co-card__name pqv-trigger"
                data-store-slug="${esc(cart.storeSlug)}" data-product-slug="${esc(item.slug)}" data-store-name="${esc(cart.storeName)}">${esc(item.name)}</button>
              ${variantsHtml}
              <div class="co-card__row">
                <div class="co-qty" dir="ltr" role="group" aria-label="כמות">
                  <button class="co-qty__btn" data-action="dec" aria-label="הפחת כמות" type="button" ${item.qty <= 1 ? 'disabled' : ''}>−</button>
                  <span class="co-qty__num" aria-live="polite">${item.qty}</span>
                  <button class="co-qty__btn" data-action="inc" aria-label="הגדל כמות" type="button" data-stock="${item.stock ?? ''}" ${item.stock != null && item.qty >= item.stock ? 'disabled' : ''}>+</button>
                </div>
                <button class="co-delete-btn" data-action="remove" aria-label="${esc(i18n['removeItem'] ?? 'הסר')}" type="button">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                  ${esc(i18n['removeItem'] ?? 'הסר')}
                </button>
              </div>
            </div>
            <div class="co-card__price-col">
              <span class="co-card__total">${formatPrice(item.price * item.qty)}</span>
              ${item.qty > 1 ? `<span class="co-card__unit">${formatPrice(item.price)} ליח׳</span>` : ''}
            </div>
          </div>`;
        });

        // Shipping card for this store
        const isFree = shipping === 0;
        html += `<div class="co-shipping-card">
          <div class="co-shipping-card__left">
            <svg class="co-shipping-card__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <div>
              <span>${esc(i18n['shipping'] ?? 'משלוח')}</span>
              <span class="co-shipping-card__store"> · ${esc(cart.storeName)}</span>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:.625rem">
            <button class="co-shipping-change" type="button" disabled title="בקרוב">${esc(i18n['changeShipping'] ?? 'שנה')}</button>
            <span class="co-shipping-card__amount ${isFree ? 'co-shipping-free' : ''}">${isFree ? (i18n['freeShipping'] ?? 'חינם') : formatPrice(shipping)}</span>
          </div>
        </div>`;
      });

      contentEl.innerHTML = html;

      if (totalEl) totalEl.textContent = formatPrice(grandTotal);
      footerEl?.classList.remove('hidden');

      attachEvents();
    }

    function patchQty(card: HTMLElement, storeSlug: string, cartKey: string): void {
      const carts   = getActiveStoreCarts();
      const item    = carts.find(c => c.storeSlug === storeSlug)?.items.find(i => i.cartKey === cartKey);
      if (!item) { renderCart(); return; }

      const qtyEl    = card.querySelector<HTMLElement>('.co-qty__num');
      const decBtn   = card.querySelector<HTMLButtonElement>('[data-action="dec"]');
      const incBtn   = card.querySelector<HTMLButtonElement>('[data-action="inc"]');
      const totalEl  = card.querySelector<HTMLElement>('.co-card__total');
      const priceCol = card.querySelector<HTMLElement>('.co-card__price-col');

      if (qtyEl)   qtyEl.textContent   = String(item.qty);
      if (decBtn)  decBtn.disabled      = item.qty <= 1;
      if (incBtn)  incBtn.disabled      = item.stock != null && item.qty >= item.stock;
      if (totalEl) totalEl.textContent  = formatPrice(item.price * item.qty);

      const unitEl = priceCol?.querySelector<HTMLElement>('.co-card__unit');
      if (item.qty > 1) {
        const txt = `${formatPrice(item.price)} ליח׳`;
        if (unitEl) { unitEl.textContent = txt; }
        else {
          const span = document.createElement('span');
          span.className = 'co-card__unit';
          span.textContent = txt;
          priceCol?.appendChild(span);
        }
      } else {
        unitEl?.remove();
      }

      // Update grand total
      let grandTotal = 0;
      carts.forEach(c => {
        const sub = c.items.reduce((s, it) => s + it.price * it.qty, 0);
        grandTotal += sub + calcShipping(c.storeSlug, sub);
      });
      const grandEl = document.getElementById('grand-total-amount');
      if (grandEl) grandEl.textContent = formatPrice(grandTotal);
    }

    function attachEvents(): void {
      document.querySelectorAll<HTMLElement>('.co-card[data-cart-key]').forEach(card => {
        const storeSlug = card.dataset['storeSlug'] ?? '';
        const cartKey   = card.dataset['cartKey'] ?? '';
        const itemName  = card.dataset['itemName'] ?? '';
        const qtyEl     = card.querySelector<HTMLElement>('.co-qty__num');

        card.querySelector<HTMLButtonElement>('[data-action="inc"]')?.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const current = parseInt(qtyEl?.textContent ?? '1', 10);
          const stockLimit = btn.dataset['stock'] ? parseInt(btn.dataset['stock'], 10) : Infinity;
          if (current < stockLimit) {
            setQty(storeSlug, cartKey, current + 1);
            patchQty(card, storeSlug, cartKey);
          }
        });

        card.querySelector<HTMLButtonElement>('[data-action="dec"]')?.addEventListener('click', () => {
          const current = parseInt(qtyEl?.textContent ?? '1', 10);
          if (current <= 1) {
            confirmRemove(storeSlug, cartKey, itemName);
          } else {
            setQty(storeSlug, cartKey, current - 1);
            patchQty(card, storeSlug, cartKey);
          }
        });

        card.querySelector<HTMLButtonElement>('[data-action="remove"]')?.addEventListener('click', () => {
          confirmRemove(storeSlug, cartKey, itemName);
        });
      });
    }

    function confirmRemove(storeSlug: string, cartKey: string, name: string): void {
      window.dispatchEvent(new CustomEvent('confirm:open', {
        detail: {
          title: i18n['removeTitle'] ?? 'הסר מהעגלה?',
          message: `${i18n['removeMsg'] ?? 'הפריט יוסר מהעגלה שלך'}: "${name}"`,
          okLabel: i18n['removeOk'] ?? 'הסר',
          onConfirm: () => { removeItem(storeSlug, cartKey); renderCart(); },
        },
      }));
    }

    // ── Payment accordion ──────────────────────────────────
    const toPaymentBtn   = document.getElementById('to-payment-btn');
    const paymentSection = document.getElementById('payment-section');

    toPaymentBtn?.addEventListener('click', () => {
      const isOpen = paymentSection?.classList.contains('is-open');
      if (isOpen) {
        paymentSection?.classList.remove('is-open');
        paymentSection?.setAttribute('aria-hidden', 'true');
        toPaymentBtn.setAttribute('aria-expanded', 'false');
      } else {
        paymentSection?.classList.add('is-open');
        paymentSection?.setAttribute('aria-hidden', 'false');
        toPaymentBtn.setAttribute('aria-expanded', 'true');
        setTimeout(() => paymentSection?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
      }
    });

    // ── Validation ─────────────────────────────────────────
    function setFieldErr(field: string, show: boolean): void {
      document.querySelector<HTMLElement>(`[data-err="${field}"]`)?.classList.toggle('hidden', !show);
      (document.getElementById(field) as HTMLInputElement | null)?.setAttribute('aria-invalid', show ? 'true' : 'false');
    }

    function validate(): boolean {
      const name   = (document.getElementById('buyerName')  as HTMLInputElement | null)?.value.trim() ?? '';
      const email  = (document.getElementById('buyerEmail') as HTMLInputElement | null)?.value.trim() ?? '';
      const phone  = (document.getElementById('buyerPhone') as HTMLInputElement | null)?.value.trim() ?? '';
      const city   = (document.getElementById('city')       as HTMLInputElement | null)?.value.trim() ?? '';
      const street = (document.getElementById('street')     as HTMLInputElement | null)?.value.trim() ?? '';
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      setFieldErr('buyerName',  !name);
      setFieldErr('buyerEmail', !email || !emailOk);
      setFieldErr('buyerPhone', !phone);
      setFieldErr('city',       !city);
      setFieldErr('street',     !street);
      return !!(name && email && emailOk && phone && city && street);
    }

    // ── Submit ─────────────────────────────────────────────
    document.getElementById('checkout-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;

      const labelEl   = document.getElementById('submit-label');
      const loadingEl = document.getElementById('submit-loading');
      const errEl     = document.getElementById('form-global-error');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

      labelEl?.classList.add('hidden');
      loadingEl?.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = true;
      errEl?.classList.add('hidden');

      const carts = getFilteredCarts();
      const items = carts.flatMap(cart =>
        cart.items.map(item => ({
          storeSlug: cart.storeSlug,
          productSlug: item.slug,
          qty: item.qty,
          ...(item.selectedVariants && Object.keys(item.selectedVariants).length ? { selectedVariants: item.selectedVariants } : {}),
        }))
      );

      const body = {
        buyerName:    (document.getElementById('buyerName')  as HTMLInputElement).value.trim(),
        buyerEmail:   (document.getElementById('buyerEmail') as HTMLInputElement).value.trim(),
        buyerPhone:   (document.getElementById('buyerPhone') as HTMLInputElement).value.trim(),
        buyerAddress: {
          city:   (document.getElementById('city')   as HTMLInputElement).value.trim(),
          street: (document.getElementById('street') as HTMLInputElement).value.trim(),
          zip:    (document.getElementById('zip')    as HTMLInputElement).value.trim() || undefined,
        },
        items,
      };

      try {
        const res  = await fetch('/api/checkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const data = await res.json() as { orderIds?: string[]; checkoutRef?: string; error?: string };
        if (!res.ok || !data.orderIds?.length) throw new Error(data.error ?? 'Unknown error');
        const ref = data.checkoutRef ?? data.orderIds[0]!.slice(0, 8).toUpperCase();
        window.location.href = `/checkout/success?order=${encodeURIComponent(ref)}`;
      } catch {
        if (errEl) { errEl.textContent = i18n['orderError'] ?? 'שגיאה. נסה שוב.'; errEl.classList.remove('hidden'); }
        labelEl?.classList.remove('hidden');
        loadingEl?.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // Global ripple — covers all buttons in checkout (qty steppers excluded)
    document.addEventListener('pointerdown', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button, [role="button"]');
      if (btn && !btn.classList.contains('co-qty__btn') && !btn.classList.contains('pqv-trigger') && !btn.classList.contains('co-card__name')) {
        spawnRipple(btn, e.clientX, e.clientY);
      }
    });

    renderCart();

    // Auto-open payment accordion when arriving via ?pay=1 (from PQV modal)
    if (new URLSearchParams(window.location.search).get('pay') === '1') {
      const paymentSection = document.getElementById('payment-section');
      const toPaymentBtn   = document.getElementById('to-payment-btn') as HTMLButtonElement | null;
      if (paymentSection && !paymentSection.classList.contains('is-open')) {
        paymentSection.classList.add('is-open');
        paymentSection.setAttribute('aria-hidden', 'false');
        toPaymentBtn?.setAttribute('aria-expanded', 'true');
      }
      setTimeout(() => toPaymentBtn?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 350);
    }
  </script>
</BaseLayout>
