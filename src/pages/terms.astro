---
/** Terms of use — the second page the footer has always linked to and that never existed.
 *
 *  See `contact.astro` for why a 404 here is an ACCOUNT-level risk and not a broken link: Merchant
 *  Center's "misrepresentation" suspension is written around a shop that does not publish who it is
 *  and on what terms it sells, and one suspension takes every seller's ads down together.
 *
 *  **What this page may say.** Only what the code and the owner's recorded decisions already
 *  establish: that this is a marketplace of independent businesses, how an order is formed, who
 *  ships, how a seller is billed, and how to reach a human. It states no returns window and no
 *  refund term — that decision is open (CURRENT_TASK §ג item 11), and inventing one here would
 *  publish a promise to every buyer that the product's own structured data deliberately refuses to
 *  guess. When the owner sets it, this page and `hasMerchantReturnPolicy` take the SAME number.
 *
 *  **The collection clause under "הזמנה ותשלום" is load-bearing, not boilerplate — and what makes
 *  it load-bearing INVERTED on 2026-08-21.** It used to say the platform collects the buyer's
 *  payment as the seller's agent and holds the balance for him, because that is what the code did;
 *  the sentence about the buyer's payment discharging their debt was what made it an agency rather
 *  than us receiving money on our own account. Under the split model the money never reaches us —
 *  a licensed processor captures it into the seller's own account and passes us our commission —
 *  so the clause now says exactly that, and its counterpart under "פתיחת חנות" says it from the
 *  seller's side. Neither may be reworded without the other, and neither may imply we hold funds.
 *
 *  The fulfilment deadlines are interpolated from `lib/order-sla.ts` — the same constants the
 *  sweep enforces — and are ⚠️ PLACEHOLDERS pending the owner's decision.
 *
 *  **The supply deadline is stated here because stating it is the legal duty.** Israeli law
 *  requires a distance seller to DISCLOSE the supply date and method (§14ג) and — checked
 *  2026-08-10 — sets no general maximum; so the exposure is an undisclosed supply time, not a slow
 *  one. The clause also says the courier's own delay does not count against the seller, which is
 *  the fairness rule `order-sla.ts` implements rather than a courtesy.
 *
 *  ⚠️ NOT a substitute for legal review before launch. It is accurate, not lawyered — and the
 *  agency clauses above are exactly what `docs/legal-brief-agent-model.md` puts in front of the עו״ד.
 *
 *  Hebrew, in both UI languages, with the Hebrew stated as binding — the standard for an Israeli
 *  consumer site, and more honest than a machine translation that would then contradict it.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getSellerSession } from '../lib/seller-auth.js';
import { getStoresBySellerId } from '../lib/stores.js';
import { getLang } from '../i18n/index.js';
import { store as platform } from '../config/store.config.js';
// Interpolated rather than restated. A deadline written as a digit in a legal clause AND separately
// in the code that enforces it is a number that will eventually disagree with itself, and the copy a
// seller can hold us to is this one. `tests/fulfilment-deadlines.test.ts` pins that these clauses
// carry no bare number of their own.
//
// The payout constants that used to be interpolated here — a hold, a weekly transfer day, a minimum
// balance — are gone with the model that had them: no money of a seller's reaches this platform, so
// there is no schedule of ours to promise him (GO_LIVE §3.1.0).
import { SHIP_DEADLINE_BUSINESS_DAYS, SHIP_AUTO_CANCEL_DAYS } from '../lib/order-sla.js';

const lang = getLang(Astro.cookies);
const sellerId = getSellerSession(Astro.cookies);
const isLoggedIn = !!sellerId;
const hasStore = sellerId ? (await getStoresBySellerId(sellerId)).length > 0 : false;

const title = lang === 'he' ? 'תנאי שימוש' : 'Terms of use';
const email = platform.business.email;

/** Every clause, in the one language that binds. Kept as data so the markup stays one loop and a
 *  new clause is one entry — the shape a page nobody visits often still has to stay editable in. */
const clauses: { h: string; p: string[] }[] = [
  {
    h: 'מה זו הפלטפורמה',
    p: [
      `${platform.name} היא זירת מסחר מקוונת. כל חנות באתר מנוהלת בידי עסק עצמאי, שהוא המוכר בפועל ואחראי למוצריו, לתיאוריהם, למחיריהם, לאספקתם ולשירות הלקוחות שלהם. ${platform.name} מפעילה את הפלטפורמה, את הסליקה ואת תשתית המשלוחים, ואינה צד לעסקה שבין הקונה למוכר.`,
    ],
  },
  {
    h: 'הזמנה ותשלום',
    p: [
      'ההזמנה נוצרת עם השלמת התשלום בעמוד הצ׳ק-אאוט. המחיר הקובע הוא המחיר המוצג בעמוד המוצר במועד ההזמנה, כולל מבצע שפעיל אז, ובשקלים חדשים.',
      'סל אחד יכול לכלול מוצרים מכמה חנויות. התשלום נגבה בחיוב אחד, ונוצרת הזמנה נפרדת מול כל מוכר — כל אחת מהן נשלחת ומטופלת בנפרד.',
      // The sentence the entire legal position rests on: we collect AS THE SELLER'S AGENT, and the
      // buyer's payment to us discharges their debt to the seller at that instant. Without it the
      // arrangement reads as us receiving funds on our own account and forwarding them later, which
      // is the shape that looks like a payment service. It is stated to the BUYER because the buyer
      // is the one whose debt is being discharged; the seller's side of the same fact is in
      // "פתיחת חנות" below. Both must move together if either is ever reworded.
      `התשלום נגבה מהקונה על ידי חברת סליקה מורשית, ומועבר על ידה לחשבונו של המוכר. ${platform.name} אינה מחזיקה את כספי הקונה בשום שלב, ועמלתה נגבית בתוך אותה עסקה. חוב הקונה למוכר בגין ההזמנה נפרע במועד החיוב. הקונה אינו נושא בסיכון כלשהו הנובע מהיחסים שבין ${platform.name} למוכר או לחברת הסליקה.`,
      'זמינות נבדקת מול המלאי בעת התשלום. אם פריט אזל בין הוספתו לסל לבין התשלום, ההזמנה לא תושלם עליו והתשלום עבורו לא ייגבה.',
      // The platform does NOT issue this document and must not promise that it does. Issuing in
      // another business's name binds the document to THAT business's tax file, and the owner's rule
      // (2026-08-13) is that we invoice only revenue that is ours. What we provide is the place to
      // put it: the seller uploads it per order and we mail it on, or he hands it over with the goods.
      `חשבונית המס על ההזמנה מונפקת בידי המוכר, שהוא המוכר בעסקה. ${platform.name} שולחת לקונה אישור הזמנה על התשלום שנגבה, ואת החשבונית מוסר המוכר — במייל דרך האתר, או יחד עם ההזמנה עצמה.`,
    ],
  },
  {
    h: 'משלוחים',
    p: [
      'דמי המשלוח נקבעים בידי הפלטפורמה ומוצגים בצ׳ק-אאוט לפני התשלום. מוכר יכול להציע איסוף עצמי כחלופה.',
      `המוכר נדרש למסור את ההזמנה לחברת השילוח — או להעמידה לאיסוף — בתוך ${SHIP_DEADLINE_BUSINESS_DAYS} ימי עסקים ממועד ההזמנה. זמן ההגעה עצמו תלוי בחברת השילוח וביעד.`,
      `לא נמסרה ההזמנה בתוך ${SHIP_AUTO_CANCEL_DAYS} ימים ממועד התשלום, היא תבוטל אוטומטית והתמורה תוחזר לקונה במלואה, ללא דמי ביטול.`,
    ],
  },
  {
    h: 'ביטול והחזרות',
    p: [
      'זכות הביטול הקבועה בחוק הגנת הצרכן ובתקנותיו חלה על רכישה באתר, ואינה ניתנת להתניה. פנייה בעניין ביטול או החזרה מופנית תחילה למוכר, דרך כפתור יצירת הקשר בעמוד החנות.',
    ],
  },
  {
    h: 'פתיחת חנות',
    p: [
      'פתיחת חנות פתוחה לעסק פעיל. המוכר אחראי לכך שהמוצרים שהוא מפרסם מותרים למכירה, שהתכנים והתמונות שהעלה הם שלו או שיש לו רשות להשתמש בהם, ושהפרטים שמסר נכונים.',
      'התשלום לפלטפורמה הוא לפי המסלול שהמוכר בחר — דמי מנוי חודשיים ועמלה מכל מכירה, כפי שהם מוצגים בעמוד המסלולים בעת ההצטרפות ובאזור האישי.',
      `התמורה מכל מכירה נגבית לחשבון המוכר אצל חברת הסליקה. עמלת המכירה של ${platform.name} נגבית בתוך אותה עסקה ומועברת אליה על ידי חברת הסליקה. ${platform.name} אינה מחזיקה כספים של המוכר בשום שלב.`,
      'מועדי הזיכוי לחשבון הבנק של המוכר, וכן עמלות הסליקה עצמן, נקבעים בהסכם שבין המוכר לחברת הסליקה ואינם בשליטת הפלטפורמה.',
      'זיכוי, ביטול או חיוב-חוזר מבוצעים כנגד אותה עסקה שבה שולם, ומקוזזים מתנועות המוכר אצל חברת הסליקה. אין בכך כדי לגרוע מאחריות המוכר לעסקה מול הקונה.',
      'מכירה מותנית בפתיחת חשבון סליקה למוכר, ולשם כך במסירת פרטי חשבון בנק ופרטי עסק תקינים באזור האישי. חברת הסליקה בוחנת כל מוכר ורשאית שלא לאשרו.',
      // The seller's half of the same fact as the "הזמנה ותשלום" section — both move together.
      `${platform.name} מוציאה למוכר חשבונית מס על עמלת המכירה, דמי המנוי והפרסום. הנפקת חשבונית מס לקונה ומסירתה לו הן באחריות המוכר בלבד, וכך גם הדיווח לרשויות המס בגין מכירותיו. ${platform.name} מעמידה לו בכל הזמנה מקום להעלות את החשבונית ולשלוח אותה לקונה, או לסמן שנמסרה עם ההזמנה.`,
      `על המוכר למסור את ההזמנה לשילוח, או להעמידה לאיסוף, בתוך ${SHIP_DEADLINE_BUSINESS_DAYS} ימי עסקים. הזמנה שלא טופלה בתוך ${SHIP_AUTO_CANCEL_DAYS} ימים תבוטל והתמורה תוחזר לקונה. עיכוב שמקורו בחברת השילוח לאחר מסירת ההזמנה אינו באחריות המוכר ואינו נספר במניין הימים.`,
      'מוכר יכול להשהות או לסגור את חנותו בכל עת. סגירה נכנסת לתוקף לאחר טיפול בהזמנות הפתוחות.',
    ],
  },
  {
    h: 'פרסום',
    p: [
      `קידום מוצר או חנות ("בוסט") רץ בחשבונות הפרסום של ${platform.name} בגוגל ובמטא. התקציב שהמוכר מגדיר הוא תקרה, והחיוב הוא לפי ההוצאה בפועל בלבד.`,
    ],
  },
  {
    h: 'תוכן ושימוש לרעה',
    p: [
      `${platform.name} רשאית להסיר מוצר או להשעות חנות שמפרים דין, זכויות של צד שלישי או את התנאים האלה. חשד לתוכן מפר אפשר לדווח לכתובת שבעמוד יצירת הקשר.`,
    ],
  },
  {
    // This clause is now a SUMMARY with a pointer, not the policy. It was the whole of the site's
    // privacy documentation until 2026-08-25, which was one paragraph where תיקון 13 (in force
    // 2025-08-14) requires a document — see `/privacy`. It stays because a reader of the terms
    // should not have to already know the other page exists, and it must never grow back into a
    // second, competing statement: anything new about personal data belongs on `/privacy` alone.
    h: 'פרטיות',
    p: [
      'הפרטים שנמסרים בהרשמה ובהזמנה משמשים להפעלת האתר, לביצוע ההזמנה ולשירות הלקוחות. פרטי הקונה הדרושים לאספקה נמסרים למוכר שאצלו בוצעה ההזמנה. פרטי אמצעי התשלום מעובדים אצל חברת הסליקה ואינם נשמרים באתר.',
      'הפירוט המלא — איזה מידע נאסף, למי הוא נמסר, כמה זמן הוא נשמר וכיצד מממשים זכות עיון, תיקון או מחיקה — נמצא במדיניות הפרטיות.',
    ],
  },
  {
    h: 'שינוי התנאים ויצירת קשר',
    p: [
      `התנאים עשויים להתעדכן; הנוסח המחייב הוא זה המפורסם בעמוד זה. לכל שאלה: ${email}.`,
    ],
  },
];
---

<BaseLayout
  title={`${title} — ${platform.name}`}
  description={lang === 'he'
    ? `תנאי השימוש של ${platform.name} — זירת מסחר של עסקים עצמאיים.`
    : `${platform.name} terms of use — a marketplace of independent businesses.`}
  isLoggedIn={isLoggedIn}
  hasStore={hasStore}
  storeMode={true}
  showSearch={true}
>
  <section class="section container" dir="rtl" style="max-width:70ch">
    <h1 class="!text-[1.6rem] !font-semibold">תנאי שימוש</h1>
    {lang !== 'he' && (
      <p class="muted" style="margin-top:0.75rem">These terms are published in Hebrew, which is the binding version.</p>
    )}

    {clauses.map((c) => (
      <>
        <h2 class="!text-[1.05rem] !font-semibold" style="margin-top:1.75rem">{c.h}</h2>
        {c.p.map((line) => <p style="margin-top:0.5rem">{line}</p>)}
      </>
    ))}

    <p style="margin-top:2rem">
      <a href="/privacy" class="muted">מדיניות פרטיות</a>
      <span class="muted" aria-hidden="true"> · </span>
      <a href="/accessibility" class="muted">הצהרת נגישות</a>
      <span class="muted" aria-hidden="true"> · </span>
      <a href="/contact" class="muted">יצירת קשר</a>
    </p>
  </section>
</BaseLayout>
