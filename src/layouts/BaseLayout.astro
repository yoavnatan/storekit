---
import { store } from '../config/store.config.js';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

import '../styles/main.css';

const { title, description, image, type, noindex, jsonLd, storeColors } = Astro.props;

function safeHex(v) {
  return typeof v === 'string' && /^#[0-9a-fA-F]{6}$/.test(v) ? v : null;
}

let colorOverrideCss = null;
if (storeColors) {
  const p = safeHex(storeColors.primary);
  const a = safeHex(storeColors.accent);
  if (p || a) {
    let css = ':root {';
    if (p) css += ` --color-primary: ${p}; --color-primary-dark: ${p};`;
    if (a) css += ` --color-accent: ${a};`;
    css += ' }';
    colorOverrideCss = css;
  }
}
---

<!doctype html>
<html lang={store.language} dir={store.direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} image={image} type={type} noindex={noindex} jsonLd={jsonLd} />
    {colorOverrideCss && <style set:html={colorOverrideCss} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CartDrawer />
  </body>
</html>
