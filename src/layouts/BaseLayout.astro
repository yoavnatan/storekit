---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import AddToCartPreview from '../components/AddToCartPreview.astro';
import WishlistDrawer from '../components/WishlistDrawer.astro';
import ConfirmModal from '../components/ConfirmModal.astro';
import StickyGlassBoot from '../components/StickyGlassBoot.astro';
import ProductQuickView from '../components/ProductQuickView.astro';
import StoreProductModal from '../components/StoreProductModal.astro';
import ToastContainer from '../components/ToastContainer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import MessageCompose from '../components/MessageCompose.astro';
import { getLang, getDir, getT } from '../i18n/index.js';
import { needsDashboardI18n } from '../lib/i18n-island.js';
import { store as platform } from '../config/store.config.js';
import { jsonForScript } from '../lib/json-script.js';
import { getSellerSession } from '../lib/seller-auth.js';
import { CSRF_META, issueCsrfToken } from '../lib/csrf.js';
import { getUnreadCountForUser } from '../lib/notifications.js';
import { storeIconUrl } from '../lib/store-image.js';
// The tag bootstraps moved OUT of this file (2026-08-25): the browser has to be able to start the
// same snippets the moment a visitor accepts, and a bootstrap copied into a second file is one that
// gets a parameter added in only one of them.
import { gtmHeadScript, metaPixelScript, consentDefaultScript } from '../lib/tag-bootstrap.js';
import { CONSENT_COOKIE, consentModeSignal, mayLoadAdPixel, mayLoadTagManager, parseConsent } from '../lib/consent.js';
import heeboHebrewUrl from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';
import heeboLatinUrl from '@fontsource-variable/heebo/files/heebo-latin-wght-normal.woff2?url';
// Two files, not ten: these are the VARIABLE cuts, one per script, each carrying the whole
// 100–900 range. Same face as the ten static cuts they replace — measured identical on
// ascent, descent and letter height, ink within 0.03% — so this is a payload change and
// nothing else. The logo's Hebrew line is Heebo too (BrandLogo.astro) and is covered here;
// the wordmark itself is paths and needs no font at all.

import '../styles/main.css';

const {
  title, description, image, type, noindex, jsonLd, canonical,
  isLoggedIn, hasStore, storeMode, storeName, storeSlug, storeLogo, storeDemo, storeHeaderLogo, sellerMode, hideNav, showSearch, isHome, dashNav,
  dataLayer, productPrice, productCurrency, preloadImage, noTracking,
} = Astro.props;

const lang = getLang(Astro.cookies);
const dir  = getDir(lang);
const t    = getT(lang);

// Is this page the STORE's, or ours? One answer, read by three things — the tab's icon, the tab's
// text and the shared card's title (Seo.astro) — because a page showing the store's picture beside
// our name in the title is the sovereignty rule half-applied. `storeMode` is NOT this question: it
// is the layout, and thirteen pages of ours ask for it (see the <link> block below).
const storeOwnsThisPage = !!storeSlug && !sellerMode;

// The tab's icon on a shopper-facing store page — see the <link> block below for
// which pages qualify and why. Resolved here rather than inline so the two slots
// are one decision: a page can't end up with the store's favicon and the
// platform's touch icon.
const storeIcon =
  storeOwnsThisPage
    ? {
        favicon: storeIconUrl({ slug: storeSlug, profileImage: storeLogo }, 'favicon'),
        touch: storeIconUrl({ slug: storeSlug, profileImage: storeLogo }, 'touch'),
      }
    : null;
/**
 * `#i18n-data` — the strings client scripts read at runtime, because a script
 * rendered by `innerHTML` has no access to `getT()`.
 *
 * **`dashboard` is the whole file and it only belongs on four routes.** Measured
 * 2026-08-03: the island is ~36.7KB on every page and `t.dashboard` alone is
 * 34.9KB of it — 95%. It was going out with every shopper-facing page (home, store,
 * product, search, /stores, checkout), where nothing has ever read it: every
 * consumer is under `src/scripts/dashboard/` or `src/scripts/admin/`, and those
 * load only on the seller dashboard, the admin panels and the buyer area. It was
 * pure page weight on exactly the pages whose weight is the SEO surface — bigger
 * than the embedded catalog the same audit went looking for.
 *
 * Gated on the PATH rather than a `dashboardI18n` prop deliberately: a prop is one
 * more thing to remember on a new dashboard page, and forgetting it fails silently
 * as English fallback strings appearing in a Hebrew UI. Every consumer already
 * lives under one of these three prefixes and `tests/i18n-island-scope.test.ts`
 * fails the build if a new one appears outside them.
 *
 * The MATCH itself lives in `lib/i18n-island.ts` — it was written inline here as a `'/admin/'`
 * prefix, which the admin dashboard's own `/admin` does not match under `trailingSlash: 'never'`,
 * and the English strings that produced went unnoticed for weeks. Its header carries the case.
 */
const needsDashboardStrings = needsDashboardI18n(Astro.url.pathname);
const i18nJson = jsonForScript({
  cart: t.cart,
  confirm: t.confirm,
  // Ungated, unlike `dashboard` below: forms exist on shopper-facing pages too (message
  // compose, search), it is ten short strings, and a missing slice here degrades to the
  // Hebrew fallbacks baked into lib/field-validity.ts — i.e. silently wrong in English.
  formErrors: t.formErrors,
  // Two strings, and ungated for the same reason: `showActionFailedToast` is the answer on every
  // surface that can fail, shopper-facing ones included.
  common: t.common,
  gallery: t.gallery,
  wishlist: t.wishlist,
  // Gated on `isLoggedIn`, not on a path: the notification bell Header draws is
  // itself gated on exactly that, so the strings travel with the markup that
  // reads them and an anonymous shopper — the SEO surface — pays nothing. This
  // is the one place a prop decides an island slice; it is safe here only
  // because `isLoggedIn` already drives the whole header on every route.
  ...(isLoggedIn ? { notifications: t.notifications } : {}),
  ...(needsDashboardStrings ? { dashboard: t.dashboard } : {}),
});

function sanitizeTagId(id?: string): string {
  const clean = (id ?? '').replace(/[^A-Za-z0-9\-]/g, '');
  return clean.length > 0 && clean.length <= 32 ? clean : '';
}
function sanitizePixelId(id?: string): string {
  return /^\d{1,20}$/.test(id ?? '') ? (id ?? '') : '';
}

/**
 * `noTracking` — this page's URL is allowed to carry a CREDENTIAL, so no third party may read it.
 *
 * Found in the row-4 re-audit, 2026-08-16, and it is latent rather than live only because both tag
 * ids are still empty (`store.config.ts`; wiring them is GO_LIVE §2.5, a launch blocker). The
 * password-reset link has to arrive as `?token=<64 hex>` — a mail can only carry a link — and every
 * page on this site loads GTM and the Meta Pixel, both of which report the FULL page location in
 * their payload. Not the `Referer` header, which modern browsers already trim to the origin
 * cross-site: GA4's `page_location` and the Pixel's `dl` are the page's own href, query string
 * included. So the day ads go live, every reset token would be copied into Google's and Meta's logs
 * inside its own 60-minute lifetime, readable by anyone with access to those accounts — an account
 * takeover path that leaves no trace on our side.
 *
 * It suppresses the dataLayer push too. That one is ours and harmless while GTM is absent, but it
 * exists to be READ by GTM, and a page that must not be reported on must not stage a report either.
 *
 * `tests/credential-url-tracking.test.ts` scans every page for the shape rather than for this file:
 * read a credential out of the URL, and the layout call has to say `noTracking`.
 */
/**
 * The CONFIGURED tag ids — what the platform would run if it were allowed to. Kept separate from
 * whether it may, below, because the banner has to be handed these even on a page that ships no
 * tag: a visitor who presses accept starts them without a reload.
 */
const configuredGtm   = noTracking ? '' : sanitizeTagId(platform.ads?.googleTagId);
const configuredPixel = noTracking ? '' : sanitizePixelId(platform.ads?.metaPixelId);

/**
 * **The consent gate, and it is a SERVER gate on purpose (owner's decision, 2026-08-25).**
 *
 * A banner that hides a tag with CSS, or unloads it after the fact, is not consent — the request
 * already went out and the third party already has the page URL and the visitor's IP. So with no
 * decision recorded these are empty, and the markup below then contains no loader, no `<noscript>`
 * pixel and no dataLayer push at all. Refusing is the DEFAULT, not a state a script has to reach.
 *
 * `lib/consent.ts` owns what the cookie means; this reads it and nothing more.
 */
const consent = parseConsent(Astro.cookies.get(CONSENT_COOKIE)?.value);
const platformGtm   = mayLoadTagManager(consent) ? configuredGtm : '';
const platformPixel = mayLoadAdPixel(consent) ? configuredPixel : '';

// The one blob that lands in EXECUTABLE JS rather than a JSON island, so it needs
// jsonForScript's U+2028/2029 escapes as much as its `</script>` ones. Carries
// seller-supplied product names (dataLayer ecommerce items) to every visitor.
// Gated on consent as well as on `noTracking`. The push is ours and harmless on its own, but it
// exists to be READ by GTM — a page that may not be reported on must not stage a report either,
// which is the same argument `noTracking` already made for a different reason.
const dlJson = dataLayer && !noTracking && platformGtm ? jsonForScript(dataLayer) : null;
const sessionUserId = getSellerSession(Astro.cookies) ?? '';

/**
 * Whether the buyer/seller NOTIFICATION surface belongs on this page — the bell, its badge, the
 * "(N)" the title carries, and the toasts.
 *
 * `sessionUserId` alone is not that question, and the difference was a live bug (owner, 2026-08-18):
 * the admin dashboard renders `isLoggedIn={false}` on purpose — an admin session is a different
 * session from any buyer/seller one, so it draws no bell and no avatar — but the cookie of whatever
 * seller account the same browser is signed into is still sent. The poller below keyed off the
 * cookie, so the admin's tab silently wore the SELLER's unread count: `(1) Admin Dashboard` for an
 * order in a store the admin was not looking at, with no bell anywhere on the page to explain the
 * number or clear it. Toasts landed there too, and Header polled `/api/notifications` every 30s for
 * a widget that does not exist on that page.
 *
 * `isLoggedIn` is the same gate the bell itself is drawn behind (Header.astro) and the same one the
 * `notifications` i18n slice travels with above, so the count, the strings and the markup that
 * explains it now appear together or not at all. Note this is deliberately NOT `window.__sessionUserId`,
 * which stays ungated below — cart identity has to switch on every page, admin pages included.
 */
const notifySurface = isLoggedIn && !!sessionUserId;
const initialUnreadCount = notifySurface ? await getUnreadCountForUser(sessionUserId) : 0;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* The CSRF token this page's requests will carry (src/lib/csrf.ts), and the one module that
        attaches it. A meta tag rather than a cookie: the server verifies the token's SIGNATURE, so
        nothing has to be echoed back and there is no JS-readable cookie to steal. The script must
        stay HERE — bundled scripts are deferred modules that run in document order, so one in the
        head runs before every other module on the page, including the ones that fetch on load. */}
    <meta name={CSRF_META} content={issueCsrfToken(Astro.cookies)} />
    <script>import { initCsrf } from '../scripts/csrf-client.js'; initCsrf();</script>
    {/* Runs before the browser restores scroll. A store quick-view modal pushes a
        product URL while the store is scrolled; if that URL is later reloaded, the
        browser would restore the STORE's scroll here (product opens scrolled down).
        Only in that case — history.state.productModal set — open at the top. A
        normal product/page load keeps its own restoration. */}
    <script is:inline>
      if (history.state && history.state.productModal && 'scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
    </script>
    {/* A STORE PAGE WEARS THE STORE'S OWN ICON IN THE TAB, everything else wears
        the platform D (2026-08-05, answering "what do we do about each store's
        favicon" in CURRENT_TASK סשן ב׳).

        It follows from the rule the whole product is built on — each store is
        sovereign, and platform chrome fades inside a store: a shopper with six tabs
        open is looking at six shops, not six copies of us. The picture is the one
        they already met on the store card and in the header, so it is recognition
        rather than a seventh asset (store-image.ts#storeIconUrl), and it costs a
        seller nothing: a store that uploaded no logo still has its generated mark,
        so there is no "set your favicon" step anywhere and never will be.

        Gated on `storeSlug && !sellerMode`, which is the shopper-facing store only.
        `storeMode` alone is the LAYOUT, and thirteen pages that are not a store ask
        for it — the homepage, /stores, /search, /checkout, 404 and every seller and
        admin screen. Those are ours and keep the D. So does the seller's dashboard:
        it is the platform's tool for running a store, not the store.

        No `type` on the store's icon on purpose: it resolves either to Cloudinary
        under `f_auto` (whatever the browser's own `Accept` asked for) or to our PNG
        endpoint, so declaring one here could only ever be a guess that contradicts
        the response. */}
    {storeIcon ? (
      <>
        <link rel="icon" href={storeIcon.favicon} />
        <link rel="apple-touch-icon" href={storeIcon.touch} />
      </>
    ) : (
      <>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        {/* iOS ignores an SVG favicon entirely and screenshots the page for the
            home screen unless this exists. Both files are generated together by
            scripts/generate-brand-assets.mjs from the one D in BrandLogo.astro. */}
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
      </>
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Every product/store image is delivered from Cloudinary (src/lib/cdn.ts), so
        the DNS+TLS handshake for that host is on the critical path of the first
        image on literally every page. Opening it in parallel with the HTML parse
        saves that round trip once per connection. */}
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    {/* The page's LCP image, when the page knows which one it is — BEFORE the ten
        font preloads on purpose. The preload scanner does find an above-the-fold
        <img> on its own, but only once it has parsed past the header and whatever
        chrome sits above it, by which point the fonts have taken the connections.
        Hoisting the largest element to the front of the queue is the whole point;
        a page that passes this must hand the byte-identical href/srcset/sizes its
        <img> uses, or the browser downloads the image twice. Store page first
        (its banner measured 2.77s LCP, 2026-08-03). */}
    {preloadImage?.href && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}
    {/* BOTH SCRIPTS PRELOADED, AND BOTH ARE MANDATORY — measured via Playwright's
       layout-shift observer (2026-07-16) that `font-display:optional` alone still
       let real text paint in the fallback font and visibly re-flow ~150-300ms later
       once Heebo finished loading, on *every* load including warm-cache reloads (not
       just a cold-first-visit edge case). Blocking all font requests in that same
       test produced zero layout-shift entries, confirming the font — not a
       JS/animation timing coincidence — as the cause.

       WHY BOTH AND NOT ONE. Hebrew and Latin are separate @font-face rules split by
       unicode-range and resolved independently: a price string mixes Latin digits
       with a Hebrew ₪, so preloading one script still lets the other half of that
       string swap on its own. That was measured too — preloading a subset of the old
       ten-file matrix cut the shift ~15x and never zeroed it.

       IT IS TWO LINKS RATHER THAN TEN as of 2026-08-23: the face is the variable
       build now, one file per script for the whole 100–900 range (12KB + 30KB
       against the ten static cuts' 86.5KB). Same face, measured identical — see
       main.css. Every @font-face there must appear in this list;
       tests/font-preload.test.ts enforces it. */}
    {[heeboHebrewUrl, heeboLatinUrl].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <Seo title={title} description={description} image={image} type={type} noindex={noindex} jsonLd={jsonLd} canonical={canonical} productPrice={productPrice} productCurrency={productCurrency} storeOwned={storeOwnsThisPage} siteName={storeName} />
    {/* Google Consent Mode v2's `default`, and it MUST come before any loader below or the
        container treats a missing signal as its own default. Emitted on every page that has a tag
        id configured at all — including pages currently shipping no tag, because it costs four
        lines and it is what makes the banner's later `update` mean anything. */}
    {configuredGtm && <script is:inline set:html={consentDefaultScript(consentModeSignal(consent))} />}
    {dlJson && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];window.dataLayer.push(${dlJson});`} />}
    {platformGtm && <script is:inline set:html={gtmHeadScript(platformGtm)} />}
    {platformPixel && <script is:inline set:html={metaPixelScript(platformPixel)} />}
  </head>
  <body data-store-slug={storeMode && !sellerMode && storeSlug ? storeSlug : undefined}>
    <script is:inline set:html={`
(function(){
  // Buffers any toast:show fired before ToastContainer's own listener exists.
  // ToastContainer.astro is a bundled component script (type=module, effectively
  // deferred until after the document parses + its JS chunk is fetched), while the
  // notifications poller below is a synchronous is:inline script whose first
  // poll()'s fetch can resolve in a few ms on localhost — often faster than the
  // module script even starts. Without this buffer, a toast fired on a fresh
  // navigation (the checkout success page landing seconds after the seller's own
  // "new_order" notification was created is the most common real case) is
  // dispatched into a void: no listener is attached yet, so it's silently lost.
  window.__toastQueue=[];
  window.addEventListener('toast:show',function(e){ window.__toastQueue.push(e.detail); });
})();
`} />
    <script is:inline set:html={`
(function(){
  var uid=${JSON.stringify(sessionUserId)};
  var stored=localStorage.getItem('__cu')||'';
  window.__sessionUserId=uid;
  window.__pendingCartSync='';
  if(stored===uid)return;
  function clearLocal(){
    var keys=Object.keys(localStorage);
    for(var i=0;i<keys.length;i++){
      var k=keys[i];
      if(k.indexOf('store_cart_v2_')===0||k==='wishlist_v1')localStorage.removeItem(k);
    }
    // recently-visited stores live in a cookie (SSR-read); drop it too so a
    // shared computer doesn't leak one account's history to the next.
    document.cookie='sn_recent_stores=;path=/;max-age=0;samesite=lax';
  }
  if(uid===''){
    // logout: server already has the latest cart; clear local
    clearLocal();
  }else if(stored===''){
    // guest → login: keep local, merge with server
    window.__pendingCartSync='merge';
  }else{
    // different logged-in user: clear local, then load their cart
    clearLocal();
    window.__pendingCartSync='replace';
  }
  localStorage.setItem('__cu',uid);
})();
`} />
    {platformGtm && <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${platformGtm}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />}
    {platformPixel && <noscript set:html={`<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${platformPixel}&ev=PageView&noscript=1" alt="" />`} />}
    <a href="#main-content" class="skip-link">{t.nav.skipToMain}</a>
    <script type="application/json" id="i18n-data" is:inline set:html={i18nJson}></script>
    {/* Navigation in flight. This is a multi-page app, so between the click and the
        next paint the browser simply holds the old page — nothing on screen says a
        thing is happening, and /stores to / is a couple of seconds of that (owner,
        2026-08-03). The same `.progress-sweep` every other wait on this site uses,
        pinned under the fixed header: one vocabulary, nothing new to learn.
        Empty until a navigation actually starts, and it needs no teardown — the
        document is replaced. */}
    <div id="nav-progress" class="progress-track fixed inset-x-0 top-[var(--site-header-h,3.4rem)] z-[70] pointer-events-none" role="status" aria-label={t.nav.loading}></div>
    <Header isLoggedIn={isLoggedIn} hasStore={hasStore} storeMode={storeMode} storeName={storeName} storeSlug={storeSlug} storeLogo={storeLogo} storeDemo={storeDemo} storeHeaderLogo={storeHeaderLogo} sellerMode={sellerMode} hideNav={hideNav} showSearch={showSearch} isHome={isHome} dashNav={dashNav} initialUnreadCount={initialUnreadCount} />
    {/* Arms every `[data-sticky-glass]` bar inline, and BEFORE <main> rather than from a page
        module or the end of the body — a sticky bar pins on the first pixel of scroll whether the
        page's imports (or even the rest of its HTML) have arrived or not. The component carries
        the measurement that made that the difference between glass and no glass. */}
    <StickyGlassBoot />
    <main id="main-content">
      <slot />
    </main>
    {/* **The one page without this footer is the one that carries it somewhere else.** The seller
        dashboard's rail runs the full height of the viewport and ends in the same four links
        (`DashRailFoot.astro`), so rendering this as well would be two footers on one page — and
        the copy at the end of the document is the one nobody reaches, being eight hundred product
        rows down. Still one footer per page; only its address changed. */}
    {!dashNav && <Footer />}
    {/* Rendered on EVERY page, dashboard included — a seller is a visitor too, and the footer's
        re-open control is not the only way here: an undecided visitor who lands straight on the
        dashboard must still be asked. It is `!hidden` until its script decides otherwise. */}
    <ConsentBanner gtmId={configuredGtm} pixelId={configuredPixel} />
    <CartDrawer />
    <AddToCartPreview />
    <WishlistDrawer />
    <ConfirmModal />
    <ProductQuickView />
    <StoreProductModal />
    <ToastContainer />
    <MessageCompose />
    <script>import '../lib/cart-sync.js';</script>
    <script>import { initErrorReporter } from '../scripts/error-reporter.js'; initErrorReporter();</script>
    <script>import { initIconTooltips } from '../scripts/icon-tooltips.js'; initIconTooltips();</script>
    <script>import { initFormValidity } from '../scripts/form-validity.js'; initFormValidity();</script>
    <script>import { initNavProgress } from '../scripts/nav-progress.js'; initNavProgress();</script>
    {notifySurface && (
      <script is:inline set:html={`
(function(){
  if(!window.__sessionUserId)return;
  // Persisted (not in-memory) cursor: a plain page reload/navigation used to reset
  // "first poll" toast-suppression every time, silently swallowing the toast for
  // any notification already unread by the time that particular page loaded (the
  // most common real case — e.g. a seller navigating dashboard tabs right as an
  // order comes in). Persisting the cursor in localStorage per-user means only the
  // very first poll this browser/user has ever run suppresses toasting a backlog;
  // every later poll (even the first one of a fresh page load) toasts anything new.
  var CURSOR_KEY='__notifToastCursor_'+window.__sessionUserId;
  var lastCheck=localStorage.getItem(CURSOR_KEY)||null;
  var isFirstEverCheck=!lastCheck;
  // Without a since= cursor the API returns every recent notification (read
  // and unread, up to 50) — on a first-ever check that's a real backlog we
  // don't want to toast all at once. But a blanket suppression also swallowed
  // a genuinely brand-new notification (e.g. the seller's own "new_order" that
  // fires the instant their checkout redirects to /checkout/success, which is
  // very often this browser's very first poll ever) — so only skip items older
  // than a short recency window instead of skipping the whole first batch.
  var FIRST_CHECK_RECENCY_MS=30000;
  function poll(){
    // The hidden-tab gate that lib/visible-poll.ts is for every other poll on the site, written
    // out by hand because this block is is:inline and can import nothing. Keep the two in step:
    // this is the one that runs on EVERY page, so a forgotten tab anywhere is this timer.
    if(document.hidden)return;
    var url='/api/notifications'+(lastCheck?'?since='+encodeURIComponent(lastCheck):'');
    fetch(url).then(function(r){return r.json();}).then(function(d){
      var notifs=d.notifications||[];
      var unreadCount=d.unreadCount||0;
      window.dispatchEvent(new CustomEvent('notifications:update',{detail:{unreadCount:unreadCount,notifications:notifs}}));
      var toToast=isFirstEverCheck
        ? notifs.filter(function(n){ return (Date.now()-new Date(n.createdAt).getTime())<FIRST_CHECK_RECENCY_MS; })
        : notifs;
      if(toToast.length>0){
        toToast.slice(0,3).forEach(function(n){
          // Where the toast leads is decided server-side, per row, by notification-link.ts — the
          // same value the bell dropdown uses. This block is is:inline plain JS and can import
          // nothing, which is exactly why the rule is on the API response instead of in a helper.
          var href=n.href||(n.role==='buyer'?'/buyer/dashboard':'/seller/dashboard');
          var body=n.storeName?(n.body?n.storeName+' — '+n.body:n.storeName):n.body;
          window.dispatchEvent(new CustomEvent('toast:show',{detail:{title:n.title,body:body,key:n.relatedId||n.id,href:href}}));
        });
      }
      isFirstEverCheck=false;
      // Anchor the cursor to the newest notification's own createdAt (notifs is
      // sorted desc by the API) rather than the client's "now" — using wall-clock
      // time here missed any notification created server-side during the fetch's
      // network round-trip (its createdAt lands before the client's "now", so the
      // next since-filtered poll silently excluded it forever: unreadCount still
