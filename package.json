{
  "name": "modular-store",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prestart": "node --env-file-if-exists=.env ./scripts/check-required-env.mjs",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env ./scripts/db-migrate.mjs",
    "backup:db": "node --env-file-if-exists=.env ./scripts/backup-db.mjs",
    "seed:showcase": "node --env-file-if-exists=.env ./scripts/seed-showcase-stores.mjs",
    "showcase:images": "node --env-file-if-exists=.env ./scripts/generate-showcase-images.mjs",
    "seed:demo": "node --env-file-if-exists=.env ./scripts/seed-demo-data.mjs",
    "verify": "node scripts/verify.mjs",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "lint": "eslint . --suppressions-location .eslint-baseline.json --pass-on-unpruned-suppressions --quiet",
    "lint:fix": "eslint . --fix",
    "lint:all": "eslint .",
    "lint:baseline": "eslint . --suppressions-location .eslint-baseline.json --suppress-all",
    "lint:prune": "eslint . --suppressions-location .eslint-baseline.json --prune-suppressions",
    "email:preview": "node scripts/email-preview.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "copy:review": "node scripts/copy-review.mjs export",
    "copy:apply": "node scripts/copy-review.mjs apply",
    "brand:wordmark": "node scripts/generate-wordmark.mjs",
    "showcase:prompts": "node ./scripts/export-showcase-prompts.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/heebo": "^5.2.8",
    "@imgly/background-removal": "^1.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.7",
    "pg": "^8.22.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.3",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.61.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
