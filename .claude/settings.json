{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/one-session-per-tree.sh",
            "timeout": 15,
            "statusMessage": "Checking for another session in this tree..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/worktrees-outstanding.sh",
            "timeout": 15,
            "statusMessage": "Checking for worktrees with unmerged work..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-new-css.sh",
            "statusMessage": "Checking Tailwind-only rule..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-new-style-block.sh",
            "statusMessage": "Checking Tailwind-only rule..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind-css-conversion.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-review.sh",
            "timeout": 30,
            "statusMessage": "Checking the review gate..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/require-green.sh",
            "timeout": 420,
            "statusMessage": "Verifying types, lint and tests..."
          }
        ]
      }
    ]
  }
}
