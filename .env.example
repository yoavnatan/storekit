# Copy this file to ".env" and fill in real values.
# Never commit the real .env file.

# --- Admin authentication ---
# Username + password for the /admin area.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Secret used to sign the admin session cookie. Use a long random string.
AUTH_SECRET=replace-with-a-long-random-string

# --- Payments (Stripe placeholder) ---
# Get these from your Stripe dashboard. Test keys start with sk_test_ / pk_test_.
STRIPE_SECRET_KEY=sk_test_xxx
PUBLIC_STRIPE_KEY=pk_test_xxx

# --- Site ---
# Public site URL (also set in src/config/store.config.js -> url)
PUBLIC_SITE_URL=http://localhost:4321
