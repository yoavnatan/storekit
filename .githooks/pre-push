#!/usr/bin/env bash
# Runs on every `git push`. Two jobs: back up Claude Code memory, and REFUSE the push if the same
# checks CI runs are not green.
#
# This hook used to block nothing, on the reasoning that the real gate is CI and a hook that
# `--no-verify` can bypass is only a reminder. Half of that is still true — see the bypass note at
# the bottom — but the conclusion was wrong, and 2026-08-02 is why: CI runs ON the pushed commit,
# so it can only ever tell you `main` is ALREADY broken. There is no arrangement in which CI is
# green before the push; the push is what starts it. Between the push and the fix, the default
# branch is red, and that window is the whole problem.
#
# The unbypassable version of this is branch protection (or a ruleset) requiring the `verify` check
# before anything lands on `main` — GitHub refuses the merge itself, with no local cooperation. It
# is deliberately NOT set up here: this repository is private on a free plan, and both mechanisms
# answer "Upgrade to GitHub Pro or make this repository public". If that ever changes, that is the
# gate to build, and this hook goes back to being a courtesy.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MEM="$REPO_ROOT/.claude-memory"

# ── 1. Memory backup ────────────────────────────────────────────────────────────
# Memory lives in its own PRIVATE repo, checked out at ./.claude-memory (git-ignored by the main
# repo). Committing and pushing it here means a `git push` of the code also backs up memory.
if [ ! -d "$MEM/.git" ]; then
  echo "[pre-push] .claude-memory is not a git repo — skipping memory backup." >&2
  echo "[pre-push] Run: bash scripts/setup-claude-memory.sh" >&2
else
  (
    cd "$MEM" || exit 0

    if [ -n "$(git status --porcelain)" ]; then
      git add -A
      git -c user.name="Yoav Natan" -c user.email="yoavnatan.yn@gmail.com" \
          commit -q -m "Memory sync $(git rev-parse --short HEAD 2>/dev/null || echo)" \
          || echo "[pre-push] memory commit failed (continuing)" >&2
    fi

    # Push only if the local branch is ahead of its remote.
    if ! git push -q origin HEAD 2>/dev/null; then
      echo "[pre-push] WARNING: memory push failed — code push continues, but memory backup is stale." >&2
    fi
  )
fi

# ── 2. The gate ─────────────────────────────────────────────────────────────────
# `npm run verify -- --all` is what CI runs (type check, lint against .eslint-baseline.json so only
# NEW problems surface, and the tests).
#
# **`--all`, and it has to be — measured 2026-08-03, when this gate waved through 69 commits.**
# Plain `verify` picks its checks from the WORKING diff, which is the right scope while you are
# editing and the wrong one entirely here: at push time the working tree is usually clean, because
# everything being pushed is already committed. It reported "nothing to check (no code touched)"
# and exited 0 — a gate that passes hardest exactly when there is most to check. AI_INSTRUCTIONS
# says the same thing about the session: a check skipped for a file committed earlier is still a
# check that did not run. A push is that situation by definition.
#
# The cost is the full run on every push instead of a fraction of it. That is the price of the gate
# meaning something, and it is paid once per push rather than once per edit.
#
# Lint alone would not be enough, and that is not hypothetical either: the CI failure that led here
# was a TEST failure — a suite that only ever ran against gitignored files imported an empty
# directory on the runner. A gate that cannot see the tests cannot see the thing that broke.
if [ ! -d "$REPO_ROOT/node_modules" ]; then
  echo "[pre-push] node_modules is missing — cannot verify. Run: npm ci" >&2
  exit 1
fi

if ! (cd "$REPO_ROOT" && npm run --silent verify -- --all); then
  echo "" >&2
  echo "[pre-push] REFUSED: verification is red, and CI will fail on the same thing." >&2
  echo "[pre-push] Fix it and push again, or run: npm run lint:fix" >&2
  echo "" >&2
  # A bypass exists — `git push --no-verify` — and removing it is not possible from inside a hook.
  # It is named here on purpose: the point of this gate is not to make a red push impossible, it is
  # to make it a decision someone takes deliberately rather than one they take by not looking.
  echo "[pre-push] Deliberate override (it will turn main red): git push --no-verify" >&2
  echo "" >&2
  exit 1
fi

exit 0
