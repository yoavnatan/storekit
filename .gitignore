# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# environment variables
.env
.env.production
.env.local

# macOS
.DS_Store

# editor
.vscode/
.idea/

# claude code worktree sessions (nested full checkouts, never source)
.claude/worktrees/

# personal local Claude Code permission overrides — machine-specific, not shared config
.claude/settings.local.json

# astro
.astro/

# runtime data (sellers, stores — created at runtime, not source)
data/*.json

# local images / assets not for version control
pics/

# One-off debug/test scripts. ROOT-ANCHORED with a leading slash on purpose: unanchored,
# `check-*.mjs` also swallowed scripts/check-required-env.mjs — a real, required file (npm's
# prestart gate), which would then be missing from a fresh clone and break `npm start` on the
# server. A pattern without a slash matches a basename at ANY depth.
/check-*.cjs
/check-*.js
/check-*.mjs
/test-*.cjs
/test-*.js
/test-*.mjs
/debug-*.cjs
/debug-*.js
/debug-*.mjs
# Dot-prefixed scratch of any kind, including the screenshots such a script writes. Kept
# unanchored (and mirrored in eslint.config.js) because nothing real in this repo is a
# dot-prefixed script, and a verification snippet must never turn `npm run lint` red for
# somebody else's unrelated work.
.tmp-*
.*.mjs
.*.cjs
# ...and the same for the `<name>.tmp.<ext>` infix form. Added 2026-08-01 after a
# `tabs-probe.tmp.mjs` at the repo root turned `npm run lint` red for an unrelated
# session — exactly the failure the paragraph above exists to prevent, just with the
# marker in the middle of the name instead of at the front. Nothing real here is
# named `*.tmp.*`.
*.tmp.mjs
*.tmp.cjs
*.tmp.js
*.tmp.ts

# Claude Code internal memory mirror (never source)
.claude-memory/
showcase-prompts.csv

# `showcase:images --batch` scratch: request JSONLs and multi-hundred-MB results files.
.showcase-batch/
